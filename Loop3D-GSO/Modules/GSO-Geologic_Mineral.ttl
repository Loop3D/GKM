gsmin:garnetgroup
  rdf:type owl:Class ;
  rdfs:comment "Added by SMR.  full name is Garnet Group"@en ;
  rdfs:comment "a group of silicate minerals with the same structure. All species of garnets possess similar physical properties and crystal forms, but differ in chemical composition. The different species are pyrope, almandine, spessartine, grossular (varieties of which are hessonite or cinnamon-stone and tsavorite), uvarovite and andradite. The garnets make up two solid solution series: pyrope-almandine-spessartine and uvarovite-grossular-andradite.(https://en.wikipedia.org/wiki/Garnet)"@en ;
  rdfs:label "Garnet"@en ;
  rdfs:subClassOf gsog:Mineral_Material ;
  gsmin:mindatid "min-10272" ;
  gsmin:mindaturl "https://www.mindat.org/min-10272.html" ;
.
