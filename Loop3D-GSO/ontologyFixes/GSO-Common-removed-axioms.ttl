@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix gsoc: <https://w3id.org/gso/1.0/common/> .

# ============================================================================
# GSO-Common-removed-axioms.ttl
#
# All axioms removed from GSO-Common.ttl for OWL 2 DL compatibility.
# To restore full OWL 2 Full expressivity, merge this file back into GSO-Common.ttl
# ============================================================================

# ============================================================================
# SECTION 1: TransitiveProperty declarations
# Removed because OWL 2 DL prohibits cardinality restrictions on transitive properties
# ============================================================================

gsoc:constantlyGenDependsOn rdf:type owl:TransitiveProperty .
gsoc:constantlySpecDependsOn rdf:type owl:TransitiveProperty .
gsoc:timeIncludedBy rdf:type owl:TransitiveProperty .
gsoc:timeIncludes rdf:type owl:TransitiveProperty .
gsoc:hasPart rdf:type owl:TransitiveProperty .
gsoc:isPartOf rdf:type owl:TransitiveProperty .
gsoc:hasPersistentPart rdf:type owl:TransitiveProperty .
gsoc:isPersistentPartOf rdf:type owl:TransitiveProperty .
gsoc:hasConstituent rdf:type owl:TransitiveProperty .
gsoc:isConstituentOf rdf:type owl:TransitiveProperty .
gsoc:externallyGenDependsOn rdf:type owl:TransitiveProperty .
gsoc:externallySpecDependsOn rdf:type owl:TransitiveProperty .
gsoc:spatio-temporallyDependsOn rdf:type owl:TransitiveProperty .
gsoc:specificallyDependsOn rdf:type owl:TransitiveProperty .
gsoc:genericallyDependsOn rdf:type owl:TransitiveProperty .
gsoc:timeOlderThan rdf:type owl:TransitiveProperty .
gsoc:timeYoungerThan rdf:type owl:TransitiveProperty .
gsoc:timeContains rdf:type owl:TransitiveProperty .
gsoc:occupiesSpaceDirectly rdf:type owl:TransitiveProperty .
gsoc:occupiesTimeDirectly rdf:type owl:TransitiveProperty .
gsoc:hostedBy rdf:type owl:TransitiveProperty .
gsoc:hosts rdf:type owl:TransitiveProperty .
gsoc:hasOlderHost rdf:type owl:TransitiveProperty .
gsoc:hasYoungerHost rdf:type owl:TransitiveProperty .
gsoc:staticHostedBy rdf:type owl:TransitiveProperty .

# ============================================================================
# SECTION 2: propertyDisjointWith axioms
# Removed because they reference non-simple (transitive) properties
# ============================================================================

gsoc:occupiesSpaceDirectly owl:propertyDisjointWith gsoc:occupiesSpaceIndirectly .
gsoc:occupiesSpaceIndirectly owl:propertyDisjointWith gsoc:occupiesSpaceDirectly .
gsoc:occupiesTimeDirectly owl:propertyDisjointWith gsoc:occupiesTimeIndirectly .
gsoc:spatio-temporallyDependsOn owl:propertyDisjointWith gsoc:spatiallyDisjoint .
gsoc:externallyGenDependsOn owl:propertyDisjointWith gsoc:hasEssentialPart .
gsoc:hasEssentialPart owl:propertyDisjointWith gsoc:timeDisjoint .
gsoc:hasReferenceSystem owl:propertyDisjointWith gsoc:isReferenceSystemFor .

# ============================================================================
# SECTION 3: Property chain axioms
# Removed due to irregular property hierarchies in OWL 2 DL
# ============================================================================

gsoc:indirectlyYoungerThan owl:propertyChainAxiom ( gsoc:occupiesTime gsoc:timeYoungerThan ) .

# ============================================================================
# SECTION 4: owl:equivalentClass axioms (41 total)
# Removed because they created unintended classification conflicts
# ============================================================================

# 4.1 Abstract_Time_Representation equivalentClass
gsoc:Abstract_Time_Representation owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        gsoc:Notional_Endurant
        [
          rdf:type owl:Class ;
          owl:complementOf [
              rdf:type owl:Restriction ;
              owl:onProperty gsoc:occupiesTime ;
              owl:someValuesFrom gsoc:Time_Region ;
            ] ;
        ]
      ) ;
  ] .

# 4.2 Amount_Of_Matter equivalentClass
gsoc:Amount_Of_Matter owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        gsoc:Material_Endurant
        [
          rdf:type owl:Restriction ;
          owl:onProperty gsoc:hasQuality ;
          owl:someValuesFrom gsoc:State_Of_Matter ;
        ]
      ) ;
  ] .

# 4.3 Event_Feature equivalentClass
gsoc:Event_Feature owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        gsoc:Endurant_Feature
        [
          rdf:type owl:Restriction ;
          owl:onProperty gsoc:hostedBy ;
          owl:someValuesFrom gsoc:Perdurant ;
        ]
      ) ;
  ] .

# 4.4 Endurant_Feature equivalentClass
gsoc:Endurant_Feature owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        gsoc:Feature
        [
          rdf:type owl:Restriction ;
          owl:onProperty gsoc:hasEssentialPart ;
          owl:someValuesFrom gsoc:Endurant ;
        ]
        [
          rdf:type owl:Restriction ;
          owl:allValuesFrom gsoc:Endurant ;
          owl:onProperty gsoc:hasEssentialPart ;
        ]
      ) ;
  ] .

# 4.5 Event equivalentClass
gsoc:Event owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        gsoc:Perdurant
        [
          rdf:type owl:Restriction ;
          owl:onProperty gsoc:hasConstituent ;
          owl:someValuesFrom gsoc:Process ;
        ]
      ) ;
  ] .

# 4.6 Example_Relator equivalentClass
gsoc:Example_Relator owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        gsoc:Relator
        [
          rdf:type owl:Restriction ;
          owl:onProperty gsoc:hasStaticPart ;
          owl:someValuesFrom gsoc:Example ;
        ]
      ) ;
  ] .

# 4.7 Fluid_Matter equivalentClass
gsoc:Fluid_Matter owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        gsoc:Amount_Of_Matter
        [
          rdf:type owl:Restriction ;
          owl:onClass [
              rdf:type owl:Class ;
              owl:intersectionOf (
                  gsoc:State_Of_Matter
                  [
                    rdf:type owl:Restriction ;
                    owl:allValuesFrom gsoc:Fluid ;
                    owl:onProperty gsoc:hasValue ;
                  ]
                ) ;
            ] ;
          owl:onProperty gsoc:hasQuality ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        ]
      ) ;
  ] .

# 4.8 Geospatial_Feature equivalentClass
gsoc:Geospatial_Feature owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        gsoc:Physical_Feature
        [
          rdf:type owl:Restriction ;
          owl:onProperty gsoc:hasEssentialPart ;
          owl:someValuesFrom gsoc:Spatial_Region ;
        ]
        [
          rdf:type owl:Restriction ;
          owl:allValuesFrom gsoc:Spatial_Region ;
          owl:onProperty gsoc:hasEssentialPart ;
        ]
      ) ;
  ] .

# 4.9 Inherant equivalentClass
gsoc:Inherant owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        gsoc:Nonphysical_Endurant
        [
          rdf:type owl:Restriction ;
          owl:onClass gsoc:Particular ;
          owl:onProperty gsoc:inheresIn ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        ]
      ) ;
  ] .

# 4.10 Inherant_Feature equivalentClass
gsoc:Inherant_Feature owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        gsoc:Nonphysical_Feature
        [
          rdf:type owl:Restriction ;
          owl:onProperty gsoc:hasEssentialPart ;
          owl:someValuesFrom gsoc:Inherant ;
        ]
        [
          rdf:type owl:Restriction ;
          owl:allValuesFrom gsoc:Inherant ;
          owl:onProperty gsoc:hasEssentialPart ;
        ]
      ) ;
  ] .

# 4.11 Material_Feature equivalentClass
gsoc:Material_Feature owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        gsoc:Physical_Feature
        [
          rdf:type owl:Restriction ;
