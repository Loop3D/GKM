# ============================================================================
# Additional equivalentClass axioms removed earlier (from initial debugging)
# ============================================================================

# Spatial_Region equivalentClass #1
gsoc:Spatial_Region owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        gsoc:Physical_Endurant
        [
          rdf:type owl:Restriction ;
          owl:onClass gsoc:Spatial_Location ;
          owl:onProperty gsoc:hasQuality ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        ]
      ) ;
  ] .

# Spatial_Region equivalentClass #2
gsoc:Spatial_Region owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        gsoc:Physical_Endurant
        [
          rdf:type owl:Class ;
          owl:complementOf [
              rdf:type owl:Restriction ;
              owl:onProperty gsoc:hasConstituent ;
              owl:someValuesFrom gsoc:Material_Endurant ;
            ] ;
        ]
      ) ;
  ] .

# Material_Endurant equivalentClass
gsoc:Material_Endurant owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        gsoc:Physical_Endurant
        [
          rdf:type owl:Restriction ;
          owl:onProperty gsoc:occupiesSpaceDirectly ;
          owl:someValuesFrom gsoc:Spatial_Region_3D ;
        ]
      ) ;
  ] .

# Physical_Endurant equivalentClass #1
gsoc:Physical_Endurant owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        gsoc:Endurant
        [
          rdf:type owl:Class ;
          owl:unionOf (
              gsoc:Spatial_Region
              [
                rdf:type owl:Restriction ;
                owl:onProperty gsoc:occupiesSpaceDirectly ;
                owl:someValuesFrom gsoc:Spatial_Region ;
              ]
            ) ;
        ]
      ) ;
  ] .

# Physical_Endurant equivalentClass #2
gsoc:Physical_Endurant owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        gsoc:Endurant
        [
          rdf:type owl:Restriction ;
          owl:allValuesFrom gsoc:Physical_Quality ;
          owl:onProperty gsoc:hasQuality ;
        ]
      ) ;
  ] .

# Endurant partition equivalentClass
gsoc:Endurant owl:equivalentClass [
    rdf:type owl:Class ;
    owl:unionOf (
        gsoc:Nonphysical_Endurant
        gsoc:Physical_Endurant
      ) ;
  ] .

# ============================================================================
# SECTION 5: Subproperty axioms causing range conflicts
# ============================================================================

# hasUOM range is Unit_Of_Measure_Value (a Quality_Value)
# hasQuality range is Quality
# Quality DisjointWith Quality_Value
# So hasUOM cannot be a subproperty of hasQuality
gsoc:hasUOM rdfs:subPropertyOf gsoc:hasQuality .

# ============================================================================
# SECTION 6: Restrictions with range violations
# isReferenceSystemFor has range Quality_Value, but these said someValuesFrom Quality/Perdurant
# ============================================================================

gsoc:Nonphysical_Reference_System rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty gsoc:isReferenceSystemFor ;
    owl:someValuesFrom gsoc:Nonphysical_Quality ;
  ] .

gsoc:Physical_Reference_System rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty gsoc:isReferenceSystemFor ;
    owl:someValuesFrom gsoc:Temporal_Quality ;
  ] .

gsoc:Temporal_Reference_System rdfs:subClassOf [
    rdf:type owl:Restriction ;
    owl:onProperty gsoc:isReferenceSystemFor ;
    owl:someValuesFrom gsoc:Perdurant ;
  ] .

# ============================================================================
# SECTION 7: Axioms removed from GSO-Geologic_Setting.ttl
# ============================================================================

@prefix gsen: <https://w3id.org/gso/1.0/geologicsetting/> .

# Extra_Terrestrial_Setting - removed complement-based subClassOf and equivalentClass
gsen:Extra_Terrestrial_Setting rdfs:subClassOf [
    rdf:type owl:Class ;
    owl:complementOf [
        rdf:type owl:Restriction ;
        owl:onProperty gsoc:containedBy ;
        owl:someValuesFrom [ rdf:type owl:Class ; owl:oneOf ( gsoc:Earth ) ] ;
      ] ;
  ] .

gsen:Extra_Terrestrial_Setting owl:disjointWith [
    rdf:type owl:Restriction ;
    owl:onProperty gsoc:containedBy ;
    owl:someValuesFrom [ rdf:type owl:Class ; owl:oneOf ( gsoc:Earth ) ] ;
  ] .

gsen:Extra_Terrestrial_Setting owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        gsoc:Setting
        [ rdf:type owl:Class ;
          owl:complementOf [
              rdf:type owl:Restriction ;
              owl:onProperty gsoc:containedBy ;
              owl:someValuesFrom [ rdf:type owl:Class ; owl:oneOf ( gsoc:Earth ) ] ;
            ] ;
        ]
      ) ;
  ] .

# Nonphysical_Endurant equivalentClass
gsoc:Nonphysical_Endurant owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        gsoc:Endurant
        [
          rdf:type owl:Class ;
          owl:complementOf [
              rdf:type owl:Restriction ;
              owl:onProperty gsoc:occupiesSpaceDirectly ;
              owl:someValuesFrom gsoc:Spatial_Region ;
            ] ;
        ]
      ) ;
  ] .

