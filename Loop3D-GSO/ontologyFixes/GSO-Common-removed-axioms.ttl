# 4.12 Massless_Endurant equivalentClass
gsoc:Massless_Endurant owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        gsoc:Material_Endurant
        [
          rdf:type owl:Class ;
          owl:complementOf [
              rdf:type owl:Restriction ;
              owl:onProperty gsoc:hasQuality ;
              owl:someValuesFrom gsoc:State_Of_Matter ;
            ] ;
        ]
      ) ;
  ] .

# 4.13 Measure_Value equivalentClass
gsoc:Measure_Value owl:equivalentClass [
    rdf:type owl:Class ;
    owl:intersectionOf (
        gsoc:Quality_Value
        [
          rdf:type owl:Restriction ;
          owl:onDataRange xsd:anySimpleType ;
          owl:onProperty gsoc:hasDataValue ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
        ]
      ) ;
  ] .

# 4.14 Named_Value equivalentClass
gsoc:Named_Value owl:equivalentClass [
    rdf:type owl:Class ;
    owl:complementOf [
        rdf:type owl:Class ;
        owl:unionOf (
            gsoc:Measure_Value
