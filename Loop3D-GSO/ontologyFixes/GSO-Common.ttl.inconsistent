@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix gsoc: <https://w3id.org/gso/1.0/common/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dcterms:created a owl:AnnotationProperty ;
    rdfs:subPropertyOf gsoc:hasAnnotation .

dcterms:creator a owl:AnnotationProperty ;
    rdfs:subPropertyOf gsoc:hasAnnotation .

dcterms:description a owl:AnnotationProperty ;
    rdfs:subPropertyOf gsoc:hasAnnotation .

dcterms:license a owl:AnnotationProperty ;
    rdfs:subPropertyOf gsoc:hasAnnotation .

dcterms:modified a owl:AnnotationProperty ;
    rdfs:subPropertyOf gsoc:hasAnnotation .

dcterms:publisher a owl:AnnotationProperty ;
    rdfs:subPropertyOf gsoc:hasAnnotation .

dcterms:rights a owl:AnnotationProperty ;
    rdfs:subPropertyOf gsoc:hasAnnotation .

dcterms:source a owl:AnnotationProperty ;
    rdfs:subPropertyOf gsoc:hasAnnotation .

rdfs:comment rdfs:subPropertyOf gsoc:hasAnnotation .

rdfs:label rdfs:subPropertyOf gsoc:hasAnnotation .

rdfs:seeAlso rdfs:subPropertyOf gsoc:hasAnnotation .

owl:versionInfo rdfs:subPropertyOf gsoc:hasAnnotation .

skos:definition a owl:AnnotationProperty ;
    rdfs:subPropertyOf gsoc:hasAnnotation .

gsoc:Constituent a owl:Class ;
    rdfs:label "Constituent"@en ;
    rdfs:comment "A part that is a constituent relation to a whole"@en ;
    rdfs:subClassOf gsoc:Part .

gsoc:Dominant_Proportion a owl:Class ;
    rdfs:label "Dominant Proportion"@en ;
    rdfs:comment "Constituent is one of the most abundant."@en,
        "Example-- in a typical granite, Quartz, plagioclase, and K-feldspar are the dominant constituents."@en ;
    rdfs:subClassOf gsoc:Proportion_Value .

gsoc:Dynamic_Feature a owl:Class ;
    rdfs:label "Dynamic Feature"@en ;
    rdfs:comment "A feature for which the host participates in some perdurant (wave) i.e. some aspect of the host changes over time"@en ;
    rdfs:subClassOf gsoc:Endurant_Feature ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Endurant_Feature [ a owl:Restriction ;
                        owl:onProperty gsoc:hostedBy ;
                        owl:someValuesFrom gsoc:Perdurant ] ) ] .

gsoc:Earth a owl:NamedIndividual,
        gsoc:Material_Object ;
    rdfs:comment "The Earth"@en .

gsoc:Event_Feature a owl:Class ;
    rdfs:label "Event Feature "@en ;
    rdfs:comment "" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Event ;
            owl:onProperty gsoc:hasEssentialPart ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:hasEssentialPart ;
            owl:someValuesFrom gsoc:Event ],
        gsoc:Occurrence_Feature .

gsoc:Fluid_Matter a owl:Class ;
    rdfs:comment "An amount of matter in a fluid state."@en ;
    rdfs:subClassOf gsoc:Amount_Of_Matter ;
    owl:disjointWith gsoc:Solid_Matter ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Amount_Of_Matter [ a owl:Restriction ;
                        owl:onProperty gsoc:hasQuality ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( gsoc:State_Of_Matter [ a owl:Restriction ;
                                            owl:allValuesFrom gsoc:Fluid ;
                                            owl:onProperty gsoc:hasValue ] ) ] ] ) ] .

gsoc:Gas a owl:Class ;
    rdfs:label "Gas state of matter"@en ;
    rdfs:comment "Gas is a state of matter that has no fixed shape and no fixed volume. Gases have lower density than other states of matter, such as solids and liquids. There is a great deal of empty space between particles, which have a lot of kinetic energy. The particles move very fast and collide into one another, causing them to diffuse, or spread out, until they are evenly distributed throughout the volume of the container.  (https://www.livescience.com/53304-gases.html)"@en ;
    rdfs:subClassOf gsoc:Fluid .

gsoc:Hole a owl:Class ;
    rdfs:label "Hole"@en ;
    rdfs:comment "A physical void with a self-connected (non-scattered) host, consisting of some depression or cavity within the host.  E.g. vug, vesicle, miariolitic cavity."@en ;
    rdfs:subClassOf gsoc:Physical_Void .

gsoc:Immaterial_Boundary a owl:Class ;
    rdfs:label "Immaterial Boundary "@en ;
    rdfs:comment "" ;
    rdfs:subClassOf gsoc:Low_Dimension_Feature .

gsoc:Liquid a owl:Class ;
    rdfs:label "Liquid state of matter"@en ;
    rdfs:comment "A nearly incompressible fluid that conforms to the shape of its container but retains a (nearly) constant volume independent of pressure. The only state of matter with a definite volume but no fixed shape. (https://en.wikipedia.org/wiki/Liquid)"@en ;
    rdfs:subClassOf gsoc:Fluid .

gsoc:Material_Boundary a owl:Class ;
    rdfs:label "Material Boundary "@en ;
    rdfs:comment "" ;
    rdfs:subClassOf gsoc:Material_Feature .

gsoc:Material_Morphological_Feature a owl:Class ;
    rdfs:label "Material Morphological Feature "@en ;
    rdfs:comment "" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty gsoc:hostedBy ;
            owl:someValuesFrom gsoc:Shape ],
        gsoc:Material_Feature .

gsoc:Minor_Proportion a owl:Class ;
    rdfs:label "Minor Constituent"@en ;
    rdfs:comment "Constituent is ubiquitous but not abundant"@en,
        "Example -- in some granites, hornblende is a minor constituent."@en ;
    rdfs:subClassOf gsoc:Proportion_Value .

gsoc:Nonphysical_Morphologic_Feature a owl:Class ;
    rdfs:label "Morphologic Feature"@en ;
    rdfs:comment "A feature that is not a part of its host, but characterized by the form or structure of the host: Morphological features can have morphological properties e.g. orientation, thickness, fold profile, etc. Examples: - smile or frown / lips.    - mountain / planet surface (protrusion in the planet surface).  - graben and horst / planet surface (protrusion or depression in the planet surface caused by faulting)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty gsoc:hasEssentialPart ;
            owl:someValuesFrom gsoc:Shape_Value ],
        gsoc:Inherant_Feature ;
    owl:disjointWith gsoc:Pattern_Feature .

gsoc:Nonphysical_Reference_System a owl:Class ;
    rdfs:comment "A reference system for non-physical quality values."@en ;
    rdfs:subClassOf gsoc:Reference_System ;
    owl:disjointWith gsoc:Physical_Reference_System,
        gsoc:Temporal_Reference_System ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Reference_System [ a owl:Restriction ;
                        owl:onProperty gsoc:isReferenceSystemFor ;
                        owl:someValuesFrom gsoc:Nonphysical_Quality ] ) ] .

gsoc:Numeric_Value a owl:Class ;
    rdfs:label "Numeric Value "@en ;
    rdfs:comment "Quality that specifies a numeric value for some quality"@en ;
    rdfs:subClassOf gsoc:Measure_Value ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Measure_Value [ a owl:Restriction ;
                        owl:allValuesFrom xsd:decimal ;
                        owl:onProperty gsoc:hasDataValue ] ) ] .

gsoc:Pause a owl:Class ;
    rdfs:label "Pause "@en ;
    rdfs:comment "Pause within an event or process, e.g. Intermission during hockey game or theater performance (host = playing process, constituent = time interval)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty gsoc:hostedBy ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( gsoc:Event gsoc:Process ) ] ],
        gsoc:Temporal_Void .

gsoc:Physical_Gap a owl:Class ;
    rdfs:label "Gap"@en ;
    rdfs:comment "A physical void with a scattered (disconnected) host, consisting of the spaces between the scattered parts of the host. e.g. porosity in a rock.   {@en}"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty gsoc:hostedBy ;
            owl:someValuesFrom gsoc:Material_Endurant ],
        gsoc:Physical_Void .

gsoc:Plasma a owl:Class ;
    rdfs:label "Plasma"@en ;
    rdfs:comment "a gas of ions, atoms or molecules which have one or more orbital electrons stripped (or, rarely, an extra electron attached), and free electrons.  Whether a given degree of ionization suffices to call the substance \"plasma\" depends on a specific phenomenon being considered. In other words, plasma is a matter which cannot be correctly described without the presence of charged particles taken into account. (https://en.wikipedia.org/wiki/Plasma_(physics))"@en ;
    rdfs:subClassOf gsoc:Fluid .

gsoc:Process_Feature a owl:Class ;
    rdfs:label "Process Feature "@en ;
    rdfs:comment "" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Process ;
            owl:onProperty gsoc:hasEssentialPart ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:hasEssentialPart ;
            owl:someValuesFrom gsoc:Process ],
        gsoc:Occurrence_Feature .

gsoc:Rare_Proportion a owl:Class ;
    rdfs:label "Rare constituent "@en ;
    rdfs:comment "Constituent is present but uncommon and rarely observed."@en,
        "Example-- in a typical granite, zircon and apatite are rare constituents"@en ;
    rdfs:subClassOf gsoc:Proportion_Value .

gsoc:Situation_Feature a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Situation ;
            owl:onProperty gsoc:hasEssentialPart ],
        gsoc:Feature ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Feature [ a owl:Restriction ;
                        owl:onProperty gsoc:hasEssentialPart ;
                        owl:someValuesFrom gsoc:Situation ] ) ] .

gsoc:Subordinate_Proportion a owl:Class ;
    rdfs:label "Subordinate Constituent"@en ;
    rdfs:comment "Constituent is less abundant than dominant constituent, but present in sufficient abundance to be an obvious constituent"@en,
        "Example--in a typical granite, biotite is a subordinate constituent."@en ;
    rdfs:subClassOf gsoc:Proportion_Value .

gsoc:Temporal_Boundary a owl:Class ;
    rdfs:label "Temporal Boundary "@en ;
    rdfs:comment "examples: start of Jan.  host = Jan; constituent = start datetime of every Jan"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty gsoc:hostedBy ;
            owl:someValuesFrom gsoc:Time_Interval_Feature ],
        gsoc:Time_Instant_Feature .

gsoc:Temporal_Gap a owl:Class ;
    rdfs:label "Temporal Gap "@en ;
    rdfs:comment "Gap in time between perdurants, E.g. offseason = time between end of sports season and beginning of next; hosts = sports seasons (2020 and 2021 NHL campaign events), constituent = time interval; relation = temporally disjoint"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty gsoc:hostedBy ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( gsoc:Event gsoc:Process ) ] ],
        gsoc:Temporal_Void .

gsoc:Time_Date_Value a owl:Class ;
    rdfs:label "A date or time datatype"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( [ a owl:Restriction ;
                        owl:allValuesFrom xsd:date ;
                        owl:onProperty gsoc:hasDataValue ] [ a owl:Restriction ;
                        owl:allValuesFrom xsd:dateTime ;
                        owl:onProperty gsoc:hasDataValue ] ) ],
        gsoc:Temporal_Value .

gsoc:Time_Numeric_Value a owl:Class ;
    rdfs:label "Time Instant Value "@en ;
    rdfs:comment "Quality that specifies a temporal location with a temporal coordinate or an xsd dateTime"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:decimal ;
            owl:onProperty gsoc:hasDataValue ],
        gsoc:Temporal_Value .

gsoc:WKT_Value a owl:Class ;
    rdfs:label "WKT Value"@en ;
    rdfs:comment "Text string to specify a spatial location according to ISO/IEC 13249-3:2016  (Information technology – Database languages – SQL multimedia and application packages – Part 3: Spatial (5th ed.), ISO, 2016-01-15, retrieved 2019-01-28)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom xsd:string ;
            owl:onProperty gsoc:hasDataValue ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:hasDataValue ;
            owl:someValuesFrom xsd:string ],
        gsoc:Spatial_Value .

gsoc:adjacentlyDependsOn a owl:ObjectProperty ;
    rdfs:comment "Specific dependence with spatial and temporal adjacency between relata."@en ;
    rdfs:subPropertyOf gsoc:spatiallyTouches,
        gsoc:spatio-temporallyDependsOn .

gsoc:containedBy a owl:ObjectProperty ;
    dcterms:source "https://en.wikipedia.org/wiki/DE-9IM. Based on the seminal works of Egenhofer et al. (1990, 1991),  Cohn et al. (1997), Clementini et al. (1993, 1994)."@en ;
    rdfs:comment "The interior and boundary of the subject spatial region intesect only the interior of the object spatial region. Subject region is in the interior of the object region."@en ;
    rdfs:subPropertyOf gsoc:isSpatiallyRelatedTo ;
    owl:inverseOf gsoc:contains ;
    skos:altLabel "within"@en .

gsoc:coveredBy a owl:ObjectProperty ;
    dcterms:source "https://en.wikipedia.org/wiki/DE-9IM. Based on the seminal works of Egenhofer et al. (1990, 1991),  Cohn et al. (1997), Clementini et al. (1993, 1994)."@en ;
    rdfs:comment "the boundary of the subject intersects the interior or the boundary of the object region, and the interior of the subject intersects only the interior of the object region.  Every point of the subject region is a point in the interior or the boundary of the object region."@en ;
    rdfs:subPropertyOf gsoc:isSpatiallyRelatedTo ;
    owl:inverseOf gsoc:covers .

gsoc:crosses a owl:ObjectProperty ;
    dcterms:source "https://en.wikipedia.org/wiki/DE-9IM. Based on the seminal works of Egenhofer et al. (1990, 1991),  Cohn et al. (1997), Clementini et al. (1993, 1994)."@en ;
    rdfs:comment "The subject and object spatial regions have some but not all interior points in common, and the dimension of the intersection is less than that of at least one of them."@en ;
    rdfs:subPropertyOf gsoc:isSpatiallyRelatedTo .

gsoc:emerges a owl:ObjectProperty ;
    rdfs:comment "The directed relation between a relator and feature, in which the feature is derived from the relator, i.e. the relator emerges the feature."@en ;
    rdfs:domain gsoc:Relator ;
    rdfs:range gsoc:Feature ;
    rdfs:subPropertyOf gsoc:hasDependent ;
    owl:inverseOf gsoc:emergesFrom .

gsoc:hasExample a owl:ObjectProperty ;
    rdfs:comment "Relation between an exemplified entity and its example."@en ;
    rdfs:range gsoc:Example ;
    rdfs:subPropertyOf gsoc:isRoleObjectFor ;
    owl:inverseOf gsoc:isExampleOf .

gsoc:hasInput a owl:ObjectProperty ;
    rdfs:comment "A participant in a process that must be present before the process can run."@en ;
    rdfs:subPropertyOf gsoc:hasParticipant ;
    owl:inverseOf gsoc:isInputOf .

gsoc:hasOlderHost a owl:ObjectProperty ;
    rdfs:comment "The host is older than the hosted entity."@en ;
    rdfs:subPropertyOf gsoc:hostedBy,
        gsoc:timeYoungerThan .

gsoc:hasOutput a owl:ObjectProperty ;
    rdfs:comment "A participant in a process that is produced by the action of the process and is present when the process is complete."@en ;
    rdfs:subPropertyOf gsoc:hasParticipant ;
    owl:inverseOf gsoc:isOutputOf .

gsoc:hasRole a owl:ObjectProperty ;
    rdfs:comment "The directed relation between a role player, and the role. E.g. between a rock material and the clast that is made up of that material."@en ;
    rdfs:range gsoc:Role ;
    rdfs:subPropertyOf gsoc:hasInherant ;
    owl:inverseOf gsoc:hasRolePlayer .

gsoc:hasSample a owl:ObjectProperty ;
    rdfs:comment "Relation between an sampled entity and its sample."@en ;
    rdfs:range gsoc:Example ;
    rdfs:subPropertyOf gsoc:isRoleObjectFor ;
    owl:inverseOf gsoc:isSampleOf .

gsoc:hasSpatialValue a owl:ObjectProperty ;
    rdfs:label "spatial location value "@en ;
    rdfs:comment "A relation between a non-abstact particular and a spatial location value - still in a test stage; intended as a short-cut for specifying the spatial location of something, but therefore equal to saying that something occupies space (in/directly) and has a spatial location quality with a certain spatial value (in a spatial reference system)."@en ;
    rdfs:range gsoc:Spatial_Value ;
    rdfs:subPropertyOf gsoc:location ;
    owl:propertyChainAxiom ( gsoc:occupiesSpace [ a owl:Restriction ;
                owl:allValuesFrom gsoc:Spatial_Location ;
                owl:onProperty gsoc:hasQuality ] [ a owl:Restriction ;
                owl:allValuesFrom gsoc:Spatial_Value ;
                owl:onProperty gsoc:hasValue ] ) .

gsoc:hasYoungerHost a owl:ObjectProperty ;
    rdfs:comment "The host is younger than the hosted entity."@en ;
    rdfs:subPropertyOf gsoc:hostedBy,
        gsoc:timeOlderThan .

gsoc:indirectlyYoungerThan a owl:ObjectProperty ;
    rdfs:label "Indirectly younger than"@en ;
    owl:propertyChainAxiom ( gsoc:occupiesTime gsoc:timeYoungerThan ) ;
    skos:prefLabel "Indirectly younger than" .

gsoc:isProducedFrom a owl:ObjectProperty ;
    rdfs:label "produced from "@en ;
    rdfs:comment "Directed relation between the output of some process or event, and its input."@en ;
    rdfs:subPropertyOf gsoc:production ;
    owl:inverseOf gsoc:isProductionInput ;
    owl:propertyDisjointWith gsoc:isProductionInput .

gsoc:materiallyDependsOn a owl:ObjectProperty ;
    rdfs:comment "Materially depends on - loss or change in the dependee will cause an unaviodable material change in the dependent."@en ;
    rdfs:domain gsoc:Physical_Endurant ;
    rdfs:range gsoc:Physical_Endurant ;
    rdfs:subPropertyOf gsoc:constantlySpecDependsOn,
        gsoc:dependsOn .

gsoc:nextTimeInterval a owl:ObjectProperty ;
    rdfs:comment "Source TimeInterval ends at the beginning of the target TimeInterval; there is no intervening time; inverse of age_met_by"@en ;
    rdfs:domain gsoc:Time_Interval ;
    rdfs:range gsoc:Time_Interval ;
    rdfs:subPropertyOf gsoc:timeMeets .

gsoc:ontology a owl:Ontology ;
    rdfs:label "Geoscience Ontology, Common"@en ;
    dcterms:bibliographicCitation "Brodaric, B., and Richard, S.M., 2021, The GeoScience Ontology Reference: Geological Survey of Canada Open File 8796, 34 p., https://doi.org/10.4095/328296" ;
    dcterms:created "2020-03-26"^^xsd:date ;
    dcterms:creator gsoc:boyan_brodaric,
        gsoc:stephen_richard ;
    dcterms:license <https://creativecommons.org/licenses/by/4.0/legalcode> ;
    dcterms:modified "2021-03-26"^^xsd:date ;
    dcterms:publisher "ARC Loop3D project;  https://loop3d.org/",
        "Geological Survey of Canada, Natural Resources Canada, Government of Canada" ;
    dcterms:rights "Copyright (c) 2021 Government of Canada" ;
    rdfs:comment "Unary predicates are represented by owl classes, binary predicates by rdf properties.  This ontology defines common types and relations that are further specialized by geologic entities in other modules"@en ;
    skos:definition "Common elements for geoscience ontology"@en ;
    schema:codeRepository "https://github.com/Loop3D/GKM" .

gsoc:partialEnvelope a owl:ObjectProperty ;
    rdfs:comment "Proposed for 'wraps around' relation." ;
    rdfs:subPropertyOf gsoc:isSpatiallyRelatedTo .

gsoc:previousTimeInterval a owl:ObjectProperty ;
    rdfs:comment "Source TimeInterval starts at the end of the target TimeInterval; there is no intervening time; inverse of meets"@en ;
    rdfs:domain gsoc:Time_Interval ;
    rdfs:range gsoc:Time_Interval ;
    rdfs:subPropertyOf gsoc:timeMetBy .

gsoc:spatialOverlaps a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:comment "The subject and object spatial regions have some but not all points in common, they have the same dimension, and the intersection of the interiors of the two geometries has the same dimension as the geometries themselves"@en ;
    rdfs:subPropertyOf gsoc:isSpatiallyRelatedTo .

gsoc:spatiallyDisjoint a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:subPropertyOf gsoc:isSpatiallyRelatedTo .

gsoc:staticHosts a owl:ObjectProperty ;
    rdfs:comment "Hosting a feature in which the feature is specifically dependent on the hsot."@en ;
    rdfs:subPropertyOf gsoc:hosts ;
    owl:inverseOf gsoc:staticHostedBy .

gsoc:timeContains a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:comment "target interval is completely within the source interval; source begins before target and ends after target. inverse of During"@en ;
    rdfs:subPropertyOf gsoc:timeIncludes,
        gsoc:timeIntersects ;
    owl:inverseOf gsoc:timeDuring .

gsoc:timeFinishedBy a owl:ObjectProperty ;
    rdfs:comment "source interval begins before target; source and target end simultaneously; inverse of finishes"@en ;
    rdfs:subPropertyOf gsoc:timeIncludes,
        gsoc:timeIntersects ;
    owl:inverseOf gsoc:timeFinishes .

gsoc:timeIncomparableTo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:comment "A is incomparable to be if there is not enough information to determine an age relationship"@en,
        "One of six binary relations between geologic events defined by Burns (1975)"@en ;
    rdfs:subPropertyOf gsoc:isTemporallyRelatedTo .

gsoc:timeOverlappedBy a owl:ObjectProperty ;
    dcterms:source "https://en.wikipedia.org/wiki/Allen%27s_interval_algebra" ;
    rdfs:comment "Target event starts after source event, and target event ends after source event ends."@en ;
    rdfs:subPropertyOf gsoc:timeIntersects ;
    owl:inverseOf gsoc:timeOverlaps .

gsoc:timePrecededBy a owl:ObjectProperty ;
    rdfs:subPropertyOf gsoc:timeDisjoint,
        gsoc:timeYoungerThan ;
    owl:inverseOf gsoc:timePrecedes .

gsoc:timeStartedBy a owl:ObjectProperty ;
    rdfs:comment "source and target start simultaneously; source interval ends after target; inverse of starts"@en ;
    rdfs:subPropertyOf gsoc:timeIncludes,
        gsoc:timeIntersects ;
    owl:inverseOf gsoc:timeStarts .

xsd:date a rdfs:Datatype .

gsoc:Duration a owl:Class ;
    rdfs:label "Duration "@en ;
    rdfs:comment "The length of a time interval in some appropriate temporal reference system, e.g. 1 month or 10 Ma."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty gsoc:hasValue ;
            owl:someValuesFrom gsoc:Quality_Value ],
        gsoc:Temporal_Quality .

gsoc:Exemplification a owl:Class ;
    rdfs:comment "Reification of the exmplification relation (i.e. of exemplifying something)."@en ;
    rdfs:subClassOf gsoc:Relator ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Relator [ a owl:Restriction ;
                        owl:onProperty gsoc:hasStaticPart ;
                        owl:someValuesFrom gsoc:Example ] ) ] .

gsoc:Geographic_Coordinate_System a owl:Class ;
    rdfs:label "Geographic Coordinate System "@en ;
    rdfs:comment "A coordinate reference system for locating positions relative to the Earth."@en ;
    rdfs:subClassOf gsoc:Physical_Reference_System .

gsoc:Low_Dimension_Feature a owl:Class ;
    rdfs:label "Low Dimension Feature "@en ;
    rdfs:comment "A feature that is immaterial but spatially located, typically a lower dimension subdivision of the host  (north pole, equator, earth surface, center of town); host is physical endurant, focal is spatial location relative to host."@en,
        "point, line or surface in 3-D space; a line or point in a 2-D space, a point in a 1-D space."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:unionOf ( gsoc:Spatial_Region_0D gsoc:Spatial_Region_1D gsoc:Spatial_Region_2D ) ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( gsoc:Spatial_Region_0D gsoc:Spatial_Region_1D gsoc:Spatial_Region_2D ) ] ;
            owl:onProperty gsoc:hasEssentialPart ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:hasEssentialPart ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( gsoc:Spatial_Region_0D gsoc:Spatial_Region_1D gsoc:Spatial_Region_2D ) ] ],
        gsoc:Immaterial_Feature .

gsoc:Pattern_Feature a owl:Class ;
    rdfs:comment "A feature that denotes a manifestation of a pattern. A pattern in GSO is a relation, in two senses: (1) an abstract pattern is a template, which can be expressed as an n-ary predicate with some variables as relata; (2) a manifested pattern is an occurence of the template in some host, and can be expressed as either (a) an n-ary relation with only constants as relata, or (b) an instance of the reification of this relation (i.e. a Relator instance). E.g. wood grain is hosted by some wood matter and the pattern is the reified relation between its wood fibres. Different wood grains are then different (reified and instantiated) relations between its fibres."@en ;
    rdfs:subClassOf gsoc:Inherant_Feature ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Inherant_Feature [ a owl:Restriction ;
                        owl:onProperty gsoc:hasEssentialPart ;
                        owl:someValuesFrom gsoc:Relator ] [ a owl:Restriction ;
                        owl:allValuesFrom gsoc:Relator ;
                        owl:onProperty gsoc:hasEssentialPart ] ) ] .

gsoc:Place_Feature a owl:Class ;
    rdfs:label "Place Feature "@en ;
    rdfs:comment "chunk of physical space (the focal); only hosted by and relative to a material entity, thus not fixed in space (host can move) (downtown, outside my house, personal space)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Spatial_Region_3D ;
            owl:onProperty gsoc:hasEssentialPart ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:hasEssentialPart ;
            owl:someValuesFrom gsoc:Spatial_Region_3D ],
        gsoc:Immaterial_Feature .

gsoc:Sample a owl:Class ;
    rdfs:comment "A dislocated part of a thing, collected for some reason. Some samples are also examples of their whole (i.e. are prototypical) and others are not."@en ;
    rdfs:subClassOf gsoc:Part .

gsoc:Shape_Value a owl:Class ;
    rdfs:label "Morphologic feature shape value"@en ;
    rdfs:comment "Place holder for category vocabularies to describe the shape of a morphological feature, e.g. fold, fold limb."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Shape ;
            owl:onProperty gsoc:isValueOf ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:isValueOf ;
            owl:someValuesFrom gsoc:Shape ],
        gsoc:Named_Value .

gsoc:Solid a owl:Class ;
    rdfs:label "Solid state of matter"@en ;
    rdfs:comment "Matter with a definite shape, mass, and volume, that does not conform to the shape of a container in which it is placed. Solids have a high density, meaning that the particles are tightly packed together. (https://www.livescience.com/46506-states-of-matter.html) A solid is characterized by structural rigidity and resistance to a force applied to the surface. The atoms in a solid are bound to each other, either in a regular geometric lattice (crystalline solids, which include metals and ordinary ice), or irregularly (an amorphous solid such as common window glass). Solids cannot be compressed with little pressure whereas gases can be compressed with little pressure because the molecules in a gas are loosely packed. (https://en.wikipedia.org/wiki/Solid)"@en ;
    rdfs:subClassOf gsoc:State_Of_Matter_Value .

gsoc:Solid_Matter a owl:Class ;
    rdfs:comment "An amount of matter in a solid state"@en ;
    rdfs:subClassOf gsoc:Amount_Of_Matter ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Amount_Of_Matter [ a owl:Restriction ;
                        owl:onProperty gsoc:hasQuality ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:intersectionOf ( gsoc:State_Of_Matter [ a owl:Restriction ;
                                            owl:allValuesFrom gsoc:Solid ;
                                            owl:onProperty gsoc:hasValue ] ) ] ] ) ] .

gsoc:Time_Instant_Feature a owl:Class ;
    rdfs:label "Time Instant Feature "@en ;
    rdfs:comment "" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Time_Instant ;
            owl:onProperty gsoc:hasEssentialPart ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:hasEssentialPart ;
            owl:someValuesFrom gsoc:Time_Instant ],
        gsoc:Temporal_Feature ;
    owl:disjointWith gsoc:Time_Interval_Feature .

gsoc:Uncertainty a owl:Class ;
    rdfs:label "Uncertainty"@en ;
    rdfs:comment "" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Measure_Value ;
            owl:onProperty gsoc:isQualityOf ],
        gsoc:Nonphysical_Quality .

gsoc:Unit_Of_Measure a owl:Class ;
    rdfs:label "Units of measurement"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Measure_Value ;
            owl:onProperty gsoc:isQualityOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Unit_Of_Measure_Value ;
            owl:onProperty gsoc:hasValue ],
        gsoc:Nonphysical_Quality .

gsoc:boyan_brodaric a owl:NamedIndividual,
        schema:Person ;
    rdfs:label "Dr. Boyan Brodaric" ;
    rdfs:comment "e-mail: mailto:boyan.brodaric@canada.ca " ;
    schema:affiliation "Natural Resources Canada, Geological Survey of Canada" ;
    schema:identifier <https://orcid.org/0000-0002-7987-3810> ;
    schema:name "Dr. Boyan Brodaric" .

gsoc:contains a owl:ObjectProperty ;
    dcterms:source "https://en.wikipedia.org/wiki/DE-9IM. Based on the seminal works of Egenhofer et al. (1990, 1991),  Cohn et al. (1997), Clementini et al. (1993, 1994)."@en ;
    rdfs:comment "Object region lies in subject region, and the interiors intersect. Another definition: \"subject region contains object region  iff no points of object region lie in the exterior of subject region, and at least one point of the interior of object region lies in the interior of subject region\"."@en ;
    rdfs:subPropertyOf gsoc:isSpatiallyRelatedTo .

gsoc:covers a owl:ObjectProperty ;
    dcterms:source "https://en.wikipedia.org/wiki/DE-9IM. Based on the seminal works of Egenhofer et al. (1990, 1991),  Cohn et al. (1997), Clementini et al. (1993, 1994)."@en ;
    rdfs:comment "At least one point of object region lies in subject region,  and no point of object region lies in the exterior of subject region, or every point of object region is a point of (the interior or boundary of) subject region. Alternative: The interior of the subject region intersects the interior or the boundary of the object region, and the boundary of the subject region intersects the boundary of the object region."@en ;
    rdfs:subPropertyOf gsoc:isSpatiallyRelatedTo .

gsoc:determinedBy a owl:ObjectProperty ;
    rdfs:comment "Directed relation between an entity and something that helps validate it."@en ;
    rdfs:subPropertyOf gsoc:determination ;
    owl:inverseOf gsoc:determines .

gsoc:determines a owl:ObjectProperty ;
    rdfs:comment "Directed relation between something, as validator, and the thing being validated."@en ;
    rdfs:subPropertyOf gsoc:determination .

gsoc:exemplifies a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:comment "Directed relation between an exemple and the thing being exemplfied."@en ;
    rdfs:subPropertyOf gsoc:exemplification ;
    owl:inverseOf gsoc:isExemplifiedBy .

gsoc:hasSetting a owl:ObjectProperty ;
    rdfs:comment "Relation between somethingh and its contextualized setting."@en ;
    rdfs:range gsoc:Setting ;
    rdfs:subPropertyOf gsoc:isEssentialPartOf ;
    owl:inverseOf gsoc:isSettingFor .

gsoc:hasStaticValue a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:comment "Having a fixed quality value that cannot change during the existence of the quality."@en ;
    rdfs:domain gsoc:Quality ;
    rdfs:range gsoc:Quality_Value ;
    rdfs:subPropertyOf gsoc:hasStaticPart,
        gsoc:hasValue ;
    owl:inverseOf gsoc:isStaticValueOf .

gsoc:hasUOM a owl:ObjectProperty ;
    rdfs:comment "top level property for assigning property values; subtype for associating values with measurement units "@en ;
    rdfs:domain gsoc:Measure_Value ;
    rdfs:range gsoc:Unit_Of_Measure_Value ;
    rdfs:subPropertyOf gsoc:hasQuality .

gsoc:isExemplifiedBy a owl:IrreflexiveProperty,
        owl:ObjectProperty ;
    rdfs:comment "Directed relation between a thing and its example."@en ;
    rdfs:subPropertyOf gsoc:exemplification .

gsoc:isInputOf a owl:ObjectProperty ;
    rdfs:comment "Relation from an endurant to an event or process for which the endurant is a precursor."@en ;
    rdfs:subPropertyOf gsoc:isParticipantIn .

gsoc:isOutputOf a owl:ObjectProperty ;
    rdfs:comment "Relation from an endurant to an event or process for which the endurant is a result."@en ;
    rdfs:subPropertyOf gsoc:isParticipantIn .

gsoc:isSampleOf a owl:ObjectProperty ;
    rdfs:comment "Relation to a significant sample (i.e. part) of the domain (in the context of some other relation). Examples and samples can overlap, but are not the same. All samples are parts of the thing sampled, and are not necessarily prototypical. Examples are prototypical of the exemlpified thing, but are not necessarily parts."@en ;
    rdfs:domain gsoc:Sample ;
    rdfs:subPropertyOf gsoc:hasRoleObject .

gsoc:location a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "location "@en ;
    rdfs:comment "A relation between a non-abstact particular and a spatial or temoral location value - still in a test stage; intended as a short-cut for specifying the spatial or temporal location of something, but therefore equal to saying that something occupies space or time (in/directly) and has a spatial/temporal location quality with a certain  value (in a spatial / temporal reference system). Generically depends on the spatial or temporal value."@en ;
    rdfs:domain [ a owl:Class ;
            owl:complementOf gsoc:Abstract_Endurant ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( gsoc:Spatial_Value gsoc:Temporal_Value ) ] ;
    rdfs:subPropertyOf gsoc:constantlyGenDependsOn .

gsoc:occupiesSpaceIndirectly a owl:ObjectProperty ;
    rdfs:comment "Occupies space indirectly."@en ;
    rdfs:domain [ a owl:Class ;
            owl:complementOf gsoc:Physical_Endurant ] ;
    rdfs:range gsoc:Spatial_Region ;
    rdfs:subPropertyOf gsoc:occupiesSpace ;
    owl:inverseOf gsoc:spaceOccupiedIndirectlyBy .

gsoc:spaceOccupiedIndirectlyBy a owl:ObjectProperty ;
    rdfs:domain gsoc:Spatial_Region ;
    rdfs:subPropertyOf gsoc:spaceOccupiedBy .

gsoc:spatiallyEquals a owl:ObjectProperty,
        owl:SymmetricProperty ;
    dcterms:source "https://en.wikipedia.org/wiki/DE-9IM. Based on the seminal works of Egenhofer et al. (1990, 1991),  Cohn et al. (1997), Clementini et al. (1993, 1994)."@en ;
    rdfs:comment "a and b are topologically equal. Two geometries are topologically equal if their interiors intersect and no part of the interior or boundary of one geometry intersects the exterior of the other"@en,
        "the boundary of the subject intersects only the boundary of the object spatial region, and the interior of the subject intersects only the interior of the obect spatial region."@en ;
    rdfs:subPropertyOf gsoc:isSpatiallyRelatedTo .

gsoc:spatiallyTouches a owl:ObjectProperty,
        owl:SymmetricProperty ;
    dcterms:source "https://en.wikipedia.org/wiki/DE-9IM. Based on the seminal works of Egenhofer et al. (1990, 1991),  Cohn et al. (1997), Clementini et al. (1993, 1994)."@en ;
    rdfs:comment "subject and object regions have at least one point in common, but their interiors do not intersect. The boundary and only the boundary of the subject intersects the boundary of the object spatial region"@en ;
    rdfs:subPropertyOf gsoc:isSpatiallyRelatedTo ;
    skos:altLabel "patially meet"@en .

gsoc:spatio-temporallyDependsOn a owl:ObjectProperty ;
    rdfs:comment "Dependence of an entity on another, requiring overlap (full or partial) in space and time between the entities."@en ;
    rdfs:subPropertyOf gsoc:externallySpecDependsOn,
        gsoc:isSpatiallyRelatedTo,
        gsoc:timeIntersects .

gsoc:staticHostedBy a owl:ObjectProperty ;
    rdfs:comment "Specifically dependent hosting: the feature could not exist essentially and retain identity without the specific host."@en ;
    rdfs:subPropertyOf gsoc:hostedBy,
        gsoc:specificallyDependsOn .

gsoc:stephen_richard a owl:NamedIndividual,
        schema:Person ;
    rdfs:label "Dr. Stephen M. Richard" ;
    rdfs:comment "e-mail: mailto:smrTucson@gmail.com " ;
    schema:identifier <https://orcid.org/0000-0001-6041-5302> ;
    schema:name "Dr. Stephen M. Richard" .

gsoc:timeDuring a owl:ObjectProperty ;
    rdfs:comment "interval A is entirely contained in interval B; B starts before A and B ends after A. Allen relation."@en ;
    rdfs:subPropertyOf gsoc:timeIncludedBy,
        gsoc:timeIntersects .

gsoc:timeEquivalentTo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:comment "A is equivalent to B if they represent expressions of the same Time_Region. Same as Allen A Equals B."@en,
        "One of six binary relations between geologic events defined by Burns (1975)"@en ;
    rdfs:subPropertyOf gsoc:timeIncludedBy,
        gsoc:timeIncludes,
        gsoc:timeIntersects .

gsoc:timeFinishes a owl:ObjectProperty ;
    rdfs:comment "Target TimeRegion starts before source TimeRegion, and source and target TimeRegion end at the same instant. Allen Relation. Use to assign a younger age boundary for a Time Region (instant or interval)."@en ;
    rdfs:subPropertyOf gsoc:timeIncludedBy,
        gsoc:timeIntersects .

gsoc:timeMeets a owl:ObjectProperty ;
    rdfs:comment "A covers B -- A is immediately younger than B (there are no events between A and B) Same as Allen A meets B."@en,
        "One of six binary relations between geologic events defined by Burns (1975)"@en,
        "Source TimeRegion ends at the beginning of the target TimeRegion; there is no intervening time and boundary instants are distinct; inverse of age_met_by"@en ;
    rdfs:subPropertyOf gsoc:timeDisjoint,
        gsoc:timeOlderThan ;
    owl:inverseOf gsoc:timeMetBy .

gsoc:timeOccupiedIndirectlyBy a owl:ObjectProperty ;
    rdfs:domain gsoc:Time_Region ;
    rdfs:subPropertyOf gsoc:timeOccupiedBy .

gsoc:timeOverlaps a owl:ObjectProperty ;
    rdfs:comment "target interval starts before source interval ends, and target inteval ends after source interval. Allen Relation"@en ;
    rdfs:subPropertyOf gsoc:timeIntersects .

gsoc:timePrecedes a owl:ObjectProperty ;
    rdfs:subPropertyOf gsoc:timeDisjoint,
        gsoc:timeOlderThan .

gsoc:timeStarts a owl:ObjectProperty ;
    rdfs:comment "Source and target TimeRegions start at same instant, target TimeRegion ends after source TimeRegion; Allen Relation. Assign an older age boundary for a time interval."@en ;
    rdfs:subPropertyOf gsoc:timeIncludedBy,
        gsoc:timeIntersects .

xsd:anySimpleType a rdfs:Datatype .

gsoc:Element a owl:Class ;
    rdfs:label "Element"@en ;
    rdfs:comment "An amount of elements: either a single atom or an aggregation of atoms of a particular element. All subtypes currently refer to an aggregation of atoms of a single element. An element is a species of atom having the same number of protons in its atomic nuclei (that is, the same atomic number, or Z). https://en.wikipedia.org/wiki/Chemical_element."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Element ;
            owl:onProperty gsoc:hasPart ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:intersectionOf ( gsoc:Material_Endurant [ a owl:Class ;
                                owl:complementOf gsoc:Element ] ) ] ;
            owl:onProperty gsoc:isConstituentOf ],
        gsoc:Amount_Of_Matter .

gsoc:Immaterial_Feature a owl:Class ;
    rdfs:label "Immaterial_Feature "@en ;
    rdfs:comment "A dependent place feature that is immaterial.  E.g. voids, shadows and relational features such as traffic intersections (meeting of roads).   MPF(x) <--> DPF(x) ^ not mat(x)"@en ;
    rdfs:subClassOf gsoc:Physical_Feature ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Physical_Feature [ a owl:Restriction ;
                        owl:onProperty gsoc:hasEssentialPart ;
                        owl:someValuesFrom gsoc:Spatial_Region ] [ a owl:Restriction ;
                        owl:allValuesFrom gsoc:Spatial_Region ;
                        owl:onProperty gsoc:hasEssentialPart ] ) ] .

gsoc:Material_Feature a owl:Class ;
    rdfs:label "Material Feature "@en ;
    rdfs:comment "Material Feature (MF): A dependent place feature that is material. - my house's backyard, frontyard."@en ;
    rdfs:subClassOf gsoc:Physical_Feature ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Physical_Feature [ a owl:Restriction ;
                        owl:onProperty gsoc:hasEssentialPart ;
                        owl:someValuesFrom gsoc:Material_Endurant ] [ a owl:Restriction ;
                        owl:allValuesFrom gsoc:Material_Endurant ;
                        owl:onProperty gsoc:hasEssentialPart ] ) ] .

gsoc:Material_Object a owl:Class ;
    rdfs:label "Material Object"@en ;
    rdfs:comment "Material Objects things constituted by some amounty of matter, but are not an amount of matter themselves, nor can constitute matter."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty gsoc:isConstituentOf ;
                    owl:someValuesFrom gsoc:Amount_Of_Matter ] ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:hasConstituent ;
            owl:someValuesFrom gsoc:Amount_Of_Matter ],
        gsoc:Material_Endurant ;
    owl:disjointWith gsoc:Amount_Of_Matter ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Material_Endurant [ a owl:Class ;
                        owl:complementOf [ a owl:Restriction ;
                                owl:onProperty gsoc:hasQuality ;
                                owl:someValuesFrom gsoc:State_Of_Matter ] ] ) ] .

gsoc:Nonphysical_Feature a owl:Class ;
    rdfs:label "Nonphysical Feature"@en ;
    rdfs:comment "" ;
    rdfs:subClassOf gsoc:Endurant_Feature ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Endurant_Feature [ a owl:Restriction ;
                        owl:onProperty gsoc:hasEssentialPart ;
                        owl:someValuesFrom gsoc:Nonphysical_Endurant ] [ a owl:Restriction ;
                        owl:allValuesFrom gsoc:Nonphysical_Endurant ;
                        owl:onProperty gsoc:hasEssentialPart ] ) ] .

gsoc:Occurrence_Feature a owl:Class ;
    rdfs:label "Occurrence Feature "@en ;
    rdfs:comment "" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( gsoc:Event gsoc:Process ) ] ;
            owl:onProperty gsoc:hasEssentialPart ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:hasEssentialPart ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( gsoc:Event gsoc:Process ) ] ],
        gsoc:Perdurant_Feature ;
    owl:disjointWith gsoc:Temporal_Feature .

gsoc:Parthood a owl:Class ;
    rdfs:comment "Reification of the parthood relation (i.e. to be in a whole-part relation)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty gsoc:hasStaticPart ;
            owl:someValuesFrom gsoc:Whole ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:hasStaticPart ;
            owl:someValuesFrom gsoc:Part ],
        gsoc:Relator ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Relator [ a owl:Restriction ;
                        owl:onProperty gsoc:hasStaticPart ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( gsoc:Part gsoc:Whole ) ] ] ) ] .

gsoc:Physical_Reference_System a owl:Class ;
    rdfs:label "Physical Reference System"@en ;
    rdfs:comment "A set of conventions for describing values of qualities of physical endurants."@en ;
    rdfs:subClassOf gsoc:Reference_System ;
    owl:disjointWith gsoc:Temporal_Reference_System ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Reference_System [ a owl:Restriction ;
                        owl:onProperty gsoc:isReferenceSystemFor ;
                        owl:someValuesFrom gsoc:Temporal_Quality ] ) ] .

gsoc:Physical_Void a owl:Class ;
    rdfs:label "Physical Void"@en ;
    rdfs:comment "A chunk of physical space adjacent to some material feature and surrounded by it. (holes,valleys, canyon, cave, gap, space between fingers). host must be self connected.  An empty physical space in 3D. Distinct from abstract mathematical spaces, which include spaces made from various reference frames, including coordinate systems imposed on the earth (these are abstract imposed on real space). V(x) <--> IPF(x) ^ exists y [hosts-v (y,x)]"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Material_Endurant ;
            owl:onProperty gsoc:hostedBy ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:hostedBy ;
            owl:someValuesFrom gsoc:Material_Endurant ],
        gsoc:Place_Feature .

gsoc:Proportion a owl:Class ;
    rdfs:label "Proportion"@en ;
    rdfs:comment "A quality denoting the fraction that a part composes a whole. Numeric values will range from 0 to 1 (0 to 100%); might also have categorical determinates like 'dominant', 'subordinate', 'minor', 'rare', 'absent'. Can only be the quality of a part role - only specifies how much a part makes up a whole."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Part ;
            owl:onProperty gsoc:isQualityOf ],
        gsoc:Nonphysical_Quality .

gsoc:Setting a owl:Class ;
    rdfs:label "Setting"@en ;
    rdfs:comment "A setting is a situation that provies context, usually casual, for a some individual.  E.g. Marine Setting and Alluvial Fan Setting are settings for things causally impacted by them. {@en" ;
    rdfs:subClassOf gsoc:Situation ;
    owl:equivalentClass [ a owl:Restriction ;
            owl:onProperty gsoc:isSettingFor ;
            owl:someValuesFrom gsoc:Particular ] .

gsoc:State_Of_Matter_Value a owl:Class ;
    rdfs:label "State of matter value"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:State_Of_Matter ;
            owl:onProperty gsoc:isValueOf ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:isValueOf ;
            owl:someValuesFrom gsoc:State_Of_Matter ],
        gsoc:Named_Value .

gsoc:Temporal_Void a owl:Class ;
    rdfs:label "Temporal Void "@en ;
    rdfs:comment "" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty gsoc:hostedBy ;
            owl:someValuesFrom [ a owl:Class ;
                    owl:unionOf ( gsoc:Event gsoc:Process ) ] ],
        gsoc:Time_Interval_Feature .

gsoc:Time_Instant_Location a owl:Class ;
    rdfs:label "Time Instant Location"@en ;
    rdfs:comment "quality the specifies the temporal coordinates of a time instant in some temporal reference system"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Temporal_Value ;
            owl:onProperty gsoc:hasValue ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:hasValue ;
            owl:someValuesFrom gsoc:Temporal_Value ],
        gsoc:Temporal_Location .

gsoc:Time_Interval_Location a owl:Class ;
    rdfs:label "Time Interval Location"@en ;
    rdfs:comment "quality the specifies the temporal coordinates of the beginning and end of time interval in some temporal reference system"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Temporal_Range ;
            owl:onProperty gsoc:hasValue ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:hasQuality ;
            owl:someValuesFrom gsoc:Duration ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:hasValue ;
            owl:someValuesFrom gsoc:Temporal_Range ],
        gsoc:Temporal_Location .

gsoc:dependance a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:comment "Undirected dependence relation."@en ;
    rdfs:subPropertyOf gsoc:isFundamentallyRelatedTo .

gsoc:determination a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:comment "Undirected relation in which something acts as evidence or method to validate an entity"@en ;
    rdfs:subPropertyOf gsoc:isFundamentallyRelatedTo .

gsoc:exemplification a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:comment "Undirected relation between an example and the thing it exemplifies. Both instances and types can be exemples and exemplified, e.g. as typical instance of a type, or a typical part of something."@en ;
    rdfs:subPropertyOf gsoc:isFundamentallyRelatedTo .

gsoc:externallyGenDependsOn a owl:ObjectProperty ;
    rdfs:comment "External generic ontological dependence in which the dependee is not an internal entity, e.g. is not a quality, role, constituent, or essential part, but is some external entit."@en ;
    rdfs:subPropertyOf gsoc:genericallyDependsOn .

gsoc:externallySpecDependsOn a owl:ObjectProperty ;
    rdfs:comment "External specific dependence, i.e. not dependent on own parts, qualities, roles, constituents, etc."@en ;
    rdfs:subPropertyOf gsoc:externallyGenDependsOn,
        gsoc:specificallyDependsOn .

gsoc:hasEndValue a owl:ObjectProperty ;
    rdfs:comment "The upper bound in quality value range."@en ;
    rdfs:domain gsoc:Range_Value ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( gsoc:Measure_Value gsoc:Named_Value ) ] ;
    rdfs:subPropertyOf gsoc:hasStaticPart .

gsoc:hasStartValue a owl:ObjectProperty ;
    rdfs:comment "The lower bound in a quality value range."@en ;
    rdfs:domain gsoc:Range_Value ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( gsoc:Measure_Value gsoc:Named_Value ) ] ;
    rdfs:subPropertyOf gsoc:hasStaticPart .

gsoc:isEssentialPartOf a owl:ObjectProperty ;
    rdfs:comment "Relation of being an essential part of a whole, such that whole is generically dependent on the part, and the part can be exchanged or missing."@en ;
    rdfs:subPropertyOf gsoc:hasDependent,
        gsoc:isPartOf ;
    owl:inverseOf gsoc:hasEssentialPart .

gsoc:isExampleOf a owl:ObjectProperty ;
    rdfs:comment "Relation to a significant example of something. Can point to a complete example or representative part."@en ;
    rdfs:domain gsoc:Example ;
    rdfs:subPropertyOf gsoc:hasRoleObject .

gsoc:isProductionInput a owl:ObjectProperty ;
    rdfs:label "production input "@en ;
    rdfs:comment "Directed relation between the input of some process or event, and its output."@en ;
    rdfs:subPropertyOf gsoc:production .

gsoc:isRoleObjectFor a owl:ObjectProperty ;
    rdfs:comment "Inverse of hasRoleObject. Relation between a role and the non-role-player objects that are associated. E.g. in an employs relation, the entity that employs (employer) is a role object for the employee role."@en ;
    rdfs:range gsoc:Role ;
    rdfs:subPropertyOf gsoc:hasDependent ;
    owl:inverseOf gsoc:hasRoleObject .

gsoc:isSettingFor a owl:ObjectProperty ;
    rdfs:comment "Relation between a setting and the entity contextualized by the settting."@en ;
    rdfs:domain gsoc:Setting ;
    rdfs:subPropertyOf gsoc:hasEssentialPart .

gsoc:isStaticPartOf a owl:ObjectProperty ;
    rdfs:comment "Inverse of hasStaticPart. Static parts are essentially part of whole during the life of the whole and cannot be missing or exchanged."@en ;
    rdfs:subPropertyOf gsoc:isPersistentPartOf ;
    owl:inverseOf gsoc:hasStaticPart .

gsoc:isStaticValueOf a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:comment "Relation between a fixed value (that never changes for the quality) and its quality."@en ;
    rdfs:domain gsoc:Quality_Value ;
    rdfs:range gsoc:Quality ;
    rdfs:subPropertyOf gsoc:isStaticPartOf,
        gsoc:isValueOf ;
    owl:inverseOf gsoc:hasStaticValue .

gsoc:occupiedBy a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( gsoc:Spatial_Region gsoc:Time_Region ) ] ;
    rdfs:subPropertyOf gsoc:hasDependent ;
    owl:inverseOf gsoc:occupies .

gsoc:occupiesTimeIndirectly a owl:ObjectProperty ;
    rdfs:comment "Occupies a temporal region indirectly."@en ;
    rdfs:domain [ a owl:Class ;
            owl:complementOf gsoc:Perdurant ] ;
    rdfs:range gsoc:Time_Region ;
    rdfs:subPropertyOf gsoc:occupiesTime ;
    owl:inverseOf gsoc:timeOccupiedIndirectlyBy .

gsoc:parthood a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:comment "Undirected relation between a part and whole."@en ;
    rdfs:subPropertyOf gsoc:isFundamentallyRelatedTo .

gsoc:production a owl:IrreflexiveProperty,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "Production "@en ;
    rdfs:comment "Undirected relation between the input and output of some process or event."@en ;
    rdfs:subPropertyOf gsoc:isFundamentallyRelatedTo .

gsoc:reference a owl:IrreflexiveProperty,
        owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:comment "Undircted relation between an entity and its reference system"@en ;
    rdfs:subPropertyOf gsoc:isFundamentallyRelatedTo .

gsoc:spaceOccupiedDirectlyBy a owl:ObjectProperty ;
    rdfs:domain gsoc:Spatial_Region ;
    rdfs:subPropertyOf gsoc:spaceOccupiedBy .

gsoc:timeInclusion a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:subPropertyOf gsoc:isTemporallyRelatedTo .

gsoc:timeMetBy a owl:ObjectProperty ;
    rdfs:comment "Source TimeRegion starts at the end of the target TimeRegion; there is no intervening time, and the boundary instants are distinct;  inverse of meets"@en ;
    rdfs:subPropertyOf gsoc:timeDisjoint,
        gsoc:timeYoungerThan .

gsoc:timeOccupiedDirectlyBy a owl:ObjectProperty ;
    rdfs:domain gsoc:Time_Region ;
    rdfs:subPropertyOf gsoc:timeOccupiedBy .

gsoc:Inherant_Feature a owl:Class ;
    rdfs:label "Inherent Feature "@en ;
    rdfs:comment "based on quality inhering in (essential relation) host. The quality is the focal; Quality inheres in both the feature and the host. Morphologic feature -- focal  is a specific shape (river bend, fold)"@en ;
    rdfs:subClassOf gsoc:Nonphysical_Feature ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Nonphysical_Feature [ a owl:Restriction ;
                        owl:onProperty gsoc:hasEssentialPart ;
                        owl:someValuesFrom gsoc:Inherant ] [ a owl:Restriction ;
                        owl:allValuesFrom gsoc:Inherant ;
                        owl:onProperty gsoc:hasEssentialPart ] ) ] .

gsoc:Perdurant_Feature a owl:Class ;
    rdfs:label "Perdurant Feature "@en ;
    rdfs:comment "" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty gsoc:hostedBy ;
            owl:someValuesFrom gsoc:Particular ],
        gsoc:Feature ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Feature [ a owl:Restriction ;
                        owl:onProperty gsoc:hasEssentialPart ;
                        owl:someValuesFrom gsoc:Perdurant ] [ a owl:Restriction ;
                        owl:allValuesFrom gsoc:Perdurant ;
                        owl:onProperty gsoc:hasEssentialPart ] ) ] .

gsoc:Shape a owl:Class ;
    rdfs:label "Shape Property"@en ;
    rdfs:comment "Property to specify the shape of an object. Lots of possible property spaces under this, e.g. (in geology) roundness, sphericity, aspect ratio. These are implemented as separate properties linked to gsoc:Shape via hasQuality"@en ;
    rdfs:subClassOf gsoc:Physical_Quality .

gsoc:Spatial_Location a owl:Class ;
    rdfs:label "Spatial Location"@en ;
    rdfs:comment "A physical property that specifies the position of an entity relative to some spatial reference system. Use WKT strings (ogc:WKTLiteral, https://www.w3.org/2011/02/GeoSPARQL.pdf)  as data values."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Spatial_Region ;
            owl:onProperty gsoc:isQualityOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Spatial_Value ;
            owl:onProperty gsoc:hasValue ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:isQualityOf ;
            owl:someValuesFrom gsoc:Spatial_Region ],
        gsoc:Physical_Quality .

gsoc:Spatial_Region_2D a owl:Class ;
    rdfs:label "2D Spatial Region "@en ;
    rdfs:comment "Apatial region that is a surface."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( gsoc:Spatial_Region_0D gsoc:Spatial_Region_1D ) ] ;
            owl:onProperty gsoc:hasPart ],
        gsoc:Spatial_Region .

gsoc:Spatial_Region_3D a owl:Class ;
    rdfs:label "3 D Spatial Region "@en ;
    rdfs:comment "A spatial region with volume." ;
    rdfs:subClassOf gsoc:Spatial_Region .

gsoc:Temporal_Feature a owl:Class ;
    rdfs:label "Temporal Feature "@en ;
    rdfs:comment "A feature for which either the constituent  is a Perdurant"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Time_Region ;
            owl:onProperty gsoc:hasEssentialPart ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:hasEssentialPart ;
            owl:someValuesFrom gsoc:Time_Region ],
        gsoc:Perdurant_Feature .

gsoc:Temporal_Range a owl:Class ;
    rdfs:label "Temporal Range "@en ;
    rdfs:comment "Quality that specifies a quality value for a Temporal Location that is a time interval with a start and end temporal value"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Temporal_Location ;
            owl:onProperty gsoc:isValueOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Temporal_Value ;
            owl:onProperty gsoc:hasEndValue ],
        [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Temporal_Value ;
            owl:onProperty gsoc:hasStartValue ],
        gsoc:Range_Value .

gsoc:Temporal_Reference_System a owl:Class ;
    rdfs:label "Temporal Reference System "@en ;
    rdfs:comment "A reference system for temporal values."@en ;
    rdfs:subClassOf gsoc:Reference_System ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Reference_System [ a owl:Restriction ;
                        owl:onProperty gsoc:isReferenceSystemFor ;
                        owl:someValuesFrom gsoc:Perdurant ] ) ] .

gsoc:Time_Instant a owl:Class ;
    rdfs:label "Time Instant"@en ;
    rdfs:comment "A time instant is a point in time."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Time_Instant ;
            owl:onProperty gsoc:hasPart ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:hasQuality ;
            owl:someValuesFrom gsoc:Time_Instant_Location ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:specificallyDependsOn ;
            owl:someValuesFrom gsoc:Time_Instant_Location ],
        gsoc:Time_Region ;
    owl:disjointWith gsoc:Time_Interval .

gsoc:Time_Interval_Feature a owl:Class ;
    rdfs:label "Time Interval Feature "@en ;
    rdfs:comment "" ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty gsoc:hasEssentialPart ;
            owl:someValuesFrom gsoc:Time_Interval ],
        gsoc:Temporal_Feature .

gsoc:Unit_Of_Measure_Value a owl:Class ;
    rdfs:label "Unit of Measure Value "@en ;
    rdfs:comment "Unit of measure categories; profile from QUDT ontology (http://qudt.org/2.1/vocab/unit)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Unit_Of_Measure ;
            owl:onProperty gsoc:isValueOf ],
        gsoc:Named_Value .

gsoc:Whole a owl:Class ;
    rdfs:comment "The whole in a whole-part relation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty gsoc:mutuallySpecDependsOn ;
            owl:someValuesFrom gsoc:Parthood ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:hasRolePlayer ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty gsoc:hasPart ;
                    owl:someValuesFrom gsoc:Particular ] ],
        gsoc:Role .

gsoc:dependsOn a owl:ObjectProperty ;
    rdfs:comment "Directed relation between a dependent entity (that relies on something) and a dependee (the thing being relied on)." ;
    rdfs:subPropertyOf gsoc:dependance ;
    owl:inverseOf gsoc:hasDependent .

gsoc:emergesFrom a owl:ObjectProperty ;
    rdfs:comment "The emergence of a feature from a relator."@en ;
    rdfs:domain gsoc:Feature ;
    rdfs:range gsoc:Relator ;
    rdfs:subPropertyOf gsoc:externallySpecDependsOn .

gsoc:hasInherant a owl:ObjectProperty ;
    rdfs:comment "Inverse relation to inheresIn - directed relation between a carrier and the inherant it carries. E.g. between a rock body and a thickness."@en ;
    rdfs:range gsoc:Inherant ;
    rdfs:subPropertyOf gsoc:hasDependent ;
    owl:inverseOf gsoc:inheresIn .

gsoc:hasReferenceSystem a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:comment "Dircted relation a quality value and its reference system."@en ;
    rdfs:domain gsoc:Quality_Value ;
    rdfs:range gsoc:Reference_System ;
    rdfs:subPropertyOf gsoc:reference ;
    owl:inverseOf gsoc:isReferenceSystemFor ;
    owl:propertyDisjointWith gsoc:isReferenceSystemFor .

gsoc:hosts a owl:ObjectProperty ;
    rdfs:comment "Direction relation of hosting a feature in which the feature is generically dependent on the host."@en ;
    rdfs:range gsoc:Feature ;
    rdfs:subPropertyOf gsoc:hasDependent ;
    owl:inverseOf gsoc:hostedBy .

gsoc:isPartOf a owl:ObjectProperty ;
    rdfs:comment "Directed relation between a part and whole."@en ;
    rdfs:subPropertyOf gsoc:parthood .

gsoc:isParticipantIn a owl:ObjectProperty ;
    rdfs:comment "Inverse of hasParticipant. Directed relation between some endurant and a process or event in which it participates."@en ;
    rdfs:domain gsoc:Endurant ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( gsoc:Event gsoc:Process ) ] ;
    rdfs:subPropertyOf gsoc:hasDependent ;
    owl:inverseOf gsoc:hasParticipant .

gsoc:occupies a owl:ObjectProperty ;
    rdfs:comment "Occupation of a region of space or time, directly or indirectly"@en ;
    rdfs:domain [ a owl:Class ;
            owl:complementOf gsoc:Abstract_Endurant ] ;
    rdfs:range [ a owl:Class ;
            owl:unionOf ( gsoc:Spatial_Region gsoc:Time_Region ) ] ;
    rdfs:subPropertyOf gsoc:constantlyGenDependsOn .

gsoc:occupiesTimeDirectly a owl:ObjectProperty ;
    rdfs:comment "The occupation of a time region by a process or event."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( gsoc:Event gsoc:Process ) ] ;
    rdfs:range gsoc:Time_Region ;
    rdfs:subPropertyOf gsoc:occupiesTime ;
    owl:inverseOf gsoc:timeOccupiedDirectlyBy .

gsoc:spaceOccupiedBy a owl:ObjectProperty ;
    rdfs:domain gsoc:Spatial_Region ;
    rdfs:subPropertyOf gsoc:occupiedBy .

gsoc:timeOccupiedBy a owl:ObjectProperty ;
    rdfs:domain gsoc:Time_Region ;
    rdfs:subPropertyOf gsoc:occupiedBy .

gsoc:timeOlderThan a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:comment "Age associated with subject is entirely prior to age associated with object"@en,
        "Event A is older than event B if A has occurred prior to B. (Burns, 1975; Mathematical Geology, Vol. 7, No. 4) Equivalent to Allen A Before B."@en ;
    rdfs:subPropertyOf gsoc:isTemporallyRelatedTo ;
    owl:inverseOf gsoc:timeYoungerThan .

gsoc:Example a owl:Class ;
    rdfs:comment "A designated example of something: a prototypical part of an instance, or a prototypical instance of a type. Derived from the exemplifies relation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty gsoc:mutuallySpecDependsOn ;
            owl:someValuesFrom gsoc:Exemplification ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:hasRolePlayer ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty gsoc:exemplifies ;
                    owl:someValuesFrom gsoc:Particular ] ],
        gsoc:Role .

gsoc:Fluid a owl:Class ;
    rdfs:label "Fluid material state"@en ;
    rdfs:comment "Matter that continually deforms (flows) under an applied shear stress, or external force. Fluids are a phase of matter and include liquids, gases and plasmas. They are substances with zero shear modulus, or, in simpler terms, substances which cannot resist any shear force applied to them. (https://en.wikipedia.org/wiki/Fluid)"@en ;
    rdfs:subClassOf gsoc:State_Of_Matter_Value .

gsoc:Physical_Feature a owl:Class ;
    rdfs:label "Physical Feature "@en ;
    rdfs:comment "A feature for which the host is involved in some essential spatial relation,e g. adjacency, containment, intersection, contact."@en ;
    rdfs:subClassOf gsoc:Endurant_Feature ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Endurant_Feature [ a owl:Restriction ;
                        owl:onProperty gsoc:hasEssentialPart ;
                        owl:someValuesFrom gsoc:Physical_Endurant ] [ a owl:Restriction ;
                        owl:allValuesFrom gsoc:Physical_Endurant ;
                        owl:onProperty gsoc:hasEssentialPart ] ) ] .

gsoc:Proportion_Value a owl:Class ;
    rdfs:label "Proportion Value"@en ;
    rdfs:comment "Value of Proportion quality"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Proportion ;
            owl:onProperty gsoc:isValueOf ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:isValueOf ;
            owl:someValuesFrom gsoc:Proportion ],
        gsoc:Named_Value .

gsoc:Situation a owl:Class ;
    rdfs:label "Situation"@en ;
    rdfs:comment "A situation is a fragment of the world with any particulars as parts and some criteria that unifies the parts into an integral whole. Situations overlap with perdurants and endurants: e.g. some situations are endurants (endurant parts only) or perdurants (perduranty parts only), and others are just situations (mixed endurant and perdurant parts). Because features are either endurants, perdurants or situations too, all situations with feature parts will also be one of these types. However, it is still tbd if situations comprised of features are features too."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty gsoc:hasStaticPart ;
            owl:someValuesFrom gsoc:Particular ],
        gsoc:Particular ;
    owl:disjointWith [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty gsoc:hasPart ;
                    owl:someValuesFrom gsoc:Particular ] ],
        [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:complementOf [ a owl:Restriction ;
                                owl:onProperty gsoc:hasStaticPart ;
                                owl:someValuesFrom gsoc:Particular ] ] [ a owl:Restriction ;
                        owl:onProperty gsoc:hasPart ;
                        owl:someValuesFrom gsoc:Particular ] ) ] .

gsoc:constantlyGenDependsOn a owl:ObjectProperty ;
    rdfs:comment "Constant generic dependance in which relata are co-temporal, that is, the dependee exists during the lifespan of the dependent."@en ;
    rdfs:subPropertyOf gsoc:genericallyDependsOn .

gsoc:hasPersistentPart a owl:ObjectProperty ;
    rdfs:comment "The  part must be present at all times the whole is present, and the part can be exchanged but not missing."@en ;
    rdfs:subPropertyOf gsoc:constantlyGenDependsOn,
        gsoc:hasEssentialPart ;
    owl:inverseOf gsoc:isPersistentPartOf .

gsoc:hasRoleObject a owl:ObjectProperty ;
    rdfs:comment "property that links a Role to the Particular that the RolePlayer is linked to in a relationship"@en ;
    rdfs:domain gsoc:Role ;
    rdfs:subPropertyOf gsoc:specificallyDependsOn .

gsoc:inheresIn a owl:FunctionalProperty,
        owl:ObjectProperty ;
    rdfs:comment "Inhering in something involves being constantly specifically dependent on it. E.g. a quality such as thickness inheres in a rock body."@en ;
    rdfs:domain gsoc:Inherant ;
    rdfs:subPropertyOf gsoc:constantlySpecDependsOn .

gsoc:isPersistentPartOf a owl:ObjectProperty ;
    rdfs:comment "Inverse of hasPersistentPart. Persistent parts temporally co-exist with the whole for the lifespan of the whole, so cannot be misisng but can be exchanged."@en ;
    rdfs:subPropertyOf gsoc:isEssentialPartOf ;
    owl:inverseOf gsoc:hasPersistentPart .

gsoc:isRelatedTo a rdf:Property,
        owl:SymmetricProperty ;
    rdfs:comment "Most general relation in GSO holding between any two things"@en .

gsoc:occupiesSpaceDirectly a owl:ObjectProperty ;
    rdfs:comment "The occupation of a spatial region by a material endurant."@en ;
    rdfs:domain gsoc:Material_Endurant ;
    rdfs:range gsoc:Spatial_Region ;
    rdfs:subPropertyOf gsoc:occupiesSpace ;
    owl:inverseOf gsoc:spaceOccupiedDirectlyBy .

gsoc:timeDisjoint a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:comment "The union of Allen Before and After; Age intervals of subject and object do not touch or intersect."@en ;
    rdfs:subPropertyOf gsoc:isTemporallyRelatedTo .

gsoc:Nonphysical_Quality a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Nonphysical_Endurant ;
            owl:onProperty gsoc:isQualityOf ],
        gsoc:Quality ;
    owl:disjointWith gsoc:Physical_Quality,
        gsoc:Temporal_Quality ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Quality [ a owl:Restriction ;
                        owl:onProperty gsoc:isQualityOf ;
                        owl:someValuesFrom gsoc:Nonphysical_Endurant ] ) ] .

gsoc:Part a owl:Class ;
    rdfs:comment "The part in a whole-part relation"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty gsoc:mutuallySpecDependsOn ;
            owl:someValuesFrom gsoc:Parthood ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:hasRolePlayer ;
            owl:someValuesFrom [ a owl:Restriction ;
                    owl:onProperty gsoc:isPartOf ;
                    owl:someValuesFrom gsoc:Particular ] ],
        gsoc:Role ;
    owl:disjointWith gsoc:Whole .

gsoc:Spatial_Region_0D a owl:Class ;
    rdfs:label "1D Spatial Region "@en ;
    rdfs:comment "A degenerate spatial region that is a single point." ;
    rdfs:subClassOf [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty gsoc:hasPart ;
                    owl:someValuesFrom gsoc:Particular ] ],
        gsoc:Spatial_Region .

gsoc:Spatial_Region_1D a owl:Class ;
    rdfs:label "1D Spatial Region "@en ;
    rdfs:comment "A spatial region that is defined as a segment of a line." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( gsoc:Spatial_Region_0D gsoc:Spatial_Region_1D ) ] ;
            owl:onProperty gsoc:hasPart ],
        gsoc:Spatial_Region .

gsoc:Spatial_Value a owl:Class ;
    rdfs:comment "A spatial location value in some spatial reference system"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Geographic_Coordinate_System ;
            owl:onProperty gsoc:hasReferenceSystem ],
        gsoc:Measure_Value ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Measure_Value [ a owl:Restriction ;
                        owl:allValuesFrom gsoc:Spatial_Location ;
                        owl:onProperty gsoc:isValueOf ] ) ] .

gsoc:constantlySpecDependsOn a owl:ObjectProperty ;
    rdfs:comment "Constant specific dependence, in which the dependee is co-temporal with the dependent."@en ;
    rdfs:subPropertyOf gsoc:constantlyGenDependsOn,
        gsoc:specificallyDependsOn,
        gsoc:timeIncludedBy .

gsoc:hasParticipant a owl:ObjectProperty ;
    rdfs:comment "The participation of an endurant in a process or event."@en ;
    rdfs:domain [ a owl:Class ;
            owl:unionOf ( gsoc:Event gsoc:Process ) ] ;
    rdfs:range gsoc:Endurant ;
    rdfs:subPropertyOf gsoc:externallyGenDependsOn ;
    owl:inverseOf gsoc:isParticipantIn .

gsoc:hasRolePlayer a owl:ObjectProperty ;
    rdfs:comment "A role is played by (has a role player) something in a relation; e.g. students, employees, pilots are played by persons in enrollment, employment, and flying relations, respectivey."@en ;
    rdfs:domain gsoc:Role ;
    rdfs:subPropertyOf gsoc:inheresIn .

gsoc:isConstituentOf a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:comment "Relation between some particular and the object that it makes up."@en ;
    rdfs:subPropertyOf gsoc:isPersistentPartOf ;
    owl:inverseOf gsoc:hasConstituent .

gsoc:mutuallySpecDependsOn a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:comment "Mutual specific dependence: the relata specifically depend on each other."@en ;
    rdfs:subPropertyOf gsoc:specificallyDependsOn .

gsoc:occupiesSpace a owl:ObjectProperty ;
    rdfs:comment "Occupation of a region of space, directly or indirectly"@en ;
    rdfs:domain [ a owl:Class ;
            owl:complementOf [ a owl:Class ;
                    owl:unionOf ( gsoc:Notional_Endurant gsoc:Spatial_Region ) ] ] ;
    rdfs:range gsoc:Spatial_Region ;
    rdfs:subPropertyOf gsoc:occupies,
        gsoc:spatiallyEquals ;
    owl:inverseOf gsoc:spaceOccupiedBy .

gsoc:occupiesTime a owl:ObjectProperty ;
    rdfs:comment "Occupation of a region of time, directly or indirectly"@en ;
    rdfs:domain [ a owl:Class ;
            owl:complementOf [ a owl:Class ;
                    owl:unionOf ( gsoc:Abstract_Endurant gsoc:Time_Region ) ] ] ;
    rdfs:range gsoc:Time_Region ;
    rdfs:subPropertyOf gsoc:occupies,
        gsoc:timeEquivalentTo ;
    owl:inverseOf gsoc:timeOccupiedBy .

gsoc:timeIncludedBy a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:subPropertyOf gsoc:timeInclusion ;
    owl:inverseOf gsoc:timeIncludes .

gsoc:timeIncludes a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:subPropertyOf gsoc:timeInclusion .

gsoc:timeYoungerThan a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:comment "Age associated with subject is entirely after the age associated with object"@en,
        "Event A is younger than event B if A has occurred after  B.  Same as Allen A After B.  (Burns, 1975; Mathematical Geology, Vol. 7, No. 4)"@en ;
    rdfs:subPropertyOf gsoc:isTemporallyRelatedTo .

gsoc:Abstract_Endurant a owl:Class ;
    rdfs:comment "Abstract endurants do not occupy space nor time - they are aspatial and atemporal, e.g. numbers and other mathematical objects"@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty gsoc:occupiesTime ;
                    owl:someValuesFrom gsoc:Time_Region ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Abstract_Endurant ;
            owl:onProperty gsoc:hasPart ],
        gsoc:Notional_Endurant ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Notional_Endurant [ a owl:Class ;
                        owl:complementOf [ a owl:Restriction ;
                                owl:onProperty gsoc:occupiesTime ;
                                owl:someValuesFrom gsoc:Time_Region ] ] ) ] .

gsoc:Endurant_Feature a owl:Class ;
    rdfs:label "Endurant Feature "@en ;
    rdfs:comment "Feature constituted by a spatial or aspatial endurant."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty gsoc:hostedBy ;
            owl:someValuesFrom gsoc:Particular ],
        gsoc:Feature ;
    owl:disjointWith gsoc:Perdurant_Feature ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Feature [ a owl:Restriction ;
                        owl:onProperty gsoc:hasEssentialPart ;
                        owl:someValuesFrom gsoc:Endurant ] [ a owl:Restriction ;
                        owl:allValuesFrom gsoc:Endurant ;
                        owl:onProperty gsoc:hasEssentialPart ] ) ] .

gsoc:Physical_Quality a owl:Class ;
    rdfs:label "Physical Quality "@en ;
    rdfs:comment "Quantifiers for dimensions of spatial regions or for location of spatial region in some reference frame."@en ;
    rdfs:subClassOf gsoc:Quality ;
    owl:disjointWith gsoc:Temporal_Quality ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Quality [ a owl:Restriction ;
                        owl:onProperty gsoc:isQualityOf ;
                        owl:someValuesFrom gsoc:Physical_Endurant ] ) ] .

gsoc:Range_Value a owl:Class ;
    rdfs:label "Quality Range "@en ;
    rdfs:comment "A range value for some quality, e.g. 2.0-3.0 or thin-thick"@en ;
    rdfs:subClassOf gsoc:Quality_Value ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Quality_Value [ a owl:Restriction ;
                        owl:onProperty gsoc:hasEndValue ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( gsoc:Measure_Value gsoc:Named_Value ) ] ] [ a owl:Restriction ;
                        owl:onProperty gsoc:hasStartValue ;
                        owl:someValuesFrom [ a owl:Class ;
                                owl:unionOf ( gsoc:Measure_Value gsoc:Named_Value ) ] ] ) ] .

gsoc:State_Of_Matter a owl:Class ;
    rdfs:label "State of Matter"@en ;
    rdfs:comment "State of matter qualities include State_Of_Matter_Value and should also include the pressure and temperature conditions that apply. If none are stated, default is standard temperature and pressure. Since 1982, STP is defined as a temperature of 273.15 K (0 °C, 32 °F) and an absolute pressure of exactly 105 Pa (100 kPa, 1 bar) (https://en.wikipedia.org/wiki/Standard_conditions_for_temperature_and_pressure)"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty gsoc:isQualityOf ;
            owl:someValuesFrom gsoc:Amount_Of_Matter ],
        gsoc:Physical_Quality .

gsoc:Temporal_Location a owl:Class ;
    rdfs:label "Temporal location "@en ;
    rdfs:comment "The location of a time region within a temporal reference system. Has temporal values such as 21 Jan 2020 or 100 Ma - 200 Ma."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Time_Region ;
            owl:onProperty gsoc:isQualityOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( gsoc:Temporal_Range gsoc:Temporal_Value ) ] ;
            owl:onProperty gsoc:hasValue ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:isQualityOf ;
            owl:someValuesFrom gsoc:Time_Region ],
        gsoc:Temporal_Quality .

gsoc:Time_Interval a owl:Class ;
    rdfs:label "Time Interval"@en ;
    rdfs:comment "A region of time that has a duration greater than 0."@en,
        "Time intervals are continuous without gaps."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty gsoc:hasQuality ;
            owl:someValuesFrom gsoc:Time_Interval_Location ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:specificallyDependsOn ;
            owl:someValuesFrom gsoc:Time_Interval_Location ],
        gsoc:Time_Region .

gsoc:hasConstituent a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:comment "Relation between an object and something (the consitituent)  that makes up the object."@en ;
    rdfs:subPropertyOf gsoc:hasPersistentPart ;
    owl:inverseOf gsoc:isConstituentOf .

gsoc:isReferenceSystemFor a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:comment "Directed relation between a referene system and a quality value."@en ;
    rdfs:domain gsoc:Reference_System ;
    rdfs:range gsoc:Quality_Value ;
    rdfs:subPropertyOf gsoc:reference .

gsoc:isTemporallyRelatedTo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:comment "Most general undirected temporal relation holding between non-abstract things, that exist in time. Temporal relationships occurr between things that directly or indirectly occupy temporal regions - the association is evaluated on the regions being occupied, but the domain and range are the occupying entities"@en ;
    rdfs:domain [ a owl:Class ;
            owl:complementOf gsoc:Abstract_Endurant ] ;
    rdfs:range [ a owl:Class ;
            owl:complementOf gsoc:Abstract_Endurant ] ;
    rdfs:subPropertyOf gsoc:isRelatedTo .

gsoc:Temporal_Quality a owl:Class ;
    rdfs:label "Temporal Quality"@en ;
    rdfs:comment "Quality that specifies the temporal location or duration that is the extent of some TimeRegion"@en ;
    rdfs:subClassOf gsoc:Quality ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Quality [ a owl:Restriction ;
                        owl:onProperty gsoc:isQualityOf ;
                        owl:someValuesFrom gsoc:Perdurant ] ) ] .

gsoc:genericallyDependsOn a owl:ObjectProperty ;
    rdfs:comment "Directed generic ontological dependence relation in which something relies on something else of a certain type; excludes self-dependence and other edge problematic cases, and is atemporal (relata need not co-exist in time). Note the relation cannot be more explicitly defined in this notation." ;
    rdfs:subPropertyOf gsoc:dependsOn .

gsoc:hasDataValue a owl:DatatypeProperty ;
    rdfs:comment "Directed relation between a measure value and a simple data type - xsd:anySimpleType - e.g. as a number, string, or date."@en ;
    rdfs:domain gsoc:Measure_Value ;
    rdfs:range xsd:anySimpleType ;
    rdfs:subPropertyOf gsoc:isFundamentallyRelatedTo .

gsoc:isFundamentallyRelatedTo a rdf:Property,
        owl:SymmetricProperty ;
    rdfs:comment "Most general domain-neutral relation (e.g. non-spatial, non-temporal, non-geological,...)"@en ;
    rdfs:subPropertyOf gsoc:isRelatedTo .

gsoc:Temporal_Value a owl:Class ;
    rdfs:label "Temporal Value "@en ;
    rdfs:comment "Quality that specifies a temporal location"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Temporal_Reference_System ;
            owl:onProperty gsoc:hasReferenceSystem ],
        gsoc:Measure_Value ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Measure_Value [ a owl:Restriction ;
                        owl:allValuesFrom gsoc:Temporal_Location ;
                        owl:onProperty gsoc:isValueOf ] ) ] .

gsoc:hasDependent a owl:ObjectProperty ;
    rdfs:label "has dependent"@en ;
    rdfs:comment "Directed relation between a dependee (the thing being relied on) and the dependent (the thing that relies on something)."@en ;
    rdfs:subPropertyOf gsoc:dependance ;
    owl:inverseOf gsoc:dependsOn .

gsoc:Named_Value a owl:Class ;
    rdfs:comment "A named value of some quality,e.g. thin or thick."@en ;
    rdfs:subClassOf gsoc:Quality_Value ;
    owl:disjointWith gsoc:Range_Value ;
    owl:equivalentClass [ a owl:Class ;
            owl:complementOf [ a owl:Class ;
                    owl:unionOf ( gsoc:Measure_Value gsoc:Range_Value ) ] ] .

gsoc:Reference_System a owl:Class ;
    rdfs:label "Reference System "@en ;
    rdfs:comment "Notional endurant that establishes a frame of reference for a quality value. Although typically mathematical,  it is not necessarily abstract, because some reference systems are dependent on non-abstract endurants located in space or time; e.g. a spatial coordinate system for the earth (tied to the Earth's ellipsoid), or a temporal coordinate system tied to the Earth's moon or sun (i.e. lunar or solar calendar)"@en ;
    rdfs:subClassOf gsoc:Notional_Endurant ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Notional_Endurant [ a owl:Restriction ;
                        owl:onProperty gsoc:isReferenceSystemFor ;
                        owl:someValuesFrom gsoc:Quality_Value ] ) ] .

gsoc:specificallyDependsOn a owl:ObjectProperty ;
    rdfs:comment "Directed specific ontological dependence in which something depends on something else, excluding self-dependence and other problematic border cases."@en ;
    rdfs:subPropertyOf gsoc:genericallyDependsOn .

gsoc:Notional_Endurant a owl:Class ;
    rdfs:label "Notional Endurant "@en ;
    rdfs:comment "Notional endurants do not occupy space, neither directly nor indirectly, e.g. ghosts, some dieties, or numbers. Notional endurants may occupy time (e.g. ghosts, assuming ghosts have finite existence), or may not occupy time (e.g. numbers, which are atemporal). Notional endurants can be part of physical things (e.g. when dieties are held to be part of people), but cannot have physical parts (e.g. when dieties do not have people as parts)."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty gsoc:occupiesSpace ;
                    owl:someValuesFrom gsoc:Spatial_Region ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Notional_Endurant ;
            owl:onProperty gsoc:hasPart ],
        gsoc:Nonphysical_Endurant ;
    owl:disjointWith gsoc:Relator ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Nonphysical_Endurant [ a owl:Class ;
                        owl:complementOf [ a owl:Restriction ;
                                owl:onProperty gsoc:occupiesSpace ;
                                owl:someValuesFrom gsoc:Spatial_Region ] ] ) ] .

gsoc:timeIntersects a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:subPropertyOf gsoc:isTemporallyRelatedTo .

gsoc:Amount_Of_Matter a owl:Class ;
    rdfs:comment "Amounts of matter refer to volumes of substances such as some gold, wood, iron, water, air, etc.  As per Lowe (1998), an amount of matter is either a chunk (unified \"part\") or heap (seperated and not unified \"piece\"). A unified chunk of matter is an integral whole (with a unifying condition),  is mereologically invariant (can gain or lose parts without loss of identity), is discretely countable (the number of gold ore bodies or sandstone layers can be enumerated),  has a single self-connected boundary upon which it is mutually ontologically dependent (the chunk cannot exist essentuially without the boundary, and the boundary cannot exist essentially without the chunk), and is a single entity (self-connected, unfragmented). Being an integral whole, a chunk of matter must then have some amount of matter as an essential part  (Brodaric et al. 2019). In contrast, a nonunified heap is mereologically variant, uncountable, and not dependent on a boundary, e.g. a heap of gold grains in an ore body or sand particles on a beach. Moreover, each unified chunk of matter is constituted by an ununified heap of matter, as well as possibly by particles of lower granularity, and can constitute larger amounts of matter or objects: e.g. an amount of mineral is a disaggreated heap of individual unit mineral cells made up by a certain configuration of atoms, and this heap of minerals makes up a single chunk of mineral locked together under binding conditions; the chunk in turn makes up a rock material, which makes up a formation. Note that both chunks and heaps can thus constitute objects: a gold ring is constituted by the chunk and its heap of gold, and a formation is constituted by both the sandstone and its heap of sand and other particles.  Even things that seem to be intrisically heaps, such as a dune, are constituted by both heaps and chunks of matter: e.g. by both a heap of sand particles and a chunk of sand (with a discrete shape and boundary). The chunk (of sand) differs from the object (the dune), in the sense that the dune has additional essential characteristics not held by the chunk, such as being a landform (i.e. located on the land surface), having a specific shape (hilly - even though the chunk has the shape, the shape is not essential to it, but is essential to the dune), and is formed by certain geomorphological processes such as wind or water flow (the sand chunk is formed by eroision and weathering). Distinguishing chunks from heaps is important to geology, as it enables chunks to have characteristics of unified matter, which otherwise would be restricted to objects, e.g. one could not then say, for example, some sandstone hosts a fault, but rather that the rock object part constituted by the sandstone hosts the fault. This then enables detailed representation of micro-scale geology, at the granularity of matter, in addition to representation of macro-scale entities such as units or basins."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Amount_Of_Matter ;
            owl:onProperty gsoc:hasPart ],
        [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Material_Endurant ;
            owl:onProperty gsoc:isConstituentOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Amount_Of_Matter ;
            owl:onProperty gsoc:hasConstituent ],
        gsoc:Material_Endurant ;
    owl:disjointWith gsoc:Material_Object ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Material_Endurant [ a owl:Restriction ;
                        owl:onProperty gsoc:hasQuality ;
                        owl:someValuesFrom gsoc:State_Of_Matter ] ) ] .

gsoc:Feature a owl:Class ;
    rdfs:label "Feature"@en ;
    rdfs:comment "A feature is  ontologically dependent on at least two distinct things, a host and some essential part, and emerges from some relation holding between them. E.g.  hole is hosted by some material entity and has spatial regions as parts (with regions changing as the host moves in space), and emerges from a spatial relation (adjacent containment) between them. A feature is made of parts of the same type, either endurants, perdurants, or possibly situations, so each feature is then itself also a perdurant, endurant or situation, e.g. a hole is also a spatial region."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Particular ;
            owl:onProperty gsoc:hasEssentialPart ],
        [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Particular ;
            owl:onProperty gsoc:hostedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Relator ;
            owl:onProperty gsoc:emergesFrom ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:emergesFrom ;
            owl:someValuesFrom gsoc:Relator ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:hasEssentialPart ;
            owl:someValuesFrom gsoc:Particular ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:hostedBy ;
            owl:someValuesFrom gsoc:Particular ],
        gsoc:Particular .

gsoc:Nonphysical_Endurant a owl:Class ;
    rdfs:label "Nonphysical Endurant"@en ;
    rdfs:comment "An endurant that does not occupy space directly, but might occupy space indirectly or not occupy space at all. Indirect spatial occupants have physical endurant parts or are ontologically dependent on physical endurants. Examples of things that indirectly occupy some space, due to such ontological dependence, include physical qualities (my height) and physical relators (reified physical relations). It even includes thoughts, poems, digital files, and datasets, whose existence is tied to being manifest in some physical object (brain, book, storage media). Also includes fictional entities such as unicorns, which must be so manifested to exist."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty gsoc:occupiesSpaceDirectly ;
                    owl:someValuesFrom gsoc:Spatial_Region ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Nonphysical_Endurant ;
            owl:onProperty gsoc:hasPart ],
        [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Nonphysical_Quality ;
            owl:onProperty gsoc:hasQuality ],
        gsoc:Endurant ;
    owl:disjointWith gsoc:Physical_Endurant ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Endurant [ a owl:Class ;
                        owl:complementOf [ a owl:Restriction ;
                                owl:onProperty gsoc:occupiesSpaceDirectly ;
                                owl:someValuesFrom gsoc:Spatial_Region ] ] ) ] .

gsoc:isSpatiallyRelatedTo a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:comment "Undirected most general spatial relation." ;
    rdfs:domain [ a owl:Class ;
            owl:complementOf gsoc:Notional_Endurant ] ;
    rdfs:range [ a owl:Class ;
            owl:complementOf gsoc:Notional_Endurant ] ;
    rdfs:subPropertyOf gsoc:isRelatedTo .

gsoc:Endurant a owl:Class ;
    rdfs:label "Endurant"@en ;
    rdfs:comment "The main characteristic of endurants is that they are fully present at any timepoint they exist, but they can change from one timepoint to another - something can be red at one time, and pink at another time. Endurants have onl;y endurants as parts."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Endurant ;
            owl:onProperty gsoc:hasPart ],
        [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Time_Region ;
            owl:onProperty gsoc:occupiesTimeIndirectly ],
        gsoc:Particular ;
    owl:disjointWith gsoc:Perdurant ;
    owl:equivalentClass [ a owl:Class ;
            owl:unionOf ( gsoc:Nonphysical_Endurant gsoc:Physical_Endurant ) ] .

gsoc:Role a owl:Class ;
    rdfs:label "Role  "@en ;
    rdfs:comment "Roles are played by a relata in a relation, e.g. a person plays the role of employee in an employs relation.  The relata playing the role is the RolePlayer and the other relata are RoleObjects. Because a role (Mary as employer, John as employee) is derived from a specific relation, e.g.  Mary employs John, it mutully depends on a specific reified relation instance (Relator - the employment of John by Mary). Roles carry qualities -  indeed, they are are a bundle of qualities."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty gsoc:hasRolePlayer ;
            owl:someValuesFrom gsoc:Particular ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:mutuallySpecDependsOn ;
            owl:someValuesFrom gsoc:Relator ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:hasRoleObject ;
            owl:someValuesFrom gsoc:Particular ],
        gsoc:Inherant ;
    owl:disjointWith [ a owl:Restriction ;
            owl:onProperty gsoc:hasPart ;
            owl:someValuesFrom gsoc:Particular ] ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Inherant [ a owl:Class ;
                        owl:complementOf [ a owl:Class ;
                                owl:unionOf ( gsoc:Quality gsoc:Quality_Value ) ] ] ) ] .

gsoc:hasStaticPart a owl:ObjectProperty ;
    rdfs:comment "The specifc individual that is a part must always be co-present with whole, cannot be exchanged nor missing, and whole is specifically dependent on it."@en ;
    rdfs:subPropertyOf gsoc:constantlySpecDependsOn,
        gsoc:hasPersistentPart ;
    owl:inverseOf gsoc:isStaticPartOf .

gsoc:Inherant a owl:Class ;
    rdfs:label "Inherant"@en ;
    rdfs:comment "An Inherent is a thing that occupies space indirectly and depends for its existence on some bearer. The inherent is associated with the bearer via the InheresIn relation. An Inherent is an Endurant because it is present in its totality at any time that it exists. Note: inherants are summative: our colour (the sum of your colour and mine) inheres in us (the sum of you and me)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Inherant ;
            owl:onProperty gsoc:hasPart ],
        gsoc:Nonphysical_Endurant ;
    owl:disjointWith gsoc:Notional_Endurant,
        gsoc:Relator ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Nonphysical_Endurant [ a owl:Restriction ;
                        owl:onProperty gsoc:inheresIn ;
                        owl:someValuesFrom gsoc:Particular ] ) ] .

gsoc:Relator a owl:Class ;
    rdfs:label "Relator "@en ;
    rdfs:comment "A relator is a reified relation: e.g. parthood reifying the whole-part relation, or meeting reifying the meets relation. Consists of static parts only, which are the roles played by each relata in the relation (with min 2 for a binary relation). A relator is thus specifically (statically) dependent on each role / part (min 2) and on each relata (min 2). Relators can also have qualities, which are also not parts, such as the intensity of the relation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Role ;
            owl:onProperty gsoc:hasPart ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:hasStaticPart ;
            owl:someValuesFrom gsoc:Role ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:mutuallySpecDependsOn ;
            owl:someValuesFrom gsoc:Role ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:specificallyDependsOn ;
            owl:someValuesFrom gsoc:Particular ],
        gsoc:Nonphysical_Endurant ;
    owl:disjointWith [ a owl:Class ;
            owl:intersectionOf ( [ a owl:Class ;
                        owl:complementOf [ a owl:Restriction ;
                                owl:onProperty gsoc:hasStaticPart ;
                                owl:someValuesFrom gsoc:Particular ] ] [ a owl:Restriction ;
                        owl:onProperty gsoc:hasPart ;
                        owl:someValuesFrom gsoc:Particular ] ) ] ;
    owl:equivalentClass [ a owl:Class ;
            owl:complementOf [ a owl:Class ;
                    owl:unionOf ( gsoc:Inherant gsoc:Notional_Endurant ) ] ] .

gsoc:hasAnnotation a owl:AnnotationProperty ;
    rdfs:comment "Most general undirected relation for annotations and similar things."@en ;
    rdfs:subPropertyOf gsoc:isRelatedTo .

gsoc:isValueOf a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:comment "Relation between a quality value and its quality."@en ;
    rdfs:domain gsoc:Quality_Value ;
    rdfs:range gsoc:Quality ;
    rdfs:subPropertyOf gsoc:constantlySpecDependsOn,
        gsoc:isPersistentPartOf ;
    owl:inverseOf gsoc:hasValue .

gsoc:Event a owl:Class ;
    rdfs:label "Event"@en ;
    rdfs:comment "A event is the thing that happens (an earthquake), and a process is how it happens (the ground shaking). Events are constituted by processes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Event ;
            owl:onProperty gsoc:hasPart ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:genericallyDependsOn ;
            owl:someValuesFrom gsoc:Time_Region ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:occupiesTimeDirectly ;
            owl:someValuesFrom gsoc:Time_Region ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:hasParticipant ;
            owl:someValuesFrom gsoc:Endurant ],
        gsoc:Perdurant ;
    owl:disjointWith gsoc:Process,
        gsoc:Time_Region ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Perdurant [ a owl:Restriction ;
                        owl:onProperty gsoc:hasConstituent ;
                        owl:someValuesFrom gsoc:Process ] ) ] .

gsoc:Perdurant a owl:Class ;
    rdfs:label "Perdurant"@en ;
    rdfs:comment "A perdurant is something that is not fully present at any timepoint, in the sense that an event, process or temporal interval exists over time, while an endurant exists in time. Perdurants are  time regions, such as an interval or instant of time, or they are things that occur in time, such as events or processes. Perdurants have only perdurant parts, and can only have fixed qualities that have unchanging values (e.g. the duration of a time interval); if there is some quality that apparently changes for the perdurant, it is a fixed quality of a part of the perdurant, but is not a quality of the perdurant itself (e.g. the intensity of a process varies over the whole process, but has fixed values for certain time-indexed parts of the process)."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Perdurant ;
            owl:onProperty gsoc:hasPart ],
        [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Spatial_Region ;
            owl:onProperty gsoc:occupiesSpaceIndirectly ],
        [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Temporal_Quality ;
            owl:onProperty gsoc:hasQuality ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Restriction ;
                    owl:allValuesFrom [ a owl:Restriction ;
                            owl:onProperty gsoc:isStaticValueOf ;
                            owl:someValuesFrom gsoc:Temporal_Quality ] ;
                    owl:onProperty gsoc:hasValue ] ;
            owl:onProperty gsoc:hasQuality ],
        gsoc:Particular ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Particular [ a owl:Class ;
                        owl:unionOf ( gsoc:Time_Region [ a owl:Restriction ;
                                    owl:onProperty gsoc:occupiesTimeDirectly ;
                                    owl:someValuesFrom gsoc:Time_Region ] ) ] ) ] .

gsoc:Physical_Endurant a owl:Class ;
    rdfs:label "Physical Endurant"@en ;
    rdfs:comment "An endurant that occupies space directly."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Physical_Endurant ;
            owl:onProperty gsoc:hasPart ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:constantlySpecDependsOn ;
            owl:someValuesFrom gsoc:Physical_Quality ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:occupiesTimeIndirectly ;
            owl:someValuesFrom gsoc:Time_Region ],
        gsoc:Endurant ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Endurant [ a owl:Class ;
                        owl:unionOf ( gsoc:Spatial_Region [ a owl:Restriction ;
                                    owl:onProperty gsoc:occupiesSpaceDirectly ;
                                    owl:someValuesFrom gsoc:Spatial_Region ] ) ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( gsoc:Endurant [ a owl:Restriction ;
                        owl:allValuesFrom gsoc:Physical_Quality ;
                        owl:onProperty gsoc:hasQuality ] ) ] .

gsoc:Process a owl:Class ;
    rdfs:label "Process"@en ;
    rdfs:comment "A event is the thing that happens (an earthquake), and a process is how it happens (the ground shaking). Events are constituted by processes."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Event ;
            owl:onProperty gsoc:isConstituentOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Process ;
            owl:onProperty gsoc:hasPart ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:genericallyDependsOn ;
            owl:someValuesFrom gsoc:Time_Region ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:occupiesTimeDirectly ;
            owl:someValuesFrom gsoc:Time_Region ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:hasParticipant ;
            owl:someValuesFrom gsoc:Endurant ],
        gsoc:Perdurant ;
    owl:disjointWith gsoc:Time_Region ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Perdurant [ a owl:Class ;
                        owl:complementOf [ a owl:Class ;
                                owl:unionOf ( gsoc:Event gsoc:Time_Region ) ] ] ) ] .

gsoc:Quality a owl:Class ;
    rdfs:label "Quality"@en ;
    rdfs:comment "A colour, mass, density, etc., that inheres in its bearer. Must have some quality values, and only quality values, as persistent parts, e.g. red or 2.0. These values can change over time, but can't be missing (i.e. a quality must a value to exist and retain identity). This means qualities cannot pause their existence: once they carry no value they cease to exist and cannot exist again, and if a similar quality resurfaces, it would be a different quality. For example, a sponge might have alternating qualities of softness (when wet) and hardness (when dry), with each  being a distinct quality. Qualities can only have values as parts, not other things, but they can possess qualities, such as colour having the qualities hue, value, situation."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Quality_Value ;
            owl:onProperty gsoc:hasPart ],
        [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Quality_Value ;
            owl:onProperty gsoc:hasValue ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:isQualityOf ;
            owl:someValuesFrom gsoc:Particular ],
        gsoc:Inherant ;
    owl:disjointWith gsoc:Quality_Value,
        gsoc:Role ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Inherant [ a owl:Restriction ;
                        owl:onProperty gsoc:hasValue ;
                        owl:someValuesFrom gsoc:Quality_Value ] ) ] .

gsoc:isQualityOf a owl:ObjectProperty ;
    rdfs:comment "Relation between a quality and the thing that carries the quality, e.g. between a thickness quality and its rock body."@en ;
    rdfs:domain gsoc:Quality ;
    rdfs:subPropertyOf gsoc:inheresIn .

gsoc:Measure_Value a owl:Class ;
    rdfs:label "Measure Value"@en ;
    rdfs:comment "A determinate value of a quality. SubClasses for numeric, spatial coordinate, and temporal coordinate value types. Use this generic value type for free text values e.g. \"some text\". Categorical values should be subclassed from gsoc:Named_Value"@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty gsoc:hasQuality ;
            owl:someValuesFrom gsoc:Uncertainty ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:hasUOM ;
            owl:someValuesFrom gsoc:Unit_Of_Measure_Value ],
        gsoc:Quality_Value ;
    owl:disjointWith gsoc:Named_Value,
        gsoc:Range_Value ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Quality_Value [ a owl:Restriction ;
                        owl:onDataRange xsd:anySimpleType ;
                        owl:onProperty gsoc:hasDataValue ;
                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ] ) ] .

gsoc:Material_Endurant a owl:Class ;
    rdfs:label "Material Endurant"@en ;
    rdfs:comment "Material endurants are physical things that occupy space (e.g. a rock), but are not the spatial region being occupied."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Material_Endurant ;
            owl:onProperty gsoc:hasPart ],
        gsoc:Physical_Endurant ;
    owl:disjointWith gsoc:Spatial_Region ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Physical_Endurant [ a owl:Restriction ;
                        owl:onProperty gsoc:occupiesSpaceDirectly ;
                        owl:someValuesFrom gsoc:Spatial_Region_3D ] ) ] .

gsoc:hasQuality a owl:ObjectProperty ;
    rdfs:comment "Directed relation between something and a quality that is carried by it."@en ;
    rdfs:range gsoc:Quality ;
    rdfs:subPropertyOf gsoc:hasInherant ;
    owl:inverseOf gsoc:isQualityOf .

gsoc:hasValue a owl:AsymmetricProperty,
        owl:ObjectProperty ;
    rdfs:comment "top level property for assigning property values; subtype for particular kinds of values (integer, category, number boolean...) "@en ;
    rdfs:domain gsoc:Quality ;
    rdfs:range gsoc:Quality_Value ;
    rdfs:subPropertyOf gsoc:hasPersistentPart ;
    owl:inverseOf gsoc:isValueOf .

gsoc:hostedBy a owl:ObjectProperty ;
    rdfs:comment "The relation of hosting a feature, such the material object that hosts a hole."@en ;
    rdfs:domain gsoc:Feature ;
    rdfs:subPropertyOf gsoc:genericallyDependsOn ;
    owl:inverseOf gsoc:hosts .

gsoc:Quality_Value a owl:Class ;
    rdfs:label "Quality Value"@en ;
    rdfs:comment "A value of (essential part of) a quality; can be a measured value (e.g. 2.0), named value (e.g. thick), or a range (e.g. 2.0-2.2 or thin-thick). Values exist within a reference system." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty gsoc:hasReferenceSystem ;
            owl:someValuesFrom gsoc:Reference_System ],
        gsoc:Inherant ;
    owl:disjointWith [ a owl:Restriction ;
            owl:onProperty gsoc:hasPart ;
            owl:someValuesFrom gsoc:Particular ],
        gsoc:Role ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Inherant [ a owl:Restriction ;
                        owl:onProperty gsoc:isValueOf ;
                        owl:someValuesFrom gsoc:Quality ] ) ] .

gsoc:Spatial_Region a owl:Class ;
    rdfs:label "Spatial Region"@en ;
    rdfs:comment "A chunk of space, either 0-3 dimensional."@en ;
    rdfs:subClassOf [ a owl:Class ;
            owl:complementOf [ a owl:Restriction ;
                    owl:onProperty gsoc:hasConstituent ;
                    owl:someValuesFrom gsoc:Material_Endurant ] ],
        [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Material_Endurant ;
            owl:onProperty gsoc:spaceOccupiedDirectlyBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Spatial_Region ;
            owl:onProperty gsoc:hasPart ],
        gsoc:Physical_Endurant ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Physical_Endurant [ a owl:Class ;
                        owl:complementOf [ a owl:Restriction ;
                                owl:onProperty gsoc:hasConstituent ;
                                owl:someValuesFrom gsoc:Material_Endurant ] ] ) ],
        [ a owl:Class ;
            owl:intersectionOf ( gsoc:Physical_Endurant [ a owl:Restriction ;
                        owl:onProperty gsoc:hasQuality ;
                        owl:someValuesFrom gsoc:Spatial_Location ] ) ] .

gsoc:hasPart a owl:ObjectProperty ;
    rdfs:comment "Standard directed relation between a whole and a part; the part could be proper or improper."@en ;
    rdfs:subPropertyOf gsoc:parthood ;
    owl:inverseOf gsoc:isPartOf .

gsoc:Time_Region a owl:Class ;
    rdfs:label "Time Region"@en ;
    rdfs:comment "A chunk of time, either an instant or interval, with a temporal location quality."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Time_Region ;
            owl:onProperty gsoc:hasPart ],
        [ a owl:Restriction ;
            owl:allValuesFrom [ a owl:Class ;
                    owl:unionOf ( gsoc:Event gsoc:Process ) ] ;
            owl:onProperty gsoc:timeOccupiedDirectlyBy ],
        [ a owl:Restriction ;
            owl:onProperty gsoc:specificallyDependsOn ;
            owl:someValuesFrom gsoc:Temporal_Location ],
        gsoc:Perdurant ;
    owl:equivalentClass [ a owl:Class ;
            owl:intersectionOf ( gsoc:Perdurant [ a owl:Restriction ;
                        owl:onProperty gsoc:hasQuality ;
                        owl:someValuesFrom gsoc:Temporal_Location ] ) ] .

gsoc:Particular a owl:Class ;
    rdfs:label "Particular"@en ;
    rdfs:comment "Any individual, e.g. this rock or that event. Individuals are not types and cannot have instances."@en ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Feature ;
            owl:onProperty gsoc:hosts ],
        [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Inherant ;
            owl:onProperty gsoc:hasInherant ],
        [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Particular ;
            owl:onProperty gsoc:determinedBy ],
        [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Particular ;
            owl:onProperty gsoc:isExampleOf ],
        [ a owl:Restriction ;
            owl:allValuesFrom gsoc:Situation ;
            owl:onProperty gsoc:hasSetting ] .

gsoc:hasEssentialPart a owl:ObjectProperty ;
    rdfs:comment "The whole is generically dependent on this part, which must be present at some time during the whole, but not necessarilly all times, and can be exchanged - all without loss of identity for the whole."@en ;
    rdfs:subPropertyOf gsoc:genericallyDependsOn,
        gsoc:hasPart .

