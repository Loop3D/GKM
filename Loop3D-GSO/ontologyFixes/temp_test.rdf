  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfoliation/metamorphic_layering_inherited_from_protolith">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Metamorphic layering in which layer differntiation is relict of compositional variations in the protolith, typically heterogeneous sedimentary or volcanic rock.</rdfs:comment>
