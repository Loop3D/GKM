    <dct:bibliographicCitation>Brodaric, B., and Richard, S.M., 2021, The GeoScience Ontology Reference: Geological Survey of Canada Open File 8796, 34 p., https://doi.org/10.4095/328296</dct:bibliographicCitation>
    <skos:definition xml:lang="en">Roles geologic entities can play in relations</skos:definition>
    <skos:prefLabel xml:lang="en">Geoscience Ontology, Geologic Role</skos:prefLabel>
  </rdf:Description>
