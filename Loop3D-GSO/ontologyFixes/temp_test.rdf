  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Calcareous_Carbonate_Sedimentary_Material">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Carbonate_Sedimentary_Material"/>
    <dct:source xml:lang="en">after Hallsworth and Knox 1999</dct:source>
    <rdfs:comment xml:lang="en">Carbonate sedimentary material of unspecified consolidation state with a calcite (plus aragonite) to dolomite ratio greater than 1 to 1. Includes lime-sediments, limestone and dolomitic limestone.</rdfs:comment>
    <rdfs:label xml:lang="en">calcareous carbonate sedimentary material</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Deformation_Twinning">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf, K.K.E, Mehl, J.P. &amp; Jackson, J.A. (eds), 2005. Glossary of geology, 5th Edition. American Geological Institute, Alexandria, 779 p.</dct:source>
    <rdfs:comment xml:lang="en">Deformation of a crystal by gliding to produce crystallographic twinning.</rdfs:comment>
    <rdfs:label xml:lang="en">deformation twinning</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Transformation"/>
  </rdf:Description>
