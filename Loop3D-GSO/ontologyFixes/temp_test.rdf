  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfoliation/primary_foliation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Foliation formed during original process of deposition or crystallization of an igneous or sedimentary material.</rdfs:comment>
    <dct:source xml:lang="en">CGI foliationtype SKOS vocabulary 2018-08-03</dct:source>
    <rdfs:label xml:lang="en">primary foliation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicstructure/Foliation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/isc2004-04">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Scale"/>
    <rdfs:comment xml:lang="en">RDF/OWL representation of the 2004-04 edition of the International Chronostratigraphic Chart from the International Commission on Stratigraphy. encoded using OWL implementation from GSO. Adapted from Cox&amp;Richard OWL GeologicTime ontology</rdfs:comment>
    <rdfs:comment xml:lang="en">dc:source  International  Chronostratigraphic Chart 2004</rdfs:comment>
    <rdfs:label xml:lang="en">International Chronostratigraphic Chart (2004)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/Bajocian2017">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologictime/Age"/>
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Specific_Geologic_Time_Unit"/>
    <rdfs:comment xml:lang="en">older bound -170.3 +|-1.4 Ma</rdfs:comment>
    <rdfs:comment xml:lang="en">younger bound -168.3 +|-1.3 Ma</rdfs:comment>
    <rdfs:label xml:lang="en">Bajocian Age</rdfs:label>
