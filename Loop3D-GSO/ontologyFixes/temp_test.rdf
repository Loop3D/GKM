  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/Spatial_Location">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A physical property that specifies the position of an entity relative to some spatial reference system. Use WKT strings (ogc:WKTLiteral, https://www.w3.org/2011/02/GeoSPARQL.pdf)  as data values.</rdfs:comment>
    <rdfs:label xml:lang="en">Spatial Location</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Physical_Quality"/>
    <rdfs:subClassOf rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b172"/>
