    <gsoc:nextTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Mississippian2017"/>
    <gsoc:nextTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Tournaisian2017"/>
