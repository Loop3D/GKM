    <gsoc:timeEquivalentTo rdf:resource="https://w3id.org/gso/1.0/geologictime/BaseUpperTriassic"/>
    <rdfs:label xml:lang="en">shared boundary with BaseUpperTriassic</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Grading">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">this vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Leveling of earth surface by rearrangement of prexisting material</rdfs:comment>
    <rdfs:label xml:lang="en">grading</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicprocess/Human_Activity"/>
