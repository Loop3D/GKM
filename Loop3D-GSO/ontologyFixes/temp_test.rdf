  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/State_Of_Matter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">State of matter qualities include State_Of_Matter_Value and should also include the pressure and temperature conditions that apply. If none are stated, default is standard temperature and pressure. Since 1982, STP is defined as a temperature of 273.15 K (0 °C, 32 °F) and an absolute pressure of exactly 105 Pa (100 kPa, 1 bar) (https://en.wikipedia.org/wiki/Standard_conditions_for_temperature_and_pressure)</rdfs:comment>
    <rdfs:label xml:lang="en">State of Matter</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Physical_Quality"/>
    <rdfs:subClassOf rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b188"/>
  </rdf:Description>
