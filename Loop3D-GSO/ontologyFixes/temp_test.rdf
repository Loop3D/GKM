  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Ductile_Flattening">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Also known as pure shear; a three-dimensional homogeneous flattening of a body (http://www.geology.sdsu.edu/visualstructure/vss/htm_hlp/pure_s.htm) accomodated by ductile deformation. It is an example of irrotational strain in which body is elongated in one direction while being shortened perpendicularly (https://en.wikipedia.org/wiki/Pure_shear).</rdfs:comment>
    <rdfs:label xml:lang="en">Ductile Flattening</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicprocess/Ductile_Flow"/>
  </rdf:Description>
