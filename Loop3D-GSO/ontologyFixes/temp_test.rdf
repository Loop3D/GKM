    <rdfs:comment xml:lang="en">younger bound -443.7 +|-1.5 Ma</rdfs:comment>
    <rdfs:label xml:lang="en">Ordovician Period</rdfs:label>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/geologictime/OrdovicianPeriod"/>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/ischart/isc2004-04"/>
