    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Geologic Process</rdfs:label>
    <rdfs:comment xml:lang="en">A process that has inputs and or outputs that are part of the Earth System</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="n099faa0fcafa464dac687bd05be17dc4b156"/>
