  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfoliation/mylonite_foliation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Generic mylonitic foliation in which 50-90 percent of rock is matrix due to tectonic grain size reduction processes. Planar fabric is very apparent due to flattening of mineral grains, development of shear surfaces, and alignment of tabular mineral grains. Lineation is typically present and easily observed.</rdfs:comment>
    <dct:source xml:lang="en">NADM metamorphic rock vocabulary (https://pubs.usgs.gov/of/2004/1451/sltt/appendixB/appendixB.pdf) SLTTm1.0 2004,  Sibson 1977</dct:source>
    <rdfs:label xml:lang="en">mylonite foliation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfoliation/generic_mylonitic_foliation"/>
  </rdf:Description>
