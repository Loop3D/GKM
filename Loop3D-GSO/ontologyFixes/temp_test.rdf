  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Impure_Limestone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Calcareous_Carbonate_Sedimentary_Rock"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Impure_Carbonate_Sedimentary_Rock"/>
    <dct:source xml:lang="en">This vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Impure carbonate sedimentary rock with a calcite (plus aragonite) to dolomite ratio greater than 1 to 1.</rdfs:comment>
    <rdfs:label xml:lang="en">impure limestone</rdfs:label>
    <skos:altLabel xml:lang="en">calcareous marlstone</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/Lopingian2004">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologictime/Epoch"/>
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Specific_Geologic_Time_Unit"/>
    <rdfs:comment xml:lang="en">older bound -260.4 +|-0.7 Ma</rdfs:comment>
    <rdfs:comment xml:lang="en">younger bound -251.0 +|-0.4 Ma</rdfs:comment>
    <rdfs:label xml:lang="en">Lopingian Epoch</rdfs:label>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/geologictime/LopingianEpoch"/>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/ischart/isc2004-04"/>
    <gsoc:nextTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Induan2004"/>
