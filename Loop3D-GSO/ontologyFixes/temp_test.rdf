    <owl:disjointWith rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Date"/>
    <owl:equivalentClass rdf:nodeID="n099faa0fcafa464dac687bd05be17dc4b179"/>
  </rdf:Description>
