    <rdfs:label xml:lang="en">Geoscience Ontology, Geologic Features</rdfs:label>
    <skos:definition xml:lang="en">Ontology to define geological features that are not structures</skos:definition>
    <skos:prefLabel xml:lang="en">Geoscience Ontology, Geologic Features</skos:prefLabel>
  </rdf:Description>
