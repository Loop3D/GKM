    <gsoc:timeStarts rdf:resource="https://w3id.org/gso/1.0/geologictime/BaseCenozoic"/>
    <rdfs:comment xml:lang="en">Interval for grouping all specific instances of the Paleogene Period</rdfs:comment>
    <rdfs:label xml:lang="en">Paleogene Period</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/element/neptunium">
