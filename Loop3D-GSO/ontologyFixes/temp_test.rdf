    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/ischart/isc2020-01"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Exotic_Alkaline_Rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Exotic_Composition_Igneous_Rock"/>
    <dct:source xml:lang="en">based on LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Kimberlite, lamproite, or lamprophyre. Generally are potassic, mafic or ultramafic rocks. Olivine (commonly serpentinized in kimberlite), and phlogopite are significant constituents.</rdfs:comment>
    <rdfs:label xml:lang="en">exotic alkaline rock</rdfs:label>
  </rdf:Description>
