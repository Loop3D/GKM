  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Subduction_Zone_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Tectonic setting at which a tectonic plate, usually oceanic, is moving down into the mantle beneath another overriding plate.</rdfs:comment>
    <rdfs:label xml:lang="en">subduction zone setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Plate_Margin_Setting"/>
  </rdf:Description>
