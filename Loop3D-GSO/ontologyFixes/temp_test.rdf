  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologictime/BaseAalenian">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Boundary"/>
    <gsoc:timeEquivalentTo rdf:resource="https://w3id.org/gso/1.0/geologictime/BaseMiddleJurassic"/>
