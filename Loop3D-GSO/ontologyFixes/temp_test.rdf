  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Mantle_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al., 2005</dct:source>
    <rdfs:comment xml:lang="en">The zone of the Earth below the crust and above the core, which is divided into the upper mantle and the lower mantle, with a transition zone separating them.</rdfs:comment>
    <rdfs:label xml:lang="en">mantle setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Planet_Interior_Setting"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Tectonic_Setting"/>
    <rdfs:subClassOf rdf:nodeID="n50ae2bf5eccd483b885316dab32dfbd1b41"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologiccontact/Magnetic_Susceptiblity_Contact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI contacttype SKOS vocabulary 2012-11-24</dct:source>
    <rdfs:comment xml:lang="en">A magnetic contact between bodies of material distinguished based on magnetic susceptibility characteristics.</rdfs:comment>
    <rdfs:label xml:lang="en">magnetic susceptiblity contact</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologiccontact/Magnetic_Contact"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Sedimentary_Massive_Sulphide">
