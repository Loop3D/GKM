    <dct:source xml:lang="en">after LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Igneous rock with between 45 and 52 percent SiO2.</rdfs:comment>
    <rdfs:label xml:lang="en">basic igneous rock</rdfs:label>
  </rdf:Description>
