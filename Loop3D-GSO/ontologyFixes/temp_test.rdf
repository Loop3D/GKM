  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfoliation/c_fabric">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Ductile shear banding foliation defined by spaced, discrete planar zones of high strain less than 1mm thick. Commonly associated with a particle flattening ('S') fabric to form a mylonitic foliation.</rdfs:comment>
    <dct:source xml:lang="en">Geoscience Victoria, Australia</dct:source>
    <rdfs:label xml:lang="en">c fabric</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfoliation/ductile_shear_banding_foliation"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8a923d1ff2a643c7adbaefc5fab5e81eb31">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/gso/1.0/common/hasRoleObject"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/gso/1.0/geology/Rock_Material"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfault/Wrench_Fault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">GGIC vocabularies working group (Australia)</dct:source>
    <rdfs:comment xml:lang="en">A strike slip fault in which the fault plane dips at least 45 degrees over more than half of the recognized extent of the fault.</rdfs:comment>
    <rdfs:label xml:lang="en">wrench fault</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfault/High_Angle_Fault"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfault/Strike_Slip_Fault"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/Hauterivian2020">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologictime/Age"/>
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Specific_Geologic_Time_Unit"/>
    <rdfs:comment xml:lang="en">older bound -132.6 Ma</rdfs:comment>
    <rdfs:comment xml:lang="en">younger bound -129.4 Ma</rdfs:comment>
    <rdfs:label xml:lang="en">Hauterivian Age</rdfs:label>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/geologictime/HauterivianAge"/>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/ischart/isc2020-01"/>
    <gsoc:nextTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Barremian2017"/>
    <gsoc:previousTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Valanginian2020"/>
    <gsoc:timeDuring rdf:resource="https://w3id.org/gso/1.0/ischart/LowerCretaceous2017"/>
    <gsoc:timeFinishedBy rdf:resource="https://w3id.org/gso/1.0/ischart/BaseBarremian2017"/>
    <gsoc:timeStartedBy rdf:resource="https://w3id.org/gso/1.0/ischart/BaseHauterivian2020"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/isSpatiallyRelatedTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:comment>Undirected most general spatial relation.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/isRelatedTo"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Biological_Reef_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al., 2005</dct:source>
    <rdfs:comment xml:lang="en">A ridgelike or moundlike structure, layered or massive, built by sedentary calcareous organisms, esp. corals, and consisting mostly of their remains, it is wave-resistant and stands topographically above the surrounding contemporaneously deposited sediment.</rdfs:comment>
    <rdfs:label xml:lang="en">biological reef setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Marine_Setting"/>
    <rdfs:subClassOf rdf:nodeID="n50ae2bf5eccd483b885316dab32dfbd1b7"/>
    <rdfs:subClassOf rdf:nodeID="n50ae2bf5eccd483b885316dab32dfbd1b8"/>
    <rdfs:subClassOf rdf:nodeID="n50ae2bf5eccd483b885316dab32dfbd1b9"/>
    <rdfs:subClassOf rdf:nodeID="n50ae2bf5eccd483b885316dab32dfbd1b10"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseGelasian2017">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Boundary"/>
    <rdfs:comment xml:lang="en">Gelasian is included in Pliocene until revisions in 2009, when it was moved to basal stage of Pleitocene. The GSSP was established before the revisions and is unchanged, so this is a boundary in the Pliocene until 2009, when it becomes base of Quaternary, Pleistocene, and Gelasian</rdfs:comment>
    <rdfs:label xml:lang="en">Base of Gelasian</rdfs:label>
    <gsoc:hasEssentialPart rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b394"/>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/ischart/isc2017-02"/>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/ischart/isc2020-01"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Backreef_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Biological_Reef_Setting"/>
    <dct:source xml:lang="en">Neuendorf et al., 2005</dct:source>
    <rdfs:comment xml:lang="en">The landward side of a reef. The term is often used adjectivally to refer to deposits within the restricted lagoon behind a barrier reef, such as the back-reef facies of lagoonal deposits. In some places, as on a platform-edge reef tract, back reef refers to the side of the reef away from the open sea, even though no land may be nearby</rdfs:comment>
    <rdfs:label xml:lang="en">backreef setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Biological_Reef_Setting"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nfc8a0206a38a4856aa36594b314ae7d7b6">
    <rdf:first rdf:resource="https://w3id.org/gso/1.0/common/Range_Value"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/Time_Region">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A chunk of time, either an instant or interval, with a temporal location quality.</rdfs:comment>
    <rdfs:label xml:lang="en">Time Region</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Perdurant"/>
    <rdfs:subClassOf rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b232"/>
    <rdfs:subClassOf rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b233"/>
    <rdfs:subClassOf rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b237"/>
    <rdfs:subClassOf rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b238"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Rock_Material"/>
    <dct:source xml:lang="en">Jackson, 1997; NADM C1 2004; Neuendorf et al 2005</dct:source>
    <rdfs:comment xml:lang="en">Consolidated aggregate of one or more EarthMaterials, or a body of undifferentiated mineral matter, or of solid organic material. Includes mineral aggregates such as granite, shale, marble; glassy matter such as obsidian; and organic material such a coal. Excludes unconsolidated materials.</rdfs:comment>
    <rdfs:label xml:lang="en">rock</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/hosts">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Direction relation of hosting a feature in which the feature is generically dependent on the host.</rdfs:comment>
    <rdfs:range rdf:resource="https://w3id.org/gso/1.0/common/Feature"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/hasDependent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/gso/1.0/common/hostedBy"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b428">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/common/Time_Instant"/>
    <gsoc:hasQuality rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b429"/>
  </rdf:Description>
