  <rdf:Description rdf:about="https://w3id.org/gso/1.0/granularmaterial/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-08-03</dct:created>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-26</dct:created>
    <dct:creator rdf:resource="https://w3id.org/gso/1.0/common/boyan_brodaric"/>
    <dct:creator rdf:resource="https://w3id.org/gso/1.0/common/stephen_richard"/>
    <dct:creator>CGI Concept Definition Task Group</dct:creator>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/legalcode"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-26</dct:modified>
    <dct:publisher>ARC Loop3D project;  https://loop3d.org/</dct:publisher>
    <dct:publisher>Geological Survey of Canada, Natural Resources Canada, Government of Canada</dct:publisher>
    <schema:codeRepository>https://github.com/Loop3D/GKM</schema:codeRepository>
    <dct:rights>Copyright (c) 2021 Government of Canada</dct:rights>
    <rdfs:comment xml:lang="en">This file contains the categories for describing granular materials-- constituents in a rock material that are a particular kind of particle, defined based on genesis and internal characteristics of the particles. The scheme is intended to be indepenent of the mineralogy of the particles to the extent possible.  Based in part on the 2016 SKOS-RDF version of the CGI  IUGS Commission for Geoscience Information (CGI) Geoscience Terminology Working Group Composition Category vocabulary. Terms to specify the nature of individual particles of each constituent in an aggregation, based mostly on their genesis. Examples include clasts, crystals, material fossil. Constituent type is determined based on the nature of the particles, and ideally is independent of the relationship between particles in a rock material aggregation (which would be roles).</rdfs:comment>
    <rdfs:label xml:lang="en">Geoscience Ontology, Granular constituents</rdfs:label>
    <dct:bibliographicCitation>Brodaric, B., and Richard, S.M., 2021, The GeoScience Ontology Reference: Geological Survey of Canada Open File 8796, 34 p., https://doi.org/10.4095/328296</dct:bibliographicCitation>
    <skos:definition xml:lang="en">Constituent particles constituting rock materials</skos:definition>
    <skos:prefLabel xml:lang="en">Geoscience Ontology, Granular Constituents</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfeature/Rock_Body_Bottom">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Constraint: rock body must be a stratigraphic unit for which 'top' and 'bottom' are meaningful.</rdfs:comment>
    <rdfs:label xml:lang="en">Rock Body Bottom</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Rock_Body_Boundary"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/altered_rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Metasomatic_Rock"/>
    <rdfs:comment xml:lang="en">Rock material has been changed by some subsurface alteration process, but the nature of the alteration is not specified.</rdfs:comment>
    <rdfs:label xml:lang="en">Altered, type not specified </rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologictime/BaseDrumian">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Boundary"/>
    <rdfs:comment xml:lang="en">Interval for grouping all specific instances of the Base of Drumian</rdfs:comment>
