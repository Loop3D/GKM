  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/specificallyDependsOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Directed specific ontological dependence in which something depends on something else, excluding self-dependence and other problematic border cases.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/genericallyDependsOn"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b736">
