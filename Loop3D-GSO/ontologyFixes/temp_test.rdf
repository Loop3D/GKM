    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Generic_Geologic_Time_Unit"/>
    <gsoc:timeStarts rdf:resource="https://w3id.org/gso/1.0/geologictime/BaseKatian"/>
    <rdfs:comment xml:lang="en">Interval for grouping all specific instances of the Katian Age</rdfs:comment>
    <rdfs:label xml:lang="en">Katian Age</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n8a923d1ff2a643c7adbaefc5fab5e81eb32">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/gso/1.0/common/hasRolePlayer"/>
