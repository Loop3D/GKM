  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Extinction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">this vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Process of disappearance of a species or higher taxon, so that it no longer exists anywhere or in the subsequent fossil record.</rdfs:comment>
    <rdfs:label xml:lang="en">extinction</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicprocess/Biological_Process"/>
  </rdf:Description>
