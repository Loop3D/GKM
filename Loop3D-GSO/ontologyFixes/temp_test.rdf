  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseCambrianSeries3SP2004">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologiccontact/Stratigraphic_Point"/>
    <rdfs:comment xml:lang="en">candidate sections are Wuliu-Zengjiayan (east Guizhou, China) and Split Mountain (Nevada, USA)</rdfs:comment>
    <rdfs:label xml:lang="en">Stratotype Point Base of Cambrian Stage 5</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://stratigraphy.org/gssps/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicrole/Enclave">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Cobbing, 2000, Barbarin, 1991</dct:source>
    <rdfs:comment xml:lang="en">General term for a polymineralic aggregate enclosed in a granitoid. Use when origin of inclusion as xenolith or a separate igneous phase is unclear.</rdfs:comment>
    <rdfs:label xml:lang="en">enclave</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicrole/Inclusion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologictime/RhyacianPeriod">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologictime/Period"/>
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Generic_Geologic_Time_Unit"/>
    <gsoc:timeStarts rdf:resource="https://w3id.org/gso/1.0/geologictime/BaseRhyacian"/>
    <rdfs:comment xml:lang="en">Interval for grouping all specific instances of the Rhyacian Period</rdfs:comment>
    <rdfs:label xml:lang="en">Rhyacian Period</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicrole/Clast">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Role for any fragment of material that is a constituent in a rock material; applies to fragments formed before lithification (e.g. sedimentary clasts) as well as fragments formed by in-place deformation of pre-existing rock (e.g. cataclastic fragments).</rdfs:comment>
    <rdfs:label xml:lang="en">Clast</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Part"/>
    <rdfs:subClassOf rdf:nodeID="n8a923d1ff2a643c7adbaefc5fab5e81eb1"/>
    <rdfs:subClassOf rdf:nodeID="n8a923d1ff2a643c7adbaefc5fab5e81eb2"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b244">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
