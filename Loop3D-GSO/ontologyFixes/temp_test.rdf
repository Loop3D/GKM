  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Boundstone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Carbonate_Sedimentary_Rock"/>
    <dct:source xml:lang="en">Hallsworth and Knox 1999; SLTTs 2004</dct:source>
    <rdfs:comment xml:lang="en">Sedimentary carbonate rock with preserved biogenic texture, whose original components were bound and encrusted together during deposition by the action of plants and animals during deposition, and remained substantially in the position of growth.</rdfs:comment>
    <rdfs:label xml:lang="en">boundstone</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/granularmaterial/Fecal_Pellet_Particle_Material">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al., 2005</dct:source>
    <rdfs:comment xml:lang="en">Granular material consisting of organic excrement, mainly of invertebrates, occuring especially in modern marine sediments but also fossilised in some sedimentary rocks, usually with simple ovoid form, less commonly rod-shaped.</rdfs:comment>
    <rdfs:label xml:lang="en">fecal pellet particle material</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/granularmaterial/Biogenic_Particle_Material"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b553">
