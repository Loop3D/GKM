    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Trachytic rock that contains between 0 and 10 percent feldspathoid in the QAPF fraction, and no quartz. QAPF field 7'.</rdfs:comment>
    <rdfs:label xml:lang="en">foid bearing trachyte</rdfs:label>
  </rdf:Description>
