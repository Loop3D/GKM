  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Impure_Carbonate_Sedimentary_Rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Carbonate_Sedimentary_Rock"/>
    <dct:source xml:lang="en">This vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Sedimentary rock in which between 50 and 90 percent of the primary and/or recrystallized constituents are composed of carbonate minerals.</rdfs:comment>
    <rdfs:label xml:lang="en">impure carbonate sedimentary rock</rdfs:label>
    <skos:altLabel xml:lang="en">marlstone</skos:altLabel>
  </rdf:Description>
