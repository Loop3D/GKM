  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Diamictite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Clastic_Sedimentary_Rock"/>
    <dct:source xml:lang="en">Fairbridge and Bourgeois 1978</dct:source>
    <rdfs:comment xml:lang="en">Unsorted or poorly sorted, clastic sedimentary rock with a wide range of particle sizes including a muddy matrix. Biogenic materials that have such texture are excluded. Distinguished from conglomerate, sandstone, mudstone based on polymodality and lack of structures related to transport and deposition of sediment by moving air or water. If more than 10 percent of the fine grained matrix is of indeterminant clastic or diagenetic origin and the fabric is matrix supported, may also be categorized as wacke.</rdfs:comment>
    <rdfs:label xml:lang="en">diamictite</rdfs:label>
  </rdf:Description>
