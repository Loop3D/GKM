  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseSinemurianSP2000">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologiccontact/GSSP"/>
    <dct:source xml:lang="en">Episodes 25/1, p. 22 28, 2002</dct:source>
    <rdfs:comment xml:lang="en">0.90 m above the base of Bed 145, East Quantoxhead, SW England</rdfs:comment>
    <rdfs:label xml:lang="en">GSSP Base of Sinemurian</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://stratigraphy.science.purdue.edu/references/Sinemurian.pdf"/>
    <rdfs:seeAlso rdf:resource="https://stratigraphy.org/gssps/"/>
    <owl:versionInfo>2000</owl:versionInfo>
  </rdf:Description>
