  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Evaporite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Chemical_Sedimentary_Material"/>
    <dct:source xml:lang="en">Jackson 1997; SLTTs 2004</dct:source>
    <rdfs:comment xml:lang="en">Nonclastic sedimentary rock composed of at least 50 percent non-carbonate salts, including chloride, sulfate or borate minerals; formed through precipitation of mineral salts from a saline solution (non-carbonate salt rock).</rdfs:comment>
    <rdfs:label xml:lang="en">evaporite</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/any_consolidation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Consolidation_Degree_Value"/>
    <dct:source xml:lang="en">CGI consolidationdegree SKOS vocabulary 2012-11-24</dct:source>
    <rdfs:comment xml:lang="en">In normative descriptions, indicates that consolidation state is not a determining factor in identification, it may have any value.</rdfs:comment>
    <rdfs:label xml:lang="en">consolidation not specified</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b232">
