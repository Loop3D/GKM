  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Dolomitic_Or_Magnesian_Sedimentary_Material">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Carbonate_Sedimentary_Material"/>
    <dct:source xml:lang="en">after SLTTs 2004, Hallsworth and Knox 1999</dct:source>
    <rdfs:comment xml:lang="en">Carbonate sedimentary material of unspecified consolidation degree with a ratio of magnesium carbonate to calcite (plus aragonite) greater than 1 to 1. Includes dolomite sediment, dolostone, lime dolostone and magnesite-stone.</rdfs:comment>
    <rdfs:label xml:lang="en">dolomitic or magnesian sedimentary material</rdfs:label>
  </rdf:Description>
