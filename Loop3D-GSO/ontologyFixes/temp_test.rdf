  <rdf:Description rdf:about="https://w3id.org/gso/1.0/element/tungsten">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">tungsten</rdfs:label>
    <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.britannica.com/science/tungsten-chemical-element</rdfs:seeAlso>
