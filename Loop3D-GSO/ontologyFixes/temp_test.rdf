  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Foliated_Metamorphic_Rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Metamorphic_Rock"/>
    <dct:source xml:lang="en">based on NADM SLTT metamorphic</dct:source>
    <rdfs:comment xml:lang="en">Metamorphic rock in which 10 percent or more of the contained mineral grains are elements in a planar or linear fabric. Cataclastic or glassy character precludes classification with this concept.</rdfs:comment>
    <rdfs:label xml:lang="en">foliated metamorphic rock</rdfs:label>
  </rdf:Description>
