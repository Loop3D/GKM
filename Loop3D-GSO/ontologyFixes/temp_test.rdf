    <gsoc:timeEquivalentTo rdf:resource="https://w3id.org/gso/1.0/geologictime/BaseLudlow"/>
    <rdfs:label xml:lang="en">shared boundary with BaseLudlow</rdfs:label>
  </rdf:Description>
