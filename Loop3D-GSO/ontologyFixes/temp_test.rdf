  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/Proterozoic2017">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologictime/Eon"/>
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Specific_Geologic_Time_Unit"/>
    <rdfs:comment xml:lang="en">older bound -2500 Ma</rdfs:comment>
    <rdfs:comment xml:lang="en">younger bound -541.0 +|-1.0 Ma</rdfs:comment>
    <rdfs:label xml:lang="en">Proterozoic Eon</rdfs:label>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/geologictime/ProterozoicEon"/>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/ischart/isc2017-02"/>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/ischart/isc2020-01"/>
    <gsoc:nextTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Cambrian2017"/>
    <gsoc:nextTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Fortunian2017"/>
    <gsoc:nextTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Paleozoic2017"/>
    <gsoc:nextTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Phanerozoic2017"/>
    <gsoc:nextTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Terreneuvian2017"/>
    <gsoc:previousTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Archean2017"/>
    <gsoc:previousTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Neoarchean2004"/>
    <gsoc:timeContains rdf:resource="https://w3id.org/gso/1.0/ischart/Mesoproterozoic2004"/>
    <gsoc:timeDuring rdf:resource="https://w3id.org/gso/1.0/ischart/Precambrian2017"/>
    <gsoc:timeFinishedBy rdf:resource="https://w3id.org/gso/1.0/ischart/BasePhanerozoic2017"/>
    <gsoc:timeFinishedBy rdf:resource="https://w3id.org/gso/1.0/ischart/Neoproterozoic2017"/>
    <gsoc:timeFinishes rdf:resource="https://w3id.org/gso/1.0/ischart/Precambrian2017"/>
    <gsoc:timeStartedBy rdf:resource="https://w3id.org/gso/1.0/ischart/BaseProterozoic2004"/>
    <gsoc:timeStartedBy rdf:resource="https://w3id.org/gso/1.0/ischart/Paleoproterozoic2004"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfoliation/slaty_cleavage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Continuous cleavage defined by aligned fine to very-fine grained phylosilicate mineral grains. The individual grains defining the fabric are too small to be seen by the unaided eye. Grades into phyllitic cleavage as grain size increases. Cleavage domains typically less than 100 micrometres wide, rock easily splits into slabs and thin plates.</rdfs:comment>
    <dct:source xml:lang="en">Brodie, Kate, Fettes, Douglas, and Harte, Ben, 2007, Structural terms including fault rock terms, in Fettes, D., and Desmons, J., Metamorphic rocks-A classification and Glossary of Terms: Cambridge, UK, Cambridge University Press, p. 24-31., Jackson 1997</dct:source>
    <rdfs:label xml:lang="en">slaty cleavage</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfoliation/continuous_cleavage"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b630">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/common/Uncertainty"/>
    <gsoc:hasValue rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b631"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n099faa0fcafa464dac687bd05be17dc4b61">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/gso/1.0/common/hasConstituent"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Material"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b783">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/GSSA"/>
    <gsoc:hasStaticPart rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b784"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/isc2014-02">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Scale"/>
    <rdfs:comment xml:lang="en">RDF/OWL representation of the 2014-02 edition of the International Chronostratigraphic Chart from the International Commission on Stratigraphy. Encoded using OWL implementation from GSO. Adapted from Cox&amp;Richard OWL GeologicTime ontology</rdfs:comment>
    <rdfs:comment xml:lang="en">dc:source  Cohen, K.M., Finney, S.C., Gibbard, P.L. &amp; Fan, J.-X. (2013; updated) The ICS  International  Chronostratigraphic Chart. Episodes 36: 199-204.</rdfs:comment>
    <rdfs:comment xml:lang="en">dc:source  International  Chronostratigraphic Chart 2014</rdfs:comment>
    <rdfs:label xml:lang="en">International Chronostratigraphic Chart (2014)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b1219">
    <rdf:type rdf:resource="http://qudt.org/vocab/unit/MegaYR"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/granularmaterial/resorbed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf, K.K.E, Mehl, J.P. &amp; Jackson, J.A. (eds), 2005. Glossary of geology, 5th Edition. American Geological Institute, Alexandria, 779 p.</dct:source>
    <rdfs:comment xml:lang="en">Particles have smooth, embayed boundaries caused by resorption by the host magma</rdfs:comment>
    <rdfs:label xml:lang="en">resorbed</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/granularmaterial/Grain_Roundness_Value"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Iron_Rich_Sedimentary_Material">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Chemical_Sedimentary_Material"/>
    <dct:source xml:lang="en">SLTTs 2004</dct:source>
    <rdfs:comment xml:lang="en">Sedimentary material of unspecified consolidation state that consists of at least 50 percent iron-bearing minerals (hematite, magnetite, limonite-group, siderite, iron-sulfides), as determined by hand-lens or petrographic analysis. Corresponds to a rock typically containing 15 percent iron by weight.</rdfs:comment>
    <rdfs:label xml:lang="en">iron rich sedimentary material</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ne509946f2e304dbfa7ee3477c0339f91b27">
    <rdf:first rdf:nodeID="ne509946f2e304dbfa7ee3477c0339f91b26"/>
    <rdf:rest rdf:nodeID="ne509946f2e304dbfa7ee3477c0339f91b28"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologictime/TournaisianAge">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologictime/Age"/>
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Generic_Geologic_Time_Unit"/>
    <gsoc:timeStarts rdf:resource="https://w3id.org/gso/1.0/geologictime/BaseCarboniferous"/>
    <rdfs:comment xml:lang="en">Interval for grouping all specific instances of the Tournaisian Age</rdfs:comment>
    <rdfs:label xml:lang="en">Tournaisian Age</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b1272">
