    <gsoc:hasQuality rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b19"/>
    <gsoc:hasUOM rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b21"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Rifting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf, K.K.E, Mehl, J.P. &amp; Jackson, J.A. (eds), 2005. Glossary of geology, 5th Edition. American Geological Institute, Alexandria, 779 p.</dct:source>
    <rdfs:comment xml:lang="en">Extension of the crust to form one or more long, narrow graben of regional extent.</rdfs:comment>
    <rdfs:label xml:lang="en">rifting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicprocess/Continental_Breakup"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Granodiorite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Granitoid"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Phaneritic crystalline rock consisting essentially of quartz, sodic plagioclase and lesser amounts of alkali feldspar with minor hornblende and biotite. Includes rocks defined modally in QAPF field 4.</rdfs:comment>
    <rdfs:label xml:lang="en">granodiorite</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b710">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/common/Time_Numeric_Value"/>
    <gsoc:hasDataValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">174.1</gsoc:hasDataValue>
    <gsoc:hasQuality rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b711"/>
    <gsoc:hasUOM rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b713"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b137">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/common/Time_Instant"/>
    <gsoc:hasQuality rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b138"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/Gas">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Gas is a state of matter that has no fixed shape and no fixed volume. Gases have lower density than other states of matter, such as solids and liquids. There is a great deal of empty space between particles, which have a lot of kinetic energy. The particles move very fast and collide into one another, causing them to diffuse, or spread out, until they are evenly distributed throughout the volume of the container.  (https://www.livescience.com/53304-gases.html)</rdfs:comment>
    <rdfs:label xml:lang="en">Gas state of matter</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Fluid"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b1248">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/common/Time_Instant_Location"/>
    <gsoc:hasStaticValue rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b1249"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologictime/BaseDevonian">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Boundary"/>
    <rdfs:comment xml:lang="en">Interval for grouping all specific instances of the Base of Devonian</rdfs:comment>
    <rdfs:label xml:lang="en">Base of Devonian</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicquality/Horizontal_Line">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source>Fleuty (1964) Folds classification.</dct:source>
    <rdfs:comment xml:lang="en">line plunges between 0 and 10 degrees.</rdfs:comment>
    <rdfs:label xml:lang="en">Horizontal line </rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicquality/Plunge_Value"/>
  </rdf:Description>
