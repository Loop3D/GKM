    <dct:source xml:lang="en">Neuendorf et al., 2005</dct:source>
    <rdfs:comment xml:lang="en">The seaward side of a reef, the slope covered with deposits of coarse reef talus</rdfs:comment>
    <rdfs:label xml:lang="en">forereef setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Biological_Reef_Setting"/>
  </rdf:Description>
