    <rdfs:label xml:lang="en">thallium</rdfs:label>
    <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.britannica.com/science/thallium</rdfs:seeAlso>
