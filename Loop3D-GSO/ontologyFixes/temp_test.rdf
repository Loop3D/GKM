  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/Nonphysical_Morphologic_Feature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A feature that is not a part of its host, but characterized by the form or structure of the host: Morphological features can have morphological properties e.g. orientation, thickness, fold profile, etc. Examples: - smile or frown / lips.    - mountain / planet surface (protrusion in the planet surface).  - graben and horst / planet surface (protrusion or depression in the planet surface caused by faulting).</rdfs:comment>
    <rdfs:label xml:lang="en">Morphologic Feature</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Inherant_Feature"/>
    <rdfs:subClassOf rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b72"/>
    <owl:disjointWith rdf:resource="https://w3id.org/gso/1.0/common/Pattern_Feature"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Basic_Igneous_Rock">
