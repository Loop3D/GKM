    <gsoc:hasDataValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">11.608</gsoc:hasDataValue>
    <gsoc:hasUOM rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b1141"/>
  </rdf:Description>
