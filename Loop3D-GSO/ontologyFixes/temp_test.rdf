  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Ocean_Highland_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI Event Environment vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Broad category for subaqueous marine settings characterized by significant relief above adjacent sea floor.</rdfs:comment>
    <rdfs:label xml:lang="en">ocean highland setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Marine_Setting"/>
    <rdfs:subClassOf rdf:nodeID="n50ae2bf5eccd483b885316dab32dfbd1b48"/>
