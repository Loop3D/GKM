    <dct:source xml:lang="en">CGI Event Environment vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Setting defined by relationships to tectonic plates on or in the Earth.</rdfs:comment>
    <rdfs:label xml:lang="en">tectonically defined setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Setting"/>
    <rdfs:subClassOf rdf:nodeID="n50ae2bf5eccd483b885316dab32dfbd1b62"/>
  </rdf:Description>
