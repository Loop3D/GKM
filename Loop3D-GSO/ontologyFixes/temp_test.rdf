  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Continental_Breakup">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">this vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Fragmentation of a continental plate into two or more smaller plates, may involve rifting or strike slip faulting.</rdfs:comment>
    <rdfs:label xml:lang="en">continental breakup</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicprocess/Tectonic_Process"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Deformation"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nfbb732a7b8ed49199dc4f9702acc66c1b10">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/gso/1.0/common/hasEssentialPart"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/gso/1.0/common/Spatial_Region_1D"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/element/uranium">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">uranium</rdfs:label>
    <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.britannica.com/science/uranium</rdfs:seeAlso>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Element"/>
    <gsel:atomicNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">92</gsel:atomicNumber>
    <gsel:chebiid rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://purl.obolibrary.org/obo/CHEBI_49936</gsel:chebiid>
    <gsel:symbol>U</gsel:symbol>
    <gsel:wikidataid rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.wikidata.org/entity/Q1098</gsel:wikidataid>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfoliation/discrete_crenulation_cleavage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Crenulation cleavage in which the cleavage domains have discrete boundaries. Amplitude of crenulation folds tends to be small.</rdfs:comment>
    <dct:source xml:lang="en">Borradaile et al 1982</dct:source>
    <rdfs:label xml:lang="en">discrete crenulation cleavage</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfoliation/crenulation_cleavage"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfoliation/spaced_cleavage"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologictime/OxfordianAge">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologictime/Age"/>
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Generic_Geologic_Time_Unit"/>
    <gsoc:timeStarts rdf:resource="https://w3id.org/gso/1.0/geologictime/BaseUpperJurassic"/>
    <rdfs:comment xml:lang="en">Interval for grouping all specific instances of the Oxfordian Age</rdfs:comment>
    <rdfs:label xml:lang="en">Oxfordian Age</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfeature/Stratigraphic_Section">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A rock object that represents a continuous strip of rock material that includes (samples) a sequence of stratified layers.</rdfs:comment>
    <rdfs:label xml:lang="en">Stratigraphic Section</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfeature/Rock_Body_Section"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicstructure/Sedimentary_Structure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Structures formed in sedimentary rocks related to depositional or diagenetic processes.   Includes trace fossils. Sedimentary structure is used to describe discrete features in a sedimentary rock; penetrative structures (like bedding, cross bedding) are Sedimentary_Fabrics</rdfs:comment>
    <rdfs:label xml:lang="en">Sedimentary Structure  </rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Structure"/>
  </rdf:Description>
