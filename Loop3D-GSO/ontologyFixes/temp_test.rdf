  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfault/Normal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">GGIC vocabularies working group (Australia)</dct:source>
    <rdfs:comment xml:lang="en">The hanging wall has been displaced down relative to the footwall, dip of fault usually 45-90 degrees.</rdfs:comment>
    <rdfs:label xml:lang="en">normal</rdfs:label>
