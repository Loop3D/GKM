  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Lacustrine_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI Event Environment vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Setting associated with a lake. Always overlaps with terrestrial, may overlap with subaerial, subaqueous, or shoreline.</rdfs:comment>
    <rdfs:label xml:lang="en">lacustrine setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Terrestrial_Setting"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n099faa0fcafa464dac687bd05be17dc4b88">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
