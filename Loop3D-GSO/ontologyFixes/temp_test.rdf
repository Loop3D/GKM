  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicreferencesystem/Plane_Dip_Dip_Direction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A spatial reference system for describing orientation of surfaces relative to the Earth. Dip (inclination) is relative to local horizontal, and Dip Direction is Azimuth measured in degrees measured clockwise (eastward) from true North.</rdfs:comment>
    <rdfs:label xml:lang="en">Dip and Dip Direction </rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Physical_Reference_System"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologictime/BaseRhaetian">
