    <rdfs:comment xml:lang="en">Interval for grouping all specific instances of the Aquitanian Age</rdfs:comment>
    <rdfs:label xml:lang="en">Aquitanian Age</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/occupiesTimeDirectly">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">The occupation of a time region by a process or event.</rdfs:comment>
    <rdfs:domain rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b269"/>
