    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Specific_Geologic_Time_Unit"/>
    <rdfs:comment xml:lang="en">older bound -227 Ma</rdfs:comment>
    <rdfs:comment xml:lang="en">younger bound -208.5 Ma</rdfs:comment>
