  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseSilurianSP1984">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologiccontact/GSSP"/>
    <dct:source xml:lang="en">Episodes 8/2, p. 101 103, 1985</dct:source>
    <dct:source>Geol. Series, Nat. Mus. Wales, 9, p. 90 - 100, 1989</dct:source>
    <rdfs:comment xml:lang="en">1.6m above the base of the Birkhill Shale Formation, within Bed 96, Dobs Linn, Scotland</rdfs:comment>
    <rdfs:comment xml:lang="en">Silurian Times No. 14 (2006)</rdfs:comment>
    <rdfs:label xml:lang="en">GSSP Base of Silurian - Llandovery - Rhuddanian</rdfs:label>
