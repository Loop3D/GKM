  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Oceanic_Plateau_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Reading 1978</dct:source>
    <rdfs:comment xml:lang="en">Region of elevated ocean crust that commonly rises to within 2-3 km of the surface above an abyssal sea floor that lies several km deeper. Climate and water depths are such that a marine carbonate platform does not develop.</rdfs:comment>
    <rdfs:label xml:lang="en">oceanic plateau setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Ocean_Highland_Setting"/>
  </rdf:Description>
