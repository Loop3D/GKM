    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Directed relation between something and a quality that is carried by it.</rdfs:comment>
    <rdfs:range rdf:resource="https://w3id.org/gso/1.0/common/Quality"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/hasInherant"/>
