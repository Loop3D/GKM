  <rdf:Description rdf:about="https://w3id.org/gso/1.0/granularmaterial/Fiamme_Particle_Material">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al 2005, http://en.wikipedia.org/wiki/Fiamme</dct:source>
    <rdfs:comment xml:lang="en">Granular material consisting of lens-shaped bodies, usually mm to cm thick, and centimeters to 1-2 decimeters long, typically seen on surfaces of some pyroclastic rocks. The name fiamme comes from the Italian word for flames, describing their shape. The term is descriptive and non-genetic. Generally interpreted to form by the collapse of pumice fragments during welding in a hot pyroclastic deposit.</rdfs:comment>
    <rdfs:label xml:lang="en">fiamme particle material</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/granularmaterial/Pyroclastic_Particle_Material"/>
  </rdf:Description>
