  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/UpperPennsylvanian2004">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologictime/Epoch"/>
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Specific_Geologic_Time_Unit"/>
    <rdfs:comment xml:lang="en">older bound -306.35 +|-1.0 Ma</rdfs:comment>
    <rdfs:comment xml:lang="en">younger bound -299.0 +|-0.8 Ma</rdfs:comment>
    <rdfs:label xml:lang="en">Upper Pennsylvanian Epoch</rdfs:label>
