  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Quartz_Rich_Igneous_Rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Acidic_Igneous_Rock"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Phaneritic_Igneous_Rock"/>
    <dct:source xml:lang="en">Gillespie and Styles 1999; LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Occurrence of igneous rocks meeting this criteria seems to be vanishingly rare, thus subdividing the category does not seem warranted for the purposes of This vocabulary. Future usage of the vocabulary may motivate including quatzolite and quartz-rich granitoid in future revisions</rdfs:comment>
    <rdfs:comment xml:lang="en">Phaneritic crystalline igneous rock that contains less than 90 percent mafic minerals and contains greater than 60 percent quartz in the QAPF fraction.</rdfs:comment>
    <rdfs:label xml:lang="en">quartz rich igneous rock</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Contact_Metamorphism">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf, K.K.E, Mehl, J.P. &amp; Jackson, J.A. (eds), 2005. Glossary of geology, 5th Edition. American Geological Institute, Alexandria, 779 p.</dct:source>
    <rdfs:comment xml:lang="en">Metamorphism taking place in rocks at or near their contact with a genetically related body of igneous rock</rdfs:comment>
    <rdfs:label xml:lang="en">contact metamorphism</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicprocess/Metamorphic_Process"/>
  </rdf:Description>
