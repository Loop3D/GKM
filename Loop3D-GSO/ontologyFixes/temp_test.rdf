  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseChattianSP2016">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologiccontact/GSSP"/>
    <dct:source xml:lang="en">Rodolfo Coccioni, Alessandro Montanari, David Bice,Graham Williams, 14 others; March 2018, The Global Stratotype Section and Point (GSSP) for the base of the Chattian Stage (Paleogene System, Oligocene Series) at Monte Cagnero, Italy; , Episodes 41(1):17-32; DOI: 10.18814/epiiugs/2018/v41i1/018003.</dct:source>
    <rdfs:comment xml:lang="en">Possibly Monte Cagnero, Umbria-Marche region, Italy</rdfs:comment>
