  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Skarn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Metasomatic_Rock"/>
    <dct:source xml:lang="en">Fettes and Desmons, 2007, p195</dct:source>
    <rdfs:comment xml:lang="en">Metasomatic rock consisting mainly of Ca-, Mg-, Fe-, or Mn-silicate minerals, which are free from or poor in water. Typically formed at the contact between a silicate rock or magma and a carbonate rock.</rdfs:comment>
    <rdfs:label xml:lang="en">skarn</rdfs:label>
    <skos:altLabel xml:lang="en">exoskarn</skos:altLabel>
    <skos:altLabel xml:lang="en">tactite</skos:altLabel>
  </rdf:Description>
