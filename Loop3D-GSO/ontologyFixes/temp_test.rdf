  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Barrier_Lagoon_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al., 2005</dct:source>
    <rdfs:comment xml:lang="en">A lagoon that is roughly parallel to the coast and is separated from the open ocean by a strip of land or by a barrier reef. Tidal influence is typically restricted and the lagoon is commonly hypersaline.</rdfs:comment>
    <rdfs:label xml:lang="en">barrier lagoon setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Barrier_Island_Coastline_Setting"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Lagoonal_Setting"/>
    <rdfs:subClassOf rdf:nodeID="n50ae2bf5eccd483b885316dab32dfbd1b5"/>
  </rdf:Description>
