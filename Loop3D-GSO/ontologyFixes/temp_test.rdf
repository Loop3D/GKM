  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseOlenekian2004">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Boundary"/>
    <dct:source xml:lang="en">Gradstein, Ogg, Smith, 2004, A Geologic Time Scale 2004</dct:source>
