  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Foid_Bearing_Latite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Latitic_Rock"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Latitic rock that contains no quartz and between 0 and 10 percent feldspathoid minerals in the QAPF fraction. QAPF field 8'.</rdfs:comment>
    <rdfs:label xml:lang="en">foid bearing latite</rdfs:label>
  </rdf:Description>
