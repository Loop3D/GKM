  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Estuarine_Lagoon_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al., 2005</dct:source>
    <rdfs:comment xml:lang="en">A lagoon produced by the temporary sealing of a river estuary by a storm barrier. Such lagoons are usually seasonal and exist until the river breaches the barrier, they occur in regions of low or spasmodic rainfall</rdfs:comment>
    <rdfs:label xml:lang="en">estuarine lagoon setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Estuary_Setting"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Lagoonal_Setting"/>
    <rdfs:subClassOf rdf:nodeID="n50ae2bf5eccd483b885316dab32dfbd1b24"/>
  </rdf:Description>
