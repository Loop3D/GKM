    <gsel:symbol>Tc</gsel:symbol>
    <gsel:wikidataid rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.wikidata.org/entity/Q1054</gsel:wikidataid>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Igneous_Material">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Rock_Material"/>
    <dct:source xml:lang="en">This vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Earth material formed as a result of igneous processes, eg. intrusion and cooling of magma in the crust, volcanic eruption.</rdfs:comment>
    <rdfs:label xml:lang="en">igneous material</rdfs:label>
  </rdf:Description>
