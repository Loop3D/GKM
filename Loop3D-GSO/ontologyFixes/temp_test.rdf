  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfold/Hinge_Line_Curvature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Variation in orientation of fold hinge along trend of fold, distinguish sheath from cylindrical folds. Specify with terminology eg sheath, dome, basin, cylindrical.</rdfs:comment>
    <rdfs:isDefinedBy xml:lang="en">GeoSciML v4</rdfs:isDefinedBy>
    <rdfs:label xml:lang="en">Fold hinge line curvature</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Nonphysical_Quality"/>
    <rdfs:subClassOf rdf:nodeID="nfbb732a7b8ed49199dc4f9702acc66c1b30"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/timeOccupiedIndirectlyBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://w3id.org/gso/1.0/common/Time_Region"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/timeOccupiedBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Natural_Unconsolidated_Material">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Unconsolidated_Material"/>
    <dct:source xml:lang="en">This vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Unconsolidated material known to have natural, ie. not human-made, origin.</rdfs:comment>
    <rdfs:label xml:lang="en">natural unconsolidated material</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Gneiss">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Foliated_Metamorphic_Rock"/>
    <dct:source xml:lang="en">Neuendorf et al. 2005</dct:source>
    <rdfs:comment xml:lang="en">Foliated metamorphic rock with bands or lenticles rich in granular minerals alternating with bands or lenticles rich in minerals with a flaky or elongate prismatic habit. Mylonitic foliation or well developed, continuous schistosity (greater than 50 percent of the rock consists of grains participate in a planar or linear fabric) precludes classification with this concept.</rdfs:comment>
    <rdfs:label xml:lang="en">gneiss</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b105">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="https://w3id.org/gso/1.0/common/Perdurant"/>
    <owl:onProperty rdf:resource="https://w3id.org/gso/1.0/common/hasPart"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Aplite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Phaneritic_Igneous_Rock"/>
    <dct:source xml:lang="en">Neuendorf et al. 2005</dct:source>
    <rdfs:comment xml:lang="en">Light coloured crystalline rock, characterized by a fine grained allotriomorphic-granular (aplitic, saccharoidal or xenomorphic) texture; typically granitic composition, consisting of quartz, alkali feldspar and sodic plagioclase.</rdfs:comment>
    <rdfs:label xml:lang="en">aplite</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n50ae2bf5eccd483b885316dab32dfbd1b45">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/gso/1.0/common/hasStaticPart"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Inner_Neritic_Setting"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b1121">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/common/Measure_Value"/>
    <gsoc:hasDataValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.9</gsoc:hasDataValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfold/Fold_InterLimb_Angle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source>Neuendorf et al., 2005</dct:source>
    <rdfs:comment xml:lang="en">The angle between adjacent limbs of a fold, normally determined by drawing tangents to the fold limbs at the inflection points.</rdfs:comment>
    <rdfs:isDefinedBy xml:lang="en">GeoSciML v4</rdfs:isDefinedBy>
    <rdfs:label xml:lang="en">Fold limb shape</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Nonphysical_Quality"/>
    <rdfs:subClassOf rdf:nodeID="nfbb732a7b8ed49199dc4f9702acc66c1b14"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BasePermianSP1996">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologiccontact/GSSP"/>
    <dct:source xml:lang="en">Episodes 21/1, p. 11 18, 1998</dct:source>
    <rdfs:comment xml:lang="en">27m above the base of Bed 19, Aidaralash Creek, Kazakhstan</rdfs:comment>
    <rdfs:label xml:lang="en">GSSP Base of Permian</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://www.stratigraphy.org/GSSP/Asselian.pdf"/>
    <rdfs:seeAlso rdf:resource="https://stratigraphy.org/gssps/"/>
    <owl:versionInfo>1996</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/Cenomanian2004">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologictime/Age"/>
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Specific_Geologic_Time_Unit"/>
    <rdfs:comment xml:lang="en">older bound -99.6 +|-0.9 Ma</rdfs:comment>
    <rdfs:comment xml:lang="en">younger bound -93.5 +|-0.8 Ma</rdfs:comment>
    <rdfs:label xml:lang="en">Cenomanian Age</rdfs:label>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/geologictime/CenomanianAge"/>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/ischart/isc2004-04"/>
