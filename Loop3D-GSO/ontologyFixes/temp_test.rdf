    <gsoc:staticHostedBy rdf:resource="https://w3id.org/gso/1.0/ischart/BaseMesozoicSP2001"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/calcsilicate_altered_rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
