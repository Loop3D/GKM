  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicrole/Screen">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI rockbodypart vocabulary 2016-11-21 </dct:source>
    <rdfs:comment xml:lang="en">A pendant that is a vertical sheet like body in an intrusive igneous rock body.</rdfs:comment>
    <rdfs:label xml:lang="en">Screen</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicrole/Pendant"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseHoloceneSP2008">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologiccontact/GSSP"/>
    <dct:source xml:lang="en">Episodes 31/2, 2008</dct:source>
    <rdfs:comment xml:lang="en">J. Quaternary Sci., Vol. 24 pp. 3–17, 2009</rdfs:comment>
    <rdfs:comment xml:lang="en">Primary marker: The base of the Greenlandian Stage is defined on the basis of the marked change in deuterium excess values that occurred over an interval of ca. 3 yr.  Correlation event is end of the Younger Dryas cold spell, which is reflected in a shift in deuterium excess values</rdfs:comment>
    <rdfs:comment xml:lang="en">The Greenlandian GSSP is located in the borehole NGRIP2 in the central Greenland ice sheet at a latitude of 75.10°N and a longitude of 42.32°W.</rdfs:comment>
    <rdfs:label xml:lang="en">GSSP Base of Holocene</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://stratigraphy.science.purdue.edu/references/HoloceneGSSP_JQuatSci090.pdf"/>
    <rdfs:seeAlso rdf:resource="http://www.episodes.org/index.php/epi/article/view/64299/50256"/>
    <rdfs:seeAlso rdf:resource="http://www.stratigraphy.org/GSSP/Holocene.pdf"/>
    <rdfs:seeAlso rdf:resource="https://timescalefoundation.org/gssp/detail.php?periodid=5&amp;top_parentid=0"/>
    <owl:versionInfo>2008</owl:versionInfo>
  </rdf:Description>
