  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Crystalline_Carbonate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Carbonate_Sedimentary_Rock"/>
    <dct:source xml:lang="en">SLTTs 2004</dct:source>
    <rdfs:comment xml:lang="en">Carbonate rock of indeterminate mineralogy in which diagenetic processes have obliterated any original depositional texture.</rdfs:comment>
    <rdfs:label xml:lang="en">crystalline carbonate</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicstructure/Sedimentary_Fabric">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Fabrics in sedimentary rock like "clast-supported",  "matrix-supported", "cross-bedding", and "graded bed" are considered kinds of Integral Feature/GeologicStructure because they depend on the configuration of parts of a rock body. Sedimentary_Fabric is used to represent penetrative feature in a rock body;  Sedimentary_Structure is used to describe discrete features in a sedimentary rock;</rdfs:comment>
    <rdfs:label xml:lang="en">Sedimentary Fabric  </rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicstructure/Fabric"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n50ae2bf5eccd483b885316dab32dfbd1b64">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
