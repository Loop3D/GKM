    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/geologictime/UpperDevonianEpoch"/>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/ischart/isc2017-02"/>
