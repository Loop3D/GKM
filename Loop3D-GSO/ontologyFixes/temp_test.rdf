  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfold/Chevron_Fold">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source>http://www.geologyin.com/2015/02/types-of-folds-with-photos.html</dct:source>
    <rdfs:comment xml:lang="en">A fold with straight limbs and sharp hinges. Well developed, these folds develop repeated set of v-shaped beds.  Inter-limb angles are generally 60 degrees or less. Chevron folding preferentially occurs in well bedded units where  bedding regularly alternates between contrasting competences.</rdfs:comment>
    <rdfs:label xml:lang="en">Chevron Fold </rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfold/Fold"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Peat">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Organic_Rich_Sediment"/>
    <dct:source xml:lang="en">Hallsworth and Knox 1999</dct:source>
    <rdfs:comment xml:lang="en">Unconsolidated organic-rich sediment composed of at least 50 percent semi-carbonised plant remains; individual remains commonly seen with unaided eye; yellowish brown to brownish black; generally fibrous texture; can be plastic or friable. In its natural state it can be readily cut and has a very high moisture content, generally greater than 90 percent. Liptinite to Inertinite ratio is less than one (Economic commission for Europe, committee on Sustainable Energy- United Nations (ECE-UN), 1998, International Classification of in-Seam Coals: Energy 19, 41 pp.)</rdfs:comment>
    <rdfs:label xml:lang="en">peat</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/Named_Value">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
