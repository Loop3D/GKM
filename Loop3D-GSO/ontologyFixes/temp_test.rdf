  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Carbonate_Sedimentary_Material">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Sedimentary_Material"/>
    <dct:source xml:lang="en">SLTTs 2004</dct:source>
    <rdfs:comment xml:lang="en">Sedimentary material in which at least 50 percent of the primary and/or recrystallized constituents are composed of one (or more) of the carbonate minerals calcite, aragonite and dolomite, in particles of intrabasinal origin.</rdfs:comment>
    <rdfs:comment xml:lang="en">Should carbonate sedimentary material be considered a kind of chemical sedimentary material? Is biogenic precipitation a chemical sedimentary process?</rdfs:comment>
    <rdfs:label xml:lang="en">carbonate sedimentary material</rdfs:label>
  </rdf:Description>
