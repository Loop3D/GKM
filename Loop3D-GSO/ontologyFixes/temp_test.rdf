    <rdfs:comment xml:lang="en">The process of emplacement of magma in pre-existing rock</rdfs:comment>
    <rdfs:label xml:lang="en">intrusion</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Additive_Process"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseUpperTriassicSP2008">
