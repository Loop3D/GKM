  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Metavolcanic_Rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Metamorphic_Rock"/>
    <dct:source xml:lang="en">This vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Rock formed by metamorphism of an extrusive igneous protolith.</rdfs:comment>
    <rdfs:label xml:lang="en">metavolcanic rock</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b98">
