  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Humid_Temperate_Climatic_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Cleland, D.T., Avers, P.E., McNab, W.H., Jensen, M.E., Bailey, R.G., King, T., Russell, W.E. 1997. National Hierarchical Framework of Ecological Units, in Boyce, M. S., Haney, A., ed., Ecosystem Management Applications for Sustainable Forest and WildlifeResources: Yale University Press, New Haven, CT. pp. 181-200.</dct:source>
    <rdfs:comment xml:lang="en">Setting with seasonal climate having hot to cold or humid to arid seasons.</rdfs:comment>
    <rdfs:label xml:lang="en">humid temperate climatic setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Planet_Surface_Setting"/>
    <rdfs:subClassOf rdf:nodeID="n50ae2bf5eccd483b885316dab32dfbd1b29"/>
  </rdf:Description>
