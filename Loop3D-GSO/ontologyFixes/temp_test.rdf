  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfoliation/solution_cleavage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Spaced cleavage forming an array of parallel to anastomosing, stylolitic to smooth, fracture-like partings formed by rock dissolution. Dissolution is indicated by discontinuity and offset of primary features that intersect cleavage surfaces, and typically by accumulation of insoluble residue along cleavage surface. Syn. stylolitic cleavage, pressure solution cleavage</rdfs:comment>
    <dct:source xml:lang="en">Geoscience Victoria, Australia</dct:source>
    <rdfs:label xml:lang="en">solution cleavage</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfoliation/spaced_cleavage"/>
  </rdf:Description>
