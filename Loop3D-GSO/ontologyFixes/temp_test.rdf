    <gsoc:staticHostedBy rdf:resource="https://w3id.org/gso/1.0/ischart/BaseUpperJurassicSP2004"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/timeIncludedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
