  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dct:bibliographicCitation>Brodaric, B., and Richard, S.M., 2021, The GeoScience Ontology Reference: Geological Survey of Canada Open File 8796, 34 p., https://doi.org/10.4095/328296</dct:bibliographicCitation>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-26</dct:created>
    <dct:creator rdf:resource="https://w3id.org/gso/1.0/common/boyan_brodaric"/>
    <dct:creator rdf:resource="https://w3id.org/gso/1.0/common/stephen_richard"/>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/legalcode"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-26</dct:modified>
    <dct:publisher>ARC Loop3D project;  https://loop3d.org/</dct:publisher>
    <dct:publisher>Geological Survey of Canada, Natural Resources Canada, Government of Canada</dct:publisher>
    <dct:rights>Copyright (c) 2021 Government of Canada</dct:rights>
    <dct:source>&lt;http://resource.geosciml.org/classifierScheme/cgi/2016.01/simplelithology&gt;</dct:source>
    <rdfs:comment xml:lang="en">Rock type categories modified from CGI SimpleLithology; properties based on GeoSciML v3.2 conceptual model. Scope includes gso Rock_Material and gso Granular Material. GSO granular material is analogous to GeoSciMLv3.2 compound material particle geometry description.  </rdfs:comment>
    <rdfs:label>Geoscience Ontology, Rock Types</rdfs:label>
    <skos:definition xml:lang="en">Kinds of rock material.</skos:definition>
    <skos:prefLabel xml:lang="en">Geoscience Ontology, Rock Types</skos:prefLabel>
    <schema:codeRepository>https://github.com/Loop3D/GKM</schema:codeRepository>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Carbonate_Mud">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Carbonate_Sediment"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Mud_Size_Sediment"/>
    <dct:source xml:lang="en">follow pattern used for clastic sand and mud categories, based on SLTTs 2004</dct:source>
    <rdfs:comment xml:lang="en">Carbonate sediment composed of less than 25 percent clasts that have a maximum diameter more than 2 mm, and the ratio of sand size to mud size clasts is less than one.</rdfs:comment>
    <rdfs:label xml:lang="en">carbonate mud</rdfs:label>
    <skos:altLabel xml:lang="en">marl</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseLudfordianSP1980">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologiccontact/GSSP"/>
    <dct:source xml:lang="en">Episodes 5/3, p. 2123, 1982 </dct:source>
    <rdfs:comment xml:lang="en">Geol. Series, Nat. Mus. Wales, 9, p. 73 90, 1989</rdfs:comment>
    <rdfs:comment xml:lang="en">Lethaia 14</rdfs:comment>
    <rdfs:comment xml:lang="en">coincident with the base of the Leintwardine Formationm near Ludlow, UK</rdfs:comment>
    <rdfs:label xml:lang="en">GSSP Base of Ludfordian</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://stratigraphy.science.purdue.edu/references/Silurian2.pdf"/>
    <rdfs:seeAlso rdf:resource="http://www.stratigraphy.org/GSSP/Sheinwoodian-Ludfordian.pdf"/>
    <rdfs:seeAlso rdf:resource="https://stratigraphy.org/gssps/"/>
    <owl:versionInfo>1980</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/Inherant_Feature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">based on quality inhering in (essential relation) host. The quality is the focal; Quality inheres in both the feature and the host. Morphologic feature -- focal  is a specific shape (river bend, fold)</rdfs:comment>
    <rdfs:label xml:lang="en">Inherent Feature </rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Nonphysical_Feature"/>
    <rdfs:subClassOf rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b43"/>
    <rdfs:subClassOf rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b44"/>
  </rdf:Description>
