  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Foreland_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">1-GE WP3, Neuendorf et al.(2005), p. 250</dct:source>
    <rdfs:comment xml:lang="en">The exterior area of an orogenic belt where deformation occurs without significant metamorphism. Generally the foreland is closer to the continental interior than other portions of the orogenic belt are.</rdfs:comment>
    <rdfs:label xml:lang="en">foreland setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Tectonic_Setting"/>
  </rdf:Description>
