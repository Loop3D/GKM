  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/Parthood">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Reification of the parthood relation (i.e. to be in a whole-part relation).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Relator"/>
    <rdfs:subClassOf rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b94"/>
    <rdfs:subClassOf rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b95"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb6cfdb5495d0402195372b290759ca66b1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
