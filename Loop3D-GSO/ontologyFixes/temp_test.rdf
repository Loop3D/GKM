  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicquality/Vertical_Line">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source>Fleuty (1964) Folds classification.</dct:source>
