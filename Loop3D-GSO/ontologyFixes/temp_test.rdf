  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/timeStartedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">source and target start simultaneously; source interval ends after target; inverse of starts</rdfs:comment>
