  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b1178">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Point"/>
    <gsoc:hasStaticPart rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b1179"/>
    <gsoc:staticHostedBy rdf:resource="https://w3id.org/gso/1.0/ischart/BaseUpperDevonianSP1986"/>
