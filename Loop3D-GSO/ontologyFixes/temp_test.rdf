    <gsoc:timeEquivalentTo rdf:resource="https://w3id.org/gso/1.0/geologictime/BasePhanerozoic"/>
    <rdfs:label xml:lang="en">shared boundary with BasePhanerozoic</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b1010">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/common/Time_Instant"/>
    <gsoc:hasQuality rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b1011"/>
