  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseBajocianSP1996">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologiccontact/GSSP"/>
    <dct:source xml:lang="en">Episodes 20/1, p.16  22, 1997</dct:source>
    <rdfs:comment xml:lang="en">base of Bed AB 11, Murtinheira Section, Cabo Mondego, Portugal</rdfs:comment>
    <rdfs:label xml:lang="en">GSSP Base of Bajocian</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://stratigraphy.science.purdue.edu/references/Bajocian.pdf"/>
