    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfoliation/tectonic_foliation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Foliation in a rock body defined by physical components related to deformation subsequent to solidification of the rock.</rdfs:comment>
    <dct:source xml:lang="en">CGI foliationtype SKOS vocabulary 2018-08-03</dct:source>
    <rdfs:label xml:lang="en">tectonic foliation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicstructure/Foliation"/>
  </rdf:Description>
