    <gsoc:timeStarts rdf:resource="https://w3id.org/gso/1.0/ischart/Lopingian2004"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Obduction">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al., 2005, http://en.wikipedia.org/wiki/Obduction, Coleman, R. G., 1971, Plate tectonic emplacement of upper mantle peridotites along continental edge: J.Geophys. Res., v75, p1212-1222.</dct:source>
    <rdfs:comment xml:lang="en">The overthrusting of continental crust by oceanic crust or mantle rocks at a convergent plate boundary.</rdfs:comment>
    <rdfs:label xml:lang="en">obduction</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicprocess/Tectonic_Process"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Deformation"/>
  </rdf:Description>
