  <rdf:Description rdf:nodeID="n099faa0fcafa464dac687bd05be17dc4b198">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="https://w3id.org/gso/1.0/common/Element"/>
    <owl:onProperty rdf:resource="https://w3id.org/gso/1.0/common/hasConstituent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Dioritoid">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Intermediate_Composition_Igneous_Rock"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Phaneritic_Igneous_Rock"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Phaneritic crystalline igneous rock with M less than 90, consisting of intermediate plagioclase, commonly with hornblende and often with biotite or augite. Plagioclase to total feldspar ratio is greater that 0.65, and anorthite content of plagioclase is less than 50 percent. Less than 10 percent feldspathoid mineral and less than 20 percent quartz in the QAPF fraction. Includes rocks defined modally in QAPF fields 9 and 10 (and their subdivisions).</rdfs:comment>
    <rdfs:label xml:lang="en">dioritoid</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b262">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/common/Time_Instant_Location"/>
    <gsoc:hasStaticValue rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b263"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicrelation/intrudedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">subject rock body intrudes object rock body. Implies that subject rock body is igneous rock, and that object rock body is older than subject rock body</rdfs:comment>
    <rdfs:domain rdf:nodeID="ne509946f2e304dbfa7ee3477c0339f91b25"/>
    <rdfs:label xml:lang="en">intrudes</rdfs:label>
    <rdfs:range rdf:resource="https://w3id.org/gso/1.0/geology/Rock_Body"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/geologicrelation/crosscutBy"/>
    <owl:inverseOf rdf:resource="https://w3id.org/gso/1.0/geologicrelation/intrudes"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Middle_Bathyal_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Berggren, W.A. &amp; Miller, K.G., 1989. Cenozoic bathyal and abyssal calcareous benthic foraminiferal zonation. Micropalaeontology 35, 308-320</dct:source>
    <rdfs:comment xml:lang="en">The ocean environment at water depths between 600 and 1000 metres</rdfs:comment>
    <rdfs:label xml:lang="en">middle bathyal setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Bathyal_Setting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologiclineation/rodding_lineation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Jackson 1997</dct:source>
    <rdfs:comment xml:lang="en">Linear structure in metamorphic rocks in which the stronger parts have been shaped into parallel rods (eg. vein quartz)</rdfs:comment>
    <rdfs:label xml:lang="en">rodding lineation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologiclineation/tectonic_lineation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/externallySpecDependsOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">External specific dependence, i.e. not dependent on own parts, qualities, roles, constituents, etc.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/externallyGenDependsOn"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/specificallyDependsOn"/>
  </rdf:Description>
