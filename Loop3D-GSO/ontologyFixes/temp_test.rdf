    <gsoc:timeContains rdf:resource="https://w3id.org/gso/1.0/ischart/Kimmeridgian2017"/>
    <gsoc:timeFinishedBy rdf:resource="https://w3id.org/gso/1.0/ischart/BaseCretaceous2017"/>
    <gsoc:timeFinishedBy rdf:resource="https://w3id.org/gso/1.0/ischart/Tithonian2017"/>
    <gsoc:timeFinishes rdf:resource="https://w3id.org/gso/1.0/ischart/Jurassic2017"/>
