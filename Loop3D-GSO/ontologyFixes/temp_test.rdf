  <rdf:Description rdf:nodeID="n50ae2bf5eccd483b885316dab32dfbd1b61">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/gso/1.0/common/isStaticPartOf"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Glacier_Related_Setting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologiccontact/Magnetic_Contact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI contacttype SKOS vocabulary 2012-11-24</dct:source>
    <rdfs:comment xml:lang="en">A geophysical contact separating bodies of material distinguished based on properties related to magnetic fields.</rdfs:comment>
    <rdfs:label xml:lang="en">magnetic contact</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologiccontact/Geophysical_Contact"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfault/Scissor_Movement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al 2005</dct:source>
    <rdfs:comment xml:lang="en">A fault on which there is increasing offset or separation along the strike from an initial point of no offset, with reverse offset in the opposite direction.</rdfs:comment>
    <rdfs:label xml:lang="en">scissor</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfault/Fault_Movement_Sense"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfoliation/varve_lamination">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Bedding defined by distinct, parallel laminae (layers less than 1 cm thick), typically occurring in sequences of distinct couplets (e.g. dark and light color). Generally interpreted as deposited from suspension in still water, with each lamina thought to be an annual sedimentation unit. Typically consists of mud-size sediment.</rdfs:comment>
    <dct:source xml:lang="en">NADM sedimentary rock vocabulary (https://pubs.usgs.gov/of/2004/1451/sltt/appendixC/appendixC_pdf.zip)  NADM sedimentary rock vocabulary (https://pubs.usgs.gov/of/2004/1451/sltt/appendixC/appendixC_pdf.zip)  SLTTs 2004, Jackson 1997</dct:source>
    <rdfs:label xml:lang="en">varve lamination</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfoliation/bedding_lamination_structure"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b283">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/common/Time_Instant"/>
    <gsoc:hasQuality rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b284"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/granularmaterial/Crystallite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Williams, Turner, Gilbert 1954</dct:source>
    <rdfs:comment xml:lang="en">Granular material consisting of minute, spherical, rod, or hair-like particles, mineralogy not discernible with hand lense. Typically appear isotropic in thin section.</rdfs:comment>
    <rdfs:label xml:lang="en">crystallite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/granularmaterial/Single_Crystal_Particle_Material"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b745">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/common/Time_Numeric_Value"/>
    <gsoc:hasDataValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">311.7</gsoc:hasDataValue>
    <gsoc:hasQuality rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b746"/>
    <gsoc:hasUOM rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b748"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologictime/BaseCalymmian">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/GSSA"/>
    <gsoc:timeEquivalentTo rdf:resource="https://w3id.org/gso/1.0/geologictime/BaseMesoproterozoic"/>
    <rdfs:label xml:lang="en">shared boundary with BaseMesoproterozoic</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Trachyte">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Trachytic_Rock"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Trachytoid that has a plagioclase to total feldspar ratio between 0.1 and 0.35, between 0 and 5 percent quartz in the QAPF fraction, and no feldspathoid minerals. QAPF field 7.</rdfs:comment>
    <rdfs:label xml:lang="en">trachyte</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologiclineation/flow_lineation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Geoscience Victoria, Australia</dct:source>
    <rdfs:comment xml:lang="en">A linear alignment of fabric elements, especially elongate or rod-shaped minerals, interpreted to have been aligned by flow of magma, lava, pyroclastic material, or diapiric flow of sedimentary rock.</rdfs:comment>
    <rdfs:label xml:lang="en">flow lineation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicstructure/Lineation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseSelandian2004">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Boundary"/>
    <dct:source xml:lang="en">Gradstein, Ogg, Smith, 2004, A Geologic Time Scale 2004</dct:source>
    <rdfs:label xml:lang="en">Base of Selandian</rdfs:label>
    <gsoc:hasEssentialPart rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b1023"/>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/ischart/isc2004-04"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b536">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/common/Time_Instant_Location"/>
    <gsoc:hasStaticValue rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b537"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfoliation/sedimentary_layering">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Layering resulting from primary sedimentary processes, in which the individual layers (beds) are bounded by discontinuities related to events in the depositional history.</rdfs:comment>
    <dct:source xml:lang="en">CGI foliationtype SKOS vocabulary 2018-08-03</dct:source>
    <rdfs:label xml:lang="en">sedimentary layering</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfoliation/bedding_fabric"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfoliation/layering"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologictime/MoscovianAge">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologictime/Age"/>
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Generic_Geologic_Time_Unit"/>
    <gsoc:timeStarts rdf:resource="https://w3id.org/gso/1.0/geologictime/BaseMiddlePennsylvanian"/>
    <rdfs:comment xml:lang="en">Interval for grouping all specific instances of the Moscovian Age</rdfs:comment>
    <rdfs:label xml:lang="en">Moscovian Age</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b1146">
    <rdf:type rdf:resource="http://qudt.org/vocab/unit/MegaYR"/>
