  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Consolidation_Degree">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Physical_Quality"/>
    <rdfs:subClassOf rdf:nodeID="nc92f217a42cf4993a473982873db190db1"/>
    <rdfs:comment xml:lang="en">A property that specifies the degree to which an aggregation of EarthMaterial particles is a distinct solid material. Consolidation and induration are related concepts specified by this property. They define a continuum from unconsolidated material to very hard rock. Induration is the degree to which a consolidated material is made hard, operationally determined by how difficult it is to break a piece of the material. Consolidated materials may have varying degrees of induration (NADMSC, 2004)</rdfs:comment>
    <rdfs:isDefinedBy xml:lang="en">GeoSciML v4</rdfs:isDefinedBy>
    <rdfs:label xml:lang="en">Consolidation degree</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Plinian_Eruption">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf, K.K.E, Mehl, J.P. &amp; Jackson, J.A. (eds), 2005. Glossary of geology, 5th Edition. American Geological Institute, Alexandria, 779 p.</dct:source>
    <rdfs:comment xml:lang="en">An explosive eruption in which a steady, turbulent stream of fragmented magma and magmatic gas is released at a high velocity from a vent. Large volumes of tephra and tall eruption columns are characteristic</rdfs:comment>
    <rdfs:label xml:lang="en">plinian eruption</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicprocess/Pyroclastic_Eruption"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologiccontact/Chronostratigraphic_Zone_Contact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">FGDC</dct:source>
    <rdfs:comment xml:lang="en">A contact between bodies of material having different ages of origin.</rdfs:comment>
    <rdfs:label xml:lang="en">chronostratigraphic-zone contact</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologiccontact/Contact"/>
  </rdf:Description>
