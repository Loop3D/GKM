  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologictime/BasePiacenzian">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Boundary"/>
    <rdfs:comment xml:lang="en">Interval for grouping all specific instances of the Base of Piacenzian</rdfs:comment>
    <rdfs:label xml:lang="en">Base of Piacenzian</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Hornblendite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Phaneritic_Igneous_Rock"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Ultramafic_Igneous_Rock"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Ultramafic rock that consists of greater than 40 percent hornblende plus pyroxene and has a hornblende to pyroxene ratio greater than 1. Includes olivine hornblendite, olivine-pyroxene hornblendite, pyroxene hornblendite, and hornblendite.</rdfs:comment>
    <rdfs:label xml:lang="en">hornblendite</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologictime/Age">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Most granular geochronologic time interval;  one or more Ages are grouped into an Epoch</rdfs:comment>
    <rdfs:label xml:lang="en">Age (time scale rank)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Interval"/>
    <rdfs:subClassOf rdf:nodeID="n026ed78851694221944dcb0fbcf00073b1"/>
    <rdfs:subClassOf rdf:nodeID="n026ed78851694221944dcb0fbcf00073b9"/>
  </rdf:Description>
