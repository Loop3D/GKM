  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologictime/BaseSilurian">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Boundary"/>
    <rdfs:comment xml:lang="en">Interval for grouping all specific instances of the Base of Silurian - Llandovery - Rhuddanian</rdfs:comment>
    <rdfs:label xml:lang="en">Base of Silurian - Llandovery - Rhuddanian</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b461">
