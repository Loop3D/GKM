  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Foid_Gabbro">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Foid_Gabbroid"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Foid gabbroid that has a plagioclase to total feldspar ratio greater than 0.9. Includes rocks defined modally in QAPF field 14.</rdfs:comment>
    <rdfs:label xml:lang="en">foid gabbro</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseWuliuanSP2020">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologiccontact/GSSP"/>
    <dct:source>Episodes 42/2, p.165-184, 2019</dct:source>
    <rdfs:comment xml:lang="en">GSSP defined at the base of a silty mudstone layer (within bed 9) 52.8m above the base of the Kaili Formation in the Wuliu-Zengjiayan section in Jianhe County, eastern Guizhou Province, China. This level coincides with the first appearance of the cosmopolitan oryctocephalid trilobite Oryctocephalus indicus. Secondary indicators near the GSSP include the ROECE negative delta 13C excursion, the simultaneous appearance of acanthomorphic acritarchs, and a transgressive phase of a major eustatic event. The Wuliu-Zengjiayan section is situated along a hill ridge which is about 0.5km northeast of Balang Village, Jianhe County, GuizhouProvince, China at a latitude of  26.74738333 N and a longitude of 108.4138333 E. The GSSP is located inside the Jianhe Natural Reserve of Paleontological Fossils and the Miaoling National Geopark.</rdfs:comment>
    <rdfs:label xml:lang="en">Stratotype Point Base of Cambrian Stage 5</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://timescalefoundation.org/gssp/detail.php?periodid=150&amp;top_parentid=77"/>
    <owl:versionInfo>2019</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/Spatial_Region_2D">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Apatial region that is a surface.</rdfs:comment>
    <rdfs:label xml:lang="en">2D Spatial Region </rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Spatial_Region"/>
    <rdfs:subClassOf rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b182"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfoliation/rough_cleavage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Disjunct (Borradaile et al, 1990) cleavage characterized by short, discontinuous clavage surfaces, typically with concentrations of phyllosilicate minerals. Common in micaceous sandstone.</rdfs:comment>
    <dct:source xml:lang="en">Neuendorf et al. 2005, Borradaile et al, 1990</dct:source>
    <rdfs:label xml:lang="en">rough cleavage</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfoliation/cleavage"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/element/cerium">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">cerium</rdfs:label>
    <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.britannica.com/science/cerium</rdfs:seeAlso>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Element"/>
    <gsel:atomicNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">58</gsel:atomicNumber>
    <gsel:chebiid rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://purl.obolibrary.org/obo/CHEBI_33369</gsel:chebiid>
    <gsel:symbol>Ce</gsel:symbol>
    <gsel:wikidataid rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.wikidata.org/entity/Q1385</gsel:wikidataid>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Shale">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Clastic_Mudstone"/>
    <dct:source xml:lang="en">NADM SLTT sedimentary, 2004</dct:source>
    <rdfs:comment xml:lang="en">Laminated mudstone that will part or break along thin, closely spaced layers parallel to stratification.</rdfs:comment>
    <rdfs:comment xml:lang="en">Note definition does not specify carbonate vs. siliclastic nature of mud.</rdfs:comment>
    <rdfs:label xml:lang="en">shale</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Mylonitic_Rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Foliated_Metamorphic_Rock"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/fault_related_material"/>
    <dct:source xml:lang="en">Marshak and Mitra 1988</dct:source>
    <rdfs:comment xml:lang="en">Metamorphic rock characterised by a foliation resulting from tectonic grain size reduction, in which more than 10 percent of the rock volume has undergone grain size reduction. Includes protomylonite, mylonite, ultramylonite, and blastomylonite.</rdfs:comment>
    <rdfs:label xml:lang="en">mylonitic rock</rdfs:label>
  </rdf:Description>
