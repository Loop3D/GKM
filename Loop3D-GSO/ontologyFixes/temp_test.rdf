    <rdfs:label xml:lang="en">Geoscience Ontology, Geologic Event</rdfs:label>
    <rdfs:comment xml:lang="en">Some example events, needs extending</rdfs:comment>
    <dct:bibliographicCitation>Brodaric, B., and Richard, S.M., 2021, The GeoScience Ontology Reference: Geological Survey of Canada Open File 8796, 34 p., https://doi.org/10.4095/328296</dct:bibliographicCitation>
    <skos:definition xml:lang="en">Types of geologic event.</skos:definition>
    <skos:prefLabel xml:lang="en">Geoscience Ontology, Geologic Event</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Metaplutonic_Rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Metamorphic_Rock"/>
    <dct:source xml:lang="en">This vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Rock formed by metamorphism of a plutonic igneous protolith.</rdfs:comment>
    <rdfs:label xml:lang="en">metaplutonic rock</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Biogenic_Silica_Sedimentary_Rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Non_Clastic_Siliceous_Sedimentary_Rock"/>
    <dct:source xml:lang="en">based on NADM SLTT sedimentary; Hallsworth and Knox 1999</dct:source>
    <rdfs:comment xml:lang="en">Sedimentary rock that consists of at least 50 percent silicate mineral material, deposited directly by biological processes at the depositional surface, or in particles formed by biological processes within the basin of deposition. Includes radiolarian chert, diatomite, novaculite.</rdfs:comment>
    <rdfs:label xml:lang="en">biogenic silica sedimentary rock</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Monzogabbro">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Monzogabbroic_Rock"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002, This vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Monzogabbroic rock that contains between 0 an 5 percent quartz and no feldspathoid mineral in the QAPF fraction. Includes rocks defined modally in QAPF field 9 .</rdfs:comment>
    <rdfs:label xml:lang="en">monzogabbro</rdfs:label>
  </rdf:Description>
