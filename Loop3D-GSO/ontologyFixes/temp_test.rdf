  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Monzodiorite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Monzodioritic_Rock"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Phaneritic crystalline igneous rock consisting of sodic plagioclase (An0 to An50), alkali feldspar, hornblende and biotite, with or without pyroxene, and 0 to 5 percent quartz. Includes rocks defined modally in QAPF field 9.</rdfs:comment>
    <rdfs:label xml:lang="en">monzodiorite</rdfs:label>
  </rdf:Description>
