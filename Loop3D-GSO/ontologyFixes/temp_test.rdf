    <rdfs:comment xml:lang="en">definition missing</rdfs:comment>
    <rdfs:label xml:lang="en">calcsilicate altered rock</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologictime/BaseOxfordian">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Boundary"/>
    <gsoc:timeEquivalentTo rdf:resource="https://w3id.org/gso/1.0/geologictime/BaseUpperJurassic"/>
    <rdfs:label xml:lang="en">shared boundary with BaseUpperJurassic</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/timeOlderThan">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Age associated with subject is entirely prior to age associated with object</rdfs:comment>
    <rdfs:comment xml:lang="en">Event A is older than event B if A has occurred prior to B. (Burns, 1975; Mathematical Geology, Vol. 7, No. 4) Equivalent to Allen A Before B.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/isTemporallyRelatedTo"/>
    <owl:inverseOf rdf:resource="https://w3id.org/gso/1.0/common/timeYoungerThan"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/hasInput">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">A participant in a process that must be present before the process can run.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/hasParticipant"/>
    <owl:inverseOf rdf:resource="https://w3id.org/gso/1.0/common/isInputOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologictime/LowerTriassicEpoch">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologictime/Epoch"/>
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Generic_Geologic_Time_Unit"/>
    <gsoc:timeStarts rdf:resource="https://w3id.org/gso/1.0/geologictime/BaseMesozoic"/>
    <rdfs:comment xml:lang="en">Interval for grouping all specific instances of the Lower Triassic Epoch</rdfs:comment>
    <rdfs:label xml:lang="en">Lower Triassic Epoch</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologictime/BaseRhyacian">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/GSSA"/>
    <rdfs:comment xml:lang="en">Interval for grouping all specific instances of the Base of Rhyacian</rdfs:comment>
    <rdfs:label xml:lang="en">Base of Rhyacian</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicrole/Schlieren">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">GGIPAC</dct:source>
    <rdfs:comment xml:lang="en">a tabular body, generally a few cm to a few metres long, within a plutonic rock, having different mineral proportions and colour to the surrounding rock</rdfs:comment>
    <rdfs:comment xml:lang="en">could be considered a primary structure or  a role ...</rdfs:comment>
    <rdfs:label xml:lang="en">Schlieren</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Part"/>
    <rdfs:subClassOf rdf:nodeID="n8a923d1ff2a643c7adbaefc5fab5e81eb31"/>
    <rdfs:subClassOf rdf:nodeID="n8a923d1ff2a643c7adbaefc5fab5e81eb32"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/granularmaterial/Oncoid_Particle_Material">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Jackson 1997, Hallsworth and Knox 1999</dct:source>
    <rdfs:comment xml:lang="en">Granular material consisting of  '...coated grains with a cortex of irregular, partially overlapping laminae. They are typically irregular in shape and may exhibit biogenic structures. Some forms lack a distinct nucleus. Oncoids are generally larger than 2 mm.' (Hallsworth and Knox, 1999, p. 27). Synonymous with oncolite: A small, variously shaped, concentrically laminated, calcareous sedimentary structure, resembling an oolith, and formed by the accretion of successive layer[s]... It...generally does not exceed 10 cm in dimension. (Jackson, 1997, p. 446).</rdfs:comment>
    <rdfs:label xml:lang="en">oncoid particle material</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/granularmaterial/Coated_Particle_Material"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/UpperMississippian2017">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologictime/Epoch"/>
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Specific_Geologic_Time_Unit"/>
    <rdfs:comment xml:lang="en">older bound -330.9 +|-0.2 Ma</rdfs:comment>
    <rdfs:comment xml:lang="en">younger bound -298.9 +|-0.15 Ma</rdfs:comment>
    <rdfs:label xml:lang="en">Upper Mississippian Epoch</rdfs:label>
