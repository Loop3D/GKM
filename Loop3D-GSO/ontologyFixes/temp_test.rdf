  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/Inherant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">An Inherent is a thing that occupies space indirectly and depends for its existence on some bearer. The inherent is associated with the bearer via the InheresIn relation. An Inherent is an Endurant because it is present in its totality at any time that it exists. Note: inherants are summative: our colour (the sum of your colour and mine) inheres in us (the sum of you and me).</rdfs:comment>
    <rdfs:label xml:lang="en">Inherant</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Nonphysical_Endurant"/>
    <rdfs:subClassOf rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b41"/>
