  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseHauterivianSP2020">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologiccontact/GSSP"/>
    <rdfs:comment xml:lang="en">Defined at the base of Bed 189 of the La Charce Section, Drôme, France. This level coincides with the first appearance of the ammonite genus Acanthodiscus which marks the base of the Acanthodiscus radiatus ammonite zone. The GSSP is located 550m west of the village of La Charce, Drôme, France at a latitude of 44.46944 N and a longitude of 5.44372 E.</rdfs:comment>
    <rdfs:label xml:lang="en">GSSP Base of Hauterivian</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://timescalefoundation.org/gssp/detail.php?periodid=48&amp;top_parentid=35"/>
    <owl:versionInfo>2019</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b156">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
    <owl:onClass rdf:resource="https://w3id.org/gso/1.0/common/Role"/>
    <owl:onProperty rdf:resource="https://w3id.org/gso/1.0/common/mutuallySpecDependsOn"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Mid_Ocean_Ridge_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI Event Environment vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Ocean highland associated with a divergent continental margin (spreading center). Setting is characterized by active volcanism, locally steep reliefhydrothermal activity, and pelagic sedimentation.</rdfs:comment>
    <rdfs:label xml:lang="en">mid ocean ridge setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Ocean_Highland_Setting"/>
  </rdf:Description>
