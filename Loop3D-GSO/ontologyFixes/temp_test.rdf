  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/Katian2017">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologictime/Age"/>
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Specific_Geologic_Time_Unit"/>
    <rdfs:comment xml:lang="en">older bound -453 +|-0.7 Ma</rdfs:comment>
    <rdfs:comment xml:lang="en">younger bound -445.2 +|-1.4 Ma</rdfs:comment>
    <rdfs:label xml:lang="en">Katian Age</rdfs:label>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/geologictime/KatianAge"/>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/ischart/isc2017-02"/>
