    <rdfs:comment xml:lang="en">older bound -163.5 +|-1.0 Ma</rdfs:comment>
    <rdfs:comment xml:lang="en">younger bound -145.0 Ma</rdfs:comment>
    <rdfs:label xml:lang="en">Upper Jurassic Epoch</rdfs:label>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/geologictime/UpperJurassicEpoch"/>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/ischart/isc2017-02"/>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/ischart/isc2020-01"/>
    <gsoc:nextTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Berriasian2017"/>
    <gsoc:nextTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Cretaceous2017"/>
    <gsoc:nextTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/LowerCretaceous2017"/>
    <gsoc:previousTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Callovian2017"/>
