  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/timeMeets">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">A covers B -- A is immediately younger than B (there are no events between A and B) Same as Allen A meets B.</rdfs:comment>
    <rdfs:comment xml:lang="en">One of six binary relations between geologic events defined by Burns (1975)</rdfs:comment>
    <rdfs:comment xml:lang="en">Source TimeRegion ends at the beginning of the target TimeRegion; there is no intervening time and boundary instants are distinct; inverse of age_met_by</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/timeDisjoint"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/timeOlderThan"/>
    <owl:inverseOf rdf:resource="https://w3id.org/gso/1.0/common/timeMetBy"/>
  </rdf:Description>
