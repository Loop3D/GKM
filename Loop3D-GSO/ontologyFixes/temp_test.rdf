    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">technetium</rdfs:label>
    <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.britannica.com/science/technetium</rdfs:seeAlso>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Element"/>
