    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/ischart/isc2020-01"/>
    <gsoc:nextTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Eifelian2017"/>
