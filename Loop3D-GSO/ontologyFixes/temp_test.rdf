    <dct:source xml:lang="en">CGI Event Environment vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Setting characterized by pressures characteristic of upper mantle, but indicated by mineral assemblage in crustal composition rocks.</rdfs:comment>
