  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseBartonianSP2004">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologiccontact/Stratigraphic_Point"/>
    <rdfs:comment xml:lang="en">Contessa highway section near Gubio, Central Apennines, Italy</rdfs:comment>
    <rdfs:label xml:lang="en">Stratotype Point Base of Bartonian</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://stratigraphy.org/gssps/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Quartz_Gabbro">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Gabbroic_Rock"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Gabbroic rock that contains between 5 and 20 percent quartz in the QAPF fraction. QAPF field 10*.</rdfs:comment>
    <rdfs:label xml:lang="en">quartz gabbro</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseUpperCretaceousSP2002">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologiccontact/GSSP"/>
    <dct:source xml:lang="en">Episodes 27/1, p. 21 32, 2004</dct:source>
    <rdfs:comment xml:lang="en">36 meters below the top of the Marnes Bleues Formation on the south side of Mount Risou, Hautes Alpes, France</rdfs:comment>
    <rdfs:label xml:lang="en">GSSP Base of Upper Cretaceous</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://www.stratigraphy.org/GSSP/Cenomanian.pdf"/>
    <rdfs:seeAlso rdf:resource="https://stratigraphy.org/gssps/"/>
    <owl:versionInfo>2002</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b150">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b151"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b589">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/common/Time_Numeric_Value"/>
    <gsoc:hasDataValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">421.3</gsoc:hasDataValue>
    <gsoc:hasQuality rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b590"/>
    <gsoc:hasUOM rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b592"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfault/Dip_Slip">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">GGIC vocabularies working group (Australia)</dct:source>
    <rdfs:comment xml:lang="en">The net slip of the fault lies in the dip direction of the fault.</rdfs:comment>
    <rdfs:label xml:lang="en">dip slip</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfault/Fault_Slip"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologictime/Subperiod">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Named rank for geochronologic time interval. Sub-Periods may be subdivided into Epochs. Sub-Periods are grouped into a period.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Interval"/>
    <rdfs:subClassOf rdf:nodeID="n026ed78851694221944dcb0fbcf00073b53"/>
    <rdfs:subClassOf rdf:nodeID="n026ed78851694221944dcb0fbcf00073b59"/>
    <rdfs:subClassOf rdf:nodeID="n026ed78851694221944dcb0fbcf00073b63"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Continental_Crust_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al., 2005</dct:source>
    <rdfs:comment xml:lang="en">That type of the Earth's crust which underlies the continents and the continental shelves, it is equivalent to the sial and continental sima and ranges in thickness from about 25 km to more than 70 km under mountain ranges, averaging ~40 km. The density of the continental crust averages ~2.8 g/cm3 and is ~2.7 g.cm3 in the upper layer. The velocities of compressional seismic waves through it average ~6.5 km/s and are less than ~7.0 km/sec.</rdfs:comment>
    <rdfs:label xml:lang="en">continental crustal setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Crustal_Setting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/Rare_Proportion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Constituent is present but uncommon and rarely observed.</rdfs:comment>
    <rdfs:comment xml:lang="en">Example-- in a typical granite, zircon and apatite are rare constituents</rdfs:comment>
    <rdfs:label xml:lang="en">Rare constituent </rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Proportion_Value"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseBathonian2017">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Boundary"/>
    <rdfs:label xml:lang="en">Base of Bathonian</rdfs:label>
    <gsoc:hasEssentialPart rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b100"/>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/ischart/isc2017-02"/>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/ischart/isc2020-01"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ne509946f2e304dbfa7ee3477c0339f91b24">
    <rdf:first rdf:resource="https://w3id.org/gso/1.0/geology/Rock_Body"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Tephritoid">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Fine_Grained_Igneous_Rock"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Fine grained igneous rock than contains less than 90 percent mafic minerals, between 10 and 60 percent feldspathoid mineral in the QAPF fraction and has a plagioclase to total feldspar ratio greater than 0.5. Includes rocks classified in QAPF field 13 and 14 or chemically in TAS field U1 as basanite or tephrite.</rdfs:comment>
    <rdfs:label xml:lang="en">tephritoid</rdfs:label>
    <skos:altLabel xml:lang="en">tephritic rock</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ne509946f2e304dbfa7ee3477c0339f91b26">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/gso/1.0/common/hostedBy"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/gso/1.0/geology/Rock_Body"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Iron_Rich_Sedimentary_Rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Iron_Rich_Sedimentary_Material"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Sedimentary_Rock"/>
    <dct:source xml:lang="en">Hallsworth and Knox 1999; SLTTs 2004</dct:source>
    <rdfs:comment xml:lang="en">Sedimentary rock that consists of at least 50 percent iron-bearing minerals (hematite, magnetite, limonite-group, siderite, iron-sulfides), as determined by hand-lens or petrographic analysis. Corresponds to a rock typically containing 15 percent iron by weight.</rdfs:comment>
    <rdfs:label xml:lang="en">iron rich sedimentary rock</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b1223">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/common/Time_Numeric_Value"/>
    <gsoc:hasDataValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">458.4</gsoc:hasDataValue>
    <gsoc:hasQuality rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b1224"/>
    <gsoc:hasUOM rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b1226"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Abandoned_Channel_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al., 2005</dct:source>
    <rdfs:comment xml:lang="en">A drainage channel along which runoff no longer occurs, as on an alluvial fan</rdfs:comment>
    <rdfs:label xml:lang="en">abandoned river channel setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/River_Plain_System_Setting"/>
    <rdfs:subClassOf rdf:nodeID="n50ae2bf5eccd483b885316dab32dfbd1b1"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n099faa0fcafa464dac687bd05be17dc4b162">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="n099faa0fcafa464dac687bd05be17dc4b163"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n099faa0fcafa464dac687bd05be17dc4b16">
    <rdf:first rdf:nodeID="n099faa0fcafa464dac687bd05be17dc4b12"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/granularmaterial/angular">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Powers, M. C., 1953 A new roundness scale for sedimentary particles. Journal of Sedimentary Petrology, v. 23, p. 117-119</dct:source>
    <rdfs:comment xml:lang="en">A clastic sedimentary particle showing very little or no evidence of abrasion, with all of its edges and corners sharp, such as blocks with numerous (15-30) secondary corners and a roundness value between 0.17 and 0.25 (midpoint at 0.21).</rdfs:comment>
    <rdfs:label xml:lang="en">angular</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/granularmaterial/Grain_Roundness_Value"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologictime/BaseGreenlandian">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Boundary"/>
    <gsoc:timeEquivalentTo rdf:resource="https://w3id.org/gso/1.0/geologictime/BaseHolocene"/>
    <rdfs:label xml:lang="en">shared boundary with BaseHolocene</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/granularmaterial/Peloid_Particle_Material">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al., 2005</dct:source>
    <rdfs:comment xml:lang="en">Granular material consisting of usually rounded aggregates of clay-sized calcareous (micritic) material, origin and size are not specified</rdfs:comment>
    <rdfs:label xml:lang="en">peloid particle material</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/granularmaterial/Clastic_Granular_Material"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/mutuallySpecDependsOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:comment xml:lang="en">Mutual specific dependence: the relata specifically depend on each other.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/specificallyDependsOn"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b643">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/common/Time_Numeric_Value"/>
    <gsoc:hasDataValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.004250</gsoc:hasDataValue>
    <gsoc:hasUOM rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b644"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Siliceous_Ooze">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Ooze"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Silicate_Mud"/>
    <dct:source xml:lang="en">This vocabulary</dct:source>
    <rdfs:comment xml:lang="en">ooze that consists of more than 50 percent siliceous skeletal remains</rdfs:comment>
    <rdfs:label xml:lang="en">siliceous ooze</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b375">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/common/Measure_Value"/>
    <gsoc:hasDataValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.4</gsoc:hasDataValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfault/High_Angle_Fault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI faulttype SKOS vocabulary 2016-10-19</dct:source>
    <rdfs:comment xml:lang="en">Fault that dips at least 45 degrees over more than half of its recognized extent, for which slip or separation is not explicitly specified.</rdfs:comment>
    <rdfs:label xml:lang="en">high angle fault</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfault/Fault"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/UpperJurassic2017">
