  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologiclineation/particle_shape_lineation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI lineationtype SKOS vocabulary 2016-11-21</dct:source>
    <rdfs:comment xml:lang="en">Lineation defined by alignment of long axes of prolate-shaped particles such as clasts, fossils, crystals, or phenocrysts. Particles may be polycrystalline aggregates formed by deformation of pre-existing particles. General category does not specify genesis of particles or their alignment.</rdfs:comment>
    <rdfs:label xml:lang="en">particle shape lineation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicstructure/Lineation"/>
  </rdf:Description>
