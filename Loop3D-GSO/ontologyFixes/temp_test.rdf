  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Pyroclastic_Rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Fragmental_Igneous_Rock"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Pyroclastic_Material"/>
    <dct:source xml:lang="en">based on LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Fragmental igneous rock that consists of greater than 75 percent fragments produced as a direct result of eruption or extrusion of magma from within the earth onto its surface. Includes autobreccia associated with lava flows and excludes deposits reworked by epiclastic processes.</rdfs:comment>
    <rdfs:label xml:lang="en">pyroclastic rock</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseCryogenianSP2016">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologiccontact/Stratigraphic_Point"/>
    <rdfs:comment xml:lang="en">Defined chronometrically; but will be replaced by GSSP. The new Cryogenian GSSP will be placed at a globally correlative level that lies stratigraphically beneath the first appearance of widespread glaciation and is assigned in the interim a ‘calibrated age’ of circa 720 Ma (Episodes Vol. 39, no. 1)</rdfs:comment>
    <rdfs:label xml:lang="en">Stratotype Point Base of Cryogenian</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://doi.org/10.18814/epiiugs/2016/v39i1/89231"/>
    <rdfs:seeAlso rdf:resource="https://stratigraphy.org/gssps/"/>
  </rdf:Description>
