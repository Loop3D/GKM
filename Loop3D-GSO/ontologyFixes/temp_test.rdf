    <gsoc:hasQuality rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b763"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologictime/BaseGelasian">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Boundary"/>
    <rdfs:comment xml:lang="en">Interval for grouping all specific instances of the Base of Gelasian</rdfs:comment>
    <rdfs:label xml:lang="en">Base of Gelasian</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Anthracite_Coal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Coal"/>
    <dct:source xml:lang="en">Economic commission for Europe, committee on Sustainable Energy- United Nations (ECE-UN), 1998, International Classification of in-Seam Coals: Energy 19, 41 pp; see also Neuendorf et al. 2005; http://en.wikipedia.org/wiki/Coal#Types_of_coal; Eberhard Lindner; Chemie für Ingenieure; Lindner Verlag Karlsruhe, S. 258</dct:source>
    <rdfs:comment xml:lang="en">Coal that has vitrinite mean random reflectance greater than 2.0% (determined in conformance with ISO 7404-5). Less than 12-14 percent volatiles (dry, ash free), greater than 91 percent fixed carbon (dry, ash free basis). The highest rank coal; very hard, glossy, black, with semimetallic luster, semi conchoidal fracture.</rdfs:comment>
    <rdfs:label xml:lang="en">anthracite</rdfs:label>
    <rdfs:label xml:lang="de">anthrazit</rdfs:label>
    <skos:altLabel xml:lang="en">High rank coal</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/granularmaterial/Intraclastic_Particle_Material">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">NADM SLTTs 2004, Neuendorf et al., 2005, Folk, 1959</dct:source>
    <rdfs:comment xml:lang="en">Granular material consisting of torn-up and re-worked fragments of penecontemporaneous sediment (usually weakly consolidated) that has been eroded within the basin of deposition...and re-deposited there...The fragment may range in size from fine sand to gravel...  A term introduced by Folk (1959, p. 4) for a component of limestone. </rdfs:comment>
    <rdfs:label xml:lang="en">intraclastic particle material</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/granularmaterial/Clastic_Granular_Material"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ne509946f2e304dbfa7ee3477c0339f91b19">
    <rdf:first rdf:nodeID="ne509946f2e304dbfa7ee3477c0339f91b18"/>
    <rdf:rest rdf:nodeID="ne509946f2e304dbfa7ee3477c0339f91b20"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologictime/BaseMesoproterozoic">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/GSSA"/>
    <rdfs:comment xml:lang="en">Interval for grouping all specific instances of the Base of Mesoproterozoic</rdfs:comment>
    <rdfs:label xml:lang="en">Base of Mesoproterozoic</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseMiddleTriassic2004">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Boundary"/>
    <dct:source xml:lang="en">Gradstein, Ogg, Smith, 2004, A Geologic Time Scale 2004</dct:source>
    <rdfs:label xml:lang="en">Base of Middle Triassic</rdfs:label>
    <gsoc:hasEssentialPart rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b761"/>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/ischart/isc2004-04"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Peridotite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Phaneritic_Igneous_Rock"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Ultramafic_Igneous_Rock"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Ultramafic rock consisting of more than 40 percent (by volume) olivine with pyroxene and/or amphibole and little or no feldspar. commonly altered to serpentinite. Includes rocks defined modally in the ultramafic rock classification as dunite, harzburgite, lherzolite, wehrlite, olivinite, pyroxene peridotite, pyroxene hornblende peridotite or hornblende peridotite.</rdfs:comment>
    <rdfs:label xml:lang="en">peridotite</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseTithonian2017">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Boundary"/>
    <rdfs:label xml:lang="en">Base of Tithonian</rdfs:label>
    <gsoc:hasEssentialPart rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b1116"/>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/ischart/isc2017-02"/>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/ischart/isc2020-01"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n026ed78851694221944dcb0fbcf00073b34">
    <rdf:first rdf:resource="https://w3id.org/gso/1.0/geologictime/Epoch"/>
    <rdf:rest rdf:nodeID="n026ed78851694221944dcb0fbcf00073b35"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicrole/Protolith">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Role that relates a rock object to an altered, metasomatized, or metamorphic rock object produced from that rock. Non-metamorphosed rock object is role player, metamorphic product is the role object. Read X is protolith for Y.</rdfs:comment>
    <rdfs:label xml:lang="en">Protolith </rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Role"/>
    <rdfs:subClassOf rdf:nodeID="n8a923d1ff2a643c7adbaefc5fab5e81eb25"/>
    <rdfs:subClassOf rdf:nodeID="n8a923d1ff2a643c7adbaefc5fab5e81eb26"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Anorthosite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Anorthositic_Rock"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Anorthositic rock that contains between 0 and 5 percent quartz and no feldspathoid mineral in the QAPF fraction. QAPF field 10.</rdfs:comment>
    <rdfs:label xml:lang="en">anorthosite</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n099faa0fcafa464dac687bd05be17dc4b139">
    <rdf:first rdf:nodeID="n099faa0fcafa464dac687bd05be17dc4b135"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Quartz_Monzodiorite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Monzodioritic_Rock"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Monzodioritic rock that contains between 5 and 20 percent quartz.</rdfs:comment>
    <rdfs:label xml:lang="en">quartz monzodiorite</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/hasOutput">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">A participant in a process that is produced by the action of the process and is present when the process is complete.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/hasParticipant"/>
    <owl:inverseOf rdf:resource="https://w3id.org/gso/1.0/common/isOutputOf"/>
  </rdf:Description>
