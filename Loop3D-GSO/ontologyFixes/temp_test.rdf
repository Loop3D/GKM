    <dct:source xml:lang="en">Neuendorf et al 2005</dct:source>
    <rdfs:comment xml:lang="en">Cavity in volcanic rock formed by trapped gas. Use amygdule if filled with secondary mineral.</rdfs:comment>
    <rdfs:label xml:lang="en">vesicle</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Hole"/>
    <rdfs:subClassOf rdf:nodeID="naa8c0128327944708dff2431da5fc25cb11"/>
  </rdf:Description>
