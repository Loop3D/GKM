  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfoliation/scaly_cleavage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Discrete, anastomosing spaced cleavage characterized by smooth and highly polished/slickensided cleavage surfaces that intersect with one another to form lensoid flakes, scales or chips. Common in pelitic rocks in shear zones, melange, or deformed accretionary complexes.</rdfs:comment>
    <dct:source xml:lang="en">Based on Jackson 1997</dct:source>
    <rdfs:label xml:lang="en">scaly cleavage</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfoliation/spaced_cleavage"/>
  </rdf:Description>
