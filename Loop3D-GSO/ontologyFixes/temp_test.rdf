  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicrole/Framework_Crystals">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">crystal that form the main framework of an igneous or metamorphic rock. Framework is the essential supporting structure of a rock material, formed by a collection of particles all in mutual contact to form a continuous connected framerwork; the framework commonly comprises more that one mineral phase, represented as different granular materials in this model, all in the 'framework crystal' role.</rdfs:comment>
    <rdfs:label xml:lang="en">framework crystals</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicrole/Crystal_Role"/>
  </rdf:Description>
