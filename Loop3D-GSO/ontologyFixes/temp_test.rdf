  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Non_Clastic_Siliceous_Sediment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Non_Clastic_Siliceous_Sedimentary_Material"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Sediment"/>
    <dct:source xml:lang="en">NGMDB 2008; Hallsworth and Knox 1999</dct:source>
    <rdfs:comment xml:lang="en">Sediment that consists of at least 50 percent silicate mineral material, deposited directly by chemical or biological processes at the depositional surface, or in particles formed by chemical or biological processes within the basin of deposition.</rdfs:comment>
    <rdfs:label xml:lang="en">non clastic siliceous sediment</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b951">
    <rdf:type rdf:resource="http://qudt.org/vocab/unit/MegaYR"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologictime/BaseNorian">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Boundary"/>
    <rdfs:comment xml:lang="en">Interval for grouping all specific instances of the Base of Norian</rdfs:comment>
    <rdfs:label xml:lang="en">Base of Norian</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Anorthositic_Rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Phaneritic_Igneous_Rock"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002; This vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Anorthositic rock term invented to label the combined QAPF fields 10, 10*, and 10', in order to construct hierarchy in this vocabulary.</rdfs:comment>
    <rdfs:comment xml:lang="en">Leucocratic phaneritic crystalline igneous rock consisting essentially of plagioclase, often with small amounts of pyroxene. By definition, colour index M is less than 10, and plagiclase to total feldspar ratio is greater than 0.9. Less than 20 percent quartz and less than 10 percent feldspathoid in the QAPF fraction. QAPF field 10, 10*, and 10'.</rdfs:comment>
    <rdfs:label xml:lang="en">anorthositic rock</rdfs:label>
  </rdf:Description>
