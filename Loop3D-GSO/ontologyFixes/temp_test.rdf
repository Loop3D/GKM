  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Tidal_Channel_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al., 2005</dct:source>
    <rdfs:comment xml:lang="en">A major channel followed by the tidal currents, extending from offshore into a tidal marsh or a tidal flat.</rdfs:comment>
    <rdfs:label xml:lang="en">tidal channel setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Subaqueous_Setting"/>
