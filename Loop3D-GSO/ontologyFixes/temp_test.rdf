  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2016-06-15</dct:created>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-26</dct:created>
    <dct:creator rdf:resource="https://w3id.org/gso/1.0/common/boyan_brodaric"/>
    <dct:creator rdf:resource="https://w3id.org/gso/1.0/common/stephen_richard"/>
    <dct:creator xml:lang="en">CGI Geoscience Terminology Working Group, OWL adaptation by Stephen Richard for Loop3D project</dct:creator>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/legalcode"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-26</dct:modified>
    <dct:publisher>ARC Loop3D project;  https://loop3d.org/</dct:publisher>
    <dct:publisher>Geological Survey of Canada, Natural Resources Canada, Government of Canada</dct:publisher>
    <schema:codeRepository>https://github.com/Loop3D/GKM</schema:codeRepository>
    <dct:rights>Copyright (c) 2021 Government of Canada</dct:rights>
    <rdfs:comment xml:lang="en">Taken primarily from the 2016 SKOS-RDF version of the CGI Event Process vocabulary. This scheme specifies classes for geological processes that are associated with geological events, as defined by the IUGS Commission for Geoscience Information (CGI) Geoscience Terminology Working Group.</rdfs:comment>
    <rdfs:label xml:lang="en">Geoscience Ontology, Geologic Processes</rdfs:label>
    <dct:bibliographicCitation>Brodaric, B., and Richard, S.M., 2021, The GeoScience Ontology Reference: Geological Survey of Canada Open File 8796, 34 p., https://doi.org/10.4095/328296</dct:bibliographicCitation>
    <skos:definition xml:lang="en">Geologic processes to characterize geologic events.</skos:definition>
    <skos:prefLabel xml:lang="en">Geoscience Ontology, Geologic Processes</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ne509946f2e304dbfa7ee3477c0339f91b2">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/gso/1.0/common/hostedBy"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/gso/1.0/geology/Rock_Body"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Middle_Continental_Crust_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI Event Environment vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Continental crustal setting characterized by greenschist to upper amphibolite facies metamorphism, plutonic igneous rocks, and ductile deformation.</rdfs:comment>
    <rdfs:label xml:lang="en">middle continental crust setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Continental_Crust_Setting"/>
    <rdfs:subClassOf rdf:nodeID="n50ae2bf5eccd483b885316dab32dfbd1b44"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b120">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/common/Time_Numeric_Value"/>
    <gsoc:hasDataValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.8</gsoc:hasDataValue>
    <gsoc:hasUOM rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b121"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseMiddleOrdovicianSP2007">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologiccontact/GSSP"/>
    <dct:source xml:lang="en">Episodes 28/2, p. 105  117, 2005</dct:source>
    <rdfs:comment xml:lang="en">10.57 m above base of the Dawan Formation, Huanghuachang Section, NE of Yichang city, Hubei Province, S. China</rdfs:comment>
    <rdfs:comment xml:lang="en">Episodes 32/2, p. 96 113, 2009</rdfs:comment>
    <rdfs:label xml:lang="en">GSSP Base of Middle Ordovician - Dapingian</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://www.stratigraphy.org/GSSP/Dapingian1.pdf"/>
    <rdfs:seeAlso rdf:resource="http://www.stratigraphy.org/GSSP/Dapingian2.pdf"/>
    <rdfs:seeAlso rdf:resource="https://stratigraphy.org/gssps/"/>
    <owl:versionInfo>2007</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Acidic_Igneous_Rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Acidic_Igneous_Material"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Igneous_Rock"/>
    <dct:source xml:lang="en">after LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Igneous rock with more than 63 percent SiO2.</rdfs:comment>
    <rdfs:label xml:lang="en">acidic igneous rock</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Supraglacial_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">North American Geologic-map Data Model Science Language Technical Team, 2004, Sedimentary materials:science language for their classification, description, and interpretation in digital geologic-map databases, Version 1.0 (12/18/2004): U.S. Geological Survey Open-File Report 2004-1451 appendix C, 595 p., accessed at http://pubs.usgs.gov/of/2004/1451/sltt/appendixC/</dct:source>
    <rdfs:comment xml:lang="en">Carried upon, deposited from, or pertaining to the top surface of a glacier or ice sheet, said of meltwater streams, till, drift, etc. (Jackson, 1997, p. 639). Dreimanis (1988, p. 39) recommendation that \supraglacial\ supersede \superglacial\ is followed.</rdfs:comment>
    <rdfs:label xml:lang="en">supraglacial setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Glacier_Related_Setting"/>
    <rdfs:subClassOf rdf:nodeID="n50ae2bf5eccd483b885316dab32dfbd1b61"/>
  </rdf:Description>
