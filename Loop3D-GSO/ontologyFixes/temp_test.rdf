    <gsoc:staticHostedBy rdf:resource="https://w3id.org/gso/1.0/ischart/BaseFurongianSP2003"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologictime/GuadalupianEpoch">
