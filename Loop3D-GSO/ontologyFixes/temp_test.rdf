  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geology/Geologic_Time_Date">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Geologic Time Date</rdfs:label>
    <rdfs:comment xml:lang="en">A temporal coordinate value, located either by a point position (with uncertainty) on a time line, specified by a numeric coordinate (generally MYPB, but definitions of 'present' vary). Can be a GSSA if the numeric time coordinate is arbitrarily assigned.  Probably should specify a Temporal Reference System used to assign coordinate values.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Time_Instant_Feature"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Feature"/>
    <owl:disjointWith rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Boundary"/>
    <owl:disjointWith rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Interval"/>
    <owl:equivalentClass rdf:nodeID="n099faa0fcafa464dac687bd05be17dc4b67"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/element/magnesium">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">magnesium</rdfs:label>
    <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.britannica.com/science/magnesium</rdfs:seeAlso>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Element"/>
    <gsel:atomicNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12</gsel:atomicNumber>
    <gsel:chebiid rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://purl.obolibrary.org/obo/CHEBI_25107</gsel:chebiid>
    <gsel:symbol>Mg</gsel:symbol>
    <gsel:wikidataid rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.wikidata.org/entity/Q660</gsel:wikidataid>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Foid_Bearing_Alkali_Feldspar_Syenite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Alkali_Feldspar_Syenitic_Rock"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Alkali feldspar syenitic rock that contains 0-10 percent feldspathoid mineral and no quartz in the QAPF fraction. QAPF field 6'.</rdfs:comment>
    <rdfs:label xml:lang="en">foid bearing alkali feldspar syenite</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicrole/Syngenetic_Nodule">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">NADM SLTTs 2004, Jackson 1997</dct:source>
    <rdfs:comment xml:lang="en">Particle formed by chemical precipitation at sediment-water interface, lacking layered structure that characterizes coated grains. Includes glauconite grains, manganese nodules, phosphate grains. Manganese nodule--\An irregular, black to brown, friable</rdfs:comment>
    <rdfs:label xml:lang="en">syngenetic nodule</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicrole/Nodule"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Marine_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">North American Geologic-map Data Model Science Language Technical Team, 2004, Sedimentary materials:science language for their classification, description, and interpretation in digital geologic-map databases, Version 1.0 (12/18/2004): U.S. Geological Survey Open-File Report 2004-1451 appendix C, 595 p., accessed at http://pubs.usgs.gov/of/2004/1451/sltt/appendixC/, Webster's Encyclopedic Unabridged Dictionary of the English Language, 2001, p. 1894.</dct:source>
    <rdfs:comment xml:lang="en">Setting characterized by location under the surface of the sea.</rdfs:comment>
    <rdfs:label xml:lang="en">marine setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Planet_Surface_Setting"/>
    <rdfs:subClassOf rdf:nodeID="n50ae2bf5eccd483b885316dab32dfbd1b43"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/granularmaterial/Axiolitic_Particle_Material">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Williams, Turner, Gilbert 1954</dct:source>
    <rdfs:comment xml:lang="en">Material that is a collection of elongate to irregular lenticular particles with radial aggregates of acicular and fibrous mineral coalescing along a central axis.</rdfs:comment>
    <rdfs:label xml:lang="en">Axiolitic particle material</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/granularmaterial/Aggregate_NonClastic_Particle_Material"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b213">
    <rdf:first rdf:resource="https://w3id.org/gso/1.0/common/Process"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfold/Recumbent_Fold">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source>Fleuty (1964) Folds classification.</dct:source>
    <rdfs:comment xml:lang="en">A fold that has an essentially horizontal axial plane.</rdfs:comment>
    <rdfs:label xml:lang="en">Recumbent Fold </rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfold/Neutral_Fold"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologictime/BasePaleozoic">
