  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseCretaceousSP2004">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologiccontact/Stratigraphic_Point"/>
    <rdfs:comment xml:lang="en">Candidates include: (1) Magnetic -- base of Chron M18r, (2) Base of Calpionellid zone B, (3) ammonite FAD of Berriasella jacobi</rdfs:comment>
    <rdfs:label xml:lang="en">Stratotype Point Base of Cretaceous</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://stratigraphy.org/gssps/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicrole/Pseudomorph">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al. 2005, Spry 1969, Fettes and Desmons, 2007</dct:source>
    <rdfs:comment xml:lang="en">Constituent particle that has the outward form of a mineral species or particle type, but the original minerals composing the particle have been altered or replaced by different minerals, a secondary mineral whose outward crystal form has been inherited from the orignal mineral it has replaced</rdfs:comment>
    <rdfs:label xml:lang="en">pseudomorph</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Role"/>
    <rdfs:subClassOf rdf:nodeID="n8a923d1ff2a643c7adbaefc5fab5e81eb27"/>
    <rdfs:subClassOf rdf:nodeID="n8a923d1ff2a643c7adbaefc5fab5e81eb28"/>
  </rdf:Description>
