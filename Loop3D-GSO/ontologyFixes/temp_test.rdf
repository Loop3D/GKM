    <gsoc:hasQuality rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b1222"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseCambrianStage4-2004">
