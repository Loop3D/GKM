  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfoliation/primary_igneous_foliation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Foliation interpreted to be the product of igneous processes, formed in the rock while melt was still present..</rdfs:comment>
