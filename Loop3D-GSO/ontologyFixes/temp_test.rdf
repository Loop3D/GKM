  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfoliation/stromatic_layering">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Tectonic layering in which variations that distinguish the layers are the result of melt segregation during high-grade metamorphism, some layers have magmatic/igneous mineralogy. Plates 143 and 144, Borradaile et al [1982] (page 344-347) Syn. Migmatitic layering, lit-par-lit layering</rdfs:comment>
    <dct:source xml:lang="en">Weiss 1972, Borradaile et al 1982, Neuendorf et al. 2005</dct:source>
    <rdfs:label xml:lang="en">stromatic layering</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfoliation/metamorphic_layering"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b148">
