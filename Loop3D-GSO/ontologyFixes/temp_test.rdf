  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Phonolitoid">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Fine_Grained_Igneous_Rock"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Fine grained igneous rock than contains less than 90 percent mafic minerals, between 10 and 60 percent feldspathoid mineral in the QAPF fraction and has a plagioclase to total feldspar ratio less than 0.5. Includes rocks defined modally in QAPF fields 11 and 12, and TAS field Ph.</rdfs:comment>
    <rdfs:label xml:lang="en">phonolitoid</rdfs:label>
    <skos:altLabel xml:lang="en">phonolitic rock</skos:altLabel>
  </rdf:Description>
