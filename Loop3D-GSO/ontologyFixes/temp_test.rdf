  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/Chattian2017">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologictime/Age"/>
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Specific_Geologic_Time_Unit"/>
    <rdfs:comment xml:lang="en">older bound -27.82 Ma</rdfs:comment>
    <rdfs:comment xml:lang="en">younger bound -23.03 Ma</rdfs:comment>
    <rdfs:label xml:lang="en">Chattian Age</rdfs:label>
