    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A value of (essential part of) a quality; can be a measured value (e.g. 2.0), named value (e.g. thick), or a range (e.g. 2.0-2.2 or thin-thick). Values exist within a reference system.</rdfs:comment>
    <rdfs:label xml:lang="en">Quality Value</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Inherant"/>
    <rdfs:subClassOf rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b143"/>
