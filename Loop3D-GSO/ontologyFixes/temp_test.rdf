  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geology/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">Geoscience Ontology, Geology</rdfs:label>
    <dct:bibliographicCitation>Brodaric, B., and Richard, S.M., 2021, The GeoScience Ontology Reference: Geological Survey of Canada Open File 8796, 34 p., https://doi.org/10.4095/328296</dct:bibliographicCitation>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-03-26</dct:created>
    <dct:creator rdf:resource="https://w3id.org/gso/1.0/common/boyan_brodaric"/>
    <dct:creator rdf:resource="https://w3id.org/gso/1.0/common/stephen_richard"/>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/legalcode"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-26</dct:modified>
    <dct:publisher>ARC Loop3D project;  https://loop3d.org/</dct:publisher>
    <dct:publisher>Geological Survey of Canada, Natural Resources Canada, Government of Canada</dct:publisher>
    <dct:rights>Copyright (c) 2021 Government of Canada</dct:rights>
    <rdfs:comment xml:lang="en">Base geologic types and relations</rdfs:comment>
    <skos:definition xml:lang="en">Base geologic types and relations</skos:definition>
    <skos:prefLabel xml:lang="en">Geoscience Ontology, Geology</skos:prefLabel>
    <schema:codeRepository>https://github.com/Loop3D/GKM</schema:codeRepository>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nfbb732a7b8ed49199dc4f9702acc66c1b1">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onClass rdf:resource="https://w3id.org/gso/1.0/geologicfold/Fold_Axial_Surface"/>
    <owl:onProperty rdf:resource="https://w3id.org/gso/1.0/common/crosses"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/exemplification">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:comment xml:lang="en">Undirected relation between an example and the thing it exemplifies. Both instances and types can be exemples and exemplified, e.g. as typical instance of a type, or a typical part of something.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/isFundamentallyRelatedTo"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/granularmaterial/subhedral">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">MacKenzie, W.S., Donaldson, C.H. &amp; Guilford, C., 1982. Atlas of igneous rocks and their textures. John Wiley &amp; Sons, New York</dct:source>
    <rdfs:comment xml:lang="en">Crystalline particles in a rock are partly bounded by crystal faces, usually referring to igneous or metamorphic grains</rdfs:comment>
    <rdfs:label xml:lang="en">subhedral</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/granularmaterial/Grain_Roundness_Value"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/material_formed_in_surficial_environment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Composite_Genesis_Material"/>
    <dct:source xml:lang="en">This vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Material that is the product of weathering processes operating on pre-existing rocks or deposits, analogous to hydrothermal or metasomatic rocks, but formed at ambient Earth surface temperature and pressure.</rdfs:comment>
    <rdfs:label xml:lang="en">material formed in surficial environment</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Pure_Calcareous_Carbonate_Sediment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Calcareous_Carbonate_Sediment"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Pure_Carbonate_Sediment"/>
    <dct:source xml:lang="en">This vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Carbonate sediment in which greater than 90 percent of the constituents are composed of one (or more) of the carbonate minerals in particles of intrabasinal origin, and a calcite (plus aragonite) to dolomite ratio greater than 1 to 1.</rdfs:comment>
    <rdfs:label xml:lang="en">pure calcareous carbonate sediment</rdfs:label>
    <skos:altLabel xml:lang="en">lime sediment</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Alkali_Feldspar_Syenitic_Rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Syenitoid"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Syenitoid with a plagioclase to total feldspar ratio of less than 0.1. QAPF fields 6, 6*, and 6'.</rdfs:comment>
    <rdfs:label xml:lang="en">alkali feldspar syenitic rock</rdfs:label>
  </rdf:Description>
