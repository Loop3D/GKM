  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicquality/Very_Low_Metamorphic_Grade">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Smulikowski et al, 2003; Fry, 1984</dct:source>
    <rdfs:comment xml:lang="en">Rock very slightly metamorphosed, protolith structure ubiquitous, mineral assemblage of zeolite facies, subgreenschist facies, or low temperature part of blueschist facies. Mineral assemblages according to Fry (1984) Table 10-1: ultramafic-serpentine (quartz, magnesite), mafic-clay, chlorite, relict igneous minerals, calc-aluminous basic-zeolite, pumpellite, epidote, albite, pelite, semi-pelite -- clays, chlorite, sericite, quartz.</rdfs:comment>
    <rdfs:label xml:lang="en">very low metamorphic grade</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicquality/Metamorphosed"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicquality/Magnetic_Susceptibility">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source>https://en.wikipedia.org/wiki/Magnetic_susceptibility</dct:source>
    <rdfs:comment xml:lang="en">a measure of how much a material will become magnetized in an applied magnetic field. It is the ratio of magnetization M (magnetic moment per unit volume) to the applied magnetizing field intensity H. This allows a simple classification, into two categories, of most materials' responses to an applied magnetic field: an alignment with the magnetic field, χ &gt; 0, called paramagnetism, or an alignment against the field, χ &lt; 0, called diamagnetism.</rdfs:comment>
    <rdfs:label xml:lang="en">Magnetic susceptibility </rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Physical_Quality"/>
    <rdfs:subClassOf rdf:nodeID="nfc8a0206a38a4856aa36594b314ae7d7b20"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfoliation/comb_layering">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Layering fabric defined by layers that have internal comb structure. Layer boundaries are the termination surfaces for the constituent crystals.</rdfs:comment>
    <dct:source xml:lang="en">Neuendorf et al. 2005, CGI foliationtype SKOS vocabulary 2018-08-03</dct:source>
    <rdfs:label xml:lang="en">comb layering</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfoliation/layering"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/isConstituentOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relation between some particular and the object that it makes up.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/isPersistentPartOf"/>
    <owl:inverseOf rdf:resource="https://w3id.org/gso/1.0/common/hasConstituent"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n099faa0fcafa464dac687bd05be17dc4b108">
    <rdf:first rdf:resource="https://w3id.org/gso/1.0/geology/Rock_Grain_Material"/>
    <rdf:rest rdf:nodeID="n099faa0fcafa464dac687bd05be17dc4b109"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfault/Transform_Fault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">GGIC vocabularies working group (Australia)</dct:source>
    <rdfs:comment xml:lang="en">A variety of strike-slip fault along which the displacement suddenly stops or changes form, typically associated with mid-ocean ridges.</rdfs:comment>
    <rdfs:label xml:lang="en">transform</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfault/Strike_Slip_Fault"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologiccontact/GSSP">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>GSSP is dependent on some particular geologic event that is manifested globally in the stratigraphic record.</rdfs:comment>
    <rdfs:label xml:lang="en">GSSP </rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologiccontact/Stratigraphic_Point"/>
    <rdfs:subClassOf rdf:nodeID="n4b2f197944944da7ac1209a5b16ce6a0b2"/>
  </rdf:Description>
