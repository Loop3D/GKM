    <dct:source xml:lang="en">smr provisional 2020-06-07</dct:source>
    <rdfs:comment xml:lang="en">rock consisting of greater than 50% sulphide or sulfosalt minerals formed by sedimentary exhalative processes.</rdfs:comment>
    <rdfs:label xml:lang="en">Sedimentary Massive Sulphide</rdfs:label>
    <skos:altLabel xml:lang="en">Sedimentary Massive Sulfide</skos:altLabel>
  </rdf:Description>
