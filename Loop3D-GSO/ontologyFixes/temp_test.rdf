  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/isc2016-10">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Scale"/>
    <rdfs:comment xml:lang="en">RDF/OWL representation of the 2016-10 edition of the International Chronostratigraphic Chart from the International Commission on Stratigraphy. Encoded using OWL implementation from GSO. Adapted from Cox&amp;Richard OWL GeologicTime ontology</rdfs:comment>
    <rdfs:comment xml:lang="en">dc:source  Cohen, K.M., Finney, S.C., Gibbard, P.L. &amp; Fan, J.-X. (2013; updated) The ICS  International  Chronostratigraphic Chart. Episodes 36: 199-204.</rdfs:comment>
    <rdfs:comment xml:lang="en">dc:source  International  Chronostratigraphic Chart 2016</rdfs:comment>
    <rdfs:label xml:lang="en">International Chronostratigraphic Chart (2016)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicrole/Block">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI rockbodypart vocabulary 2016-11-21 </dct:source>
    <rdfs:comment xml:lang="en">Geologic unit part is one or more masses with generally sharp boundaries and block-like geometry within a matrix of some other material emplaced by processes at the earth's surface--e.g. volcanic eruption or mass wasting. Use for objects that are larger that what would be considered a clast, e.g. greater than about 10 m shortest dimension, typically large enough and sparse enough to be considered individual objects.</rdfs:comment>
    <rdfs:label xml:lang="en">blocks</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicrole/Inclusion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicstructure/Foliation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Jackson 1997</dct:source>
    <rdfs:comment xml:lang="en">Fabric defined by the planar arrangement of textural or structural features (fabric elements).</rdfs:comment>
    <rdfs:label xml:lang="en">Foliation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicstructure/Fabric"/>
    <rdfs:subClassOf rdf:nodeID="ncfb97c8f959a4b2d94f5de891117840fb4"/>
    <owl:disjointWith rdf:resource="https://w3id.org/gso/1.0/geologicstructure/Lineation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Aeolian_Process_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI Event Environment vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Sedimentary setting in which wind is the dominant process producing, transporting, and depositing sediment. Typically has low-relief plain or piedmont slope physiography.</rdfs:comment>
    <rdfs:label xml:lang="en">aeolian process setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Subaerial_Setting"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Terrestrial_Setting"/>
  </rdf:Description>
