  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfold/Fold_Amplitude">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">the length of half the distance from the crest of a fold to the adjacent troughs. </rdfs:comment>
    <rdfs:label xml:lang="en">Fold Amplitude</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Nonphysical_Quality"/>
