    <gsoc:hasStaticPart rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b261"/>
    <gsoc:staticHostedBy rdf:resource="https://w3id.org/gso/1.0/ischart/BaseCretaceousSP2004"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicrelation/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
