  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseJiangshanianSP2011">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologiccontact/GSSP"/>
    <dct:source xml:lang="en">Episodes 35/4, p.462-477, 2012</dct:source>
    <rdfs:comment xml:lang="en">the base of a limestone (wackestone) layer 108.12 m above the base of the Huayansi Formation in the Duibian B section, coinciding with the first appearance of the cosmopolitan agnostoid trilobite Agnostotes orientalis (base of the A. orientalis Zone), Zhejiang province, China</rdfs:comment>
    <rdfs:label xml:lang="en">GSSP Base of Jiangshanian</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://www.stratigraphy.org/GSSP/Jiangshanian.pdf"/>
    <rdfs:seeAlso rdf:resource="https://stratigraphy.org/gssps/"/>
    <owl:versionInfo>2011</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/element/rubidium">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">rubidium</rdfs:label>
    <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.britannica.com/science/rubidium</rdfs:seeAlso>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Element"/>
    <gsel:atomicNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">37</gsel:atomicNumber>
    <gsel:chebiid rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://purl.obolibrary.org/obo/CHEBI_33322</gsel:chebiid>
