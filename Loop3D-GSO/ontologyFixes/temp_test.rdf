  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicevent/Magnetic_Field_Reversal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI GTWG process vocabulary</dct:source>
    <rdfs:comment xml:lang="en">A geomagnetic event in which the Earth's magnetic field reverses direction.</rdfs:comment>
    <rdfs:label xml:lang="en">magnetic field reversal</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Event"/>
  </rdf:Description>
