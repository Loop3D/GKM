  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Strandplain_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">based on Jackson 1997, p. 626</dct:source>
    <rdfs:comment xml:lang="en">A prograded shore built seaward by waves and currents, and continuous for some distance along the coast. It is characterized by subparallel beach ridges and swales, in places with associated dunes.</rdfs:comment>
    <rdfs:label xml:lang="en">strandplain setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Shoreline_Setting"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Subaerial_Setting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/phyllic_altered_rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/altered_rock"/>
    <dct:source xml:lang="en">https://en.wikipedia.org/wiki/Phyllic_alteration</dct:source>
    <rdfs:comment xml:lang="en">Altered rock characterised by the assemblage of quartz + sericite + pyrite, and occurs at high temperatures and moderately acidic (low pH) conditions. Typically associated with copper porphyry ore deposits in calc-alkaline rocks.</rdfs:comment>
    <rdfs:label xml:lang="en">phyllic altered rock</rdfs:label>
  </rdf:Description>
