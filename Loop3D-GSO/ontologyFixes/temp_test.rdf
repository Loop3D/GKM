  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologiccontact/Lithogenetic_Contact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI contacttype SKOS vocabulary 2012-11-24</dct:source>
    <rdfs:comment xml:lang="en">A non-faulted contact separating bodies of material in the earth that have different lithologic character or geologic history.</rdfs:comment>
    <rdfs:label xml:lang="en">lithogenetic contact</rdfs:label>
