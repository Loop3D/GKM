  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologiclineation/cleavage_intersection_lineation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI lineationtype SKOS vocabulary 2016-11-21</dct:source>
    <rdfs:comment xml:lang="en">Lineation defined by the intersection of two cleavages.</rdfs:comment>
    <rdfs:label xml:lang="en">cleavage intersection lineation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologiclineation/intersection_lineation"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologiclineation/tectonic_lineation"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b442">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/common/Time_Numeric_Value"/>
    <gsoc:hasDataValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">303.7</gsoc:hasDataValue>
    <gsoc:hasQuality rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b443"/>
    <gsoc:hasUOM rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b445"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Continental_Rift_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI Event Environment vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Extended terrane in a zone of continental breakup, may include incipient oceanic crust. Examples include Red Sea, East Africa Rift, Salton Trough</rdfs:comment>
    <rdfs:label xml:lang="en">continental rift setting</rdfs:label>
