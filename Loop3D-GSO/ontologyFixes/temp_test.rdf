  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Diffusion_Creep">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf, K.K.E, Mehl, J.P. &amp; Jackson, J.A. (eds), 2005. Glossary of geology, 5th Edition. American Geological Institute, Alexandria, 779 p.</dct:source>
    <rdfs:comment xml:lang="en">Grain-scale, ductile deformation accomplished by the motion of atoms through crystals, along grain boundaries, and through pore fluids.</rdfs:comment>
    <rdfs:label xml:lang="en">diffusion creep</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Transformation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/Temporal_Gap">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Gap in time between perdurants, E.g. offseason = time between end of sports season and beginning of next; hosts = sports seasons (2020 and 2021 NHL campaign events), constituent = time interval; relation = temporally disjoint</rdfs:comment>
    <rdfs:label xml:lang="en">Temporal Gap </rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Temporal_Void"/>
    <rdfs:subClassOf rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b194"/>
  </rdf:Description>
