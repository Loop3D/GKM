    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A setting is a situation that provies context, usually casual, for a some individual.  E.g. Marine Setting and Alluvial Fan Setting are settings for things causally impacted by them. {@en</rdfs:comment>
    <rdfs:label xml:lang="en">Setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Situation"/>
  </rdf:Description>
