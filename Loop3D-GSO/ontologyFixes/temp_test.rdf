  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/sericitic_altered_rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/altered_rock"/>
    <dct:source xml:lang="en">https://en.wikipedia.org/wiki/Sericitic_alteration</dct:source>
    <rdfs:comment xml:lang="en">Rock in which plagioclase feldspar has been converted to sericite, an informal term for  fine-grained white phyllosilicate minerals. Commonly associated with phyllic altered rocks, used to describe less intense alteration.</rdfs:comment>
    <rdfs:label xml:lang="en">sericitic altered rock</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseArchean2004">
