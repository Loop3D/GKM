    <dct:source xml:lang="en">Episodes 30/2,p. 85 95, 2007</dct:source>
    <rdfs:comment xml:lang="en">at the base of a dark-gray thinly laminated calcisiltite layer, 62 m above the base of the Wheeler Formation, Drum Mountains, Millard County, Utah, USA</rdfs:comment>
    <rdfs:label xml:lang="en">GSSP Base of Drumian</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://stratigraphy.science.purdue.edu/references/Drumian0.pdf"/>
    <rdfs:seeAlso rdf:resource="http://www.stratigraphy.org/GSSP/Drumian.pdf"/>
