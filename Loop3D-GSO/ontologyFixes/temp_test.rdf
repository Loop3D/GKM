  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/hasRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">The directed relation between a role player, and the role. E.g. between a rock material and the clast that is made up of that material.</rdfs:comment>
    <rdfs:range rdf:resource="https://w3id.org/gso/1.0/common/Role"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/hasInherant"/>
