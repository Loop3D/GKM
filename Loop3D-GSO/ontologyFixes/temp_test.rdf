  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Barrier_Island_Coastline_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI Event Environment vocabulary</dct:source>
    <rdfs:comment xml:lang="en">setting meant to include all the various geographic elements typically associated with a barrier island coastline, including the barrier islands, and geomorphic/geographic elements that are linked by processes associated with the presence of the island (e.g. wash over fans, inlet channel, back barrier lagoon).</rdfs:comment>
    <rdfs:label xml:lang="en">barrier island coastline setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Shoreline_Setting"/>
  </rdf:Description>
