  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologiccontact/Sedimentary_Facies_Contact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">base on Nichols, Gary, 1999, Sedimentology and stratigraphy, Blackwell, p. 62-63.</dct:source>
    <rdfs:comment xml:lang="en">A lithogenetic contact separating essentially coeval sedimentary material bodies distinguished by characteristics reflecting different physical or chemical processes active at the time of deposition of the sediment.</rdfs:comment>
