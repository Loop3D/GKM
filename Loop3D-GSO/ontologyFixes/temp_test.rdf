    <gsoc:hasDataValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</gsoc:hasDataValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfault/Fault_Movement_Sense">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Quality that specifies the relative sense of displacement (right, left, up, down) between rocks on opposites of a fault.</rdfs:comment>
    <rdfs:label xml:lang="en">Fault movement sense </rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Physical_Quality"/>
    <rdfs:subClassOf rdf:nodeID="nae0fbe391b0449e5bb0dae53c5a2f6ceb8"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Quartz_Monzonite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Monzonitic_Rock"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Monzonitic rock that contains 5-20 percent quartz iin the QAPF fraction. Includes rocks defined modally in QAPF Field 8*.</rdfs:comment>
    <rdfs:label xml:lang="en">quartz monzonite</rdfs:label>
  </rdf:Description>
