  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Hornfels">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Granofels"/>
    <dct:source xml:lang="en">IUGS SCMR 2007 (http://www.bgs.ac.uk/SCMR/)</dct:source>
    <rdfs:comment xml:lang="en">Granofels formed by contact metamorphism, composed of a mosaic of equidimensional grains in a characteristically granoblastic or decussate matrix; porphyroblasts or relict phenocrysts may be present. Typically fine grained.</rdfs:comment>
    <rdfs:label xml:lang="en">hornfels</rdfs:label>
  </rdf:Description>
