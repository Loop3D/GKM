  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/Measure_Value">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A determinate value of a quality. SubClasses for numeric, spatial coordinate, and temporal coordinate value types. Use this generic value type for free text values e.g. "some text". Categorical values should be subclassed from gsoc:Named_Value</rdfs:comment>
