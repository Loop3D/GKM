  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Crustal_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al., 2005</dct:source>
    <rdfs:comment xml:lang="en">The outermost layer or shell of the Earth, defined according to various criteria, including seismic velocity, density and composition, that part of the Earth above the Mohorovicic discontinuity, made up of the sial and the sima.</rdfs:comment>
    <rdfs:label xml:lang="en">crustal setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Planet_Interior_Setting"/>
    <rdfs:subClassOf rdf:nodeID="n50ae2bf5eccd483b885316dab32dfbd1b14"/>
    <rdfs:subClassOf rdf:nodeID="n50ae2bf5eccd483b885316dab32dfbd1b15"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicquality/Azimuth">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Bearing of a horizontal line relative to north. Use for specifying the orientation of planar or linear features.</rdfs:comment>
    <rdfs:label xml:lang="en">Azimuth</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/quality/Orientation"/>
    <rdfs:subClassOf rdf:nodeID="nfc8a0206a38a4856aa36594b314ae7d7b2"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicreferencesystem/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-26</dct:created>
    <dct:creator rdf:resource="https://w3id.org/gso/1.0/common/stephen_richard"/>
    <dct:creator rdf:resource="https://w3id.org/gso/1.0/geologicreferencesystem/boyan_brodaric"/>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/legalcode"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-26</dct:modified>
    <dct:publisher>ARC Loop3D project;  https://loop3d.org/</dct:publisher>
    <dct:publisher>Geological Survey of Canada, Natural Resources Canada, Government of Canada</dct:publisher>
    <schema:codeRepository>https://github.com/Loop3D/GKM</schema:codeRepository>
    <dct:rights>Copyright (c) 2021 Government of Canada</dct:rights>
    <rdfs:label xml:lang="en">Geoscience Ontology, Geologic reference system</rdfs:label>
    <dct:bibliographicCitation>Brodaric, B., and Richard, S.M., 2021, The GeoScience Ontology Reference: Geological Survey of Canada Open File 8796, 34 p., https://doi.org/10.4095/328296</dct:bibliographicCitation>
    <rdfs:comment xml:lang="en">Reference systems used for measurement values, e.g. conventions for reporting orientation of planes or lines.</rdfs:comment>
    <skos:prefLabel xml:lang="en">Geoscience Ontology, Geologic reference system</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicquality/Moderately_Inclined">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source>Fleuty (1964) Folds classification.</dct:source>
    <rdfs:comment xml:lang="en">Surface dips between 30 and 60 degrees; typically used to describe orientation of fold hing surface or axial surface, but could be applied to any geologic surface.</rdfs:comment>
    <rdfs:label xml:lang="en">Moderately Inclinded </rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicquality/Inclined"/>
  </rdf:Description>
