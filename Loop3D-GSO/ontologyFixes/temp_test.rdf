  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfoliation/transposed_bedding_layering">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Layering interpreted to have originated as sedimentary bedding that has been transposed as a result of metamorphism and deformation.</rdfs:comment>
    <dct:source xml:lang="en">CGI foliationtype SKOS vocabulary 2018-08-03</dct:source>
    <rdfs:label xml:lang="en">transposed bedding layering</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfoliation/metamorphic_layering_inherited_from_protolith"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Foidite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Foiditoid"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Foiditoid that contains greater than 90 percent feldspathoid minerals in the QAPF fraction.</rdfs:comment>
    <rdfs:label xml:lang="en">foidite</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b150">
