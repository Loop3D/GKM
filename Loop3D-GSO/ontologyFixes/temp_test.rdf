  <rdf:Description rdf:about="https://w3id.org/gso/1.0/granularmaterial/Particle_Aspect_Ratio">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Property to describe the geometry of particles based on the (average) ratio of the length of long, intermediate and short axes of grains. Equates to sphericity in sedimentary rocks (ie: the degree to which the shape of a particle approximates a sphere).  A quantitative specification based on the ratio of lengths of long, intermediate and short axes of grain shape (Sneed and Folk, 1958; Zingg, 1935). (eg: prolate, slightly flattened, very bladed, equant, acicular, tabular)</rdfs:comment>
    <rdfs:isDefinedBy xml:lang="en">GeoSciML v4</rdfs:isDefinedBy>
    <rdfs:label xml:lang="en">Particle aspect ratio </rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Physical_Quality"/>
    <rdfs:subClassOf rdf:nodeID="ncfee6aa20821456a92f56028ebe7a3fbb11"/>
  </rdf:Description>
