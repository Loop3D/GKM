  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/MiddleCambrian2004">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologictime/Epoch"/>
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Specific_Geologic_Time_Unit"/>
    <rdfs:comment xml:lang="en">Middle Cambrian as defined in 2004-04. Gradstein et al. are unclear on precise determination of how Lower-Middle Cambrian boundary is defined. More research necessary.</rdfs:comment>
    <rdfs:comment xml:lang="en">dc:source-- Gradstein, Ogg, Smith, 2004, A Geologic Time Scale 2004</rdfs:comment>
    <rdfs:comment xml:lang="en">older bound -513 +|-2 Ma</rdfs:comment>
    <rdfs:comment xml:lang="en">younger bound -501 +|-2 Ma</rdfs:comment>
    <rdfs:label xml:lang="en">Middle Cambrian Epoch  </rdfs:label>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/geologictime/MiddleCambrianEpoch"/>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/ischart/isc2004-04"/>
    <gsoc:nextTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Furongian2004"/>
    <gsoc:previousTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/LowerCambrian2004"/>
    <gsoc:timeDuring rdf:resource="https://w3id.org/gso/1.0/ischart/Cambrian2004"/>
    <gsoc:timeFinishedBy rdf:resource="https://w3id.org/gso/1.0/ischart/BaseFurongian2004"/>
    <gsoc:timeStartedBy rdf:resource="https://w3id.org/gso/1.0/ischart/BaseMiddleCambrian2004"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/element/ytterbium">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">ytterbium</rdfs:label>
    <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.britannica.com/science/ytterbium</rdfs:seeAlso>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Element"/>
    <gsel:atomicNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">70</gsel:atomicNumber>
    <gsel:chebiid rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://purl.obolibrary.org/obo/CHEBI_33381</gsel:chebiid>
    <gsel:symbol>Yb</gsel:symbol>
    <gsel:wikidataid rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.wikidata.org/entity/Q1855</gsel:wikidataid>
