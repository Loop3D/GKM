  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfault/Transcurrent_Fault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">GGIC vocabularies working group (Australia)</dct:source>
    <rdfs:comment xml:lang="en">A large scale strike-slip fault in which the fault surface is steeply inclined.</rdfs:comment>
    <rdfs:label xml:lang="en">transcurrent</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfault/High_Angle_Fault"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfault/Strike_Slip_Fault"/>
  </rdf:Description>
