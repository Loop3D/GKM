  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/Perdurant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A perdurant is something that is not fully present at any timepoint, in the sense that an event, process or temporal interval exists over time, while an endurant exists in time. Perdurants are  time regions, such as an interval or instant of time, or they are things that occur in time, such as events or processes. Perdurants have only perdurant parts, and can only have fixed qualities that have unchanging values (e.g. the duration of a time interval); if there is some quality that apparently changes for the perdurant, it is a fixed quality of a part of the perdurant, but is not a quality of the perdurant itself (e.g. the intensity of a process varies over the whole process, but has fixed values for certain time-indexed parts of the process).</rdfs:comment>
    <rdfs:label xml:lang="en">Perdurant</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Particular"/>
    <rdfs:subClassOf rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b105"/>
    <rdfs:subClassOf rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b106"/>
    <rdfs:subClassOf rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b107"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b140">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="https://w3id.org/gso/1.0/common/Quality_Value"/>
    <owl:onProperty rdf:resource="https://w3id.org/gso/1.0/common/hasValue"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Oceanic_Crust_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al., 2005</dct:source>
    <rdfs:comment xml:lang="en">That type of the Earth's crust which underlies the ocean basins. The oceanic crust is 5-10 km thick, it has a density of 2.9 g/cm3, and compressional seismic-wave velocities travelling through it at 4-7.2 km/sec. Setting in crust produced by submarine volcanism at a mid ocean ridge.</rdfs:comment>
    <rdfs:label xml:lang="en">oceanic crustal setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Crustal_Setting"/>
  </rdf:Description>
