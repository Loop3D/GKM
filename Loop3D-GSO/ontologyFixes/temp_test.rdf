    <gsoc:hasUOM rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b1302"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologiclineation/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-26</dct:created>
    <dct:creator rdf:resource="https://w3id.org/gso/1.0/common/boyan_brodaric"/>
    <dct:creator rdf:resource="https://w3id.org/gso/1.0/common/stephen_richard"/>
    <dct:creator xml:lang="en">CGI Geoscience Terminology Working Group; OWL adoption by Stephen Richard for Loop3D project</dct:creator>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/legalcode"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-26</dct:modified>
    <dct:publisher>ARC Loop3D project;  https://loop3d.org/</dct:publisher>
    <dct:publisher>Geological Survey of Canada, Natural Resources Canada, Government of Canada</dct:publisher>
    <schema:codeRepository>https://github.com/Loop3D/GKM</schema:codeRepository>
    <dct:rights>Copyright (c) 2021 Government of Canada</dct:rights>
    <rdfs:comment xml:lang="en">This vocabulary specifies subclasses of gsos:Lineation, as defined by the IUGS Commission for Geoscience Information (CGI) Geoscience Terminology Working Group CGI Lineation Type vocabulary. Original vocabular developed for populating Lineation Type properties in GeoSciML GeologicStructure/Lineation elements, adopted here for Loop3D ontology.</rdfs:comment>
    <rdfs:label xml:lang="en">Geoscience Ontology, Lineation</rdfs:label>
    <dct:bibliographicCitation>Brodaric, B., and Richard, S.M., 2021, The GeoScience Ontology Reference: Geological Survey of Canada Open File 8796, 34 p., https://doi.org/10.4095/328296</dct:bibliographicCitation>
    <skos:definition xml:lang="en">Types of lineation</skos:definition>
    <skos:prefLabel xml:lang="en">Geoscience Ontology, Lineation</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b916">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/common/Time_Instant_Location"/>
    <gsoc:hasStaticValue rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b917"/>
