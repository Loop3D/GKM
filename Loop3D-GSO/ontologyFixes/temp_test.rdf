  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Foid_Bearing_Gabbro">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Gabbroic_Rock"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Gabbroic rock that contains 0-10 percent feldspathoid minerals and no quartz in the QAPF fraction. QAPF field 10'.</rdfs:comment>
    <rdfs:label xml:lang="en">foid bearing gabbro</rdfs:label>
  </rdf:Description>
