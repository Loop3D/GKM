  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfeature/Miarolitic_Cavity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al 2005</dct:source>
    <rdfs:comment xml:lang="en">An irregular cavity in a phaneritic igneous rock into which small crystals of the rock-forming minerals protrude.</rdfs:comment>
    <rdfs:label xml:lang="en">miarolitic cavity</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfeature/Vug"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockobject/Mantle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A planet's mantle, e.g. the Earth's mantle. Is a geologic object, because it is constituted by a mixture of geologic solid and fluid material. </rdfs:comment>
    <rdfs:label xml:lang="en">Mantle</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Object"/>
  </rdf:Description>
