    <gsoc:previousTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/LowerPennsylvanian2004"/>
    <gsoc:timeDuring rdf:resource="https://w3id.org/gso/1.0/ischart/Pennsylvanian2004"/>
