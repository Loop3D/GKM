    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Metamorphic layering of uncertain origin, defined by subtle mineralogical or textural variations, with gradational layer boundaries. See plate 142 in Borradaile et al [1982].</rdfs:comment>
    <dct:source xml:lang="en">Weiss 1972,Borradaile et al 1982, CGI foliationtype SKOS vocabulary 2018-08-03</dct:source>
    <rdfs:label xml:lang="en">vague metamorphic layering</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfoliation/metamorphic_layering"/>
  </rdf:Description>
