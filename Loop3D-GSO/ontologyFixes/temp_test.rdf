  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfeature/Vug">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al 2005</dct:source>
    <rdfs:comment xml:lang="en">Irregular cavity in rock, generic term with no connotation of origin of cavity. May be lined with crystals of different mineral compostion to the host rock</rdfs:comment>
    <rdfs:label xml:lang="en">vug</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Hole"/>
    <rdfs:subClassOf rdf:nodeID="naa8c0128327944708dff2431da5fc25cb12"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Ultramafic_Igneous_Rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Igneous_Rock"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002; Gillespie and Styles 1999</dct:source>
    <rdfs:comment xml:lang="en">Igneous rock that consists of greater than 90 percent mafic minerals.</rdfs:comment>
    <rdfs:label xml:lang="en">ultramafic igneous rock</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseFurongianSP2003">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologiccontact/GSSP"/>
    <dct:source xml:lang="en">Lethaia 37, p. 365 379, 2004</dct:source>
    <rdfs:comment xml:lang="en">at 396 m in the Huaqiao Formation, Wuling Mountains, Huayuan County, NW Hunan Province, China</rdfs:comment>
    <rdfs:label xml:lang="en">GSSP Base of Furongian Series - Paibian</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://www.stratigraphy.org/GSSP/Paibian.pdf"/>
    <rdfs:seeAlso rdf:resource="https://stratigraphy.org/gssps/"/>
    <owl:versionInfo>2003</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Foid_Bearing_Monzodiorite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Monzodioritic_Rock"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Monzodioritic rock that contains between 0 and 10 percent feldspathoid mineral.</rdfs:comment>
    <rdfs:label xml:lang="en">foid bearing monzodiorite</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Granitoid">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Acidic_Igneous_Rock"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Phaneritic_Igneous_Rock"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Phaneritic crystalline igneous rock consisting of quartz, alkali feldspar and/or plagioclase. Includes rocks defined modally in QAPF fields 2, 3, 4 and 5 as alkali feldspar granite, granite, granodiorite or tonalite.</rdfs:comment>
    <rdfs:label xml:lang="en">granitoid</rdfs:label>
    <skos:altLabel xml:lang="en">granitic rock</skos:altLabel>
  </rdf:Description>
