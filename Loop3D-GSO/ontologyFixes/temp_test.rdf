    <rdfs:subClassOf rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b142"/>
    <owl:disjointWith rdf:resource="https://w3id.org/gso/1.0/common/Quality_Value"/>
    <owl:disjointWith rdf:resource="https://w3id.org/gso/1.0/common/Role"/>
  </rdf:Description>
