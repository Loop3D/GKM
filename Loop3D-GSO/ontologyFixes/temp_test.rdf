  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Delta_System_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">North American Geologic-map Data Model Science Language Technical Team, 2004, Sedimentary materials:science language for their classification, description, and interpretation in digital geologic-map databases, Version 1.0 (12/18/2004): U.S. Geological Survey Open-File Report 2004-1451 appendix C, 595 p., accessed at http://pubs.usgs.gov/of/2004/1451/sltt/appendixC/</dct:source>
    <rdfs:comment xml:lang="en">Environments at the mouth of a river or stream that enters a standing body of water (ocean or lake). The delta forms a triangular or fan-shaped plain of considerable area. Subaerial parts of the delta are crossed by many distributaries of the main river, and commonly extend beyond the general trend of the coast. Subaqueous parts of the delta merge with the adjacent basin floor, and are progressively influenced by non-fluvial processes. Deltas result from the accumulation of sediment supplied by the river in such quantities that it is not removed by tides, waves, and currents. Adapted from the Glossary of Geology definition for delta (Jackson, 1997, p. 167).</rdfs:comment>
    <rdfs:label xml:lang="en">deltaic system setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Shoreline_Setting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/Neogene2004">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologictime/Period"/>
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Specific_Geologic_Time_Unit"/>
    <rdfs:comment xml:lang="en">older bound -23.03 Ma</rdfs:comment>
    <rdfs:comment xml:lang="en">younger bound -0 Ma</rdfs:comment>
    <rdfs:label xml:lang="en">Neogene Period</rdfs:label>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/geologictime/NeogenePeriod"/>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/ischart/isc2004-04"/>
    <gsoc:previousTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Chattian2004"/>
    <gsoc:previousTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Oligocene2004"/>
    <gsoc:previousTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Paleogene2004"/>
    <gsoc:timeFinishedBy rdf:resource="https://w3id.org/gso/1.0/ischart/Present"/>
    <gsoc:timeFinishes rdf:resource="https://w3id.org/gso/1.0/ischart/Cenozoic2004"/>
    <gsoc:timeStartedBy rdf:resource="https://w3id.org/gso/1.0/ischart/BaseNeogene2004"/>
    <gsoc:timeStartedBy rdf:resource="https://w3id.org/gso/1.0/ischart/Miocene2004"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Hydrothermal_Massive_Sulphide">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Massive_Sulphide"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Metasomatic_Rock"/>
    <dct:source xml:lang="en">provisional by SMR 2020-06-07</dct:source>
    <rdfs:comment xml:lang="en">Rock consisting of greater that 50% sulphide or sulfosalt minerals formed by hydrothermal mineralization processes.</rdfs:comment>
    <rdfs:label xml:lang="en">Hydrothermal Massive Sulphide</rdfs:label>
    <skos:altLabel xml:lang="en">Hydrothermal Massive Sulfide</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Rock_Gypsum_Or_Anhydrite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Evaporite"/>
    <dct:source xml:lang="en">This vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Evaporite composed of at least 50 percent gypsum or anhydrite.</rdfs:comment>
    <rdfs:label xml:lang="en">gypsum or anhydrite</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologictime/PaleogenePeriod">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologictime/Period"/>
