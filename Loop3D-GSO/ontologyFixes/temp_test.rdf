    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicrelation/overprintedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">relationship in which a subject  Rock_Body or Physical_Feature is interpreted to have a subject fabric (foliation or lineation) imposed on it</rdfs:comment>
    <rdfs:domain rdf:nodeID="ne509946f2e304dbfa7ee3477c0339f91b33"/>
    <rdfs:label xml:lang="en">overprinted by</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/timeOlderThan"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/geology/isGeologicallyRelatedTo"/>
    <owl:inverseOf rdf:resource="https://w3id.org/gso/1.0/geologicrelation/overprints"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfault/Strike_Slip">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">GGIC vocabularies working group (Australia), this vocabulary</dct:source>
    <rdfs:comment xml:lang="en">The net slip of the fault (slip vector) is parallel to the strike of the fault.</rdfs:comment>
    <rdfs:label xml:lang="en">strike slip</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfault/Fault_Slip"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/Carboniferous2017">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologictime/Period"/>
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Specific_Geologic_Time_Unit"/>
