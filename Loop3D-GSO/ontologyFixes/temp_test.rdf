    <owl:disjointWith rdf:resource="https://w3id.org/gso/1.0/common/Range_Value"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseHolocene2004">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Boundary"/>
    <rdfs:comment xml:lang="en">Base of Holocene as defined in 2004-04, before definition of GSSP. Gradstein, Ogg and Smith 2004 assert Exactly 10000 carbon-14 years (11.5 ka calendar years BP). End of the Younger Dryas cold spell.</rdfs:comment>
    <rdfs:label xml:lang="en">Base Holocene  </rdfs:label>
    <gsoc:hasEssentialPart rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b477"/>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/ischart/isc2004-04"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicquality/Metamorphic_Grade">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A term to indicate the intensity or rank of metamorphism applied to an EarthMaterial (eg: high metamorphic grade, low metamorphic grade). Indicates in a general way the P-T environment in which the metamorphism took place. Determination of metamorphic grade is based on mineral assemblages (ie, facies) present in a rock that are interpreted to have crystallized in equilibrium during a particular metamorphic event.</rdfs:comment>
    <rdfs:comment xml:lang="en">applies to Earth_Material or Geologic_Unit</rdfs:comment>
    <rdfs:isDefinedBy xml:lang="en">GeoSciML v4</rdfs:isDefinedBy>
    <rdfs:label xml:lang="en">Metamorphic grade</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Physical_Quality"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b25">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/gso/1.0/common/hasRolePlayer"/>
    <owl:someValuesFrom rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b26"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b611">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/common/Uncertainty"/>
    <gsoc:hasValue rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b612"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Granite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Granitoid"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Phaneritic crystalline rock consisting of quartz, alkali feldspar and plagioclase (typically sodic) in variable amounts, usually with biotite and/or hornblende. Includes rocks defined modally in QAPF Field 3.</rdfs:comment>
    <rdfs:label xml:lang="en">granite</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b330">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Point"/>
    <gsoc:hasStaticPart rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b331"/>
    <gsoc:staticHostedBy rdf:resource="https://w3id.org/gso/1.0/ischart/BaseEmsianSP1995"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Foid_Bearing_Alkali_Feldspar_Trachyte">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Alkali_Feldspar_Trachytic_Rock"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Alkali feldspar trachytic rock that contains no quartz and between 0 and 10 percent feldspathoid mineral in the QAPF fraction. QAPF field 6'.</rdfs:comment>
    <rdfs:label xml:lang="en">foid bearing alkali feldspar trachyte</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/Part">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">The part in a whole-part relation</rdfs:comment>
