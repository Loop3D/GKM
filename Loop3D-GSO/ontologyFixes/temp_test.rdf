  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Coastal_Plain_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">based on Neuendorf et al, 2005, p. 125</dct:source>
    <rdfs:comment xml:lang="en">A low relief plain bordering a water body extending inland to the nearest elevated land, sloping very gently towards the water body. Distinguished from alluvial plain by presence of relict shoreline-related deposits or morphology.</rdfs:comment>
    <rdfs:label xml:lang="en">coastal plain setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Shoreline_Setting"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Subaerial_Setting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/isc2009-08">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Scale"/>
    <rdfs:comment xml:lang="en">RDF/OWL representation of the 2009-08 edition of the International Chronostratigraphic Chart from the International Commission on Stratigraphy. Encoded using OWL implementation from GSO. Adapted from Cox&amp;Richard OWL GeologicTime ontology</rdfs:comment>
    <rdfs:comment xml:lang="en">dc:source  International  Chronostratigraphic Chart 2009</rdfs:comment>
    <rdfs:label xml:lang="en">International Chronostratigraphic Chart (2009)</rdfs:label>
  </rdf:Description>
