    <gsoc:timeStarts rdf:resource="https://w3id.org/gso/1.0/geologictime/BasePermian"/>
    <rdfs:comment xml:lang="en">Interval for grouping all specific instances of the Asselian Age</rdfs:comment>
    <rdfs:label xml:lang="en">Asselian Age</rdfs:label>
  </rdf:Description>
