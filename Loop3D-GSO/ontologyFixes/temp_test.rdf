  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b680">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/common/Time_Instant"/>
    <gsoc:hasQuality rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b681"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Reef_Flat_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al., 2005</dct:source>
    <rdfs:comment xml:lang="en">A stony platform of reef rock, landward of the reef crest at or above the low tide level, occasionally with patches of living coral and associated organisms, and commonly strewn with coral fragments and coral sand. It may include shallow pools, irregular gullies, low islands of sand or rubble (often vegetated, esp. by palms), and scattered colonies of the more hardy species of coral</rdfs:comment>
    <rdfs:label xml:lang="en">reef flat setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Biological_Reef_Setting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicquality/Horizonatal_Inclination">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Surface dips between 0 and 10 degrees. Equivalent term 'recumbent' used to describe orientation of fold hing surface or axial surface</rdfs:comment>
    <rdfs:label xml:lang="en">Horizontal inclination </rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicquality/Dip_Value"/>
  </rdf:Description>
