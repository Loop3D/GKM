  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Quartzite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Metamorphic_Rock"/>
    <dct:source xml:lang="en">after Neuendorf et al. 2005</dct:source>
    <rdfs:comment xml:lang="en">Metamorphic rock consisting of greater than or equal to 75 percent quartz; typically granoblastic texture.</rdfs:comment>
    <rdfs:label xml:lang="en">quartzite</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b1299">
