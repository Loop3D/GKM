    <gsoc:previousTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/MiddleMississippian2004"/>
    <gsoc:previousTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Visean2004"/>
    <gsoc:timeFinishedBy rdf:resource="https://w3id.org/gso/1.0/ischart/BasePennsylvanian2004"/>
