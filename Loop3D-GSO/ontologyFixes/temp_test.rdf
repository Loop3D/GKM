    <gsoc:nextTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Cisuralian2017"/>
    <gsoc:nextTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Permian2017"/>
    <gsoc:previousTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Devonian2017"/>
    <gsoc:previousTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Famennian2017"/>
    <gsoc:previousTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/UpperDevonian2017"/>
    <gsoc:timeDuring rdf:resource="https://w3id.org/gso/1.0/ischart/Paleozoic2017"/>
