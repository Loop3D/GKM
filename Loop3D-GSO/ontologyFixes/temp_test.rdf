  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/High_Magnesium_Fine_Grained_Igneous_Rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Fine_Grained_Igneous_Rock"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">fine-grained igneous rock that contains unusually high concentration of MgO. For rocks that contain greater than 52 percent silica, MgO must be greater than 8 percent. For rocks containing less than 52 percent silica, MgO must be greater than 12 percent.</rdfs:comment>
    <rdfs:label xml:lang="en">high magnesium fine grained igneous rock</rdfs:label>
  </rdf:Description>
