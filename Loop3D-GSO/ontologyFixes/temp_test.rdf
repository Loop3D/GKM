    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/hasDependent"/>
    <owl:inverseOf rdf:resource="https://w3id.org/gso/1.0/common/inheresIn"/>
  </rdf:Description>
