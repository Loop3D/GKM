  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Marine_Carbonate_Platform_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI Event Environment vocabulary</dct:source>
    <rdfs:comment xml:lang="en">A shallow submerged plateau separated from continental landmasses, on which high biological carbonate production rates produce enough sediment to maintain the platform surface near sea level. Grades into atoll as area becomes smaller and ringing coral reefs become more prominent part of the setting.</rdfs:comment>
    <rdfs:label xml:lang="en">marine carbonate platform setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Marine_Setting"/>
    <rdfs:subClassOf rdf:nodeID="n50ae2bf5eccd483b885316dab32dfbd1b42"/>
  </rdf:Description>
