  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseKatianSP2006">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologiccontact/GSSP"/>
    <dct:source xml:lang="en">Episodes 30/4, p.258 270, 2007</dct:source>
    <rdfs:comment xml:lang="en">4.0m above the base of the Bigfork Chert, Black Knob Ridge Section, Atoka, Oklahoma (USA)</rdfs:comment>
    <rdfs:label xml:lang="en">GSSP Base of Katian</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://www.episodes.org/backissues/304/304.htm"/>
    <rdfs:seeAlso rdf:resource="http://www.stratigraphy.org/GSSP/Katian.pdf"/>
    <rdfs:seeAlso rdf:resource="https://stratigraphy.org/gssps/"/>
    <owl:versionInfo>2006</owl:versionInfo>
  </rdf:Description>
