  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Ash_Tuff_Lapillistone_And_Lapilli_Tuff">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Pyroclastic_Rock"/>
    <dct:source xml:lang="en">Schmid 1981; LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Pyroclastic rock in which less than 25 percent of rock by volume are more than 64 mm in longest diameter. Includes tuff, lapilli tuff, and lapillistone.</rdfs:comment>
    <rdfs:label xml:lang="en">ash tuff lapillistone and lapilli tuff</rdfs:label>
  </rdf:Description>
