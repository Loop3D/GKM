  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfault/High_Angle_Normal_Fault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI faulttype SKOS vocabulary 2016-10-19</dct:source>
    <rdfs:comment xml:lang="en">Fault that dips at least 45 degrees over more than half of the recognized extent of the fault with the hanging wall displaced from a structurally higher position relative to footwall rocks.</rdfs:comment>
    <rdfs:label xml:lang="en">high angle normal fault</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfault/High_Angle_Fault"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfault/Normal_Fault"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/unconsolidated">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Consolidation_Degree_Value"/>
    <dct:source xml:lang="en">CGI consolidationdegree SKOS vocabulary 2012-11-24</dct:source>
    <rdfs:comment xml:lang="en">Particulate constituents of a compound material do not adhere to each other strongly enough that the aggregate can be considered a solid in its own right.</rdfs:comment>
    <rdfs:label xml:lang="en">unconsolidated</rdfs:label>
  </rdf:Description>
