    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Igneous_Rock"/>
    <dct:source xml:lang="en">after LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Igneous rock with less than 45 percent SiO2.</rdfs:comment>
    <rdfs:label xml:lang="en">ultrabasic igneous rock</rdfs:label>
  </rdf:Description>
