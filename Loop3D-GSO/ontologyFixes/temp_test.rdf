  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Transform_Plate_Boundary_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI Event Environment vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Plate boundary at which the adjacent plates are moving laterally relative to each other.</rdfs:comment>
    <rdfs:label xml:lang="en">transform plate boundary setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Plate_Margin_Setting"/>
