  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Partial_Melting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf, K.K.E, Mehl, J.P. &amp; Jackson, J.A. (eds), 2005. Glossary of geology, 5th Edition. American Geological Institute, Alexandria, 779 p.</dct:source>
    <rdfs:comment xml:lang="en">Process of melting involving only some of the mineral phases in a rock, to produce a mixture of melt and residual particles.</rdfs:comment>
    <rdfs:label xml:lang="en">partial melting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicprocess/Melting"/>
  </rdf:Description>
