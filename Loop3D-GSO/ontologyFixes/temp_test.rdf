  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfault/Strike_Separation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">GGIC vocabularies working group (Australia)</dct:source>
