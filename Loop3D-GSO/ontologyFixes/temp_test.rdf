    <rdfs:label xml:lang="en">Guadalupian Epoch</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b920">
    <rdf:type rdf:resource="http://qudt.org/vocab/unit/MegaYR"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/granularmaterial/Bioclastic_Particle_Material">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">This vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Granular material consisting of particles that are shell, bone, or other hard skeletal structure of an animal, plant, or protozoan. May be fossilized or non-fossilized. Use in situations where fossil organism can not be identified, thus 'material fossil' is too specific.</rdfs:comment>
    <rdfs:label xml:lang="en">bioclastic particle material</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/granularmaterial/Biogenic_Particle_Material"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Swamp_Or_Marsh_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al 2005, Soil Science Society of America, 1997.</dct:source>
    <rdfs:comment xml:lang="en">A water-saturated, periodically wet or continually flooded area with the surface not deeply submerged, essentially without the formation of peat. Marshes are characterized by sedges, cattails, rushes, or other aquatic and grasslike vegetation. Swamps are characterized by tree and brush vegetation.</rdfs:comment>
    <rdfs:label xml:lang="en">swamp or marsh setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Wetland_Setting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicquality/ontology">
