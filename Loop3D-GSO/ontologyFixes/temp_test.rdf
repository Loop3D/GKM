  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/exemplifies">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Directed relation between an exemple and the thing being exemplfied.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/exemplification"/>
    <owl:inverseOf rdf:resource="https://w3id.org/gso/1.0/common/isExemplifiedBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/hasDependent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Directed relation between a dependee (the thing being relied on) and the dependent (the thing that relies on something).</rdfs:comment>
    <rdfs:label xml:lang="en">has dependent</rdfs:label>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/dependance"/>
    <owl:inverseOf rdf:resource="https://w3id.org/gso/1.0/common/dependsOn"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicrole/Roof_pendant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al 2005</dct:source>
    <rdfs:comment xml:lang="en">A pendant that is demonstrably derived from the upper boundary of an igneous body.</rdfs:comment>
    <rdfs:label xml:lang="en">Roof pendant</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicrole/Pendant"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b267">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Point"/>
    <gsoc:hasStaticPart rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b268"/>
    <gsoc:staticHostedBy rdf:resource="https://w3id.org/gso/1.0/ischart/BaseCretaceousSP2004"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicreferencesystem/Plane_Azimuth_Dip_RHR">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A spatial reference system for describing orientation of surfaces relative to the Earth. Azimuth measured in degrees measured clockwise (eastward) from true North, with the downward dipping direction on the right when facing in the azimuth direction. Dip (inclination) is relative to local horizontal.</rdfs:comment>
    <rdfs:label xml:lang="en">Azimuth and Dip (Right Hand Rule)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Physical_Reference_System"/>
  </rdf:Description>
