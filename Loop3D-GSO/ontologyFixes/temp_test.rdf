    <rdfs:comment xml:lang="en">younger bound -443.7 +|-1.5 Ma</rdfs:comment>
    <rdfs:label xml:lang="en">Hirnantian Age</rdfs:label>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/geologictime/HirnantianAge"/>
