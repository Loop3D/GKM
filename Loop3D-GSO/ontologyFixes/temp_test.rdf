  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/isEssentialPartOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relation of being an essential part of a whole, such that whole is generically dependent on the part, and the part can be exchanged or missing.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/hasDependent"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/isPartOf"/>
    <owl:inverseOf rdf:resource="https://w3id.org/gso/1.0/common/hasEssentialPart"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfoliation/continuous_cleavage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A cleavage that is statistically homogeneous down to the scale of individual mineral grains.</rdfs:comment>
    <dct:source xml:lang="en">Borradaile et al 1982</dct:source>
    <rdfs:label xml:lang="en">continuous cleavage</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfoliation/cleavage"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologiclineation/pencil_lineation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">based on Neuendorf et al 2005</dct:source>
    <rdfs:comment xml:lang="en">Lineation defined by tendency of rock to break into long, slender pieces resembling pencils. Typically produced by intesection of bedding and cleavage or intersection of two cleavages. Fabric is generally only observed in weakly metamorphosed rocks.</rdfs:comment>
    <rdfs:label xml:lang="en">pencil lineation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicstructure/Lineation"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.w3.org/2000/01/rdf-schema#seeAlso">
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/hasAnnotation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologiccontact/Nonconformable_Contact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf, K.K.E, Mehl, J.P. &amp; Jackson, J.A. (eds), 2005. Glossary of geology, 5th Edition. American Geological Institute, Alexandria, 779 p.</dct:source>
    <rdfs:comment xml:lang="en">An unconformable contact between an underlying, older nonstratified geological unit (usually intrusive igneous rocks or metamorphics) and an overlying, younger stratified geological unit.</rdfs:comment>
    <rdfs:label xml:lang="en">nonconformable contact</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologiccontact/Unconformable_Contact"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologictime/BasePaibian">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Boundary"/>
    <gsoc:timeEquivalentTo rdf:resource="https://w3id.org/gso/1.0/geologictime/BaseFurongian"/>
    <rdfs:label xml:lang="en">shared boundary with BaseFurongian</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b642">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/common/Time_Instant_Location"/>
    <gsoc:hasStaticValue rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b643"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Serpentinite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Metamorphic_Rock"/>
    <dct:source xml:lang="en">Neuendorf et al. 2005</dct:source>
    <rdfs:comment xml:lang="en">Rock consisting of more than 75 percent serpentine-group minerals, eg. antigorite, chrysotile or lizardite; accessory chlorite, talc and magnetite may be present; derived from hydration of ferromagnesian silicate minerals such as olivine and pyroxene.</rdfs:comment>
    <rdfs:label xml:lang="en">serpentinite</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b216">
