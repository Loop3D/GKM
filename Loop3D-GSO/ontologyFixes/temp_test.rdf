  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfoliation/protomylonite_foliation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Generic mylonitic foliation in which 10-50 percent of rock is matrix due to tectonic grain size reduction processes. Planar aspect of fabric may be quite subtle in weakly deformed rocks.</rdfs:comment>
    <dct:source xml:lang="en">NADM metamorphic rock vocabulary (https://pubs.usgs.gov/of/2004/1451/sltt/appendixB/appendixB.pdf) SLTTm1.0 2004,  Sibson 1977</dct:source>
    <rdfs:label xml:lang="en">protomylonite foliation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfoliation/generic_mylonitic_foliation"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b62">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/gso/1.0/common/hasEssentialPart"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/gso/1.0/common/Material_Endurant"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b221">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
