  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Exotic_Evaporite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Evaporite"/>
    <dct:source xml:lang="en">This vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Category represents evaporite material that is not mostly gypsum/anhydrite or halite. These are generally not very common, thus the 'exotic' name</rdfs:comment>
    <rdfs:comment xml:lang="en">Evaporite that is not 50 percent halite or 50 percent gypsum or anhydrite.</rdfs:comment>
    <rdfs:label xml:lang="en">exotic evaporite</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/element/helium">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">helium</rdfs:label>
    <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.britannica.com/science/helium-chemical-element</rdfs:seeAlso>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Element"/>
    <gsel:atomicNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</gsel:atomicNumber>
