    <owl:someValuesFrom rdf:nodeID="n099faa0fcafa464dac687bd05be17dc4b11"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologiccontact/Conductivity_Contact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI contacttype SKOS vocabulary 2012-11-24</dct:source>
    <rdfs:comment xml:lang="en">A geophysical contact between bodies of material distinguished based on electrical conductivity characteristics</rdfs:comment>
    <rdfs:label xml:lang="en">conductivity contact</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologiccontact/Geophysical_Contact"/>
