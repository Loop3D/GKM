  <rdf:Description rdf:nodeID="n8a923d1ff2a643c7adbaefc5fab5e81eb19">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/gso/1.0/common/hasRolePlayer"/>
    <owl:someValuesFrom rdf:nodeID="n8a923d1ff2a643c7adbaefc5fab5e81eb20"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/granularmaterial/Particle_Sorting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">The Sorting attribute holds text terms to specify size distribution of particles in a CompoundMaterial. Terminology for sorting in sedimentary rocks is based in the quantitative Graphic Standard Deviation (IGSD) scheme proposed by Folk (1968, 1974).  Example terms for this attribute may include sedimentary terms such as well sorted and poorly sorted, or igneous terms such as porphyritic, equigranuilar, seriate.</rdfs:comment>
    <rdfs:isDefinedBy xml:lang="en">GeoSciML v4</rdfs:isDefinedBy>
    <rdfs:label xml:lang="en">Particle sorting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Physical_Quality"/>
    <rdfs:subClassOf rdf:nodeID="ncfee6aa20821456a92f56028ebe7a3fbb15"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/hasDataValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Directed relation between a measure value and a simple data type - xsd:anySimpleType - e.g. as a number, string, or date.</rdfs:comment>
    <rdfs:domain rdf:resource="https://w3id.org/gso/1.0/common/Measure_Value"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anySimpleType"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/isFundamentallyRelatedTo"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nfc8a0206a38a4856aa36594b314ae7d7b28">
    <rdf:first rdf:resource="https://w3id.org/gso/1.0/common/Named_Value"/>
    <rdf:rest rdf:nodeID="nfc8a0206a38a4856aa36594b314ae7d7b29"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n026ed78851694221944dcb0fbcf00073b65">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="n026ed78851694221944dcb0fbcf00073b66"/>
