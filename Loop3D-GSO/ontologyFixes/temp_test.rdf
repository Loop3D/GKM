  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseSakmarianSP2020">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologiccontact/GSSP"/>
    <rdfs:comment xml:lang="en">The base of the Sakmarian Stage is defined in Bed 26/3 at 55.4m above the base of the Usolka Section, southern Urals, Russia. It coincides with the first occurrence of conodont Mesogondolella monstra.</rdfs:comment>
    <rdfs:label xml:lang="en">GSSP Base of Sakmarian</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://timescalefoundation.org/gssp/detail.php?periodid=89&amp;top_parentid=77"/>
    <owl:versionInfo>2018</owl:versionInfo>
  </rdf:Description>
