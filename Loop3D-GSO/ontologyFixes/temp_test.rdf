    <rdfs:label xml:lang="en">Spatial Region</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Physical_Endurant"/>
    <rdfs:subClassOf rdf:nodeID="nd61eda891d324cf2b12b4208980eba67b175"/>
