  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Ash_And_Lapilli">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Tephra"/>
