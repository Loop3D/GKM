    <rdf:first rdf:resource="https://w3id.org/gso/1.0/geology/Rock_Object"/>
    <rdf:rest rdf:nodeID="n099faa0fcafa464dac687bd05be17dc4b168"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ne509946f2e304dbfa7ee3477c0339f91b33">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:unionOf rdf:nodeID="ne509946f2e304dbfa7ee3477c0339f91b34"/>
