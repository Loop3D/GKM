    <gsoc:nextTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/LowerOrdovician2017"/>
    <gsoc:nextTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Ordovician2017"/>
