  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Geodynamo_Process">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Process that generates electric currents due to the motion of convection currents of molten iron in the Earth's outer core, caused by heat escaping from the core. Process responsible for Earth’s magnetic field.</rdfs:comment>
    <rdfs:label xml:lang="en">Geodynamo process</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicprocess/Geomagnetic_Process"/>
