  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Foid_Diorite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Foid_Dioritoid"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Foid dioritoid in which the plagioclase to total feldspar ratio is greater than 0.9. Includes rocks defined modally in QAPF field 14.</rdfs:comment>
    <rdfs:label xml:lang="en">foid diorite</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Upper_Bathyal_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Berggren, W.A. &amp; Miller, K.G., 1989. Cenozoic bathyal and abyssal calcareous benthic foraminiferal zonation. Micropalaeontology 35, 308-320</dct:source>
    <rdfs:comment xml:lang="en">The ocean environment at water depths between 200 and 600 metres</rdfs:comment>
    <rdfs:label xml:lang="en">upper bathyal setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Bathyal_Setting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/hasStaticPart">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">The specifc individual that is a part must always be co-present with whole, cannot be exchanged nor missing, and whole is specifically dependent on it.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/constantlySpecDependsOn"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/hasPersistentPart"/>
    <owl:inverseOf rdf:resource="https://w3id.org/gso/1.0/common/isStaticPartOf"/>
  </rdf:Description>
