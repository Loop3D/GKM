    <gsoc:timeStartedBy rdf:resource="https://w3id.org/gso/1.0/ischart/BaseUpperMississippian2017"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Playa_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Based on Hawley and Parsons, 1980</dct:source>
    <rdfs:comment xml:lang="en">The usually dry and nearly level plain that occupies the lowest parts of closed depressions, such as those occurring on intermontane basin floors. Temporary flooding occurs primarily in response to precipitation-runoff events.</rdfs:comment>
    <rdfs:label xml:lang="en">playa setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Arid_Or_Semi_Arid_Environment_Setting"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Subaerial_Setting"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Terrestrial_Setting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/granularmaterial/Coprolite_Particle_Material">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al., 2005</dct:source>
    <rdfs:comment xml:lang="en">Granular material consisting of the fossilised excrement of vertebrate animals</rdfs:comment>
    <rdfs:label xml:lang="en">coprolite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/granularmaterial/Biogenic_Particle_Material"/>
  </rdf:Description>
