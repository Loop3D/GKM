  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Tectonic_Process">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">this vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Processes related to the interaction between or deformation of rigid plates forming the crust of the Earth.</rdfs:comment>
    <rdfs:label xml:lang="en">Tectonic Process</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Process"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n22856b26283e4e44a884a593ef04b6f6b762">
