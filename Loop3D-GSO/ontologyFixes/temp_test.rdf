  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfault/Oblique_Slip">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">GGIC vocabularies working group (Australia), SMR</dct:source>
    <rdfs:comment xml:lang="en">The net slip of the fault lies between the strike and dip directions of the fault, the slip vector rakes between 10 and 80 degrees in the plane of the fault.</rdfs:comment>
    <rdfs:label xml:lang="en">oblique slip</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfault/Fault_Slip"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n099faa0fcafa464dac687bd05be17dc4b176">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/gso/1.0/common/hasPart"/>
