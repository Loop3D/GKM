    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(SiO&lt;sub&gt;3&lt;/sub&gt;OH)&lt;sub&gt;2&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1191</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1191:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1191.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(SiO&lt;sub&gt;3&lt;/sub&gt;OH)&lt;sub&gt;2&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060570</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cuprosklodowskite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cuprosklodowskite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Vaes J P (1933) Sur un minéral de Kalongwe (Katanga), Annales de la Société Géologique de Belgique 56, B331-B332</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.AK.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl neso- and polysilicate</gsmin:strunzlabel>
