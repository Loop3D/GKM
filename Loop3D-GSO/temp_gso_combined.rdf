    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: TetraantimonyIII tetraoxy sulfate dihydroxyl</gsmin:iupacchemname>
