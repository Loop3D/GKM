  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/chabourneite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Chabournéite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Tl | Pb | Sb | As | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/chabourneite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tl&lt;sub&gt;4&lt;/sub&gt;Pb&lt;sub&gt;2&lt;/sub&gt;(Sb,As)&lt;sub&gt;20&lt;/sub&gt;S&lt;sub&gt;34&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1976-042</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-957</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:957:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-957.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tl&lt;sup&gt;1+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(Sb&lt;sup&gt;3+&lt;/sup&gt;,As&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;20&lt;/sub&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;34&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070371 | R140106</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Chabournéite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Chabourneite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Johan Z, Mantienne J, Picot P (1981) La chabournéite, un nouveau minéral thallifère, Bulletin de Minéralogie 104, 10-15 Chemical formula revised: Nestola F, Guastoni A, Bindi L, Secco L (2009) Dalnegroite, Tl&lt;sub&gt;5-x&lt;/sub&gt;Pb&lt;sub&gt;2x&lt;/sub&gt;(As,Sb)&lt;sub&gt;21-x&lt;/sub&gt;S&lt;sub&gt;34&lt;/sub&gt;, a new thallium sulphosalt from Lengenbach quarry, Binntal, Switzerland, Mineralogical Magazine 73, 1027-1032</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Chabournéite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.HC.05e</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">SnS type sulfosalt with only Pb</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Chabourn%E9ite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1976-042</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/martinite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Martinite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Si | S | B | O | H | Cl | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;,Ca)&lt;sub&gt;12&lt;/sub&gt;Ca&lt;sub&gt;4&lt;/sub&gt;(Si,S,B)&lt;sub&gt;14&lt;/sub&gt;B&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;38&lt;/sub&gt;(OH,Cl)&lt;sub&gt;2&lt;/sub&gt;F&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2001-059</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-26345</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:26345:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-26345.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;,Ca)&lt;sub&gt;12&lt;/sub&gt;Ca&lt;sub&gt;4&lt;/sub&gt;(Si,S,B)&lt;sub&gt;14&lt;/sub&gt;B&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;38&lt;/sub&gt;(OH,Cl)&lt;sub&gt;2&lt;/sub&gt;F&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Martinite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Martinite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">McDonald A M, Chao G Y (2007) Martinite, a new hydrated sodium calcium fluorborosilicate species from Mont Saint-Hilaire, Quebec: Description, structure determination and genetic implication, The Canadian Mineralogist 45, 1281-1292</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Gyrolite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EE.80</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate: Single tetrahedral nets of 6-membered rings connected by octahedral nets or octahedral bands</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Martinite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2001-059</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/chvaleticeite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Chvaleticeite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">hexahydrite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/chvaleticeite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn(SO&lt;sub&gt;4&lt;/sub&gt;)·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1984-059</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Manganese sulfate hexahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1049</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1049:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1049.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Chvaleticeite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Chvaleticeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pasava J, Breiter K, Huka M, Korecký J (1986) Chvaleticeite, (Mn,Mg)SO&lt;sub&gt;4&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O, a new mineral, Neues Jahrbuch für Mineralogie, Monatshefte 1986, 121-125</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hexahydrite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.CB.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, with H2O, With only medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Chvaleticeite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1984-059</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/nukundamite">
