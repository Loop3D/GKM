  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/richterite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Richterite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Mg | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">amphibole-group 3 Na-Ca</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/richterite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na(NaCa)Mg&lt;sub&gt;5&lt;/sub&gt;Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Redefined|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3416</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3416:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3416.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na(CaNa)Mg&lt;sub&gt;5&lt;/sub&gt;Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050414 | R060043 | R060471 | R100069</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Richterite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Richterite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Breithaupt A (1865) Mineralogische studien. 25. Richterit, Berg- und Huttenmannische Zeitung 24, 364-364 Redefined: Leake B E, Woolley A R, Arps C E S, Birch W D, Gilbert M C, Grice J D, Hawthorne F C, Kato A, Kisch H J, Krivovichev V G, Linthout K, Laird J, Mandarino J A, Maresch W V, Nickel E H, Rock N M S, Schumacher J C, Smith D C, Stephenson N C N, Ungaretti L, Whittaker E J W, Youzhi G (1997) Nomenclature of amphiboles: Report of the subcommittee on amphiboles of the International Mineralogical Association, commission on new minerals and mineral names, The Canadian Mineralogist 35, 219-246</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Amphibole</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DE.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 2-periodic double chains, Si4O11; Clinoamphiboles</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Richterite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1865</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/foretite">
