    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KNa&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(Li&lt;sub&gt;3&lt;/sub&gt;Si&lt;sub&gt;12&lt;/sub&gt;)O&lt;sub&gt;30&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1974-060</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
