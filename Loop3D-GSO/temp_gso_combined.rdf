    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1114:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1114.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hg&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;55&lt;/sub&gt;N&lt;sup&gt;3-&lt;/sup&gt;&lt;sub&gt;24&lt;/sub&gt;(N&lt;sup&gt;3-&lt;/sup&gt;H&lt;sub&gt;2&lt;/sub&gt;,OH)&lt;sub&gt;4&lt;/sub&gt;(Cl,Br)&lt;sub&gt;34&lt;/sub&gt;</gsmin:rruffchemistry>
