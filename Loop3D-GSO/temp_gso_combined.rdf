    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;6&lt;/sub&gt;Al&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;18&lt;/sub&gt;[Na(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;6&lt;/sub&gt;](SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1976-033</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Questionable mineral species|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2793</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2793:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2793.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;6&lt;/sub&gt;Al&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;18&lt;/sub&gt;[Na(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;6&lt;/sub&gt;](S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070337</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Motukoreaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Motukoreaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Rodgers K A, Chisholm J E, Davis R J, Nelson C S (1977) Motukoreaite, a new hydrated carbonate, sulphate, and hydroxide of Mg and Al from Auckland, New Zealand, Mineralogical Magazine 41, 389-390</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Woodwardite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.DD.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With only medium-sized cations; sheets of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Motukoreaite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1976-033</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ice-vii">
