  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/luetheite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Luetheite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Al | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/luetheite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1976-011</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dicopper dialuminium diarsenate tetrahydroxyl monohydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2456</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2456:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2456.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060088</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Luetheite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Luetheite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Williams S A (1977) Luetheite, Cu_2_Al_2_(AsO_4_)_2_(OH)_4_·H_2_O, a new mineral from Arizona, compared with chenevixite, Mineralogical Magazine 41, 27-32</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Chenevixite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DD.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With only medium-sized cations, (OH, etc.):RO4= 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Luetheite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1976-011</gsmin:wikipediadate>
  </rdf:Description>
