    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;7&lt;/sub&gt;Al(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(HCO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;F&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Barentsite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Barentsite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Khomyakov A P, Kurova T A, Nechelyustov G N, Piloyan G O (1983) Barentsite, Na&lt;sub&gt;7&lt;/sub&gt;AlH&lt;sub&gt;2&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;F&lt;sub&gt;4&lt;/sub&gt;, a new mineral, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 112(4), 474-479</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.BB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions, without H2O, With alkalies, etc.</gsmin:strunzlabel>
