    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2500:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2500.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">MgAl&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Magnesiocarpholite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Magnesiocarpholite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mineral described in this paper: Goffé B, Goffé-Urbano G, Saliot P (1973) Sur la présence d'une variété magnésienne de ferrocarpholite en Vanoise (Alpes françaises), Comptes Rendus de L’Académie des Sciences Paris 277, 1965-1968 Mineral named in this paper: Goffé B (1977) Présence de cookéite dans les bauxites métamorphiques du Dogger de la Vanoise (Savoie), Bulletin de la Société Française de Minéralogie et de Cristallographie 100, 254-257</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Carpholite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 2-periodic single chains, Si2O6; Pyroxene-related minerals</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Magnesiocarpholite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1978-027</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Organic_Bearing_Mudstone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al. 2005; http://en.wikipedia.org/wiki/Oil_shale</dct:source>
    <rdfs:comment xml:lang="en">Mudstone that contains a significant amount of organic carbon, typically kerogen. commonly finely laminated, brown or black in color.</rdfs:comment>
    <rdfs:label xml:lang="en">organic bearing mudstone</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Generic_Mudstone"/>
    <skos:altLabel xml:lang="en">oil shale</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/tritomite-ce">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
