    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Copper lead antimonide trisulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-741</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:741:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-741.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;1+&lt;/sup&gt;Pb&lt;sup&gt;2+&lt;/sup&gt;Sb&lt;sup&gt;3+&lt;/sup&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050111 | R050364</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bournonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Bournonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Jameson R (1805) Bournonite, System of Mineralogy II, Bell and Bradfute (Edinburgh, U.K.) 579-582</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Bournonite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.GA.50</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Neso-sulfarsenite without additional S</gsmin:strunzlabel>
