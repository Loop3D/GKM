  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/arsenoclasite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Arsenoclasite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/arsenoclasite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: PentamanganeseII diarsenate tetrahydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-364</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:364:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-364.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Arsenoclasite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Arsenoclasite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named arsenoklasite: Aminoff G (1931) Contributions to the mineralogy of Långban I-V. V: Arsenoklasite, a new arsenate from Långban, Kunglig Svenska Vetenskapsakademiens Handlingar 9, 52-57</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Arsenoclasite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BD.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With only medium-sized cations, (OH, etc.):RO4= 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Arsenoclasite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1931</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/tsepinite-ca">
