  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfault/Low_Angle_Normal_Fault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI faulttype SKOS vocabulary 2016-10-19</dct:source>
    <rdfs:comment xml:lang="en">Fault that dips less than 45 degrees over more than half of the recognized extent of the fault with the hanging wall displaced from a structurally higher position relative to footwall rocks.</rdfs:comment>
    <rdfs:label xml:lang="en">low angle normal fault</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfault/Low_Angle_Fault"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfault/Normal_Fault"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/quadruphite">
