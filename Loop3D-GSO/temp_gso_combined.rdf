    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaAl&lt;sub&gt;3&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Sodium trialuminium disulfate hexahydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-2850</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2850:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2850.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaAl&lt;sub&gt;3&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060406</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Natroalunite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Natroalunite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hillebrand W F, Penfield S L (1902) Some additions to the alunite-jarosite group of minerals, American Journal of Science 164, 211-220 Redefined: Bayliss P, Kolitsch U, Nickel E H, Pring A (2010) Alunite supergroup: recommended nomenclature, Mineralogical Magazine 74, 919-927</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Alunite-Alunite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.BC.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions, without H2O, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Natroalunite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1902</gsmin:wikipediadate>
  </rdf:Description>
