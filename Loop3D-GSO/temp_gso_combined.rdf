    <gsmin:rruffnameplain xml:lang="en">Plumbotellurite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Spiridonov E M, Tananeyva O I (1982) Plumbotellurite, a-PbTeO3, a new mineral, Doklady Akademii Nauk SSSR 262, 1231-1235 Fleischer M, Cabri L J, Chao G Y, Mandarino J A, Pabst A (1982) New mineral names, American Mineralogist 67, 1074-1082</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.??</gsmin:strunzcodeV10>
