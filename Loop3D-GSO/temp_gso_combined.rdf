  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ramazzoite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ramazzoite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mg | Cu | P | O | C | H | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">[Mg&lt;sub&gt;8&lt;/sub&gt;Cu&lt;sub&gt;12&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;24&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;20&lt;/sub&gt;][(H&lt;sub&gt;0.33&lt;/sub&gt;SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;36&lt;/sub&gt;]</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2017-090</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">[Mg&lt;sub&gt;8&lt;/sub&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;12&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;24&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;20&lt;/sub&gt;][(H&lt;sub&gt;0.33&lt;/sub&gt;S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;36&lt;/sub&gt;]</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ramazzoite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ramazzoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf A R, Rossman G R, Ma C, Belmonte D, Biagioni C, Castellaro F, Chiappino L (2018) Ramazzoite, [Mg_8_Cu_12_(PO_4_)(CO_3_)_4_(OH)_24_(H_2_O)_20_][(H_0.33_SO_4_)_3_(H_2_O)_36_], the first mineral with a polyoxometalate cation. European Journal of Mineralogy 30, 827-834</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Interdistributary_Bay_Setting">
