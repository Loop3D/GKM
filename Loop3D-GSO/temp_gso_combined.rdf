  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ferroaluminoceladonite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ferroaluminoceladonite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/mineral/celadonitefamily"/>
    <gsmin:chemistryelements>K | Fe | Al | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">mica-true micas</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KFe&lt;sup&gt;2+&lt;/sup&gt;AlSi&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1995-019</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:mindatid>min-6933</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:6933:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-6933.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KFe&lt;sup&gt;2+&lt;/sup&gt;AlSi&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ferroaluminoceladonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ferroaluminoceladonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Li G, Peacor D R, Coombs D S, Kawachi Y (1997) Solid solution in the celadonite family: the new minerals ferroceladonite, K_2_Fe^2+^_2_Fe^3+^_2_Si_8_O_20_(OH)_4_, and ferroaluminoceladonite, K_2_Fe^2+^_2_Al_2_Si_8_O_20_(OH)_4_, American Mineralogist 82, 503-511 Name changed from ferro-aluminoceladonite: Burke E A J (2008) Tidying up mineral names: an IMA-CNMNC scheme for suffixes, hyphens and diacritical marks, The Mineralogical Record 39, 131-135</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Mica</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EC.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with mica sheets, composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Ferro-aluminoceladonite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1995-019</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/chesnokovite">
