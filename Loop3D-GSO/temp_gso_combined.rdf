    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;12&lt;/sub&gt;Th&lt;sub&gt;3&lt;/sub&gt;(Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;19&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;·18H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1985-050</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3947</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3947:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3947.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;12&lt;/sub&gt;Th&lt;sub&gt;3&lt;/sub&gt;(Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;19&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;·18H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Thornasite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Thornasite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Ansell V E, Chao G Y (1987) Thornasite, a new hydrous sodium thorium silicate from Mont St-Hilaire, Quebec, The Canadian Mineralogist 25, 181-183</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.GF.50</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Other rare zeolite</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Thornasite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1985-050</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/becquerelite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Becquerelite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | U | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic, hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/becquerelite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-597</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:597:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-597.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Becquerelite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Becquerelite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Schoep A (1922) Sur la becquerélite, nouveau minéral radioactif, Comptes Rendus Hebdomadaires des Séances de l’Académie des Sciences 174, 1240-1242 Chemical formula redefined: Frondel J W, Cuttutta F (1953) Studies of uranium minerals (XII): The status of billietite and becquerelite, American Mineralogist 30, 1019-1024 Chemical formula redefined again: Piret-Meunier J, Piret P (1982) Nouvelle détermination de la structure cristalline de la bequerelite, Bulletin de Minéralogie 105, 606-610</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.GB.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl hydroxide, With additional cations (K, Ca, Ba, Pb, etc.); with mainly UO2(O,OH)5 pentagonal polyhedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Becquerelite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1922</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/glaukosphaerite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Glaukosphaerite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Ni | C | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/glaukosphaerite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CuNi(CO&lt;sub&gt;3&lt;/sub&gt;)(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1972-028</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Copper nickel carbonate dihydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-1711</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1711:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1711.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;Ni&lt;sup&gt;2+&lt;/sup&gt;CO&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Glaukosphaerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Glaukosphaerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pryce M W, Just J (1974) Glaukosphaerite: A new nickel analogue of rosasite, Mineralogical Magazine 39, 737-743 Chemical formula changed from (Cu,Ni)2CO3(OH)2 because the Cu and Ni are found to order into distinct crystallographic sites: Perchiazzi N, Merlino S (2006) The malachite-rosasite group: crystal structures of glaukosphaerite and pokrovskite, European Journal of Mineralogy 18, 787-792</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Malachite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>05.BA.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions, without H2O, With Cu, Co, Ni, Zn, Mg, Mn</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Glaukosphaerite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1972-028</gsmin:wikipediadate>
  </rdf:Description>
