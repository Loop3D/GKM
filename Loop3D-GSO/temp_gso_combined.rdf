    <gsmin:statusnotes xml:lang="en">Oberti, R., Boiocchi, M., Hawthorne, F.C., Ball, N.A. and Martin, R.F. (2016) Ferrifluoro-katophorite, IMA 2015-096. CNMNC Newsletter No. 29, February 2016, page 203; Mineralogical Magazine, 80, 199–205</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Amphibole-amphiboles sodic-calcic</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/gageite">
