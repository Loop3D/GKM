    <gsmin:mindatid>min-2803</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2803:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2803.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;1+&lt;/sup&gt;Ni&lt;sup&gt;2+&lt;/sup&gt;Bi&lt;sup&gt;3+&lt;/sup&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mückeite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Muckeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Schnorrer-Köhler G, Neumann U, Doering Th (1989) Mückeite, CuNiS3, a new mineral from the Grüne Au mine, Schutzbach/Siegerland, Neues Jahrbuch für Mineralogie, Monatshefte 1989, 193-200 Jambor J L, Vanko D A (1990) New mineral names, American Mineralogist 75, 706-713</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.GA.25</gsmin:strunzcodeV10>
