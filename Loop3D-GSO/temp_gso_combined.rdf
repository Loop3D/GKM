    <gsmin:statusnotes xml:lang="en">Garavelli C L (1957) Bonattite: Un nuovo minerale di alterazione del giacimento elbano di Capo Calamita, Atti della Accademia Nazionale dei Lincei. Rendiconti della Classe di Scienze Fisiche, Matematiche e Naturali 22, 318-327</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.CB.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, with H2O, With only medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Bonattite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1957</gsmin:wikipediadate>
  </rdf:Description>
