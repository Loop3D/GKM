    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;3+&lt;/sup&gt;AlOSiO&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kanonaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kanonaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Vrána S, Rieder M, Podlaha J (1978) Kanonaite, (Mn^3+^_0.76_Al_0.23_Fe^3+^_0.02_)^[6]^Al^[5]^[O|SiO_4_], a new mineral isotypic with andalusite, Contributions to Mineralogy and Petrology 66, 325-332</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Andalusite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AF.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with additional anions; cations in [4], [5] and/or only [6] coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Kanonaite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1976-047</gsmin:wikipediadate>
  </rdf:Description>
