    <gsmin:statusnotes xml:lang="en">Sokolova E, Cámara F, Abdu Y A, Hawthorne F C, Horváth, Pfenninger-Horváth E (2015) Bobshannonite, Na_2_KBa(Mn,Na)_8_(Nb,Ti)_4_(Si_2_O_7_)_4_O_4_(OH)_4_(O,F)_2_, a new TS-block mineral from Mont Saint-Hilaire, Québec, Canada: Description and crystal structure. Mineralogical Magazine 79, 1791-1811</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Seidozerite-Bafertisite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/euclase">
