  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/manganonaujakasite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Manganonaujakasite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Mn | Al | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;6&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;Al&lt;sub&gt;4&lt;/sub&gt;Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;26&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1999-031</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-7097</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7097:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7097.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;6&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;Al&lt;sub&gt;4&lt;/sub&gt;Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;26&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Manganonaujakasite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Manganonaujakasite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Khomyakov A P, Nechelystov G N, Ferraris G, Ivaldi G (2000) Manganonaujakasite, Na6(Mn, Fe)Al4Si8O26, a new mineral from the Lovozero alkaline massif, Kola Peninsula, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 129, issue 4, 48-53 Jambor J L, Roberts A C (2001) New mineral names, American Mineralogist 86, 1112-1115</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.EG.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate: Double nets with 6-membered and larger rings</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Manganonaujakasite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1999-031</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicquality/Metamorphic_Grade">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A term to indicate the intensity or rank of metamorphism applied to an EarthMaterial (eg: high metamorphic grade, low metamorphic grade). Indicates in a general way the P-T environment in which the metamorphism took place. Determination of metamorphic grade is based on mineral assemblages (ie, facies) present in a rock that are interpreted to have crystallized in equilibrium during a particular metamorphic event.</rdfs:comment>
    <rdfs:comment xml:lang="en">applies to Earth_Material or Geologic_Unit</rdfs:comment>
    <rdfs:isDefinedBy xml:lang="en">GeoSciML v4</rdfs:isDefinedBy>
    <rdfs:label xml:lang="en">Metamorphic grade</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Physical_Quality"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/uranospathite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Uranospathite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Al | U | O | F | P | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">autunite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/uranospathite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Al,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;F(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·20H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4111</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4111:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4111.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Al,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;F(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·20(H&lt;sub&gt;2&lt;/sub&gt;O,F)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Uranospathite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Uranospathite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hallimond A F (1915) On bassetite and uranospathite, new species hitherto classed as autunite, Mineralogical Magazine 17, 221-236 Chemical formula revised: Locock A J, Kinman W S, Burns P C (2005) The structure and composition of uranospathite, Al_1-x_[box]_x_[(UO_2_)(PO_4_)]_2_(H_2_O)_20+3x_F_1-3x_, 0&lt;x&lt;0.33, a non-centrosymmetric fluorine-bearing mineral of the autunite group, and of a related synthetic lower hydrate, Al_0.67_[box]_0.33_[(UO_2_)(PO_4_)]_2_(H_2_O)_15.5_, The Canadian Mineralogist 43, 989-1003</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.EB.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl phosphate or arsenate, UO2:RO4 = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Uranospathite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1915</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/bytownite">
