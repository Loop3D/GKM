    <gsmin:mindaturl>http://www.mindat.org/min-1759.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;6&lt;/sub&gt;Hg&lt;sub&gt;3&lt;/sub&gt;Sb&lt;sub&gt;4&lt;/sub&gt;S&lt;sub&gt;12&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Gruzdevite</gsmin:rruffnamehtml>
