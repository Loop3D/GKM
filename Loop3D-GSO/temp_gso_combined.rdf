    <gsmin:imanumber xml:lang="en">IMA1994-050</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-6957</gsmin:mindatid>
