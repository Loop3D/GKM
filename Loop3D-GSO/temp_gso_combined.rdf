    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaNb&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Isolueshite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Isolueshite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chakhmouradian A, Yakovenchuk V, Mitchell R H, Bogdanova A (1997) Isolueshite: a new mineral of the perovskite group from the Khibina alkaline complex, European Journal of Mineralogy 9, 483-490</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Perovskite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.CC.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 2: 3,3: 5, and similar, With large and medium-sized cations</gsmin:strunzlabel>
