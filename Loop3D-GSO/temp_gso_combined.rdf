    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;Sr&lt;sub&gt;14&lt;/sub&gt;Na&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;12&lt;/sub&gt;F&lt;sub&gt;64&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1995-046</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-7121</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7121:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7121.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;Sr&lt;sub&gt;14&lt;/sub&gt;Na&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;12&lt;/sub&gt;F&lt;sub&gt;64&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R100009</gsmin:rruffids>
