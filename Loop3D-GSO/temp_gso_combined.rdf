  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/tangdanite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Tangdanite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Cu | As | O | S | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Cu&lt;sub&gt;9&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;0.5&lt;/sub&gt;(OH)&lt;sub&gt;9&lt;/sub&gt;·9H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2011-096</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;9&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;0.5&lt;/sub&gt;(OH)&lt;sub&gt;9&lt;/sub&gt;·9H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tangdanite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tangdanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">de Fourestier J, Li G, Poirier G, Chukanov N V, Ma Z (2012) Fuxiaotuite, IMA 2011-096. CNMNC Newsletter No. 13, June 2012, page 808; Mineralogical Magazine, 76, 807-817 Originally proposed with its name given as fuxiaotuite. The mineral remains pending, but the name has been withdrawn: Williams P A, Hatert F, Pasero M, Mills S J (2013) IMA Commission on new minerals, nomenclature and classification (CNMNC) Newsletter 16. New minerals and nomenclature modifications approved in 2013. Mineralogical Magazine 77, 2695-2709 New name approved: Ma Z, Li G, Chukanov N V, Poirier G, Shi N (2014) Tangdanite, a new mineral species from the Yunnan Province, China and the discreditation of 'clinotyrolite'. Mineralogical Magazine 78, 559-569</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Tyrolite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/timeOlderThan">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Age associated with subject is entirely prior to age associated with object</rdfs:comment>
    <rdfs:comment xml:lang="en">Event A is older than event B if A has occurred prior to B. (Burns, 1975; Mathematical Geology, Vol. 7, No. 4) Equivalent to Allen A Before B.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/isTemporallyRelatedTo"/>
    <owl:inverseOf rdf:resource="https://w3id.org/gso/1.0/common/timeYoungerThan"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/florencite-nd">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
