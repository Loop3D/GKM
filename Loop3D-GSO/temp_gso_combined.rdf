  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Pegmatite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al. 2005</dct:source>
    <rdfs:comment xml:lang="en">Exceptionally coarse grained crystalline rock with interlocking crystals; most grains are 1cm or more diameter; composition is generally that of granite, but the term may refer to the coarse grained facies of any type of igneous rock;usually found as irregular dikes, lenses, or veins associated with plutons or batholiths.</rdfs:comment>
    <rdfs:label xml:lang="en">pegmatite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Phaneritic_Igneous_Rock"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Rock_Gypsum_Or_Anhydrite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">This vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Evaporite composed of at least 50 percent gypsum or anhydrite.</rdfs:comment>
    <rdfs:label xml:lang="en">gypsum or anhydrite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Evaporite"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/anthonyite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Anthonyite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | O | H</gsmin:chemistryelements>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/anthonyite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu(OH)&lt;sub&gt;2&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: CopperII hydroxide trihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-253</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:253:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-253.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Anthonyite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Anthonyite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Williams S A (1963) Anthonyite and calumetite, two new minerals from the Michigan copper district, American Mineralogist 48, 614-619</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Anthonyite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>03.DA.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Double-, Oxy- or Hydroxy- halide with Cu, etc., without Pb</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Anthonyite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1963</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/alluaudite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Alluaudite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Mn | Mg | Fe | P | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">alluaudite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/alluaudite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,Ca)(Mn,Mg,Fe&lt;sup&gt;2+&lt;/sup&gt;)(Fe&lt;sup&gt;3+&lt;/sup&gt;,Mn&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:mindatid>min-142</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:142:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-142.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,Ca)(Mn&lt;sup&gt;2+&lt;/sup&gt;,Mg,Fe&lt;sup&gt;2+&lt;/sup&gt;)(Fe&lt;sup&gt;3+&lt;/sup&gt;,Mn&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R160080 | R160081 | R140711 | R141067</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Alluaudite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Alluaudite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Damour A A (1848) Sur un nouveau phosphate de fer, de manganèse et de soude, l'alluaudite, trouvé dans le département de la Haute-Vienne, Annales des Mines 13, 341-350 Redefined: Moore P B, Ito J (1979) Alluaudites, wyllieites, arrojadites: crystal chemistry and nomenclature, Mineralogical Magazine 43, 227-235</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Alluaudite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.AC.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, without H2O, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Alluaudite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1848</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Non_Clastic_Siliceous_Sedimentary_Material">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">SLTTs 2004</dct:source>
    <rdfs:comment xml:lang="en">Sedimentary material that consists of at least 50 percent silicate mineral material, deposited directly by chemical or biological processes at the depositional surface, or in particles formed by chemical or biological processes within the basin of deposition.</rdfs:comment>
    <rdfs:label xml:lang="en">non clastic siliceous sedimentary material</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Sedimentary_Material"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/aravaipaite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Aravaipaite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Al | F | H | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic, monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/aravaipaite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;3&lt;/sub&gt;AlF&lt;sub&gt;9&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1988-021</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Trilead aluminium nonafluoride monohydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-311</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:311:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-311.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;3&lt;/sub&gt;AlF&lt;sub&gt;9&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R100004 | R100032</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Aravaipaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Aravaipaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf A R, Dunn P J, Foord E E (1989) Grandreefite, pseudograndreefite, laurelite, and aravaipaite: Four new minerals from the Grand Reef mine, Graham County, Arizona, American Mineralogist 74, 927-933</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Aravaipaite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>03.DC.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Double-, Oxy- or Hydroxy-  halide with Pb (As,Sb,Bi), without Cu</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Aravaipaite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1988-021</gsmin:wikipediadate>
  </rdf:Description>
