    <gsmin:rruffnameplain xml:lang="en">Fukalite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Henmi C, Kusachi I, Kawahara A, Henmi K (1977) Fukalite, a new calcium carbonate silicate hydrate mineral, Mineralogical Journal 8, 374-381</gsmin:statusnotes>
