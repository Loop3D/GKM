    <gsmin:rruffnameplain xml:lang="en">Donharrisite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Paar W H, Chen T T, Roberts A C, Criddle A J, Stanley C J (1989) Donharrisite, nickel-mercury sulfide, a new mineral species from Leogang, Salzburg Province, Austria, The Canadian Mineralogist 27, 257-262</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.BD.20</gsmin:strunzcodeV10>
