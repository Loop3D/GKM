  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/paravinogradovite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Paravinogradovite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ti | Fe | Si | O | Al | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)&lt;sub&gt;2&lt;/sub&gt;(Ti&lt;sup&gt;4+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;4&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;3&lt;/sub&gt;AlO&lt;sub&gt;10&lt;/sub&gt;)(OH)&lt;sub&gt;4&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2002-033</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-25599</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:25599:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-25599.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)&lt;sub&gt;2&lt;/sub&gt;(Ti&lt;sup&gt;4+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;4&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;3&lt;/sub&gt;AlO&lt;sub&gt;10&lt;/sub&gt;)(OH)&lt;sub&gt;4&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060834</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Paravinogradovite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Paravinogradovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Khomyakov A P, Kulikova I E, Sokolova E, Hawthorne F C, Kartashov P M (2003) Paravinogradovite, (Na,box])_2_[(Ti^4+^,Fe^3+^)_4_{Si_2_O_6_}_2_{Si_3_AlO_10_}(OH)_4_]H_2_O, a new mineral species from the Khibina Alkaline Massif, Kola Peninsula, Russia: description and crystal structure, The Canadian Mineralogist 41, 989-1002</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.DB.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 2-periodic single chains, Si2O6; Pyroxene-related minerals</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Paravinogradovite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2002-033</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Silicate_Mudstone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">This vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Mudstone that contains less than 10 percent carbonate minerals.</rdfs:comment>
    <rdfs:comment xml:lang="en">Operational distinction of this category will typically be based on whether or not the rock fizzes when hydrochloric acid is applied--the rock is silicate mudstone if it does not fizz. The quantitative '10 percent' criteria is fuzzy.</rdfs:comment>
    <rdfs:label xml:lang="en">silicate mudstone</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Generic_Mudstone"/>
  </rdf:Description>
