    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Mg,Al,Zn&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;3&lt;/sub&gt;(Al,Sn&lt;sup&gt;4+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;,Fe&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;15&lt;/sub&gt;(OH)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Magnesionigerite-6N6S</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Magnesionigerite-6N6S</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chen J, Shi Y, Pan Z, Peng Z (1989) The crystal structure and crystal chemistry of a new mineral, pengzhizhongite-6H. Earth Science Journal of China University of Geosciences 14, 413-422 Chemical formula revised and name changed: Armbruster T (2002) Revised nomenclature of högbomite, nigerite, and taafeite minerals, European Journal of Mineralogy 14, 389-395</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Nigerite-Magnesionigerite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.FC.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Hydroxide (without V or U), Hydroxides with OH, without H2O; corner-sharing octahedra</gsmin:strunzlabel>
