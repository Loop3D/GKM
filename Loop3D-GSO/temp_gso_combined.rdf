    <gsmin:rruffnameplain xml:lang="en">Whiteite-(MnMnMg)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Elliott P, Willis A C (2019) Whiteite-(MnMnMg), a new jahnsite-group mineral from Iron Monarch, South Australia: Description and crystal structure. The Canadian Mineralogist 57, 215-223</gsmin:statusnotes>
