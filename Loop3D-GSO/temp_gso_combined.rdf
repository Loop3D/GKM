  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseMeghalayanSP2018">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologiccontact/GSSP"/>
    <dct:source xml:lang="en">International Commission on Stratigraphy - Formal subdivision of the Holocene Series/Epoch</dct:source>
    <rdfs:comment xml:lang="en">Mawmluh Cave speleothem, Meghalaya, India. The Meghalayan GSSP is located in the northeastern Indian State of Meghalaya. The entrance of Mawmluh Cave is at the southern edge of the Meghalayan Plateau at a latitude of 25.262 N and a longitude of 91.715 W. The nearest town is Sohra (Cherrapunji).</rdfs:comment>
    <rdfs:label xml:lang="en">GSSP Base of Meghalayan</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://www.episodes.org/journal/view.html?doi=10.18814/epiiugs/2018/018016"/>
    <rdfs:seeAlso rdf:resource="https://timescalefoundation.org/gssp/detail.php?periodid=183&amp;top_parentid=0"/>
    <owl:versionInfo>2018-06-14</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/paracelsian">
