  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/calcybeborosilite-y">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Calcybeborosilite-(Y)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Y | REE | Ca | B | Be | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Y,REE,Ca)&lt;sub&gt;2&lt;/sub&gt;(B,Be)&lt;sub&gt;2&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH,O)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Questionable mineral species|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-6843</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:6843:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-6843.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Y&lt;sup&gt;3+&lt;/sup&gt;,REE,Ca)&lt;sub&gt;2&lt;/sub&gt;(B,Be)&lt;sub&gt;2&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH,O)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Calcybeborosilite-(Y)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Calcybeborosilite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pekov I V, Voloshin A V, Pushcharovskii D Y, Rastsvetaeva R K, Chukanov N V, Belakovskii D I (2000) New data on calcybeborosilite-(Y) (REE,Ca)&lt;sub&gt;2&lt;/sub&gt;(B,Be)&lt;sub&gt;2&lt;/sub&gt;[SiO&lt;sub&gt;4&lt;/sub&gt;]&lt;sub&gt;2&lt;/sub&gt;(OH,O)&lt;sub&gt;2&lt;/sub&gt;, Moscow University Geology Bulletin 55, 62-70</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Gadolinite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>0</gsmin:strunzcodeV10>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Calcybeborosilite-%28Y%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>0</gsmin:wikipediadate>
  </rdf:Description>
