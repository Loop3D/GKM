  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/granularmaterial/Oolitic_Particle_Material">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Jackson1997, Hallsworth and Knox 1999</dct:source>
    <rdfs:comment xml:lang="en">Granular material consisting of particles that resembles an oolith in outer appearance and size- (Jackson, 1997, p. 447). Hallsworth and Knox (1999, p. 27) describe ooids as coated grains that typically are spherical or ellipsoidal in shape, with the degree of roundness increasing outward. Concentric to semi-concentric coats are smoothly and evenly laminated. A nucleus usually is present, and may have a composition different from the coatings. Biogenic structures are not obvious. NADMSC SLTTs (2004) considers synomous with oolith.</rdfs:comment>
    <rdfs:label xml:lang="en">oolitic particle material</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/granularmaterial/Coated_Particle_Material"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/Measure_Value">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A determinate value of a quality. SubClasses for numeric, spatial coordinate, and temporal coordinate value types. Use this generic value type for free text values e.g. "some text". Categorical values should be subclassed from gsoc:Named_Value</rdfs:comment>
    <rdfs:label xml:lang="en">Measure Value</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Quality_Value"/>
