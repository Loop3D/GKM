    <gsmin:statusnotes xml:lang="en">Kampf A R, Dunn P J, Foord E E (1992) Parafransoletite, a new dimorph of fransoletite from the Tip Top Pegmatite, Custer, South Dakota, American Mineralogist 77, 843-847</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.CA.05</gsmin:strunzcodeV10>
