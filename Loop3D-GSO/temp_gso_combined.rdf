    <gsmin:rruffnameplain xml:lang="en">Braccoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Cámara F, Bittarello E, Ciriotti M E, Nestola F, Radica F, Marchesini M (2015) As-bearing new mineral species from Valletta mine, Maira Valley, Piedmont, Italy: II. Braccoite, NaMn^2+^_5_[Si_5_AsO_17_(OH)](OH), description and crystal structure. Mineralogical Magazine 79, 171-189</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Saneroite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/biraite-ce">
