  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/balliranoite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Balliranoite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | K | Ca | Si | Al | O | Cl | C</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/balliranoite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,K)&lt;sub&gt;6&lt;/sub&gt;Ca&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;6&lt;/sub&gt;Al&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;)Cl&lt;sub&gt;2&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2008-065</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-39332</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:39332:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-39332.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,K)&lt;sub&gt;6&lt;/sub&gt;Ca&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;6&lt;/sub&gt;Al&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;)Cl&lt;sub&gt;2&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Balliranoite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Balliranoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chukanov N V, Zubkova N V, Pekov I V, Olysych L V, Bonaccorsi E, Pushcharovsky D Y (2010) Balliranoite, (Na,K)&lt;sub&gt;6&lt;/sub&gt;Ca&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;6&lt;/sub&gt;Al&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;)Cl&lt;sub&gt;2&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;), a new cancrinite-group mineral from Monte Somma - Vesuvio volcanic complex, Italy, European Journal of Mineralogy 22, 113-119</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Cancrinite-sodalite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.FB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Tektosilicate with additional anions</gsmin:strunzlabel>
    <gsmin:wikipediadate>2008-065</gsmin:wikipediadate>
