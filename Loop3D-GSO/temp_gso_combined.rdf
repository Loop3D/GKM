    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Cu&lt;sup&gt;1+&lt;/sup&gt;&lt;sub&gt;0.5&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;0.5&lt;/sub&gt;)Rh&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1984-017</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Copper dirhenium tetrasulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-1188</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1188:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1188.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Cu&lt;sup&gt;1+&lt;/sup&gt;&lt;sub&gt;0.5&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;0.5&lt;/sub&gt;)Rh&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cuprorhodsite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cuprorhodsite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Rudashevsky N S, Men'shikov Y P, Mochalov A G, Trubkin N V, Shumskaya N I, and Zhdanov V V (1985) Cuprorhodsite CuRh&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;4&lt;/sub&gt; and cuproiridsite CuIr&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;4&lt;/sub&gt; - new natural thiospinels of platinum-group elements, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 114(2), 187-195</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Spinel</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.DA.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide (M:S = 3:4)</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Cuprorhodsite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1984-017</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/alum-k">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Alum-(K)</rdfs:label>
