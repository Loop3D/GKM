  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/mordenite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Mordenite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | K | Al | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">zeolite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/mordenite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na&lt;sub&gt;2&lt;/sub&gt;,Ca,K&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(Al&lt;sub&gt;8&lt;/sub&gt;Si&lt;sub&gt;40&lt;/sub&gt;)O&lt;sub&gt;96&lt;/sub&gt;·28H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2779</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2779:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2779.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na&lt;sub&gt;2&lt;/sub&gt;,Ca,K&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(Al&lt;sub&gt;8&lt;/sub&gt;Si&lt;sub&gt;40&lt;/sub&gt;)O&lt;sub&gt;96&lt;/sub&gt;·28H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R061118 | R070524</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mordenite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Mordenite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">How H (1864) On mordenite, a new mineral from the trap of Nova Scotia, Journal of the Chemical Society 17, 100-104</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.GD.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Zeolite family: Chains of 6-membered rings – tabular zeolites</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Mordenite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1864</gsmin:wikipediadate>
  </rdf:Description>
