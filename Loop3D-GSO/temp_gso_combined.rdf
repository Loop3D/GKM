  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Delta_Front_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al., 2005</dct:source>
    <rdfs:comment xml:lang="en">A narrow zone where deposition in deltas is most active, consisting of a continuous sheet of sand, and occurring within the effective depth of wave erosion (10 m or less). It is the zone separating the prodelta from the delta plain, and it may or may not be steep\</rdfs:comment>
    <rdfs:label xml:lang="en">delta front setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Delta_System_Setting"/>
