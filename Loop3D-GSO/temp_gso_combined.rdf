  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/evansite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Evansite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Al | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">amorphous</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/evansite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)(OH)&lt;sub&gt;6&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1426</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1426:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1426.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al&lt;sub&gt;3&lt;/sub&gt;PO&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R061030</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Evansite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Evansite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Forbes D (1864) On evansite, a new mineral species, The London, Edinburgh, and Dublin Philosophical Magazine and Journal of Science 28, 341-346 Chemical formula revised: García-Guinea J, Chagoyen A M, Nickel E H (1995) A re-investigation of bolivarite and evansite. The Canadian Mineralogist 33, 59-65</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Amorphous</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DF.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With only medium-sized cations, (OH,etc.):RO4 &gt; 3:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Evansite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>0</gsmin:wikipediadate>
