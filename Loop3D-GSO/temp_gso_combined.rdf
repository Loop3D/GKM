  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/montgomeryite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Montgomeryite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Mg | Al | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">calcioferrite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/montgomeryite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;4&lt;/sub&gt;MgAl&lt;sub&gt;4&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·12H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Tetracalcium magnesium tetraaluminium hexaphosphate tetrahydroxyl dodecahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2767</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2767:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2767.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;4&lt;/sub&gt;MgAl&lt;sub&gt;4&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·12H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070631 | R080094 | R140625</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Montgomeryite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Montgomeryite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Larsen E S (1940) Overite and montgomeryite: two new mineral from Fairfield, Utah, American Mineralogist 25, 315-326 Chemical formula revised from Ca_4_Al_5_(PO_4_)_6_(OH)_5_·11H_2_O to Ca_4_Al_4_(PO_4_)_3_(OH)·7H_2_O: Mead C W, Mrose M E (1968) Solving problems in phosphate mineralogy with the electron probe. U.S. Geological Survey Professional Paper 600-D, D204-D206</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Calcioferrite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DH.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 &lt; 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Montgomeryite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1940</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Ductile_Flattening">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Also known as pure shear; a three-dimensional homogeneous flattening of a body (http://www.geology.sdsu.edu/visualstructure/vss/htm_hlp/pure_s.htm) accomodated by ductile deformation. It is an example of irrotational strain in which body is elongated in one direction while being shortened perpendicularly (https://en.wikipedia.org/wiki/Pure_shear).</rdfs:comment>
    <rdfs:label xml:lang="en">Ductile Flattening</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicprocess/Ductile_Flow"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/arhbarite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Arhbarite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Mg | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/arhbarite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;2&lt;/sub&gt;Mg(AsO&lt;sub&gt;4&lt;/sub&gt;)(OH)&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1981-044</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dicopper magnesium arsenate trihydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-333</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:333:1"/>
