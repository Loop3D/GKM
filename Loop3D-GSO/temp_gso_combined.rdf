  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/uroxite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Uroxite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>U | O | C | H</gsmin:chemistryelements>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">[(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(C&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;)(OH)&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;2&lt;/sub&gt;]·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2018-100</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Pending publication</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">[(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(C&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;)(OH)&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;2&lt;/sub&gt;]·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Uroxite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Uroxite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf, A.R., Plášil, J., Nash, B.P., Ne?mec, I. and Marty, J. (2018) Uroxite, IMA2018-100. CNMNC Newsletter No. 46, December 2018, page 1376; Mineralogical Magazine, 82, 1369–1379</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/leucostaurite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Leucostaurite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | B | O | Cl | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;2&lt;/sub&gt;[B&lt;sub&gt;5&lt;/sub&gt;O&lt;sub&gt;9&lt;/sub&gt;]Cl·0.5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2007-047</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-35579</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:35579:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-35579.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;B&lt;sub&gt;5&lt;/sub&gt;O&lt;sub&gt;9&lt;/sub&gt;Cl·0.5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Leucostaurite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Leucostaurite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Brugger J, Meisser N, Ansermat S, Krivovichev S V, Kahlenberg V, Belton D, Ryan C G (2012) Leucostaurite, Pb_2_[B_5_O_9_]Cl·0.5H_2_O, from the Atacama Desert: The first Pb-dominant member of the hilgardite group, and micro-determination of boron minerals by PIGE. American Mineralogist 97, 1206-1212</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hilgardite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>06.EA.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Neso-pentaborate</gsmin:strunzlabel>
    <gsmin:wikipediadate>2007-047</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/paratimroseite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
