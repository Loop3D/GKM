  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/Reference_System">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Notional endurant that establishes a frame of reference for a quality value. Although typically mathematical,  it is not necessarily abstract, because some reference systems are dependent on non-abstract endurants located in space or time; e.g. a spatial coordinate system for the earth (tied to the Earth's ellipsoid), or a temporal coordinate system tied to the Earth's moon or sun (i.e. lunar or solar calendar)</rdfs:comment>
    <rdfs:label xml:lang="en">Reference System </rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Notional_Endurant"/>
    <rdfs:subClassOf rdf:nodeID="n7bda25761fc44f8595ef751309700190b342"/>
    <owl:equivalentClass rdf:nodeID="n7bda25761fc44f8595ef751309700190b343"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/pribramite">
