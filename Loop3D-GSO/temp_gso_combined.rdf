    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1807:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1807.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hallimondite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hallimondite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Walenta K (1965) Hallimondite, a new uranium mineral from the Michael mine near Reichenbach (Black Forest, Germany), American Mineralogist 50, 1143-1157</gsmin:statusnotes>
