    <gsmin:rruffnameplain xml:lang="en">Grantsite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Weeks A D, Lindberg M L, Truesdell A H, Meyrowitz R (1964) Grantsite, a new hydrated sodium calcium vanadate from New Mexico, Colorado, and Utah, American Mineralogist 49, 1511-1526</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hewettite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.HG.55</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">V oxide, unclassified</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Grantsite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1964</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/cymrite">
