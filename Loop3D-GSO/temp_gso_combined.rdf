    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:35973:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-35973.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sr&lt;sub&gt;5&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;F</gsmin:rruffchemistry>
