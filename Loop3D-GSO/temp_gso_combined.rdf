    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaNa&lt;sub&gt;3&lt;/sub&gt;(NaCa)Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;13&lt;/sub&gt;Al(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;11&lt;/sub&gt;(PO&lt;sub&gt;3&lt;/sub&gt;OH)(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2014-071</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaNa&lt;sub&gt;3&lt;/sub&gt;(NaCa)Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;13&lt;/sub&gt;Al(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;11&lt;/sub&gt;(PO&lt;sub&gt;3&lt;/sub&gt;OH)(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R160077</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Arrojadite-(BaNa)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Arrojadite-(BaNa)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Vignola P, Hatert F, Baijot M, Dal Bo F, Andò S, Bersani D, Pavese A, Risplendente A, Vanini F (2016) Arrojadite-(BaNa), BaNa_3_(Na,Ca)Fe^2+^_13_Al(PO_4_)_11_(PO_3_OH)(OH)_2_, a new phosphate mineral from the Luna Albite pegmatite, Dorio commune, Lecco province, Italy. The Canadian Mineralogist 54, 1021-1032</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Arrojadite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/carbonatecyanotrichite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Carbonatecyanotrichite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Al | C | O | H</gsmin:chemistryelements>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/carbonatecyanotrichite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;4&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)(OH)&lt;sub&gt;12&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Tetracopper dialuminium carbonate dodecahydroxyl dihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-894</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:894:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-894.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;CO&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;12&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060600</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Carbonatecyanotrichite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Carbonatecyanotrichite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Ankinovich E A, Gerht I I, Zaiatseva R I (1963) A new variety of cyanotrichite — carbonate-cyanotrichite, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 92, 458-463 Name changed from carbonate-cyanotrichite: Burke E A J (2008) Tidying up mineral names: an IMA-CNMNC scheme for suffixes, hyphens and diacritical marks, The Mineralogical Record 39, 131-135</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Cyanotrichite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.DE.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With only medium-sized cations; unclassified</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Carbonate-cyanotrichite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1963</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/vanmeersscheite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
