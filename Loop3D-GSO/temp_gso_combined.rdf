  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/arsenolite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Arsenolite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>As | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/arsenolite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">As&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Diarsenic trioxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-294</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:294:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-294.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">As&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050383 | R080095</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Arsenolite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Arsenolite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">The mineral was known before this publication, but under other names like arsenite, a general name for salts of arsenous acid: Dana J D (1854) II. Oxyds of elements of the arsenic group. I. Oxyds of arsenic, antimony, etc. Arsenolite, in A System of Mineralogy, Comprising the Most Recent Discoveries, Fourth Edition, Volume II, George P. Putnam &amp; Co. (New York and London) 139-140</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Arsenolite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.CB.50</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 2: 3,3: 5, and similar, With medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Arsenolite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1854</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/nechelyustovite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Nechelyustovite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ba | Ti | Nb | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;&lt;sub&gt;2&lt;/sub&gt;Ba&lt;sub&gt;4&lt;/sub&gt;Ti&lt;sub&gt;4&lt;/sub&gt;Nb&lt;sub&gt;4&lt;/sub&gt;(Na&lt;sub&gt;11&lt;/sub&gt;&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)Ti&lt;sub&gt;4&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;8&lt;/sub&gt;(OH)&lt;sub&gt;8&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;12&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2006-021</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Redefined|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-29548</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:29548:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-29548.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;&lt;sub&gt;2&lt;/sub&gt;Ba&lt;sub&gt;4&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Nb&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;(Na&lt;sub&gt;11&lt;/sub&gt;&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;8&lt;/sub&gt;(OH)&lt;sub&gt;8&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;12&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nechelyustovite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Nechelyustovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Nèmeth P, Khomyakov A P, Ferraris G, Menshikov Y P (2009) Nechelyustovite, a new heterophyllosilicate mineral, and new data on bykovaite: a comparative TEM study, European Journal of Mineralogy 21, 251-260</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Seidozerite-Lamprophyllite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.BE.55</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate: Si2O7 groups, with additional anions; cations in octahedral [6] and greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Nechelyustovite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2006-021</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/seelite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Seelite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mg | U | O | As | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/seelite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(AsO&lt;sub&gt;3&lt;/sub&gt;,AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·7H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1992-005</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3604</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3604:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3604.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(As&lt;sup&gt;3+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;,As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·7H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Seelite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Seelite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Bariand P, Bachet B, Brassy C, Medenbach O, Deliens M, Piret P (1993) Seelite - a new uranium mineral from the Talmessi mine, Iran, and Rabejac, France, The Mineralogical Record 24, 463-467</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Seelite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.JD.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Arsenite, antimonite, bismuthite; with additional anions and H2O</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Seelite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1992-005</gsmin:wikipediadate>
  </rdf:Description>
