    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Zn,Cu)&lt;sub&gt;5&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Pentazinc dicarbonate hexahydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-422</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:422:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-422.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050297 | R060426</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Aurichalcite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Aurichalcite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Boettger T (1839) Chemische untersuchung des aurichalcits, eines neuen kupfererzes vom Altai, Annalen der Physik und Chemie 48, 495-500</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.BA.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions, without H2O, With Cu, Co, Ni, Zn, Mg, Mn</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Aurichalcite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1839</gsmin:wikipediadate>
