    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 3:4 and similar, With only medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Magnesiochromite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1873</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseMaastrichtianSP2001">
