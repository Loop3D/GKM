  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/renierite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Renierite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Zn | Fe | Ge | As | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/renierite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Cu&lt;sup&gt;1+&lt;/sup&gt;,Zn)&lt;sub&gt;11&lt;/sub&gt;Fe&lt;sub&gt;4&lt;/sub&gt;(Ge&lt;sup&gt;4+&lt;/sup&gt;,As&lt;sup&gt;5+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;16&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:mindatid>min-3389</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3389:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3389.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Cu&lt;sup&gt;1+&lt;/sup&gt;,Cu&lt;sup&gt;2+&lt;/sup&gt;Zn&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;11&lt;/sub&gt;(Fe&lt;sup&gt;2+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;4&lt;/sub&gt;(Ge&lt;sup&gt;4+&lt;/sup&gt;,As&lt;sup&gt;5+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;16&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050428 | R050433</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Renierite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Renierite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Vaes J F (1948) La reniérite (anciennement applelée «Bornite orange») Un sulfure germanifère provenant de la Mine Prince-Léopold, Kipushi (Congo Belge), Annales de la Société Géologique de Belgique 72, 19-32</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Germanite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.CB.35a</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide (M = S) with Zn, Fe, Cu, Ag, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Renierite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1948</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/sursassite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Sursassite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | Al | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/sursassite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;3&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)(OH)&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3832</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3832:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3832.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;3&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)(OH)&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060336</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sursassite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Sursassite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Jakob J (1926) Sursassit, ein Mangansilikat aus dem Val d'Err (Graubünden), Schweizerische Mineralogische und Petrographische Mitteilungen 6, 376-380</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Ardennite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.BG.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate with mixed SiO4 and Si2O7 groups; cations in octahedral [6] and greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Sursassite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1926</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Metaplutonic_Rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">This vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Rock formed by metamorphism of a plutonic igneous protolith.</rdfs:comment>
    <rdfs:label xml:lang="en">metaplutonic rock</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Metamorphic_Rock"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/High_Pressure_Low_Temperature_Earth_Interior_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI Event Environment vocabulary</dct:source>
    <rdfs:comment xml:lang="en">High pressure environment characterized by geothermal gradient significantly lower than standard continental geotherm, enviornment in which blueschist facies metamorphic rocks form. Typically associated with subduction zones.</rdfs:comment>
    <rdfs:label xml:lang="en">high pressure low temperature earth interior setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Planet_Interior_Setting"/>
    <rdfs:subClassOf rdf:nodeID="nb91377c629b1476ba973ba249cd56575b42"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/wallkilldellite-fe">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Wallkilldellite-(Fe)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Cu | Fe | As | O | Si | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">kittatinnyite</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·9H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1997-032</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-7361</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7361:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7361.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Cu&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;4&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;,SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;8&lt;/sub&gt;·18H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Wallkilldellite-(Fe)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Wallkilldellite-(Fe)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Sarp H, Mari G, Chiappero P J (1999) La wallkilldellite-Fe, (Ca,Cu)_4_Fe_6_[(As,Si)O_4_]_4_(OH)_8_·18H_2_O, un nouveau mineral de la mine de Roua (Alpes-Maritimes, France), Riviéra Scientifique 12, 5-12</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.DL.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 = 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Wallkilldellite-%28Fe%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1997-032</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/winstanleyite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Winstanleyite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ti | Te | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/winstanleyite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">TiTe&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;8&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1979-001</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4297</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4297:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4297.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ti&lt;sup&gt;4+&lt;/sup&gt;Te&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;8&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Winstanleyite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Winstanleyite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Williams S A (1979) Girdite, oboyerite, fairbankite, and winstanleyite, four new tellurium minerals from Tombstone, Arizona, Mineralogical Magazine 43, 453-457</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.JK.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Tellurite without additional anions, without H2O</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Winstanleyite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1979-001</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/quetzalcoatlite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Quetzalcoatlite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Zn | Te | O | H | Ag | Pb | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/quetzalcoatlite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Zn&lt;sub&gt;6&lt;/sub&gt;Te&lt;sup&gt;6+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·(Ag,Pb,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)Cl</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1973-010</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3343</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3343:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3343.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;Te&lt;sup&gt;6+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·(Ag&lt;sup&gt;1+&lt;/sup&gt;,Pb&lt;sup&gt;2+&lt;/sup&gt;,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)Cl&lt;sup&gt;1-&lt;/sup&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Quetzalcoatlite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Quetzalcoatlite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Williams S A (1974) Quetzalcoatlite, Cu&lt;sub&gt;4&lt;/sub&gt;Zn&lt;sub&gt;8&lt;/sub&gt;(TeO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;18&lt;/sub&gt;, a new mineral from Moctezuma, Sonora, Mineralogical Magazine 39, 261-263</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.FE.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Hydroxide (without V or U), Hydroxides with OH, without H2O; sheets of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Quetzalcoatlite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1973-010</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/clinotobermorite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Clinotobermorite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic, monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/clinotobermorite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;4&lt;/sub&gt;Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;17&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;2&lt;/sub&gt;·(Ca·3H&lt;sub&gt;2&lt;/sub&gt;O)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1990-005</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:mindatid>min-1084</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1084:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1084.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;5&lt;/sub&gt;Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;17&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Clinotobermorite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Clinotobermorite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Henmi C, Kusachi I, (1992) Clinotobermorite, Ca&lt;sub&gt;5&lt;/sub&gt;Si&lt;sub&gt;6&lt;/sub&gt;(O,OH)&lt;sub&gt;18&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O, a new mineral from Fuka, Okayama Prefecture, Japan, Mineralogical Magazine 56, 353-358 Chemical formula revised: Merlino S, Bonaccorsi E, Armbruster T (1999) Tobermorites: Their real structure and order-disorder (OD) character, American Mineralogist 84, 1613-1621</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Tobermorite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DG.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 3-periodic single and multiple chains</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Clinotobermorite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1990-005</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Tephritic_Phonolite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Phonolitoid that has a plagioclase to total feldspar ratio between 0.1 and 0.5. Broadly corresponds to TAS tephriphonolite of TAS field U3.</rdfs:comment>
    <rdfs:label xml:lang="en">tephritic phonolite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Phonolitoid"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/alstonite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Alstonite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ba | Ca | C | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic, triclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/alstonite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaCa(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Barium calcium dicarbonate</gsmin:iupacchemname>
    <gsmin:mindatid>min-146</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:146:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-146.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaCa(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050483 | R090049</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Alstonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Alstonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Breithaupt A (1841) Holoëdrites syntheticus oder alstonit, Vollständiges Handbuch der Mineralogie 2, 255-256</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Alstonite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>05.AB.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate without additional anions, without H2O, Alkali-earth (and other M2+) carbonates</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Alstonite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1841</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/arsenolamprite">
