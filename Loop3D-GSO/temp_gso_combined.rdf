  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/serrabrancaite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Serrabrancaite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn(PO&lt;sub&gt;4&lt;/sub&gt;)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1998-006</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Manganese phosphate monohydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-7288</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7288:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7288.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;3+&lt;/sup&gt;P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R080077</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Serrabrancaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Serrabrancaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Witzke T, Wegner R, Doering T, Pöllmann H, Schuckmann W (2000) Serrabrancaite, MnPO4·H2O, a new mineral from the Alto Serra Branca pegmatite, Pedra Lavrada, Paraiba, Brazil, American Mineralogist 85, 847-849</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Kieserite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With only medium-sized cations, RO4:H2O = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Serrabrancaite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1998-006</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/Ediacaran2017">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologictime/Period"/>
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Specific_Geologic_Time_Unit"/>
    <rdfs:comment xml:lang="en">Enorama Creek, Flinders Ranges, South Australia |  31.3314 S 138.6334 E |  Base of the Marinoan cap Carbonate |  (1) rapid decay of Marinoan ice sheets and onset of distinct cap carbonates throughout the world, and (2) the beginning of a distinctive pattern of secular changes in carbon isotopes. |  Ratified 1990 |  Lethaia 39, p.13 30, 2006 | http://stratigraphy.science.purdue.edu/references/EdiacaranGSSP_Lethaia060.pdf</rdfs:comment>
    <rdfs:comment xml:lang="en">older bound -635 Ma</rdfs:comment>
    <rdfs:comment xml:lang="en">younger bound -541.0 +|-1.0 Ma</rdfs:comment>
    <rdfs:label xml:lang="en">Ediacaran Period</rdfs:label>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/geologictime/EdiacaranPeriod"/>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/ischart/isc2017-02"/>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/ischart/isc2020-01"/>
    <gsoc:nextTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Cambrian2017"/>
    <gsoc:nextTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Paleozoic2017"/>
    <gsoc:nextTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Phanerozoic2017"/>
    <gsoc:previousTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Cryogenian2017"/>
    <gsoc:timeFinishedBy rdf:resource="https://w3id.org/gso/1.0/ischart/BasePhanerozoic2017"/>
    <gsoc:timeFinishes rdf:resource="https://w3id.org/gso/1.0/ischart/Neoproterozoic2017"/>
    <gsoc:timeStartedBy rdf:resource="https://w3id.org/gso/1.0/ischart/BaseEdiacaran2017"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/clinojimthompsonite">
