    <gsmin:strunzcodeV10>08.BC.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With only medium-sized cations, (OH, etc.):RO4 &gt; 1:1 and &lt; 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Angelellite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1959</gsmin:wikipediadate>
