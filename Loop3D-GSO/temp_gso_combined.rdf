  <rdf:Description rdf:about="https://w3id.org/gso/1.0/granularmaterial/Glomerocryst_Particle_Material">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">definition of glomerocryst from Neuendorf et al., 2005</dct:source>
    <rdfs:comment xml:lang="en">Granular material consisting of particles that are aggregates of crystals of the same mineral</rdfs:comment>
    <rdfs:comment xml:lang="en">Typically will not play a framework role in a Rock Material.  Expect these to be conceptually like a sub class of phenocryst, but avoid that commitment for now.</rdfs:comment>
    <rdfs:label xml:lang="en">glomerocryst particle material</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/granularmaterial/Aggregate_NonClastic_Particle_Material"/>
  </rdf:Description>
