    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:29262:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-29262.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;0.5&lt;/sub&gt;(V&lt;sup&gt;4+&lt;/sup&gt;O)&lt;sub&gt;0.5&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;(P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;F&lt;sub&gt;2&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cloncurryite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cloncurryite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Colchester D M, Leverett P, McKinnon A R, Sharpe J L, Williams P A (2007) Cloncurryite, Cu&lt;sub&gt;0.56&lt;/sub&gt;(VO)&lt;sub&gt;0.44&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(F,OH)&lt;sub&gt;2&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O, a new mineral from the Great Australia mine, Cloncurry, Queensland, Australia, and its relationship to nevadaite, Australian Journal of Mineralogy 13, 5-14</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.DC.60</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With only medium-sized cations, (OH, etc.):RO4 = 1:1 and &lt; 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://webmineral.com/data/Cloncurryite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2005-060</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/tondiite">
