    <gsmin:imanumber xml:lang="en">IMA1991-024</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: HexaantimonyIII octaoxy sulfate hydrate</gsmin:iupacchemname>
