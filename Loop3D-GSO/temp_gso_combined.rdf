  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/mannardite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Mannardite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ba | Ti | V | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">coronadite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/mannardite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba(Ti&lt;sub&gt;6&lt;/sub&gt;V&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;)O&lt;sub&gt;16&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1983-013</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2567</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2567:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2567.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba(Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;V&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;)O&lt;sub&gt;16&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060966 | R080136</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mannardite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Mannardite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Scott J D, Peatfield G R (1986) Mannardite [Ba·H_2_O](Ti_6_V^3+^_2_)O_16_, a new mineral species, and new data on redledgeite, The Canadian Mineralogist 24, 55-66 Chemical formula changed from Ba_x_Ti_8-2x_V^3+^_2x_O_16_·2-xH_2_O: Biagioni C, Capalbo C, Pasero M (2013) Nomenclature tunings in the hollandite supergroup. European Journal of Mineralogy 25, 85-90</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Coronadite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.DK.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With large (+- medium-sized) cations; tunnel structures</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Mannardite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1983-013</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/mathiasite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Mathiasite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Ba | Sr | Zr | Fe | Mg | Ti | Cr | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">crichtonite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/mathiasite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(K,Ba,Sr)(Zr,Fe)(Mg,Fe)&lt;sub&gt;2&lt;/sub&gt;(Ti,Cr,Fe)&lt;sub&gt;18&lt;/sub&gt;O&lt;sub&gt;38&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1982-087</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2591</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2591:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2591.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(K,Ba,Sr)(Zr&lt;sup&gt;4+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;)(Mg,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;(Ti&lt;sup&gt;4+&lt;/sup&gt;,Cr&lt;sup&gt;3+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;18&lt;/sub&gt;O&lt;sub&gt;38&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mathiasite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Mathiasite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Haggerty S E, Smyth J R, Erlank A J, Rickard R S, Danchin R V (1983) Lindsleyite (Ba) and mathiasite (K): two new chromium-titanites in the crichtonite series from the upper mantle, American Mineralogist 68, 494-505</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Crichtonite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.CC.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 2: 3,3: 5, and similar, With large and medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Mathiasite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1982-087</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/magnesiotaaffeite-6n3s">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
