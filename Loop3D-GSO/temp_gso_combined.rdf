    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Mg | As | O | H</gsmin:chemistryelements>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;4&lt;/sub&gt;Ca&lt;sub&gt;3&lt;/sub&gt;Mg&lt;sub&gt;2&lt;/sub&gt;[AsO&lt;sub&gt;3&lt;/sub&gt;(OH)]&lt;sub&gt;2&lt;/sub&gt;[AsO&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;]&lt;sub&gt;10&lt;/sub&gt;·7H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
