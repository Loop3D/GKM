    <gsmin:rruffnameplain xml:lang="en">Latrappite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Nickel E H (1964) Latrappite – a proposed new name for the perovskite–type calcium niobate mineral from the Oka Area of Quebec, The Canadian Mineralogist 8, 121-122</gsmin:statusnotes>
