    <gsmin:statusnotes xml:lang="en">Grice J D, Gasparrini E (1981) Spertiniite, Cu(OH)_2_, a new mineral from the Jeffrey mine, Quebec, The Canadian Mineralogist 19, 337-340</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.FD.05</gsmin:strunzcodeV10>
