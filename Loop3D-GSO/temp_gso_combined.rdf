  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/nitrobarite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Nitrobarite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ba | N | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/nitrobarite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba(NO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Barium dinitrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2918</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2918:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2918.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba(NO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060622</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nitrobarite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Nitrobarite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">First reported as a natural barium nitrate: Groth P (1882) Natürlicher barytsalpeter, Zeitschrift für Krystallographie und Mineralogie 6, 195-195 The mineral is named: Lewis H C (1882) General notes. Mineralogy. Nitrobarite, The American Naturalist 16, 78-78</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.NA.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nitrate, Without OH or H2O</gsmin:strunzlabel>
