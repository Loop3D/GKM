    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Li&lt;sub&gt;2&lt;/sub&gt;CaAl&lt;sub&gt;4&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060666</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bertossaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Bertossaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">von Knorring O, Mrose M E (1966) Bertossaite, (Li,Na)&lt;sub&gt;2&lt;/sub&gt;(Ca,Fe,Mn)Al&lt;sub&gt;4&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH,F)&lt;sub&gt;4&lt;/sub&gt;, a new mineral from Rwanda (Africa), The Canadian Mineralogist 8, 668-668</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Carminite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BH.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH,etc.):RO4 = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Bertossaite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1965-038</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/yaroshevskite">
