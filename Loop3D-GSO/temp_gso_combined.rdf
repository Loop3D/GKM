    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1998-007</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dicalcium tetramanganeseII diironIII hexaphosphate dihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-6821</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:6821:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-6821.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bederite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Bederite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Galliski M A, Cooper M A, Hawthorne F C, Cerný P (1999) Bederite, a new pegmatite mineral from Nevados de Palermo, Argentina: description and crystal structure, American Mineralogist 84, 1674-1679</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Wicksite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CF.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With large and medium-sized cations, RO4:H2O &gt; 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Bederite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1998-007</gsmin:wikipediadate>
  </rdf:Description>
