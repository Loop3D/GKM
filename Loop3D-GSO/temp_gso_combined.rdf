    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaTi&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;8&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;19&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1997-038</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-10174</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:10174:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-10174.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaTi&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;8&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;19&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Batiferrite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Batiferrite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Lengauer C L, Tillmanns E, Hentschel G (2001) Batiferrite, Ba[Ti&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sub&gt;10&lt;/sub&gt;]O&lt;sub&gt;19&lt;/sub&gt;, a new ferrimagnetic magnetoplumbite-type mineral from the Quaternary volcanic rocks of the western Eifel area, Germany, Mineralogy and Petrology 71, 1-19</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Plumboferrite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.CC.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 2: 3,3: 5, and similar, With large and medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Batiferrite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2001</gsmin:wikipediadate>
  </rdf:Description>
