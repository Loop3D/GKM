    <gsmin:rruffnameplain xml:lang="en">Manganhumite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Moore P B (1978) Manganhumite, a new species, Mineralogical Magazine 42, 133-136 Fleischer M, Chao G Y, Pabst A (1979) New mineral names, American Mineralogist 64, 241-245</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Humite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AF.50</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with additional anions; cations in [4], [5] and/or only [6] coordination</gsmin:strunzlabel>
