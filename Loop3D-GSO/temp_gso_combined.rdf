    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3662:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3662.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al&lt;sub&gt;2&lt;/sub&gt;OSiO&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050601 | R060080 | R060787 | R100126 | R100127</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sillimanite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Sillimanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Bowen G T (1824) Description and analysis of sillimanite, a new mineral, American Journal of Science and Arts 8, 113-118</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.AF.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with additional anions; cations in [4], [5] and/or only [6] coordination</gsmin:strunzlabel>
