    <gsmin:rruffnameplain xml:lang="en">Tamboite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Cooper, M.A., Hawthorne, F.C., Abdu, Y.A., Walford, P.C. and Back, M.E. (2016) Tamboite, IMA 2016-059. CNMNC Newsletter No. 33, October 2016, page 1142; Mineralogical Magazine, 80, 1135–1144</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/sarkinite">
