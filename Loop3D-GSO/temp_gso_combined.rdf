  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/vayrynenite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Väyrynenite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | Be | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/vayrynenite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BeMn&lt;sup&gt;2+&lt;/sup&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)(OH)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: ManganeseII berillium phosphate hydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-4220</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4220:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4220.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;Be(PO&lt;sub&gt;4&lt;/sub&gt;)OH</gsmin:rruffchemistry>
    <gsmin:rruffids>R050243 | R050590</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Väyrynenite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Vayrynenite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Volborth A, Stradner E (1954) Väyrynenit BeMn[PO_4_](OH), ein neues Mineral, Anzeiger der Österreichischen Akademie der Wissenschaften Mathematisch-Natur Wissenschaftliche Klasse 2, 21-23</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.BA.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With small and medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Vayrynenite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1954</gsmin:wikipediadate>
  </rdf:Description>
