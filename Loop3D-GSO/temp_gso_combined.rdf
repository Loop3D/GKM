    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/brindleyite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ni,Al)&lt;sub&gt;3&lt;/sub&gt;(Si,Al)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;5&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1975-009a</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-774</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:774:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-774.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ni&lt;sup&gt;2+&lt;/sup&gt;,Al)&lt;sub&gt;3&lt;/sub&gt;(Si,Al)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;5&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Brindleyite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Brindleyite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Maksimovic Z, Bish D L (1978) Brindleyite, a nickel-rich aluminous serpentine mineral analogous to berthierine, American Mineralogist 63, 484-489</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Serpentine</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.ED.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with kaolinite layers composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Brindleyite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1975-009a</gsmin:wikipediadate>
  </rdf:Description>
