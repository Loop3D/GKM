    <gsmin:rruffnameplain xml:lang="en">Vanmeersscheite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Piret P, Deliens M (1982) La vanmeerscheite U(UO_2_)_3_(PO_4_)_2_(OH)_6_·4(H_2_O) et la méta-vanmeerscheite U(UO_2_)_3_(PO_4_)_2_(OH)_6_·2(H_2_O), nouveaux minéraux, Bulletin de Minéralogie 105, 125-128</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.EC.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl phosphate or arsenate, UO2:RO4 = 3:2</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Vanmeersscheite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1981-009</gsmin:wikipediadate>
