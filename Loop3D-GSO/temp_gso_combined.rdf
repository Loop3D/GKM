    <gsmin:imanumber xml:lang="en">IMA1979-032</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2107</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2107:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2107.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;10&lt;/sub&gt;Ca&lt;sub&gt;6&lt;/sub&gt;Mg&lt;sub&gt;18&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;25&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;36&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Johnsomervilleite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Johnsomervilleite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Livingstone A (1980) Johnsomervilleite, a new transition-metal phosphate mineral from the Loch Quoich area, Scotland, Mineralogical Magazine 43, 833-836</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Fillowite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.AC.50</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, without H2O, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Johnsomervilleite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1979-032</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/melanocerite-ce">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Melanocerite-(Ce)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ce | Si | O | B | H</gsmin:chemistryelements>
    <gsmin:fleischersgroup xml:lang="en">tritomite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/melanoceritece.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ce&lt;sub&gt;5&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;,BO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH,O)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Questionable mineral species|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2629</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2629:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2629.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ce&lt;sub&gt;5&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;,BO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH,O)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Melanocerite-(Ce)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Melanocerite-(Ce)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Name changed from melanocerite: Nickel E H, Mandarino J A (1987) Procedures involving the IMA Commission on New Minerals and Mineral Names and guidelines on mineral nomenclature, American Mineralogist 72, 1031-1042 Mineral is equal to tritomite-(Ce), so the name of melanocerite-(Ce) is discredited: Pasero M, Kampf A R, Ferraris C, Pekov I V, Rakovan J R, White T J (2010) Nomenclature of the apatite supergroup minerals, European Journal of Mineralogy 22, 163-179</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Apatite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AJ.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with BO3 triangles and/or B[4], Be[4] tetrahedra, cornersharing with SiO4</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Melanocerite-%28Ce%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1887, 1890</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ephesite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ephesite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
