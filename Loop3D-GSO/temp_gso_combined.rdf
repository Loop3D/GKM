  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/phoenicochroite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Phoenicochroite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | O | Cr</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/phoenicochroite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;2&lt;/sub&gt;O(CrO&lt;sub&gt;4&lt;/sub&gt;)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3194</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3194:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3194.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O(Cr&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)</gsmin:rruffchemistry>
    <gsmin:rruffids>R050164 | R050587</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Phoenicochroite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Phoenicochroite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named melanochroït: Hermann R (1833) Ueber den Melanochroït, ein neues Mineral, Annalen der Physik und Chemie 28, 162-164 Renamed phönikechroit: Glocker E F (1839) 19. Phönikechroit, in Grundrib der Mineralogie, mit Einschlub der Geognosie und Petrefactenkunde, Schrag (Nurnberg) 612-612</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.FB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Chromate, With additional O,V, S, Cl</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Phoenicochroite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1833</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/messelite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Messelite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Fe | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">fairfieldite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/messelite.pdf</gsmin:handbookofmineralogyurl>
