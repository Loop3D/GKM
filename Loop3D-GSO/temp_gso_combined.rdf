    <gsmin:statusnotes xml:lang="en">Gramaccioli C M, Griffin W L, Mottana A (1980) Tiragalloite, Mn_4_[AsSi_3_O_12_(OH)], a new mineral and the first example of arsenatotrisilicate, American Mineralogist 65, 947-952</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.BJ.25</gsmin:strunzcodeV10>
