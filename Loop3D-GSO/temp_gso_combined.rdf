  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/syngenite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Syngenite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Ca | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/syngenite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;Ca(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dipotassium calcium disulfate monohydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-3856</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3856:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3856.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;Ca(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R061002</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Syngenite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Syngenite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Zepharovich V R (1872) Vorläufige Notiz über den Syngenit, ein neues Mineral der Salzlager-Stätten, Lotos. Zeitschrift für Naturwissenschaften 22, 137-138</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Syngenite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.CD.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, with H2O, With only large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Syngenite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1872</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseFamennianSP1993">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologiccontact/GSSP"/>
    <dct:source xml:lang="en">Episodes 16/4, p. 433 441, 1993</dct:source>
    <rdfs:comment xml:lang="en">Base of Bed 32a, Coumiac Quarry, near Cessenon, Montagne Noire, France</rdfs:comment>
    <rdfs:label xml:lang="en">GSSP Base of Famennian</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://stratigraphy.science.purdue.edu/references/Famennian.pdf"/>
