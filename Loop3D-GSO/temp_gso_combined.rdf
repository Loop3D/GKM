  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ettringite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ettringite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Al | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">ettringite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/ettringite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;6&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;12&lt;/sub&gt;·26H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1414</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1414:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1414.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;6&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;12&lt;/sub&gt;·26H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070208</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ettringite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ettringite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Lehmann J (1874) Über den ettringit, ein neues mineral, in Kalkeinschlüssen der Lava von Ettringen (Laacher Gebiet), Neues Jahrbuch für Mineralogie, Geologie und Palaontologie 1874, 273-275</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Ettringite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.DG.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With large and medium-sized cations; with NO3, CO3, B(OH)4, SiO4 or IO3</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Ettringite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1874</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/fiemmeite">
