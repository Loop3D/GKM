    <gsmin:mindaturl>http://www.mindat.org/min-7386.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Zn&lt;sup&gt;2+&lt;/sup&gt;,Al,Fe&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;3&lt;/sub&gt;(Al,Fe&lt;sup&gt;3+&lt;/sup&gt;,Ti&lt;sup&gt;4+&lt;/sup&gt;)&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;15&lt;/sub&gt;(OH)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zincohögbomite-2&amp;lt;i&amp;gt;N&amp;lt;/i&amp;gt;2&amp;lt;i&amp;gt;S&amp;lt;/i&amp;gt;</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Zincohogbomite-2N2S</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Designated as zincohögbomite: Ockenga E, Yal?in Ü, Medenbach O, Schreyer W (1998) Zincohögbomite, a new mineral from eastern Aegean metabauxites, European Journal of Mineralogy 10, 1361-1366 Designated as zincohögbomite-8H: Armbruster T (1998) Zincohögbomite-8H from Samos (Greece): crystal structure, polysomatism and polytypism in högbomite related structures, Schweizerische Mineralogische und Petrographische Mitteilungen 78, 461-468 Name changed from zincohogbomite-8H, and chemical formula revised: Armbruster T (2002) Revised nomenclature of högbomite, nigerite, and taafeite minerals, European Journal of Mineralogy 14, 389-395</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hogbömite-Zincohögbomite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.CB.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 2: 3,3: 5, and similar, With medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Zincohogbomite-2N2S.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1994-016</gsmin:wikipediadate>
  </rdf:Description>
