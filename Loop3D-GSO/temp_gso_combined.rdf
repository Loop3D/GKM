    <gsmin:imanumber xml:lang="en">IMA1988-032</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2247</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2247:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2247.html</gsmin:mindaturl>
