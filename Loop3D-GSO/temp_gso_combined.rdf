    <gsmin:imastatus xml:lang="en">Approved|Pending publication</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;8&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Ca&lt;sub&gt;6&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;,Mn&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;3&lt;/sub&gt;Zr&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Nb&lt;sup&gt;5+&lt;/sup&gt;Si&lt;sub&gt;24&lt;/sub&gt;(Si,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;,Ti&lt;sup&gt;4+&lt;/sup&gt;)O&lt;sub&gt;72&lt;/sub&gt;(O,OH)&lt;sub&gt;3&lt;/sub&gt;Cl·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Siudaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Siudaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chukanov, N., Rastsvetaeva, R.K., Kruszewski, L., Aksenov, S.M., Rusakov, V.S., Britvin, S.N. and Vozchikova, S.A. (2018) Siudaite, IMA 2017-092. CNMNC Newsletter No. 41, February 2018, page 231; Mineralogical Magazine, 82, 229–233</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Eudialyte</gsmin:structuralgroup>
