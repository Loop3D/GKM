  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/baotite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Baotite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ba | Ti | Nb | W | O | Si | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/baotite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba&lt;sub&gt;4&lt;/sub&gt;(Ti,Nb,W)&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;16&lt;/sub&gt;(SiO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;Cl</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-510</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:510:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-510.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba&lt;sub&gt;4&lt;/sub&gt;(Ti&lt;sup&gt;4+&lt;/sup&gt;,Nb&lt;sup&gt;5+&lt;/sup&gt;,W&lt;sup&gt;6+&lt;/sup&gt;)&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;16&lt;/sub&gt;(SiO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;Cl</gsmin:rruffchemistry>
    <gsmin:rruffids>R060251 | R060414</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Baotite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Baotite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Simonov V I (1960) Baotite - a mineral with [Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;] metasilicate rings, Soviet Physics - Crystallography 5, 523-525</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.CE.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si4O12]8- 4-membered single rings (vierer-Einfachringe), without insular complex anions</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Baotite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1960</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/cryobostryxite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cryobostryxite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Zn | Cl | H | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KZnCl&lt;sub&gt;3&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2014-058</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KZn&lt;sup&gt;2+&lt;/sup&gt;Cl&lt;sup&gt;1-&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cryobostryxite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cryobostryxite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pekov I V, Zubkova N V, Britvin S N, Yapaskurt V O, Chukanov N V, Lykova I S, Sidorov E G, Pushcharovsky D Yu (2015) New zinc and potassium chlorides from fumaroles of the Tolbachik volcano, Kamchatka, Russia: mineral data and crystal chemistry. III. Cryobostryxite, KZnCl_3_·2H_2_O. European Journal of Mineralogy 27, 805-812</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/potassic-mangani-leakeite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Potassic-mangani-leakeite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Na | Mg | Mn | Li | Si | O | H</gsmin:chemistryelements>
    <gsmin:fleischersgroup xml:lang="en">amphibole-group 4 Na</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KNa&lt;sub&gt;2&lt;/sub&gt;(Mg&lt;sub&gt;2&lt;/sub&gt;Mn&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Li)Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1992-032</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KNa&lt;sub&gt;2&lt;/sub&gt;(Mg&lt;sub&gt;2&lt;/sub&gt;Mn&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Li)Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Potassic-mangani-leakeite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Potassic-mangani-leakeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Armbruster T, Oberhänsli R, Bermanec V, Dixon R (1993) Hennomartinite and kornite, two new Mn^3+^ rich silicates from the Wessels mine, Kalahari, South Africa, Schweizerische Mineralogische und Petrographische Mitteilungen 73, 349-355 Name changed from kornite according to: Hawthorne F C, Oberti R, Harlow G E, Maresch W V, Martin R F, Schumacher J C, Welch M D (2012) Nomenclature of the amphibole supergroup. American Mineralogist 97, 2031-2048</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Amphibole</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/aphthitalite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Aphthitalite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Na | S | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">aphthitalite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/aphthitalite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;3&lt;/sub&gt;Na(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Tripotassium natrium disulfate</gsmin:iupacchemname>
    <gsmin:mindatid>min-280</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:280:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-280.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;3&lt;/sub&gt;Na(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050651</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Aphthitalite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Aphthitalite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Called vesuvian salt: Smithson J (1813) On a saline substance from Mount Vesuvius, Philosophical Transactions of the Royal Society of London 103, 256-262 Named aphthalose: Beudant F S (1832) Aphthalose, tartre vitriolé, in Traité Élémentaire de Minéralogie, 2nd Edition, (Paris) 477-478 Renamed aphthitalite: Shepard C U (1835) Aphthitalite, Treatise on Mineralogy: second part 1, Hezekiah Howe and Co. and Herrick and Noyes (New Haven, Connecticut, USA) 36-36</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Aphthitalite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.AC.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, without H2O, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Aphthitalite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1813</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/alpeite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Alpeite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Mn | Al | Mg | Si | O | V | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;4&lt;/sub&gt;Mn&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;(Mn&lt;sup&gt;3+&lt;/sup&gt;Mg)(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;)(VO&lt;sub&gt;4&lt;/sub&gt;)(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2016-072</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;4&lt;/sub&gt;Mn&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;(Mn&lt;sup&gt;3+&lt;/sup&gt;Mg)(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;)(V&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Alpeite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Alpeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf A R, Carbone C, Belmonte D, Nash B P, Chiappino L, Castellaro F (2017) Alpeite, Ca_4_Mn^3+^_2_Al_2_(Mn^3+^Mg)(SiO_4_)_2_(Si_3_O_10_)(V^5+^O_4_)(OH)_6_ a new ardennite-group mineral from Italy. 29, 907-914</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Ardennite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/fencooperite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Fencooperite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ba | Fe | Si | O | C | Cl | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba&lt;sub&gt;6&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;23&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;Cl&lt;sub&gt;3&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2000-023</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-10343</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:10343:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-10343.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba&lt;sub&gt;6&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;23&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;Cl&lt;sub&gt;3&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R061032</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fencooperite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Fencooperite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Roberts A C, Grice J D, Dunning G E, Venance K E (2001) Fencooperite, Ba_6_Fe^3+^_3_Si_8_O_23_(CO_3_)_2_Cl_3_·H_2_O, a new mineral species from Trumbull Peak, Mariposa County, California, The Canadian Mineralogist 39, 1059-1064</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.BH.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate with Si3O10, Si4O11, etc. anions; cations in tetrahedral [4] and greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Fencooperite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2000-023</gsmin:wikipediadate>
  </rdf:Description>
