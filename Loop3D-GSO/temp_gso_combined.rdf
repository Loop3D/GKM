    <gsmin:mindaturl>http://www.mindat.org/min-3657.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;3+&lt;/sup&gt;Al&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;·7H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R050576</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sigloite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Sigloite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hurlbut C S, Honea R (1962) Sigloite, a new mineral from Llallagua, Bolivia, American Mineralogist 47, 1-8</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Laueite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DC.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With only medium-sized cations, (OH, etc.):RO4 = 1:1 and &lt; 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Sigloite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1962</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/siderotil">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Siderotil</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Fe | Cu | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">chalcanthite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/siderotil.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Fe,Cu)(SO&lt;sub&gt;4&lt;/sub&gt;)·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1962-006a</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: IronII sulfate pentahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-3643</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3643:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3643.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Fe&lt;sup&gt;2+&lt;/sup&gt;,Cu&lt;sup&gt;2+&lt;/sup&gt;)S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Siderotil</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Siderotil</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Schrauf A (1892) Ueber Metacinnaberit von Idria und dessen Paragenesis. 9. Sulfate: Baryt, Bittersalz-Efflorescenzen, Idrizit, Siderotil und Gyps, Jahrbuch der Kaiserlich-Königlichen Geologischen Reichsanstalt 41, 377-381 Redefined: Jambor J L, Traill R J (1963) On rozenite and siderotil, The Canadian Mineralogist 7, 751-763</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Chalcanthite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EC.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with mica sheets, composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
