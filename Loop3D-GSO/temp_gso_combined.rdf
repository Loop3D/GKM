  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ferronigerite-6n6s">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ferronigerite-6N6S</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Al | Fe | Zn | Sn | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">nigerite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/ferronigerite6n6s.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Al,Fe,Zn)&lt;sub&gt;3&lt;/sub&gt;(Al,Sn,Fe)&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;15&lt;/sub&gt;(OH)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:mindatid>min-11451</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:11451:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-11451.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Al,Fe&lt;sup&gt;3+&lt;/sup&gt;,Zn&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;3&lt;/sub&gt;(Al,Sn&lt;sup&gt;4+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;15&lt;/sub&gt;(OH)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ferronigerite-6N6S</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ferronigerite-6N6S</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Recognized as a species distinct from nigerite, but not named: Burke E A J, Lof P, Hazebroek H P (1977) Nigerite from the Rosendal pegmatite and aplites, Kemiö Island, Southwestern Finland. Bulletin of the Geological Society of Finland 49, 151-157 Named nigerite-24R Grey I E, Gatehouse, B M (1979) The crystal structure of nigerite-24R, American Mineralogist 64, 1255-1264 Renamed ferronigerite-6N6S: Armbruster T (2002) Revised nomenclature of högbomite, nigerite, and taafeite minerals, European Journal of Mineralogy 14, 389-395</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Nigerite-Ferronigerite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.FC.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Hydroxide (without V or U), Hydroxides with OH, without H2O; corner-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Ferronigerite-6N6S.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1947</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/telluromandarinoite">
