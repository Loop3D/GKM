    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3257:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3257.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Y&lt;sup&gt;3+&lt;/sup&gt;(Ti&lt;sup&gt;4+&lt;/sup&gt;,Nb&lt;sup&gt;5+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;(O,OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Polycrase-(Y)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Polycrase-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Scheerer T (1844) Polykras und malakon, zwei neue Mineralspecies, Annalen der Physik und Chemie 62, 429-443 Name changed from polycrase: Nickel E H, Mandarino J A (1987) Procedures involving the IMA Commission on New Minerals and Mineral Names and guidelines on mineral nomenclature, American Mineralogist 72, 1031-1042</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Columbite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.DG.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With large (+- medium-sized) cations; chains of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Polycrase-%28Y%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1844</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/routhierite">
