    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:27530:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-27530.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(K&lt;sub&gt;1-x&lt;/sub&gt;&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;&lt;sub&gt;x&lt;/sub&gt;)(Ca,Na)&lt;sub&gt;2&lt;/sub&gt;U&lt;sup&gt;4+&lt;/sup&gt;Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;20&lt;/sub&gt; (x~0.5)</gsmin:rruffchemistry>
    <gsmin:rruffids>R060672</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Arapovite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Arapovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Agakhanov A A, Pautov L A, Uvarova Y A, Sokolova E V, Hawthorne F C, Karpenko V Y, Dusmatov V D, Semenov E I (2004) Arapovite, (U,Th)(Ca,Na)&lt;sub&gt;2&lt;/sub&gt;(K&lt;sub&gt;1-x&lt;/sub&gt;[box]&lt;sub&gt;x&lt;/sub&gt;)Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;20&lt;/sub&gt;·H_2_O – new mineral, New Data on Minerals. Moscow 39, 14-19 Chemical formula revised: Uvarova Y A, Sokolova E, Hawthorne F C, Agakhanov A A, Pautov L A (2004) The crystal structure of arapovite, U&lt;sup&gt;4+&lt;/sup&gt;(Ca,Na)&lt;sub&gt;2&lt;/sub&gt;(K&lt;sub&gt;1-x&lt;/sub&gt;[box]&lt;sub&gt;x&lt;/sub&gt;)[Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;20&lt;/sub&gt;], x~0.5, a new mineral species of the steacyite group from the Dara-I-Pioz Moraine, Tien-Shan Mountains, Tajikistan, The Canadian Mineralogist 42, 1005-1011</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Steacyite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CH.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si4O12]8- 4-membered double rings</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://webmineral.com/data/Arapovite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2003-046</gsmin:wikipediadate>
