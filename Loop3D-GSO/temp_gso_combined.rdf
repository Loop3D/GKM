    <gsmin:rruffnameplain xml:lang="en">Ruizite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Williams S A, Duggan M (1977) Ruizite, a new silicate mineral from Christmas, Arizona, Mineralogical Magazine 41, 429-432 Chemical formula revised from CaMn(SiO_3_)_2_(OH)·2H_2_O: Hawthorne F C (1984) The crystal structure of ruizite, a sorosilicate with an [Si_4_O_13_] cluster. Tschermaks Mineralogische und Petrographische Mitteilungen 33, 135-146</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Ruizite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.BJ.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate with Si3O10, Si4O11, etc. anions; cations in octahedral [6] and greater coordination</gsmin:strunzlabel>
