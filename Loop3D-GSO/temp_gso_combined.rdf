    <gsmin:chemistryelements>Ca | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/phaunouxite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;3&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·11H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1980-062</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Tricalcium diarsenate undecahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-3186</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3186:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3186.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;3&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·11H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Phaunouxite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Phaunouxite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Bari H, Catti M, Ferraris G, Ivaldi G, Permingeat F (1982) Phaunouxite Ca3(AsO4)2.11H2O, a new mineral strictly associated with rauenthalite, Bulletin de Minéralogie 105, 327-332 Dunn P J, Cabri L J, Clark A M, Fleischer M (1983) New mineral names, American Mineralogist 68, 849-852</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.CJ.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With only large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Phaunouxite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1980-062</gsmin:wikipediadate>
  </rdf:Description>
