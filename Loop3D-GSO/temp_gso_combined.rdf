    <gsmin:chemistryelements>Na | Mg | S | O | F | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/uklonskovite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaMg(SO&lt;sub&gt;4&lt;/sub&gt;)F·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2016-J</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4084</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4084:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4084.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaMg(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)F·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Uklonskovite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Uklonskovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Slyusareva M N (1964) The new mineral uklonskovite, Doklady Akademii Nauk SSSR 158, 1093-1095 Formula changed from NaMg(SO_4_)(OH)·2H_2_O to NaMg(SO_4_)F·2H_2_O: Menchetti S, Bindi L, Belakovskiy D, Zaccarini F (2017) Structural, chemical and spectroscopic re-examination of type uklonskovite leads to its redefinition. Mineralogical Magazine 81, 1397-1404</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.DF.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With large and medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Uklonskovite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1964</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/chernykhite">
