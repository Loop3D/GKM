  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicrole/Orb">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI GTWG vocabulary</dct:source>
    <rdfs:comment xml:lang="en">A circular-shaped rock body within another rock body.</rdfs:comment>
    <rdfs:comment xml:lang="en">Igneous constituent typically mafic, equant rounded spheroid with concentric mineralogic banding.</rdfs:comment>
    <rdfs:label xml:lang="en">Orb</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Part"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/byzantievite">
