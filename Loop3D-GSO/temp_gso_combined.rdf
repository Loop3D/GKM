  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Passive_Continental_Margin_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI Event Environment vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Boundary of continental crust into oceanic crust of an oceanic basin that is not a subduction zone or transform fault system. Generally is rifted margin formed when ocean basin was initially formed.</rdfs:comment>
    <rdfs:label xml:lang="en">passive continental margin setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Tectonic_Setting"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb26e920196f4af8bbd263b193e6f242b1015">
