    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ferri-mottanaite-(Ce)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ferri-mottanaite-(Ce)</gsmin:rruffnameplain>
