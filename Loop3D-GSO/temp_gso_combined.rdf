    <gsmin:rruffids>R060922</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Wilkinsonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Wilkinsonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Duggan M B (1990) Wilkinsonite, Na_2_Fe^2+^_4_Fe^3+^_2_Si_6_O_20_, a new member of the aenigmatite group from the Warrumbungle Volcano, New South Wales, Australia, American Mineralogist 75, 694-701</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Sapphirine</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DH.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 4-periodic single chains, Si4O12</gsmin:strunzlabel>
