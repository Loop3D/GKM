  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/gallite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Gallite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Ga | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">chalcopyrite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/gallite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CuGaS&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Copper gallium disulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-1644</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1644:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1644.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;1+&lt;/sup&gt;Ga&lt;sup&gt;3+&lt;/sup&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Gallite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Gallite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Strunz H, Geier B H, Seeliger E (1958) Gallit, CuGaS_2_, das erste selbständige galliummineral, und seine verbreitung in den Erzen der Tsumeb- und Kipushi-Mine, Neues Jahrbuch für Mineralogie, Monatshefte 1958, 241-264</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Chalcopyrite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.CB.10a</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide (M = S) with Zn, Fe, Cu, Ag, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Gallite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1958</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/faujasite-na">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Faujasite-Na</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Mg | Si | Al | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">zeolite-faujasite series</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/faujasitena.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,Ca,Mg)&lt;sub&gt;2&lt;/sub&gt;(Si,Al)&lt;sub&gt;12&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;·15H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:mindatid>min-6922</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:6922:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-6922.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,Ca,Mg)&lt;sub&gt;2&lt;/sub&gt;(Si,Al)&lt;sub&gt;12&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;·15H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Faujasite-Na</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Faujasite-Na</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Damour A A (1842) Description de la faujasite, nouvelle espèce minérale, Annales des Mines 1, 395-397 Name changed from faujasite: Coombs D S, Alberti A, Armbruster T, Artioli G, Colella C, Galli E, Grice J D, Liebau F, Mandarino J A, Minato H, Nickel E H, Passaglia E, Peacor D R, Quartieri S, Rinaldi R, Ross M, Sheppard R A, Tillmanns E, Vezzalini G, (1997) Recommended nomenclature for zeolite minerals: report of the Subcommittee on Zeolites of the International Mineralogical Association, Commission on New Minerals and Mineral Names, The Canadian Mineralogist 35, 1571-1606</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.GD.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Zeolite family: Chains of 6-membered rings – tabular zeolites</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Faujasite-Na.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1842</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/rhabdoborite-w">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Rhabdoborite-(W)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mg | W | V | O | B | P | As | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;12&lt;/sub&gt;(W&lt;sup&gt;6+&lt;/sup&gt;,V&lt;sup&gt;5+&lt;/sup&gt;)&lt;sub&gt;1.5&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;{[BO&lt;sub&gt;3&lt;/sub&gt;]&lt;sub&gt;6-x&lt;/sub&gt;[(P,As)O&lt;sub&gt;4&lt;/sub&gt;]&lt;sub&gt;x&lt;/sub&gt;F&lt;sub&gt;2-x&lt;/sub&gt;} (x &lt; 1)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2017-109</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Pending publication</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;12&lt;/sub&gt;(W&lt;sup&gt;6+&lt;/sup&gt;,V&lt;sup&gt;5+&lt;/sup&gt;)&lt;sub&gt;1.5&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;{[BO&lt;sub&gt;3&lt;/sub&gt;]&lt;sub&gt;6-x&lt;/sub&gt;[(P,As&lt;sup&gt;5+&lt;/sup&gt;)O&lt;sub&gt;4&lt;/sub&gt;]&lt;sub&gt;x&lt;/sub&gt;F&lt;sub&gt;2-x&lt;/sub&gt;} (x &lt; 1)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Rhabdoborite-(W)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Rhabdoborite-(W)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pekov, I.V., Zubkova, N.V., Koshlyakova, N.N., Belakovskiy, D.I., Vigasina, M.F., Agakhanov, A.A., Britvin, S.N., Sidorov, E. G. and Pushcharovsky, D.Y. (2018) Rhabdoborite-(W), IMA 2017-109. CNMNC Newsletter No. 42, April 2018, page 449; Mineralogical Magazine, 82, 445–451</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Rhabdoborite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/loseyite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Loseyite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | Zn | C | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/loseyite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Zn&lt;sub&gt;3&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;10&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: HeptamanganeseII dicarbonate decahydoxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-2438</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2438:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2438.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;10&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Loseyite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Loseyite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Bauer L H, Berman H (1929) Loseyite - a new Franklin mineral, American Mineralogist 14, 150-153</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.BA.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions, without H2O, With Cu, Co, Ni, Zn, Mg, Mn</gsmin:strunzlabel>
