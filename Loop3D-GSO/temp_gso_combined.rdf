    <gsmin:mindaturl>http://www.mindat.org/min-3536.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)(OH)·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sarmientite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Sarmientite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Angelelli V, Gordon S G (1941) Sarmientite, a new mineral from Argentina, Notulae Naturae of The Academy of Natural Sciences of Philadelphia 92, 1-4</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.DB.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With only medium-sized cations, (OH, etc.):RO4&lt; 1:1</gsmin:strunzlabel>
