  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/sclarite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Sclarite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Zn | C | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/sclarite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sub&gt;7&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;10&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1988-026</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Heptazinc dicarbonate decahydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-3593</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3593:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3593.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;7&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;10&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sclarite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Sclarite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Grice J D, Dunn P J (1989) Sclarite, a new mineral from Franklin, New Jersey, with essential octahedrally and tetrahedrally coordinated zinc: description and ststructure refinement, American Mineralogist 74, 1355-1359</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.BA.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions, without H2O, With Cu, Co, Ni, Zn, Mg, Mn</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Sclarite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1988-026</gsmin:wikipediadate>
  </rdf:Description>
