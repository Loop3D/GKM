    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7257:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7257.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;3&lt;/sub&gt;B&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;9&lt;/sub&gt;(OH)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pseudosinhalite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Pseudosinhalite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Daniels P, Krosse S, Werding G, Schreyer W (1997) "Pseudosinhalite", a new hydrous MgAl-borate: synthesis, phase characterization, crystal structure, and PT-stability, Contributions to Mineralogy and Petrology 128, 261-271 Schreyer W, Pertsev N N, Medenbach O, Burchard M, Dettmar D (1998) Pseudosinhalite: discovery of the hydrous MgAl-borate as a new mineral in the Tayozhnoye, Siberia, skarn deposit, Contributions to Mineralogy and Petrology 133, 382-388 Jambor J L, Pertsev N N, Roberts A C (1999) New mineral names, American Mineralogist 84, 1195-1198</gsmin:statusnotes>
    <gsmin:strunzcodeV10>06.AC.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Monoborate, B(O,OH)4, without and with additional anions; 1(T), 1(T)+OH, etc</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Pseudosinhalite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1997-014</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/stishovite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
