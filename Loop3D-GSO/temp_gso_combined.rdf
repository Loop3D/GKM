    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;5&lt;/sub&gt;Ca&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;23&lt;/sub&gt;Al&lt;sub&gt;9&lt;/sub&gt;)O&lt;sub&gt;64&lt;/sub&gt;·24H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1976-046</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2651</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2651:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2651.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;5&lt;/sub&gt;Ca&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;23&lt;/sub&gt;Al&lt;sub&gt;9&lt;/sub&gt;)O&lt;sub&gt;64&lt;/sub&gt;·24H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R130095</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Merlinoite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Merlinoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Passaglia E, Pongiluppi D, Rinaldi R (1977) Merlinoite, a new mineral of the zeolite group, Neues Jahrbuch für Mineralogie, Monatshefte 1977, 355-364</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.GC.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Zeolite family: Chains of doubly-connected 4-membered rings</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Merlinoite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1976-046</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/witherite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Witherite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ba | C | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">aragonite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/witherite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba(CO&lt;sub&gt;3&lt;/sub&gt;)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Barium carbonate</gsmin:iupacchemname>
