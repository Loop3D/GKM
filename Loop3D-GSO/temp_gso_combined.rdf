    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4166</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4166:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4166.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sr&lt;sub&gt;2&lt;/sub&gt;[B&lt;sub&gt;5&lt;/sub&gt;O&lt;sub&gt;8&lt;/sub&gt;(OH)]&lt;sub&gt;2&lt;/sub&gt;B(OH)&lt;sub&gt;3&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060348</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Veatchite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Veatchite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Switzer G (1938) Veatchite, a new calcium borate from Lang, California, American Mineralogist 23, 409-411 Chemical formula changed from Ca_2_B_6_O_11_·2H_2_O to Sr_3_B_16_O_27_·5H_2_O: Switzer G, Brannock W W (1950) Composition of veatchite, American Mineralogist 35, 90-92 Chemical formula revised again: Clark J R, Christ C L (1971) Veatchite: crystal structure and correlations with p-veatchite, American Mineralogist 56, 1934-1954</gsmin:statusnotes>
    <gsmin:strunzcodeV10>06.EC.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllo-pentaborate</gsmin:strunzlabel>
