    <gsmin:rruffnameplain xml:lang="en">Anapaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Sachs A (1902) Über anapait, ein neues kalkeisenphosphat von Anapa am Schwarzen Meere, Sitzungsberichte der Königlich Preussischen Akademie der Wissenschaften 1902, 18-21</gsmin:statusnotes>
