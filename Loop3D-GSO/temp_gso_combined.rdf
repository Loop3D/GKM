    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;5&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(AsO&lt;sub&gt;3&lt;/sub&gt;OH)&lt;sub&gt;2&lt;/sub&gt;·10H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Pentamagnesium diarsenate dihydrogen arsenate decahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1043</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1043:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1043.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;5&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;OH)&lt;sub&gt;2&lt;/sub&gt;·10H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Chudobaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Chudobaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Strunz H (1960) Chudobait, ein neues Mineral von Tsumeb, Neues Jahrbuch für Mineralogie, Monatshefte 1960, 1-7</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Lindackerite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CE.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With only medium-sized cations, RO4:H2O about 1:2.5</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Chudobaite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1960</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/aguilarite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
