    <gsmin:mindatid>min-43332</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:43332:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-43332.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al&lt;sub&gt;2&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)(PO&lt;sub&gt;4&lt;/sub&gt;)F·9H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Arangasite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Arangasite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Gamyanin G N, Zayakina N V, Galenchikova L T (2013) Arangasite, Al_2_(PO_4_)(SO_4_)F·7.5H_2_O, a new mineral from Alaskitovoye deposit (Eastern Yakutia, Russia). Zapiski Rossiiskogo Mineralogicheskogo Obshchetstva 142(5), 21-30 Chemical formula revised from Al_2_(SO_4_)(PO_4_)F·7.5H_2_O: Yakubovich O V, Steele I M, Chernyshev V V, Zayakina N V, Gamyanin G N, Karimova O V (2014) The crystal structure of arangasite, Al_2_F(PO_4_)(SO_4_)·9H_2_O determined using low-temperature synchrotron data. Mineralogical Magazine 78, 889-903</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">phosphate, arsenate, or vanadate</gsmin:strunzlabel>
    <gsmin:wikipediadate>2012-018</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/chevkinite-ce">
