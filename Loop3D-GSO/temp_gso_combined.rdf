    <gsmin:chemistryelements>Bi | Ta | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">cervantite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/bismutotantalite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BiTaO&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Bismuth tantalum tetraoxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-663</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:663:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-663.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bi&lt;sup&gt;3+&lt;/sup&gt;Ta&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R130254 | R130778</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bismutotantalite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Bismutotantalite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Wayland E J, Spencer L J (1929) Bismutotantalite, a new mineral, from Uganda, Mineralogical Magazine 22, 185-192</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.DE.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With medium-sized cations; with various polyhedra</gsmin:strunzlabel>
