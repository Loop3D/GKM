  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/goyazite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Goyazite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Sr | Al | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">alunite-jarosite-plumbogummite subgroup</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/goyazite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">SrAl&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)(PO&lt;sub&gt;3&lt;/sub&gt;OH)(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Strontium trialuminium phosphate hydrogenphosphate hexahydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-1787</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1787:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1787.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">SrAl&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)(PO&lt;sub&gt;3&lt;/sub&gt;OH)(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R061054</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Goyazite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Goyazite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Damour A A (1884) Note sur un nouveau phosphate d'alumine et de chaux, des terrains diamantifères, Bulletin de la Société Minéralogique de France 7, 204-205</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Alunite-crandallite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BL.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH, etc.):RO4 = 3:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Goyazite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1884</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/cejkaite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Čejkaite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | U | O | C</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal, monoclinic, triclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;4&lt;/sub&gt;(UO&lt;sub&gt;2&lt;/sub&gt;)(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1999-045</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Tetrasodium uranyl tricarbonate</gsmin:iupacchemname>
    <gsmin:mindatid>min-7105</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7105:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7105.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;4&lt;/sub&gt;UO&lt;sub&gt;2&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Čejkaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cejkaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Ondrus P, Skála R, Veselovský F, Sejkora J, Vitti C (2003) Cejkaite, the triclinic polymorph of Na&lt;sub&gt;4&lt;/sub&gt;(UO&lt;sub&gt;2&lt;/sub&gt;)(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt; - a new mineral from Jáchymov, Czech Republic, American Mineralogist 88, 686-693</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.ED.50</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl Carbonate, UO2:CO3 = 1:3</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Cejkaite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1999-045</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/andrianovite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Andrianovite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | K | Sr | Ce | Ca | Mn | Zr | Nb | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">eudialyte</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;12&lt;/sub&gt;(K,Sr,Ce)&lt;sub&gt;3&lt;/sub&gt;Ca&lt;sub&gt;6&lt;/sub&gt;Mn&lt;sub&gt;3&lt;/sub&gt;Zr&lt;sub&gt;3&lt;/sub&gt;Nb(Si&lt;sub&gt;25&lt;/sub&gt;O&lt;sub&gt;73&lt;/sub&gt;)(O,H&lt;sub&gt;2&lt;/sub&gt;O,OH)&lt;sub&gt;5&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2007-008</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-31664</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:31664:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-31664.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;12&lt;/sub&gt;(K,Sr,Ce&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;3&lt;/sub&gt;Ca&lt;sub&gt;6&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Zr&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Nb&lt;sup&gt;5+&lt;/sup&gt;Si&lt;sub&gt;25&lt;/sub&gt;O&lt;sub&gt;73&lt;/sub&gt;(O,H&lt;sub&gt;2&lt;/sub&gt;O,OH)&lt;sub&gt;5&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Andrianovite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Andrianovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Khomyakov A P, Nechelyustov G N, Rastsvetaeva R K, Rozenberg K A (2008) Andrianovite, Na&lt;sub&gt;12&lt;/sub&gt;(K,Sr,Ce)&lt;sub&gt;3&lt;/sub&gt;Ca&lt;sub&gt;6&lt;/sub&gt;Mn&lt;sub&gt;3&lt;/sub&gt;Zr&lt;sub&gt;3&lt;/sub&gt;NbSi&lt;sub&gt;25&lt;/sub&gt;O&lt;sub&gt;73&lt;/sub&gt;(O,H&lt;sub&gt;2&lt;/sub&gt;O,OH)&lt;sub&gt;5&lt;/sub&gt;, a new potassium-rich mineral of the eudialyte group from Khibiny Alkaline Massif, Kola Peninsula, Russia, Zapiski Rossiiskogo Mineralogicheskogo Obshchetstva 137(2), 43-52</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Eudialyte</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CO.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si9O27]18- 9-membered rings</gsmin:strunzlabel>
    <gsmin:wikipediadate>2007-008</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Mica_Schist">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">This vocabulary</dct:source>
    <rdfs:comment xml:lang="en">A schist that consists of more than 50 percent mica minerals, typically muscovite or biotite. Special type included to distinguish this common variety of schist.</rdfs:comment>
    <rdfs:comment xml:lang="en">Include single subcategory of schist to indicate this common kind of schist. 'Mica rich metamorphic rock' for compound use with schist fabric term would be more compatible with treatment of blueschist (Glaucophane lawsonite epidote metamorphic rock) and greenschist (Chlorite actinolite epidote metamorphic rock), but based on the assumption that schist is the only rock type that will meet the mica-rich criteria, it seems reasonable to include as a subtype of schist.</rdfs:comment>
    <rdfs:label xml:lang="en">mica schist</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Schist"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/chondrodite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Chondrodite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mg | Si | O | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">humite-humite subgroup</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/chondrodite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;5&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;F&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1027</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1027:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1027.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;5&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;F&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R040016 | R110158</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Chondrodite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Chondrodite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">d'Ohsson C M (1817) Undersokning af någre mineralier, Kong. Svenska Vetenskaps-Akademiens Handlingar 1817, 206-210</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Humite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AF.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with additional anions; cations in [4], [5] and/or only [6] coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Chondrodite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1817</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/graftonite-mn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Graftonite-(Mn)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | Fe | P | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">MnFe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2017-050</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Graftonite-(Mn)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Graftonite-(Mn)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pieczka A, Hawthorne F C, Ball N, Abdu Y, Golebiowska B, Wlodek A, Zukrowski J (2018) Graftonite-(Mn), ideally ^&lt;i&gt;M1&lt;/i&gt;^Mn^&lt;i&gt;M2,M3&lt;/i&gt;^Fe_2_(PO_4_)_2_, and graftonite- (Ca), ideally ^&lt;i&gt;M1&lt;/i&gt;^Ca^&lt;i&gt;M2,M3&lt;/i&gt;^Fe_2_(PO_4_)_2_, two new minerals of the graftonite group from Poland. Mineralogical Magazine 82, 1307-1322</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Graftonite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/villamaninite">
