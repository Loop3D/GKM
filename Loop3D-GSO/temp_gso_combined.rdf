    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,K,Ca)&lt;sub&gt;x&lt;/sub&gt;Mn&lt;sub&gt;6&lt;/sub&gt;(Si,Al)&lt;sub&gt;10&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O (x = 1-2; n = 7-11)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1982-059</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1356</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1356:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1356.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,K,Ca)&lt;sub&gt;1-2&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;(Si,Al)&lt;sub&gt;10&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·7-11H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Eggletonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Eggletonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Peacor D, Dunn P J, Simmons W B (1984) Eggletonite, the Na analogue of ganophyllite, Mineralogical Magazine 48, 93-96 Chemical formula revised based on the structure of tamaite: Hughes J M, Rakovan J, Bracco R, Gunter M E (2003) The atomic arrangement of the ganophyllite-group modulated layer silicates as determined from the orthorhombic dimorph of tamaite, with the elusive 16.8 Å ganophyllite-group superstructure revealed, American Mineralogist 88, 1324-1330</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Clay</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EG.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate: Double nets with 6-membered and larger rings</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Eggletonite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1982-059</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/vivianite">
