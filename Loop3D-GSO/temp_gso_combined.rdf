    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(V&lt;sup&gt;3+&lt;/sup&gt;,Fe&lt;sup&gt;2+&lt;/sup&gt;,V&lt;sup&gt;4+&lt;/sup&gt;)O(OH)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
