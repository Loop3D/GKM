    <gsmin:rruffnameplain xml:lang="en">Mineevite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Khomjakov A P, Polezhaeva L I, Yamnova N A, Pushcharovsky D Y (1992) Mineevite-(Y) - Na_25_Ba(Y,Gd,Dy)_2_(CO_3_)_11_(HCO_3_)_4_(SO_4_)_2_F_2_ - a new mineral, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 121(6), 138-142</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.BF.25</gsmin:strunzcodeV10>
