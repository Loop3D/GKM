    <gsmin:rruffnameplain xml:lang="en">Tritomite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Frondel C (1961) Two yttrium minerals: spencite and rowlandite, The Canadian Mineralogist 6, 576-581 Name changed from spencite: Jaffe H W, Molinski V J (1962) Spencite, the yttrium analogue of tritomite from Sussex County, New Jersey, American Mineralogist 47, 9-25</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Apatite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/tvedalite">
