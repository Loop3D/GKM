  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/betpakdalite-camg">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Betpakdalite-CaMg</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | H | O | Mg | Mo | As | Fe</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">[Ca&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;17&lt;/sub&gt;Mg(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;6&lt;/sub&gt;][Mo&lt;sup&gt;6+&lt;/sup&gt;&lt;sub&gt;8&lt;/sub&gt;As&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;36&lt;/sub&gt;(OH)]</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2011-034</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-41944</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:41944:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-41944.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">[Ca&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;17&lt;/sub&gt;Mg(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;6&lt;/sub&gt;][Mo&lt;sup&gt;6+&lt;/sup&gt;&lt;sub&gt;8&lt;/sub&gt;As&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;36&lt;/sub&gt;(OH)]</gsmin:rruffchemistry>
    <gsmin:rruffids>R060242</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Betpakdalite-CaMg</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Betpakdalite-CaMg</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf A R, Mills S J, Rumsey M S, Dini M, Birch W D, Spratt J, Pluth J J, Steele I M, Jenkins R A, Pinch W W (2012) The heteropolymolybdate family: structural relations, nomenclature scheme and new species, Mineralogical Magazine 76, 1175-1207</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Betpakdalite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DM.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 &gt; 2:1</gsmin:strunzlabel>
    <gsmin:wikipediadate>2011-034</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Fine_Grained_Igneous_Rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Gillespie and Styles 1999; LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Igneous rock in which the framework of the rock consists of crystals that are too small to determine mineralogy with the unaided eye; framework may include up to 50 percent glass. A significant percentage of the rock by volume may be phenocrysts. Includes rocks that are generally called volcanic rocks.</rdfs:comment>
    <rdfs:comment xml:lang="en">Need to make decision as to whether devitrified glass should be considered glass or microcrystalline framework for purposes of categorization</rdfs:comment>
    <rdfs:label xml:lang="en">fine grained igneous rock</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Igneous_Rock"/>
    <skos:altLabel xml:lang="en">volcanic rock</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/pigeonite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Pigeonite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mg | Fe | Ca | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/pigeonite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Mg,Fe,Ca)&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3210</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3210:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3210.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Mg,Fe&lt;sup&gt;2+&lt;/sup&gt;,Ca)SiO&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pigeonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Pigeonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Winchell A N (1900) Mineralogical and petrographic study of the gabbroid rocks of Minnesota, and more particularly, of the pagioclasytes, The American Geologist 26, 197-245</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Pyroxene</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DA.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 2-periodic single chains, Si2O6; pyroxene family</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Pigeonite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1900</gsmin:wikipediadate>
  </rdf:Description>
