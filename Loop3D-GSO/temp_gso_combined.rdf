    <gsmin:rruffnameplain xml:lang="en">Hatrurite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Gross S (1977) The mineralogy of the Hatrurim formation, Israel, Geological Survey of Israel 70, 1-80</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.AG.65</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with additional anions; cations in &gt; [6] +- [6] coordination</gsmin:strunzlabel>
