  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/phurcalite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Phurcalite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | U | O | P | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic, unknown</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">phosphuranylite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/phurcalite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·7H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1977-040</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3202</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3202:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3202.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·7H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R050534 | R060698</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Phurcalite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Phurcalite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Deliens M, Piret P (1978) La phurcalite, Ca_2_(UO_2_)_3_(PO_4_)_2_(OH)_4_·4H_2_O, nouveau minéral, Bulletin de Minéralogie 101, 356-358</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Phosphuranylite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.EC.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl phosphate or arsenate, UO2:RO4 = 3:2</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Phurcalite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1977-040</gsmin:wikipediadate>
