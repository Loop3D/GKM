    <gsmin:imanumber xml:lang="en">IMA1979-019</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4284</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4284:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4284.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaCa&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;,Mn&lt;sup&gt;2+&lt;/sup&gt;,Fe&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;4&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070274</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Wicksite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Wicksite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Sturman B D, Peacor D R, Dunn P J (1981) Wicksite, a new mineral from northeastern Yukon Territory, The Canadian Mineralogist 19, 377-380</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Wicksite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CF.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With large and medium-sized cations, RO4:H2O &gt; 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Wicksite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1979-019</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/haigerachite">
