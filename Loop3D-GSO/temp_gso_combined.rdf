    <gsmin:rruffids>R070471</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Gageite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Gageite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Phillips A H (1910) Gageite, a new mineral from Franklin, New Jersey, The American Journal of Science 180, 283-284</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.DH.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 4-periodic single chains, Si4O12</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Gageite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1910</gsmin:wikipediadate>
