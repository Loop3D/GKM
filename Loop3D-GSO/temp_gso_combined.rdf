    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Villamanínite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Villamaninite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Schoeller W R, Powell A R (1920) Villamaninite, a new mineral, Mineralogical Magazine 19, 14-18</gsmin:statusnotes>
