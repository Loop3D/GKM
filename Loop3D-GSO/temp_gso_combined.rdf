  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/graftonite-ca">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Graftonite-(Ca)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Fe | P | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaFe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2017-048</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaFe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Graftonite-(Ca)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Graftonite-(Ca)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pieczka A, Hawthorne F C, Ball N, Abdu Y, Golebiowska B, Wlodek A, Zukrowski J (2018) Graftonite-(Mn), ideally ^&lt;i&gt;M1&lt;/i&gt;^Mn^&lt;i&gt;M2,M3&lt;/i&gt;^Fe_2_(PO_4_)_2_, and graftonite- (Ca), ideally ^&lt;i&gt;M1&lt;/i&gt;^Ca^&lt;i&gt;M2,M3&lt;/i&gt;^Fe_2_(PO_4_)_2_, two new minerals of the graftonite group from Poland. Mineralogical Magazine 82, 1307-1322</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Graftonite</gsmin:structuralgroup>
  </rdf:Description>
