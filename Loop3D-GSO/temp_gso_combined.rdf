  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/allanite-la">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Allanite-(La)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | La | Al | Fe | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">epidote</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaLa(Al&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;)[Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;][SiO&lt;sub&gt;4&lt;/sub&gt;]O(OH)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2003-065</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-126</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:126:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-126.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaLaFe&lt;sup&gt;2+&lt;/sup&gt;Al&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)(SiO&lt;sub&gt;4&lt;/sub&gt;)O(OH)</gsmin:rruffchemistry>
    <gsmin:rruffids>R070246</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Allanite-(La)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Allanite-(La)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">While the name has been used previously, it was only officially approved by IMA with this publication: Orlandi P, Pasero M (2006) Allanite-(La) from Buca della Vena mine, Apuan Alps, Italy, an epidote-group mineral, The Canadian Mineralogist 44, 63-68</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Epidote</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.BG.05b</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate with mixed SiO4 and Si2O7 groups; cations in octahedral [6] and greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Allanite-%28La%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2003-065</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/donpeacorite">
