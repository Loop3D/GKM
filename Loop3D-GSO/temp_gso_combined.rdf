  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/humite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Humite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mg | Si | O | F | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">humite-humite subgroup</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/humite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;7&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(F,OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1947</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1947:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1947.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;7&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(F,OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R040071 | R050665</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Humite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Humite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Bournon J L (1813) Humite, in Catalogue de la Collection Minéralogique du Compte de Bournon, De l'imprimetie de R. Juigné (London) 52-54</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Humite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AF.50</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with additional anions; cations in [4], [5] and/or only [6] coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Humite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1971</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/tegengrenite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Tegengrenite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | Sb | Mg | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
