  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/isRoleObjectFor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Inverse of hasRoleObject. Relation between a role and the non-role-player objects that are associated. E.g. in an employs relation, the entity that employs (employer) is a role object for the employee role.</rdfs:comment>
    <rdfs:range rdf:resource="https://w3id.org/gso/1.0/common/Role"/>
