    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dilead manganeseII hexadecaironIII heptacosaoxide</gsmin:iupacchemname>
