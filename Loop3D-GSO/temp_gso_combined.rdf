    <gsmin:mindatid>min-235</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:235:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-235.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KMgS&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;Cl</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Anhydrokainite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Anhydrokainite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Jänecke E (1912) Über reziproke Salzpaare. II. Das Salzpaar K&lt;sub&gt;2&lt;/sub&gt;Cl&lt;sub&gt;2&lt;/sub&gt;-MgSO&lt;sub&gt;4&lt;/sub&gt;, MgCl&lt;sub&gt;2&lt;/sub&gt;-K&lt;sub&gt;2&lt;/sub&gt;SO&lt;sub&gt;4&lt;/sub&gt;, Zeitschrift für Physikalische Chemie 80, 1-12</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Chlorothionite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.BC.80</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions, without H2O, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:wikipediadate>1912</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/nyholmite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
