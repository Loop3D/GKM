    <gsmin:rruffnameplain xml:lang="en">Crocoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally described as red crystalline lead ore, without a mineral name: Lehmann J G (1767) Nachricht von einem neu endechten Bleyerze. Neues Hamburg Magazin 7, 336-348 Beudant F S (1832) Crocoïse, plomb chromaté, in Traité Élémentaire de Minéralogie, 2nd Edition, (Paris) 669-670</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Monazite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.FA.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Chromate, Without additional anions</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Crocoite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1832</gsmin:wikipediadate>
