    <rdf:first rdf:resource="https://w3id.org/gso/1.0/common/Spatial_Region_0D"/>
    <rdf:rest rdf:nodeID="n7bda25761fc44f8595ef751309700190b428"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/perboeite-ce">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Perbøeite-(Ce)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Ce | Al | Fe | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(CaCe&lt;sub&gt;3&lt;/sub&gt;)(Al&lt;sub&gt;3&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;)(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;O(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2011-055</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-42352</gsmin:mindatid>
    <gsmin:mindaturl>https://www.mindat.org/min-42352.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(CaCe&lt;sub&gt;3&lt;/sub&gt;)(Al&lt;sub&gt;3&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;)(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;O(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Perbøeite-(Ce)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Perboeite-(Ce)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Bonazzi P, Lepore G O, Bindi L, Chopin C, Husdal T A, Medenbach O (2014) Perbøeite-(Ce) and alnaperbøeite-(Ce), two new members of the epidote-törnebohmite polysomatic series: Chemistry, structure, dehydrogenation, and clue for a sodian epidote end-member. American Mineralogist 99, 157-169</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Gatelite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Transitional_Crust_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al., 2005</dct:source>
    <rdfs:comment xml:lang="en">Crust formed in the transition zone between continental and oceanic crust, during the history of continental rifting that culminates in the formation of a new ocean.</rdfs:comment>
    <rdfs:label xml:lang="en">transitional crustal setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Crustal_Setting"/>
  </rdf:Description>
