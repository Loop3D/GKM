    <gsmin:statusnotes xml:lang="en">The mineral was known before this publication, but under other names: Breithaupt A (1841) Genus 4. Chalcophyllites, Vollständiges Handbuch der Mineralogie 2, 149-150</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Chalcophyllite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DF.30</gsmin:strunzcodeV10>
