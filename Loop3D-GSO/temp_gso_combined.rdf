    <gsmin:rruffnameplain xml:lang="en">Ekatite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Keller P (2001) Ekatite, (Fe^3+^,Fe^2+^,Zn)_12_(OH)_6_[AsO_3_]_6_[AsO_3_,HOSiO_3_]_2_, a new mineral from Tsumeb, Nambia, and its crystal structure, European Journal of Mineralogy 13, 769-777</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Ellenbergerite</gsmin:structuralgroup>
