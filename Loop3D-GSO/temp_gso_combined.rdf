  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Back_Arc_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI Event Environment vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Tectonic setting adjacent to a volcanic arc formed above a subduction zone. The back arc setting is on the opposite side of the volcanic arc from the trench at which oceanic crust is consumed in a subduction zone. Back arc setting includes terrane that is affected by plate margin and arc-related processes.</rdfs:comment>
    <rdfs:label xml:lang="en">back arc setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Tectonic_Setting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/hydrokenoralstonite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Hydrokenoralstonite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Al | F | H | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;F&lt;sub&gt;6&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;F&lt;sub&gt;6&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)</gsmin:rruffchemistry>
    <gsmin:rruffids>R060012</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hydrokenoralstonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hydrokenoralstonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Brush G J (1871) On ralstonite, a new fluoride from Arksut-Fiord, The American Journal of Science and Arts 102, 30-31 Named changed from ralstonite to hydrokenoralstonite, and chemical formula revised from Na_0.5_(Al,Mg)_2_(F,OH)_6_·H_2_O: Atencio D, Andrade M B, Neto A C B, Pereira V P (2017) Ralstonite renamed hydrokenoralstonite, coulsellite renamed fluornatrocoulsellite, and their incorporation into the pyrochlore supergroup. The Canadian Mineralogist 55, 115-120</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Pyrochlore</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n72640d8b1cb14a4485d5865c649679b7b13">
