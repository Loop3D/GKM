    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-800</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:800:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-800.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;[SiO&lt;sub&gt;3&lt;/sub&gt;(OH)]F·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R050088</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bultfonteinite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Bultfonteinite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Parry J, Williams A F, Wright F E (1932) On bultfonteinite, a new fluorine-bearing hydrous calcium silicate from South Africa, Mineralogical Magazine 23, 145-162 Chemical formula revised from Ca&lt;sub&gt;2&lt;/sub&gt;SiO&lt;sub&gt;2&lt;/sub&gt;(OH,F)&lt;sub&gt;4&lt;/sub&gt;: Megaw H D, Kelsey C H (1955) An accurate determination of the cell dimensions of bultfonteinite, Ca&lt;sub&gt;4&lt;/sub&gt;Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;H&lt;sub&gt;6&lt;/sub&gt;F&lt;sub&gt;2&lt;/sub&gt;, Mineralogical Magazine 30, 569-573</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Spurrite-Afwillite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AG.80</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with additional anions; cations in &gt; [6] +- [6] coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Bultfonteinite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1932</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/cordylite-la">
