    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:42356:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-42356.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;&lt;sub&gt;12&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;,Fe&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;3&lt;/sub&gt;Nb&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Th&lt;sup&gt;4+&lt;/sup&gt;(Nb&lt;sup&gt;5+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;12&lt;/sub&gt;O&lt;sub&gt;42&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O,OH)&lt;sub&gt;12&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R130014</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Aspedamite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Aspedamite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Cooper M A, Abdu Y A, Ball N A, Cerný P, Hawthorne F C, Kristiansen R (2012) Aspedamite, ideally [box]&lt;sub&gt;12&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;,Fe&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;3&lt;/sub&gt;Nb&lt;sub&gt;4&lt;/sub&gt;[Th(Nb,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;12&lt;/sub&gt;O&lt;sub&gt;42&lt;/sub&gt;]{(H&lt;sub&gt;2&lt;/sub&gt;O),(OH)}&lt;sub&gt;12&lt;/sub&gt;, a new heteropolyniobate mineral species from the Herrebøkasa Quarry, Aspedammen, Østfold, Southern Norway: description and crystal structure, The Canadian Mineralogist 50, 793-804</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Menezesite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, hydroxide or arsenite</gsmin:strunzlabel>
    <gsmin:wikipediadate>2011-056</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/thomsonite-sr">
