    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NiSe</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Nickel selenide</gsmin:iupacchemname>
    <gsmin:mindatid>min-2732</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2732:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2732.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NiSe</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mäkinenite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Makinenite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Vuorelainen Y, Huhma A, Häkli A (1964) Sederholmite, wilkmanite, kullerudite, mäkinenite, and trüstedtite, five new nickel selenide minerals, Comptes Rendus de la Société Géologique de Finlande 36, 113-125</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Millerite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.CC.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide (M = S) with Ni, Fe, Co, PGE, etc.</gsmin:strunzlabel>
