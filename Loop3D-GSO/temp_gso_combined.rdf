    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">ettringite</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;3&lt;/sub&gt;(Si,Fe&lt;sup&gt;3+&lt;/sup&gt;,Al)(SO&lt;sub&gt;4&lt;/sub&gt;)B(OH)&lt;sub&gt;4&lt;/sub&gt;(OH,O)&lt;sub&gt;6&lt;/sub&gt;·12H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
