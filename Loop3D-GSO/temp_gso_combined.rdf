    <gsmin:statusnotes xml:lang="en">Pekov I V, Chukanov N V, Yapaskurt V O, Belakovskiy D I, Lykova I S, Zubkova N V, Shcherbakova E P, Britvin S N, Chervonnyi A D (2016) Tinnunculite, C_5_H_4_N_4_O_3_·2H_2_O: finds at Kola Peninsula, redefinition and validation as a mineral species. Zapiski Rossiiskogo Mineralogicheskogo Obshchetstva 145(4), 20-35</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/hallimondite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
