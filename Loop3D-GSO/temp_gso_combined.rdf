    <gsmin:strunzcodeV10>08.BE.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With only medium-sized cations, (OH, etc.):RO4 &gt; 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Gerdtremmelite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1983-049a</gsmin:wikipediadate>
