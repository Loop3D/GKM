    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K(UO&lt;sub&gt;2&lt;/sub&gt;)(PO&lt;sub&gt;4&lt;/sub&gt;)·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1963-013</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Potassium uranyl phosphate trihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2661</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2661:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2661.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K(UO&lt;sub&gt;2&lt;/sub&gt;)(PO&lt;sub&gt;4&lt;/sub&gt;)·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Meta-ankoleite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Meta-ankoleite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Gallagher M J, Atkin D (1966) Meta-ankoleïte, hydrated potassium uranyl phosphate, Bulletin of the Geological Survey of Great Britain 25, 49-54</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Natroautunite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.EB.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl phosphate or arsenate, UO2:RO4 = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Meta-ankoleite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1963-013</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/phosphoellenbergerite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Phosphoellenbergerite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mg | P | O | H | C</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/phosphoellenbergerite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Mg,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)&lt;sub&gt;2&lt;/sub&gt;Mg&lt;sub&gt;12&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;,PO&lt;sub&gt;3&lt;/sub&gt;OH)&lt;sub&gt;6&lt;/sub&gt;(PO&lt;sub&gt;3&lt;/sub&gt;OH,CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1994-006</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-7232</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7232:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7232.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Mg,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)&lt;sub&gt;2&lt;/sub&gt;Mg&lt;sub&gt;12&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;,PO&lt;sub&gt;3&lt;/sub&gt;OH)&lt;sub&gt;6&lt;/sub&gt;(PO&lt;sub&gt;3&lt;/sub&gt;OH,CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Phosphoellenbergerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Phosphoellenbergerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Raade G, Rømming C, Medenbach O (1998) Carbonate-substituted phosphoellenbergerite from Modum, Norway: description and crystal structure, Mineralogy and Petrology 62, 89-101</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Ellenbergerite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BB.55</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With only medium-sized cations, (OH, etc.):RO4 about 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Phosphoellenbergerite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1994-006</gsmin:wikipediadate>
  </rdf:Description>
