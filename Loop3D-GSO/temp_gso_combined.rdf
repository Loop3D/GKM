    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ag&lt;sup&gt;1+&lt;/sup&gt;I&lt;sup&gt;1-&lt;/sup&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R110034 | R110170</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Miersite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Miersite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Spencer L J (1898) Miersite, a cubic modification of native silver iodide, Nature 57, 574-574</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Sphalerite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>03.AA.05</gsmin:strunzcodeV10>
