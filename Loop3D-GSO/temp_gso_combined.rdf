  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/quenstedtite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Quenstedtite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Fe | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/quenstedtite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;·11H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: IronIII sulfate decahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-3341</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3341:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3341.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;·11H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Quenstedtite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Quenstedtite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Linck G (1888) Ueber einige aus Chile stammende sulfate, Neues Jahrbuch für Mineralogie, Geologie und Palaontologie 1888, 213-213</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.CB.65</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, with H2O, With only medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Quenstedtite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1888</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/fluor-liddicoatite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Fluor-liddicoatite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Li | Al | Si | O | B | H | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">tourmaline</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/liddicoatite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca(Li&lt;sub&gt;2&lt;/sub&gt;Al)Al&lt;sub&gt;6&lt;/sub&gt;(Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;)(BO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;F</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1976-041</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:mindatid>min-41296</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:41296:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-41296.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca(Li&lt;sub&gt;2&lt;/sub&gt;Al)Al&lt;sub&gt;6&lt;/sub&gt;(Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;)(BO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;F</gsmin:rruffchemistry>
    <gsmin:rruffids>R060635 | R060969</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fluor-liddicoatite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Fluor-liddicoatite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Dunn P J, Appleman D E, Nelen J E (1977) Liddicoatite, a new calcium end-member of the tourmaline group, American Mineralogist 62, 1121-1124 Name changed from liddicoatite, and chemical formula modified: Henry D J, Novák M, Hawthorne F C, Ertl A, Dutrow B L, Uher P, Pezzotta F (2011) Nomenclature of the tourmaline-supergroup minerals, American Mineralogist 96, 895-913</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Tourmaline</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CK.05</gsmin:strunzcodeV10>
