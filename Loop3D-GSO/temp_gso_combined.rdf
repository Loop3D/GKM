    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaAlZr&lt;sup&gt;4+&lt;/sup&gt;(P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Wycheproofite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Wycheproofite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Birch W D, Pring A, Bevan D J M, Kharisun (1994) Wycheproofite: a new hydrated sodium aluminium zirconium phosphate from Wycheproof, Victoria, Australia, and a new occurence of kosnarite, Mineralogical Magazine 58, 635-639</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.DJ.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 = 1:1</gsmin:strunzlabel>
