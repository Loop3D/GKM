    <gsmin:rruffnameplain xml:lang="en">Davidite-(Ce)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Ce-rich mineral described but not named: Neumann H, Sverdrup T L (1960) Davidite from Tuftan, Iveland. Norsk Geologisk Tidsskrift 40, 277-288 Ce-rich mineral is named: Levinson A A (1966) A system of nomenclature for rare-earth minerals, American Mineralogist 51, 152-158</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Crichtonite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/norrishite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Norrishite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
