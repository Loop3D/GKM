    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2214:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2214.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">PbFe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)(PO&lt;sub&gt;3&lt;/sub&gt;OH)(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kintoreite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kintoreite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pring A, Birch W D, Dawe J, Taylor M, Deliens M, Walenta K (1995) Kintoreite, PbFe_3_(PO_4_)_2_(OH,H_2_O)_6_, a new mineral of the jarosite-alunite family, and lusungite discredited, Mineralogical Magazine 59, 143-148</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Alunite-crandallite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BL.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH, etc.):RO4 = 3:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Kintoreite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1992-045</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/blatterite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
