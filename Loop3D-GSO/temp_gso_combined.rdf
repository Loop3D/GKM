  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/indite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Indite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Fe | In | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">linnaeite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/indite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">FeIn&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Iron diindium tetrasulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-2029</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2029:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2029.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;In&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Indite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Indite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Genkin A D, Murav'eva I V (1963) Indite and dzhalindite, new indium minerals, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 92(4), 445-457</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Spinel</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.DA.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide (M:S = 3:4)</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Indite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1963</gsmin:wikipediadate>
