  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/folvikite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Folvikite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Sb | Mn | Mg | O | B</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sb&lt;sup&gt;5+&lt;/sup&gt;Mn&lt;sup&gt;3+&lt;/sup&gt;(Mg,Mn&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;10&lt;/sub&gt;O&lt;sub&gt;8&lt;/sub&gt;(BO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
