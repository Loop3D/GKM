    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;4&lt;/sub&gt;[Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;]O&lt;sub&gt;4&lt;/sub&gt;[Si&lt;sub&gt;8&lt;/sub&gt;Be&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;36&lt;/sub&gt;]</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1990-051</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1917</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1917:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1917.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;4&lt;/sub&gt;(Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;)O&lt;sub&gt;4&lt;/sub&gt;[Si&lt;sub&gt;8&lt;/sub&gt;Be&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;36&lt;/sub&gt;]</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Høgtuvaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hogtuvaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Grauch R I, Lindahl I, Evans H T, Burt D M, Fitzpatrick J J, Foord E E, Graff P, Hysingjord J (1994) Høgtuvaite, a new beryllian member of the aenigmatite group from Norway, with new X-ray data on aenigmatite, The Canadian Mineralogist 32, 439-448 Chemical formula revised: Grew E S, Hålenius U, Pasero M, Barbier J (2008) Recommended nomenclature for the sapphirine and surinamite group (sapphirine supergroup), Mineralogical Magazine 72, 839-876</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Sapphirine</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DH.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 4-periodic single chains, Si4O12</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Hogtuvaite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1990-051</gsmin:wikipediadate>
  </rdf:Description>
