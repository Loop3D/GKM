  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/phyllic_altered_rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">https://en.wikipedia.org/wiki/Phyllic_alteration</dct:source>
    <rdfs:comment xml:lang="en">Altered rock characterised by the assemblage of quartz + sericite + pyrite, and occurs at high temperatures and moderately acidic (low pH) conditions. Typically associated with copper porphyry ore deposits in calc-alkaline rocks.</rdfs:comment>
    <rdfs:label xml:lang="en">phyllic altered rock</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/altered_rock"/>
  </rdf:Description>
