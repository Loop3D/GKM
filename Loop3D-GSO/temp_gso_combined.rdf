    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1351:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1351.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaCa&lt;sub&gt;2&lt;/sub&gt;Mg&lt;sub&gt;5&lt;/sub&gt;(Si&lt;sub&gt;7&lt;/sub&gt;Al)O&lt;sub&gt;22&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050415 | R060029</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Edenite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Edenite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Glocker E F (1839) IX. Amphibolite 5. Edenische hornblende oder edenit, in Grundriss der Mineralogie mit Einschluss der Geognosie und Petrefactenkunde, Verlag von Johann Leonhard Schrag (Nürnberg) 410-410</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Amphibole</gsmin:structuralgroup>
