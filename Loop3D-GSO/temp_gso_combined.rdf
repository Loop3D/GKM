    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/mineral/biotite"/>
    <gsmin:chemistryelements>K | Fe | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic, hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">mica-true micas</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KFe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(Si&lt;sub&gt;3&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;)O&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:mindatid>min-7333</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7333:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7333.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KFe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(Si&lt;sub&gt;3&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;)O&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tetraferriannite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tetraferriannite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Wahl W (1925) Die Gesteine des Wiborger Rapakiwigebietes, Fennia 45, 83-88 Name changed from monrepite: Rieder M, Cavazzini G, D’Yakonov Y S, Frank-Kamenetskii V A, Gottardt G, Guggenheim S, Koval P V, Muller G, Neiva A M R, Radoslovich E W, Robert J L, Sassi F P, Takeda H, Weiss Z, Wones D R (1998) Nomenclature of the micas, The Canadian Mineralogist 36, 905-912 Name changed from tetra-ferri-annite: Burke E A J (2008) Tidying up mineral names: an IMA-CNMNC scheme for suffixes, hyphens and diacritical marks, The Mineralogical Record 39, 131-135</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Mica</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EC.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with mica sheets, composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Tetraferriannite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1925</gsmin:wikipediadate>
  </rdf:Description>
