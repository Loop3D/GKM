    <gsmin:chemistryelements>Mg | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">chalcanthite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/pentahydrite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg(SO&lt;sub&gt;4&lt;/sub&gt;)·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Magnesium sulfate pentahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-3153</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3153:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3153.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">MgS&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060990 | R070069 | R100022</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pentahydrite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Pentahydrite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Palache C, Berman H, Frondel C (1951) 29.6.5.3 Pentahydrite [MgSO_4_·5H_2_O], in The System of Mineralogy, Volume II, Seventh Edition, John Wiley and Sons, Inc (New York) 492-493</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Chalcanthite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.CB.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, with H2O, With only medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Pentahydrite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1951</gsmin:wikipediadate>
