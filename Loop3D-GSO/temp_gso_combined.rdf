  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/dellagiustaite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Dellagiustaite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>V | Al | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">V&lt;sup&gt;2+&lt;/sup&gt;Al&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2017-101</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">V&lt;sup&gt;2+&lt;/sup&gt;Al&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Dellagiustaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Dellagiustaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Cámara F, Bindi L, Pagano A, Pagano R, Gain S E M, Griffin W L (2019) Dellagiustaite: A novel natural spinel containing V^2+^. Minerals 9, 4</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Spinel</gsmin:structuralgroup>
  </rdf:Description>
