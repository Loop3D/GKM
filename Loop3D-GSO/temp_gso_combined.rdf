    <gsmin:strunzcodeV10>05.BD.20a</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions, without H2O, With rare earth elements (REE)</gsmin:strunzlabel>
