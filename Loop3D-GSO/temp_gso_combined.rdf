    <gsmin:statusnotes xml:lang="en">Mills S J, Kampf A R, Sejkora J, Adams P M, Birch W D, Plášil J (2011) Iangreyite: a new secondary phosphate mineral closely related to perhamite, Mineralogical Magazine 75, 327-336</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.DE.45</gsmin:strunzcodeV10>
