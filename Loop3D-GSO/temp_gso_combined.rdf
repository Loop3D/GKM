    <gsmin:mindaturl>http://www.mindat.org/min-4302.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;Sn&lt;sup&gt;4+&lt;/sup&gt;Ta&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;8&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R130047</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Wodginite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Wodginite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Nickel E H, Rowland J F, McAdam R C (1963) Wodginite - A new tin-manganese tantalate from Wodgina, Australia and Bernic lake, Manitoba, The Canadian Mineralogist 7, 390-402</gsmin:statusnotes>
