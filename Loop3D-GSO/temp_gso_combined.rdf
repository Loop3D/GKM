    <gsmin:mindaturl>http://www.mindat.org/min-29549.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;0.7&lt;/sub&gt;(W,Fe&lt;sup&gt;3+&lt;/sup&gt;)(O,OH)&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
