    <gsmin:imanumber xml:lang="en">IMA1998-033</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dizinc aluminium antimony dodecahydroxide</gsmin:iupacchemname>
