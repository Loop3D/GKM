    <gsmin:imanumber xml:lang="en">IMA2008-020</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Bismuth sulfide chloride</gsmin:iupacchemname>
    <gsmin:mindatid>min-38694</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:38694:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-38694.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BiSCl</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Demicheleite-(Cl)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Demicheleite-(Cl)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Demartin F, Gramaccioli C M, Campostrini I (2009) Demicheleite-(Cl), BiSCl, a new mineral from La Fossa crater, Vulcano, Aeolian Islands, Italy, American Mineralogist 94, 1045-1048</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Demicheleite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.FC.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Other sulfide with Cl, Br, I (halide-sulfides)</gsmin:strunzlabel>
