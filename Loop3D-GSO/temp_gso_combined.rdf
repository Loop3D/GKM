    <gsmin:rruffnameplain xml:lang="en">Mapiquiroite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Biagioni C, Orlandi P, Pasero M, Nestola F, Bindi L (2014) Mapiquiroite, (Sr,Pb)(U,Y)Fe_2_(Ti,Fe^3+^)_18_O_38_, a new member of the crichtonite group from the Apuan Alps, Tuscany, Italy. European Journal of Mineralogy 26, 427-437</gsmin:statusnotes>
