    <gsmin:chemistryelements>Sb</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal, cubic, tetragonal, rhombohedral</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">arsenic</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/antimony.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sb</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-262</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:262:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-262.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sb</gsmin:rruffchemistry>
    <gsmin:rruffids>R050654 | R070318</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Antimony</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Antimony</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Swab A (1748) Berattelse om en nativ regulus antimonii, eller spets glas-kung, Kong. Svenska Vetenskaps-Akademiens Handlingar 9, 99-106</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Arsenic</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>01.CA.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Arsenic group element</gsmin:strunzlabel>
