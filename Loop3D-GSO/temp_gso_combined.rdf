  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/epsomite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Epsomite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mg | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">epsomite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/epsomite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg(SO&lt;sub&gt;4&lt;/sub&gt;)·7H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Magnesium sulfate heptahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1393</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1393:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1393.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">MgS&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;·7H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R150060</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Epsomite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Epsomite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">The mineral was previously known, but was named epsonite in this paper: Delamétherie J C (1806) Tableau des analyses chimiques des minéraux, et d'une nouvelle classification de ces substances, fondée sur ces analyses, Journal de Physique, de Chimie et d´Histoire Naturelle 62, 319-365; 376-405</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Epsomite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.CB.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, with H2O, With only medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Epsomite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1721</gsmin:wikipediadate>
  </rdf:Description>
