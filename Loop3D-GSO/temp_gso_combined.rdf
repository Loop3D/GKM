    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nicksobolevite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Nicksobolevite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Vergasova L P, Semenova T F, Krivovichev S V, Filatov S K, Zolotarev A A, Ananiev V V (2014) Nicksobolevite, Cu_7_(SeO_3_)_2_O_2_Cl_6_, a new complex copper oxoselenite chloride from Tolbachik fumaroles, Kamchatka peninsula, Russia. European Journal of Mineralogy 26, 439-449</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/liebenbergite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
