    <gsmin:chemistryelements>Pt | Sb</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/genkinite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pt&lt;sub&gt;4&lt;/sub&gt;Sb&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1976-051</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Tetraplatinum triantimonide</gsmin:iupacchemname>
    <gsmin:mindatid>min-1672</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1672:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1672.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pt&lt;sub&gt;4&lt;/sub&gt;Sb&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Genkinite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Genkinite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Cabri L J, Stewart J M, Laflamme J H G, Szymanski J T (1977) Platinum-group minerals from Onverwacht. III. Genkinite, (Pt,Pd)_4_Sb_3_, a new mineral, The Canadian Mineralogist 15, 389-392</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.AC.35a</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfide or sulfosalt alloy of metalloids with PGE</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Genkinite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1976-051</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/niigataite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Niigataite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Sr | Al | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">epidote</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaSrAl&lt;sub&gt;3&lt;/sub&gt;[Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;][SiO&lt;sub&gt;4&lt;/sub&gt;]O(OH)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2001-055</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Renamed|Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaSrAl&lt;sub&gt;3&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)(SiO&lt;sub&gt;4&lt;/sub&gt;)O(OH)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Niigataite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Niigataite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Miyajima H, Matsubara S, Miyawaki R, Hirokawa K (2003) Niigataite, CaSrAl&lt;sub&gt;3&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)(SiO&lt;sub&gt;4&lt;/sub&gt;)O(OH): Sr-analogue of clinozoisite, a new member of the epidote group from the Itoigawa-Ohmi district, Niigata Prefecture, central Japan, Journal of Mineralogical and Petrological Sciences 98, 118-129 Name changed from niigataite to clinozoisite-(Sr): Armbruster T, Bonazzi P, Akasaka M, Bermanec V, Chopin C, Giere R, Huess-Assbichler S, Liebscher A, Menchetti S, Pan Y, Pasero M (2006) Recommended nomeclature of epidote-group minerals, European Journal of Mineralogy 18, 551-567 Name changed back to niigataite: Revheim O, King V T (2016) Epidote supergroup nomenclature: The names hancockite, niigataite and tweddillite reinstated. Mineralogical Magazine 80, 877-880</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Epidote</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/stoiberite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Stoiberite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | O | V</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/stoiberite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;5&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(VO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1979-016</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Pentacopper dioxy divanadate</gsmin:iupacchemname>
    <gsmin:mindatid>min-3792</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3792:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3792.html</gsmin:mindaturl>
