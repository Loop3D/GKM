    <gsmin:imanumber xml:lang="en">IMA1991-019</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1542</gsmin:mindatid>
