  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/tinsleyite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Tinsleyite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Al | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">leucophosphite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/tinsleyite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KAl&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1983-004</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Potassium dialuminium diphosphate hydroxyl dihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-3969</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3969:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3969.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KAl&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070706</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tinsleyite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tinsleyite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Dunn P J, Rouse R C, Campbell T J, Roberts W L (1984) Tinsleyite, the aluminum analogue of leucophosphite, from the Tip Top pegmatite in South Dakota, American Mineralogist 69, 374-376</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.DH.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 &lt; 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Tinsleyite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1983-004</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/cupropolybasite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cupropolybasite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Sb | S | Ag</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">[Cu&lt;sub&gt;6&lt;/sub&gt;Sb&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;7&lt;/sub&gt;][Ag&lt;sub&gt;9&lt;/sub&gt;CuS&lt;sub&gt;4&lt;/sub&gt;]</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2008-004</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-35952</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:35952:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-35952.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">[Cu&lt;sub&gt;6&lt;/sub&gt;Sb&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;7&lt;/sub&gt;][Ag&lt;sub&gt;9&lt;/sub&gt;CuS&lt;sub&gt;4&lt;/sub&gt;]</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cupropolybasite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cupropolybasite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Bindi L, Evain M, Spry P G, Tait K T, Menchetti S (2007) Structural role of copper in the minerals of the pearceite-polybasite group: the case of the new minerals cupropearcite and cupropolybasite, Mineralogical Magazine 71, 641-650</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Polybasite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.GB.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Neso-sulfarsenite with additional S</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://webmineral.com/data/Cupropolybasite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2008-004</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseAlbianSP2016">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologiccontact/GSSP"/>
    <rdfs:comment xml:lang="en">The lowest occurrence of the planktonic foraminifer Microhedbergella renilaevis, which is 37.4 m above the base of the section and 0.4 m above the base of the laminated Niveau Kilian bed, Col de Pré-Guittard section lies 11 km northwest of Rémuzat and 19 km northwest of Rosans in the Départment of Drôme at 44 29′ 47.78″N, 5 18′ 42.36″E (Lambert coordinates 836,42;3248, 95; 1;25,000 topographic sheet Série Bleu 3138E, La Motte-Chalançon), Southeastern France</rdfs:comment>
    <rdfs:comment xml:lang="en">dc:source -- Kennedy, W.J., A.S. Gale, B.T. Huber, M.R. Petrizzo, P. Bown, H.C. Jenkyns (2017). The Global Boundary Stratotype Section and Point (GSSP) for the base of the Albian Stage, of the Cretaceous, the Col de Pré-Guittard section, Arnayon, Drôme, France. Episodes: 40, 177-188.</rdfs:comment>
    <rdfs:label xml:lang="en">GSSP Base of Albian</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://cretaceous.stratigraphy.org/gssps/gssp-of-albian-stage/"/>
    <rdfs:seeAlso rdf:resource="https://stratigraphy.org/gssps/"/>
    <owl:versionInfo>2016-04</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/akdalaite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Akdalaite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Al | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal, orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/akdalaite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Al&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;5&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1969-002</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-69</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:69:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-69.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Al&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;5&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Akdalaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Akdalaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Shpanov E P, Sidorenko G A, Stolyarova T I (1970) Akdalaite, a new hydrous modification of alumina, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 99, 333-339</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.FL.70</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Hydroxide (without V or U), Hydroxides with H2O±(OH); sheets of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Akdalaite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1969-002</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Grainstone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Dunham 1962</dct:source>
    <rdfs:comment xml:lang="en">Carbonate sedimentary rock with recognizable depositional fabric that is grain-supported, and constituent particles are of intrabasinal origin; contains little or no mud matrix. Distinction from sandstone is based on interpretation of intrabasinal origin of clasts and grain-supported fabric, but grainstone definition does not include a grain size criteria.</rdfs:comment>
    <rdfs:label xml:lang="en">grainstone</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Carbonate_Sedimentary_Rock"/>
    <skos:altLabel xml:lang="en">carbonate grainstone</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kampfite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kampfite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ba | Si | Al | O | C | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba&lt;sub&gt;12&lt;/sub&gt;(Si&lt;sub&gt;11&lt;/sub&gt;Al&lt;sub&gt;5&lt;/sub&gt;)O&lt;sub&gt;31&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;8&lt;/sub&gt;Cl&lt;sub&gt;5&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2000-003</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-10386</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:10386:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-10386.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba&lt;sub&gt;12&lt;/sub&gt;(Si&lt;sub&gt;11&lt;/sub&gt;Al&lt;sub&gt;5&lt;/sub&gt;)O&lt;sub&gt;31&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;8&lt;/sub&gt;Cl&lt;sub&gt;5&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kampfite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kampfite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Basciano L C, Groat L A, Roberts A C, Grice J D, Dunning G E, Foord E E, Kjarsgaard I M, Walstrom R E (2001) Kampfite, a new barium silicate carbonate mineral species from Fresno County, California, The Canadian Mineralogist 39, 1053-1058 Chemical formula changed from Ba_6_[(Si,Al)O_2_]_8_(CO_3_)_2_Cl_2_(Cl,H_2_O)_2_: Basciano L C, Groat L A (2007) The crystal structure of kampfite, The Canadian Mineralogist 45, 935-943</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.EG.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate: Double nets with 6-membered and larger rings</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Kampfite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2000-003</gsmin:wikipediadate>
