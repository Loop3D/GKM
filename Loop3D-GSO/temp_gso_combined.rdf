    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:39973:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-39973.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;3&lt;/sub&gt;Y(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R141187</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Lecoqite-(Y)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Lecoqite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pekov I V, Chukanov N V, Zubkova N V, Ksenofontov D A, Horváth L, Zadov A E, Pushcharovsky D Y (2010) Lecoqite-(Y), Na_3_Y(CO_3_)_3_·6H_2_O, a new mineral species from Mont Saint-Hilaire, Quebec, Canada, The Canadian Mineralogist 48, 95-104</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate or nitrate</gsmin:strunzlabel>
    <gsmin:wikipediadate>2008-069</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/babefphite">
