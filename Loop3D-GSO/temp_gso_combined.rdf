    <gsmin:chemistryelements>Cu | Mg | C | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">rosasite</gsmin:fleischersgroup>
