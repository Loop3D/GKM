    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4032:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4032.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ni&lt;sup&gt;2+&lt;/sup&gt;Ni&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Se&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
