    <gsmin:mindatid>min-4435</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4435:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4435.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pd&lt;sub&gt;3&lt;/sub&gt;Pb</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zvyagintsevite</gsmin:rruffnamehtml>
