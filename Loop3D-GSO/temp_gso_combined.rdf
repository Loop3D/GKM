    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Crawfordite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Crawfordite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Khomjakov A P, Polezhaeva L I, Sokolova E V (1994) Crawfordite Na&lt;sub&gt;3&lt;/sub&gt;Sr(PO&lt;sub&gt;4&lt;/sub&gt;)(CO&lt;sub&gt;3&lt;/sub&gt;) - a new mineral from the bradleyite family, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 123(3), 107-111</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Bradleyite</gsmin:structuralgroup>
