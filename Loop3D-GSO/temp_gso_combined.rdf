  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/incipient_consolidation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">NADM sedimentary rock vocabulary NADM sedimentary rock vocabulary (https://pubs.usgs.gov/of/2004/1451/sltt/appendixC/appendixC_pdf.zip)  SLTTs 2004,  after Bowles 1986</dct:source>
    <rdfs:comment xml:lang="en">Shoveled with difficulty, relative density 0.4 - 0.7.</rdfs:comment>
    <rdfs:label xml:lang="en">incipient consolidation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/unconsolidated"/>
  </rdf:Description>
