    <gsmin:chemistryelements>Cu | Fe | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/putoranite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;1.1&lt;/sub&gt;Fe&lt;sub&gt;1.2&lt;/sub&gt;S&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1979-054</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3312</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3312:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3312.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;1.1&lt;/sub&gt;Fe&lt;sub&gt;1.2&lt;/sub&gt;S&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Putoranite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Putoranite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Filimonova A A, Evstigneeva T L, Laputina I P (1980) Putoranite and nickel-bearing putoranite, new minerals of the chalcopyrite group, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 109, issue 3, 335-341 Fleischer M, Cabri L J (1981) New mineral names, American Mineralogist 66, 637-639</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Chalcopyrite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.CB.10b</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide (M = S) with Zn, Fe, Cu, Ag, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Putoranite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1979-054</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Quartz_Rich_Igneous_Rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Gillespie and Styles 1999; LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Occurrence of igneous rocks meeting this criteria seems to be vanishingly rare, thus subdividing the category does not seem warranted for the purposes of This vocabulary. Future usage of the vocabulary may motivate including quatzolite and quartz-rich granitoid in future revisions</rdfs:comment>
    <rdfs:comment xml:lang="en">Phaneritic crystalline igneous rock that contains less than 90 percent mafic minerals and contains greater than 60 percent quartz in the QAPF fraction.</rdfs:comment>
    <rdfs:label xml:lang="en">quartz rich igneous rock</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Acidic_Igneous_Rock"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Phaneritic_Igneous_Rock"/>
  </rdf:Description>
