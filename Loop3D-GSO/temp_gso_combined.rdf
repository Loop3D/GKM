    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2875:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2875.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaMn&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;8&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)</gsmin:rruffchemistry>
    <gsmin:rruffids>R060726</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Neltnerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Neltnerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Baudracco-Gritti C, Caye R, Permingeat F, Protas J (1982) La neltnérite CaMn_6_SiO_12_, une nouvelle espèce minérale du groupe de la braunite, Bulletin de Minéralogie 105, 161-165</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Braunite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AG.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with additional anions; cations in &gt; [6] +- [6] coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Neltnerite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1979-059</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ershovite">
