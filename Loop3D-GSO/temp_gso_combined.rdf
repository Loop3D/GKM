  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/huangite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Huangite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Al | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">alunite-jarosite-alunite subgroup</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/huangite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;0.5&lt;/sub&gt;Al&lt;sub&gt;3&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1991-009</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1939</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1939:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1939.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;0.5&lt;/sub&gt;Al&lt;sub&gt;3&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Huangite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Huangite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Li G, Peacor D R, Essene E J, Brosnahan D R, Beane R E (1992) Walthierite, Ba_0.5_[box]_0.5_Al_3_(SO_4_)_2_(OH)_6_, and huangite, Ca_0.5_[box]_0.5_Al_3_(SO_4_)_2_(OH)_6_, two new minerals of the alunite group from the Coquimbo region, Chile, American Mineralogist 77, 1275-1284</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Alunite-Alunite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.BC.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions, without H2O, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Huangite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1991-009</gsmin:wikipediadate>
  </rdf:Description>
