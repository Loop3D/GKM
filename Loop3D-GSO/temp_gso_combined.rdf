  <rdf:Description rdf:about="https://w3id.org/gso/1.0/granularmaterial/Fluidal_Pyroclastic_Particle_Material">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Base on Gillespie and Styles, 1999</dct:source>
    <rdfs:comment xml:lang="en">Granular material consisting of particles that have a rounded, fluidal shape indicating that they were in a wholly or partly molten state during formation and subsequent transport. Concept corresponds to bomb, but with no size denotation.</rdfs:comment>
    <rdfs:label xml:lang="en">fluidal pyroclastic particle material</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/granularmaterial/Juvenile_Pyroclastic_Particle_Material"/>
  </rdf:Description>
