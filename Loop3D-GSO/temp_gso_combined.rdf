    <gsmin:mindaturl>http://www.mindat.org/min-2867.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(V&lt;sup&gt;5+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;10&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;·12H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Navajoite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Navajoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Weeks A D, Thompson M E, Sherwood A M (1954) Navajoite, a new vanadium oxide from Arizona, Science 119, 326-326</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Ajoite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.HG.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">V oxide, unclassified</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Navajoite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1954</gsmin:wikipediadate>
