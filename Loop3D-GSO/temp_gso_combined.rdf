    <gsmin:rruffnameplain xml:lang="en">Stronadelphite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pekov I V, Britvin S N, Zubkova N V, Pushcharovsky D Y, Pasero M, Merlino S (2010) Stronadelphite, Sr_5_(PO_4_)_3_F, a new apatite-group mineral, European Journal of Mineralogy 22, 869-874</gsmin:statusnotes>
