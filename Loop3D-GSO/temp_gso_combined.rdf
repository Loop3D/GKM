  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/paraberzeliite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Paraberzeliite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Mg | As | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaCa&lt;sub&gt;2&lt;/sub&gt;Mg&lt;sub&gt;2&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2018-001</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Pending publication</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaCa&lt;sub&gt;2&lt;/sub&gt;Mg&lt;sub&gt;2&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Paraberzeliite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Paraberzeliite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pekov, I.V., Koshlyakova, N.N., Belakovskiy, D.I., Vigasina, M.F., Zubkova, N.V., Agakhanov, A.A., Britvin, S.N., Sidorov, E.G. and Pushcharovsky, D.Y. (2018) Paraberzeliite, IMA2018-001. CNMNC Newsletter No 43, June 2018, page 780; Mineralogical Magazine, 82, 779–785</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Alluaudite</gsmin:structuralgroup>
  </rdf:Description>
