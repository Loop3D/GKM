    <rdfs:label xml:lang="en">Philrothite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Tl | As | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">TlAs&lt;sub&gt;3&lt;/sub&gt;S&lt;sub&gt;5&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2013-066</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">TlAs&lt;sub&gt;3&lt;/sub&gt;S&lt;sub&gt;5&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Philrothite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Philrothite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Bindi L, Nestola F, Makovicky E, Guastoni A, De Battisti L (2014) Tl-bearing sulfosalt from the Lengenbach quarry, Binn Valley, Switzerland: Philrothite, TlAs_3_S_5_. Mineralogical Magazine 78, 1-9</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Sartorite</gsmin:structuralgroup>
  </rdf:Description>
