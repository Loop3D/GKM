  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/pezzottaite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Pezzottaite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cs | Li | Be | Al | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CsLiBe&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2003-022</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-25652</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:25652:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-25652.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CsLiBe&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060583</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pezzottaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Pezzottaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Laurs B M, Simmons W B, Rossman G R, Quinn E P, McClure S F, Peretti A, Armbruster T, Hawthorne F C, Falster A U, Günther D, Cooper M A, Grobéty (2003) Pezzottaite from Ambatovita, Madagascar: a new gem mineral, Gems &amp; Gemology 39, 284-301</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Beryl</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CJ.60</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si6O18]12- 6-membered single rings (sechser-Einfachringe), without insular complex anions</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Pezzottaite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2003-022</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ferri-obertiite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ferri-obertiite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Mg | Fe | Ti | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaNa&lt;sub&gt;2&lt;/sub&gt;(Mg&lt;sub&gt;3&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;Ti)Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2015-079</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaNa&lt;sub&gt;2&lt;/sub&gt;(Mg&lt;sub&gt;3&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;)Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ferri-obertiite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ferri-obertiite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Oberti R, Boiocchi M, Hawthorne F C, Ball N A, Blass G (2017) Ferri-obertiite from the Rothenberg quarry, Eifel volcanic complex, Germany: Mineral data and crystal chemistry of a new amphibole end-member. Mineralogical Magazine 81, 641-651</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Amphibole</gsmin:structuralgroup>
  </rdf:Description>
