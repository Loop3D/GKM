    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">SiO&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Silicon dioxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-1104</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1104:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1104.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">SiO&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070565</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Coesite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Coesite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">The silica polymorph is named: Sosman R B (1954) New high-pressure phases of silica, Science 119, 738-739 The mineral is found in nature: Chao E C T, Shoemaker E M, Madsen B M (1960) First natural occurrence of coesite, Science 132, 220-222</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.DA.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With small cations: Silica family</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Coesite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1954</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/vendidaite">
