    <gsmin:mindaturl>http://www.mindat.org/min-488.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;Al(Si&lt;sub&gt;3&lt;/sub&gt;Al)O&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;8&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Baileychlore</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Baileychlore</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Rule A C, Radke F (1988) Baileychlore, the Zn end member of the trioctahedral chlorite series, American Mineralogist 73, 135-139</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Clay</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EC.55</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with mica sheets, composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Baileychlore.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1986-056</gsmin:wikipediadate>
