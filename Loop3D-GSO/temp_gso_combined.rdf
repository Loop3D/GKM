    <gsmin:mindaturl>http://www.mindat.org/min-41604.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ag&lt;sup&gt;1+&lt;/sup&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;As&lt;sup&gt;3+&lt;/sup&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
