  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/fornacite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Fornacite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Pb | Cr | O | As | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/fornacite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CuPb&lt;sub&gt;2&lt;/sub&gt;(CrO&lt;sub&gt;4&lt;/sub&gt;)(AsO&lt;sub&gt;4&lt;/sub&gt;)(OH)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Copper dilead chromate arsenate hydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-1583</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1583:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1583.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(Cr&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)(OH)</gsmin:rruffchemistry>
    <gsmin:rruffids>R060932 | R060986</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fornacite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Fornacite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Lacroix A (1915) Note préliminaire sur une novelle espèce minérale (furnacite), provenant du Moyen Congo (Afrique equatoriale française), Bulletin de la Société Française de Minéralogie 38, 198-200 Mineral name changed from furnacite to fornacite: Lacroix A (1916) Erratum concernant une nouvelle espèce minérale du Congo, Bulletin de la Société Française de Minéralogie 39, 84-84</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Fornacite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.FC.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Chromate, With PO4, AsO4, SiO4</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Fornacite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1915</gsmin:wikipediadate>
