    <gsmin:rruffnameplain xml:lang="en">Scottyite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Yang H, Downs R T, Evans S H, Pinch W W (2013) Scottyite, the natural analog of synthetic BaCu_2_Si_2_O_7_, a new mineral from the Wessels mine, Kalahari Manganese Fields, South Africa, American Mineralogist 98, 478-484</gsmin:statusnotes>
