  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/thorite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Thorite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Th | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">zircon</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/thorite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Th(SiO&lt;sub&gt;4&lt;/sub&gt;)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Thorium nesosilicate</gsmin:iupacchemname>
    <gsmin:mindatid>min-3946</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3946:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3946.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">ThSiO&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Thorite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Thorite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named thorina: Gahn J G, Berzelius J, Wallman C, Eggertz H P (1817) Examination of some minerals found in the neighbourhood of Fahlun, and of their situation, Annals of Philosophy 9, 452-460</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Zircon</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AD.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate without additional anions; cations in [6] and/or greater coordination</gsmin:strunzlabel>
