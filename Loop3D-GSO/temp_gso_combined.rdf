    <gsmin:imanumber xml:lang="en">IMA1963-010</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Copper sulfate monohydrate</gsmin:iupacchemname>
