  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/claudetite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Claudetite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>As | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/claudetite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">As&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Diarsenic trioxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-1060</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1060:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1060.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">As&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050313</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Claudetite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Claudetite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Dana J D, Brush G J (1868) Claudetite, in A System of Mineralogy, Fifth Edition, John Wiley and Sons (New York) 796-796</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Claudetite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.CB.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 2: 3,3: 5, and similar, With medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Claudetite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1868</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/walpurgite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Walpurgite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Bi | O | U | As | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/walpurgite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bi&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;(UO&lt;sub&gt;2&lt;/sub&gt;)(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4238</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4238:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4238.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bi&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R050573</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Walpurgite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Walpurgite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Weisbach A (1871) Vorläufige Mittheilung, Neues Jahrbuch für Mineralogie, Geologie und Palaontologie 1871, 869-870 Chemical formula revised: Mereiter K (1982) The crystal structure of walpurgite, (UO_2_)Bi_4_O_4_(AsO_4_)_2_·2(H_2_O), Tschermaks Mineralogische und Petrographische Mitteilungen 30, 129-139</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.EA.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl phosphate or arsenate, UO2:RO4 = 1:2</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Walpurgite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1871</gsmin:wikipediadate>
  </rdf:Description>
