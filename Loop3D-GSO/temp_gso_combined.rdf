    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3848:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3848.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·7H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Switzerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Switzerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Leavens P B, White J S (1967) Switzerite, (Mn, Fe)3(PO4)2·4H2O, a new mineral, American Mineralogist 52, 1595-1602 Redefined and chemical formula revised: White J S, Leavens P B, Zanazzi P F (1986) Switzerite redefined as Mn3(PO4)2·7H2O, and metaswitzerite, Mn3(PO4)2·4H2O, American Mineralogist 71, 1221-1223</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.CE.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With only medium-sized cations, RO4:H2O about 1:2.5</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Switzerite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1966-042</gsmin:wikipediadate>
  </rdf:Description>
