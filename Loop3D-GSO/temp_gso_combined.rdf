    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kamenevite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kamenevite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pekov, I.V., Zubkova, N.V., Yapaskurt, V.O., Belakovskiy, D.I., Lykova, I.S., Britvin, S.N., Turchkova, A.G. and Pushcharovsky, D.Y. (2017) Kamenevite, IMA2017-021. CNMNC Newsletter No. 38, August 2017, page 1034; Mineralogical Magazine, 81,1033–1038</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Umbite</gsmin:structuralgroup>
