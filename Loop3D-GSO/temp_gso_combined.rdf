    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Al,Fe)&lt;sub&gt;32&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;18&lt;/sub&gt;(OH)&lt;sub&gt;42&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;22&lt;/sub&gt;·52H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2416</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2416:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2416.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Al,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;32&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;18&lt;/sub&gt;(OH)&lt;sub&gt;42&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;22&lt;/sub&gt;·52H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060768</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Liskeardite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Liskeardite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Maskelyne N S (1878) A new mineral, Nature 18, 426-426 Chemical formula revised from Al_3_AsO_4_(OH)_6_·5H_2_O: Grey I E, Mumme W G, Macrae C M, Caradoc-Davies T, Price J R, Rumsey M S, Mills S J (2013) Chiral edge-shared octahedral chains in liskeardite, [(Al,Fe)_32_(AsO_4_)_18_(OH)_42_(H_2_O)_22_]·52H_2_O, an open framework mineral with a pharmacoalumite-related structure. Mineralogical Magazine 77, 3125-3135</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.DF.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With only medium-sized cations, (OH,etc.):RO4 &gt; 3:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Liskeardite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>0</gsmin:wikipediadate>
  </rdf:Description>
