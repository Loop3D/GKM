    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KCaCl&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Potassium calcium trichloride</gsmin:iupacchemname>
    <gsmin:mindatid>min-1020</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1020:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1020.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KCaCl&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Chlorocalcite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Chlorocalcite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named clorocalcite: Scacchi A (1872) Notizie preliminari di alcune specie mineralogiche rinvenute nel Vesuvio dopo l'incendio di aprile 1872, Rendiconto dell'Accademia delle Scienze Fisiche e Matematiche (sezione della Societa reale di Napoli) 11, 210-213</gsmin:statusnotes>
    <gsmin:strunzcodeV10>03.AA.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Simple halides, without H2O, M:X 1:&lt;2</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Chlorocalcite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1872</gsmin:wikipediadate>
  </rdf:Description>
