    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Aleutite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Aleutite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Siidra, O.I., Nazarchuk, E.V., Agakhanov, A.A. and Polekhovsky, Y.S. (2018) Aleutite, IMA 2018-014. CNMNC Newsletter No 43, June 2018, page 784; Mineralogical Magazine, 82, 779–785</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/despujolsite">
