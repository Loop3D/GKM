    <gsmin:rruffnameplain xml:lang="en">Ferrotochilinite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pekov I V, Sereda E V, Polekhovsky Y S, Britvin S N, Chukanov N V. Yapaskurt V O, Bryzgalov I A (2012) Ferrotochilinite, 6FeS·5Fe(OH)_2_, a new mineral from Oktyabr'skoye ore deposit (Norilsk ore district, Siberia, Russia). Zapiski Rossiiskogo Mineralogicheskogo Obshchetstva 141(4), 1-11</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Tochilinite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">sulfide or sulfosalt</gsmin:strunzlabel>
    <gsmin:wikipediadate>2010-080</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/davidlloydite">
