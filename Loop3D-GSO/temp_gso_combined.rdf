    <gsmin:rruffnameplain xml:lang="en">Labyrinthite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Khomyakov A P, Nechelyustov G N, Rastsvetaeva R K (2006) Labyrinthite (Na,K,Sr)_35_Ca_12_Fe_3_Zr_6_TiSi_51_O_144_(O,OH,H_2_O)_9_Cl_3_, a new mineral with a modular eudialyte-like structure from Khibiny alkaline massif, Kola Peninsula, Russia, Zapiski Rossiiskogo Mineralogicheskogo Obshchetstva 135(2), 38-49</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Eudialyte</gsmin:structuralgroup>
