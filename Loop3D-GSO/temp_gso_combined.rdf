    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaCa&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;8&lt;/sub&gt;(OH)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3141</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3141:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3141.html</gsmin:mindaturl>
