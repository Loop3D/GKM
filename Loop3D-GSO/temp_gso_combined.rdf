    <gsmin:rruffnameplain xml:lang="en">Schubnelite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Cesbron F (1970) La schubnélite, nouveau vanadate de fer hydraté, Bulletin de la Société Française de Minéralogie et de Cristallographie 93, 470-475</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.CB.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With only medium-sized cations, RO4:H2O = 1:1</gsmin:strunzlabel>
