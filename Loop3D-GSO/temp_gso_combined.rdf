    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Al | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">reyerite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/reyerite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;Ca&lt;sub&gt;14&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;22&lt;/sub&gt;O&lt;sub&gt;58&lt;/sub&gt;(OH)&lt;sub&gt;8&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3396</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3396:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3396.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;Ca&lt;sub&gt;14&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;22&lt;/sub&gt;O&lt;sub&gt;58&lt;/sub&gt;(OH)&lt;sub&gt;8&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060749 | R060490</gsmin:rruffids>
