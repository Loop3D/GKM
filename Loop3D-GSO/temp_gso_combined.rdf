    <gsmin:chemistryelements>Ag | Zn | Tl | As | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">AgZn&lt;sub&gt;2&lt;/sub&gt;TlAs&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2014-077</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ag&lt;sup&gt;1+&lt;/sup&gt;Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Tl&lt;sup&gt;1+&lt;/sup&gt;As&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ralphcannonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ralphcannonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Bindi L, Biagioni C, Raber T, Roth T, Nestola F (2015) Ralphcannonite, AgZn_2_TlAs_2_S_6_, a new mineral of the routhierite isotypic series from Lengenbach, Binn Valley, Switzerland. Mineralogical Magazine 79, 1089-1098</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Routhierite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ferrovalleriite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ferrovalleriite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Fe | Cu | S | Al | Mg | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">2[(Fe,Cu)S]·1.53[(Fe,Al,Mg)(OH)&lt;sub&gt;2&lt;/sub&gt;]</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2011-068</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-42850</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:42850:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-42850.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">2(Fe,Cu)S·1.53[(Fe&lt;sup&gt;2+&lt;/sup&gt;,Al,Mg)(OH)&lt;sub&gt;2&lt;/sub&gt;]</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ferrovalleriite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ferrovalleriite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mineral described but not named: Harris D C, Cabri L J, Stewart J M (1970) A "valleriite-type" mineral from Noril'sk, western Siberia. American Mineralogist 55, 2110-2114 Mineral is named: Pekov I V, Sereda E V, Yapaskurt V O, Polekhovsky Y S, Britvin S N, Chukanov N V (2012) Ferrovalleriite, 2(Fe,Cu)S·1.5Fe(OH)_2_: validation as a mineral species and the new data. Zapiski Rossiiskogo Mineralogicheskogo Obshchetstva 141(6), 29-43</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Valleriite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">sulfide or sulfosalt</gsmin:strunzlabel>
    <gsmin:wikipediadate>2011-068</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kobellite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kobellite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Cu | Fe | Bi | Sb | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic, orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">kobellite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/kobellite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;11&lt;/sub&gt;(Cu,Fe)&lt;sub&gt;2&lt;/sub&gt;(Bi,Sb)&lt;sub&gt;15&lt;/sub&gt;S&lt;sub&gt;35&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2233</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2233:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2233.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;11&lt;/sub&gt;(Cu&lt;sup&gt;1+&lt;/sup&gt;,Fe&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;(Bi&lt;sup&gt;3+&lt;/sup&gt;,Sb&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;15&lt;/sub&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;35&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070669 | R110092</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kobellite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kobellite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Setterberg J (1841) Undersökning af ett nytt mineral, funnet uti Hvena Kobolt-grufvor uti Nerike, Kong. Svenska Vetenskaps-Akademiens Handlingar 1841, 188-193 Chemical formula is redefined to Pb_3_BiSbS_6_: Rammelsberg C F (1875) Kobellit, Handbuch der Mineralchemie 2, 100-101 The original chemical formula proposed by Setterberg is reconfirmed as Pb_6_Sb_2_Bi_4_S_15_: Keller H F (1890) Ueber Kobellit von Ouray, Colorado, und über die chemische Zusammensetzung dieser Species. Zeitschrift für Krystallographie und Mineralogie 17, 67-72 Chemical formula is redefined again as Pb_6_FeSb_2_Bi_4_S_16_: Nuffield E W (1948) Observations on kobellite, University of Toronto Studies: VI. Geological Series 52, 86-89 Chemical formula is redefined yet again as Pb_5_(Bi,Sb)_8_S_17_: Harris D C, Jambor J L, Lachance G R, Thorpe R I (1968) Tintinaite, the antimony analogue of kobellite, The Canadian Mineralogist 9, 371-382 Chemical formula is redefined again, based on crystal structure, Pb_12_(Cu,Fe)_2_(Bi,Sb)_14_S_35_: Miehe G (1971) Crystal structure of kobellite, Nature Physical Science 231, 133-134 Chemical formula redefined yet again: Moëlo Y, Roger G, Maurel-Palacin D, Marcoux E, Laroussi A (1995) Chemistry of some Pb-(Cu,Fe)-(Sb,Bi) sulfosalts from France and Portugal. Implications for the crystal chemistry of lead sulfosalts in the Cu-poor part of the Pb_2_S_2_-Cu_2_S-Sb_2_S_3_-Bi_2_S_3_ system, Mineralogy and Petrology 53, 229-250</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Kobellite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.HB.10a</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">SnS type sulfosalt with Cu, Ag, Fe, Sn and Pb</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Kobellite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1841</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/crednerite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Crednerite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Mn | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/crednerite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CuMnO&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: CopperII manganeseII dioxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-1150</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1150:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1150.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;1+&lt;/sup&gt;Mn&lt;sup&gt;3+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070404</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Crednerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Crednerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Rammelsberg C (1849) Ueber das mangankupfererz von Friedrichsrode, Zusatz zu der vorhergehenden abhandlung, Annalen der Physik und Chemie 74, 559-562 Redefined: Wherry E T (1924) Redefinition of species, American Mineralogist 9, 97-98</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.AB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 2:1 and 1:3, M:O = 1:1 (and up to 1:1.25); with small to medium-sized cations only</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Crednerite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1849</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/grischunite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Grischunite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Mn | Fe | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">wicksite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/grischunite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaCa&lt;sub&gt;2&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1981-028</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1753</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1753:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1753.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaCa&lt;sub&gt;2&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R130677</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Grischunite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Grischunite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Graeser S, Schwander H, Suhner B (1984) Grischunit (CaMn_2_[AsO_4_]_2_), eine neue mineralart aus den Schweizer Alpen, Schweizerische Mineralogische und Petrographische Mitteilungen 64, 1-10 Chemical formula revised: Bianchi R, Pilati T, Mannucci G (1987) Crystal structure of grischunite. American Mineralogist 72, 1225-1229</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Wicksite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CF.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With large and medium-sized cations, RO4:H2O &gt; 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Grischunite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1981-028</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/sanbornite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Sanbornite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ba | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/sanbornite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaSi&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;5&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3518</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3518:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3518.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaSi&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;5&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050001 | R060489</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sanbornite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Sanbornite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Rogers A F (1932) Sanbornite, a new barium silicate mineral from Mariposa County, California, American Mineralogist 17, 161-172</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.EF.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate: Single nets with 6-membered rings, connected by M[4], M[8], etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Sanbornite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1932</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/moorhouseite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Moorhouseite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Co | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">hexahydrite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/moorhouseite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Co(SO&lt;sub&gt;4&lt;/sub&gt;)·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1963-008</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Cobalt sulfate hexahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2776</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2776:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2776.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Co&lt;sup&gt;2+&lt;/sup&gt;S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Moorhouseite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Moorhouseite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Jambor J L, Boyle R W (1965) Moorhouseite and aplowite, new cobalt minerals from Walton, Nova Scotia, The Canadian Mineralogist 8, 166-171</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hexahydrite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.CB.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, with H2O, With only medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Moorhouseite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1963-008</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kyanoxalite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kyanoxalite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Al | Si | O | C | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;7&lt;/sub&gt;(Al&lt;sub&gt;5-6&lt;/sub&gt;Si&lt;sub&gt;6-7&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;)(C&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;0.5-1.0&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2008-041</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-38989</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:38989:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-38989.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;7&lt;/sub&gt;(Al&lt;sub&gt;5-6&lt;/sub&gt;Si&lt;sub&gt;6-7&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;)((C&lt;sub&gt;2&lt;/sub&gt;)&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;0.5-1.0&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kyanoxalite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kyanoxalite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chukanov N V, Pekov I V, Olysych L V, Massa W, Yakubovich O V, Zadov A E, Rastsvetaeva R K, Vigasina M F (2009) Kyanoxalite - a new cancrinite-group mineral with extra-framework oxalate anion, from Lovozero alkaline massif, Kola Peninsula, Zapiski Rossiiskogo Mineralogicheskogo Obshchetstva 138, 18-35</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Cancrinite-sodalite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.FB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Tektosilicate with additional anions</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Kyanoxalite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2008-041</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseWenlock2017">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Boundary"/>
    <rdfs:label xml:lang="en">Base of Wenlock - Sheinwoodian</rdfs:label>
