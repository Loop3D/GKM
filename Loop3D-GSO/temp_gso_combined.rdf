    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2406:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2406.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;16&lt;/sub&gt;O&lt;sub&gt;27&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Lindqvistite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Lindqvistite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Holstram D, Norrestam R (1993) Lindqvistite, Pb_2_&lt;i&gt;Me&lt;/i&gt;Fe_16_O_27_, a novel hexagonal ferrite mineral from Jakobsberg, Filipstad, Sweden, American Mineralogist 78, 1304-1312</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.CC.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 2: 3,3: 5, and similar, With large and medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Lindqvistite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1991-038</gsmin:wikipediadate>
