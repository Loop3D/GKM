    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:6872:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-6872.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KCr&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;3&lt;/sub&gt;Al)O&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Chromphyllite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Chromphyllite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Reznitsky L Z, Sklyarov E V, Ushchapovskaya Z F, Nartova N V, Evsyunin V G, Kashaev A A, Suvorova L F (1997) Chromphyllite KCr&lt;sub&gt;2&lt;/sub&gt;[AlSi&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;](OH,F)&lt;sub&gt;2&lt;/sub&gt; – a new dioctahedral mica, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 126(2), 110-119</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Mica</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EC.15</gsmin:strunzcodeV10>
