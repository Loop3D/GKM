    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Thometzekite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Thometzekite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Schmetzer K, Nuber B, Mendenbach O (1985) Thometzekite, a new mineral from Tsumeb, Namibia, and symmetry relations in the tsumcorite-helmutwinklerite family, Neues Jahrbuch für Mineralogie, Monatshefte 1985, 446-452</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Natrochalcite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CG.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With large and medium-sized cations, RO4:H2O = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Thometzekite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1982-103</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/feitknechtite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Feitknechtite</rdfs:label>
