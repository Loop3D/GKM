    <gsmin:rruffids>R050536</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cobaltaustinite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cobaltaustinite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Nickel E H, Birch W D (1988) Cobaltaustinite - a new arsenate mineral from Dome Rock, South Australia, Australian Mineralogist 3, 53-57</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Adelite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BH.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH,etc.):RO4 = 1:1</gsmin:strunzlabel>
