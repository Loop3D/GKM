    <gsmin:mindatid>min-27502</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:27502:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-27502.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaV&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;V&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;12&lt;/sub&gt;Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;27&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zoltaiite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Zoltaiite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Bartholomew P R, Mancini F, Cahill C, Harlow G E, Bernhardt H J (2005) Zoltaiite, a new barium-vanadium nesosubsilicate mineral from British Columbia: Description and crystal structure, American Mineralogist 90, 1655-1660</gsmin:statusnotes>
