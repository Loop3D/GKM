  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/well_indurated">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI consolidationdegree SKOS vocabulary 2012-11-24</dct:source>
    <rdfs:comment xml:lang="en">Particles in the rock are strongly bound together such that rock surface can only be broken with great difficulty using standard rock hammer (less than 1 kg mass).</rdfs:comment>
    <rdfs:label xml:lang="en">well indurated</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/indurated"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/aurostibite">
