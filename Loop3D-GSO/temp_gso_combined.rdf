    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Chrisstanleyite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Chrisstanleyite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Paar W H, Roberts A C, Criddle A J, Topa D (1998) A new mineral, chrisstanleyite, Ag&lt;sub&gt;2&lt;/sub&gt;Pd&lt;sub&gt;3&lt;/sub&gt;Se&lt;sub&gt;4&lt;/sub&gt;, from Hope's Nose, Torquay, Devon, England, Mineralogical Magazine 62, 257-264</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Chrisstanleyite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.BC.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide M:S &gt; 1:1 with Rh, Pd, Pt, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Chrisstanleyite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1996-044</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/chalcostibite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Chalcostibite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Sb | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/chalcostibite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CuSbS&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Copper antimonide disulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-983</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:983:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-983.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;1+&lt;/sup&gt;Sb&lt;sup&gt;3+&lt;/sup&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060262</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Chalcostibite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Chalcostibite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">The mineral was known before this publication, but under other names: Glocker E F (1847) VII. Lampritae Chalcostibitoidei. 35. Chalcostibites (kupferantimonglanz), in Generum et Specierum Mineralium Secundum Ordines Naturales Digestorum Synopsis, Eduardum Anton (Halae Saxonum) 32-33</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Chalcostibite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.HA.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">SnS type sulfosalt with Cu, Ag, Fe (without Pb)</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Chalcostibite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1835</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/allactite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Allactite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/allactite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;7&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;8&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: DimanganeseII diarsenate octahydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-122</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:122:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-122.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;7&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;8&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070175 | R150120</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Allactite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Allactite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Sjögren A (1884) Allaktit, ett nytt manganarseniat från Mossgrufvan å Nordmarksfältet, Geologiska Föreningens i Stockholm Förhandlingar 7, 109-111</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Allactite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BE.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With only medium-sized cations, (OH, etc.):RO4 &gt; 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Allactite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1884</gsmin:wikipediadate>
  </rdf:Description>
