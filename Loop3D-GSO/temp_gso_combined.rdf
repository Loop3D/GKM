    <gsmin:rruffnameplain xml:lang="en">Deltalumite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pekov, I.V., Anikin, L.P., Chukanov, N.V., Belakovskiy, D.I., Yapaskurt, V.O., Sidorov, E.G., Britvin, S.N. and Zubkova, N.V. (2016) Deltalumite, IMA 2016-027. CNMNC Newsletter No. 32, August 2016, page 919; Mineralogical Magazine, 80, 915–922</gsmin:statusnotes>
