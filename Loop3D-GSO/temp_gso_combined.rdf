    <gsmin:statusnotes xml:lang="en">Krause W, Blass G, Bernhardt H J, Effenberger H (2001) Lukrahnite, CaCuFe^3+^(AsO_4_)_2_[(H_2_O)(OH)], the calcium analogue of gartrellite, Neues Jahrbuch für Mineralogie, Monatshefte 2001, 481-492</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Helmutwinklerite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CG.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With large and medium-sized cations, RO4:H2O = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Lukrahnite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1999-030</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/lautenthalite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Lautenthalite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Cu | S | O | H</gsmin:chemistryelements>
