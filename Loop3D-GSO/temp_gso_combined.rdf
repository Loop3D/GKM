    <gsmin:rruffnameplain xml:lang="en">Tochilinite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Organova N I, Genkin A D, Drits V A, Molotkov S P, Kuz'mina O V, Dmitrik A L (1971) Tochilinite, a new sulfide-hydroxide of iron and magnesium, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 100, issue 4, 477-487</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Tochilinite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.FD.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Other sulfide with O, OH, H2O</gsmin:strunzlabel>
