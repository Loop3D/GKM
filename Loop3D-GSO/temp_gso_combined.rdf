  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/golyshevite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Golyshevite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Zr | Fe | Si | Nb | O | H | C</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">eudialyte</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;10&lt;/sub&gt;Ca&lt;sub&gt;9&lt;/sub&gt;Zr&lt;sub&gt;3&lt;/sub&gt;Fe&lt;sub&gt;2&lt;/sub&gt;SiNb(Si&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;9&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;9&lt;/sub&gt;O&lt;sub&gt;27&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2004-039</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-27418</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:27418:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-27418.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;10&lt;/sub&gt;Ca&lt;sub&gt;9&lt;/sub&gt;Zr&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;SiNb&lt;sup&gt;5+&lt;/sup&gt;(Si&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;9&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;9&lt;/sub&gt;O&lt;sub&gt;27&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R061047</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Golyshevite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Golyshevite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chukanov N V, Moiseev M M, Rastsvetaeva R K, Rozenberg K A, Zadov A E, Pekov I V, Korovushkin V V (2005) Golyshevite (Na,Ca)_10_Ca_9_(Fe^3+^,Fe^2+^)_2_Zr_3_NbSi_25_O_72_(CO_3_)(OH)_3_·H_2_O, and mogovidite, Na_9_(Ca,Na)_6_Ca_6_(Fe^3+^,Fe^2+^)_2_Zr_3_[box]Si_25_O_72_(CO_3_)(OH,H_2_O)_4_, the new eudialyte-group minerals from high-calcium agpaitic pegmatites of the Kovdor Massif, Kola peninsula, Zapiski Rossiiskogo Mineralogicheskogo Obshchetstva 134(6), 36-47</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Eudialyte</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CO.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si9O27]18- 9-membered rings</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Golyshevite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2004-039</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/arsenmarcobaldiite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
