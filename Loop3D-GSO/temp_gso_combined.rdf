    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3465:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3465.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;3&lt;/sub&gt;CaMn&lt;sup&gt;2+&lt;/sup&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;F</gsmin:rruffchemistry>
