    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Algodonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Algodonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Field F (1857) On algodonite, a new mineral containing arsenic and copper, The Quarterly Journal of the Chemical Society 10, 289-292 Chemical formula revised: Bayliss P (1990) Revised unit cell dimensions, space group, and chemical formula of some metallic minerals, The Canadian Mineralogist 28, 751-755</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.AA.10a</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">sulfide or sulfosalt alloy of metalloids with Cu, Ag, Au</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Algodonite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1857</gsmin:wikipediadate>
