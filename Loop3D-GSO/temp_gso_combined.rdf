    <gsmin:chemistryelements>Al | As | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">berlinite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/alarsite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al(AsO&lt;sub&gt;4&lt;/sub&gt;)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1993-003</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Aluminium arsenate</gsmin:iupacchemname>
    <gsmin:mindatid>min-94</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:94:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-94.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">AlAs&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Alarsite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Alarsite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Semenova T F, Vergasova L P, Filatov S K, Ananev V V (1994) Alarsite AlAsO&lt;sub&gt;4&lt;/sub&gt;: A new mineral from volcanic exhalations, Doklady Akademii Nauk 338(4), 501-505</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Quartz</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.AA.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, without H2O, With small cations (some also with larger ones)</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Alarsite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1993-003</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Effusive_Eruption">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Orton, G.J., 1996. Volcanic environments. 485-567 in Readingh.G. (ed.), Sedimentary Environments: Processes, Facies and Stratigraphy, Third Edition. Blackwell Science, Oxford</dct:source>
    <rdfs:comment xml:lang="en">Eruptions characterized by low volatile content of the erupting magma relative to ambient pressure</rdfs:comment>
    <rdfs:label xml:lang="en">effusive eruption</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicprocess/Eruption_Process"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/sillimanite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
