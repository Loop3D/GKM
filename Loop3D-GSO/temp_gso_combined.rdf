    <gsmin:statusnotes xml:lang="en">Tu K C, Li H L, Hsieh H D, Yin S S (1964) Zincobotryogen and zincocopiapite - two new varieties of sulfate minerals, Acta Geologica Sinica 44, 99-101</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Copiapite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.DB.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With only medium-sized cations; insular octahedra and finite units</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Zincocopiapite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1964</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfoliation/compound_metamorphic_foliation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A compound foliation in which the constituent fabric elements are of metamorphic origin.</rdfs:comment>
    <dct:source xml:lang="en">CGI foliationtype SKOS vocabulary 2018-08-03</dct:source>
    <rdfs:label xml:lang="en">compound metamorphic foliation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfoliation/compound_foliation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Migmatite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Fette and Desmons (2007) (http://www.bgs.ac.uk/SCMR/)</dct:source>
    <rdfs:comment xml:lang="en">Silicate metamorphic rock that is pervasively heterogeneous on a decimeter to meter scale that typically consists of darker and lighter parts; the darker parts usually exhibit features of metamorphic rocks whereas the lighter parts are of igneous-looking appearance.</rdfs:comment>
    <rdfs:label xml:lang="en">migmatite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Metamorphic_Rock"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kojonenite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kojonenite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pd | Sn | Te</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pd&lt;sub&gt;7-x&lt;/sub&gt;SnTe&lt;sub&gt;2&lt;/sub&gt; (0.3 = x = 0.8)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2013-132</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pd&lt;sub&gt;7-x&lt;/sub&gt;SnTe&lt;sub&gt;2&lt;/sub&gt; (0.3 = x = 0.8)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kojonenite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kojonenite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Stanley C J, Vymazalová A (2015) Kojonenite, a new palladium tin telluride mineral from the Stillwater layered igneous intrusion, Montana, U.S.A.. American Mineralogist 100, 447-450</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/minrecordite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Minrecordite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
