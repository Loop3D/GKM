  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/calcioburbankite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Calcioburbankite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Ce | Sr | La | C | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal, orthorhombic, monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">burbankite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/calcioburbankite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;3&lt;/sub&gt;(Ca,Ce,Sr,La)&lt;sub&gt;3&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;5&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1993-001</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-827</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:827:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-827.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;3&lt;/sub&gt;(Ca,Ce&lt;sup&gt;3+&lt;/sup&gt;,Sr,La&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;3&lt;/sub&gt;(C&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;5&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070023</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Calcioburbankite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Calcioburbankite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Van Velthuizen J, Gault R A, Grice J D (1995) Calcioburbankite, Na&lt;sub&gt;3&lt;/sub&gt;(Ca,REE,Sr)&lt;sub&gt;3&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;5&lt;/sub&gt;, a new mineral species from Mont Saint-Hilaire, Quebec, and its relationship to the burbankite group of minerals, The Canadian Mineralogist 33, 1231-1235</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Burbankite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>05.AC.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate without additional anions, without H2O, Alkali and alkali-earth carbonates</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Calcioburbankite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1993-001</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/zincalstibite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
