    <gsmin:imastatus xml:lang="en">Questionable mineral species|Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;Ca&lt;sub&gt;15&lt;/sub&gt;Al&lt;sub&gt;4&lt;/sub&gt;Si&lt;sub&gt;16&lt;/sub&gt;O&lt;sub&gt;54&lt;/sub&gt;·17H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Jusite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Jusite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Gramling-Mende I, Leopold G (1943) „Jusit", ein vermutlich neues Mineral!, Neues Jahrbuch für Mineralogie, Geologie und Palaontologie A49, 178-184</gsmin:statusnotes>
