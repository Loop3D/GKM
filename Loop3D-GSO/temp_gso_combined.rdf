    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 2: 3,3: 5, and similar, With large and medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Plumboferrite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1881</gsmin:wikipediadate>
