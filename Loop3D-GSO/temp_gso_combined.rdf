    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:27433:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-27433.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Mg&lt;sub&gt;2&lt;/sub&gt;Be&lt;sub&gt;4&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060893</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Atencioite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Atencioite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chukanov N V, St. Möckel R K, Rastsvetaeva A, Zadov A E (2006) The roscherite group and its new representative member atencioite, Ca&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;Mg&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Be&lt;sub&gt;4&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O, New Data on Minerals 41, 18-25</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Roscherite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DA.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With small (and occasionally larger) cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://webmineral.com/data/Atencioite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2004-041</gsmin:wikipediadate>
  </rdf:Description>
