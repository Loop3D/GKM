    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ag | Fe | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/sternbergite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">AgFe&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Silver diiron trisulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-3767</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3767:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3767.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ag&lt;sup&gt;1+&lt;/sup&gt;Fe&lt;sub&gt;2&lt;/sub&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R110137</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sternbergite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Sternbergite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Haidinger W (1827) On sternbergite, a new mineral species, The Edinburgh Journal of Science 7, 242-244</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Cubanite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.CB.65</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide (M = S) with Zn, Fe, Cu, Ag, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Sternbergite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1827</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/gorceixite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Gorceixite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ba | Al | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal, monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">alunite-jarosite-plumbogummite subgroup</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/gorceixite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaAl&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)(PO&lt;sub&gt;3&lt;/sub&gt;OH)(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Barium trialuminium phosphate hydrogenphosphate hexahydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-1727</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1727:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1727.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaAl&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)(PO&lt;sub&gt;3&lt;/sub&gt;OH)(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060158</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Gorceixite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Gorceixite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hussak E (1906) Über die sogenannten “phosphat-favas” der diamantführenden Sande Brasiliens, Tschermaks Mineralogische und Petrographische Mitteilungen 25, 335-344</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Alunite-crandallite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BL.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH, etc.):RO4 = 3:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Gorceixite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1906</gsmin:wikipediadate>
  </rdf:Description>
