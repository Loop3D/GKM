    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;PO&lt;sub&gt;4&lt;/sub&gt;(OH)</gsmin:rruffchemistry>
    <gsmin:rruffids>R050614 | R060545 | R140864</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Wolfeite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Wolfeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Frondel C (1949) Wolfeite, xanthoxenite, and whitlockite from the Palermo mine, New Hampshire, American Mineralogist 34, 692-705</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Wagnerite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BB.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With only medium-sized cations, (OH, etc.):RO4 about 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Wolfeite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1949</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/reinhardbraunsite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Reinhardbraunsite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic, unknown</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">humite-reinhardbraunsite subgroup</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/reinhardbraunsite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;5&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1980-032</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3387</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3387:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3387.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;5&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R061006</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Reinhardbraunsite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Reinhardbraunsite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hamm H M, Hentschel G (1983) Reinhardbraunsite, Ca5(SiO4)2(OH,F)2, a new mineral - the natural equivalent of synthetic "calcio-chondrodite", Neues Jahrbuch für Mineralogie, Monatshefte 1983, 119-129 Dunn P J, Grice J D, Fleischer M, Pabst A (1983) New mineral names, American Mineralogist, 68, 1038-1041</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Humite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AF.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with additional anions; cations in [4], [5] and/or only [6] coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Reinhardbraunsite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1980-032</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/calclacite">
