  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/irhtemite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Irhtemite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Mg | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/irhtemite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;4&lt;/sub&gt;Mg(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(AsO&lt;sub&gt;3&lt;/sub&gt;OH)&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1971-034</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2043</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2043:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2043.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;4&lt;/sub&gt;Mg(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;OH)&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Irhtemite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Irhtemite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pierrot R, Schubnel H J (1972) L'irhtemite, un nouvel arséniate hydraté de calcium et magnésium, Bulletin de la Société Française de Minéralogie et de Cristallographie 95, 365-370</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.CB.55</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With only medium-sized cations, RO4:H2O = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Irhtemite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1971-034</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/hollingworthite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
