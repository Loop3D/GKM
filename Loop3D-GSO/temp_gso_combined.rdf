  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/cahnite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cahnite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | B | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/cahnite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;B(AsO&lt;sub&gt;4&lt;/sub&gt;)(OH)&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dicalcium boron arsenate tetrahydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-851</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:851:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-851.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;B(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)(OH)&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070182 | R110095</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cahnite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cahnite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Palache C, Bauer L H (1927) Cahnite, A new boro-arsenate of calcium from Franklin, New Jersey, American Mineralogist 12, 149-153</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Zircon</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>06.AC.70</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Monoborate, B(O,OH)4, without and with additional anions; 1(T), 1(T)+OH, etc</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Cahnite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1927</gsmin:wikipediadate>
  </rdf:Description>
