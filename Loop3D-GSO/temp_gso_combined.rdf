  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/burpalite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Burpalite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Zr | Si | O | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">Wöhlerite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/burpalite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;4&lt;/sub&gt;Ca&lt;sub&gt;2&lt;/sub&gt;Zr&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;F&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1988-036</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-806</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:806:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-806.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;CaZr&lt;sup&gt;4+&lt;/sup&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)F&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Burpalite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Burpalite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Merlino S, Perchiazzi N, Khomyakov A P, Pushcharovsky D Y, Kulikova I M, Kuzmin V I (1990) Burpalite, a new mineral from Burpalinskii massif, North Transbajkal, USSR: its crystal structure and OD character, European Journal of Mineralogy 2, 177-185</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Wöhlerite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.BE.17</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate: Si2O7 groups, with additional anions; cations in octahedral [6] and greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Burpalite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1988-036</gsmin:wikipediadate>
  </rdf:Description>
