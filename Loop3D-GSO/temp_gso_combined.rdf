    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3164:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3164.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaMn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Perloffite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Perloffite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf A R (1977) A new mineral: perloffite, the Fe&lt;sup&gt;3+&lt;/sup&gt; analogue of bjarebyite, The Mineralogical Record 8, 112-114</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Bjarebyite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BH.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH,etc.):RO4 = 1:1</gsmin:strunzlabel>
