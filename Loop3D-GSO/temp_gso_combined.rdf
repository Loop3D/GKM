    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;5&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1974-043</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2863</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2863:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2863.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;5&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060855</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Natrosilite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Natrosilite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Timoshenkov I M, Men´shikov Y P, Gannibal L F, Bussen I V (1975) A natural sodium silicate, natrosilite, from the Lovozero massif, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 104, issue 3, 317-321 Fleischer M, Chao G Y, Mandarino J A (1976) New mineral names, American Mineralogist 61, 338-341</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.EE.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate: Single tetrahedral nets of 6-membered rings connected by octahedral nets or octahedral bands</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Natrosilite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1974-043</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/philoxenite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Philoxenite</rdfs:label>
