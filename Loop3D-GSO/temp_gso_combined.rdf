  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/chenguodaite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Chenguodaite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ag | Fe | Te | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ag&lt;sub&gt;9&lt;/sub&gt;FeTe&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2004-042a</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Nonasilver iron ditelluride tetrasulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-28953</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:28953:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-28953.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ag&lt;sub&gt;9&lt;/sub&gt;FeTe&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Chenguodaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Chenguodaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Gu X, Watanabe M, Xie X, Peng S, Nakamuta Y, Ohkawa M, Hoshino K, Ohsumi K, Shibata Y (2008) Chenguodaite (Ag&lt;sub&gt;9&lt;/sub&gt;FeTe&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;4&lt;/sub&gt;): a new tellurosulfide mineral from the gold diststrict of East Shandong Peninsula, China, Chinese Science Bulletin 53, 3567-3573</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.BA.60</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide M:S &gt; 1:1 with Cu, Ag, Au</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://webmineral.com/data/Chenguodaite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2004-042a</gsmin:wikipediadate>
  </rdf:Description>
