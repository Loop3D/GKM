    <rdfs:label xml:lang="en">Tertschite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | B | O | H</gsmin:chemistryelements>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/tertschite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;4&lt;/sub&gt;B&lt;sub&gt;10&lt;/sub&gt;O&lt;sub&gt;19&lt;/sub&gt;·20H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Questionable mineral species|Approved</gsmin:imastatus>
