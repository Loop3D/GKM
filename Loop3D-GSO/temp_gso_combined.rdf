    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nickelpicromerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Nickelpicromerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Belogub, E.V., Krivovichev, S.V., Pekov, I.V., Kuznetsov, A.M., Kotlyarov, V.A., Chukanov, N.V. and Belakovskiy, D.I. (2013) Nickelpicromerite, IMA2012-053. CNMNC Newsletter No. 15, February 2013, page 4; Mineralogical Magazine, 77, 1-12</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Picromerite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/metazellerite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Metazellerite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | U | O | C | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/metazellerite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca(UO&lt;sub&gt;2&lt;/sub&gt;)(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1965-032</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Copper uranyl dicarbonate trihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2697</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2697:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2697.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca(UO&lt;sub&gt;2&lt;/sub&gt;)(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Metazellerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Metazellerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Coleman R G, Ross D R, Meyrowitz R (1966) Zellerite and metazellerite, new uranyl carbonates, American Mineralogist 51, 1567-1578</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.EC.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl Carbonate, UO2:CO3 &lt; 1:1 - 1:2</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Metazellerite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1965-032</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/sartorite">
