  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Sapropel">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al. 2005</dct:source>
    <rdfs:comment xml:lang="en">Jelly like organic rich sediment composed of plant remains, usually algal. Liptinite to Inertinite ratio is greater than one (Economic commission for Europe, committee on Sustainable Energy- United Nations (ECE-UN), 1998, International Classification of in-Seam Coals: Energy 19, 41 pp.)</rdfs:comment>
    <rdfs:label xml:lang="en">sapropel</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Organic_Rich_Sediment"/>
  </rdf:Description>
