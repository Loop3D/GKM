    <gsmin:rruffnameplain xml:lang="en">Arsenogorceixite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Walenta K, Dunn P J (1993) Arsenogorceixit von der Grube Clara im mittleren Schwarzwald, Aufschluss 44, 250-254</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Alunite-crandallite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BL.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH, etc.):RO4 = 3:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Arsenogorceixite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1989-055</gsmin:wikipediadate>
  </rdf:Description>
