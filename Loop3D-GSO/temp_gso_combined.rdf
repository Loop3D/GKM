    <gsmin:iupacchemname xml:lang="en">IUPAC: Disodium calcium dicarbonate dihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-3220</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3220:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3220.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;Ca(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070192</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pirssonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Pirssonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pratt J H (1896) On northupite; pirssonite, a new mineral; gaylussite and hanksite from Borax Lake, San Bernardino County, California, The American Journal of Science 152, 123-135</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.CB.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate without additional anions, with H2O, With large cations (alkali and alkali-earth carbonates)</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Pirssonite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1896</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Marginal_Marine_Sabkha_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">North American Geologic-map Data Model Science Language Technical Team, 2004, Sedimentary materials:science language for their classification, description, and interpretation in digital geologic-map databases, Version 1.0 (12/18/2004): U.S. Geological Survey Open-File Report 2004-1451 appendix C, 595 p., accessed at http://pubs.usgs.gov/of/2004/1451/sltt/appendixC/, based on Jackson 1997, Neuendorf et al. 2005</dct:source>
    <rdfs:comment xml:lang="en">Setting characterized by arid to semi-arid conditions on restricted coastal plains mostly above normal high tide level, with evaporite-saline mineral, tidal-flood, and eolian deposits. Boundaries with intertidal setting and non-tidal terrestrial setting are gradational. (Jackson, 1997, p. 561).</rdfs:comment>
    <rdfs:label xml:lang="en">marginal marine sabkha setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Arid_Or_Semi_Arid_Environment_Setting"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Low_Energy_Shoreline_Setting"/>
  </rdf:Description>
