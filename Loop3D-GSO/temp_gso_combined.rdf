    <gsmin:rruffnameplain xml:lang="en">Ferri-kaersutite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Gentili S, Biagioni C, Comodi P, Pasero M, McCammon C, Bonadiman C (2016) Ferri-kaersutite, NaCa_2_(Mg_3_TiFe^3+^)(Si_6_Al_2_)O_22_O_2_, a new oxo-amphibole from Harrow Peaks, Northern Victoria Land, Antarctica. American Mineralogist 101, 461-468</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Amphibole-amphiboles sodic-calcic</gsmin:structuralgroup>
