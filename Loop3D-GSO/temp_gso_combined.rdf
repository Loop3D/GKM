    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dipotassium dimanganeseII trisulfate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2485</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2485:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2485.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Manganolangbeinite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Manganolangbeinite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Zambonini F, Carobbi G (1926) Sulla presenza, tra i prodotti dell'attuale attivita del Vesuvia, del composto Mn_2_K_2_(SO_4_)_3_, Rendiconto dell'Accademia delle Scienze Fisiche e Matematiche (sezione della Societa reale di Napoli) 30, 123-126</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Langbeinite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.AC.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, without H2O, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Manganolangbeinite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1926</gsmin:wikipediadate>
  </rdf:Description>
