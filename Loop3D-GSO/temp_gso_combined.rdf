    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3510:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3510.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Li,Na)Al&lt;sub&gt;3&lt;/sub&gt;(Si&lt;sub&gt;3&lt;/sub&gt;Al)O&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;5&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Saliotite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Saliotite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Goffé B, Baronnet A, Morin G (1994) La saliotite, interstratifié régulier 1:1 cookéite/paragonite. Nouveau phyllosilicate du métamorphisme de haute pression et basse température, European Journal of Mineralogy 6, 897-911</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Corrensite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EC.60</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with mica sheets, composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Saliotite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1990-018</gsmin:wikipediadate>
  </rdf:Description>
