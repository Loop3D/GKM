    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BeAl&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;5&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Brandãoite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Brandaoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Menezes, L., Chaves, M.L.S.C., Cooper, M.A., Ball, N., Abdu, Y., Sharp, R., Hawthorne, F.C. and Day, M. (2017) Brandãoite, IMA 2016-071a. CNMNC Newsletter No. 39, October 2017, page 1283; Mineralogical Magazine, 81, 1279–1286</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/bicapite">
