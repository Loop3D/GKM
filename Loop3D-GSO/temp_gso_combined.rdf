  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/dissakisite-ce">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Dissakisite-(Ce)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Ce | Mg | Al | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">epidote</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaCe(Al&lt;sub&gt;2&lt;/sub&gt;Mg)[Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;][SiO&lt;sub&gt;4&lt;/sub&gt;]O(OH)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1990-004</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaCeMgAl&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)(SiO&lt;sub&gt;4&lt;/sub&gt;)O(OH)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Dissakisite-(Ce)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Dissakisite-(Ce)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Grew E S, Essene E J, Peacor D R, Su S-C, Asami M (1991) Dissakisite-(Ce), a new member of the epidote group and the Mg analogue of allanite-(Ce), from Antarctica, American Mineralogist 76, 1990-1997</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Epidote</gsmin:structuralgroup>
  </rdf:Description>
