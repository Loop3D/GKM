  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Basanitic_Foidite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Foiditoid that contains less than 90 percent feldspathoid minerals in the QAPF fraction, and has a plagioclase to total feldspar ratio that is greater than 0.5, with greater than 10 percent normative olivine.</rdfs:comment>
    <rdfs:label xml:lang="en">basanitic foidite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Foiditoid"/>
  </rdf:Description>
