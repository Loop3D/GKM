    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Belakovskiite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Belakovskiite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf A R, Plášil J, Kasatkin A V, Marty J (2014) Belakovskiite, Na_7_(UO_2_)(SO_4_)_4_(SO_3_OH)(H_2_O)_3_, a new uranyl sulfate mineral from the Blue Lizard mine, San Juan County, Utah, USA. Mineralogical Magazine 78, 639-649</gsmin:statusnotes>
  </rdf:Description>
