    <gsmin:rruffids>R060497 | R140338</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Spherocobaltite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Spherocobaltite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named sphärocobaltit: Weisbach A (1877) Mineralogische Mittheilungen: Kobaltspath. (ein neues Glied der Kalkspath-Gruppe), Jahrbuch für das Berg-und Hüttenwesen im Königreiche Sachsen 1877, 42-53</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.AB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate without additional anions, without H2O, Alkali-earth (and other M2+) carbonates</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Spherocobaltite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1877</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/chukhrovite-ce">
