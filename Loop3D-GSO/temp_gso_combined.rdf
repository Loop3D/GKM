    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:314:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-314.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Arcanite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Arcanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Haidinger W (1845) Erste Klasse: Akrogenide. IV. Ordnung. Salze. XIII. Pikrochylinsalz. Arcanit., in Handbuch der Bestimmenden Mineralogie, Bei Braumüller and Seidel (Wien) 487-492</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Arcanite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.AD.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, without H2O, With only large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Arcanite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1845</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/roquesite">
