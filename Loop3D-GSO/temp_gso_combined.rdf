  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/rosasite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Rosasite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Zn | C | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">rosasite</gsmin:fleischersgroup>
