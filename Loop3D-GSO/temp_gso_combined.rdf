    <gsmin:imanumber xml:lang="en">IMA1976-045</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: ManganeseII sulfate pentahydrate</gsmin:iupacchemname>
