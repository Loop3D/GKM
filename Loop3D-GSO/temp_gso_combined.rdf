  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfault/Dextral_Strike_Slip_Fault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI faulttype SKOS vocabulary 2016-10-19</dct:source>
    <rdfs:comment xml:lang="en">Fault with right-lateral strike-parallel displacement component of slip vector more than 10 times the dip-parallel component of the slip vector at at least one location along the fault, and right-lateral displacement over more than half the mapped trace of the fault.</rdfs:comment>
    <rdfs:label xml:lang="en">dextral strike slip fault</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfault/Strike_Slip_Fault"/>
  </rdf:Description>
