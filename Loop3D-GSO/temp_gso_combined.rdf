    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Gramaccioliite-(Y)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Gramaccioliite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Orlandi P, Pasero M, Rotiroti N, Olmi F, Demartin F, Moelo Y (2004) Gramaccioliite-(Y), a new mineral of the crichtonite group from Stura Valley, Piedmont, Italy, European Journal of Mineralogy 16, 171-175</gsmin:statusnotes>
