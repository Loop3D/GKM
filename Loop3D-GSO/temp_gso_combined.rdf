  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/vanadinite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Vanadinite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/mineral/apatitegroup"/>
    <gsmin:chemistryelements>Pb | V | O | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">apatite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/vanadinite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;5&lt;/sub&gt;(VO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;Cl</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Pentalead trivanadate chloride</gsmin:iupacchemname>
    <gsmin:mindatid>min-4139</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4139:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4139.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;(V&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;Cl</gsmin:rruffchemistry>
    <gsmin:rruffids>R050171 | R050189 | R050376 | R050530 | R050533</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Vanadinite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Vanadinite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">von Kobell F (1838) Vanadinit, in Grundzüge der Mineralogie, (Nürnberg) 283-283</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Apatite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BN.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With only large cations, (OH, etc.):RO4 = 0.33:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Vanadinite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1838</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/matlockite">
