    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Lead manganeseIII dioxide hydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-3340</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3340:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3340.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;Mn&lt;sup&gt;3+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;(OH)</gsmin:rruffchemistry>
    <gsmin:rruffids>R060439 | R100036</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Quenselite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Quenselite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Flink G (1925) Quenselite, ein neues mineral von Långban, Geologiska Föreningens i Stockholm Förhandlingar 47, 377-384</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.FE.30</gsmin:strunzcodeV10>
