  <rdf:Description rdf:about="https://w3id.org/gso/1.0/granularmaterial/Bioclastic_Particle_Material">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">This vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Granular material consisting of particles that are shell, bone, or other hard skeletal structure of an animal, plant, or protozoan. May be fossilized or non-fossilized. Use in situations where fossil organism can not be identified, thus 'material fossil' is too specific.</rdfs:comment>
    <rdfs:label xml:lang="en">bioclastic particle material</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/granularmaterial/Biogenic_Particle_Material"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/hollandite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Hollandite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ba | Mn | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal, monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">coronadite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/hollandite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba(Mn&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;Mn&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;)O&lt;sub&gt;16&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2012 s.p.</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Barium manganeseII heptamanganeseIV hexadecaoxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-1921</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1921:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1921.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba(Mn&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;Mn&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;)O&lt;sub&gt;16&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060852 | R070539</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hollandite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hollandite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Named hollandite, though subsequently found to be ferrihollandite: Fermor L L (1906) Manganese in India, Transactions of the Mining and Geological Institute of India 1, 69-131 First report of true hollandite: Miura H (1986) The crystal structure of hollandite. Mineralogical Journal 13, 119-129 Redefined, and chemical formula revised from BaMn&lt;sup&gt;2+&lt;/sup&gt;Mn&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;7&lt;/sub&gt;O&lt;sub&gt;16&lt;/sub&gt;: Biagioni C, Capalbo C, Pasero M (2013) Nomenclature tunings in the hollandite supergroup. European Journal of Mineralogy 25, 85-90</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Coronadite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.DK.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With large (+- medium-sized) cations; tunnel structures</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Hollandite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1906</gsmin:wikipediadate>
  </rdf:Description>
