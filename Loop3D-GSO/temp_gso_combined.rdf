    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nafertisite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Nafertisite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Khomyakov A P, Ferraris G, Ivaldi G, Nechelyustov G N, Soboleva S V (1995) Nafertisite Na_3_(Fe^2+^, Fe^3+^)_6_[Ti_2_Si_12_O_34_](O,OH)_7_·2H_2_O, a new mineral with a new type of banded silicate radical, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 124(6), 101-107. Formula changed from Na_3_(Fe^2+^, Fe^3+^)_6_[Ti_2_Si_12_O_34_](O,OH)_7_·2H_2_O: Cámara F, Sokolova E, Abdu Y A, Hawthorne F C (2014) Nafertisite, Na_3_Fe^2+^_10_Ti_2_(Si_6_O_17_)_2_O_2_(OH)_6_F(H_2_O)_2_, from Mt. Kukisvumchorr, Khibiny alkaline massif, Kola peninsula, Russia: Refinement of the crystal structure and revision of the chemical formula. European Journal of Mineralogy 26, 689-700.</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.EH.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Transitional structure between phyllosilicate and other silicate units</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Nafertisite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1994-007</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/cyanotrichite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cyanotrichite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Al | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">unknown</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/cyanotrichite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;4&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)(OH)&lt;sub&gt;12&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Tetracopper dialuminium sulfate dodecahydroxyl dihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1203</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1203:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1203.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;12&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070405 | R070500</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cyanotrichite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cyanotrichite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Glocker E F (1839) 17. Kupferlasur. Anhang. 1. Der noch wenig gelannte cyanotrichit, in Grundrib der Mineralogie, mit Einschlub der Geognosie und Petrefactenkunde, Schrag (Nurnberg) 585-587</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Cyanotrichite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.DE.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With only medium-sized cations; unclassified</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Cyanotrichite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1839</gsmin:wikipediadate>
  </rdf:Description>
