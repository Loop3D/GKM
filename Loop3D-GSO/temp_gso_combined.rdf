    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;2&lt;/sub&gt;Cu(PO&lt;sub&gt;4&lt;/sub&gt;)(SO&lt;sub&gt;4&lt;/sub&gt;)(OH)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dilead copper phosphate sulfate hydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-4040</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4040:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4040.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;(P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)(OH)</gsmin:rruffchemistry>
    <gsmin:rruffids>R070446 | R080020</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tsumebite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tsumebite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Busz K (1912) Tsumebit, ein neues Mineral von Otavi und Zinnsteinkristalle. Deutschen Naturforscher und Årtze in Münster, Versammlung 84, 230-230 Chemical formula revised from Pb_2_Cu(PO_4_)(OH)_3_·3H_2_O: Nichols M C (1966) The structure of tsumebite, American Mineralogist 51, 267-267</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Brackebuschite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BG.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH, etc.):RO4 = 0.5:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Tsumebite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1966</gsmin:wikipediadate>
  </rdf:Description>
