    <gsmin:chemistryelements>Pb | U | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic, cubic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/curite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;3+x&lt;/sub&gt;[(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;4+x&lt;/sub&gt;(OH)&lt;sub&gt;3-x&lt;/sub&gt;]&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Trilead octauranyl octaoxy hexahydroxyl trihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1197</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1197:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1197.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;3+x&lt;/sub&gt;[(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;4+x&lt;/sub&gt;(OH)&lt;sub&gt;3-x&lt;/sub&gt;]&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060728 | R070328 | R130657</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Curite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Curite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Schoep A (1921) La curite, nouveau minéral radioactif, Comptes Rendus de L’Académie des Sciences Paris 173, 1186-1187</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.GB.55</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl hydroxide, With additional cations (K, Ca, Ba, Pb, etc.); with mainly UO2(O,OH)5 pentagonal polyhedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Curite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1921</gsmin:wikipediadate>
