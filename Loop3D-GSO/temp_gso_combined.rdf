    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaTi&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R110180</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Barioperovskite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Barioperovskite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Ma C, Rossman G R (2008) Barioperovskite, BaTiO&lt;sub&gt;3&lt;/sub&gt;, a new mineral from the Benitoite mine, California, American Mineralogist 93, 154-157</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Perovskite</gsmin:structuralgroup>
