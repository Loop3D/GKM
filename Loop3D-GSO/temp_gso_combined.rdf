    <gsmin:imanumber xml:lang="en">IMA1966-011</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Lead iron arsenate hydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-1626</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1626:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1626.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;(As&lt;sup&gt;3+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Gabrielsonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Gabrielsonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Moore P B (1967) Gabrielsonite, PbFe(AsO_4_)(OH), a new member of the descloizite-pyrobelonite group, from Långban, Arkiv för Mineralogi och Geologi 4, 401-405 Chemical formula revised from PbFe(AsO_4_)(OH): Perchiazzi N, Hålenius U, Vignola P, Demitri N (2018) Gabrielsonite revisited: crystal-structure determination and redefinition of chemical formula. European Journal of Mineralogy 30, 1173-1180</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.BH.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH,etc.):RO4 = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Gabrielsonite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1966-011</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/windhoekite">
