    <gsmin:rruffnameplain xml:lang="en">Trattnerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Postl W, Walter F, Ettinger K, Hauzenberger C, Bojar H P (2004) Trattnerite, (Fe,Mg)2(Mg,Fe)3[Si12O30], a new mineral of the milarite group: mineral data and crystal structure, European Journal of Mineralogy 16, 375-380</gsmin:statusnotes>
