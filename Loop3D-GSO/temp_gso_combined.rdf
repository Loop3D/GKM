    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">O'danielite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Odanielite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Keller P, Hess H, Dunn P J, Newbury D (1981) O'Danielite, NaZn_3_H_2_(AsO_4_)_3_, a new mineral from Tsumeb, Namibia, Neues Jahrbuch für Mineralogie, Monatshefte 1981, 155-160</gsmin:statusnotes>
