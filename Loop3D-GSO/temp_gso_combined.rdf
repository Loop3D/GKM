    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3101:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3101.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;O(SiO&lt;sub&gt;4&lt;/sub&gt;)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Paranatisite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Paranatisite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Khomjakov A P, Polezhaeva L I, Sokolova E V (1992) Paranatisite - Na_2_TiSiO_5_ - a new mineral, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 121(6), 133-137</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.AG.40b</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with additional anions; cations in &gt; [6] +- [6] coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Paranatisite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1990-016</gsmin:wikipediadate>
