    <gsmin:rruffnameplain xml:lang="en">Adamsite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Grice J D, Gault R A, Roberts A C, Cooper M A (2000) Adamsite-(Y), a new sodium-yttrium carbonate mineral species from Mont Saint-Hilaire, Quebec, The Canadian Mineralogist 38, 1457-1466</gsmin:statusnotes>
