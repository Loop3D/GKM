  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/sainfeldite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Sainfeldite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">hureaulite</gsmin:fleischersgroup>
