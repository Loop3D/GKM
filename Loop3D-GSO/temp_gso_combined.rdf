    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:mindatid>min-1329</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1329:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1329.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">AlAl&lt;sub&gt;6&lt;/sub&gt;BSi&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060069 | R050628</gsmin:rruffids>
