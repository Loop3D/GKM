    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Mn&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;0.5&lt;/sub&gt;Sb&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;0.5&lt;/sub&gt;)Mg&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tegengrenite</gsmin:rruffnamehtml>
