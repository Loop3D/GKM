    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;MgCr&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)(SiO&lt;sub&gt;4&lt;/sub&gt;)(OH)&lt;sub&gt;2&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1980-061</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3642</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3642:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3642.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;MgCr&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)(OH)&lt;sub&gt;2&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070109</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Shuiskite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Shuiskite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Ivanov O K, Arkhangel´skaya V A, Miroshnikova L O, Shilova T A (1981) Shuiskite, the chromium analogue of pumpellyite, from the Bisersk deposit, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 110(4), 508-512</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.BG.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate with mixed SiO4 and Si2O7 groups; cations in octahedral [6] and greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Shuiskite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1980-061</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/nantokite">
