    <gsmin:rruffnameplain xml:lang="en">Kulkeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Schreyer W, Medenbach O, Abraham K, Gebert W, Müller W F (1982) Kulkeite, a new metamorphic phyllosilicate mineral: Ordered 1:1 chlorite/talc mixed-layer. Contributions to Mineralogy and Petrology 80, 103-109</gsmin:statusnotes>
