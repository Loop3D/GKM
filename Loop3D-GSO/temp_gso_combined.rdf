    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:925:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-925.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;V&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH)</gsmin:rruffchemistry>
    <gsmin:rruffids>R070363 | R170047</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Čechite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cechite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mrázek Z, Táborský Z (1981) Cechite, Pb(Fe&lt;sup&gt;+2&lt;/sup&gt;,Mn&lt;sup&gt;+2&lt;/sup&gt;)(VO&lt;sub&gt;4&lt;/sub&gt;)(OH), a new mineral of the descloizite-pyrobelonite group, Neues Jahrbuch für Mineralogie, Monatshefte 1981, 520-528</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Descloizite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BH.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH,etc.):RO4 = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Cechite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1980-068</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/fourmarierite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Fourmarierite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | O | U | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
