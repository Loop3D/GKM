  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Shale">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">NADM SLTT sedimentary, 2004</dct:source>
    <rdfs:comment xml:lang="en">Laminated mudstone that will part or break along thin, closely spaced layers parallel to stratification.</rdfs:comment>
    <rdfs:comment xml:lang="en">Note definition does not specify carbonate vs. siliclastic nature of mud.</rdfs:comment>
    <rdfs:label xml:lang="en">shale</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Clastic_Mudstone"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Intraplate_Tectonic_Setting">
