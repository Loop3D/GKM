    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Stoiberite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Stoiberite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Birnie R W, Hughes J M (1979) Stoiberite, Cu5V2O10, a new copper vanadate from Izalco volcano, El Salvador, Central America, American Mineralogist 64, 941-944</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.BB.75</gsmin:strunzcodeV10>
