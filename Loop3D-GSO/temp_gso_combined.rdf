    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Y | REE | Ca | Na | Al | Fe | As | Si | B | O | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Y,REE,Ca,Na)&lt;sub&gt;15&lt;/sub&gt;(Al,Fe&lt;sup&gt;3+&lt;/sup&gt;)Ca&lt;sub&gt;x&lt;/sub&gt;As&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;1-x&lt;/sub&gt;(Si,As&lt;sup&gt;5+&lt;/sup&gt;)Si&lt;sub&gt;6&lt;/sub&gt;B&lt;sub&gt;3&lt;/sub&gt;(O,F)&lt;sub&gt;48&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2006-005</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-29098</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:29098:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-29098.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Y,Ca,Na)&lt;sub&gt;15&lt;/sub&gt;(Al,Fe&lt;sup&gt;3+&lt;/sup&gt;)Ca&lt;sub&gt;x&lt;/sub&gt;As&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;1-x&lt;/sub&gt;(Si,As&lt;sup&gt;5+&lt;/sup&gt;)Si&lt;sub&gt;6&lt;/sub&gt;B&lt;sub&gt;3&lt;/sub&gt;(O,F)&lt;sub&gt;48&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hundholmenite-(Y)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hundholmenite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Raade G, Johnsen O, Erambert M, Petersen O V (2007) Hundholmenite-(Y) from Norway — a new mineral species in the vicanite group: descriptive data and crystal structure, Mineralogical Magazine 71, 179-192</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Okanoganite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AJ.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with BO3 triangles and/or B[4], Be[4] tetrahedra, cornersharing with SiO4</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://webmineral.com/data/Hundholmenite-(Y).shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2006-005</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/cyprine">
