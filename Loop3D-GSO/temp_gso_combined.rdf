    <gsmin:rruffids>R070453 | R070537 | R130016</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hulsite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hulsite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Knopf A, Schaller W T (1908) Two new boron minerals of contact-metamorphic origin, The American Journal of Science 175, 323-331</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hulsite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>06.AB.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Monoborate, BO3, with additional anions; 1(D) + OH, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Hulsite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1908</gsmin:wikipediadate>
  </rdf:Description>
