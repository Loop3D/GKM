    <gsmin:rruffnameplain xml:lang="en">Jachymovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Cejka J, Sejkora J, Mrázek Z, Urbanec Z, Jarchovský T (1996) Jáchymovite, (UO_2_)_8_(SO_4_)(OH)_14_·13H_2_O, a new uranyl mineral from Jáchymov, the Krusné hory Mts., Czech Republic, and its comparison with uranopilite, Neues Jahrbuch für Mineralogie, Abhandlungen 170, 155-170</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.EA.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl sulfate, Without cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Jachymovite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1994-025</gsmin:wikipediadate>
