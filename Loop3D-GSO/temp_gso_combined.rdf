    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dicalcium ironII diphosphate dihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2658</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2658:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2658.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Messelite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Messelite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Muthmann W (1890) Messelit, ein neues mineral, Zeitschrift für Krystallographie und Mineralogie 17, 93-94</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Fairfieldite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CG.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With large and medium-sized cations, RO4:H2O = 1:1</gsmin:strunzlabel>
