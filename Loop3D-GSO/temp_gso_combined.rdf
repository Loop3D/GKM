  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/Inherant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">An Inherent is a thing that occupies space indirectly and depends for its existence on some bearer. The inherent is associated with the bearer via the InheresIn relation. An Inherent is an Endurant because it is present in its totality at any time that it exists. Note: inherants are summative: our colour (the sum of your colour and mine) inheres in us (the sum of you and me).</rdfs:comment>
    <rdfs:label xml:lang="en">Inherant</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Nonphysical_Endurant"/>
    <rdfs:subClassOf rdf:nodeID="n7bda25761fc44f8595ef751309700190b89"/>
    <rdfs:subClassOf rdf:nodeID="n7bda25761fc44f8595ef751309700190b90"/>
    <owl:disjointWith rdf:resource="https://w3id.org/gso/1.0/common/Notional_Endurant"/>
    <owl:disjointWith rdf:resource="https://w3id.org/gso/1.0/common/Relator"/>
    <owl:equivalentClass rdf:nodeID="n7bda25761fc44f8595ef751309700190b91"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb26e920196f4af8bbd263b193e6f242b571">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/common/Uncertainty"/>
    <gsoc:hasDataValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.2</gsoc:hasDataValue>
  </rdf:Description>
