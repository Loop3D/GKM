    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Th,Ce)(PO&lt;sub&gt;4&lt;/sub&gt;)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-780</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:780:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-780.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Th,Ce)PO&lt;sub&gt;4&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Brockite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Brockite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Fisher F G, Meyrowitz R (1962) Brockite, a new calcium thorium phosphate from the Wet Mountains, Colorado, American Mineralogist 47, 1346-1355</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Rhabdophane</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CJ.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With only large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Brockite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1962</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/melkovite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Melkovite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | H | O | Mo | P | Fe</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/melkovite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaFe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Mo&lt;sub&gt;5&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;12&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1968-033</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2637</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2637:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2637.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">[Ca&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;15&lt;/sub&gt;Ca(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;6&lt;/sub&gt;][Mo&lt;sup&gt;6+&lt;/sup&gt;&lt;sub&gt;8&lt;/sub&gt;P&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;36&lt;/sub&gt;(OH)]</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Melkovite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Melkovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Egorov B L, Dara A D, Senderova V M (1969) Melkovite, a new phosphate-molybdate from the zone of oxidation, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 98(2), 207-212</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Betpakdalite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DM.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 &gt; 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Melkovite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1968-033</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/cobaltkieserite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
