    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ramanite-(Cs)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ramanite-(Cs)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Rainer T, Davidson P, Hahn A (2008) Ramanite-(Cs) and ramanite-(Rb): New cesium and rubidium pentaborate tetrahydrate minerals identified with Raman spectroscopy. American Mineralogist 93 (2008) 1034-1042</gsmin:statusnotes>
