  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/magnesioferrite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Magnesioferrite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mg | Fe | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">spinel</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/magnesioferrite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">MgFe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Magnesium diironIII tetraoxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-2501</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2501:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2501.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">MgFe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060869 | R070127</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Magnesioferrite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Magnesioferrite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named magnoferrit: Rammelsberg C (1859) Ueber den sogenannten octaëdrischen Eisenglanz vom Vesuv, und über die Bildung von Magneteisen durch Sublimation, Annalen der Physik und Chemie 107, 451-454</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Spinel</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.BB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 3:4 and similar, With only medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Magnesioferrite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1859</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/parawulffite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Parawulffite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Na | Cu | S | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;5&lt;/sub&gt;Na&lt;sub&gt;3&lt;/sub&gt;Cu&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;8&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2013-036</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;5&lt;/sub&gt;Na&lt;sub&gt;3&lt;/sub&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;8&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Parawulffite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Parawulffite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pekov I V, Zubkova N V, Yapaskurt V O, Belakovskiy D I, Chukanov N V, Lykova I S, Savelyev D P, Sidorov E G, Pushcharovsky D Y (2014) Wulffite, K_3_NaCu_4_O_2_(SO_4_)_4_, and parawulffite, K_5_Na_3_Cu_8_O_4_(SO_4_)_8_, two new minerals from fumarole sublimates of the Tolbachik volcano, Kamchatka, Russia. The Canadian Mineralogist 52, 699-716</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/fluorkyuygenite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Fluorkyuygenite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Al | O | H | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;12&lt;/sub&gt;Al&lt;sub&gt;14&lt;/sub&gt;O&lt;sub&gt;32&lt;/sub&gt;[(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;4&lt;/sub&gt;F&lt;sub&gt;2&lt;/sub&gt;]</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2013-043</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;12&lt;/sub&gt;Al&lt;sub&gt;14&lt;/sub&gt;O&lt;sub&gt;32&lt;/sub&gt;[(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;4&lt;/sub&gt;F&lt;sub&gt;2&lt;/sub&gt;]</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fluorkyuygenite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Fluorkyuygenite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Galuskin E V, Gfeller F, Armbruster T, Galuskina I O, Vapnik Y, Dulski M, Murashko M, Dzierzanowski P, Sharygin V V, Krivovichev S V, Wirth R (2015) Mayenite supergroup, part III: fluormayenite, Ca_12_Al_14_O_32_[[box]_4_F_2_], and fluorkyuygenite, Ca_12_Al_14_O_32_[(H_2_O)_4_F_2_], two new minerals from pyrometamorphic rocks of the Hatrurim Complex, South Levant. European Journal of Mineralogy 27, 123-136</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Mayenite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/legrandite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Legrandite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Zn | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/legrandite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sub&gt;2&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)(OH)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dizinc arsenate hydroxyl monohydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2365</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2365:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2365.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R040151</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Legrandite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Legrandite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Drugman J, Hey M H, Bannister F A (1932) Legrandite, a new zinc arsenate, Mineralogical Magazine 23, 175-178</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.DC.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With only medium-sized cations, (OH, etc.):RO4 = 1:1 and &lt; 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Legrandite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1932</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/aleksandrovite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Aleksandrovite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Ca | Sn | Li | Si | O | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KCa&lt;sub&gt;7&lt;/sub&gt;Sn&lt;sub&gt;2&lt;/sub&gt;Li&lt;sub&gt;3&lt;/sub&gt;Si&lt;sub&gt;12&lt;/sub&gt;O&lt;sub&gt;36&lt;/sub&gt;F&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2009-004</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
