    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zincrosasite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Zincrosasite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Strunz H (1959) Tsumeb, seine Erze und Sekundärmineralien, insbesondere der neu aufgeschlossenen zweiten Oxydationszone. Fortschritte der Mineralogie 37, 87-90</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Malachite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>05.BA.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions, without H2O, With Cu, Co, Ni, Zn, Mg, Mn</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Zincrosasite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>0</gsmin:wikipediadate>
  </rdf:Description>
