    <gsmin:rruffids>R050522 | R070403 | R070491</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Corkite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Corkite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mineral species recognized but not named: Rammelsberg C (1857) Ueber die Zusammensetzung des Beudantits, Annalen der Physik und Chemie 10, 581-583 Mineral is named: Adam G J (1869) Tableau Minéralogique. Corkite, Annales des Mines 15, 552-553 Chemical composition revised: Scott K M (1987) Solid solution in, and classification of, gossan-derived members of the alunite-jarosite family, northwest Queensland, Australia, American Mineralogist 72, 178-187</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Alunite-beudantite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BL.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH, etc.):RO4 = 3:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Corkite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1987</gsmin:wikipediadate>
  </rdf:Description>
