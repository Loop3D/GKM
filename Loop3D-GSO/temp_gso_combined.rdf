  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/slikite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Šlikite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Zn | Mg | C | O | H</gsmin:chemistryelements>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sub&gt;2&lt;/sub&gt;Mg(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2018-120</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Pending publication</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Mg(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">&amp;#138;likite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Slikite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Sejkora, J., Grey, I.E., Kampf, A.R., Mumme, W.G., Bureš, B. and Cejka, J. (2019) Šlikite, IMA 2018-120. CNMNC Newsletter No. 47, February 2019, page 145; Mineralogical Magazine, 83, 143–147</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Eruption_Process">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf, K.K.E, Mehl, J.P. &amp; Jackson, J.A. (eds), 2005. Glossary of geology, 5th Edition. American Geological Institute, Alexandria, 779 p.</dct:source>
    <rdfs:comment xml:lang="en">The ejection of volcanic materials (lava, pyroclasts, and volcanic gases) onto the Earth's surface, either from a central vent or from a fissure or group of fissures</rdfs:comment>
    <rdfs:label xml:lang="en">eruption</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicprocess/Magmatic_Process"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicprocess/Rock_Forming_Process"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Additive_Process"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Foid_Dioritoid">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Phaneritic crystalline igneous rock in which M is less than 90, the plagioclase to total feldspar ratio is greater than 0.5, feldspathoid minerals form 10-60 percent of the QAPF fraction, plagioclase has anorthite content less than 50 percent. These rocks typically contain large amounts of mafic minerals. Includes rocks defined modally in QAPF fields 13 and 14.</rdfs:comment>
    <rdfs:label xml:lang="en">foid dioritoid</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Phaneritic_Igneous_Rock"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/natrite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Natrite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | C | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/natrite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1981-005</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Disodium carbonate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2849</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2849:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2849.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;CO&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Natrite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Natrite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Khomyakov A P (1982) Natrite, Na2CO3, a new mineral, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 111, issue 2, 220-225 Fleischer M, Pabst A (1983) New mineral names, American Mineralogist 68, 280-283</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.AA.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate without additional anions, without H2O, Alkali carbonates</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Natrite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1981-005</gsmin:wikipediadate>
  </rdf:Description>
