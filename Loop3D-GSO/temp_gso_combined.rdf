    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;7&lt;/sub&gt;[(Cu,Ag)&lt;sub&gt;0.33&lt;/sub&gt;Pb&lt;sub&gt;1.33&lt;/sub&gt;Bi&lt;sub&gt;11.33&lt;/sub&gt;]S&lt;sub&gt;22&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1983-091</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
