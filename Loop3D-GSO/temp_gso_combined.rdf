  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Packstone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Hallsworth and Knox 1999</dct:source>
    <rdfs:comment xml:lang="en">Carbonate sedimentary rock with discernible grain supported depositional texture, containing greater than 10 percent grains, and constituent particles are of intrabasinal origin; intergranular spaces are filled by matrix.</rdfs:comment>
    <rdfs:comment xml:lang="en">Note that this category overlaps with 'carbonate mudstone'.</rdfs:comment>
    <rdfs:label xml:lang="en">packstone</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Carbonate_Sedimentary_Rock"/>
  </rdf:Description>
