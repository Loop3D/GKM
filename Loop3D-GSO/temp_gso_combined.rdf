    <gsmin:chemistryelements>Al | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">andalusite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/andalusite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al&lt;sub&gt;2&lt;/sub&gt;SiO&lt;sub&gt;5&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-217</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:217:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-217.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al&lt;sub&gt;2&lt;/sub&gt;SiO&lt;sub&gt;5&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050258 | R050449 | R050561 | R050626 | R060197 | R060212</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Andalusite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Andalusite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Delamétherie J C (1798) Sur une pierre de l'andalousie, Journal de Physique, de Chimie et d'Histoire Naturelle et des Arts 46, 386-387</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Andalusite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AF.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with additional anions; cations in [4], [5] and/or only [6] coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Andalusite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1798</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/gismondine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
