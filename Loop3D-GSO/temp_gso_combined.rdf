    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Syenitic_Rock"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/chlormanganokalite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
