    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Saamite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Saamite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Cámara F, Sokolova E, Abdu Y A, Hawthorne F C (2014) Saamite, Ba[box]TiNbNa_3_Ti(Si_2_O_7_)_2_O_2_(OH)_2_(H_2_O)_2_, a group-III Ti-disilicate mineral from the Khibiny alkaline massif, Kola Peninsula, Russia: description and crystal structure. The Canadian Mineralogist 52, 745-761</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Seidozerite-Lamprophyllite</gsmin:structuralgroup>
