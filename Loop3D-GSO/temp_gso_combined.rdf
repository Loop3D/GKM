  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/nanlingite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Nanlingite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Li | Mg | As | O | Fe | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/nanlingite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na(Ca&lt;sub&gt;5&lt;/sub&gt;Li)Mg&lt;sub&gt;12&lt;/sub&gt;(AsO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;[Fe&lt;sup&gt;2+&lt;/sup&gt;(AsO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;]F&lt;sub&gt;14&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2838</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2838:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2838.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaCa&lt;sub&gt;5&lt;/sub&gt;LiMg&lt;sub&gt;12&lt;/sub&gt;(As&lt;sup&gt;3+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;[Fe&lt;sup&gt;2+&lt;/sup&gt;(As&lt;sup&gt;3+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;]F&lt;sub&gt;14&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nanlingite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Nanlingite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Gu X, Ding K, Xu Y (1976) Nanlingite - A new arsenite mineral from southern China, Geochimica 2, 107-112 Chemical formula revised: Fleischer M, Pabst A, Mandarino J A, Chao G Y (1977) New mineral names, American Mineralogist 62, 1057-1061 Chemical formula revised again: Yang Z, Giester G, Ding K, Tillmanns E (2011) Crystal structure of nanlingite - the first mineral with a [Fe(AsO3)6] configuration, European Journal of Mineralogy 23, 63-71</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.JB.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Arsenite, antimonite, bismuthite; with additional anions, without H2O</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Nanlingite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1976</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/hochelagaite">
