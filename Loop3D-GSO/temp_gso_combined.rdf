    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K(MgAl&lt;sub&gt;2&lt;/sub&gt;)(Al&lt;sub&gt;5&lt;/sub&gt;Mg)(BO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;)(OH)&lt;sub&gt;3&lt;/sub&gt;O</gsmin:imachemistry>
