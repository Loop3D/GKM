  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/woodruffite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Woodruffite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Zn | Mn | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/woodruffite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sub&gt;2&lt;/sub&gt;(Mn&lt;sup&gt;4+&lt;/sup&gt;,Mn&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;5&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4312</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4312:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4312.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Mn&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Woodruffite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Woodruffite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Frondel C (1953) New manganese oxides: hydrohausmannite and woodruffite, American Mineralogist 38, 761-769</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.FL.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Hydroxide (without V or U), Hydroxides with H2O±(OH); sheets of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Woodruffite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1953</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Calcareous_Carbonate_Sedimentary_Rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">SLTTs 2004; Hallsworth and Knox 1999</dct:source>
    <rdfs:comment xml:lang="en">Carbonate sedimentary rock with a calcite (plus aragonite) to dolomite ratio greater than 1 to 1. Includes limestone and dolomitic limestone.</rdfs:comment>
    <rdfs:label xml:lang="en">calcareous carbonate sedimentary rock</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Calcareous_Carbonate_Sedimentary_Material"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Carbonate_Sedimentary_Rock"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2016-06-15</dct:created>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-26</dct:created>
    <dct:creator rdf:resource="https://w3id.org/gso/1.0/common/boyan_brodaric"/>
    <dct:creator rdf:resource="https://w3id.org/gso/1.0/common/stephen_richard"/>
    <dct:creator xml:lang="en">CGI Geoscience Terminology Working Group, OWL adaptation by Stephen Richard for Loop3D project</dct:creator>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/legalcode"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-26</dct:modified>
    <dct:publisher>ARC Loop3D project;  https://loop3d.org/</dct:publisher>
    <dct:publisher>Geological Survey of Canada, Natural Resources Canada, Government of Canada</dct:publisher>
    <schema:codeRepository>https://github.com/Loop3D/GKM</schema:codeRepository>
    <dct:rights>Copyright (c) 2021 Government of Canada</dct:rights>
    <rdfs:comment xml:lang="en">Taken primarily from the 2016 SKOS-RDF version of the CGI Event Process vocabulary. This scheme specifies classes for geological processes that are associated with geological events, as defined by the IUGS Commission for Geoscience Information (CGI) Geoscience Terminology Working Group.</rdfs:comment>
    <rdfs:label xml:lang="en">Geoscience Ontology, Geologic Processes</rdfs:label>
    <dct:bibliographicCitation>Brodaric, B., and Richard, S.M., 2021, The GeoScience Ontology Reference: Geological Survey of Canada Open File 8796, 34 p., https://doi.org/10.4095/328296</dct:bibliographicCitation>
    <owl:imports rdf:resource="https://w3id.org/gso/1.0/common/ontology"/>
    <owl:imports rdf:resource="https://w3id.org/gso/1.0/geology/ontology"/>
    <skos:definition xml:lang="en">Geologic processes to characterize geologic events.</skos:definition>
    <skos:prefLabel xml:lang="en">Geoscience Ontology, Geologic Processes</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kosnarite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kosnarite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Zr | P | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/kosnarite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KZr&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1991-022</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Potassium dizirconium triphosphate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2259</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2259:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2259.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KZr&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060250</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kosnarite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kosnarite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Brownfield M E, Foord E E, Sutley S J, Botinelly T (1993) Kosnarite, KZr_2_(PO_4_)_3_, a new mineral from Mount Mica and Black Mountain, Oxford County, Maine, American Mineralogist 78, 653-656</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.AC.60</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, without H2O, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Kosnarite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1991-022</gsmin:wikipediadate>
  </rdf:Description>
