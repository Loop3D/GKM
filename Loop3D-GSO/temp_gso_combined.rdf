    <gsmin:statusnotes xml:lang="en">Yang, H., Gu, X., Downs, R.T. and Xie, X. (2015) Taniajacoite, IMA 2014-107. CNMNC Newsletter No. 25, June 2015, page 531; Mineralogical Magazine, 79, 529-535</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Ruizite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/surinamite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Surinamite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mg | Al | O | Si | Be</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">aenigmatite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/surinamite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;3&lt;/sub&gt;Al&lt;sub&gt;3&lt;/sub&gt;O(Si&lt;sub&gt;3&lt;/sub&gt;BeAlO&lt;sub&gt;15&lt;/sub&gt;)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1974-053</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3830</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3830:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3830.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;3&lt;/sub&gt;Al&lt;sub&gt;3&lt;/sub&gt;O[Si&lt;sub&gt;3&lt;/sub&gt;BeAlO&lt;sub&gt;15&lt;/sub&gt;]</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Surinamite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Surinamite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">De Roever E W F, Kieft C, Murray E, Klein E, Drucker W H, Moore P B (1976) Surinamite, a new Mg-Al silicate from the Bakhuis Mountains, western Surinam I. Description, occurrence, and conditions of formation II. X-ray crystallography and propsed crystal structure, American Mineralogist 61, 193-199 Chemical formula revised: DeRoever E M F, Lattard D, Schreyer W (1981) Surinamite: a beryllium-bearing mineral, Contributions to Mineralogy and Petrology 76, 472-473</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Sapphirine</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DH.55</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 4-periodic single chains, Si4O12</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Surinamite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1974-053</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/wonesite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Wonesite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | K | Mg | Fe | Al | Si | O | H | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic, monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">mica-interlayer-deficient micas</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/wonesite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,K,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)(Mg,Fe,Al)&lt;sub&gt;6&lt;/sub&gt;(Si,Al)&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;20&lt;/sub&gt;(OH,F)&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1979-007a</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4309</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4309:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4309.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,K,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)(Mg,Fe&lt;sup&gt;2+&lt;/sup&gt;,Al,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;6&lt;/sub&gt;(Si,Al)&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;20&lt;/sub&gt;(OH,F)&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Wonesite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Wonesite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Spear F S, Hazen R M, Rumble D (1981) Wonesite: a new rock-forming silicate from the Post Pond Volcanics, Vermont, American Mineralogist 66, 100-105</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Clay</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EC.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with mica sheets, composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Wonesite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1979-007a</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/astrocyanite-ce">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Astrocyanite-(Ce)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Ce | U | O | C | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/astrocyanitece.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;2&lt;/sub&gt;Ce&lt;sub&gt;2&lt;/sub&gt;(UO&lt;sub&gt;2&lt;/sub&gt;)(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;5&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·1.5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1989-032</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-404</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:404:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-404.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Ce&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;5&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·1.5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Astrocyanite-(Ce)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Astrocyanite-(Ce)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Deliens M, Piret P (1990) L'astrocyanite-(Ce), Cu&lt;sub&gt;2&lt;/sub&gt;(TR)&lt;sub&gt;2&lt;/sub&gt;(UO&lt;sub&gt;2&lt;/sub&gt;)(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;5&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·1,5 H&lt;sub&gt;2&lt;/sub&gt;O, nouvelle espèce minérale de Kamoto, Shaba, Zaïre, European Journal of Mineralogy 2, 407-411</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.EF.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl Carbonate, UO2:CO3 = 1:5</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Astrocyanite-%28Ce%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1989-032</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/gotzenite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Götzenite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Na | Ti | Si | O | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">rosenbuschite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/gotzenite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;4&lt;/sub&gt;NaCa&lt;sub&gt;2&lt;/sub&gt;Ti(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OF)F&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:mindatid>min-1760</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1760:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1760.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;4&lt;/sub&gt;NaCa&lt;sub&gt;2&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OF)F&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070449 | R130110 | R140781 | R141182</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Götzenite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Gotzenite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Sahama T G, Hytönen K (1957) Götzenite and combeite, two new silicates from the Belgian Congo, Mineralogical Magazine 31, 503-510 Chemical formula revised from Na_2_Ca_5_Ti(Si_2_O_7_)_2_(F,OH)_4_: Sokolova E (2006) From structure topology to chemical composition. I. Structural hierarchy and stereochemistry in titanium disilicate minerals. The Canadian Mineralogist 44, 1273-1330</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Seidozerite-Rinkite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.BE.22</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate: Si2O7 groups, with additional anions; cations in octahedral [6] and greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Gotzenite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1957</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/mammothite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Mammothite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Cu | Al | Sb | O | S | Cl | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/mammothite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;6&lt;/sub&gt;Cu&lt;sub&gt;4&lt;/sub&gt;AlSb&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;Cl&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;16&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1983-076a</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2556</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2556:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2556.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;AlSb&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;Cl&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;16&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R130100</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mammothite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Mammothite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Peacor D R, Dunn P J, Schnorrer-Köhler G, Bideaux R A (1985) Mammothite a new mineral from Tiger, Arizona and Laurium, Greece, The Mineralogical Record 16, 117-120</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.BC.60</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions, without H2O, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Mammothite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1983-076a</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/nolzeite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Nolzeite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Mn | Si | B | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na(Mn,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)&lt;sub&gt;2&lt;/sub&gt;[Si&lt;sub&gt;3&lt;/sub&gt;(B,Si)O&lt;sub&gt;9&lt;/sub&gt;](OH)&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2014-086</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na(Mn&lt;sup&gt;2+&lt;/sup&gt;,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)&lt;sub&gt;2&lt;/sub&gt;[Si&lt;sub&gt;3&lt;/sub&gt;(B,Si)O&lt;sub&gt;9&lt;/sub&gt;](OH)&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nolzeite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Nolzeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Haring M M M, McDonald A M (2017) Nolzeite, Na(Mn,[box])_2_[Si_3_(B,Si)O_9_(OH)_2_]·2H_2_O, a new pyroxenoid mineral from Mont Saint-Hilaire, Québec, Canada. Mineralogical Magazine 81, 183-197</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/agardite-y">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Agardite-(Y)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Y | Cu | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">mixite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/agarditey.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">YCu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1968-021</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-44</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:44:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-44.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;Y&lt;sup&gt;3+&lt;/sup&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060711 | R060924 | R070357 | R070649</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Agardite-(Y)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Agardite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Dietrich J E, Orliac M, Permingeat F (1969) L’agardite, une nouvelle espèce minérale, et le problème du chlorotile, Bulletin de la Société Française de Minéralogie et de Cristallographie 92, 420-434 Name changed from agardite: Nickel E H, Mandarino J A (1987) Procedures involving the IMA Commission on New Minerals and Mineral Names and guidelines on mineral nomenclature, American Mineralogist 72, 1031-1042</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Mixite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DL.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 = 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Agardite-%28Y%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1968-021</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/armstrongite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Armstrongite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Zr | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/armstrongite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaZr(Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;15&lt;/sub&gt;)·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1972-018</gsmin:imanumber>
