    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Iwashiroite-(Y)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Iwashiroite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hori H, Kobayashi T, Miyawaki R, Matsubara S, Yokoyama K, Shimizu M (2006) Iwashiroite-(Y), YTaO_4_, a new mineral from Suishoyama, Kawamata Town, Fukushima Prefecture, Japan, Journal of Mineralogical and Petrological Sciences 101, 170-177</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.GA.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Molybdate, Wolframate or Niobate, Without additional anions or H2O</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Iwashiroite-%28Y%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2003-053</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/borcarite">
