    <gsmin:webmineralurl>http://www.webmineral.com/data/Ikaite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1962-005</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/prismatine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Prismatine</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mg | Al | Fe | Si | B | O | H | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Mg,Al,Fe)&lt;sub&gt;6&lt;/sub&gt;Al&lt;sub&gt;4&lt;/sub&gt;(Si,Al)&lt;sub&gt;4&lt;/sub&gt;(B,Si,Al)(O,OH,F)&lt;sub&gt;22&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:mindatid>min-7252</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7252:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7252.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Mg,Al,Fe&lt;sup&gt;2+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;6&lt;/sub&gt;Al&lt;sub&gt;4&lt;/sub&gt;(Si,Al)&lt;sub&gt;4&lt;/sub&gt;(B,Si,Al)(O,OH,F)&lt;sub&gt;22&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Prismatine</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Prismatine</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Sauer A (1886) Über eine eigenthümliche Granulitart als Muttergestein zweier neuer Mineralspecies, Zeitschrift der Deutschen Geologischen Gesellschaft 38, 704-706 Determined to be identical to kornerupine, so it was discredited: Ussing N V (1889) Untersuchungen der Mineralien von Fiskernäs in Grönland, Zeitschrift für Krystallographie und Mineralogie 15, 596-615 Revalidated and redefined: Grew E S, Cooper M A, Hawthorne F C (1996) Prismatine: revalidation for boron-rich compositions in the kornerupine group, Mineralogical Magazine 60, 483-491</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.BJ.50</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate with Si3O10, Si4O11, etc. anions; cations in octahedral [6] and greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Prismatine.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1886</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/quenselite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
