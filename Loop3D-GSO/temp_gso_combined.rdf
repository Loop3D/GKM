    <gsmin:rruffnameplain xml:lang="en">Kenoplumbomicrolite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Atencio D, Andrade M B, Bindi L, Bonazzi P, Zoppi M, Stanley C J, Kristiansen R (2018) Kenoplumbomicrolite, (Pb,[box])_2_Ta_2_O_6_[[box],(OH),O], a new mineral from Ploskaya, Kola Peninsula, Russia. Mineralogical Magazine 82, 1049-1055</gsmin:statusnotes>
