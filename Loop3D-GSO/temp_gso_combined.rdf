    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dicalcium ironII diphosphate tetrahydrate</gsmin:iupacchemname>
