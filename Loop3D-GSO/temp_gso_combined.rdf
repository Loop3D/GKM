    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">wodginite</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;TiTa&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;8&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1998-028</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-6944</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:6944:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-6944.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;Ta&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;8&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ferrotitanowodginite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ferrotitanowodginite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Galliski M A, Cerný P, Márquez-Zavalía M F, Chapman R (1999) Ferrotitanowodginite, Fe^2+^TiTa_2_O_8_, a new mineral of the wodginite group from the San Elías pegmatite, San Luis, Argentina, American Mineralogist 84, 773-777</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Wodginite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.DB.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With medium-sized cations; chains of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Ferrotitanowodginite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1998-028</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/millisite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Millisite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Al | P | O | H</gsmin:chemistryelements>
    <gsmin:fleischersgroup xml:lang="en">wardite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/millisite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaCaAl&lt;sub&gt;6&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;9&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Sodium calcium hexaaluminium tetraphosphate nonahydroxyl trihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2712</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2712:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2712.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaCaAl&lt;sub&gt;6&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;9&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Millisite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Millisite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Larsen E S, Shannon E V (1930) The minerals of the phosphate nodules from near Fairfield, Utah, American Mineralogist 15, 307-337</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Wardite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DL.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 = 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Millisite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1930</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/marcobaldiite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Marcobaldiite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Sb | As | Bi | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;12&lt;/sub&gt;(Sb&lt;sub&gt;3&lt;/sub&gt;As&lt;sub&gt;2&lt;/sub&gt;Bi)&lt;sub&gt;S6&lt;/sub&gt;S&lt;sub&gt;21&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2015-109</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;12&lt;/sub&gt;(Sb&lt;sub&gt;3&lt;/sub&gt;As&lt;sub&gt;2&lt;/sub&gt;Bi)S&lt;sub&gt;21&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Marcobaldiite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Marcobaldiite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Biagioni C, Pasero M, Moëlo Y, Zaccarini F, Paar W H (2018) Lead-antimony sulfosalts from Tuscany (Italy). XXII. Marcobaldiite, ~Pb_12_(Sb_3_As_2_Bi)_S6_S_21_, a new member of the jordanite homologous series from the Pollone mine, Valdicastello Carducci. European Journal of Mineralogy 30, 581-591</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Geocronite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Aeolian_Process_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI Event Environment vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Sedimentary setting in which wind is the dominant process producing, transporting, and depositing sediment. Typically has low-relief plain or piedmont slope physiography.</rdfs:comment>
    <rdfs:label xml:lang="en">aeolian process setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Subaerial_Setting"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Terrestrial_Setting"/>
  </rdf:Description>
