    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1483:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1483.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Na,K)&lt;sub&gt;0.9&lt;/sub&gt;(V&lt;sup&gt;5+&lt;/sup&gt;,V&lt;sup&gt;4+&lt;/sup&gt;,Fe&lt;sup&gt;2+&lt;/sup&gt;,Ti&lt;sup&gt;4+&lt;/sup&gt;)&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;20&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070694</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fernandinite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Fernandinite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Schaller W T (1915) Four new minerals, Journal of the Washington Academy of Sciences 5, 7-7 Discredited: Bayliss P, Freeman K J (1989) Mineral nomenclature: fernandinite, Mineralogical Magazine 53, 511 Revalidated: Evans H T, Post J E, Ross D R, Nelen J A (1994) The crystal structure and crystal chemistry of fernandinite and corvusite, The Canadian Mineralogist 32, 339-351</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Straczekite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.HE.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">V[5,6] Vanadate, Phyllovanadates</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Fernandinite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1915</gsmin:wikipediadate>
