    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:29090:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-29090.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;MgFe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)(SiO&lt;sub&gt;4&lt;/sub&gt;)(OH)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Julgoldite-(Mg)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Julgoldite-(Mg)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Passaglia E, Gottardi G (1973) Crystal chemistry and nomenclature of pumpellyites and julgoldites, The Canadian Mineralogist 12, 219-223</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Pumpellyite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.BG.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate with mixed SiO4 and Si2O7 groups; cations in octahedral [6] and greater coordination</gsmin:strunzlabel>
    <gsmin:wikipediadate>1972-003a</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/carlgieseckeite-nd">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
