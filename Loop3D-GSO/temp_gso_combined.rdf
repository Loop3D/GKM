    <gsmin:rruffnameplain xml:lang="en">Chloraluminite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named chloralluminio (page 43): Scacchi A (1873) Contribuzoni mineralogiche per servire alla storia dell’ incendio Vesuviano del Mese di Aprile, 1872. Part 2., Reale Accademia delle Scienze Fisische e Matematiche (Naples) 1-69</gsmin:statusnotes>
    <gsmin:strunzcodeV10>03.BC.05</gsmin:strunzcodeV10>
