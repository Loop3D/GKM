    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba&lt;sub&gt;3&lt;/sub&gt;NaFe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;8&lt;/sub&gt;Ti&lt;sub&gt;4&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;F&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2009-011</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Redefined|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-39451</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:39451:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-39451.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba&lt;sub&gt;3&lt;/sub&gt;NaFe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;8&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;F&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cámaraite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Camaraite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Sokolova E, Abdu Y, Hawthorne F C, Stepanov A V, Bekenova G K, Kotel'nikov P E (2009) Cámaraite, Ba&lt;sub&gt;3&lt;/sub&gt;NaTi&lt;sub&gt;4&lt;/sub&gt;(Fe&lt;sup&gt;2+&lt;/sup&gt;,Mn)&lt;sub&gt;8&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH,F)&lt;sub&gt;7&lt;/sub&gt;. I. A new Ti-silicate mineral from the Verkhnee Espe Deposit, Akjailyautas Mountains, Kazakhstan, Mineralogical Magazine 73, 847-854</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Seidozerite-Bafertisite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.B?.</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate</gsmin:strunzlabel>
    <gsmin:wikipediadate>2009-011</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Syenogranite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Granite that has a plagiolcase to total feldspar ratio between 0.10 and 0.35. QAPF field 3a.</rdfs:comment>
    <rdfs:label xml:lang="en">syenogranite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Granite"/>
