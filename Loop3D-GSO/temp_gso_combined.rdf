  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/parabutlerite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Parabutlerite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Fe | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/parabutlerite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;3+&lt;/sup&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)(OH)·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: IronIII sulfate hydroxyl dihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-3081</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3081:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3081.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;3+&lt;/sup&gt;S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH)·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060754 | R070547 | R110161</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Parabutlerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Parabutlerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Bandy M C (1938) Mineralogy of three sulphate deposits of Northern Chile, American Mineralogist 23, 669-760</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.DC.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With only medium-sized cations; chains of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Parabutlerite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1938</gsmin:wikipediadate>
