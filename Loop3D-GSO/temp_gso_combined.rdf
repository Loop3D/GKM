  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/paratsepinite-na">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Paratsepinite-Na</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Sr | K | Ca | Ti | Nb | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">labuntsovite</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,Sr,K,Ca)&lt;sub&gt;2&lt;/sub&gt;(Ti,Nb)&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;)(O,OH)&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2003-008</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-27504</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:27504:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-27504.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,Sr,K,Ca)&lt;sub&gt;2&lt;/sub&gt;(Ti&lt;sup&gt;4+&lt;/sup&gt;,Nb&lt;sup&gt;5+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;)(O,OH)&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Paratsepinite-Na</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Paratsepinite-Na</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Organova N I, Krivovichev S V, Shlyukova Z V, Zadov A E, Rozhdestvenskaya I V, Ivanova T I (2004) Structure of the new mineral paratsepinite-Na and its place in the labuntsovite group, Crystallography Reports 49, 946-952</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Labuntsovite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CE.30b</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si4O12]8- 4-membered single rings (vierer-Einfachringe), without insular complex anions</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Paratsepinite-Na.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2003-008</gsmin:wikipediadate>
  </rdf:Description>
