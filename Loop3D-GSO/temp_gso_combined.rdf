    <gsmin:rruffnameplain xml:lang="en">Morrisonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf A R, Hughes J M, Nash B P, Marty J (2016) Vanarsite, packratite, morrisonite, and gatewayite: Four new minerals containing the [As^3+^V^4+,5+^_12_As^5+^_6_O_51_] heteropolyanion, a novel polyoxometalate cluster. The Canadian Mineralogist 54, 145-162</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/heinrichite">
