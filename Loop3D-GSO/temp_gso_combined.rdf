    <gsmin:rruffnameplain xml:lang="en">Tsaregorodtsevite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pautov L A, Karpenko V Y, Sokolova E V, Ignatenko K I (1993) Tsaregorodtsevite N(CH_3_)_4_[Si_2_(Si_0.5_Al_0.5_)O_6_]_2_ - a new mineral, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 128(1), 128-135</gsmin:statusnotes>
