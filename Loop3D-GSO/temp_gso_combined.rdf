    <gsmin:mindaturl>http://www.mindat.org/min-11461.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KNa&lt;sub&gt;2&lt;/sub&gt;LiMn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;V&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Watatsumiite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Watatsumiite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Matsubara S, Miyawaki R, Kurosawa M, Suzuki Y (2003) Watatsumiite, KNa_2_LiMn_2_V_2_Si_8_O_24_, a new mineral from the Tanohata mine, Iwate Prefecture, Japan, Journal of Mineralogical and Petrological Sciences 98, 142-150</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Neptunite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EH.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Transitional structure between phyllosilicate and other silicate units</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Watatsumiite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2001-043</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/harstigite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Harstigite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Be | Mn | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/harstigite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;6&lt;/sub&gt;Be&lt;sub&gt;4&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1822</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1822:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1822.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;6&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;Be&lt;sub&gt;4&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Harstigite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Harstigite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Flink G (1886) Harstigit från Pajsberg, Bihang till Kongl. Svenska Vetenskaps-Akademiens Handlingar 12, 59-63</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.BF.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate with mixed SiO4 and Si2O7 groups; cations in tetrahedral [4] and greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Harstigite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1886</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/cuprobismutite">
