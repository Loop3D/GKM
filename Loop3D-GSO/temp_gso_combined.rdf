  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/nimite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Nimite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/mineral/chloritegroup"/>
    <gsmin:chemistryelements>Ni | Mg | Al | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">chlorite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/nimite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ni,Mg,Al)&lt;sub&gt;6&lt;/sub&gt;(Si,Al)&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;8&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2905</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2905:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2905.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ni&lt;sup&gt;2+&lt;/sup&gt;,Mg,Al)&lt;sub&gt;6&lt;/sub&gt;(Si,Al)&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;8&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nimite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Nimite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hiemstra S A, De Waal S A (1968) Nickel minerals from Barberton, II. Nimite, a nickelian chlorite. National Institute of Metallurgy (South Africa) Research Report 344, 1-10</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Clay</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EC.55</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with mica sheets, composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Nimite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1969-012</gsmin:wikipediadate>
