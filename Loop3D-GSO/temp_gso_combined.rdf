    <gsmin:webmineralurl>http://www.webmineral.com/data/Uramarsite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2005-043</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/yingjiangite">
