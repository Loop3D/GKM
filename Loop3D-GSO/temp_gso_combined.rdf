    <gsmin:statusnotes xml:lang="en">Yang G, Li G, Xiong M, Pan B, Yan C (2014) Hydroxycalciopyrochlore, a new mineral species from Sichuan, China. Acta Geologica Sinica 88, 748-753</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Pyrochlore-Pyrochlore</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, hydroxide or arsenite</gsmin:strunzlabel>
    <gsmin:wikipediadate>2011-026</gsmin:wikipediadate>
