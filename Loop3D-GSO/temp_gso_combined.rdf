    <gsmin:wikipediadate>1992-033</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/scawtite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Scawtite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Si | O | C | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/scawtite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;7&lt;/sub&gt;(Si&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;9&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3552</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3552:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3552.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;7&lt;/sub&gt;(Si&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;9&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060340</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Scawtite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Scawtite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Tilley C E, Hey M H (1930) Scawtite, a new mineral from Scawt Hill, Co. Antrim, Mineralogical Magazine 22, 222-224</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.CK.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si6O18]12- 6-membered single rings, with insular complex anions</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Scawtite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1930</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/zirkelite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Zirkelite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ti | Ca | Zr | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal, monoclinic, amorphous</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/zirkelite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ti,Ca,Zr)O&lt;sub&gt;2-x&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Redefined|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4425</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4425:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4425.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ti&lt;sup&gt;4+&lt;/sup&gt;,Ca,Zr&lt;sup&gt;4+&lt;/sup&gt;)O&lt;sub&gt;2-x&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060540 | R080083</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zirkelite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Zirkelite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hussak E, Prior G T (1895) Lewisite and zirkelite, two new Brazilian minerals, Mineralogical Magazine 11, 80-88 Chemical formula redefined from CaZrTi_2_O_7_ to a fluorite format: Sinclair W, Eggleton R A (1982) Structure refinement of zirkelite from Kaiserstuhl, West Germany, American Mineralogist 67, 615-620</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Fluorite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.DL.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With large (+- medium-sized) cations; fluorite-type structures</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Zirkelite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1895</gsmin:wikipediadate>
  </rdf:Description>
