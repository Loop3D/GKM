  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/bauranoite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Bauranoite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ba | U | O | H</gsmin:chemistryelements>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/bauranoite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaU&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;·4-5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1971-052</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Barium diuranium heptaoxide 4-5hydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-574</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:574:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-574.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaU&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;·4-5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bauranoite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Bauranoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Rogova V P, Belova L N, Kiziyarov G N, Kuznetsova N N (1973) Bauranoite and metacaltsuranoite [metacalciouranoite] - new minerals of the group of hydrous uranium oxides, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 102(1), 75-81</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Wölsendorfite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.GB.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl hydroxide, With additional cations (K, Ca, Ba, Pb, etc.); with mainly UO2(O,OH)5 pentagonal polyhedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Bauranoite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1971-052</gsmin:wikipediadate>
  </rdf:Description>
