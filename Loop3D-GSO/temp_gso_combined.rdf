  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Cave_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al., 2005</dct:source>
    <rdfs:comment xml:lang="en">A natural underground open space, it generally has a connection to the surface, is large enough for a person to enter, and extends into darkness. The most common type of cave is formed in limestone by dissolution.</rdfs:comment>
    <rdfs:label xml:lang="en">cave setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Planet_Surface_Setting"/>
  </rdf:Description>
