    <gsmin:mindaturl>http://www.mindat.org/min-7360.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Fe&lt;sup&gt;3+&lt;/sup&gt;,Te&lt;sup&gt;6+&lt;/sup&gt;,Ti&lt;sup&gt;4+&lt;/sup&gt;,Mg)Te&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;8&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Walfordite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Walfordite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Back M E, Grice J D, Gault R A, Criddle A J, Mandarino J A (1999) Walfordite, a new tellurite species from the Wendy open pit, El Indio-Tambo mining property, Chile, The Canadian Mineralogist 37, 1261-1268</gsmin:statusnotes>
