  <rdf:Description rdf:about="http://qudt.org/vocab/unit/KiloGM-PER-M3">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://qudt.org/2.1/vocab/unit"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Unit_Of_Measure_Value"/>
    <skos:altLabel xml:lang="en-us">kilogram per cubic meter</skos:altLabel>
    <skos:definition xml:lang="en">Kilogram per cubic metre is an SI derived unit of density, defined by mass in kilograms divided by volume in cubic metres. The official SI symbolic abbreviation is \(kg \cdot m^{-3}\), or equivalently either \(kg/m^3\).</skos:definition>
    <skos:prefLabel xml:lang="en">kilogram per cubic metre</skos:prefLabel>
  </rdf:Description>
