    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sicklerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Sicklerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Schaller W T (1912) New manganese phosphates from the gem tourmaline field of Southern California, Journal of the Washington Academy of Sciences 2, 143-145</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Olivine</gsmin:structuralgroup>
