    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">MoO&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1979-072</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: MolybdeniumIV oxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-4043</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4043:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4043.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mo&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R100218</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tugarinovite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tugarinovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kruglova V G, Poteryaikina A A, Sidorenko G A, Dubakina L S, Ryabeva E G (1980) Tugarinovite, (MoO_2_), a new hypogene molybdenum mineral, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 109(4), 465-468</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Rutile</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.DB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With medium-sized cations; chains of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Tugarinovite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1979-072</gsmin:wikipediadate>
  </rdf:Description>
