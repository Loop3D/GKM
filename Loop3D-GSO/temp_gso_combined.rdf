  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/sedovite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Sedovite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>U | Mo | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/sedovite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">U&lt;sup&gt;4+&lt;/sup&gt;(MoO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: UraniumIV dimolybdate</gsmin:iupacchemname>
    <gsmin:mindatid>min-3602</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3602:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3602.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">U&lt;sup&gt;4+&lt;/sup&gt;(Mo&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sedovite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Sedovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Skvortsova K V, Sidorenko G A (1965) Sedovite, a new supergene mineral of uranium and molybdenum, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 94, issue 5, 548-554</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.HA.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranium or uranyl molybdate or wolframate, With U4+</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Sedovite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1965</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/cesplumtantite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cesplumtantite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cs | Pb | Ta | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">pyrochlore</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/cesplumtantite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cs&lt;sub&gt;2&lt;/sub&gt;Pb&lt;sub&gt;3&lt;/sub&gt;Ta&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1985-040</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dicaesium trilead octatantalum tetracosaoxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-941</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:941:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-941.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cs&lt;sub&gt;2&lt;/sub&gt;Pb&lt;sub&gt;3&lt;/sub&gt;Ta&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cesplumtantite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cesplumtantite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Voloshin A V, Pakhomovskii Y A, Bakhchisaraitsev A Y, Devnina N N (1986) Cesplumtantite - A new cesium-lead tantalate from granitic pegmatites, Mineralogiceskij Zhurnal 8, 92-98</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.DM.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With large (+- medium-sized) cations; unclassified</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Cesplumtantite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1985-040</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/pseudosinhalite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Pseudosinhalite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mg | Al | B | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/pseudosinhalite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;3&lt;/sub&gt;B&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;9&lt;/sub&gt;(OH)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1997-014</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
