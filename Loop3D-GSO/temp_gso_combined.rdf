  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologiclineation/rodding_lineation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Jackson 1997</dct:source>
    <rdfs:comment xml:lang="en">Linear structure in metamorphic rocks in which the stronger parts have been shaped into parallel rods (eg. vein quartz)</rdfs:comment>
    <rdfs:label xml:lang="en">rodding lineation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologiclineation/tectonic_lineation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Blanket_Bog_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">1-GE WP3; Neuendorf et al.(2005), p. 675</dct:source>
    <rdfs:comment xml:lang="en">Topogeneous bog/peat whose moisture content is largely dependent on surface water. It is relatively rich in plant nutrients, nitrogen, and mineral matter, is mildly acidic to nearly neutral, and contains little or no cellulose, forms in topographic depressions with essential stagnat or non-moving minerotrophic water supply</rdfs:comment>
    <rdfs:label xml:lang="en">blanket bog</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Bog_Setting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/cacoxenite">
