    <gsmin:wikipediadate>2001-013</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/volkonskoite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Volkonskoite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Cr | Mg | Si | Al | O | H</gsmin:chemistryelements>
    <gsmin:fleischersgroup xml:lang="en">smectite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/volkonskoite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;0.3&lt;/sub&gt;(Cr,Mg)&lt;sub&gt;2&lt;/sub&gt;(Si,Al)&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:mindatid>min-4201</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4201:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4201.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;0.3&lt;/sub&gt;(Cr&lt;sup&gt;3+&lt;/sup&gt;,Mg)&lt;sub&gt;2&lt;/sub&gt;(Si,Al)&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Volkonskoite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Volkonskoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named wolchonskoit: Kämmerer A (1831) Mittheilungen an den Geheimen Rath v. Leonhard gerichtet, Jahrbuch für Mineralogie, Geognosie, Geologie und Petrefaktenkunde 2, 420-420 Redefined: Foord E F, Starkey H C, Taggart J E, Shawe D R (1987) Reassessment of the volkonskoite-chromian smectite nomenclature problem, Clays and Clay Minerals 35, 139-149</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Smectite-vermiculite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EC.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with mica sheets, composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Volkonskoite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1831</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/vranaite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Vránaite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Al | B | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al&lt;sub&gt;16&lt;/sub&gt;B&lt;sub&gt;4&lt;/sub&gt;Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;38&lt;/sub&gt;</gsmin:imachemistry>
