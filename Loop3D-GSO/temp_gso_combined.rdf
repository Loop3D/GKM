  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Cutoff_Meander_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al., 2005</dct:source>
    <rdfs:comment xml:lang="en">The abandoned, bow- or horseshoe-shaped channel of a former meander, left when the stream formed a cutoff across a narrow meander neck. Note that these are typically lakes, thus also lacustrine.</rdfs:comment>
    <rdfs:label xml:lang="en">cutoff meander setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/River_Plain_System_Setting"/>
    <rdfs:subClassOf rdf:nodeID="nb91377c629b1476ba973ba249cd56575b16"/>
  </rdf:Description>
