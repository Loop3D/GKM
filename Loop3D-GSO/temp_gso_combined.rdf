    <gsmin:imanumber xml:lang="en">IMA1975-005a</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Trilead tricopper heptabismuth pentadecasulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-2408</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2408:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2408.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;3&lt;/sub&gt;Cu&lt;sub&gt;3&lt;/sub&gt;Bi&lt;sub&gt;7&lt;/sub&gt;S&lt;sub&gt;15&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Lindströmite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Lindstromite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Johansson K (1924) Bidrag till Gladhammar-gruvornas mineralogi, Arkiv för Kemi, Mineralogi och Geologi 9, 1-22 Redefined in: Mumme W G, Welin E, Wuensch B J (1976) Crystal chemistry and proposed nomenclature for sulfosalts intermediate in the system bismuthinite-aikinite (Bi_2_S_3_ - CuPbBiS_3_), American Mineralogist 61, 15-20</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Meneghinite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.HB.05a</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">SnS type sulfosalt with Cu, Ag, Fe, Sn and Pb</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Lindstromite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1975-005a</gsmin:wikipediadate>
  </rdf:Description>
