  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/red_rock_altered_rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI alterationtype SKOS vocabulary 2012-11-24</dct:source>
    <dct:source>Williams, P.J., 1994, Aust. J. Earth Science, v41, p381-382</dct:source>
    <rdfs:comment xml:lang="en">Alteration characterized by finely dispersed hematite</rdfs:comment>
    <rdfs:label xml:lang="en">red rock altered rock</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/altered_rock"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Argillite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al, 2004, provisional SMR 2020-06-11</dct:source>
    <rdfs:comment xml:lang="en">A weakly metamorphosed argillaceous rock (Flawn, 1953, AAPG Bull v37 p.563-664).  Rock is very fine-grained to aphanitic, compact, indurated, and massive (lacks fissility or cleavage) (Neuendorf et al, 2004). Claystone and Siltstone are related, non-metamorphosed sedimentary rocks. Like Aphanite but sedimentary protolith is determined. In contact metamorphic environments would be Hornfels.</rdfs:comment>
    <rdfs:label xml:lang="en">Argillite </rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Metamorphic_Rock"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb26e920196f4af8bbd263b193e6f242b818">
