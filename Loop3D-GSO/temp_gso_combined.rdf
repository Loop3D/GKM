    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3181:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3181.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;(P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R050224</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Phosphophyllite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Phosphophyllite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Laubmann H, Steinmetz H (1920) Phosphatführende pegmatite des Oberpfälzer und Bayerischen Waldes, Zeitschrift für Krystallographie und Mineralogie 55, 523-586 Chemical formula redefined: Foshag W F (1928) New mineral names, American Mineralogist 13, 32-34</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Phosphophyllite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CA.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With small and large/medium cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Phosphophyllite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1920</gsmin:wikipediadate>
