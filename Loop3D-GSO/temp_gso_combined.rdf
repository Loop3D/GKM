    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3182:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3182.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KCa(H&lt;sub&gt;3&lt;/sub&gt;O)&lt;sub&gt;3&lt;/sub&gt;(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;7&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R050470 | R110155 | R130108</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Phosphuranylite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Phosphuranylite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Genth F A (1879) Examination of the North Carolina uranium minerals, American Chemical Journal 1, 87-93 Chemical formula redefined: Demartin F, Diella V, Donzelli S, Gramaccioli C M, Pilati T (1991) The importance of accurate crystal structure determination of uranium minerals. I. phosphuranylite KCa(H3O)3(UO2)7(PO4)4O4·8H2O, Acta Crystallographica B47, 439-446</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Phosphuranylite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.EC.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl phosphate or arsenate, UO2:RO4 = 3:2</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Phosphuranylite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1879</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/eztlite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Eztlite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Fe | Te | O | S | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
