    <gsmin:wikipediadate>2002-021</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ferro-ferri-pedrizite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
