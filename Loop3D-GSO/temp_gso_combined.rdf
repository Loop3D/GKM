    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Cu | Ti | O | As | F | Cl</gsmin:chemistryelements>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;18&lt;/sub&gt;Cu&lt;sub&gt;12&lt;/sub&gt;TiO&lt;sub&gt;8&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;8&lt;/sub&gt;FCl&lt;sub&gt;5&lt;/sub&gt;</gsmin:imachemistry>
