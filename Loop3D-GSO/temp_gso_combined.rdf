    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba&lt;sub&gt;4&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;,Ti&lt;sup&gt;4+&lt;/sup&gt;)&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;[B&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;27&lt;/sub&gt;]Cl&lt;sub&gt;0-1&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R110043 | R160011</gsmin:rruffids>
