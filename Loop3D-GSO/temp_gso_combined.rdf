    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:37645:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-37645.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba&lt;sub&gt;5&lt;/sub&gt;(Ca,Y&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;22&lt;/sub&gt;(Ti&lt;sup&gt;4+&lt;/sup&gt;,Nb&lt;sup&gt;5+&lt;/sup&gt;)&lt;sub&gt;18&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;,SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(BO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;9&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;((OH),F)&lt;sub&gt;43&lt;/sub&gt;·1.5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Byzantievite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Byzantievite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Sokolova E, Hawthorne F C, Pautov L A, Agakhanov A A (2010) Byzantievite, Ba_5_(Ca,REE,Y)_22_(Ti,Nb)_18_(SiO_4_)_4_[(PO_4_),(SiO_4_)]_4_(BO_3_)_9_O_21_[(OH),F]_43_(H_2_O)_1.5_: the crystal structure and crystal chemistry of the only known mineral with the oxyanions (BO_3_), (SiO_4_) and (PO_4_). Mineralogical Magazine 74, 285-308</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.??</gsmin:strunzcodeV10>
