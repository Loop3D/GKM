    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>H | O | Al | As</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(H&lt;sub&gt;3&lt;/sub&gt;O)Al&lt;sub&gt;4&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·4.5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
