  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Deposition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf, K.K.E, Mehl, J.P. &amp; Jackson, J.A. (eds), 2005. Glossary of geology, 5th Edition. American Geological Institute, Alexandria, 779 p.</dct:source>
    <rdfs:comment xml:lang="en">Accumulation of material, the constructive process of accumulation of sedimentary particles, chemical precipitation of mineral matter from solution, or the accumulation of organic material on the death of plants and animals.</rdfs:comment>
    <rdfs:label xml:lang="en">deposition</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicprocess/Rock_Forming_Process"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicprocess/Sedimentary_Process"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Additive_Process"/>
  </rdf:Description>
