    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mg | U | O | F | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg[U&lt;sup&gt;5+&lt;/sup&gt;(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;F&lt;sub&gt;3&lt;/sub&gt;]·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2017-100</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Pending publication</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg[U&lt;sup&gt;5+&lt;/sup&gt;(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;F&lt;sub&gt;3&lt;/sub&gt;]·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nollmotzite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Nollmotzite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Plášil, J., Kampf, A.R., Škoda, R. and Cejka, J. (2018) Nollmotzite, IMA2017-100. CNMNC Newsletter No. 42, April 2018, page 446; Mineralogical Magazine, 82, 445–451</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/laumontite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Laumontite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Si | Al | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">zeolite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/laumontite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaAl&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2340</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2340:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2340.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca(Si&lt;sub&gt;4&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;)O&lt;sub&gt;12&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R040020 | R060114</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Laumontite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Laumontite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named lomonite by Werner: Jameson R (1805) Lomonite, System of Mineralogy II, Bell and Bradfute (Edinburgh, U.K.) 539-540 Renamed laumonite: Haüy R J (1809) Laumonite, in Tableau Comparatif des Résultats de Cristallographie et de l'Analyse Chimique Relativement á la Classification des Minéraux, Courcier (Paris, France) 195-196 Renamed laumontite: von Leonhard K C (1821) Laumontit, in Handbuch der Oryktognosie, Mohr and Winter (Heidelberg, Germany) 448-449</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.GB.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Zeolite family: Chains of single connected 4-membered rings</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://webmineral.com/data/Laumontite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1805</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/jamborite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Jamborite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ni | Co | O | H | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">spangolite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/jamborite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ni&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;1-x&lt;/sub&gt;Co&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;x&lt;/sub&gt;(OH)&lt;sub&gt;2-x&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;x&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O [x = 1/3 n; = (1-x)]</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1971-037</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2070</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2070:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2070.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ni&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;1-x&lt;/sub&gt;Co&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;x&lt;/sub&gt;(OH)&lt;sub&gt;2-x&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;x&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O [x = 1/3; n = (1-x)]</gsmin:rruffchemistry>
    <gsmin:rruffids>R070619</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Jamborite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Jamborite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Morandi N, Dalrio G (1973) Jamborite: A new nickel hydroxide mineral from the Northern Apennines, Italy, American Mineralogist 58, 835-839 Chemical formula is modified from Ni(OH,S,O)_2_·nH_2_O, and the mineral is no longer questionable: Bindi L, Christy A G, Mills S J, Ciriotti M E, Bittarello E (2015) New compositional and structural data validate the status of jamborite. The Canadian Mineralogist 53, 791-802</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hydrotalcite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.FL.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Hydroxide (without V or U), Hydroxides with H2O±(OH); sheets of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Jamborite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1971-037</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/zvyagintsevite">
