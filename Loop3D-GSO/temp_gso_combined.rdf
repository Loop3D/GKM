    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Jaskólskiite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Jaskolskiite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Zakrzewski M A (1984) Jaskólskiite, a new Pb-Cu-Sb-Bi sulfosalt from the Vena Deposit, Sweden, The Canadian Mineralogist 22, 481-485</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Meneghinite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.HB.05c</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">SnS type sulfosalt with Cu, Ag, Fe, Sn and Pb</gsmin:strunzlabel>
