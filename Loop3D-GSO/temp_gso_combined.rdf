    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al&lt;sub&gt;4+2x&lt;/sub&gt;Si&lt;sub&gt;2-2x&lt;/sub&gt;O&lt;sub&gt;10-x&lt;/sub&gt; (x ˜ 0.4)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2806</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2806:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2806.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al&lt;sub&gt;4+2x&lt;/sub&gt;Si&lt;sub&gt;2-2x&lt;/sub&gt;O&lt;sub&gt;10-x&lt;/sub&gt; (x ˜ 0.4)</gsmin:rruffchemistry>
    <gsmin:rruffids>R141101 | R141103 | R150147</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mullite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Mullite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Bowen N L, Greig J W, Zies E G (1924) Mullite, a silicate of alumina, Journal of the Washington Academy of Sciences 14, 183-191</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.AF.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with additional anions; cations in [4], [5] and/or only [6] coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Mullite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1924</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/magnesioleydetite">
