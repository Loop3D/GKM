    <gsmin:chemistryelements>Pb | Fe | As | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">adelite-descloizite-descloizite subgroup</gsmin:fleischersgroup>
