    <gsmin:chemistryelements>Ca | K | Na | Ti | Nb | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">labuntsovite</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,K,Na)&lt;sub&gt;2-x&lt;/sub&gt;(Ti,Nb)&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;)(OH,O)&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2002-020</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,K,Na)&lt;sub&gt;2-x&lt;/sub&gt;(Ti&lt;sup&gt;4+&lt;/sup&gt;,Nb&lt;sup&gt;5+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;(OH,O)&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060833</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tsepinite-Ca</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tsepinite-Ca</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pekov I V, Chukanov N V, Ferraris G, Gula A, Pushcharovsky D Yu, Zadov A E (2003) Tsepinite-Ca, (Ca,K,Na, )2(Ti,Nb)2(Si4O12)(OH,O)2· 4H2O, a new mineral of the labuntsovite group from the Khibiny alkaline massif, Kola Peninsula - Novel disordered sites in the vuoriyarvite-type structure, Neues Jahrbuch für Mineralogie, Monatshefte 2003, 461-480</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Labuntsovite</gsmin:structuralgroup>
  </rdf:Description>
