    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:40152:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-40152.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(H&lt;sub&gt;3&lt;/sub&gt;O)Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hydroniumpharmacosiderite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hydroniumpharmacosiderite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mills S J, Kampf A R, Williams P A, Leverett P, Poirier G, Raudsepp M, Francis C A (2010) Hydroniumpharmacosiderite, a new member of the pharmacosiderite supergroup from Cornwall, UK: structure and description, Mineralogical Magazine 74, 863-869</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Pharmacosiderite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DK.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 &gt; 1:1 and &lt; 2:1</gsmin:strunzlabel>
    <gsmin:wikipediadate>2010-014</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/dorrite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Dorrite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Mg | Fe | O | Si | Al</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">aenigmatite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/dorrite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;4&lt;/sub&gt;[Mg&lt;sub&gt;3&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;9&lt;/sub&gt;]O&lt;sub&gt;4&lt;/sub&gt;[Si&lt;sub&gt;3&lt;/sub&gt;Al&lt;sub&gt;8&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;O&lt;sub&gt;36&lt;/sub&gt;]</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1987-054</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1313</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1313:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1313.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;4&lt;/sub&gt;(Mg&lt;sub&gt;3&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;9&lt;/sub&gt;)O&lt;sub&gt;4&lt;/sub&gt;[Si&lt;sub&gt;3&lt;/sub&gt;Al&lt;sub&gt;8&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;O&lt;sub&gt;36&lt;/sub&gt;]</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Dorrite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Dorrite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Cosca M A, Rouse R R, Essene E J (1988) Dorrite [Ca&lt;sub&gt;2&lt;/sub&gt;(Mg&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;)(Al&lt;sub&gt;4&lt;/sub&gt;Si&lt;sub&gt;2&lt;/sub&gt;)O&lt;sub&gt;20&lt;/sub&gt;], a new member of the aenigmatite group from a pyrometamorphic melt-rock, American Mineralogist 73, 1440-1448 Chemical formula revised: Grew E S, Hålenius U, Pasero M, Barbier J (2008) Recommended nomenclature for the sapphirine and surinamite group (sapphirine supergroup), Mineralogical Magazine 72, 839-876</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Sapphirine</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DH.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 4-periodic single chains, Si4O12</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Dorrite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1987-054</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/srilankite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
