    <gsmin:chemistryelements>Na | Al | P | O | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">durangite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/lacroixite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaAl(PO&lt;sub&gt;4&lt;/sub&gt;)F</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Sodium aluminium phosphate fluoride</gsmin:iupacchemname>
    <gsmin:mindatid>min-2310</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2310:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2310.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaAl(PO&lt;sub&gt;4&lt;/sub&gt;)F</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Lacroixite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Lacroixite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Slavik M F (1914) Sur les fluorophosphates ternaires de Al_2_O_3_, RO et R_2_O (morinite, ježekite, lacroixite), Bulletin de la Société Française de Minéralogie et de Cristallographie 37, 152-162</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Titanite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BH.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH,etc.):RO4 = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Lacroixite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1914</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/velikite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Velikite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Hg | Sn | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">stannite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/velikite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;2&lt;/sub&gt;HgSnS&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1996-052</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dicopper mercury tin tetrasulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-4168</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4168:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4168.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;1+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Hg&lt;sup&gt;2+&lt;/sup&gt;Sn&lt;sup&gt;4+&lt;/sup&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Velikite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Velikite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mineral is named and reported without regard to the IMA nomenclature commission: Kaplunnik L N, Pobedimskaya E A, Belov N V (1977) Crystal structure of velikite Cu&lt;sub&gt;3.75&lt;/sub&gt;Hg&lt;sub&gt;1.75&lt;/sub&gt;Sn&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;8&lt;/sub&gt;, Soviet Physics - Crystallography 22, 99-100 Mineral is redefined and chemical formula revised: Gruzdev V S, Volgin V Y, Spiridonov E M, Kaplunnik L N, Pobedimskaya Y A, Chvileva T N, Chernitsova N M (1988) Velikite Cu_2_HgSnS - the mercury member of the stannite group. Doklady Akademii Nauk SSSR 300, 432-435 The mineral is described: Gruzdev V S, Volgin V Y, Spiridonov E M, Evstigneeva T L, Kabalov Y K, Sorokin V I, Osadchyi E G, Chvileva T N, Chernizova N M (1997) Velikite Cu&lt;sub&gt;2&lt;/sub&gt;HgSnS&lt;sub&gt;4&lt;/sub&gt; (mercurian member of the stannite group) – the new mineral, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 126(4), 71-75</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Sphalerite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.HC.05d</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">SnS type sulfosalt with only Pb</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Velikite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1996-052</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ferberite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ferberite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Fe | W | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">wolframite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/ferberite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;(WO&lt;sub&gt;4&lt;/sub&gt;)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Iron tungsten tetraoxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-1476</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1476:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1476.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;W&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R040044 | R050090 | R050632</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ferberite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ferberite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Liebe K L T (1863) Ein neuer wolframit, Neues Jahrbuch für Mineralogie, Geologie und Palaontologie 1863, 641-653</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Wolframite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.DB.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With medium-sized cations; chains of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Ferberite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1863</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/manganlotharmeyerite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Manganlotharmeyerite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Mn | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">tsumcorite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/manganlotharmeyerite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaMn&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2001-026</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Calcium dimanganeseIII diarsenate dihydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-11206</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:11206:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-11206.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaMn&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Manganlotharmeyerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Manganlotharmeyerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Brugger J, Krivovichev S V, Kolitsch U, Meisser N, Andrut M, Ansermet S, Burns P C (2002) Description and crystal structure of manganlotharmeyerite, Ca(Mn^3+^,[box],Mg)_2_{AsO_4_,[AsO_2_(OH)_2_]}_2_(OH,H_2_O)_2_, from the Starlera Mn Deposit, Swiss Alps, and a redefinition of lotharmeyerite, The Canadian Mineralogist 40, 1597-1608</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Natrochalcite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CG.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With large and medium-sized cations, RO4:H2O = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Manganlotharmeyerite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2001-026</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/stanekite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Stanekite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Fe | Mn | O | P</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">wagnerite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/stanekite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;3+&lt;/sup&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;O(PO&lt;sub&gt;4&lt;/sub&gt;)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1994-045</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: IronIII manganeseII oxyphosphate</gsmin:iupacchemname>
    <gsmin:mindatid>min-7310</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7310:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7310.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;3+&lt;/sup&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;O(PO&lt;sub&gt;4&lt;/sub&gt;)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Stanĕkite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Stanekite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Keller P, Fontan F, Velasco Roldan F, Melgarejo I Draper J C (1997) Stanêkite, Fe3+(Mn,Fe2+,Mg)(PO4)O: a new phosphate mineral in pegmatites at Karibib (Namibia) and French Pyrénées (France), European Journal of Mineralogy 9, 475-482</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Wagnerite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BB.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With only medium-sized cations, (OH, etc.):RO4 about 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Stanekite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1994-045</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/zemannite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Zemannite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mg | Zn | Fe | Te | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">zemannite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/zemannite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;0.5&lt;/sub&gt;ZnFe&lt;sup&gt;3+&lt;/sup&gt;(Te&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;·4.5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1968-009</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4392</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4392:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4392.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;0.5&lt;/sub&gt;Zn&lt;sup&gt;2+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;(Te&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;·4.5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R050273</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zemannite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Zemannite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mandarino J A, Matzat E, Williams S J (1969) Zemannite, a new tellurite mineral from Moctezum, Sonora, Mexico, The Canadian Mineralogist 10, 139-140 Chemical formula revised: Miletich R (1995) Crystal chemistry of the microporous tellurite minerals zemannite and kinichilite, Mg_0.5_[Me^2+^Fe^3+^(TeO_3_)_3_]4·5H_2_O, (Me^2+^ = Zn;Mn), European Journal of Mineralogy 7, 509-523</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Zemannite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.JM.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Tellurite without additional anions, with H2O</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Zemannite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1968-009</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/barylite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Barylite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ba | Be | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic, monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/barylite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaBe&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:mindatid>min-545</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:545:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-545.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaBe&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060606 | R060620</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Barylite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Barylite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Blomstrand C W (1876) Bidrag till kännedomen af Långbans-grufvans mineralier. B) Barylith, ett nytt mineral från Långban, Geologiska Föreningens i Stockholm Förhandlingar 3, 123-133</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.BB.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate: Si2O7 groups, without non-tetrahedral anions; cations in tetrahedral [4] and greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Barylite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1876</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/danielsite">
