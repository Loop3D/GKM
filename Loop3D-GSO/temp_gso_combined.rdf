    <gsmin:rruffids>R120120</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Goldichite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Goldichite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Rosenzweig A, Gross E B (1955) Goldichite, a new hydrous potassium ferric sulfate from the San Rafael Swell, Utah, American Mineralogist 40, 469-480</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.CC.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, with H2O, With medium-sized and large cations</gsmin:strunzlabel>
