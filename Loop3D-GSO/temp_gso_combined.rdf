    <gsmin:rruffnameplain xml:lang="en">Schulenbergite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">von Hodenberg R, Krause W, Täuber H (1984) Schulenbergit, (Cu,Zn)7(SO4,CO3)2(OH)10·3H2O, ein neues Mineral, Neues Jahrbuch für Mineralogie, Monatshefte 1984, 17-24</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Ktenasite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.DD.80</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With only medium-sized cations; sheets of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Schulenbergite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1982-074</gsmin:wikipediadate>
  </rdf:Description>
