    <gsmin:rruffnameplain xml:lang="en">Nabesite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Petersen O V, Giester G, Brandstätter F, Niedermayr G (2002) Nabesite, Na2BeSi4O10·4H2O, a new mineral species from the Ilímaussaq alkaline complex, South Greenland, The Canadian Mineralogist 40, 173-181 Jambor J L, Roberts A C (2003) New mineral names, American Mineralogist 88, 251-255</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.EA.65</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate: Single nets of tetrahedra with 4-, 5-, (6-), and 8-membered rings</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Nabesite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2000-024</gsmin:wikipediadate>
