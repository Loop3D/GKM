    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1608:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1608.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na(Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;)O&lt;sub&gt;8&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Freudenbergite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Freudenbergite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Frenzel G (1961) Ein neues mineral: Freudenbergit (Na_2_Fe_2_Ti_7_O_18_), Neues Jahrbuch für Mineralogie, Monatshefte 1961, 12-22 Chemical formula revised: McKie D, Long J V P (1970) The unit-cell contents of frudenbergite, Zeitschrift für Kristallographie 132, 157-160 Chemical formula revised from Na_2_(Ti, Fe^3+^)_8_O_16_: Ishiguro T, Tanaka K, Marumo F, Ismail M G M U, Hirano S, Somiya S (1978) Freudenbergite. Acta Crystallographica B34, 255-256</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.CC.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 2: 3,3: 5, and similar, With large and medium-sized cations</gsmin:strunzlabel>
