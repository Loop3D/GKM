  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/marshite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Marshite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | I</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">nantokite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/marshite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CuI</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Copper iodide</gsmin:iupacchemname>
    <gsmin:mindatid>min-2580</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2580:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2580.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;1+&lt;/sup&gt;I&lt;sup&gt;1-&lt;/sup&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R100001</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Marshite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Marshite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Marsh C W, Liversidge A (1892) On native copper iodide (marshite) and other minerals from Broken Hills, N. S. Wales., Journal and Proceedings of the Royal Society of New South Wales 26, 326-332</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Sphalerite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>03.AA.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Simple halides, without H2O, M:X 1:&lt;2</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Marshite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1892</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/polyphite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Polyphite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Ti | Si | O | P | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">epistolite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/polyphite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;6&lt;/sub&gt;(Na&lt;sub&gt;4&lt;/sub&gt;Ca&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;Na&lt;sub&gt;2&lt;/sub&gt;Ti&lt;sub&gt;2&lt;/sub&gt;Na&lt;sub&gt;2&lt;/sub&gt;Ti&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;F&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1990-025</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Redefined|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3262</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3262:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3262.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;6&lt;/sub&gt;(Na&lt;sub&gt;4&lt;/sub&gt;Ca&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;Na&lt;sub&gt;2&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Na&lt;sub&gt;2&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;F&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Polyphite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Polyphite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Khomyakov A P, Nechelyustov G N, Sokolova E V, Dorokhova G I (1992) Quadruphite Na_14_CaMgTi_4_[Si_2_O_7_]_2_[PO_4_]_4_O_4_F_2_ and polyphite Na_17_Ca_3_Mg(Ti,Mn)_4_[Si_2_O_7_]_2_[PO_4_]_6_O_2_F_6_ - new minerals of the lomonosovite family, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 121(1), 105-112 Chemical formula revised: Sokolova E, Hawthorne F C, Khomyakov A P (2005) Polyphite and sobolevite: Revision of their crystal structures, The Canadian Mineralogist 43, 1527-1544</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Seidozerite-Murmanite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.BE.47</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate: Si2O7 groups, with additional anions; cations in octahedral [6] and greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Polyphite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1990-025</gsmin:wikipediadate>
  </rdf:Description>
