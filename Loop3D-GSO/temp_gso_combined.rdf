  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/dingdaohengite-ce">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Dingdaohengite-(Ce)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ce | La | Fe | Ti | Mg | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">chevkinite</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ce,La)&lt;sub&gt;4&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;(Ti,Fe&lt;sup&gt;2+&lt;/sup&gt;,Mg,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;Ti&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2005-014</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-27437</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:27437:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-27437.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ce&lt;sup&gt;3+&lt;/sup&gt;,La&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;4&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;(Ti&lt;sup&gt;4+&lt;/sup&gt;,Fe&lt;sup&gt;2+&lt;/sup&gt;,Mg,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R150046</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Dingdaohengite-(Ce)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Dingdaohengite-(Ce)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Li G, Yang G, Ma Z, Shi N, Xiong M, Sheng G, Fan H (2005) The crystal structure of a new mineral dingdaohengite-(Ce), Kuangwu Xuebao 25, 313-320</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Chevkinite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.BE.70</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate: Si2O7 groups, with additional anions; cations in octahedral [6] and greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://webmineral.com/data/Dingdaohengite-(Ce).shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2005-014</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseLadinianSP2005">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologiccontact/GSSP"/>
    <dct:source xml:lang="en">Episodes 28/4, p. 233  244, 2005</dct:source>
    <rdfs:comment xml:lang="en">base of a 15 – 20cm thick limestone bed overlying a distinctive groove (“Chiesense groove”) of limestone nodules in a shaly matrix, located about 5m above the base of the Buchenstein Beds, Bagolino, Province of Brescia, Northern Italy</rdfs:comment>
    <rdfs:label xml:lang="en">GSSP Base of Ladinian</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://stratigraphy.science.purdue.edu/references/Ladinian.pdf"/>
    <rdfs:seeAlso rdf:resource="https://stratigraphy.org/gssps/"/>
    <owl:versionInfo>2005</owl:versionInfo>
  </rdf:Description>
