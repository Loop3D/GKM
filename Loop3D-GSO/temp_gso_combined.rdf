    <gsmin:rruffnameplain xml:lang="en">Ferroceladonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Li G, Peacor D R, Coombs D S, Kawachi Y (1997) Solid solution in the celadonite family: the new minerals ferroceladonite, K_2_Fe^2+^_2_Fe^3+^_2_Si_8_O_20_(OH)_4_, and ferroaluminoceladonite, K_2_Fe^2+^_2_Al_2_Si_8_O_20_(OH)_4_, American Mineralogist 82, 503-511</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Mica</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EC.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with mica sheets, composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
