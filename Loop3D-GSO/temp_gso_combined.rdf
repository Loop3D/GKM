    <gsmin:statusnotes xml:lang="en">Bindi L, Holstam D, Fatappiè G, Andersson U B, Bonazzi P (2018) Ferriperbøeite-(Ce), [CaCe_3_]_S=4_[Fe^3+^Al_2_Fe^2+^]_S=4_[Si_2_O_7_][SiO_4_]_3_O(OH)_2_, a new member of the polysomatic epidote-törnebohmite series from the Nya Bastnäs Fe-Cu-REE deposit, Sweden. European Journal of Mineralogy 30, 537-544</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Gatelite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/microsommite">
