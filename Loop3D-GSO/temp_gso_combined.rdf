  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ehrleite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ehrleite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Zn | Be | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/ehrleite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;ZnBe(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;3&lt;/sub&gt;OH)·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1983-039</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1358</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1358:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1358.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Zn&lt;sup&gt;2+&lt;/sup&gt;Be(P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;OH)·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ehrleite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ehrleite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Robinson G W, Grice J D, Van Velthuizen J (1985) Ehrleite, a new calcium beryllium zinc phosphate hydrate from the Tip Top Pegmatite, Custer, South Dakota, The Canadian Mineralogist 23, 507-510</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.CA.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With small and large/medium cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Ehrleite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1983-039</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/francoanellite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Francoanellite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Al | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/francoanellite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;3&lt;/sub&gt;Al&lt;sub&gt;5&lt;/sub&gt;(PO&lt;sub&gt;3&lt;/sub&gt;OH)&lt;sub&gt;6&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·12H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1974-051</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Tripotassium pentaaluminium hexahydrogen phosphate diphosphate dodecahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1593</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1593:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1593.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;3&lt;/sub&gt;Al&lt;sub&gt;5&lt;/sub&gt;(PO&lt;sub&gt;3&lt;/sub&gt;OH)&lt;sub&gt;6&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·12H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Francoanellite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Francoanellite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Balenzano F, Dell´Anna L, Di Pierro M (1976) Francoanellite, H_6_K_3_Al_5_(PO_4_)_8_·13H_2_O, a new mineral from the caves of Castellana, Puglia, southern Italy, Neues Jahrbuch für Mineralogie, Monatshefte 1976, 49-57 Chemical formula revised: Dick S, Zeiske T (1998) Francoanellit K_3_Al_5_(HPO_4_)_6_(PO_4_)_2_·12H_2_O: struktur und synthese durch topochemische entwässerung von taranakit, Zeitschrift für Naturforschung B Chemical Science 53, 711-719</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.CH.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With large and medium-sized cations, RO4:H2O &lt; 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Francoanellite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1974-051</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/telyushenkoite">
