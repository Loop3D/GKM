  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/natron">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Natron</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | C | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/natron.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)·10H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Disodium carbonate decahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2858</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2858:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2858.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;CO&lt;sub&gt;3&lt;/sub&gt;·10H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Natron</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Natron</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mining of the mineral goes back to Egyptian times, and the mineral name predates a formal description. For instance, the name appears in the medical literature: Wallerius J G (1741) Sal natron, in Decades Binae Thesium Medicarum, J A Darellius (Upsaliæ) 29-31 The mineral is described: Wallerius J G (1750) I. Mit Erdevermischtes alkalisches Salz. Species 189. Alkali orientale impurum terrestre. Natron. Nitrum veterum, in Mineralogie,oder Mineralreich, Nicolai (Berlin) 228-228</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.CB.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate without additional anions, with H2O, With large cations (alkali and alkali-earth carbonates)</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Natron.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1783</gsmin:wikipediadate>
  </rdf:Description>
