    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: IronIII phosphate trihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2249</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2249:7"/>
