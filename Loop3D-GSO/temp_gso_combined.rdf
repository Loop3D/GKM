    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2503:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2503.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060695 | R060757</gsmin:rruffids>
