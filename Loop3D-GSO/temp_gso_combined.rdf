    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ni&lt;sup&gt;2+&lt;/sup&gt;,Cu&lt;sup&gt;2+&lt;/sup&gt;)Al&lt;sub&gt;4&lt;/sub&gt;(N&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;,S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;12&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060597</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mbobomkulite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Mbobomkulite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Martini J E J (1980) Mbobomkulite, hydrombobomkulite and nickelalumite, new minerals from Mbobo Mkulu cave, eastern Transvaal, Annals of the Geological Survey of South Africa 14(2), 1-11</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Chalcoalumite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>05.ND.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nitrate, With OH (etc.) and H2O</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Mbobomkulite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1979-078</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/coldwellite">
