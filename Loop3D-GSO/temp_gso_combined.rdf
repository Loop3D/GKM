    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na(Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;)O&lt;sub&gt;8&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
