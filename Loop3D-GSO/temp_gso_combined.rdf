    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4060:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4060.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;Al&lt;sub&gt;6&lt;/sub&gt;(P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;8&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R050225 | R050418 | R050554</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Turquoise</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Turquoise</gsmin:rruffnameplain>
