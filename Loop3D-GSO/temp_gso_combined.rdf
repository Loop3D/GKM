    <gsmin:mindaturl>http://www.mindat.org/min-3576.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaZn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R050238 | R080068</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Scholzite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Scholzite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Strunz H (1948) Scholzit, ein neue Mineralart, Fortschritte der Mineralogie 27, 31-31 Chemical formula changed from Ca_3_Zn(PO_4_)_2_(OH)_2_·H&lt;sub&gt;2&lt;/sub&gt;O: Strunz H, Tennyson C (1956) Kristallographie von Scholzit, CaZn&lt;sub&gt;2&lt;/sub&gt;[PO&lt;sub&gt;4&lt;/sub&gt;]&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O, Zeitschrift für Kristallographie 107, 318-324</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.CA.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With small and large/medium cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Scholzite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1948</gsmin:wikipediadate>
  </rdf:Description>
