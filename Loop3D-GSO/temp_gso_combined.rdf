    <gsmin:strunzlabel xml:lang="en">Zinc-brass family</gsmin:strunzlabel>
    <gsmin:wikipediadate>2010-044</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Metamorphic_Process">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">this vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Mineralogical, chemical, and structural adjustment of solid rocks to physical and chemical conditions that differ from the conditions under which the rocks in question originated, and are generally been imposed at depth, below the surface zones of weathering and cementation.</rdfs:comment>
    <rdfs:label xml:lang="en">Metamorphic Process</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Transformation"/>
  </rdf:Description>
