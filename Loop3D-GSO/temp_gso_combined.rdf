    <gsmin:mindaturl>http://www.mindat.org/min-1374.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;LiFe&lt;sup&gt;3+&lt;/sup&gt;Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;15&lt;/sub&gt;</gsmin:rruffchemistry>
