    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaAl(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·11H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070315</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mendozite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Mendozite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Dana J D, Brush G J (1868) 677. Mendozite, in A System of Mineralogy, Fifth Edition, John Wiley and Sons (New York) 653-653</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.CC.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, with H2O, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Mendozite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1868</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/francisite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Francisite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Bi | Se | O | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/francisite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;3&lt;/sub&gt;Bi(Se&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;Cl</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1989-028</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Tricopper bismuth diseleniteIV dioxy chloride</gsmin:iupacchemname>
    <gsmin:mindatid>min-1591</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1591:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1591.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Bi&lt;sup&gt;3+&lt;/sup&gt;(Se&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;Cl</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Francisite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Francisite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pring A, Gatehouse B M, Birch W D (1990) Francisite, Cu_3_Bi(SeO_3_)_2_O_2_Cl, new mineral from Iron Monarch, South Australia: description and crystal structure, American Mineralogist 75, 1421-1425</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.JG.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Selenite with additional anions, without H2O</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Francisite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1989-028</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/orthojoaquinite-la">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Orthojoaquinite-(La)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ba | La | Fe | Ti | Si | O | H | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">joaquinite</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaBa&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;La&lt;sub&gt;2&lt;/sub&gt;Ti&lt;sub&gt;2&lt;/sub&gt;(SiO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(OH,O,F)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:mindatid>min-10392</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:10392:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-10392.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaBa&lt;sub&gt;2&lt;/sub&gt;La&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;26&lt;/sub&gt;(OH,O,F)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Orthojoaquinite-(La)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Orthojoaquinite-(La)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Matsubara S, Mandarino J A, Semenov E I (2001) Redefinition of a mineral in the joaquinite group: Orthojoaquinite-(La), The Canadian Mineralogist 39, 757-760 Jambor J L, Roberts A C (2002) New mineral names, American Mineralogist 87, 355-358</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Joaquinite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CE.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si4O12]8- 4-membered single rings (vierer-Einfachringe), without insular complex anions</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Orthojoaquinite-%28La%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2000-D</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/rossmanite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Rossmanite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Al | Li | Si | O | B | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">tourmaline</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;(Al&lt;sub&gt;2&lt;/sub&gt;Li)Al&lt;sub&gt;6&lt;/sub&gt;(Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;)(BO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;(OH)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1996-018</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-7275</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7275:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7275.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;(LiAl&lt;sub&gt;2&lt;/sub&gt;)Al&lt;sub&gt;6&lt;/sub&gt;(Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;)(BO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;OH</gsmin:rruffchemistry>
    <gsmin:rruffids>R070680 | R070702</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Rossmanite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Rossmanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Selway J B, Novák M, Hawthorne F C, Cerný P, Ottolini Luisa, Kyser T K (1998) Rossmanite, (LiAl2)Al6(Si6O18)(BO3)3(OH)4, a new alkali-deficient tourmaline: description and crystal structure, American Mineralogist 83, 896-900</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Tourmaline</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CK.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si6O18]12- 6-membered single rings, with insular complex anions</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Rossmanite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1996-018</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/tassieite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Tassieite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Mg | Fe | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">wicksite</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaCa&lt;sub&gt;2&lt;/sub&gt;Mg&lt;sub&gt;3&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2005-051</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-29006</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:29006:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-29006.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaCa&lt;sub&gt;2&lt;/sub&gt;Mg&lt;sub&gt;3&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tassieite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tassieite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Grew E S, Armbruster T, Medenbach O, Yates M G, Carson C J (2007) Tassieite, (Na,[box])Ca_2_(Mg,Fe^2+^,Fe^3+^)_2_(Fe^3+^,Mg)_2_(Fe^2+^,Mg)_2_(PO_4_)_6_·2H_2_O, a new hydrothermal wicksite-group mineral in fluorapatite nodules from granulite-facies paragneiss in the Larsemann Hills, Prydz Bay, east Antarctica, The Canadian Mineralogist 45, 293-305</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Wicksite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CF.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With large and medium-sized cations, RO4:H2O &gt; 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Tassieite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2005-051</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicstructure/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-26</dct:created>
