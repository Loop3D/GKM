    <gsmin:rruffids>R040093 | R040094 | R050644 | R060630 | R060744 | R070097 | R070418 | R070550 | R070641 | R100093 | R120168 | R120174</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Enstatite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Enstatite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kenngott A (1855) Mineralogische notizen, betreffend die bekannten species: Karstenit, dolomit, millerit, turmalin, galaktit, wasser, plagionit, diopsid, zinkit, calcit und felsobanyt, sowie zwei neue: den enstatit im geschlechte der augit-spathe und den pseudophit im geschlechte der serpentin-steatite, Sitzungsberichte der Kaiserlichen Akademie der Wissenschaften 16, 152-179</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Pyroxene</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DA.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 2-periodic single chains, Si2O6; pyroxene family</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Enstatite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1855</gsmin:wikipediadate>
  </rdf:Description>
