  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Lacustrine_Delta_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al., 2005</dct:source>
    <rdfs:comment xml:lang="en">The low, nearly flat, alluvial tract of land at or near the mouth of a river, commonly forming a triangular or fan-shaped plain of considerable area, crossed by many distributaries of the main river, perhaps extending beyond the general trend of the lake shore, resulting from the accumulation of sediment supplied by the river in such quantities that it is not removed by waves or currents. Most deltas are partly subaerial and partly below water.</rdfs:comment>
    <rdfs:label xml:lang="en">lacustrine delta setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Delta_System_Setting"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Lacustrine_Setting"/>
    <rdfs:subClassOf rdf:nodeID="nb91377c629b1476ba973ba249cd56575b48"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/heazlewoodite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Heazlewoodite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ni | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal, rhombohedral</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/heazlewoodite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ni&lt;sub&gt;3&lt;/sub&gt;S&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Trinickel sulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-1839</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1839:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1839.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ni&lt;sub&gt;3&lt;/sub&gt;S&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R061074</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Heazlewoodite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Heazlewoodite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Smith J H (1897) Heazlewood and Whyte River Districts, Tasmania. Report of the Secretary for Mines 1896-7, 47-47</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.BB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide M:S &gt; 1:1 with Ni</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Heazlewoodite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1947</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicrole/Framework_Crystals">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">crystal that form the main framework of an igneous or metamorphic rock. Framework is the essential supporting structure of a rock material, formed by a collection of particles all in mutual contact to form a continuous connected framerwork; the framework commonly comprises more that one mineral phase, represented as different granular materials in this model, all in the 'framework crystal' role.</rdfs:comment>
    <rdfs:label xml:lang="en">framework crystals</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicrole/Crystal_Role"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfoliation/bedding_fabric">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Fabric defined by textural or mineralogic variations in sediment produced by depositional processes. May be manifested by lamination structure within the sediment, or by layering in which the individual layers (beds) are bounded by discontinuities related to events in the depositional history.</rdfs:comment>
    <dct:source xml:lang="en">NADM sedimentary rock vocabulary (https://pubs.usgs.gov/of/2004/1451/sltt/appendixC/appendixC_pdf.zip)  SLTTs 2004, CGI foliationtype SKOS vocabulary 2018-08-03</dct:source>
    <rdfs:label xml:lang="en">bedding</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfoliation/primary_foliation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kozyrevskite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kozyrevskite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | O | As</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;4&lt;/sub&gt;O(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2013-023</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;O(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kozyrevskite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kozyrevskite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pekov I V, Zubkova N V, Yapaskurt V O, Belakovskiy D I, Vigasina M F, Sidorov E G, Pushcharovsky D Y (2014) New arsenate minerals from the Arsenatnaya fumarole, Tolbachik volcano, Kamchatka, Russia. II. Ericlaxmanite and kozyrevskite, two natural modifications of Cu_4_O(AsO_4_)_2_. Mineralogical Magazine 78, 1553-1569</gsmin:statusnotes>
  </rdf:Description>
