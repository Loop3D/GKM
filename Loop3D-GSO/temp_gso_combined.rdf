    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaBe(PO&lt;sub&gt;4&lt;/sub&gt;)F</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1966-003</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
