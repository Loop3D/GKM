    <gsmin:rruffnameplain xml:lang="en">Aravaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Galuskin, E.V., Krüger, B., Galuskina, I.O., Krüger, H. and Vapnik, Y. (2018) Aravaite, IMA 2018-078. CNMNC Newsletter No. 46, December 2018, page 1370; Mineralogical Magazine, 82, 1369–1379</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/cechite">
