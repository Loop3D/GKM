    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">LiAl(PO&lt;sub&gt;4&lt;/sub&gt;)F</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Lithium aluminium phosphate fluorid</gsmin:iupacchemname>
    <gsmin:mindatid>min-189</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:189:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-189.html</gsmin:mindaturl>
