  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/machatschkiite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Machatschkiite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | As | O | H | P</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/machatschkiite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;6&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)(AsO&lt;sub&gt;3&lt;/sub&gt;OH)&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)·15H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1976-010</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Hexacalcium arsenate trihydrogen arsenate phosphate pentadecahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2510</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2510:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2510.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;6&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;OH)&lt;sub&gt;3&lt;/sub&gt;PO&lt;sub&gt;4&lt;/sub&gt;·15H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Machatschkiite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Machatschkiite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Walenta K (1977) Machatschkiit, ein neues Arsenmineral aus der Grube Anton im Heubachtal bei Schiltach (Schwarzwald, Bundesrepublik Deutschland). Tschermaks Mineralogische und Petrographische Mitteilungen 24, 125-132 Chemical formula revised: Effenberger H, Mereiter K, Pimminger M, Zemann J (1982) Machatschkiite: crystal structure and revision of the chemical formula, Tschermaks Mineralogische und Petrographische Mitteilungen 30, 145-155</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.CJ.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With only large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Machatschkiite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1976-010</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/cabalzarite">
