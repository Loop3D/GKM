    <gsmin:imastatus xml:lang="en">Approved|Pending publication</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;12&lt;/sub&gt;(V&lt;sup&gt;5+&lt;/sup&gt;,Mo&lt;sup&gt;6+&lt;/sup&gt;,W&lt;sup&gt;6+&lt;/sup&gt;)&lt;sub&gt;1.5&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;{[BO&lt;sub&gt;3&lt;/sub&gt;]&lt;sub&gt;6-x&lt;/sub&gt;[(P,As&lt;sup&gt;5+&lt;/sup&gt;)O&lt;sub&gt;4&lt;/sub&gt;]&lt;sub&gt;x&lt;/sub&gt;F&lt;sub&gt;2-x&lt;/sub&gt;} (x &lt; 1)</gsmin:rruffchemistry>
