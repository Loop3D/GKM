    <gsmin:chemistryelements>Mg | Be | Al | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">taaffeite</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;3&lt;/sub&gt;BeAl&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;16&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;3&lt;/sub&gt;BeAl&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;16&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070555 | RS739661 | R090035</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Magnesiotaaffeite-2N'2S</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Magnesiotaaffeite-2N2S</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named taaffeite: Anderson B W, Payne C J, Claringbull G F, Hey M H (1951) Taaffeite, a new beryllium mineral, found as a cut gemstone, Mineralogical Magazine 29, 765-772 Renamed: Armbruster T (2002) Revised nomenclature of högbomite, nigerite, and taafeite minerals, European Journal of Mineralogy 14, 389-395</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Taaffeite-Magnesiotaaffeite</gsmin:structuralgroup>
  </rdf:Description>
