  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/paraotwayite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Paraotwayite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ni | O | H | S | C</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/paraotwayite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ni(OH)&lt;sub&gt;2-x&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;,CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;0.5x&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1984-045a</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3104</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3104:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3104.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ni&lt;sup&gt;2+&lt;/sup&gt;(OH)&lt;sub&gt;2-x&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;,C&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;0.5x&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Paraotwayite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Paraotwayite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Nickel E H, Graham J (1987) Paraotwayite, a new nickel hydroxide mineral from Western Australia, The Canadian Mineralogist 25, 409-411</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.BB.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions, without H2O, With medium-sized cations</gsmin:strunzlabel>
