  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/hydroxykenoelsmoreite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Hydroxykenoelsmoreite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | W | Fe | Al | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;,Pb)&lt;sub&gt;2&lt;/sub&gt;(W,Fe&lt;sup&gt;3+&lt;/sup&gt;,Al)&lt;sub&gt;2&lt;/sub&gt;(O,OH)&lt;sub&gt;6&lt;/sub&gt;(OH)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2016-056</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;,Pb)&lt;sub&gt;2&lt;/sub&gt;(W,Fe&lt;sup&gt;3+&lt;/sup&gt;,Al)&lt;sub&gt;2&lt;/sub&gt;(O,OH)&lt;sub&gt;6&lt;/sub&gt;(OH)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hydroxykenoelsmoreite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hydroxykenoelsmoreite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mills S J, Christy A G, Kampf A R, Birch W D, Kasatkin A (2017) Hydroxykenoelsmoreite, the first new mineral from the Republic of Burundi. European Journal of Mineralogy 29, 491-497</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Pyrochlore-Elsmoreite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kahlerite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kahlerite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Fe | U | O | As | H</gsmin:chemistryelements>
    <gsmin:fleischersgroup xml:lang="en">autunite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/kahlerite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·12H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: IronII diuranyl diarsenate dodecahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2131</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2131:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2131.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·12H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kahlerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kahlerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Meixner H (1953) Kahlerit, ein neues mineral der uranglimmergruppe, aus der Hüttenberger Lagerstätte, Kärnten, Der Karinthin 23, 277-280</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.EB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl phosphate or arsenate, UO2:RO4 = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Kahlerite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1953</gsmin:wikipediadate>
  </rdf:Description>
