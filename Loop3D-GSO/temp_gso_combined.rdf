    <gsmin:rruffnameplain xml:lang="en">Anglesite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Beudant F S (1832) Anglesite, plomb sulfaté, in Traité Élémentaire de Minéralogie, 2nd Edition, (Paris) 459-460</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Baryte</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.AD.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, without H2O, With only large cations</gsmin:strunzlabel>
