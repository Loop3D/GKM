    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;Bi&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Te&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hitachiite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hitachiite</gsmin:rruffnameplain>
