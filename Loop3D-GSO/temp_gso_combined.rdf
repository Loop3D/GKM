    <gsmin:rruffids>R050517 | R050521 | R120112</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mottramite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Mottramite</gsmin:rruffnameplain>
