  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/miessiite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Miessiite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pd | Te | Se</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pd&lt;sub&gt;11&lt;/sub&gt;Te&lt;sub&gt;2&lt;/sub&gt;Se&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2006-013</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Undecapalladium ditelluride disulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-29258</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:29258:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-29258.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pd&lt;sub&gt;11&lt;/sub&gt;Te&lt;sub&gt;2&lt;/sub&gt;Se&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Miessiite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Miessiite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kojonen K K, Tarkian M, Roberts A C, Törnroos R, Heidrich S (2007) Miessiite, Pd_11_Te_2_Se_2_, a new mineral species from Miessijoki, Finnish Lapland, Finland, The Canadian Mineralogist 45, 1221-1227</gsmin:statusnotes>
