  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/calciosamarskite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Calciosamarskite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Fe | Y | Nb | Ta | Ti | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">samarskite</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Fe,Y)(Nb,Ta,Ti)O&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-7962</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7962:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7962.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Fe&lt;sup&gt;3+&lt;/sup&gt;,Fe&lt;sup&gt;2+&lt;/sup&gt;,Y&lt;sup&gt;3+&lt;/sup&gt;)(Nb&lt;sup&gt;5+&lt;/sup&gt;Ta&lt;sup&gt;5+&lt;/sup&gt;,Ti&lt;sup&gt;4+&lt;/sup&gt;)O&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Calciosamarskite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Calciosamarskite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Ellsworth H V (1928) A mineral related to samarskite from the Woodcox mine, Hybla, Ontario, American Mineralogist 13, 63-65</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.DB.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With medium-sized cations; chains of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Calciosamarskite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1928</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/argentoliveingite">
