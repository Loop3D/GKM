    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;6&lt;/sub&gt;Cr&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;16&lt;/sub&gt;Cl&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2000-042</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-10319</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:10319:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-10319.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;6&lt;/sub&gt;Cr&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;16&lt;/sub&gt;Cl&lt;sup&gt;1-&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Woodallite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Woodallite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Grguric B A, Madsen I C, Pring A (2001) Woodallite, a new chromium analogue of iowaite from the Mount Keith nickel deposit, Western Australia, Mineralogical Magazine 65, 427-435</gsmin:statusnotes>
