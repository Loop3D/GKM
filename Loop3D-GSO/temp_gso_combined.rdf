    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Melcherite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Melcherite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Andrade M B, Atencio D, Menezes L A D, Spratt J (2018) Melcherite, trigonal Ba_2_Na_2_Mg[Nb_6_O_19_]·6H_2_O, the second natural hexaniobate, from Cajati, São Paulo, Brazil: Description and crystal structure. Mineralogical Magazine 82, 111-120</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Peterandresenite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/monteneveite">
