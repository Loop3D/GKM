    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1219</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1219:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1219.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Cu,Ag)&lt;sub&gt;14&lt;/sub&gt;HgS&lt;sub&gt;8&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070419</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Danielsite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Danielsite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Nickel E H (1987) Danielsite: A new sulfide mineral from Western Australia, American Mineralogist 72, 401-403</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.BD.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide M:S &gt; 1:1 with Hg, Tl</gsmin:strunzlabel>
