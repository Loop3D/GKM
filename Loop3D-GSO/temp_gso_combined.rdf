    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4065:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4065.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;4&lt;/sub&gt;Be&lt;sub&gt;3&lt;/sub&gt;Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;17&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tvedalite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tvedalite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Larsen A O, Åsheim A, Raade G, Taftø J (1992) Tvedalite, (Ca,Mn)4Be3Si6O17(OH)4·3H2O, a new mineral from syenite pegmatite in the Oslo Region, Norway, American Mineralogist 77, 438-443</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.DF.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 2-periodic multiple chains</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Tvedalite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1990-027</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/karibibite">
