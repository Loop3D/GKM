    <gsmin:mindaturl>http://www.mindat.org/min-39838.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(Te&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;6&lt;/sub&gt;)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Paratimroseite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Paratimroseite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf A R, Mills S J, Housley R M, Marty J, Thorne B (2010) Lead-tellurium oxysalts from Otto Mountain near Baker, California: V. Timroseite, Pb_2_Cu^2+^_5_(Te^6+^O_6_)_2_(OH)_2_, and paratimroseite, Pb_2_Cu^2+^_4_(Te^6+^O_6_)_2_(H_2_O)_2_, two new tellurates with Te-Cu polyhedral sheets, American Mineralogist 95, 1560-1568</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, hydroxide or arsenite</gsmin:strunzlabel>
    <gsmin:wikipediadate>2009-065</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/staurolite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Staurolite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Fe | Al | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic, orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">staurolite</gsmin:fleischersgroup>
