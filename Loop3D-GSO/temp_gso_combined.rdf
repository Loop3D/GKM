    <gsoc:hasDataValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.4</gsoc:hasDataValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/nolanite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Nolanite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>V | Fe | Ti | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/nolanite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(V&lt;sup&gt;3+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;,Fe&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;10&lt;/sub&gt;O&lt;sub&gt;14&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2922</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2922:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2922.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(V&lt;sup&gt;3+&lt;/sup&gt;,Fe&lt;sup&gt;2+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;,Ti&lt;sup&gt;4+&lt;/sup&gt;)&lt;sub&gt;10&lt;/sub&gt;O&lt;sub&gt;14&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nolanite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Nolanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Robinson S C, Evans H T, Schaller W T, Fahey J J (1957) Nolanite, a new iron-vanadium mineral from Beaverlodge, Saskatchewan, American Mineralogist 42, 619-628</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Nolanite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.CB.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 2: 3,3: 5, and similar, With medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Nolanite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1957</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="http://qudt.org/vocab/unit/MilliM">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://qudt.org/2.1/vocab/unit"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Unit_Of_Measure_Value"/>
    <skos:altLabel>MM</skos:altLabel>
    <skos:altLabel>mm</skos:altLabel>
    <skos:definition xml:lang="en">The millimetre (International spelling as used by the International Bureau of Weights and Measures) or millimeter (American spelling) (SI unit symbol mm) is a unit of length in the metric system, equal to one thousandth of a metre, which is the SI base unit of length. It is equal to 1000 micrometres or 1000000 nanometres. A millimetre is equal to approximately 0.039370 of an inch.</skos:definition>
    <skos:prefLabel xml:lang="en-us">Millimeter</skos:prefLabel>
    <skos:prefLabel xml:lang="en">millimetre</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/magnesionigerite-2n1s">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Magnesionigerite-2N1S</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mg | Al | Zn | Sn | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">nigerite</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Mg,Al,Zn)&lt;sub&gt;2&lt;/sub&gt;(Al,Sn)&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;11&lt;/sub&gt;(OH)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1988-010</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Mg,Al,Zn&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;(Al,Sn&lt;sup&gt;4+&lt;/sup&gt;)&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;11&lt;/sub&gt;(OH)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Magnesionigerite-2N1S</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Magnesionigerite-2N1S</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named pengzhizhongite-6H: Chen J, Shi Y, Pan Z, Peng Z (1989) The crystal structure and crystal chemistry of a new mineral, pengzhizhongite-6H, Earth Science Journal of China University of Geosciences 14, 413-422 Name changed to pengzhizhongite-6T because it is trigonal and not hexagonal: Nickel E H (1993) Standardization of polytype suffixes, The Canadian Mineralogist 31, 767-768 Renamed: Armbruster T (2002) Revised nomenclature of högbomite, nigerite, and taafeite minerals, European Journal of Mineralogy 14, 389-395</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Nigerite-Magnesionigerite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/medaite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Medaite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | V | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/medaite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;V&lt;sup&gt;5+&lt;/sup&gt;Si&lt;sub&gt;5&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;(OH)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1979-062</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2624</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2624:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2624.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;V&lt;sup&gt;5+&lt;/sup&gt;Si&lt;sub&gt;5&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;(OH)</gsmin:rruffchemistry>
    <gsmin:rruffids>R130098</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Medaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Medaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Gramaccioli C M, Griffin W L, Mottana A (1982) Medaite, Mn_6_[VSi_5_O_18_(OH)], a new mineral and the first example of vanadatopentasilicate ion, American Mineralogist 67, 85-89</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Medaite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.BJ.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate with Si3O10, Si4O11, etc. anions; cations in octahedral [6] and greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Medaite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1979-062</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/majzlanite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
