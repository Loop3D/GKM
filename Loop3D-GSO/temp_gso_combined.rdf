    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">[(N&lt;sup&gt;3-&lt;/sup&gt;H&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;Mg&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;20&lt;/sub&gt;]·[V&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;10&lt;/sub&gt;O&lt;sub&gt;28&lt;/sub&gt;]</gsmin:rruffchemistry>
