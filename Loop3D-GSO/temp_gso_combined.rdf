    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Sodium tricalcium uranyl sulfate tricarbonate fluoride decahydrate</gsmin:iupacchemname>
