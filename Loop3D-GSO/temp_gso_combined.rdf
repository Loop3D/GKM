    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaMn&lt;sup&gt;3+&lt;/sup&gt;Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1989-026</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2834</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2834:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2834.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaMn&lt;sup&gt;3+&lt;/sup&gt;Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070006</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Namansilite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Namansilite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kalinin V V, Marsii I M, Dikov Y P, Troneva N V, Trubkin N V (1992) Namansilite NaMn^3+^Si_2_O_6_: a new silicate, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 121(1), 89-94</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.DA.25</gsmin:strunzcodeV10>
