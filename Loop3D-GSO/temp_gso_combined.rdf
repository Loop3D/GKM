    <gsmin:imanumber xml:lang="en">IMA2010-029</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-40398</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:40398:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-40398.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Cd&lt;sup&gt;2+&lt;/sup&gt;,Ca)(Cu&lt;sup&gt;2+&lt;/sup&gt;,Zn&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;4&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Aldridgeite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Aldridgeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Elliot P, Pring A (2015) Aldridgeite, a new mineral from the Block 14 open cut, Broken Hill, New South Wales. Australian Journal of Mineralogy 17, 67-71</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Devilline</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">sulfate, chromate, molybdate or tungstate</gsmin:strunzlabel>
    <gsmin:wikipediadate>2010-029</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseUpperTriassicSP2008">
