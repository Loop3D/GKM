  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/halloysite-10a">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Halloysite-10Å</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/mineral/halloysite"/>
    <gsmin:chemistryelements>Al | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">kaolinite-serpentine-kaolinite subgroup</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;5&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-10409</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:10409:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-10409.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;5&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Halloysite-10Å</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Halloysite-10A</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally considered hydrated halloysite: Hofmann U, Endell K, Wilm D (1934) Röntgenographische und kolloidchemische untersuchungen über ton. Angewandte Chemie 47, 539-558 Renamed endellite: Alexander L T, Faust G T, Hendricks S B, Insley H, McMurdie H F (1943) Relationship of the clay minerals halloysite and endellite, American Mineralogist 28, 1-18 Name changed to halloysite-10Å: Bailey S W (1980) Summary of recommendations of the AIPEA nomenclature committee, The Canadian Mineralogist 18, 143-150</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Kaolinite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.ED.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with kaolinite layers composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Endellite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1943</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/markeyite">
