  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseHoloceneSP2008">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologiccontact/GSSP"/>
    <dct:source xml:lang="en">Episodes 31/2, 2008</dct:source>
    <rdfs:comment xml:lang="en">J. Quaternary Sci., Vol. 24 pp. 3–17, 2009</rdfs:comment>
    <rdfs:comment xml:lang="en">Primary marker: The base of the Greenlandian Stage is defined on the basis of the marked change in deuterium excess values that occurred over an interval of ca. 3 yr.  Correlation event is end of the Younger Dryas cold spell, which is reflected in a shift in deuterium excess values</rdfs:comment>
    <rdfs:comment xml:lang="en">The Greenlandian GSSP is located in the borehole NGRIP2 in the central Greenland ice sheet at a latitude of 75.10°N and a longitude of 42.32°W.</rdfs:comment>
    <rdfs:label xml:lang="en">GSSP Base of Holocene</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://stratigraphy.science.purdue.edu/references/HoloceneGSSP_JQuatSci090.pdf"/>
    <rdfs:seeAlso rdf:resource="http://www.episodes.org/index.php/epi/article/view/64299/50256"/>
    <rdfs:seeAlso rdf:resource="http://www.stratigraphy.org/GSSP/Holocene.pdf"/>
    <rdfs:seeAlso rdf:resource="https://timescalefoundation.org/gssp/detail.php?periodid=5&amp;top_parentid=0"/>
    <owl:versionInfo>2008</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/lamprophyllite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Lamprophyllite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Sr | Na | Ti | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic, orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">lamprophyllite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/lamprophyllite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(SrNa)Ti&lt;sub&gt;2&lt;/sub&gt;Na&lt;sub&gt;3&lt;/sub&gt;Ti(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Redefined|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2315</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2315:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2315.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(SrNa)Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Na&lt;sub&gt;3&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070200 | R070284 | R130420</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Lamprophyllite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Lamprophyllite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hackman V (1894) Petrographische beschreibung des nephelinsyenites vom Umptek und einiger ihn begleitenden gesteine, Fennia 11, 101-196</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Seidozerite-Lamprophyllite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.BE.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate: Si2O7 groups, with additional anions; cations in octahedral [6] and greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Lamprophyllite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1894</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/tadzhikite-ce">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Tadzhikite-(Ce)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Ce | Ti | B | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">hellandite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/tadzhikitey.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;4&lt;/sub&gt;Ce&lt;sub&gt;2&lt;/sub&gt;Ti&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;(B&lt;sub&gt;4&lt;/sub&gt;Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;)(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:mindatid>min-3866</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3866:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3866.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;4&lt;/sub&gt;Ce&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;(B&lt;sub&gt;4&lt;/sub&gt;Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;)(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060641</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tadzhikite-(Ce)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tadzhikite-(Ce)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Efimov A F, Dusmatov V D, Alkhazov V Y, Pudovkina Z G, Kazakova M Y (1970) Tadzhikite, a new borosilicate of the rare earths of the hellandite group, Doklady Akademii Nauk SSSR 195, 1190-1193 Name changed from tadzhikite: Nickel E H, Mandarino J A (1987) Procedures involving the IMA Commission on New Minerals and Mineral Names and guidelines on mineral nomenclature, American Mineralogist 72, 1031-1042</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hellandite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DK.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 5-periodic single chains</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Tadzhikite-%28Ce%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1970</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicunit/Amphibolite_Metamorphic_Facies">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">amphibolite metamorphic facies</rdfs:label>
    <dct:source xml:lang="en">Smulikowski et al. 2003; Fettes and Desmons, 2007</dct:source>
    <rdfs:comment xml:lang="en">Metamorphic facies characterized in rocks of basaltic composition by hornblende-plagioclase (plagioclase more calcic than An17).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicunit/Metamorphic_Facies"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/lanarkite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Lanarkite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | O | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/lanarkite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;2&lt;/sub&gt;O(SO&lt;sub&gt;4&lt;/sub&gt;)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dilead oxysulfate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2316</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2316:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2316.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)</gsmin:rruffchemistry>
    <gsmin:rruffids>R080116</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Lanarkite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Lanarkite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Beudant F S (1832) Lanarkite, plomb carbonaté rhomboédrique, in Traité Élémentaire de Minéralogie, 2nd Edition, (Paris) 366-367</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.BD.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions, without H2O, With only large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Lanarkite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1832</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/mopungite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Mopungite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Sb | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">stottite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/mopungite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaSb&lt;sup&gt;5+&lt;/sup&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1982-020</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Sodium antimonyV hexahydroxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-2777</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2777:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2777.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaSb&lt;sup&gt;5+&lt;/sup&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mopungite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Mopungite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Williams S A (1985) Mopungite a new mineral from Nevada, The Mineralogical Record 16, 73-74</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Perovskite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.FC.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Hydroxide (without V or U), Hydroxides with OH, without H2O; corner-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Mopungite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1982-020</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/cesiokenopyrochlore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cesiokenopyrochlore</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Nb | O | H | Cs</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;Nb&lt;sub&gt;2&lt;/sub&gt;(O,OH)&lt;sub&gt;6&lt;/sub&gt;Cs&lt;sub&gt;1-x&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2016-104</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Pending publication</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;Nb&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(O,OH)&lt;sub&gt;6&lt;/sub&gt;Cs&lt;sub&gt;1-x&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cesiokenopyrochlore</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cesiokenopyrochlore</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Agakhanov, A.A., Kasatkin, A.V., Britvin, S.N., Siidra, O.I., Pautov, L.A., Pekov, I.V. and Karpenko, V.Y. (2017) Cesiokenopyrochlore, IMA 2016-104. CNMNC Newsletter No. 36, April 2017, page 341; European Journal of Mineralogy, 29, 339–344</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Pyrochlore-Pyrochlore</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/cheremnykhite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cheremnykhite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Zn | Te | O | V</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">dugganite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/cheremnykhite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;3&lt;/sub&gt;Zn&lt;sub&gt;3&lt;/sub&gt;(TeO&lt;sub&gt;6&lt;/sub&gt;)(VO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1989-017</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Trilead trizinc tellurium hexaoxy divanadate</gsmin:iupacchemname>
    <gsmin:mindatid>min-989</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:989:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-989.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Te&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;6&lt;/sub&gt;(V&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cheremnykhite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cheremnykhite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kim A A, Zayakina N V, Makhotko V F (1990) Kuksite Pb&lt;sub&gt;3&lt;/sub&gt;Zn&lt;sub&gt;3&lt;/sub&gt;TeO&lt;sub&gt;6&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt; and cheremnykhite Pb&lt;sub&gt;3&lt;/sub&gt;Zn&lt;sub&gt;3&lt;/sub&gt;TeO&lt;sub&gt;6&lt;/sub&gt;(VO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt; - new tellurates from the Kuranakh gold deposit (Central Aldan, southern Yakutia), Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 119(5), 50-57</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.DL.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 = 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Cheremnykhite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1989-017</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/rhabdophane-y">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Rhabdophane-(Y)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Y | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Y(PO&lt;sub&gt;4&lt;/sub&gt;)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2011-031</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Yttrium phosphate monohydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-42532</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:42532:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-42532.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">YPO&lt;sub&gt;4&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Rhabdophane-(Y)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Rhabdophane-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Takai Y, Uehara S (2012) Rabdophane-(Y), YPO4·H2O, a new mineral in alkali olivine basalt from Hinodematsu, Genkai-cho, Saga Prefecture, Japan, Journal of Mineralogical and Petrological Sciences 107, 110-113</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Rhabdophane</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CJ.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With only large cations</gsmin:strunzlabel>
    <gsmin:wikipediadate>2011-031</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/aurihydrargyrumite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Aurihydrargyrumite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Au | Hg</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Au&lt;sub&gt;6&lt;/sub&gt;Hg&lt;sub&gt;5&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2017-003</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
