  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/wyllieite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Wyllieite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Mn | Al | P | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">wyllieite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/wyllieite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,Ca,Mn&lt;sup&gt;2+&lt;/sup&gt;,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)&lt;sub&gt;2&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Al(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1972-015</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4321</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4321:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4321.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,Ca,Mn&lt;sup&gt;2+&lt;/sup&gt;,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)&lt;sub&gt;2&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Al(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Wyllieite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Wyllieite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Moore P B, Ito J (1973) Wyllieite, Na_2_Fe^2+^_2_Al(PO_4_)_3_, a new species, The Mineralogical Record 4, 131-136 Wyllieite group redefined, chemical formula for wyllieite changed to the Mn-dominant member: Moore P B, Ito J (1979) Alluaudites, wyllieites, arrojadites: crystal chemistry and nomenclature, Mineralogical Magazine 43, 227-235</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Alluaudite-Wyllieite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.AC.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, without H2O, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Wyllieite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1972-015</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kupletskite-cs">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kupletskite-(Cs)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cs | Na | Mn | Ti | Si | O | H | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">astrophyllite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/kupletskitecs.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cs&lt;sub&gt;2&lt;/sub&gt;NaMn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;7&lt;/sub&gt;Ti&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;26&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;F</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1970-009</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Renamed|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-6853</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:6853:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-6853.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cs&lt;sup&gt;1+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;NaMn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;7&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;F</gsmin:rruffchemistry>
    <gsmin:rruffids>R060929</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kupletskite-(Cs)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kupletskite-(Cs)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Yefimov A F, Dusmatov V D, Ganzeyev A A, Katayeva Z T (1971) Tseziykupletskit-novyy mineral. Doklady Akademii Nauk SSSR 197, 1394-1397 Renamed: Bayliss P (2007) Cesium kupletskite renamed kupletskite-(Cs), Mineralogical Magazine 71, 365-367 Chemical composition revised according to: Cámara F, Sokolova E, Abdu Y, Hawthorne F C (2010) The crystal structures of niobophyllite, kupletskite-(Cs) and Sn-rich astrophyllite: Revisions to the crystal chemistry of the astrophyllite-group minerals, The Canadian Mineralogist 48, 1-16</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Astrophyllite-Kupletskite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DC.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with branched 2-periodic single chains; Si2O6 + 2SiO3 Si4O12</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://webmineral.com/data/Kupletskite-(Cs).shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1970-009</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ferriperboeite-la">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ferriperbøeite-(La)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | La | Fe | Al | Si | O | H</gsmin:chemistryelements>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(CaLa&lt;sub&gt;3&lt;/sub&gt;)(Fe&lt;sup&gt;3+&lt;/sup&gt;Al&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;)[Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;][SiO&lt;sub&gt;4&lt;/sub&gt;]&lt;sub&gt;3&lt;/sub&gt;O(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2018-106</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Pending publication</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(CaLa&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;)(Fe&lt;sup&gt;3+&lt;/sup&gt;Al&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;)[Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;][SiO&lt;sub&gt;4&lt;/sub&gt;]&lt;sub&gt;3&lt;/sub&gt;O(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ferriperbøeite-(La)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ferriperboeite-(La)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kasatkin, A.V., Pekov, I.V., Zubkova, N.V., Chukanov, N.V., Škoda, R., Polekhovsky, Y. S., Belakovskiy, D.I., Agakhanov, A.A., Kuznetsov, A.M. and Pushcharovsky, D.Y. (2018) Ferriperbøeite-(La), IMA 2018-106. CNMNC Newsletter No. 46, December 2018, page 1377; Mineralogical Magazine, 82, 1369–1379</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Gatelite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/nepskoeite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Nepskoeite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mg | Cl | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;4&lt;/sub&gt;Cl(OH)&lt;sub&gt;7&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1996-016</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-7189</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7189:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7189.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;4&lt;/sub&gt;Cl(OH)&lt;sub&gt;7&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nepskoeite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Nepskoeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Apollonov V N (1998) Nepskoeite Mg4Cl(OH)7·6H2O — a new mineral from the Nepskoye potash salt deposit, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 127, issue 1, 41-46 Jambor J L, Puziewicz J, Roberts A C (1999) New mineral names, American Mineralogist 84, 685-688</gsmin:statusnotes>
    <gsmin:strunzcodeV10>03.BD.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Simple halides, with H2O + OH</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Nepskoeite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1996-016</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/barahonaite-al">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Barahonaite-(Al)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Cu | Na | Fe | Al | As | O | H | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Cu,Na,Fe&lt;sup&gt;3+&lt;/sup&gt;,Al)&lt;sub&gt;12&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;8&lt;/sub&gt;(OH,Cl)&lt;sub&gt;x&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2006-051</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Cu&lt;sup&gt;2+&lt;/sup&gt;,Na,Fe&lt;sup&gt;3+&lt;/sup&gt;,Al)&lt;sub&gt;12&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;8&lt;/sub&gt;(OH,Cl)&lt;sub&gt;x&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Barahonaite-(Al)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Barahonaite-(Al)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Viñals J, Jambor J L, Raudsepp M, Roberts A C, Grice J D, Kokinos M, Wise W S (2008) Barahonaite-(Al) and barahonaite-(Fe), new Ca-Cu arsenate mineral species, from Murcia Province, southeastern Spain, and Gold Hill, Utah, The Canadian Mineralogist 46, 205-217</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/phosphowalpurgite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
