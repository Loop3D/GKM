  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/nickelboussingaultite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Nickelboussingaultite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>N | H | Ni | S | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">picromerite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/nickelboussingaultite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(NH&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;Ni(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1975-037</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Diammonium nickel disulfate hexahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2896</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2896:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2896.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(N&lt;sup&gt;3-&lt;/sup&gt;H&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;Ni&lt;sup&gt;2+&lt;/sup&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nickelboussingaultite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Nickelboussingaultite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Yahontova L K, Sidrenko G A, Stolyarova T I, Plyusnina I I, Ivanova T L (1976) Nickelboussingaultite, sulfate from zones of Norilskih Mestorozhdenix, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 105, issue 6, 710-720 Hawthorne F C, Bladh K W, Burke E A J, Ercit S, Grew E S, Grice J D, Puziewicz J, Roberts A C, Schedler R A, Shigley J E (1986) New mineral names, American Mineralogist 71, 1543-1548</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Picromerite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.CC.60</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, with H2O, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Nickelboussingaultite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1975-037</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/fernandinite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
