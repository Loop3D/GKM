  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/reinerite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Reinerite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Zn | As | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/reinerite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sub&gt;3&lt;/sub&gt;(AsO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Trizinc diarsenite</gsmin:iupacchemname>
    <gsmin:mindatid>min-3386</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3386:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3386.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(As&lt;sup&gt;3+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R080132</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Reinerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Reinerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Geier B H, Weber K (1958) Reinerit Zn3[AsO3]2, ein neues Mineral der Tsumeb Mine Südwestafrika, Neues Jahrbuch für Mineralogie, Monatshefte 1958, 160-167 Fleischer M (1959) New mineral names, American Mineralogist 44, 207-210</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.JA.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Arsenite, antimonite, bismuthite; without additional anions, without H2O</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Reinerite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1958</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/liroconite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Liroconite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Al | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/liroconite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;2&lt;/sub&gt;Al(AsO&lt;sub&gt;4&lt;/sub&gt;)(OH)&lt;sub&gt;4&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dicopper aluminium arsenate tetrahydroxyl tetrahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2413</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2413:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2413.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;AlAs&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R050535</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Liroconite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Liroconite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mohs F (1822) IV. Malachite. II. Lirokon-malachit., in Grund-Riß der Mineralogie, Volume 1, Arnoldischen buchhandlung (Dresden) 544-547</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.DF.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With only medium-sized cations, (OH,etc.):RO4 &gt; 3:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Liroconite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1822</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/richetite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Richetite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Fe | Mg | Pb | U | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/richetite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Fe&lt;sup&gt;3+&lt;/sup&gt;,Mg)&lt;sub&gt;x&lt;/sub&gt;Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;8.6&lt;/sub&gt;(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;36&lt;/sub&gt;O&lt;sub&gt;36&lt;/sub&gt;(OH)&lt;sub&gt;24&lt;/sub&gt;·41H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Lead tetrauranate pentaoxide tetrahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-3415</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3415:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3415.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Fe&lt;sup&gt;3+&lt;/sup&gt;,Mg)&lt;sub&gt;x&lt;/sub&gt;Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;8.6&lt;/sub&gt;(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;36&lt;/sub&gt;O&lt;sub&gt;36&lt;/sub&gt;(OH)&lt;sub&gt;24&lt;/sub&gt;·41H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R090053</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Richetite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Richetite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Vaes J F (1947) Six nouveaux minéraux d'urane provenant de Shinkolobwe (Katanga), Annales de la Société Géologique de Belgique 70, 212-225 Fleischer M (1948) New mineral names, American Mineralogist 33, 384-386 Chemical formula revised: Burns P C (1998) The structure of richetite, a rare lead uranyl oxide hydrate, The Canadian Mineralogist 36, 187-199</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.GB.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl hydroxide, With additional cations (K, Ca, Ba, Pb, etc.); with mainly UO2(O,OH)5 pentagonal polyhedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Richetite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1947</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/stewartite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Stewartite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | Fe | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">stewartite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/stewartite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: ManganeseII diironIII diphosphate dihydroxyl octahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-3772</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3772:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3772.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070643</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Stewartite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Stewartite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Schaller W T (1912) New manganese phosphates from the gem tourmaline field of Southern California, Journal of the Washington Academy of Sciences 2, 143-145</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Stewartite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DC.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With only medium-sized cations, (OH, etc.):RO4 = 1:1 and &lt; 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Stewartite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1910</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/seeligerite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Seeligerite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | I | O | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/seeligerite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;3&lt;/sub&gt;(IO&lt;sub&gt;4&lt;/sub&gt;)Cl&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1970-036</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Trilead iodate trichloride</gsmin:iupacchemname>
    <gsmin:mindatid>min-3603</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3603:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3603.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(I&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)Cl&lt;sup&gt;1-&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060714</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Seeligerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Seeligerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mücke A (1971) Seeligerit, ein natürliches Blei-Jodat, Neues Jahrbuch für Mineralogie, Monatshefte 1971, 210-217</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.KB.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Iodate with additional anions, without H2O</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Seeligerite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1970-036</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/vertumnite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Vertumnite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Al | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/vertumnite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;4&lt;/sub&gt;Al&lt;sub&gt;4&lt;/sub&gt;Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;(OH)&lt;sub&gt;24&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1975-043</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4174</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4174:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4174.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;4&lt;/sub&gt;Al&lt;sub&gt;4&lt;/sub&gt;Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;(OH)&lt;sub&gt;24&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070063</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Vertumnite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Vertumnite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Passaglia E, Galli E (1977) Vertumnite, a new natural silicate, Tschermaks Mineralogische und Petrographische Mitteilungen 24, 57-66</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.EG.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate: Double nets with 6-membered and larger rings</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Vertumnite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1975-043</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/Fluid">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Matter that continually deforms (flows) under an applied shear stress, or external force. Fluids are a phase of matter and include liquids, gases and plasmas. They are substances with zero shear modulus, or, in simpler terms, substances which cannot resist any shear force applied to them. (https://en.wikipedia.org/wiki/Fluid)</rdfs:comment>
    <rdfs:label xml:lang="en">Fluid material state</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/State_Of_Matter_Value"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/potassic-jeanlouisite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Potassic-jeanlouisite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Na | Ca | Mg | Ti | Si | O</gsmin:chemistryelements>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K(NaCa)(Mg&lt;sub&gt;4&lt;/sub&gt;Ti)Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2018-050</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Pending publication</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K(NaCa)(Mg&lt;sub&gt;4&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;)Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Potassic-jeanlouisite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Potassic-jeanlouisite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Oberti, R., Boiocchi, M., Hawthorne, F.C., Della Ventura, G. and Färber, G. (2018) Potassic-jeanlouisite, IMA 2018-050. CNMNC Newsletter No. 45, October 2018, page xxx; Mineralogical Magazine, 82, xxx-xxx</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Amphibole</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/paulscherrerite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Paulscherrerite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>U | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic, monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(UO&lt;sub&gt;2&lt;/sub&gt;)(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2008-022</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
