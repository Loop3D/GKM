    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Akaganeite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Akaganeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mackay, A L (1962) ß-ferric oxyhydroxide-akaganéite, Mineralogical Magazine 33, 270-280 Chemical formula redefined: Post J E, Heaney P J, von Dreele R B, Hanson J C (2003) Neutron and temperature-resolved synchrotron X-ray powder diffraction study of akaganéite, American Mineralogist 88, 782-788</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Coronadite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.DK.05</gsmin:strunzcodeV10>
