    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Sr | Pb | U | Y | Fe | Ti | Cr | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Sr,Pb)(U,Y)Fe&lt;sub&gt;2&lt;/sub&gt;(Ti,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;18&lt;/sub&gt;O&lt;sub&gt;38&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2013-010</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Sr,Pb&lt;sup&gt;2+&lt;/sup&gt;)(U&lt;sup&gt;4+&lt;/sup&gt;,Y&lt;sup&gt;3+&lt;/sup&gt;)Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(Ti&lt;sup&gt;4+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;,Cr&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;18&lt;/sub&gt;O&lt;sub&gt;38&lt;/sub&gt;</gsmin:rruffchemistry>
