  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/heyerdahlite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Heyerdahlite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Mn | Ti | Si | O | H | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;3&lt;/sub&gt;Mn&lt;sub&gt;7&lt;/sub&gt;Ti&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;F(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2016-108</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;3&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;7&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;F(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Heyerdahlite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Heyerdahlite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Sokolova E, Day M C, Hawthorne F C, Kristiansen R (2018) Heyerdahlite, Na_3_Mn_7_Ti_2_(Si_4_O_12_)_2_O_2_(OH)_4_F(H_2_O)_2_, a new mineral of the astrophyllite supergroup from the Larvik Plutonic complex, Norway: Description and crystal structure. Mineralogical Magazine 82, 243-255</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Astrophyllite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Faulting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf, K.K.E, Mehl, J.P. &amp; Jackson, J.A. (eds), 2005. Glossary of geology, 5th Edition. American Geological Institute, Alexandria, 779 p.</dct:source>
    <rdfs:comment xml:lang="en">The process of fracturing, frictional slip, and displacement accumulation that produces a fault</rdfs:comment>
    <rdfs:label xml:lang="en">faulting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Deformation"/>
  </rdf:Description>
