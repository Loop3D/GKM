    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;NaTi&lt;sub&gt;2&lt;/sub&gt;O(OH)Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3635</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3635:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3635.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;NaTi&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;)O(OH)</gsmin:rruffchemistry>
    <gsmin:rruffids>R080078</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Shcherbakovite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Shcherbakovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Es'kova E M, Kazakova M E (1954) Shcherbakovite - a new mineral, Doklady Akademii Nauk SSSR 99, 837-840</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Batisite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DH.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 4-periodic single chains, Si4O12</gsmin:strunzlabel>
