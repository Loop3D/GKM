  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/dussertite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Dussertite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ba | Fe | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">alunite-jarosite-dussertite subgroup</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/dussertite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaFe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)(AsO&lt;sub&gt;3&lt;/sub&gt;OH)(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Redefined|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1334</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1334:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1334.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaFe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;OH)(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060398 | R070486</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Dussertite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Dussertite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Barthoux J (1925) Description d’un minéral nouveau: la dussertite, Comptes Rendus de L’Académie des Sciences Paris 180, 299-301 Chemical formula redefined: McConnell D (1942) X-ray data on several phosphate minerals, American Journal of Science 240, 649-657</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Alunite-crandallite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BL.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH, etc.):RO4 = 3:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Dussertite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1925</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/bellbergite">
