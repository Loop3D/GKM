    <gsmin:rruffnameplain xml:lang="en">Stefanweissite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chukanov, N.V., Zubkova,N.V., Pekov, I.V., Vigasina, M.F., Polekhovsky, Y.S., Ternes, B., Schüller, W., Britvin, S.N. and Pushcharovsky, D.Y. (2018) Stefanweissite, IMA 2018-020. CNMNC Newsletter No. 44, August 2018, page 1016; Mineralogical Magazine, 82, 1015–1021</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Zirconolite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/takovite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Takovite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ni | Al | C | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">hydrotalcite</gsmin:fleischersgroup>
