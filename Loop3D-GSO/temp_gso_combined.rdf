    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;3&lt;/sub&gt;(Ce,La,Ca,Na,Sr)&lt;sub&gt;3&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;5&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1987-035</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:mindatid>min-3388</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3388:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3388.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;3&lt;/sub&gt;(Ce&lt;sup&gt;3+&lt;/sup&gt;,La&lt;sup&gt;3+&lt;/sup&gt;,Ca,Na,Sr)&lt;sub&gt;3&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;5&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R120060</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Rémondite-(Ce)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Remondite-(Ce)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Cesbron F, Gilles C, Pelisson P, Saugues J C (1988) La remondite-(Ce), un nouveau carbonate de terres rares de la famille de la burbankite, Comptes Rendus de l‘Académie des Sciences Paris Série II 307, 915-920 Spelling of name changed from remondite-(Ce) to rémondite-(Ce): Hålenius U, Hatert F, Pasero M, Mills S J (2015) IMA Commission on New Minerals, Nomenclature and Classification (CNMNC) Newsletter 28. New minerals and nomenclature modifications approved in 2015. Mineralogical Magazine 79, 1859-1864</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Burbankite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>05.AD.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate without additional anions, without H2O, With rare-earth elements (REE)</gsmin:strunzlabel>
