  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/augite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Augite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Mg | Fe | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">pyroxene</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/augite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Mg,Fe)&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-419</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:419:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-419.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Mg,Fe&lt;sup&gt;2+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;(Si,Al)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R061086 | R061108 | R070231 | R110063</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Augite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Augite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pliny [translated by Hardouin, 1685] (77) Augites, in Caii Plinii secundi Naturalis historiae libri XXXVII interpretatione et notis illustravit Joannes Harduinus in usum Delphini, Franciscum Muguet (Paris) 406-406 The name was used to describe several different species until this paper: Werner A G (1792) Geognostische Beobachtungen, auf einer Reife durch einen Theil des böhmischen Mittelgebirges, Bergmannisches Journal 1, 215-266</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Pyroxene</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DA.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 2-periodic single chains, Si2O6; pyroxene family</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Augite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>0</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/lechatelierite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Lechatelierite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Si | O</gsmin:chemistryelements>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">SiO&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Questionable mineral species|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Silicon dioxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-2363</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2363:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2363.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">SiO&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
