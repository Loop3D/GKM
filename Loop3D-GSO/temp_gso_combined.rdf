    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mereiterite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Mereiterite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Giester G, Rieck B (1995) Mereiterite, K2Fe[SO4]2·4H2O, a new leonite-type mineral from the Lavrion Mining District, Greece, European Journal of Mineralogy 7, 559-566</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.CC.55</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, with H2O, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Mereiterite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1993-045</gsmin:wikipediadate>
