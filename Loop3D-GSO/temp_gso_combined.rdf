    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sr&lt;sub&gt;9&lt;/sub&gt;Mg(PO&lt;sub&gt;3&lt;/sub&gt;OH)(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1989-040</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Nonastrontium magnesium hexaphosphate hydrogenphosphate</gsmin:iupacchemname>
    <gsmin:mindatid>min-3742</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3742:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3742.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sr&lt;sub&gt;9&lt;/sub&gt;Mg(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;(PO&lt;sub&gt;3&lt;/sub&gt;OH)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Strontiowhitlockite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Strontiowhitlockite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Britvin S N, Pakhomovskii Y A, Bogdanova A N, Skiba V I (1991) Strontiowhitlockite, Sr9Mg(PO3OH)(PO4)6, a new mineral species from the Kovdor deposit, Kola Peninsula, U.S.S.R, The Canadian Mineralogist 29, 87-93</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Whitlockite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.AC.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, without H2O, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Strontiowhitlockite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1989-040</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/tugarinovite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
