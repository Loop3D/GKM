  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Tephritoid">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Fine grained igneous rock than contains less than 90 percent mafic minerals, between 10 and 60 percent feldspathoid mineral in the QAPF fraction and has a plagioclase to total feldspar ratio greater than 0.5. Includes rocks classified in QAPF field 13 and 14 or chemically in TAS field U1 as basanite or tephrite.</rdfs:comment>
    <rdfs:label xml:lang="en">tephritoid</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Fine_Grained_Igneous_Rock"/>
    <skos:altLabel xml:lang="en">tephritic rock</skos:altLabel>
  </rdf:Description>
