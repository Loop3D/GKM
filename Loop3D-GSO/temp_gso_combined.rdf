    <gsmin:rruffnameplain xml:lang="en">Zaratite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">First described without a name: Martinez Alcibar A (1850) Raro é importante mineral de niquel. Revista Minera 1, 302-306</gsmin:statusnotes>
