    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;4&lt;/sub&gt;B&lt;sub&gt;10&lt;/sub&gt;O&lt;sub&gt;19&lt;/sub&gt;·20H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tertschite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tertschite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Meixner, H (1953) Einige Boratminerale (Colemanit und Tertschit, ein neues Mineral) aus der Türkei, Fortschritte der Mineralogie 31, 39-42</gsmin:statusnotes>
