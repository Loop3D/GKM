    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dicopper dimagnesium carbonate hexahydroxyl dihydrate</gsmin:iupacchemname>
