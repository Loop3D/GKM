    <gsmin:rruffnameplain xml:lang="en">Tondiite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Malcherek T, Bindi L, Dini M, Ghiara M R, Molina Donoso A, Nestola F, Rossi M, Schlüter J (2014) Tondiite, Cu_3_Mg(OH)_6_Cl_2_, the Mg-analogue of herbertsmithite. Mineralogical Magazine 78, 583-590</gsmin:statusnotes>
