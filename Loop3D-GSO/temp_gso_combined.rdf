    <gsmin:statusnotes xml:lang="en">Yu T, Chou H (1979) Ruarsite, a new mineral, Chinese Science Bulletin 24, 310-316</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.EB.20</gsmin:strunzcodeV10>
