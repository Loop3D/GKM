    <gsmin:imanumber xml:lang="en">IMA1972-005</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:mindatid>min-225</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:225:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-225.html</gsmin:mindaturl>
