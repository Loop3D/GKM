    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;7&lt;/sub&gt;(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;14&lt;/sub&gt;O&lt;sub&gt;19&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·12H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4308</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4308:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4308.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;7&lt;/sub&gt;(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;14&lt;/sub&gt;O&lt;sub&gt;19&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·12H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R090051</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Wölsendorfite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Wolsendorfite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Protas J (1957) La wölsendorfite, nouvelle espèce uranifère, Comptes Rendus Hebdomadaires des Séances de l’Académie des Sciences 244, 2942-2944 Chemical formula changed from PbU&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O: Burns P C (1999) A new complex sheet of uranyl polyhedra in the structure of wölsendorfite, 84, 1661-1673</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Wölsendorfite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.GB.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl hydroxide, With additional cations (K, Ca, Ba, Pb, etc.); with mainly UO2(O,OH)5 pentagonal polyhedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Wölsendorfite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1957</gsmin:wikipediadate>
  </rdf:Description>
