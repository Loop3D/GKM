    <gsmin:statusnotes xml:lang="en">Haidinger W (1846) Hauerit, Berichte Über die Mittheilungen von Freunden der Naturwissenschaften in Wien 7, 2-3</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Pyrite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.EB.05a</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide, M: S &lt;= 1:2 with Fe, Co, Ni, PGE, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Hauerite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1846</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/buddingtonite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Buddingtonite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>N | H | Al | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">feldspar</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/buddingtonite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(NH&lt;sub&gt;4&lt;/sub&gt;)(AlSi&lt;sub&gt;3&lt;/sub&gt;)O&lt;sub&gt;8&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1963-001</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-796</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:796:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-796.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(N&lt;sup&gt;3-&lt;/sup&gt;H&lt;sub&gt;4&lt;/sub&gt;)AlSi&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;8&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R061115</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Buddingtonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Buddingtonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Erd R C, White D E, Fahey J J, Lee D E (1964) Buddingtonite, an ammonium feldspar with zeolitic water, American Mineralogist 49, 831-851 Chemical formula revised: Voncken J H L, Van Roermund H L M, Van Der Eerden A M J, Jansen J B H, Erd R C (1993) Holotype buddingtonite: An ammonium feldspar without zeolitic H&lt;sub&gt;2&lt;/sub&gt;O, American Mineralogist 78, 204-209</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Feldspar</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.FA.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Tektosilicate without additional non-tetrahedral anions</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Buddingtonite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1963-001</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/sulphohalite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Sulphohalite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | S | O | Cl | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/sulphohalite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;6&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;ClF</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Hexasodium disulfate chloride fluoride</gsmin:iupacchemname>
    <gsmin:mindatid>min-3824</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3824:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3824.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;6&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;ClF</gsmin:rruffchemistry>
    <gsmin:rruffids>R050479</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sulphohalite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Sulphohalite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hidden W E, Mackintosh J B (1888) On a new sodium sulphato-chloride, sulphohalite, The American Journal of Science 136, 463-464</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.BD.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions, without H2O, With only large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Sulphohalite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1888</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfold/Ptygmatic_Fold">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Chaotic and highly sinuous fold typically in an isolated layer within a more homogeneous rock body. Typical of sedimentary slump folding and veins or dikes in medium to high-grade metamorphic rocks</rdfs:comment>
    <rdfs:label xml:lang="en">Ptygmatic Fold </rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfold/Fold"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/edenharterite">
