    <gsmin:chemistryelements>Co | Sb | As</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">Marcasite-Löllingite-Löllingite subgroup</gsmin:fleischersgroup>
