  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Carbonate_Rich_Mudstone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">This vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Carbonate-rich mudstone' definition limits carbonate to mud-size fraction to avoid overlap with 'impure carbonate sedimentary rock'. If carbonate minerals are in sand or gravel size fractions, use 'impure carbonate sedimentary rock'. The operational test typically used to identify this category is if the rock fizzes when hydrochloric acid is applied. The '10 percent carbonate' criteria is a fuzzy boundary.</rdfs:comment>
    <rdfs:comment xml:lang="en">Mudstone that contains between 10 and 50 percent carbonate minerals in the mud size fraction. Carbonate origin is not specified.</rdfs:comment>
    <rdfs:label xml:lang="en">carbonate rich mudstone</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Generic_Mudstone"/>
    <skos:altLabel xml:lang="en">marlstone</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/panasqueiraite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Panasqueiraite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Mg | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">durangite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/panasqueiraite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaMg(PO&lt;sub&gt;4&lt;/sub&gt;)(OH)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1978-063</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Calcium magnesium phosphate hydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-3073</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3073:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3073.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaMgPO&lt;sub&gt;4&lt;/sub&gt;(OH)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Panasqueiraite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Panasqueiraite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Isaacs A M, Peacor D R (1981) Panasqueiraite, a new mineral: the OH-equivalent of isokite, The Canadian Mineralogist 19, 389-392</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Titanite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BH.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH,etc.):RO4 = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Panasqueiraite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1978-063</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/mroseite">
