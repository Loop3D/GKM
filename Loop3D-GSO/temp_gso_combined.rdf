  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/Eoarchean2004">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologictime/Era"/>
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Specific_Geologic_Time_Unit"/>
    <rdfs:comment xml:lang="en">Eoarchean as defined in 2004-04, before acceptance of Hadean into ISC. Age of lower bound is undefined but assigned Age of Earth here</rdfs:comment>
