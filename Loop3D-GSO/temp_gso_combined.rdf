  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/jamesite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Jamesite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Zn | Fe | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/jamesite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;2&lt;/sub&gt;ZnFe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;,Zn)&lt;sub&gt;4&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;8&lt;/sub&gt;(OH,O)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1978-079</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2071</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2071:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2071.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Zn&lt;sup&gt;2+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;,Zn&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;4&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;8&lt;/sub&gt;(OH,O)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060274</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Jamesite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Jamesite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Keller P, Hess H, Dunn P J (1981) Jamesite, Pb_2_Zn_2_Fe^3+^_5_O_4_(AsO_4_)_5_, a new mineral from Tsumeb, Namibia, Chemie der Erde 40, 105-109 Chemical formula changed from Pb_2_Zn_2_Fe^3+^_5_(AsO_4_)_5_O_4_: Cooper M A, Hawthorne F C (1999) Local Pb^2+^–[box] disorder in the crystal structure of jamesite, Pb_2_ZnFe^3+^_2_(Fe^3+^_2.8_Zn_1.2_)(AsO_4_)_4_(OH)_8_[(OH)_1.2_O_0.8_], and revision of the chemical formula. The Canadian Mineralogist 37, 53-60</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.BK.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH, etc.):RO4 = 2:1, 2.5:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Jamesite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1978-079</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BasePleistocene2004">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Boundary"/>
    <dct:source xml:lang="en">Gradstein, Ogg, Smith, 2004, A Geologic Time Scale 2004</dct:source>
    <rdfs:comment xml:lang="en">based on Quaternary as defined in 2004; GSSP as defined remains the base of the Calabrian </rdfs:comment>
    <rdfs:label xml:lang="en">Base of Middle Ordovician</rdfs:label>
    <gsoc:hasEssentialPart rdf:nodeID="ndb26e920196f4af8bbd263b193e6f242b809"/>
    <gsoc:isPartOf rdf:resource="https://w3id.org/gso/1.0/ischart/isc2004-04"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/vuonnemite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Vuonnemite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Nb | Ti | Si | O | P | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">epistolite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/vuonnemite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;6&lt;/sub&gt;Na&lt;sub&gt;2&lt;/sub&gt;Nb&lt;sub&gt;2&lt;/sub&gt;Na&lt;sub&gt;3&lt;/sub&gt;Ti(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(OF)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1973-015</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:mindatid>min-4216</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4216:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4216.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;6&lt;/sub&gt;Na&lt;sub&gt;2&lt;/sub&gt;Nb&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Na&lt;sub&gt;3&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(OF)</gsmin:rruffchemistry>
    <gsmin:rruffids>R050250 | R080015 | R070690</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Vuonnemite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Vuonnemite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Bussen I V, Denisov A P, Zabavnikova N I, Kozyreva L V, Men'Shikov Y P, Lipatova E A (1973) Vuonnemite, a new mineral, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 102, 423-426</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Seidozerite-Lamprophyllite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.BE.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate: Si2O7 groups, with additional anions; cations in octahedral [6] and greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Vuonnemite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1973-015</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/aenigmatite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Aenigmatite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Fe | Ti | O | Si</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">aenigmatite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/aenigmatite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;4&lt;/sub&gt;[Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;10&lt;/sub&gt;Ti&lt;sub&gt;2&lt;/sub&gt;]O&lt;sub&gt;4&lt;/sub&gt;[Si&lt;sub&gt;12&lt;/sub&gt;O&lt;sub&gt;36&lt;/sub&gt;]</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-33</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:33:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-33.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;4&lt;/sub&gt;(Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;10&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;)O&lt;sub&gt;4&lt;/sub&gt;[Si&lt;sub&gt;12&lt;/sub&gt;O&lt;sub&gt;36&lt;/sub&gt;]</gsmin:rruffchemistry>
    <gsmin:rruffids>R061088 | R061089</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Aenigmatite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Aenigmatite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Breithaupt A (1865) Mineralogische studien. 29. Kölbingit. Ainigmatit, Berg- und Huttenmannische Zeitung 24, 397-398</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Sapphirine</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DH.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 4-periodic single chains, Si4O12</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Aenigmatite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1865</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/dokuchaevite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Dokuchaevite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | O | V | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(VO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;Cl&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2018-012</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Pending publication</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(V&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;Cl&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Dokuchaevite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Dokuchaevite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Siidra, O.I., Nazarchuk, E.V., Zaitsev, A.N., Polekhovsky, Y.S., Wenzel, T. and Spratt, J (2018) Dokuchaevite, IMA2018-012. CNMNC Newsletter No 43, June 2018, page 783; Mineralogical Magazine, 82, 779–785</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/evdokimovite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Evdokimovite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Tl | V | O | S | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tl&lt;sub&gt;4&lt;/sub&gt;(VO)&lt;sub&gt;3&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;5&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;5&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2013-041</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tl&lt;sup&gt;1+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;(V&lt;sup&gt;4+&lt;/sup&gt;O)&lt;sub&gt;3&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;5&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Evdokimovite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Evdokimovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Siidra O I, Vergasova L P, Kretser Y L, Polekhovsky Y S, Filatov S K, Krivovichev S V (2014) Unique thallium mineralization in the fumaroles of the Tolbachik volcano, Kamchatka Peninsula, Russia. III. Evdokimovite, Tl_4_(VO)_3_(SO_4_)_5_(H_2_O)_5_. Mineralogical Magazine 78, 1711-1724</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/gottardiite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
