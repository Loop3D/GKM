    <gsmin:imanumber xml:lang="en">IMA1988-014</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Lead tricopper divanadate dichloride</gsmin:iupacchemname>
    <gsmin:mindatid>min-2374</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2374:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2374.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(V&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;Cl&lt;sup&gt;1-&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070053</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Leningradite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Leningradite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Vergasova L P, Filatov S K, Semenova T F, Anan'yev V V (1990) Leningradite PbCu_3_(VO_4_)_2_Cl_2_, a new mineral from volcanic exhalations, Doklady Akademii Nauk SSSR 310, 1434-1437</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.BH.65</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH,etc.):RO4 = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Leningradite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1988-014</gsmin:wikipediadate>
