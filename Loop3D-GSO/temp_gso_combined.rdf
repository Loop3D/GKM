  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Mid_Ocean_Ridge_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI Event Environment vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Ocean highland associated with a divergent continental margin (spreading center). Setting is characterized by active volcanism, locally steep reliefhydrothermal activity, and pelagic sedimentation.</rdfs:comment>
    <rdfs:label xml:lang="en">mid ocean ridge setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Ocean_Highland_Setting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseSakmarianSP2020">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologiccontact/GSSP"/>
    <rdfs:comment xml:lang="en">The base of the Sakmarian Stage is defined in Bed 26/3 at 55.4m above the base of the Usolka Section, southern Urals, Russia. It coincides with the first occurrence of conodont Mesogondolella monstra.</rdfs:comment>
    <rdfs:label xml:lang="en">GSSP Base of Sakmarian</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://timescalefoundation.org/gssp/detail.php?periodid=89&amp;top_parentid=77"/>
    <owl:versionInfo>2018</owl:versionInfo>
  </rdf:Description>
