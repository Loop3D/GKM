  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicunit/Chronostratigraphic_Unit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Chronostratigraphic unit</rdfs:label>
    <dct:source xml:lang="en">Salvador, A., 1994, International Stratigraphic Guide, Second Edition</dct:source>
    <rdfs:comment xml:lang="en">A body of rocks that includes all rocks, layered or unlayered, formed during a specific interval of geologic time, and only those rocks formed during that time span. Chronostratigraphic units are bounded by synchronous horizons. The rank and relative magnitude of the units in the chronostratigraphic hierarchy are a function of the length of the time interval that their rocks subtend, rather than of their physical thickness. (http://www.stratigraphy.org/upload/bak/chron.htm)</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="n6d111a80c3f44937a55e40566db5bca3b98"/>
    <rdfs:subClassOf rdf:nodeID="n6d111a80c3f44937a55e40566db5bca3b99"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicunit/Stratigraphic_Unit"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Intertidal_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al., 2005</dct:source>
    <rdfs:comment xml:lang="en">Pertaining to the benthic ocean environment or depth zone between high water and low water, also, pertaining to the organisms of that environment</rdfs:comment>
    <rdfs:label xml:lang="en">intertidal setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Subaqueous_Setting"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Tidal_Setting"/>
    <rdfs:subClassOf rdf:nodeID="nb91377c629b1476ba973ba249cd56575b47"/>
  </rdf:Description>
