    <gsmin:rruffids>R070183 | R080042</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Stishovite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Stishovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chao E C T, Fahey J J, Littler J, Milton D J (1962) Stishovite, SiO2, a very high pressure new mineral from Meteor Crater, Arizona, Journal of Geophysical Research 67, 419-421</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.DA.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With small cations: Silica family</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Stishovite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1962</gsmin:wikipediadate>
