    <gsmin:iupacchemname xml:lang="en">IUPAC: Aluminium iron trisulfate nonahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-40001</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:40001:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-40001.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">AlFe&lt;sup&gt;3+&lt;/sup&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;·9H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
