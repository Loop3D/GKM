    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaZn&lt;sup&gt;2+&lt;/sup&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Minrecordite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Minrecordite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Garavelli C G, Vurro F, Fioravanti G C (1982) Minrecordite a new mineral from Tsumeb, The Mineralogical Record 13, 131-136</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Dolomite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>05.AB.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate without additional anions, without H2O, Alkali-earth (and other M2+) carbonates</gsmin:strunzlabel>
