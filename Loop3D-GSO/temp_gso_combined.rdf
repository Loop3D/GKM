  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/chenite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Chenite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Pb | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/chenite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CuPb&lt;sub&gt;4&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1983-069</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Copper tetralead disulfate hexahydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-987</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:987:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-987.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R130276 | R130278</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Chenite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Chenite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Paar W H, Mereiter K, Braithwaite R S W, Keller P, Dunn P J (1986) Chenite, Pb&lt;sub&gt;4&lt;/sub&gt;Cu(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;, a new mineral, from Leadhills, Scotland, Mineralogical Magazine 50, 129-135</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.BC.70</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions, without H2O, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Chenite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1983-069</gsmin:wikipediadate>
  </rdf:Description>
