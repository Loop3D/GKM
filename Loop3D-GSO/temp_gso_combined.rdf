    <gsmin:statusnotes xml:lang="en">Burke E A J, Lustenhouwer W J (1981) Pehrmanite, a new beryllium mineral from Rosendal Pegmatite, Kemio Island, southwestern Finland, The Canadian Mineralogist 19, 311-314 Name changed from pehrmanite: Armbruster T (2002) Revised nomenclature of högbomite, nigerite, and taafeite minerals, European Journal of Mineralogy 14, 389-395</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Taaffeite-Ferrotaaffeite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, hydroxide or arsenite</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Ferrotaaffeite-6N3S.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1979-047</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/scottyite">
