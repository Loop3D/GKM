    <gsmin:fleischersgroup xml:lang="en">mica-true micas</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/nanpingite.pdf</gsmin:handbookofmineralogyurl>
