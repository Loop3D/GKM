    <gsmin:statusnotes xml:lang="en">Topa D, Makovicky E, Balic-Žunic T, Paar W H (2003) Kupcíkite, Cu_3.4_Fe_0.6_Bi_5_S_10_, a new Cu-Bi sulfosalt from Felbertal, Austria, and its crystal structure, The Canadian Mineralogist 41, 1155-1166</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.JA.10b</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">PbS type sulfosalt with  little or no Pb</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Kupcikite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2001-017</gsmin:wikipediadate>
  </rdf:Description>
