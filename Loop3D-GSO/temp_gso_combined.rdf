    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;As&lt;sup&gt;5+&lt;/sup&gt;Si&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;(OH)</gsmin:rruffchemistry>
    <gsmin:rruffids>R130101</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tiragalloite</gsmin:rruffnamehtml>
