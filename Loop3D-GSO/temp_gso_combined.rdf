  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/cohenite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cohenite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Fe | C</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/cohenite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CFe&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Triiron carbide</gsmin:iupacchemname>
    <gsmin:mindatid>min-1107</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1107:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1107.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sub&gt;3&lt;/sub&gt;C</gsmin:rruffchemistry>
    <gsmin:rruffids>R100076</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cohenite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cohenite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Weinschenk E (1889) Ueber einige bestandtheile de meteoreisens von Magura, Arva, Ungarn, Annalen des Kaiserlich-Königlichen Naturhistorischen Hofmuseums 4, 93-101</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Perovskite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>01.BA.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbides</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Cohenite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1889</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/cobaltomenite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cobaltomenite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Co | Se | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">cobaltomenite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/cobaltomenite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Co(Se&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Renamed|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Cobalt seleniumIV trioxide dihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1092</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1092:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1092.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Co&lt;sup&gt;2+&lt;/sup&gt;Se&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070352 | R110040</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cobaltomenite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cobaltomenite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Bertrand E (1882) Sur la molybdoménite (sélénite de plomb), la cobaltoménite (sélénite de cobalt) et l´acide sélénieux de Cacheuta (La Plata), Bulletin de la Société Minéralogique de France 5, 90-92</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Cobaltomenite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.JH.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Selenite without additional anions, with H2O</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Cobaltomenite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1882</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Extended_Terrane_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI Event Environment vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Tectonic setting characterized by extension of the upper crust manifested by formation of rift valleys or basin and range physiography, with arrays of low to high angle normal faults. Modern examples include the North Sea, East Africa, and the Basin and Range of the North American Cordillera. Typically applied in continental crustal settings.</rdfs:comment>
    <rdfs:label xml:lang="en">extended terrane setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Tectonic_Setting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/lenaite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Lenaite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ag | Fe | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">chalcopyrite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/lenaite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">AgFeS&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1994-008</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Silver iron disulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-2372</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2372:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2372.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ag&lt;sup&gt;1+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Lenaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Lenaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Amuzinsky V A, Zhdanov Y Y, Zayakina N V, Leskova N V (1995) Lenaite AgFeS_2_ – a new mineral species, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 124(5) 85-91</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Chalcopyrite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.CB.10a</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide (M = S) with Zn, Fe, Cu, Ag, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Lenaite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1994-008</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/metauranocircite-i">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Metauranocircite-I</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ba | U | O | P | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">autunite</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R050575</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Metauranocircite-I</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Metauranocircite-I</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named métauranocircite: Gaubert M P (1904) Produits de déshydratation de quelques phosphates et orientation du chlorure de baryum sur les minéraux du groupe de l´autunite, Bulletin de la Société Française de Minéralogie 27, 222-233 Name changed from métauranocircite to metauranocircite I: Walenta K (1963) Über die barium-uranylphosphatmineralien uranocircit I, II und metauranocircit I, II von Menzenschwand in südlichen Schwarzwald, Jahreshefte des Geologischen Landesamtes Baden-Württemberg 6, 113-135 Name changed from metauranocircite I to metauranocircite-I: Nickel E H, Nichols M C (2009) IMA/CNMNC list of mineral names compiled by Ernest H. Nickel &amp; Monte C. Nichols supplied through the courtesy of Materials Data, Inc. (http://www.MaterialsData.com) and based on the database MINERAL, which MDI makes available as a free download to the mineralogical community. 1-315</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:nodeID="nb91377c629b1476ba973ba249cd56575b58">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
