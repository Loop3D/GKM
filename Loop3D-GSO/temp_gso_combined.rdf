    <gsmin:mindaturl>http://www.mindat.org/min-560.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CeCO&lt;sub&gt;3&lt;/sub&gt;F</gsmin:rruffchemistry>
    <gsmin:rruffids>R050409 | R060359 | R060629 | R060550 | R060737</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bastnäsite-(Ce)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Bastnasite-(Ce)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Huot J J N (1841) Genre. Lanthane. 2 Espèce, Bastnaesite, in Manuels-Roret. Nouveau Manuel Complet de Minéralogie, Première Partie, (Paris) 296-296 Name changed from bastnasite: Levinson A A (1966) A system of nomenclature for rare-earth minerals, American Mineralogist 51, 152-158</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Bastnäsite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.??</gsmin:strunzcodeV10>
