    <gsmin:imanumber xml:lang="en">IMA1979-055</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dicopper pyrovanadateV</gsmin:iupacchemname>
