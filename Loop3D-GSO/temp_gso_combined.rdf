  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/halotrichite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Halotrichite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Fe | Al | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">halotrichite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/halotrichite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;Al&lt;sub&gt;2&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;·22H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: IronII dialuminium tetrasulfate docosahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1809</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1809:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1809.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;Al&lt;sub&gt;2&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;·22H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060118 | R070673</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Halotrichite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Halotrichite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named halotrichum: Scopoli J A (1777) Basi Metallica. Halotrichum, in Fundementa Chemiae, Wolfgangum Gerle (Prague) 23-27 Renamed halotrichite: Glocker E F (1839) 18. Halotrichit, in Grundrib der Mineralogie, mit Einschlub der Geognosie und Petrefactenkunde, Schrag (Nurnberg) 691-691</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Halotrichite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.CB.85</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, with H2O, With only medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Halotrichite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1777</gsmin:wikipediadate>
  </rdf:Description>
