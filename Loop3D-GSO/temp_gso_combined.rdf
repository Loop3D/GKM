    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Srilankite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Srilankite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Willgallis A, Siegmann E, Hettiaratchi T (1983) Srilankite, a new Zr-Ti-oxide mineral, Neues Jahrbuch für Mineralogie, Monatshefte 1983, 151-157</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Columbite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.DB.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With medium-sized cations; chains of edge-sharing octahedra</gsmin:strunzlabel>
