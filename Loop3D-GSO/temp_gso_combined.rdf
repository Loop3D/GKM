    <gsmin:rruffnameplain xml:lang="en">Mendeleevite-(Ce)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Sokolova E, Hawthorne F C, Pautov L A, Agakhanov A A, Karpenko V Y (2011) The crystal structure and crystal chemistry of mendeleevite-(Ce), (Cs,[box])_6_([box],Cs)_6_([box],K)_6_(REE,Ca,[box])_30_(Si_70_O_175_)(H_2_O,OH,F,[box])_35_, a potential microporous material, Mineralogical Magazine 75, 2583-2596 Pautov L A, Agakhanov A A, Karpenko V Y, Sokolova E V, Hawthorne F C (2013) (Cs,[box])_6_([box],Cs)_6_([box],K)_6_(REE,Ca,[box])_30_(Si_70_O_175_)(H_2_O,OH,F,[box])_35_: a new mineral from the Darai-Pioz Massif, Tajikistan. Doklady Earth Sciences 452, 1023-1026 Chemical formula revised from (Cs,[box])_6_([box],Cs)_6_([box],K)_6_(Ce,Ca,[box])_30_(Si_70_O_175_)(H_2_O,OH,F,[box])_35_: Mineralogical Magazine 81 (2017), 113</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Mendeleevite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">silicate</gsmin:strunzlabel>
