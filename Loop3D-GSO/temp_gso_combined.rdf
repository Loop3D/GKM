    <gsmin:rruffnameplain xml:lang="en">Chlormayenite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hentschel G (1964) Mayenit, 12CaO·7Al_2_O_3_, und brownmillerit, 2CaO·(Al,Fe)_2_O_3_, zwei neue minerale in den kalksteinschlüssen der lava des Ettringer Bellerberges, Neues Jahrbuch für Mineralogie, Monatshefte 1, 22-29 Name changed from mayenite: Williams P A, Hatert F, Pasero M, Mills S J (2014) IMA Commission on new minerals, nomenclature and classification (CNMNC) Newsletter 20. New minerals and nomenclature modifications approved in 2014. Mineralogical Magazine 78, 549-558</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Mayenite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ferrohexahydrite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ferrohexahydrite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Fe | S | O | H</gsmin:chemistryelements>
    <gsmin:fleischersgroup xml:lang="en">hexahydrite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/ferrohexahydrite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: IronII sulfate hexahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1517</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1517:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1517.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ferrohexahydrite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ferrohexahydrite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Name was earlier proposed for the hypothetical mineral (Shubnikova, 1947): Mineral is observed in nature: Vlasov V V, Kuznetsov A V (1962) Melanterite and the products of its alteration, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 91(4), 490-492</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hexahydrite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.CB.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, with H2O, With only medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Ferrohexahydrite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1947</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/cuprorhodsite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cuprorhodsite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Fe | Rh | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
