  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/vesuvianite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Vesuvianite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Na | Al | Mg | Fe | Si | O | H | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">vesuvianite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/vesuvianite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Na)&lt;sub&gt;19&lt;/sub&gt;(Al,Mg,Fe)&lt;sub&gt;13&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;10&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH,F,O)&lt;sub&gt;10&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4223</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4223:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4223.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Na)&lt;sub&gt;19&lt;/sub&gt;(Al,Mg,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;13&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;10&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH,F,O)&lt;sub&gt;10&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050056 | R050035 | R050233 | R050489 | R060170 | R060532 | R060902 | R070226</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Vesuvianite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Vesuvianite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Klaproth M H (1795) Vesuvian, hellbrauner, Beiträge zur Chemischen Kenntniss der Mineralkörper 1, 34-35</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Vesuvianite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.BG.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate with mixed SiO4 and Si2O7 groups; cations in octahedral [6] and greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Vesuvianite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1795</gsmin:wikipediadate>
  </rdf:Description>
