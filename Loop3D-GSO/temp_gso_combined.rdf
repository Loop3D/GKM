    <gsmin:rruffnameplain xml:lang="en">Liebigite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Smith J L (1848) Two new minerals, - medjidite (sulphate of uranium and lime) - liebigite (carbonate of uranium and lime), The American Journal of Science and Arts 5, 336-338</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.ED.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl Carbonate, UO2:CO3 = 1:3</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Liebigite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1848</gsmin:wikipediadate>
