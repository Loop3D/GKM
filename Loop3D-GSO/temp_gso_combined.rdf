    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3161:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3161.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">MgO</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Periclase</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Periclase</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Scacchi A (1841) Della periclasia, nuova specie di minerale del monte di Somma, in Memorie Mineralogische e Geologische, (Napoli) 23-32</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Rocksalt</gsmin:structuralgroup>
