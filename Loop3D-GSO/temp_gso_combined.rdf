  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/anorpiment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Anorpiment</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>As | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">As&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2011-014</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Diarsenic trisulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-42349</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:42349:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-42349.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">As&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R110016</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Anorpiment</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Anorpiment</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf A R, Downs R T, Housley R M, Jenkins R A, Hyršl J (2011) Anorpiment, As&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;3&lt;/sub&gt;, the triclinic dimorph of orpiment, Mineralogical Magazine 75, 2857-2867</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">sulfide or sulfosalt</gsmin:strunzlabel>
    <gsmin:wikipediadate>2011-014</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/haggertyite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Haggertyite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ba | Fe | Ti | Mg | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">plumboferrite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/haggertyite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaFe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Ti&lt;sub&gt;5&lt;/sub&gt;MgO&lt;sub&gt;19&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1996-054</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Barium hexairon pentatitanium magnesium nonadecaoxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-6984</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:6984:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-6984.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaMgFe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;O&lt;sub&gt;19&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Haggertyite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Haggertyite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Grey I E, Velde D, Criddle A J (1998) Haggertyite, a new magnetoplumbite-type titanate mineral from the Prairie Creek (Arkansas) lamproite, American Mineralogist 83, 1323-1329</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Plumboferrite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.CC.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 2: 3,3: 5, and similar, With large and medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Haggertyite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1996-054</gsmin:wikipediadate>
  </rdf:Description>
