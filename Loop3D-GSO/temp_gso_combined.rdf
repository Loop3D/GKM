    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Haidingerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Haidingerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Turner E (1827) On haidingerite, a new mineral species, The Edinburgh Journal of Science 6, 317-318</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.CJ.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With only large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Haidingerite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1827</gsmin:wikipediadate>
