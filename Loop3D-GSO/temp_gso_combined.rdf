    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Koechlinite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Koechlinite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Schaller W T (1914) Mineralogical notes. Koechlinite (bismuth molybdate), a new mineral from Schneeberg, Journal of the Washington Academy of Sciences 4, 354-356</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.DE.15</gsmin:strunzcodeV10>
