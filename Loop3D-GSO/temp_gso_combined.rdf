    <gsmin:rruffnameplain xml:lang="en">Irarsite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Genkin A D, Zhuravlev N N, Troneva N V, Murav'eva (1966) Irarsite, a new sulfoarsenide of iridium, ruthenium, and plantinum, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 95(6), 700-712</gsmin:statusnotes>
