  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ferriandrosite-la">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ferriandrosite-(La)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | La | Fe | Al | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">MnLaFe&lt;sup&gt;3+&lt;/sup&gt;AlMn&lt;sup&gt;2+&lt;/sup&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)(SiO&lt;sub&gt;4&lt;/sub&gt;)O(OH)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2013-127</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;La&lt;sup&gt;3+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;AlMn&lt;sup&gt;2+&lt;/sup&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)(SiO&lt;sub&gt;4&lt;/sub&gt;)O(OH)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ferriandrosite-(La)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ferriandrosite-(La)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Nagashima M, Nishio-Hamane D, Tomita N, Minakawa T, Inaba S (2015) Ferriakasakaite-(La) and ferriandrosite-(La): new epidote-supergroup minerals from Ise, Mie Prefecture, Japan. Mineralogical Magazine 79, 735-753</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Epidote</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/lepageite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Lepageite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | Fe | O | Sb | As</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;7&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;)O&lt;sub&gt;3&lt;/sub&gt;[Sb&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;As&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;34&lt;/sub&gt;]</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2018-028</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Pending publication</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;7&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;)O&lt;sub&gt;3&lt;/sub&gt;[Sb&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;As&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;34&lt;/sub&gt;]</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Lepageite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Lepageite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pieczka, A., Cooper, M.A. and Hawthorne, F.C. (2018) Lepageite, IMA 2018-028. CNMNC Newsletter No. 44, August 2018, page 1018; Mineralogical Magazine, 82, 1015–1021</gsmin:statusnotes>
  </rdf:Description>
