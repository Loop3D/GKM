    <gsmin:webmineralurl>http://www.webmineral.com/data/Phosphowalpurgite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2001-062</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/namansilite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
