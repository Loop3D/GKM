  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfault/Dextral">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">GGIC vocabularies working group (Australia)</dct:source>
    <rdfs:comment xml:lang="en">In plan view, the side opposite the observer is displaced to the right.</rdfs:comment>
    <rdfs:comment xml:lang="en">Right-lateral separation sense, in plan view, the side opposite the observer appears displaced to the right.,</rdfs:comment>
    <rdfs:label xml:lang="en">dextral</rdfs:label>
