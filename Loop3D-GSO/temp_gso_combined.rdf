    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:39302:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-39302.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaMn&lt;sup&gt;2+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Gayite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Gayite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf A R, Colombo F, González del Tánago J (2010) Gayite, a new dufrénite-group mineral from the Gigante granitic pegmatite, Córdoba province, Argentina, American Mineralogist 95, 386-391</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Dufrénite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DK.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 &gt; 1:1 and &lt; 2:1</gsmin:strunzlabel>
    <gsmin:wikipediadate>2008-056</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/wuyanzhiite">
