  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/manganochromite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Manganochromite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | Cr | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">spinel</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/manganochromite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;Cr&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1975-020</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: ManganeseII dichromium tetraoxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-2475</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2475:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2475.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;Cr&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Manganochromite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Manganochromite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Graham J (1978) Manganochromite, palladium antimonide, and some unusual mineral associations at the Nairne pyrite deposit, South Australia, American Mineralogist 63, 1166-1174</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Spinel</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.BB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 3:4 and similar, With only medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Manganochromite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1975-020</gsmin:wikipediadate>
  </rdf:Description>
