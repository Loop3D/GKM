    <gsmin:rruffnameplain xml:lang="en">Abramovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Yudovakaya M A, Trybkin N V, Koporulina E V, Belakovsky D I, Mokhov A V, Kuznetsova M V, Golovanova T I (2007) Abramovite, Pb&lt;sub&gt;2&lt;/sub&gt;SnInBiS&lt;sub&gt;7&lt;/sub&gt; - the new mineral from fumaroles of Kudryavy Volcano (Kurily Islands), Zapiski Rossiiskogo Mineralogicheskogo Obshchetstva 136(5), 45-51</gsmin:statusnotes>
