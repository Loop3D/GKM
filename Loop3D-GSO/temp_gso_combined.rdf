    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na(Mn&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;7&lt;/sub&gt;Mn&lt;sup&gt;3+&lt;/sup&gt;)O&lt;sub&gt;16&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1966-009</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
