  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/Low_Dimension_Feature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A feature that is immaterial but spatially located, typically a lower dimension subdivision of the host  (north pole, equator, earth surface, center of town); host is physical endurant, focal is spatial location relative to host.</rdfs:comment>
    <rdfs:comment xml:lang="en">point, line or surface in 3-D space; a line or point in a 2-D space, a point in a 1-D space.</rdfs:comment>
    <rdfs:label xml:lang="en">Low Dimension Feature </rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Immaterial_Feature"/>
