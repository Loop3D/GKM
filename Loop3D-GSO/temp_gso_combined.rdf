    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ta(OH)&lt;sub&gt;3&lt;/sub&gt;(O,CO&lt;sub&gt;3&lt;/sub&gt;)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1983-023</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2207</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2207:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2207.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ta&lt;sup&gt;5+&lt;/sup&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;(O,CO&lt;sub&gt;3&lt;/sub&gt;)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kimrobinsonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kimrobinsonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Nickel E H, Robinson B W (1985) Kimrobinsonite, a new tantalum mineral from Western Australia, and its association with cesstibtantite, The Canadian Mineralogist 23, 573-576</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.FG.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Hydroxide (without V or U), with OH, without H2O; unclassified</gsmin:strunzlabel>
