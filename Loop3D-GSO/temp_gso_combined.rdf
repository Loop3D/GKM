    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Sodium trialuminium diphosphate tetrahydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-760</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:760:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-760.html</gsmin:mindaturl>
