  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/tungusite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Tungusite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Fe | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/tungusite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;14&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;9&lt;/sub&gt;Si&lt;sub&gt;24&lt;/sub&gt;O&lt;sub&gt;60&lt;/sub&gt;(OH)&lt;sub&gt;22&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1966-029</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4055</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4055:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4055.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;14&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;9&lt;/sub&gt;Si&lt;sub&gt;24&lt;/sub&gt;O&lt;sub&gt;60&lt;/sub&gt;(OH)&lt;sub&gt;22&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070757</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tungusite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tungusite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kudryashova V I (1966) Tungusite, a new mineral of the hydrous calcium silicate group. Doklady Akademii Nauk SSSR 171, 1167-1170 Chemical formula redefined: Ferraris G, Pavese A, Soboleva S V (1995) Tungusite: new data, relationshhip with gyrolite and structural model, Mineralogical Magazine 59, 535-543</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Gyrolite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EE.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate: Single tetrahedral nets of 6-membered rings connected by octahedral nets or octahedral bands</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Tungusite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1966-029</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/abellaite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Abellaite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Pb | C | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaPb&lt;sub&gt;2&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)</gsmin:imachemistry>
