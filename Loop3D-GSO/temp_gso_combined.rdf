    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Oxyvanite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Oxyvanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Reznitsky L Z, Sklyarov E V, Armbruster T, Ushchapovskaya Z F, Galuskin E V, Polekhovsky Y S, Barash I G (2009) The new mineral oxyvanite V_3_O_5_ and the oxyvanite-berdesinskiite V_2_TiO_5_ isomorphic join in metamorphic rocks of Sludyanka complex (South Baikal region), Zapiski Rossiiskogo Mineralogicheskogo Obshchetstva 138(3), 70-81</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Berdesinskiite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.CB.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 2: 3,3: 5, and similar, With medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://webmineral.com/data/Oxyvanite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2008-044</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/xenotime-y">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
