    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sb&lt;sub&gt;2&lt;/sub&gt;OS&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Diantimony oxydisulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-2187</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2187:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2187.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sb&lt;sub&gt;2&lt;/sub&gt;OS&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060742</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kermesite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kermesite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Beudant F S (1832) Kermès, antimoine rouge, in Traité Élémentaire de Minéralogie, 2nd Edition, (Paris) 617-618</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.FD.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Other sulfide with O, OH, H2O</gsmin:strunzlabel>
