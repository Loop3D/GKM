  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/bosiite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Bosiite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Fe | Al | Mg | Si | O | B | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaFe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(Al&lt;sub&gt;4&lt;/sub&gt;Mg&lt;sub&gt;2&lt;/sub&gt;)(Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;)(BO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2014-094</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaFe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(Al&lt;sub&gt;4&lt;/sub&gt;Mg&lt;sub&gt;2&lt;/sub&gt;)(Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;)(BO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bosiite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Bosiite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Ertl A, Baksheev I A, Giester G, Lengauer C L, Prokofiev V Y, Zorina L D (2016) Bosiite, NaFe^3+^_3_(Al_4_Mg_2_)(Si_6_O_18_)(BO_3_)_3_(OH)_3_O, a new ferric member of the tourmaline supergroup from the Darasun gold deposit, Transbaikalia, Russia. European Journal of Mineralogy 28, 581-591</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Tourmaline</gsmin:structuralgroup>
  </rdf:Description>
