  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Seamount_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Reading 1978</dct:source>
    <rdfs:comment xml:lang="en">Setting that consists of a conical mountain on the ocean floor (guyot). Typically characterized by active volcanism, pelagic sedimentation. If the mountain is high enough to reach the photic zone, carbonate production may result in reef building to produce a carbonate platform or atoll setting.</rdfs:comment>
    <rdfs:label xml:lang="en">seamount setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Intraplate_Tectonic_Setting"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Ocean_Highland_Setting"/>
  </rdf:Description>
