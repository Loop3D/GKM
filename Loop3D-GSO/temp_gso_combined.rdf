  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/smectitegroup">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Smectite a group name for platy phyllosilicates of 2:1 layer and a layer charge of ~ -0.2 to -0.6 per formula unit. Generally for natural samples, the d(001) spacing is approximately 14.4-15.6 Å, although other spacing may occur depending on H2O retention and interlayer occupancy. The group is further divided into subgroups that are either trioctahedral (according to Bailey, 1980, this subgroup name is saponite) or dioctahedral (subgroup name of montmorillonite, according to Bailey, 1980), and these subgroups are further divided into mineral species.  Prior to circa 1975, the smectite group was called the montmorillonite-saponite group</rdfs:comment>
    <rdfs:label xml:lang="en">Smectite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/mineral/claymineral"/>
    <gsmin:mindatid>min-11119</gsmin:mindatid>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Monzonitic_Rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Syenitoid with a plagioclase to total feldspar ratio between 0.35 and 0.65. Includes rocks in QAPF fields 8, 8*, and 8'.</rdfs:comment>
    <rdfs:label xml:lang="en">monzonitic rock</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Syenitoid"/>
  </rdf:Description>
