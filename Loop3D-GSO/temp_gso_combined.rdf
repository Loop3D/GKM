    <gsmin:rruffnameplain xml:lang="en">Carlgieseckeite-(Nd)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pekov I V, Zubkova N V, Husdal T A, Kononkova N N, Agakhanov A A, Zadov A E, Pushcharovsky D Y (2012) Carlgieseckeite-(Nd), NaNdCa&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;F, a new belovite-group mineral species from the Ilímaussaq alkaline complex, South Greenland, The Canadian Mineralogist 50, 571-580</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Apatite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BH.55</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH,etc.):RO4 = 1:1</gsmin:strunzlabel>
    <gsmin:wikipediadate>2010-036</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/armangite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
