    <gsmin:chemistryelements>Cu | As | S | Ag</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">[Cu&lt;sub&gt;6&lt;/sub&gt;As&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;7&lt;/sub&gt;][Ag&lt;sub&gt;9&lt;/sub&gt;CuS&lt;sub&gt;4&lt;/sub&gt;]</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2007-046</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-35576</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:35576:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-35576.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">[Cu&lt;sub&gt;6&lt;/sub&gt;As&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;7&lt;/sub&gt;][Ag&lt;sub&gt;9&lt;/sub&gt;CuS&lt;sub&gt;4&lt;/sub&gt;]</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cupropearceite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cupropearceite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Bindi L, Evain M, Spry P G, Tait K T, Menchetti S (2007) Structural role of copper in the minerals of the pearceite-polybasite group: the case of the new minerals cupropearcite and cupropolybasite, Mineralogical Magazine 71, 641-650</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Polybasite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.GB.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Neso-sulfarsenite with additional S</gsmin:strunzlabel>
