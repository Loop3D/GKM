    <gsmin:rruffnameplain xml:lang="en">Koritnigite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Keller P, Hess H, Süsse P, Schnorrer G, Dunn P J (1979) Koritnigit, Zn[H_2_O|HOAsO_3_], ein neues mineral aus Tsumeb, Südwestafrika, Tschermaks Mineralogische und Petrographische Mitteilungen 26, 51-58</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Koritnigite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CB.20</gsmin:strunzcodeV10>
