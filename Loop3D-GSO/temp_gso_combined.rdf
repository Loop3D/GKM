    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Selenostephanite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Selenostephanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Botova M M, Sandomirskaya S M, Tschuvikina N G (1985) Selenostephanite Ag5Sb(Se,S)4—a new mineral, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 114, issue 5, 627-630</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.GB.10</gsmin:strunzcodeV10>
