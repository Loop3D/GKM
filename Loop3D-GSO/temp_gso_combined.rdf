    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:27406:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-27406.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,Ca)&lt;sub&gt;13&lt;/sub&gt;Sr&lt;sub&gt;11&lt;/sub&gt;(Zr&lt;sup&gt;4+&lt;/sup&gt;,Y,Nb&lt;sup&gt;5+&lt;/sup&gt;)&lt;sub&gt;14&lt;/sub&gt;Si&lt;sub&gt;42&lt;/sub&gt;B&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;132&lt;/sub&gt;(OH)&lt;sub&gt;12&lt;/sub&gt;·12H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070414</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bobtraillite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Bobtraillite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">McDonald A M, Chao G Y (2005) Bobtraillite, (Na,Ca)&lt;sub&gt;13&lt;/sub&gt;Sr&lt;sub&gt;11&lt;/sub&gt;(Zr,Y,Nb)&lt;sub&gt;14&lt;/sub&gt;Si&lt;sub&gt;42&lt;/sub&gt;B&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;132&lt;/sub&gt;(OH)&lt;sub&gt;12&lt;/sub&gt;·12H&lt;sub&gt;2&lt;/sub&gt;O, a new mineral species from Mont Saint-Hilaire, Quebec: description, structure determination and relationship to benitoite and wadeite, The Canadian Mineralogist 43, 747-758</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.CA.30</gsmin:strunzcodeV10>
