    <gsmin:rruffids>R040002 | R050065 | R050120 | R050121 | R050305 | R050347 | R050368 | R060942 | R060943 | R060944 | RS521166 | RS544095 | RS540155 | R110100 | R110113 | R110115 | R110118</gsmin:rruffids>
