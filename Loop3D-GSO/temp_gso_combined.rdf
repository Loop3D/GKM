  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/matioliite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Matioliite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Mg | Al | P | O | H</gsmin:chemistryelements>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaMgAl&lt;sub&gt;5&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2005-011</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Sodium magnesium pentaaluminium tetraphosphate hexahydroxyl dihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-27412</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:27412:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-27412.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaMgAl&lt;sub&gt;5&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Matioliite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Matioliite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Coutinho J M V, Mascarenhas Y P,Atencio D, Ellena J A (2006) Matioliite the Mg-analog of burangaite from Gentil mine, Mendes Pimentel, Minas Gerais Brazil and other occurrences: American Mineralogist 91, 1932-1936.</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Dufrénite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DK.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 &gt; 1:1 and &lt; 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Matioliite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2005-011</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Rhyolite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">rhyolitoid in which the ratio of plagioclase to total feldspar is between 0.1 and 0.65.</rdfs:comment>
    <rdfs:label xml:lang="en">rhyolite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Rhyolitoid"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Doleritic_Rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al 2005; LeMaitre et al. 2002; Gillespie and Styles 1999</dct:source>
    <rdfs:comment xml:lang="en">Dark colored gabbroic (basaltic) or dioritic (andesitic) rock intermediate in grain size between basalt and gabbro and composed of plagioclase, pyroxene and opaque minerals; often with ophitic texture. Typically occurs as hypabyssal intrusions. Includes dolerite, microdiorite, diabase and microgabbro.</rdfs:comment>
    <rdfs:label xml:lang="en">doleritic rock</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Igneous_Rock"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb26e920196f4af8bbd263b193e6f242b68">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/common/Time_Instant_Location"/>
    <gsoc:hasStaticValue rdf:nodeID="ndb26e920196f4af8bbd263b193e6f242b69"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Continental_Crust_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al., 2005</dct:source>
    <rdfs:comment xml:lang="en">That type of the Earth's crust which underlies the continents and the continental shelves, it is equivalent to the sial and continental sima and ranges in thickness from about 25 km to more than 70 km under mountain ranges, averaging ~40 km. The density of the continental crust averages ~2.8 g/cm3 and is ~2.7 g.cm3 in the upper layer. The velocities of compressional seismic waves through it average ~6.5 km/s and are less than ~7.0 km/sec.</rdfs:comment>
    <rdfs:label xml:lang="en">continental crustal setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Crustal_Setting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologictime/GivetianAge">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologictime/Age"/>
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Generic_Geologic_Time_Unit"/>
    <gsoc:timeStarts rdf:resource="https://w3id.org/gso/1.0/geologictime/BaseGivetian"/>
    <rdfs:comment xml:lang="en">Interval for grouping all specific instances of the Givetian Age</rdfs:comment>
    <rdfs:label xml:lang="en">Givetian Age</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologictime/CambrianSeries2Epoch">
