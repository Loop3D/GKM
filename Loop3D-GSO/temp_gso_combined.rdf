    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:39554:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-39554.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">LiNa&lt;sub&gt;3&lt;/sub&gt;(Y,Na,Ca)&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)(F,OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Peatite-(Y)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Peatite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">McDonald A M, Back M E, Gault R A, Horváth L (2013) Peatite-(Y) and ramikite-(Y), two new Na-Li-Y±Zr phosphate-carbonate minerals from the Poudrette pegmatite, Mont Saint-Hilaire, Quebec. The Canadian Mineralogist 51, 569-596</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">phosphate, arsenate, or vanadate</gsmin:strunzlabel>
    <gsmin:wikipediadate>2009-020</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/rhodochrosite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
