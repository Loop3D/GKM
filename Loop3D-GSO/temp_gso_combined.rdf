  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/cyanochroite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cyanochroite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Cu | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">picromerite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/cyanochroite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;Cu(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dipotassium copper disulfate hexahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1200</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1200:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1200.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R061035</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cyanochroite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cyanochroite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named cianocroma: Guarini G, Palmieri L, Scacchi A (1855) Chapter 5. Esame mineralogico-chimico delle produzioni dell'incendio, in Memoria sullo Incendio Vesuviano, Gaetano Nobile (Napoli) 165-200 Name modified: Dana J D, Brush G J (1868) 670. Cyanochroite, in A System of Mineralogy, Fifth Edition, John Wiley and Sons (New York) 649-649</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Picromerite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.CC.60</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, with H2O, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Cyanochroite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1855</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/alleghanyite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
