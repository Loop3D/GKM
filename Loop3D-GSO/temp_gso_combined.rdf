    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfault/Fault"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/whiteite-mnmnmg">
