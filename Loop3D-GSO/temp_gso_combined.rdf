  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ferrisepiolite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ferrisepiolite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Fe | Mg | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Fe&lt;sup&gt;3+&lt;/sup&gt;,Fe&lt;sup&gt;2+&lt;/sup&gt;,Mg)&lt;sub&gt;4&lt;/sub&gt;[(Si,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;15&lt;/sub&gt;](O,OH)&lt;sub&gt;2&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2010-061</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-41139</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:41139:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-41139.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Fe&lt;sup&gt;3+&lt;/sup&gt;,Fe&lt;sup&gt;2+&lt;/sup&gt;,Mg)&lt;sub&gt;4&lt;/sub&gt;[(Si,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;15&lt;/sub&gt;](O,OH)&lt;sub&gt;2&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ferrisepiolite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ferrisepiolite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Previously described with the name gunnbjarnite: Bøggild O B (1951) Gunnbjarnite, a new mineral from East Greenland. Meddelelser om Grønland 142, 3-11 Gu X, Xie X, Wu X, Zhu G, Lai J, Kenich H, Huang J (2013) Ferrisepiolite: a new mineral from Saishitang copper skarn deposit in Xinghai County, Qinghai Province, China. European Journal of Mineralogy 25, 177-186</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Sepiolite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EE.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate: Single tetrahedral nets of 6-membered rings connected by octahedral nets or octahedral bands</gsmin:strunzlabel>
    <gsmin:wikipediadate>2010-061</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/shuiskite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Shuiskite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Mg | Cr | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">pumpellyite</gsmin:fleischersgroup>
