    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:27489:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-27489.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;46&lt;/sub&gt;Ca&lt;sub&gt;10&lt;/sub&gt;(Si&lt;sub&gt;42&lt;/sub&gt;Al&lt;sub&gt;42&lt;/sub&gt;O&lt;sub&gt;168&lt;/sub&gt;)(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;12&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Farneseite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Farneseite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Cámara F, Bellatreccia F, Della Ventura G, Mottana A (2005) Farneseite, a new mineral of the cancrinite - sodalite group with a 14-layer stacking sequence: occurence and crystal structure, European Journal of Mineralogy 17, 839-846</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Cancrinite-sodalite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.FB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Tektosilicate with additional anions</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Farneseite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2004-043</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/heulandite-sr">
