    <gsmin:statusnotes xml:lang="en">Hålenius U, Bosi F (2015) Gatedalite, Zr(Mn^2+^_2_Mn^3+^_4_)SiO_12_, a new mineral species of the braunite group from Långban, Sweden. Mineralogical Magazine 79, 625-634</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Braunite</gsmin:structuralgroup>
  </rdf:Description>
