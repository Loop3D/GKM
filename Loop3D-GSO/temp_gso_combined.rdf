  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfault/Thrust_Fault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI faulttype SKOS vocabulary 2016-10-19</dct:source>
    <rdfs:comment xml:lang="en">Fault that dips less than 45 degrees over more than half of the recognized extent of the fault, with a hanging wall displaced from a structurally deeper position relative to footwall rocks.</rdfs:comment>
    <rdfs:label xml:lang="en">thrust fault</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfault/Low_Angle_Fault"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfault/Reverse_Fault"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/glaucocerinite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Glaucocerinite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Zn | Al | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">woodwardite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/glaucocerinite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Zn&lt;sub&gt;1-x&lt;/sub&gt;Al&lt;sub&gt;x&lt;/sub&gt;)(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;x/2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O (x &lt; 0.5, n &gt; 3x/2)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1707</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1707:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1707.html</gsmin:mindaturl>
