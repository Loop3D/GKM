  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kainite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kainite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Mg | S | O | Cl | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/kainite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KMg(SO&lt;sub&gt;4&lt;/sub&gt;)Cl·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Potassium magnesium sulfate chloride trihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2132</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2132:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2132.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KMg(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)Cl·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070152 | R100021</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kainite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kainite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Zincken C (1865) Ueber ein neues salz von Leopoldshall bei Stassfurth, Berg- und Huttenmannische Zeitung 24, 79-80</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.DF.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With large and medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Kainite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1865</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/berborite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Berborite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Be | B | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/berborite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Be&lt;sub&gt;2&lt;/sub&gt;(BO&lt;sub&gt;3&lt;/sub&gt;)(OH)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1967-004</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Diberyllium borate hydroxyl monohydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-629</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:629:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-629.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Be&lt;sub&gt;2&lt;/sub&gt;BO&lt;sub&gt;3&lt;/sub&gt;(OH)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Berborite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Berborite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Nefedov E I (1967) Berborite, a new mineral, Doklady Akademii Nauk SSSR 174, 189-192</gsmin:statusnotes>
    <gsmin:strunzcodeV10>06.AB.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Monoborate, BO3, with additional anions; 1(D) + OH, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Berborite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1967-004</gsmin:wikipediadate>
  </rdf:Description>
