  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/symesite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Symesite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | S | O | Cl | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/symesite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;10&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)O&lt;sub&gt;7&lt;/sub&gt;Cl&lt;sub&gt;4&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1998-035</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Decalead sulfate heptaoxy tetrachloride monohydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-11033</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:11033:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-11033.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;10&lt;/sub&gt;SO&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;Cl&lt;sub&gt;4&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Symesite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Symesite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Welch M D, Cooper M A, Hawthorne F C, Criddle A J (2000) Symesite, Pb10(SO4)O7Cl4(H2O), a new PbO-related sheet mineral: description and crystal structure, American Mineralogist 85, 1526-1533</gsmin:statusnotes>
    <gsmin:strunzcodeV10>03.DC.60</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Double-, Oxy- or Hydroxy-  halide with Pb (As,Sb,Bi), without Cu</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Symesite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1998-035</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Barrier_Beach_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al., 2005</dct:source>
    <rdfs:comment xml:lang="en">A narrow, elongate sand or gravel ridge rising slightly above the high-tide level and extending generally parallel with the shore, but separated from it by a lagoon (Shepard, 1954, p.1904), estuary, or marsh, it is extended by longshore transport and is rarely more than several kilometers long.</rdfs:comment>
    <rdfs:label xml:lang="en">barrier beach setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Barrier_Island_Coastline_Setting"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Beach_Setting"/>
    <rdfs:subClassOf rdf:nodeID="nb91377c629b1476ba973ba249cd56575b4"/>
  </rdf:Description>
