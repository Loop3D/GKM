    <gsmin:rruffnameplain xml:lang="en">Wakefieldite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hogarth D D, Miles N (1969) Wakefieldite, natural YVO&lt;sub&gt;4&lt;/sub&gt;, The Canadian Mineralogist 10, 136-137 Name changed from wakefieldite: Nickel E H, Mandarino J A (1987) Procedures involving the IMA Commission on New Minerals and Mineral Names and guidelines on mineral nomenclature, American Mineralogist 72, 1031-1042</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Zircon</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.AD.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, without H2O, With only large cations</gsmin:strunzlabel>
