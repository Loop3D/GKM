    <gsmin:fleischersgroup xml:lang="en">cylindrite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/cylindrite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">FePb&lt;sub&gt;3&lt;/sub&gt;Sn&lt;sub&gt;4&lt;/sub&gt;Sb&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;14&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Iron tripalladium tetratin diantimonide tetrasulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-1204</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1204:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1204.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">FePb&lt;sub&gt;3&lt;/sub&gt;Sn&lt;sub&gt;4&lt;/sub&gt;Sb&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;14&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050175 | R050329</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cylindrite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cylindrite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Frenzel A (1893) Ueber den kylindrit, Neues Jahrbuch für Mineralogie, Geologie und Palaontologie 2, 125-128</gsmin:statusnotes>
