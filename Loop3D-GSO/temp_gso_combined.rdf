    <gsmin:statusnotes xml:lang="en">Jambor J L, Dutrizac J E, Roberts A C, Grice J D, Szymanski J T (1996) Clinoatacamite, a new polymorph of Cu&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;Cl, and its relationship to paratacamite and "anarkite", The Canadian Mineralogist 34, 61-72</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Atacamite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>03.DA.10b</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Double-, Oxy- or Hydroxy- halide with Cu, etc., without Pb</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Clinoatacamite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1993-060</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/llantenesite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Llantenesite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Al | Se | O | H | Cl</gsmin:chemistryelements>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;6&lt;/sub&gt;Al[SeO&lt;sub&gt;4&lt;/sub&gt;](OH)&lt;sub&gt;12&lt;/sub&gt;Cl·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
