  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Limestone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">This vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Pure carbonate sedimentary rock with a calcite (plus aragonite) to dolomite ratio greater than 1 to 1. Includes limestone and dolomitic limestone.</rdfs:comment>
    <rdfs:label xml:lang="en">limestone</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Calcareous_Carbonate_Sedimentary_Rock"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Pure_Carbonate_Sedimentary_Rock"/>
  </rdf:Description>
