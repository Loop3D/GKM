  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/roumaite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Roumaite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Nb | Ti | Ca | Na | REE | Si | O | H | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Nb,Ti)(Ca,Na,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)&lt;sub&gt;3&lt;/sub&gt;(Ca,REE)&lt;sub&gt;4&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)F&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2008-024</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-38702</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:38702:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-38702.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Na,Ce&lt;sup&gt;3+&lt;/sup&gt;,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)&lt;sub&gt;7&lt;/sub&gt;(Nb&lt;sup&gt;5+&lt;/sup&gt;,Ti&lt;sup&gt;4+&lt;/sup&gt;)(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)F&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Roumaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Roumaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Biagioni C, Bonaccorsi E, Merlino S, Parodi G C, Perchiazzi N, Chevrier V, Bersani D (2010) Roumaite, (Ca,Na,[box])&lt;sub&gt;3&lt;/sub&gt;(Ca,REE,Na)&lt;sub&gt;4&lt;/sub&gt;(Nb,Ti)[Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;]&lt;sub&gt;2&lt;/sub&gt;(OH)F&lt;sub&gt;3&lt;/sub&gt;, from Rouma Island, Los Archipelago, Guinea: A new mineral species related to dovyrenite, The Canadian Mineralogist 48, 17-28</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">silicate</gsmin:strunzlabel>
    <gsmin:wikipediadate>2008-024</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/hydroxykenopyrochlore">
