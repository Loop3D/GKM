    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2688:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2688.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Metaswitzerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Metaswitzerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named switzerite: Leavens P B, White J S (1967) Switzerite, (Mn,Fe)_3_(PO_4_)_2_·4H_2_O, a new mineral, American Mineralogist 52, 1595-1602 Redefined: White J S, Leavens P B, Zanazzi P F (1986) Switzerite redefined as Mn_3_(PO_4_)_2_·7H_2_O, and metaswitzerite, Mn_3_(PO_4_)_2_·4H_2_O, American Mineralogist 71, 1221-1223</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.CE.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With only medium-sized cations, RO4:H2O about 1:2.5</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Metaswitzerite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1967</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/bobtraillite">
