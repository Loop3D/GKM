    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">lovozerite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/zirsinalite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;6&lt;/sub&gt;CaZrSi&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1973-025</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4427</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4427:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4427.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;6&lt;/sub&gt;CaZr&lt;sup&gt;4+&lt;/sup&gt;Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zirsinalite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Zirsinalite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kapustin Y L, Pudovkina Z V, Bykova A V (1974) Zirsinalite, a new mineral, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 103(5), 551-558</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Lovozerite-Zirsinalite–Lovozerite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CJ.15a</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si6O18]12- 6-membered single rings (sechser-Einfachringe), without insular complex anions</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Zirsinalite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1973-025</gsmin:wikipediadate>
  </rdf:Description>
