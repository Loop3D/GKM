    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KHMg&lt;sub&gt;2&lt;/sub&gt;B&lt;sub&gt;12&lt;/sub&gt;O&lt;sub&gt;16&lt;/sub&gt;(OH)&lt;sub&gt;10&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060352</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kaliborite</gsmin:rruffnamehtml>
