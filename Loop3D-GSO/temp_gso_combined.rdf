    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Ag | Sb | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic, hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">polybasite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/polybasite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">[Ag&lt;sub&gt;9&lt;/sub&gt;CuS&lt;sub&gt;4&lt;/sub&gt;][(Ag,Cu)&lt;sub&gt;6&lt;/sub&gt;(Sb,As)&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;7&lt;/sub&gt;]</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Redefined|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3256</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3256:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3256.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu(Ag,Cu)&lt;sub&gt;6&lt;/sub&gt;Ag&lt;sub&gt;9&lt;/sub&gt;Sb&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;11&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R061052</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Polybasite</gsmin:rruffnamehtml>
