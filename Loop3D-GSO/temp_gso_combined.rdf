  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfoliation/disjunctive_cleavage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A spaced cleavage independent of any pre-existing mineral orientation, cleavage in which there is no systematic relationship between a pre-existing preferred orientation and the superimposed cleavage. (Borradaile et al., 1982)</rdfs:comment>
    <dct:source xml:lang="en">Borradaile et al. 1982</dct:source>
    <rdfs:label xml:lang="en">disjunctive cleavage</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfoliation/cleavage"/>
  </rdf:Description>
