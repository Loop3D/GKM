    <rdfs:label xml:lang="en">Hydromagnesite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mg | C | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">hydromagnesite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/hydromagnesite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;5&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Pentamagnesium tetracarbonate dihydroxyl tetrahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1979</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1979:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1979.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;5&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060011</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hydromagnesite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hydromagnesite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mineral described, but called magnesia alba: Wachtmeister T (1828) Analys af ett pulverformigt mineral från Norra Amerika. Kongliga Svenska Vetenskaps-Akademiens Handlingar 1828, 17-19 Mineral named: von Kobell F (1835) Ueber den hydromagnesit von Kumi auf Negroponte, Journal für Praktische Chemie 4, 80-81</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.DA.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions and H2O, With medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Hydromagnesite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1828</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/bezsmertnovite">
