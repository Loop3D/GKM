    <gsoc:timeStarts rdf:resource="https://w3id.org/gso/1.0/ischart/Jurassic2004"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/Feature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A feature is  ontologically dependent on at least two distinct things, a host and some essential part, and emerges from some relation holding between them. E.g.  hole is hosted by some material entity and has spatial regions as parts (with regions changing as the host moves in space), and emerges from a spatial relation (adjacent containment) between them. A feature is made of parts of the same type, either endurants, perdurants, or possibly situations, so each feature is then itself also a perdurant, endurant or situation, e.g. a hole is also a spatial region.</rdfs:comment>
    <rdfs:label xml:lang="en">Feature</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Particular"/>
    <rdfs:subClassOf rdf:nodeID="n7bda25761fc44f8595ef751309700190b62"/>
    <rdfs:subClassOf rdf:nodeID="n7bda25761fc44f8595ef751309700190b63"/>
    <rdfs:subClassOf rdf:nodeID="n7bda25761fc44f8595ef751309700190b64"/>
    <rdfs:subClassOf rdf:nodeID="n7bda25761fc44f8595ef751309700190b65"/>
    <rdfs:subClassOf rdf:nodeID="n7bda25761fc44f8595ef751309700190b66"/>
    <rdfs:subClassOf rdf:nodeID="n7bda25761fc44f8595ef751309700190b67"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/dyscrasite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Dyscrasite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ag | Sb</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/dyscrasite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ag&lt;sub&gt;3+x&lt;/sub&gt;Sb&lt;sub&gt;1-x&lt;/sub&gt; (x ˜ 0.2)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1342</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1342:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1342.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ag&lt;sub&gt;3.2&lt;/sub&gt;Sb&lt;sub&gt;0.8&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R061043</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Dyscrasite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Dyscrasite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Beudant F S (1832) Deuxième genre. Antimoniure. Espèce unique. Discrase, in Traité Élémentaire de Minéralogie, 2nd Edition, (Paris) 613-614</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Allargentum</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.AA.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">sulfide or sulfosalt alloy of metalloids with Cu, Ag, Au</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Dyscrasite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1832</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/zhemchuzhnikovite">
