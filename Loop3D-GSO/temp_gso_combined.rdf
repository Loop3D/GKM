  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/fluorapatite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Fluorapatite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/mineral/apatite"/>
