  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/calciomurmanite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Calciomurmanite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Ti | Mg | Nb | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)&lt;sub&gt;2&lt;/sub&gt;Ca(Ti,Mg,Nb)&lt;sub&gt;4&lt;/sub&gt;[Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;]&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(OH,O)&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2014-103</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Redefined|Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)&lt;sub&gt;2&lt;/sub&gt;Ca(Ti&lt;sup&gt;4+&lt;/sup&gt;,Mg,Nb&lt;sup&gt;5+&lt;/sup&gt;)&lt;sub&gt;4&lt;/sub&gt;[Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;]&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(OH,O)&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Calciomurmanite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Calciomurmanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Lykova I S, Pekov I V, Chukanov N V, Belakovskiy D I, Yapaskurt V O, Zubkova N V, Britvin S N, Giester G (2016) Calciomurmanite, (Na,[box])_2_Ca(Ti,Mg,Nb)_4_[Si_2_O_7_]_2_O_2_(OH,O)_2_(H_2_O)_4_, a new mineral from the Lovozero and Khibiny alkaline complexes, Kola Peninsula, Russia. European Journal of Mineralogy 28, 835-845</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Seidozerite-Murmanite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/behierite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Béhierite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ta | B | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/behierite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ta(BO&lt;sub&gt;4&lt;/sub&gt;)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Tantalum borate</gsmin:iupacchemname>
    <gsmin:mindatid>min-602</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:602:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-602.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">TaBO&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060657</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Béhierite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Behierite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mrose M E, Rose H J (1961) Behierite, (Ta,Nb)BO&lt;sub&gt;4&lt;/sub&gt;, a new mineral from Manjaka, Madagascar, Geological Society of America, Abstracts Annual Meetings 1961, 111A-111A Spelling of name changed from behierite to béhierite: Hålenius U, Hatert F, Pasero M, Mills S J (2015) IMA Commission on New Minerals, Nomenclature and Classification (CNMNC) Newsletter 28. New minerals and nomenclature modifications approved in 2015. Mineralogical Magazine 79, 1859-1864</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Zircon</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>06.AC.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Monoborate, B(O,OH)4, without and with additional anions; 1(T), 1(T)+OH, etc</gsmin:strunzlabel>
