    <gsmin:rruffnameplain xml:lang="en">Chukhrovite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Ermilova L P, Moleva V A, Klevtsova R F (1960) Chukhrovite, a new mineral from Central Kazakhstan, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 89(1), 15-25 Name changed from chukhrovite: Nickel E H, Mandarino J A (1987) Procedures involving the IMA Commission on New Minerals and Mineral Names and guidelines on mineral nomenclature, American Mineralogist 72, 1031-1042</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Chukhrovite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>03.CG.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Aluminofluoride with CO3, SO4, or PO4</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Chukhrovite-%28Y%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1960</gsmin:wikipediadate>
  </rdf:Description>
