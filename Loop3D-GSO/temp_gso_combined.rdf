    <gsmin:chemistryelements>Cu | Fe | Zn | Bi | S</gsmin:chemistryelements>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;6&lt;/sub&gt;[Cu&lt;sub&gt;4&lt;/sub&gt;(Fe,Zn)&lt;sub&gt;2&lt;/sub&gt;](Bi,Sb,As)&lt;sub&gt;4&lt;/sub&gt;S&lt;sub&gt;13&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Questionable mineral species|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-26713</gsmin:mindatid>
    <gsmin:mindaturl>https://www.mindat.org/min-26713.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;1+&lt;/sup&gt;&lt;sub&gt;10&lt;/sub&gt;(Fe&lt;sup&gt;2+&lt;/sup&gt;,Zn&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;Bi&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;13&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Annivite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Annivite</gsmin:rruffnameplain>
