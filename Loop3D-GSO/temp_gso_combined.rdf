    <gsmin:chemistryelements>Na | Al | Mg | Si | O | H</gsmin:chemistryelements>
    <gsmin:fleischersgroup xml:lang="en">smectite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/tosudite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;0.5&lt;/sub&gt;(Al,Mg)&lt;sub&gt;6&lt;/sub&gt;(Si,Al)&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;(OH)&lt;sub&gt;12&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4001</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4001:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4001.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;0.5&lt;/sub&gt;(Al,Mg)&lt;sub&gt;6&lt;/sub&gt;(Si,Al)&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;(OH)&lt;sub&gt;12&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tosudite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tosudite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Frank-Kamenetskii V A, Logvinenko N V, Drits V A (1963) A dioctahedral mixed-layer clay mineral - tosudite, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 92, 560-565</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Clay</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EC.60</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with mica sheets, composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Tosudite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1963</gsmin:wikipediadate>
  </rdf:Description>
