  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/cuprotungstite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cuprotungstite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | W | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/cuprotungstite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(WO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: TricopperII ditungstate dihydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-1194</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1194:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1194.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(WO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cuprotungstite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cuprotungstite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Adam G J (1869) VIII Famille Wolframides 275 Cuprotungstite, in Tableau Minéralogique, Libraire des Corps Impériaux des Ponts et Chaussées es des Mines (Paris) 32-32 Chemical formula redefined: Schaller W T (1932) Chemical composition of cuprotungstite, American Mineralogist 17, 234-237 Chemical formula redefined again: Duggan M B (1988) Cuprotungstite from the Cordillera mine, Crookwell, New South Wales, Australian Mineralogist 3, 61-64</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.GB.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Molybdate, Wolframate or Niobate, With additional anions and/or H2O</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Cuprotungstite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1932</gsmin:wikipediadate>
  </rdf:Description>
