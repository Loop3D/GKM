    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:39666:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-39666.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(N&lt;sup&gt;3-&lt;/sup&gt;H&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;Mg&lt;sub&gt;5&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Al(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;12&lt;/sub&gt;·18H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R130079</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ammoniomagnesiovoltaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ammoniomagnesiovoltaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Szakáll S, Sajó I, Fehér B, Bigi S, (2012) Ammoniomagnesiovoltaite, a new voltaite-related mineral species from Pécs-Vasas, Hungary, The Canadian Mineralogist 50, 65-72</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Voltaite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.CC.25</gsmin:strunzcodeV10>
