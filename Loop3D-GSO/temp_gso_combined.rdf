    <gsmin:rruffnameplain xml:lang="en">Barikaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Topa D, Makovicky E, Tajedin H, Putz H, Zagler G (2013) Barikaite, Pb_10_Ag_3_(Sb_8_As_11_)_S19_S_40_, a new member of the sartorite homologous series. Mineralogical Magazine 77, 3039-3046</gsmin:statusnotes>
