    <gsmin:wikipediadate>1980-097</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfoliation/slaty_cleavage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Continuous cleavage defined by aligned fine to very-fine grained phylosilicate mineral grains. The individual grains defining the fabric are too small to be seen by the unaided eye. Grades into phyllitic cleavage as grain size increases. Cleavage domains typically less than 100 micrometres wide, rock easily splits into slabs and thin plates.</rdfs:comment>
    <dct:source xml:lang="en">Brodie, Kate, Fettes, Douglas, and Harte, Ben, 2007, Structural terms including fault rock terms, in Fettes, D., and Desmons, J., Metamorphic rocks-A classification and Glossary of Terms: Cambridge, UK, Cambridge University Press, p. 24-31., Jackson 1997</dct:source>
    <rdfs:label xml:lang="en">slaty cleavage</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfoliation/continuous_cleavage"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/isc2013-01">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Scale"/>
    <rdfs:comment xml:lang="en">RDF/OWL representation of the 2013-01 edition of the International Chronostratigraphic Chart from the International Commission on Stratigraphy. Encoded using OWL implementation from GSO. Adapted from Cox&amp;Richard OWL GeologicTime ontology</rdfs:comment>
    <rdfs:comment xml:lang="en">dc:source  Cohen, K.M., Finney, S.C., Gibbard, P.L. &amp; Fan, J.-X. (2013; updated) The ICS  International  Chronostratigraphic Chart. Episodes 36: 199-204. </rdfs:comment>
    <rdfs:comment xml:lang="en">dc:source  International  Chronostratigraphic Chart 2013</rdfs:comment>
    <rdfs:label xml:lang="en">International Chronostratigraphic Chart (2013)</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologiccontact/Disconformable_Contact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf, K.K.E, Mehl, J.P. &amp; Jackson, J.A. (eds), 2005. Glossary of geology, 5th Edition. American Geological Institute, Alexandria, 779 p.</dct:source>
    <rdfs:comment xml:lang="en">An unconformable contact between two geological units in which the bedding of the older, underlying unit is parallel to the bedding of the younger, overlying unit, but in which the contact between the two units is marked by an irregular or uneven surface of appreciable relief.</rdfs:comment>
    <rdfs:label xml:lang="en">disconformable contact</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologiccontact/Unconformable_Contact"/>
  </rdf:Description>
