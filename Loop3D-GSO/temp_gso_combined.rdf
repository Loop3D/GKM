  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/Dynamic_Feature">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A feature for which the host participates in some perdurant (wave) i.e. some aspect of the host changes over time</rdfs:comment>
    <rdfs:label xml:lang="en">Dynamic Feature</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Endurant_Feature"/>
