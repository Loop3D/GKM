    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">crichtonite</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ce(Y,U)Fe&lt;sub&gt;2&lt;/sub&gt;(Ti,Fe,Cr,V)&lt;sub&gt;18&lt;/sub&gt;(O,OH,F)&lt;sub&gt;38&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
