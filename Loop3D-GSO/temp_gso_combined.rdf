    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:39882:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-39882.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KCaNaAl&lt;sub&gt;4&lt;/sub&gt;B&lt;sub&gt;4&lt;/sub&gt;Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;</gsmin:rruffchemistry>
