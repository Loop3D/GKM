    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:211:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-211.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R050510 | R141081</gsmin:rruffids>
