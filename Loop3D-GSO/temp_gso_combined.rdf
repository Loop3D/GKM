    <gsmin:mindaturl>http://www.mindat.org/min-26414.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Co&lt;sup&gt;2+&lt;/sup&gt;S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cobaltkieserite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cobaltkieserite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Holtstam D (2002) Cobaltkieserite, CoSO&lt;sub&gt;4&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O, a new mineral species from Bastnäs, Skinnskatteberg, Sweden, Geologiska Föreningens i Stockholm Förhandlingar 124, 117-119</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Kieserite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.CB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, with H2O, With only medium-sized cations</gsmin:strunzlabel>
