    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2706:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2706.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;4&lt;/sub&gt;K&lt;sub&gt;2&lt;/sub&gt;Ca&lt;sub&gt;2&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)(Si&lt;sub&gt;6&lt;/sub&gt;Al&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;)Cl&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R100090</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Microsommite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Microsommite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Scacchi A (1872) Notizie preliminari di alcune specie mineralogiche rinvenute nel Vesuvio dopo l'incendio di aprile 1872, Rendiconto dell'Accademia delle Scienze Fisiche e Matematiche (sezione della Societa reale di Napoli) 11, 210-213</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Cancrinite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.FB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Tektosilicate with additional anions</gsmin:strunzlabel>
