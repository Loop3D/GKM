    <gsmin:mindaturl>http://www.mindat.org/min-7278.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Na)&lt;sub&gt;2&lt;/sub&gt;(Fe&lt;sup&gt;2+&lt;/sup&gt;,Mn&lt;sup&gt;2+&lt;/sup&gt;)(Sc&lt;sup&gt;3+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;)Si&lt;sub&gt;5&lt;/sub&gt;O&lt;sub&gt;14&lt;/sub&gt;(OH)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Scandiobabingtonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Scandiobabingtonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Orlandi P, Pasero M, Vezzalini G (1998) Scandiobabingtonite, a new mineral from the Baveno pegmatite, Piedmont, Italy, American Mineralogist 83, 1330-1334</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Rhodonite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DK.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 5-periodic single chains</gsmin:strunzlabel>
