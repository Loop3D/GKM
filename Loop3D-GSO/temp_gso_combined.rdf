  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/chlormayenite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Chlormayenite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Al | O | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;12&lt;/sub&gt;Al&lt;sub&gt;14&lt;/sub&gt;O&lt;sub&gt;32&lt;/sub&gt;[&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;&lt;sub&gt;4&lt;/sub&gt;Cl&lt;sub&gt;2&lt;/sub&gt;]</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1963-016</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;12&lt;/sub&gt;Al&lt;sub&gt;14&lt;/sub&gt;O&lt;sub&gt;32&lt;/sub&gt;[&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;&lt;sub&gt;4&lt;/sub&gt;Cl&lt;sub&gt;2&lt;/sub&gt;]</gsmin:rruffchemistry>
    <gsmin:rruffids>R130063 | R140780</gsmin:rruffids>
