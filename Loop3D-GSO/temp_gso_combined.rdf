    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;(VO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dibarium ironIII divanadate hydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-1645</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1645:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1645.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;(V&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)</gsmin:rruffchemistry>
    <gsmin:rruffids>R130111</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Gamagarite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Gamagarite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">de Villiers J E (1943) Gamagarite, a new vanadium mineral from the Postmasburg manganese deposits, American Mineralogist 28, 329-335</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Brackebuschite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BG.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH, etc.):RO4 = 0.5:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Gamagarite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1943</gsmin:wikipediadate>
  </rdf:Description>
