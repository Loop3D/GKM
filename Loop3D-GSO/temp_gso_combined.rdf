    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Ba,Pb,K,Na)U&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1973-004</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-828</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:828:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-828.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Ba,Pb,K,Na)U&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070022</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Calciouranoite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Calciouranoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Rogova V P, Belova L N, Kiziyarov G N, Koznetsova N N (1974) Calciouranoite, a new hydroxide of uranium, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 103, 108-109</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Wölsendorfite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.GB.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl hydroxide, With additional cations (K, Ca, Ba, Pb, etc.); with mainly UO2(O,OH)5 pentagonal polyhedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Calciouranoite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1973-004</gsmin:wikipediadate>
  </rdf:Description>
