    <gsmin:imanumber xml:lang="en">IMA2004-040</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-27487</gsmin:mindatid>
