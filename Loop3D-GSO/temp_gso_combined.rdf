    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KNa&lt;sub&gt;8&lt;/sub&gt;Si&lt;sub&gt;9&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;(OH)&lt;sub&gt;9&lt;/sub&gt;·19H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Megacyclite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Megacyclite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Khomyakov A P, Necheljustov G N, Yamnova N A, Pushcharovsky D Y (1993) Megacyclite Na8KSi9O18(OH)9·19H2O — a new mineral, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 122, issue 1, 125-128 Jambor J L, Roberts A C, Vanko D A (1994) New mineral names, American Mineralogist 79, 1009-1014</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.CP.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: 12-membered and larger rings</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Megacyclite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1991-015</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/moncheite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Moncheite</rdfs:label>
