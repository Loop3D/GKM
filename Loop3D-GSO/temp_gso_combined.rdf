    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;7&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;[Mg(OH)&lt;sub&gt;4&lt;/sub&gt;](OH)Cl&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R130568</gsmin:rruffids>
