    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;((C&lt;sub&gt;2&lt;/sub&gt;)&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)(OH)&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fiemmeite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Fiemmeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Demartin F, Campostrini I, Ferretti P, Rocchetti I (2018) Fiemmeite Cu_2_(C_2_O_4_)(OH)_2_·2H_2_O, a new mineral from Val di Fiemme, Trentino, Italy. Minerals 8, 248</gsmin:statusnotes>
