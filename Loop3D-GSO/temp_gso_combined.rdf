    <gsmin:chemistryelements>Na | Cr | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">pyroxene</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/kosmochlor.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaCr&lt;sup&gt;3+&lt;/sup&gt;Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2258</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2258:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2258.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaCr&lt;sup&gt;3+&lt;/sup&gt;Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R120015</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kosmochlor</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kosmochlor</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Laspeyres H (1897) Die steinigen Gemengtheile in Meteoreisen von Toluca in Mexico. Kosmochlor, ein neues kosmisches Mineral. Zeitschrift für Krystallographie und Mineralogie 27, 586-600</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Pyroxene</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DA.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 2-periodic single chains, Si2O6; pyroxene family</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Kosmochlor.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1897</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Spreading">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf, K.K.E, Mehl, J.P. &amp; Jackson, J.A. (eds), 2005. Glossary of geology, 5th Edition. American Geological Institute, Alexandria, 779 p.</dct:source>
    <rdfs:comment xml:lang="en">A process whereby new oceanic crust is formed by upwelling of magma at the center of mid-ocean ridges and by a moving-away of the new material from the site of upwelling at rates of one to ten centimeters per year.</rdfs:comment>
    <rdfs:label xml:lang="en">spreading</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicprocess/Tectonic_Process"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Additive_Process"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Deformation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/chabazite-na">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Chabazite-Na</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | K | Al | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal, rhombohedral, triclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">zeolite-chabazite series</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na&lt;sub&gt;3&lt;/sub&gt;K)[Al&lt;sub&gt;4&lt;/sub&gt;Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;]·11H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-6856</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:6856:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-6856.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na&lt;sub&gt;3&lt;/sub&gt;K)Al&lt;sub&gt;4&lt;/sub&gt;Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;·11H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R061095 | R070440</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Chabazite-Na</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Chabazite-Na</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mineral described and called Na-chabazite: Passaglia E (1970) The crystal chemistry of chabazites. American Mineralogist 55, 1278-1301 Name changed to chabazite-Na: Coombs D S, Alberti A, Armbruster T, Artioli G, Colella C, Galli E, Grice J D, Liebau F, Mandarino J A, Minato H, Nickel E H, Passaglia E, Peacor D R, Quartieri S, Rinaldi R, Ross M, Sheppard R A, Tillmanns E, Vezzalini G, (1997) Recommended nomenclature for zeolite minerals: report of the subcommittee on zeolites of the international mineralogical association, commission on new minerals and mineral names, The Canadian Mineralogist 35, 1571-1606</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.GD.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Zeolite family: Chains of 6-membered rings – tabular zeolites</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Chabazite-Na.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1997</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/linarite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Linarite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Cu | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/linarite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CuPb(SO&lt;sub&gt;4&lt;/sub&gt;)(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Lead copper sulfate dihydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-2403</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2403:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2403.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060130 | R060472 | R120094</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Linarite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Linarite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Brooke H I (1822) On a new lead ore, The Annals of Philosophy 4, 117-119</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Linarite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.BC.65</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions, without H2O, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Linarite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1822</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/lecoqite-y">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
