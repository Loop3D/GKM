  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicunit/Deformation_Unit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">deformation unit</rdfs:label>
    <dct:source xml:lang="en">CGI geologicunittype SKOS vocabulary 2012-11-24</dct:source>
    <rdfs:comment xml:lang="en">Lithotectonic unit defined by deformation style or characteristic geologic structure observable in outcrop.</rdfs:comment>
