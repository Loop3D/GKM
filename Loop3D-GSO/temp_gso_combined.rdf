    <rdfs:comment xml:lang="en">Geological structures</rdfs:comment>
    <rdfs:label xml:lang="en">Geoscience Ontology, Geological Structure</rdfs:label>
    <dct:bibliographicCitation>Brodaric, B., and Richard, S.M., 2021, The GeoScience Ontology Reference, Geologic Structure: Geological Survey of Canada Open File 8796, 34 p., https://doi.org/10.4095/328296</dct:bibliographicCitation>
    <owl:imports rdf:resource="https://w3id.org/gso/1.0/common/ontology"/>
    <owl:imports rdf:resource="https://w3id.org/gso/1.0/geologicquality/ontology"/>
