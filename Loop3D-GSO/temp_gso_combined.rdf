    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Iridium diarsenite</gsmin:iupacchemname>
    <gsmin:mindatid>min-2044</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2044:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2044.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">IrAs&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
