  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Basin_Bog_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">1-GE WP3; Neuendorf et al.(2005), p. 451</dct:source>
    <rdfs:comment xml:lang="en">An ombrotrophic or ombrogene peat/bog whose nutrient supply is exclusively from rain water (including snow and atmospheric fallout) therefore making nutrients extremely oligotrophic</rdfs:comment>
    <rdfs:label xml:lang="en">basin bog setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Bog_Setting"/>
  </rdf:Description>
