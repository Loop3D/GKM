    <gsmin:mindaturl>http://www.mindat.org/min-27258.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Na,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)&lt;sub&gt;2&lt;/sub&gt;Mn&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;CO&lt;sub&gt;3&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sailaufite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Sailaufite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Wildner M, Tillmanns E, Andrut M, Lorenz J (2003) Sailaufite, (Ca,Na,_)&lt;sub&gt;2&lt;/sub&gt;Mn&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)·3H&lt;sub&gt;2&lt;/sub&gt;O, a new mineral from Hartkoppe hill, Ober-Sailauf (Spessart mountains, Germany), and its relationship to mitridatite-group minerals and pararobertsite, European Journal of Mineralogy 15, 555-564</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Arseniosiderite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DH.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 &lt; 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Sailaufite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2000-005</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/khomyakovite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Khomyakovite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Sr | Ca | Fe | Zr | W | Si | O | H | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">eudialyte</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;12&lt;/sub&gt;Sr&lt;sub&gt;3&lt;/sub&gt;Ca&lt;sub&gt;6&lt;/sub&gt;Fe&lt;sub&gt;3&lt;/sub&gt;Zr&lt;sub&gt;3&lt;/sub&gt;W(Si&lt;sub&gt;25&lt;/sub&gt;O&lt;sub&gt;73&lt;/sub&gt;)(O,OH,H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;3&lt;/sub&gt;(Cl,OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1998-042</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-7137</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7137:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7137.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;12&lt;/sub&gt;Ca&lt;sub&gt;6&lt;/sub&gt;Sr&lt;sub&gt;3&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;W&lt;sup&gt;6+&lt;/sup&gt;Zr&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(Si&lt;sub&gt;25&lt;/sub&gt;O&lt;sub&gt;73&lt;/sub&gt;)(O,OH,H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;3&lt;/sub&gt;(Cl,OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Khomyakovite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Khomyakovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Johnsen O, Gault R A, Grice J D, Ercit T S (1999) Khomyakovite and manganokhomyakovite, two new members of the eudialyte group from Mont Saint-Hilaire, Quebec, Canada, The Canadian Mineralogist 37, 893-899</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Eudialyte</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CO.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si9O27]18- 9-membered rings</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Khomyakovite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1998-042</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/cornwallite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cornwallite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/cornwallite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;5&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Pentacopper diarsenate tetrahydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-1133</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1133:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1133.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050469 | R110146</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cornwallite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cornwallite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Zippe F X M (1847) Über den Cornwallit, eine neue Species des Mineralreichs, Abhandlungen der Königlichen Böhmischen Gesellschaft der Wissenschaften 4, 649-654 Chemical composition revised: Church A H (1868) Chemical researches on new and rare Cornish minerals. V. Cornwallite, The Journal of the Chemical Society of London 21, 276-279</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.BD.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With only medium-sized cations, (OH, etc.):RO4= 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Cornwallite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1847</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/granularmaterial/anhedral">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">MacKenzie, W.S., Donaldson, C.H. &amp; Guilford, C., 1982. Atlas of igneous rocks and their textures. John Wiley &amp; Sons, New York</dct:source>
    <rdfs:comment xml:lang="en">Crystalline particles in a rock lack well-developed crystal faces, usually referring to igneous or metamorphic grains</rdfs:comment>
    <rdfs:label xml:lang="en">anhedral</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/granularmaterial/Grain_Roundness_Value"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/hexahydroborite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Hexahydroborite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | B | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/hexahydroborite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca[B(OH)&lt;sub&gt;4&lt;/sub&gt;]&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1977-015</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1892</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1892:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1892.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca[B(OH)&lt;sub&gt;4&lt;/sub&gt;]&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hexahydroborite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hexahydroborite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Simonov M A, Malinko S V, Belov N V, Kazanskaya E V, Egorov-Tismenko Yu K, Fedorenko M B, Belokoneva E L, Yamnova N A, Kuznetsova N N (1977) Hexahydroborite Ca[B(OH)_4_]_2_·2H_2_O - a new mineral. Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 106(6), 691-697</gsmin:statusnotes>
    <gsmin:strunzcodeV10>06.AC.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Monoborate, B(O,OH)4, without and with additional anions; 1(T), 1(T)+OH, etc</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Hexahydroborite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1977-015</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicrelation/intrudes">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">subject rock body intrudes object rock body. Implies that subject rock body is igneous rock, and that object rock body is older than subject rock body</rdfs:comment>
