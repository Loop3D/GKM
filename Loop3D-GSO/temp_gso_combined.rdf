    <gsmin:rruffnameplain xml:lang="en">Stannopalladinite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Maslenitzky I N, Faleev P V, Iskyul E V (1947) Tin-bearing minerals of the platinum group in sulfide copper-nickel ores, Doklady Akademii Nauk SSSR 58, 1137-1140</gsmin:statusnotes>
    <gsmin:strunzcodeV10>01.AG.25</gsmin:strunzcodeV10>
