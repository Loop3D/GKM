    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7387:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7387.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CuNiSb&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zlatogorite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Zlatogorite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Spiridonov E M, Spiridonov F M, Kabalov Y K, Karataeva N I, Skokova E V (1995) Zlatogorite CuNiSb_2_ - A new mineral from the listwanite in rodingite at the Zolotaya Gora deposit (Middle Ural), Vestnik Moskovskogo Universiteta, Geologiya 4, 57-64</gsmin:statusnotes>
