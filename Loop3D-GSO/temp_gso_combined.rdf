  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/UpperDevonian2004">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologictime/Epoch"/>
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Specific_Geologic_Time_Unit"/>
    <rdfs:comment xml:lang="en">older bound -385.3 +|-2.6 Ma</rdfs:comment>
    <rdfs:comment xml:lang="en">younger bound -359.2 +|-2.5 Ma</rdfs:comment>
    <rdfs:label xml:lang="en">Upper Devonian Epoch</rdfs:label>
