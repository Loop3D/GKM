    <gsmin:rruffnameplain xml:lang="en">Jonesite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Wise W S, Pabst A, Hinthorne J R (1977) Jonesite a new mineral from the Benitoite Gem mine, San Benito County, California, The Mineralogical Record 8, 453-456</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.DJ.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 4-periodic double and triple chains</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Jonesite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1976-040</gsmin:wikipediadate>
