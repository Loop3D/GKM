  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfoliation/fissile_lamination">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Diffuse to distinct lamination in mudstones and mud, defined by the alignment of clay minerals. Lacks distinct very-fine scale layering and repetition of couplets that characterize varves. Essentially a continuous cleavage parallel to bedding, but considered a sedimentary structure related to sediment compaction during diagenesis.</rdfs:comment>
    <dct:source xml:lang="en">NADM sedimentary rock vocabulary (https://pubs.usgs.gov/of/2004/1451/sltt/appendixC/appendixC_pdf.zip)  SLTTs 2004, CGI foliationtype SKOS vocabulary 2018-08-03</dct:source>
    <rdfs:label xml:lang="en">fissile lamination</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfoliation/bedding_lamination_structure"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/timeFinishedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">source interval begins before target; source and target end simultaneously; inverse of finishes</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/timeIncludes"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/timeIntersects"/>
    <owl:inverseOf rdf:resource="https://w3id.org/gso/1.0/common/timeFinishes"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseCambrianStage2SP2004">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologiccontact/Stratigraphic_Point"/>
    <rdfs:label xml:lang="en">Stratotype Point Base of Cambrian Stage 2</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://stratigraphy.org/gssps/"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/yusupovite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Yusupovite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Zr | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;Zr(Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;15&lt;/sub&gt;)(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2014-022</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;Zr&lt;sup&gt;4+&lt;/sup&gt;(Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;15&lt;/sub&gt;)·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Yusupovite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Yusupovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Agakhanov A A, Pautov L A, Karpenko V Y, Sokolova E, Abdu Y A, Hawthorne F C, Pekov I V, Siidra O I (2015) Yusupovite, Na_2_Zr(Si_6_O_15_)(H_2_O)_3_, a new mineral species from the Darai-Pioz alkaline massif and its implications as a new microporous filter for large ions. American Mineralogist 100, 1502-1508</gsmin:statusnotes>
  </rdf:Description>
