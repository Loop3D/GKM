    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Schlossmacherite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Schlossmacherite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Schmetzer K, Ottemann J, Bank H (1980) Schlossmacherit, (H3O,Ca)Al3[(OH)6|((S,As)O4)2], ein neues Mineral der Alunit-Jarosit-Reihe, Neues Jahrbuch für Mineralogie, Monatshefte 1980, 215-222</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Alunite-Alunite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.BC.10</gsmin:strunzcodeV10>
