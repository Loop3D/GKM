    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1444:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1444.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ni&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;15&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Falcondoite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Falcondoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Springer G (1976) Falcondoite, nickel analogue of sepiolite, The Canadian Mineralogist 14, 407-409</gsmin:statusnotes>
