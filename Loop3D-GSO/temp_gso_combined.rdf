    <gsmin:statusnotes xml:lang="en">Nawaz R (1974) Killalite, a new mineral from Co. Sligo, Ireland, Mineralogical Magazine 39, 544-548 Chemical formula revised: Taylor H F W (1997) The crystal structure of killalaite, Mineralogical Magazine 41, 363-369</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.BE.85</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate: Si2O7 groups, with additional anions; cations in octahedral [6] and greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Killalaite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1973-033</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/takanelite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Takanelite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | Ca | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/takanelite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Mn&lt;sup&gt;2+&lt;/sup&gt;,Ca)&lt;sub&gt;2x&lt;/sub&gt;(Mn&lt;sup&gt;4+&lt;/sup&gt;)&lt;sub&gt;1-x&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;·0.7H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1970-034</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3871</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3871:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3871.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Mn&lt;sup&gt;2+&lt;/sup&gt;,Ca)&lt;sub&gt;2x&lt;/sub&gt;Mn&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;1-x&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;·0.7H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Takanelite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Takanelite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Nambu M, Tanida K (1971) New mineral takanelite, Journal of the Japanese Association of Mineralogists, Petrologists and Economic Geologists 65, 1-15</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.FL.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Hydroxide (without V or U), Hydroxides with H2O±(OH); sheets of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Takanelite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1970-034</gsmin:wikipediadate>
  </rdf:Description>
