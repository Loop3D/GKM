    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;15&lt;/sub&gt;Ca&lt;sub&gt;6&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Zr&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Si(Si&lt;sub&gt;25&lt;/sub&gt;O&lt;sub&gt;73&lt;/sub&gt;)(O,OH,H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;3&lt;/sub&gt;(Cl,OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050230 | R060035 | R060206</gsmin:rruffids>
