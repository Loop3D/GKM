    <gsmin:webmineralurl>http://www.webmineral.com/data/Bobtraillite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2001-041</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ecandrewsite">
