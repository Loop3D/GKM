    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4410:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4410.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sup&gt;2+&lt;/sup&gt;O</gsmin:rruffchemistry>
