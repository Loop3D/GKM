  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/magnesiopascoite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Magnesiopascoite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Mg | V | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;MgV&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;10&lt;/sub&gt;O&lt;sub&gt;28&lt;/sub&gt;·16H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2007-025</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dicalcium magnesium decavanadiumV octacosaoxide hexadecahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-32206</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:32206:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-32206.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;MgV&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;10&lt;/sub&gt;O&lt;sub&gt;28&lt;/sub&gt;·16H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Magnesiopascoite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Magnesiopascoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf A R, Steele I M (2008) Magnesiopascoite, a new member of the pascoite group: description and crystal structure, The Canadian Mineralogist 46, 679-686</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Pascoite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.HC.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">V[5,6] Vanadate, [6]-Sorovanadates</gsmin:strunzlabel>
