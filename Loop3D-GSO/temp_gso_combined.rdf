    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3279:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3279.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaAlMg&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;)O&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Preiswerkite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Preiswerkite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Keusen H R, Peters T (1980) Preiswerkite, an Al-rich trioctahedral sodium mica from the Geisspfad ultramafic complex (Penninic Alps), American Mineralogist 65, 1134-1137</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Mica</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EC.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with mica sheets, composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
