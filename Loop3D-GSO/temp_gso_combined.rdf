    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)F</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Redefined|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: IronII manganeseII phosphate fluoride</gsmin:iupacchemname>
    <gsmin:mindatid>min-4436</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4436:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4436.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;PO&lt;sub&gt;4&lt;/sub&gt;F</gsmin:rruffchemistry>
    <gsmin:rruffids>R050279</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zwieselite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Zwieselite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Breithaupt J F A (1841) Phyletites ferrosus oder Zwiselit. in Vollständige Charakteristik des Mineral-Systems 2nd Edition, Arnoldische Buchhandlung (Dresden and Leipzig) 299-300</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Triplite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BB.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With only medium-sized cations, (OH, etc.):RO4 about 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Zwieselite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1841</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/charmarite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
