    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Mn | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">wollastonite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/bustamite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaMn&lt;sup&gt;2+&lt;/sup&gt;Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-809</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:809:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-809.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaMn&lt;sup&gt;2+&lt;/sup&gt;Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R040014</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bustamite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Bustamite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Brongniart A (1826) Sur la bustamite, bisilicate de manganèse et de chaux du Mexique, Anneles des Sciences Naturelles 8, 411-418. Original material shown to be a mixture; name applied to current mineral: Larsen E S, Shannon E V (1922) Bustamite from Franklin Furnace, New Jersey. American Mineralogist 7, 95-100.</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Wollastonite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DG.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 3-periodic single and multiple chains</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Bustamite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1826</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/penroseite">
