  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/carlfrancisite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Carlfrancisite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | Mg | Fe | Al | As | O | Si | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(Mn&lt;sup&gt;2+&lt;/sup&gt;,Mg,Fe&lt;sup&gt;3+&lt;/sup&gt;,Al)&lt;sub&gt;42&lt;/sub&gt;(As&lt;sup&gt;3+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;[(Si,As&lt;sup&gt;5+&lt;/sup&gt;)O&lt;sub&gt;4&lt;/sub&gt;]&lt;sub&gt;6&lt;/sub&gt;[(As&lt;sup&gt;5+&lt;/sup&gt;,Si)O&lt;sub&gt;4&lt;/sub&gt;]&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;42&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2012-033</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-43359</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:43359:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-43359.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(Mn&lt;sup&gt;2+&lt;/sup&gt;,Mg,Fe&lt;sup&gt;3+&lt;/sup&gt;,Al)&lt;sub&gt;42&lt;/sub&gt;[As&lt;sup&gt;3+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;]&lt;sub&gt;2&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;[(Si,As&lt;sup&gt;5+&lt;/sup&gt;)O&lt;sub&gt;4&lt;/sub&gt;]&lt;sub&gt;6&lt;/sub&gt;[(As&lt;sup&gt;5+&lt;/sup&gt;,Si)O&lt;sub&gt;4&lt;/sub&gt;]&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;42&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Carlfrancisite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Carlfrancisite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hawthorne F C, Abdu Y A, Ball N A, Pinch W W (2013) Carlfrancisite: Mn^2+^_3_(Mn^2+^,Mg,Fe^3+^,Al)_42_(As^3+^O_3_)_2_(As^5+^O_4_)_4_[(Si,As^5+^)O_4_]_6_[(As^5+^,Si)O_4_]_2_(OH)_42_, a new arseno-silicate mineral from the Kombat mine, Otavi Valley, Namibia. American Mineralogist 98, 1693-1696</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hematolite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BE.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With only medium-sized cations, (OH, etc.):RO4 &gt; 2:1</gsmin:strunzlabel>
    <gsmin:wikipediadate>2012-033</gsmin:wikipediadate>
  </rdf:Description>
