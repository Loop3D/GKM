    <gsmin:chemistryelements>Cd | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">periclase</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/monteponite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CdO</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: CadmiumII oxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-2764</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2764:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2764.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cd&lt;sup&gt;2+&lt;/sup&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Monteponite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Monteponite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mineral is described but not named: Wittich E, Neumann B (1901) Ein neues Cadmium-Mineral, Centralblatt für Mineralogie, Geologie und Paläontologie 1901, 549-551 Mineral is named: Fairbanks E E (1946) The punched card identification of ore minerals, Economic Geology 41, 761-768</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.AB.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 2:1 and 1:3, M:O = 1:1 (and up to 1:1.25); with small to medium-sized cations only</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Monteponite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1901</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/zlatogorite">
