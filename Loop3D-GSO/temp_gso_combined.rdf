    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Te | W | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;(Te&lt;sub&gt;1.5&lt;/sub&gt;&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;&lt;sub&gt;0.5&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;W&lt;sub&gt;5&lt;/sub&gt;O&lt;sub&gt;19&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2014-053</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;(Te&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;1.5&lt;/sub&gt;&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;&lt;sub&gt;0.5&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;W&lt;sup&gt;6+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;O&lt;sub&gt;19&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tewite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tewite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Li G, Xue Y, Xiong M (2019) Tewite: a K-Te-W new mineral species with a modified tungsten-bronze type structure, from the Panzhihua-Xichang region, southwest China. European Journal of Mineralogy 31, 145-152</gsmin:statusnotes>
  </rdf:Description>
