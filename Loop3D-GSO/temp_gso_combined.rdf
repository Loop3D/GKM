    <gsmin:mindaturl>http://www.mindat.org/min-3134.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KMg&lt;sub&gt;2&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;·15H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Paulkerrite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Paulkerrite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Peacor D R, Dunn P J, Simmons W B (1984) Paulkerrite a new titanium phosphate from Arizona, The Mineralogical Record 15, 303-306 Dunn P J, Fleischer M, Langley R H, Shingley J E, Zilczer J A (1985) New mineral names, American Mineralogist 70, 871-881</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.DH.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 &lt; 1:1</gsmin:strunzlabel>
