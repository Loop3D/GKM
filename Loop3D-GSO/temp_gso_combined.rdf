    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2555:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2555.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt; 2+&lt;/sup&gt;S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;·7H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
