  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-26</dct:created>
    <dct:creator rdf:resource="https://w3id.org/gso/1.0/common/boyan_brodaric"/>
    <dct:creator rdf:resource="https://w3id.org/gso/1.0/common/stephen_richard"/>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/legalcode"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-26</dct:modified>
    <dct:publisher>ARC Loop3D project;  https://loop3d.org/</dct:publisher>
    <dct:publisher>Geological Survey of Canada, Natural Resources Canada, Government of Canada</dct:publisher>
    <schema:codeRepository>https://github.com/Loop3D/GKM</schema:codeRepository>
    <dct:rights>Copyright (c) 2021 Government of Canada</dct:rights>
    <rdfs:comment xml:lang="en">This ontology defines time intervals for specific time scale instance, ics 2020, ics2017 and ics2004, using the timescale implementation in the LOOP3D geology.ttl module. Adapted for Loop3D geoscience ontology by SMR 2019-11-15</rdfs:comment>
    <rdfs:label xml:lang="en">Geologic Timescale Elements For  International Chronostratigraphic Chart 2004,2017, 2020</rdfs:label>
    <dct:bibliographicCitation>Brodaric, B., and Richard, S.M., 2021, The GeoScience Ontology Reference: Geological Survey of Canada Open File 8796, 34 p., https://doi.org/10.4095/328296</dct:bibliographicCitation>
    <owl:imports rdf:resource="https://w3id.org/gso/1.0/geologictime/ontology"/>
    <owl:imports rdf:resource="https://w3id.org/gso/1.0/geology/ontology"/>
    <owl:imports rdf:resource="https://w3id.org/gso/1.0/qudt/voc/ontology"/>
    <skos:prefLabel xml:lang="en">Geoscience Ontology, Geologic Timescale Elements</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/biachellaite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Biachellaite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | K | Si | Al | O | S | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,Ca,K)&lt;sub&gt;8&lt;/sub&gt;(Si&lt;sub&gt;6&lt;/sub&gt;Al&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;)(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;0.5&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2007-044</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-32621</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:32621:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-32621.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,Ca,K)&lt;sub&gt;8&lt;/sub&gt;(Si&lt;sub&gt;6&lt;/sub&gt;Al&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;)(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;0.5&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Biachellaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Biachellaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chukanov N V, Rastsvetaeva R K, Pekov I V, Zadov A E, Allori R, Zubkova N V, Giester G, Pushcharovsky D Y, Van K V (2008) Biachellaite (Na,Ca,K)&lt;sub&gt;8&lt;/sub&gt;(Si&lt;sub&gt;6&lt;/sub&gt;Al&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;)(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;0.5&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O, a new member of the cancrinite group, Zapiski Rossiiskogo Mineralogicheskogo Obshchetstva 137(3), 57-66</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Cancrinite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.FB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Polyphosphate, etc., with OH only</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Biachellaite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2007-044</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/coesite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Coesite</rdfs:label>
