    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;Mg(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Picromerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Picromerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named picromeride: Guarini G, Palmieri L, Scacchi A (1955) Chapter 5. Esame mineralogico-chimico delle produzioni dell'incendio, in Memoria sullo Incendio Vesuviano, Gaetano Nobile (Napoli) 165-200</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Picromerite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.CC.60</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, with H2O, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Picromerite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1955</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/hasOutput">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
