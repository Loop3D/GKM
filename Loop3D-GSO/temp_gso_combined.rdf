  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/bahianite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Bahianite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Al | Sb | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/bahianite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al&lt;sub&gt;5&lt;/sub&gt;Sb&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;14&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1974-027</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Pentaaluminium triantimonyV tetradecaoxide dihydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-484</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:484:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-484.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al&lt;sub&gt;5&lt;/sub&gt;Sb&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;14&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050627 | R060433</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bahianite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Bahianite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Moore P B, Barbosa C D P, Gaines R V (1978) Bahianite, Sb&lt;sub&gt;3&lt;/sub&gt;Al&lt;sub&gt;5&lt;/sub&gt;O&lt;sub&gt;14&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;, a new species, Mineralogical Magazine 42, 179-182</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.DC.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With medium-sized cations; sheets of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Bahianite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1974-027</gsmin:wikipediadate>
  </rdf:Description>
