    <gsmin:imanumber xml:lang="en">IMA1975-027</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Trimagnesium diphosphate octahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-524</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:524:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-524.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R061045</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Barićite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Baricite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Sturman B D, Mandarino J A (1976) Baricite, the magnesium analogue of vivianite, from Yukon Territory, Canada, The Canadian Mineralogist 14, 403-406</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Vivianite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CE.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With only medium-sized cations, RO4:H2O about 1:2.5</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Baricite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1975-027</gsmin:wikipediadate>
