  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/burgessite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Burgessite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Co | H | O | As</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic, orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/burgessite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Co&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;4&lt;/sub&gt;[AsO&lt;sub&gt;3&lt;/sub&gt;(OH)]&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2007-055</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dicobalt dihydrogen arsenate pentahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-35833</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:35833:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-35833.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Co&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;4&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;OH)&lt;sub&gt;2&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Burgessite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Burgessite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Sejkora J, Hawthorne F C, Cooper M A, Grice J D, Vajdak J, Jambor J L (2009) Burgessite, Co&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;4&lt;/sub&gt;[AsO&lt;sub&gt;3&lt;/sub&gt;(OH)]&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O), a new arsenate mineral species from the Keeley mine, South Lorrain township, Ontario, Canada, The Canadian Mineralogist 47, 159-164</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Burgessite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CB.60</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With only medium-sized cations, RO4:H2O = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Burgessite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2007-055</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/coralloite">
