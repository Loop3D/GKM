    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Tricopper nitrate pentahydroxyl dihydrate</gsmin:iupacchemname>
