    <gsmin:rruffids>R130552</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Richelsdorfite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Richelsdorfite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Süsse P, Schnorrer-Köhler G (1983) Richelsdorfit, Ca2Cu5Sb[Cl/(OH)6/(AsO4)4]·6H2O, ein neues mineral, Neues Jahrbuch für Mineralogie, Monatshefte 1983, 145-150 Dunn P J, Grice J D, Fleischer M, Pabst A (1984) New mineral names, American Mineralogist 69, 210-215</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.DK.??</gsmin:strunzcodeV10>
