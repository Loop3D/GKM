    <gsoc:hasDataValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">33.9</gsoc:hasDataValue>
    <gsoc:hasQuality rdf:nodeID="ndb26e920196f4af8bbd263b193e6f242b738"/>
