  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicunit/Lithogenetic_Unit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Lithogenetic Unit</rdfs:label>
    <rdfs:comment xml:lang="en">Rock object defined by a specific genesis AND surrounding rocks, e.g. Metamorphic Unit, Sedimentary Unit. This differs from a unit such as 'Metamorphic Unit created by Event X', which is not defined by bounding rocks, but only by a specific genesis (Event X) and which is not a Geologic Unit, but is a Situated Rock Object. It also differs from a unit such as 'Metamorphic Rock' (a Generic Rock Object), which includes metamorphic rocks regardless of originating process or event, and without regard to surrounding rocks: i.e. all rocks (possibly in an area) created by any metmorphic event or process</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="n6d111a80c3f44937a55e40566db5bca3b118"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicunit/Nonstratigraphic_Unit"/>
    <owl:disjointWith rdf:resource="https://w3id.org/gso/1.0/geologicunit/Facies"/>
    <owl:equivalentClass rdf:nodeID="n6d111a80c3f44937a55e40566db5bca3b122"/>
  </rdf:Description>
