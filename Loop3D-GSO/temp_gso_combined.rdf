    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cr&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: ChromiumIII oxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-1411</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1411:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1411.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cr&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060892</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Eskolaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Eskolaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kouvo O, Vuorelainen Y (1958) Eskolaite, a new chromium mineral, American Mineralogist 43, 1098-1106</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Corundum</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.CB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 2: 3,3: 5, and similar, With medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Eskolaite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1958</gsmin:wikipediadate>
  </rdf:Description>
