    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;ZrSi&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2015-042</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;Zr&lt;sup&gt;4+&lt;/sup&gt;Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hydroterskite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hydroterskite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Grice J D, Rowe R, Poirier G (2015) Hydroterskite: A new mineral species from the Saint-Amable Sill, Quebec, and a comparison with terskite and elpidite. The Canadian Mineralogist 53, 821-832</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Terskite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/tashelgite">
