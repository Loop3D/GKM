  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologiccontact/Nonconformable_Contact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf, K.K.E, Mehl, J.P. &amp; Jackson, J.A. (eds), 2005. Glossary of geology, 5th Edition. American Geological Institute, Alexandria, 779 p.</dct:source>
    <rdfs:comment xml:lang="en">An unconformable contact between an underlying, older nonstratified geological unit (usually intrusive igneous rocks or metamorphics) and an overlying, younger stratified geological unit.</rdfs:comment>
    <rdfs:label xml:lang="en">nonconformable contact</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologiccontact/Unconformable_Contact"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicstructure/Crystallographic_Preferred_Orientation_Fabric">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">fabric defined by a preferred orientation of the crystallographic axes of mineral particles in a rock.</rdfs:comment>
    <rdfs:label xml:lang="en">Crystallographic Preferred Orientation Fabric</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicstructure/Particle_Preferred_Orientation_Fabric"/>
  </rdf:Description>
