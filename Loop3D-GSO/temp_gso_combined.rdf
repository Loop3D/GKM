  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kamphaugite-y">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kamphaugite-(Y)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Y | C | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/kamphaugitey.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaY(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1987-043</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dicalcium diyttrium tetracarbonate dixydroxyl trihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2151</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2151:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2151.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaY&lt;sup&gt;3+&lt;/sup&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R080085</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kamphaugite-(Y)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kamphaugite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Raade G, Brastad K (1993) Kamphaugite-(Y), a new hydrous Ca-(Y,REE)-carbonate mineral, European Journal of Mineralogy 5, 679-683 Chemical formula changed from Ca_2_Y_2_(CO_3_)_4_(OH)_2_·3H_2_O: Romming C, Kocharian A K, Raade G (1993) The crystal structure of kamphaugite-(Y). European Journal of Mineralogy 5, 685-690</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.DC.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions and H2O, With large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Kamphaugite-%28Y%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1987-043</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/meerschautite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Meerschautite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ag | Cu | Pb | Sb | As | S | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ag,Cu)&lt;sub&gt;5.5&lt;/sub&gt;Pb&lt;sub&gt;42.4&lt;/sub&gt;(Sb,As)&lt;sub&gt;45.1&lt;/sub&gt;S&lt;sub&gt;112&lt;/sub&gt;O&lt;sub&gt;0.8&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2013-061</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ag&lt;sup&gt;1+&lt;/sup&gt;,Cu&lt;sup&gt;1+&lt;/sup&gt;)&lt;sub&gt;5.5&lt;/sub&gt;Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;42.4&lt;/sub&gt;(Sb&lt;sup&gt;3+&lt;/sup&gt;,As&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;45.1&lt;/sub&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;112&lt;/sub&gt;O&lt;sub&gt;0.8&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Meerschautite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Meerschautite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Biagioni C, Moëlo Y, Orlandi P, Stanley C J (2016) Lead-antimony sulfosalts from Tuscany (Italy). XVII. Meerschautite, (Ag,Cu)_5.5_Pb_42.4_(Sb,As)_45.1_S_112_O_0.8_, a new expanded derivative of owyheeite from the Pollone mine, Valdicastello Carducci: occurrence and crystal structure. Mineralogical Magazine 80, 675-690</gsmin:statusnotes>
  </rdf:Description>
