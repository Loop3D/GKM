    <gsmin:imanumber xml:lang="en">IMA1996-025</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-7184</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7184:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7184.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;3&lt;/sub&gt;Ca&lt;sub&gt;4&lt;/sub&gt;Al&lt;sub&gt;11&lt;/sub&gt;Si&lt;sub&gt;85&lt;/sub&gt;O&lt;sub&gt;192&lt;/sub&gt;·60H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mutinaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Mutinaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Galli E, Vezzalini G, Quartieri S, Alberti A, Franzini M (1997) Mutinaite, a new zeolite from Antarctica: the natural counterpart of ZSM-5, Zeolites 19, 318-322 Jambor J L, Pertsev N N, Roberts A C (1998) New mineral names, American Mineralogist 83, 907-911</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.GF.35</gsmin:strunzcodeV10>
