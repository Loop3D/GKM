    <gsmin:mindaturl>http://www.mindat.org/min-2968.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;(Mn,Mg)(Mn&lt;sup&gt;3+&lt;/sup&gt;,Al,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;3&lt;/sub&gt;(O,OH)&lt;sub&gt;14&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Okhotskite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Okhotskite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Togari K, Akasaka M (1987) Okhotskite, a new mineral, an Mn3+-dominant member of the pumpellyite group, from the Kokuriki mine, Hokkaido, Japan, Mineralogical Magazine 51, 611-614 Jambor J L, Burke E A J, Ercit T S, Grice J D (1988) New mineral names, American Mineralogist 73, 1492-1499</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.BG.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate with mixed SiO4 and Si2O7 groups; cations in octahedral [6] and greater coordination</gsmin:strunzlabel>
