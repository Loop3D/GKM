    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1962-006</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: IronII sulfate tetrahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-3469</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3469:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3469.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070187</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Rozenite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Rozenite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kubisz J (1960) Rozenite - FeSO&lt;sub&gt;4&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O - a new mineral, Bulletin de L'Academie Polonaise des Sciences, Série des sciences géologiques et géographiques 8, 107-113 Redefined: Jambor J L, Traill R J (1963) On rozenite and siderotil, The Canadian Mineralogist 7, 751-763</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Starkeyite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.CB.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, with H2O, With only medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Rozenite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1962-006</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/karpenkoite">
