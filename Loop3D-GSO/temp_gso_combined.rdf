    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Pb&lt;sub&gt;7&lt;/sub&gt;(Si&lt;sub&gt;36&lt;/sub&gt;Al&lt;sub&gt;12&lt;/sub&gt;)O&lt;sub&gt;99&lt;/sub&gt;·n(H&lt;sub&gt;2&lt;/sub&gt;O,OH)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1985-036</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2577</gsmin:mindatid>
