    <gsmin:rruffids>R050584</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Schultenite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Schultenite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Spencer L J, Mountain E D (1926) Schultenite, a new mineral, from South-West Africa, Mineralogical Magazine 21, 149-155</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.AD.30</gsmin:strunzcodeV10>
