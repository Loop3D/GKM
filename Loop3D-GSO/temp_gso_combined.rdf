    <gsmin:rruffnameplain xml:lang="en">Haycockite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Cabri L J, Hall S R (1972) Mooihoekite and haycockite, two new copper-iron sulfides, and their relationship to chalcopyrite and talnakhite, American Mineralogist 57, 689-708</gsmin:statusnotes>
