    <gsmin:mindatid>min-4180</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4180:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4180.html</gsmin:mindaturl>
