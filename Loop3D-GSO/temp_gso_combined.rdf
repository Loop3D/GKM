    <gsmin:rruffnameplain xml:lang="en">Giuseppettite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mazzi F, Tadini C (1981) Giuseppettite, a new mineral from Sacrofano (Italy), related to the cancrinite group, Neues Jahrbuch für Mineralogie, Monatshefte 1981, 103-110</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Cancrinite-sodalite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.FB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Tektosilicate with additional anions</gsmin:strunzlabel>
