  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/hingganite-y">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Hingganite-(Y)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Be | Y | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">gadolinite-datolite-datolite subgroup</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/hingganitey.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BeY(SiO&lt;sub&gt;4&lt;/sub&gt;)(OH)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1981-052</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Yttrium beryllium nesosilicate hydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-1906</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1906:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1906.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BeY&lt;sup&gt;3+&lt;/sup&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)(OH)</gsmin:rruffchemistry>
    <gsmin:rruffids>R070466 | R120171</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hingganite-(Y)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hingganite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Ding X, Bai G,Yuan Z, Sun L (1981) Yttroceberysite, a new Ce-Be-rich silicate, Geological Review 27, 459-466 Renamed: Ding X, Bai G,Yuan Z, Liu J (1984) Hingganite [(Y,Ce)BeSiO&lt;sub&gt;5&lt;/sub&gt;(OH)]: new data, Acta Petrologica Mineralogica et Analytica 3, 46-48 Name changed from hingganite: Nickel E H, Mandarino J A (1987) Procedures involving the IMA Commission on New Minerals and Mineral Names and guidelines on mineral nomenclature, American Mineralogist 72, 1031-1042</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Gadolinite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AJ.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with BO3 triangles and/or B[4], Be[4] tetrahedra, cornersharing with SiO4</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Hingganite-%28Y%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1981-052</gsmin:wikipediadate>
  </rdf:Description>
