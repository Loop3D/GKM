  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/combeite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Combeite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">lovozerite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/combeite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;4.5&lt;/sub&gt;Ca&lt;sub&gt;3.5&lt;/sub&gt;Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;17.5&lt;/sub&gt;(OH)&lt;sub&gt;0.5&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1115</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1115:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1115.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;Ca&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;9&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Combeite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Combeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Sahama T G, Hytönen K (1957) Götzenite and combeite, two new silicates from the Belgian Congo, Mineralogical Magazine 31, 503-510 Chemical formula revised: Fischer R, Tillmanns E (1981) Die Kristallstruktur von Combeit; ein Cyclosilikat mit Sechserringen, Fortschritte der Mineralogie 59, 45-46</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Lovozerite-Zirsinalite–Lovozerite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CJ.15a</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si6O18]12- 6-membered single rings (sechser-Einfachringe), without insular complex anions</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Combeite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1957</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/krasnovite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
