    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2199:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2199.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Pb&lt;sup&gt;2+&lt;/sup&gt;Te&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;6&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
