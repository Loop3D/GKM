    <gsmin:mindaturl>http://www.mindat.org/min-27487.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;9&lt;/sub&gt;(Ca,Na)&lt;sub&gt;12&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;,Fe&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;Zr&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Si&lt;sub&gt;25&lt;/sub&gt;O&lt;sub&gt;72&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)(OH)&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mogovidite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Mogovidite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chukanov N V, Moiseev M M, Rastsvetaeva R K, Rozenberg K A, Zadov A E, Pekov I V, Korovushkin V V (2005) Golyshevite (Na,Ca)_10_Ca_9_(Fe^3+^,Fe^2+^)_2_Zr_3_NbSi_25_O_72_(CO_3_)(OH)_3_·H_2_O, and mogovidite, Na_9_(Ca,Na)_6_Ca_6_(Fe^3+^,Fe^2+^)_2_Zr_3_ Si_25_O_72_(CO_3_)(OH,H_2_O)_4_, the new eudialyte-group minerals from high-calcium agpaitic pegmatites of the Kovdor Massif, Kola peninsula, Zapiski Rossiiskogo Mineralogicheskogo Obshchetstva 134(6), 36-47</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Eudialyte</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CO.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si9O27]18- 9-membered rings</gsmin:strunzlabel>
