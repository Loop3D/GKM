    <gsmin:wikipediadate>1748</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/mangani-dellaventuraite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Mangani-dellaventuraite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Mg | Mn | Li | Ti | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">amphibole-group 4 Na</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaNa&lt;sub&gt;2&lt;/sub&gt;(MgMn&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;Li)Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2003-061</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaNa&lt;sub&gt;2&lt;/sub&gt;(MgMn&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;LiTi&lt;sup&gt;4+&lt;/sup&gt;)Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mangani-dellaventuraite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Mangani-dellaventuraite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Tait K T, Hawthorne F C, Grice J D, Ottolini L, Nayak V K (2005) Dellaventuraite, NaNa&lt;sub&gt;2&lt;/sub&gt;(MgMn&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;Li)Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;, a new anhydrous amphibole from the Kajlidongri Manganese Mine, Jhabua District, Madhya Pradesh, India, American Mineralogist 90, 304-309 Name changed from dellaventuraite: Hawthorne F C, Oberti R, Harlow G E, Maresch W V, Martin R F, Schumacher J C, Welch M D (2012) Nomenclature of the amphibole supergroup. American Mineralogist 97, 2031-2048</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Amphibole</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfeature/Lenticular_Lithosome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI rockbodypart vocabulary 2016-11-21 </dct:source>
    <rdfs:comment xml:lang="en">Lithosome occurs as discrete lense-shaped bodies, not connected with other bodies.</rdfs:comment>
    <rdfs:label xml:lang="en">lenticular lithosome</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfeature/Lithosome"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/evenkite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Evenkite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>C | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic, monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/evenkite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">C&lt;sub&gt;23&lt;/sub&gt;H&lt;sub&gt;48&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1428</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1428:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1428.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">C&lt;sub&gt;23&lt;/sub&gt;H&lt;sub&gt;48&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Evenkite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Evenkite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Skropyshev A V (1953) A paraffin from a polymetallic vein, Doklady Akademii Nauk SSSR 88, 717-719 Formula changed from C_21_H_44_ to C_24_H_50_: Strunz H, Contag B (1965) Evenkit, Flagstaffit, Idrialin und Reficit. Neues Jahrbuch für Mineralogie, Monatshefte 1965, 19-25 Chemical formula revised from C_24_H_50_: Kotelnikova E N, Filatov S K, Chukanov N V (2004) Evenkite: symmetry, chemical composition, identification and thermal behavior, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 133(3), 80-92</gsmin:statusnotes>
    <gsmin:strunzcodeV10>10.BA.50</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Hydrocarbon</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Evenkite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1953</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/arsenatrotitanite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Arsenatrotitanite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ti | As | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaTi(AsO&lt;sub&gt;4&lt;/sub&gt;)O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2016-015</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Pending publication</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaTi&lt;sup&gt;4+&lt;/sup&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Arsenatrotitanite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Arsenatrotitanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pekov, I.V., Zubkova, N.V., Agakhanov, A.A., Belakovskiy, D.I., Vigasina, M.F., Yapaskurt, V.O., Sidorov, R.G., Britvin, S.N. and Pushcharovsky, D.Y. (2016) Arsenatrotitanite, IMA 2016-015. CNMNC Newsletter No. 33, October 2016, page 1143; Mineralogical Magazine, 80, 1135–1144</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Titanite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/carlsonite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Carlsonite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>N | H | Fe | O | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(NH&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;5&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;O(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;·7H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2014-067</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(NH&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;5&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;O(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;·7H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Carlsonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Carlsonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf A R, Richards R P, Nash B P, Murowchick J B, Rakovan J F (2016) Carlsonite, (NH_4_)_5_Fe^3+^_3_O(SO_4_)_6_·7H_2_O, and huizingite-(Al), (NH_4_)_9_Al_3_(SO_4_)_8_(OH)_2_·4H_2_O, two new minerals from a natural fire in an oil-bearing shale near Milan, Ohio. American Mineralogist 101, 2095-2107</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Metavoltine</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/devitoite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Devitoite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ba | P | O | C | Fe | Si | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/devitoite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">[Ba&lt;sub&gt;6&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)][Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;7&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(SiO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;8&lt;/sub&gt;]</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2009-010</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-39450</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:39450:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-39450.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba&lt;sub&gt;6&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;7&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)O&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R130083</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Devitoite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Devitoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf A R, Rossman G R, Steele I M, Pluth J J, Dunning G E, Walstrom R E (2010) Devitoite, a new heterophyllosilicate mineral with astrophyllite-like layers from eastern Fresno County, California, The Canadian Mineralogist 48, 29-40</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Astrophyllite-Devitoite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.E?</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate</gsmin:strunzlabel>
    <gsmin:wikipediadate>2009-010</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/nizamoffite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Nizamoffite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | Zn | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;Zn&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2012-076</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nizamoffite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Nizamoffite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf A R, Falster A U, Simmons W B, Whitmore R W (2013) Nizamoffite, Mn^2+^Zn_2_(PO_4_)_2_(H_2_O)_4_, the Mn analogue of hopeite from the Palermo No. 1 pegmatite, North Groton, New Hampshire. American Mineralogist 98, 1893-1898</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hopeite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/argentotennantite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Argentotennantite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ag | Cu | Fe | Zn | As | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">tennantite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/argentotennantite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ag&lt;sub&gt;6&lt;/sub&gt;[Cu&lt;sub&gt;4&lt;/sub&gt;(Fe,Zn)&lt;sub&gt;2&lt;/sub&gt;]As&lt;sub&gt;4&lt;/sub&gt;S&lt;sub&gt;13&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1985-026</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-319</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:319:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-319.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ag&lt;sup&gt;1+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;Cu&lt;sup&gt;1+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;(Fe&lt;sup&gt;2+&lt;/sup&gt;,Zn&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;As&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;13&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Argentotennantite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Argentotennantite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Spiridonov E M, Sokolova N F, Gapeev A K, Dashevskaya D M, Evstigneeva T L, Chvileva T N, Demidov V G, Balashov E P, Shulga V I (1986) A new mineral - argentotennantite, Doklady Akademii Nauk SSSR 290, 206-210 Chemical formula revised: Moëlo Y, Makovicky E, Mozgova N N, Jambor J L, Cook N, Pring A, Paar W, Nickel E H, Graeser S, Karup-Møller S, Balic-Zunic T, Mumme W G, Vurro F, Topa D, Bindi L, Bente K, Shimizu M (2008) Sulfosalt systematics: a review. Report of the sulfosalt sub-committee of the IMA Commission on Ore Mineralogy, European Journal of Mineralogy 20, 7-46</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Tennantite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.GB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Neso-sulfarsenite with additional S</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Argentotennantite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1985-026</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/allochalcoselite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Allochalcoselite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Pb | O | Se | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;1+&lt;/sup&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;PbO&lt;sub&gt;2&lt;/sub&gt;(SeO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;Cl&lt;sub&gt;5&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2004-025</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-27596</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:27596:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-27596.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;1+&lt;/sup&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;Pb&lt;sup&gt;2+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;(Se&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;Cl&lt;sub&gt;5&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Allochalcoselite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Allochalcoselite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Vergasova L P, Krivovichev S V, Britvin S N, Fitatov S K, Berns P K, Ananyev V V (2005) Allochalcoselite, Cu&lt;sup&gt;+&lt;/sup&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;PbO&lt;sub&gt;2&lt;/sub&gt;(SeO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;Cl&lt;sub&gt;5&lt;/sub&gt; - a new mineral from volcanic exhalations (Kamchatka, Russia), Zapiski Rossiiskogo Mineralogicheskogo Obshchetstva 134(3), 70-74</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.JG.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Selenite with additional anions, without H2O</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://webmineral.com/data/Allochalcoselite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2004-025</gsmin:wikipediadate>
