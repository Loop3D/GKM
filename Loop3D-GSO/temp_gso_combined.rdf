    <gsmin:mindaturl>http://www.mindat.org/min-2547.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;4&lt;/sub&gt;[Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;8&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;]O&lt;sub&gt;4&lt;/sub&gt;[Si&lt;sub&gt;8&lt;/sub&gt;Be&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;36&lt;/sub&gt;]</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Makarochkinite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Makarochkinite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Grew E S, Barbier J, Britten J, Yates M G, Polyakov V O, Shcherbakova E P, Halenius U, Shearer C K (2005) Makarochkinite, Ca_2_Fe^2+^_4_Fe^3+^TiSi_4_BeAlO_20_, a new beryllosilicate member of the aenigmatite-sapphirine-surinamite group from the Il'men mountains (souther Urals), Russia, American Mineralogist 90, 1402-1412</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Sapphirine</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DH.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 4-periodic single chains, Si4O12</gsmin:strunzlabel>
