    <gsmin:rruffids>R060036 | R130537</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Wadeite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Wadeite</gsmin:rruffnameplain>
