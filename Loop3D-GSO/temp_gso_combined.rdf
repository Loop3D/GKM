    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;3&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Trimagnesium diarsenate octahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1931</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1931:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1931.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;3&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060724 | R070336</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hörnesite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hornesite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kenngott A (1860) Der Hörnesit, ein neues Mineral aus dem Banat, Jahrbuch der Kaiserlich-Königlichen Geologischen Reichsanstalt 11, 10-11</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Vivianite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CE.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With only medium-sized cations, RO4:H2O about 1:2.5</gsmin:strunzlabel>
