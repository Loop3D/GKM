    <gsmin:fleischersgroup xml:lang="en">dickinsonite</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaFe&lt;sup&gt;2+&lt;/sup&gt;(CaNa&lt;sub&gt;2&lt;/sub&gt;)Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;13&lt;/sub&gt;Al(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;11&lt;/sub&gt;(PO&lt;sub&gt;3&lt;/sub&gt;OH)(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
