  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Tephra">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Hallsworth and Knox 1999; LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Unconsolidated pyroclastic material in which greater than 75 percent of the fragments are deposited as a direct result of volcanic processes and the deposit has not been reworked by epiclastic processes. Includes ash, lapilli tephra, bomb tephra, block tephra and unconsolidated agglomerate.</rdfs:comment>
    <rdfs:label xml:lang="en">tephra</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Natural_Unconsolidated_Material"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Pyroclastic_Material"/>
  </rdf:Description>
