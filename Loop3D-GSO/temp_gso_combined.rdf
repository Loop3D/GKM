    <gsmin:mindatid>min-2354</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2354:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2354.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaFe&lt;sup&gt;3+&lt;/sup&gt;As&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Lazarenkoite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Lazarenkoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Yakhontova L K, Plosina I I (1981) The new mineral lazarenkoite, Mineralogiceskij Zhurnal 3, 92-96</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.JC.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Arsenite, antimonite, bismuthite; without additional anions, with H2O</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Lazarenkoite.shtml</gsmin:webmineralurl>
