    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;(BO&lt;sub&gt;3&lt;/sub&gt;)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1983-074</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2498</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2498:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2498.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;(BO&lt;sub&gt;3&lt;/sub&gt;)</gsmin:rruffchemistry>
    <gsmin:rruffids>R070223</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Magnesiohulsite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Magnesiohulsite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Yang G, Peng Z, Pan Z (1985) Magnesiohulsite - A new tin-rich borate mineral, Acta Mineralogica Sinica 5, 97-101</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hulsite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>06.AB.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Monoborate, BO3, with additional anions; 1(D) + OH, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Magnesiohulsite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1983-074</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/aurichalcite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Aurichalcite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Zn | Cu | C | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
