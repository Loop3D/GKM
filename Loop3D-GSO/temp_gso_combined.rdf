  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfault/Fault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">this vocabulary</dct:source>
    <rdfs:comment xml:lang="en">A discrete surface, or zone of discrete surfaces, with some thickness, separating two rock masses across which one mass has slid past the other and characterized by brittle deformation.</rdfs:comment>
    <rdfs:label xml:lang="en">Fault</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicstructure/Fracture"/>
    <rdfs:subClassOf rdf:nodeID="n487acc5da05049618fd9508bab26ad38b6"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/Event">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A event is the thing that happens (an earthquake), and a process is how it happens (the ground shaking). Events are constituted by processes.</rdfs:comment>
    <rdfs:label xml:lang="en">Event</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Perdurant"/>
    <rdfs:subClassOf rdf:nodeID="n7bda25761fc44f8595ef751309700190b43"/>
    <rdfs:subClassOf rdf:nodeID="n7bda25761fc44f8595ef751309700190b44"/>
    <rdfs:subClassOf rdf:nodeID="n7bda25761fc44f8595ef751309700190b45"/>
    <rdfs:subClassOf rdf:nodeID="n7bda25761fc44f8595ef751309700190b46"/>
    <rdfs:subClassOf rdf:nodeID="n7bda25761fc44f8595ef751309700190b47"/>
    <owl:disjointWith rdf:resource="https://w3id.org/gso/1.0/common/Process"/>
    <owl:disjointWith rdf:resource="https://w3id.org/gso/1.0/common/Time_Region"/>
    <owl:equivalentClass rdf:nodeID="n7bda25761fc44f8595ef751309700190b48"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/piemontite-sr">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Piemontite-(Sr)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Sr | Mn | Al | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">epidote</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/strontiopiemontite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaSr(Al&lt;sub&gt;2&lt;/sub&gt;Mn&lt;sup&gt;3+&lt;/sup&gt;)[Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;][SiO&lt;sub&gt;4&lt;/sub&gt;]O(OH)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1989-031</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:mindatid>min-3773</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3773:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3773.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaSrMn&lt;sup&gt;3+&lt;/sup&gt;Al&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)(SiO&lt;sub&gt;4&lt;/sub&gt;)O(OH)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Piemontite-(Sr)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Piemontite-(Sr)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named strontiopiemontite: Bonazzi P, Menchetti S, Palenzona A (1990) Strontiopiemontite, a new member of the epidote group, from Val Graveglia, Liguria, Italy, European Journal of Mineralogy 2, 519-523 Name changed: Armbruster T, Bonazzi P, Akasaka M, Bermanec V, Chopin C, Giere R, Huess-Assbichler S, Liebscher A, Menchetti S, Pan Y, Pasero M (2006) Recommended nomeclature of epidote-group minerals, European Journal of Mineralogy 18, 551-567 as Stontiopiemontite</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Epidote</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.BG.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate with mixed SiO4 and Si2O7 groups; cations in octahedral [6] and greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://webmineral.com/data/Piemontite-(Sr).shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1989-031</gsmin:wikipediadate>
  </rdf:Description>
