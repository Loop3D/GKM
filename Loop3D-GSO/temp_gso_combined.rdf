    <gsmin:imanumber xml:lang="en">IMA1998-019</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-7141</gsmin:mindatid>
