    <gsmin:statusnotes xml:lang="en">Nestola F, Cámara F, Chukanov N V, Atencio D, Coutinho J M V, Contreira R R, Färber G (2012) Witzkeite: A new rare nitrate-sulphate mineral from a guano deposit at Punta de Lobos, Chile, American Mineralogist 97, 1783-1787</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">sulfate, chromate, molybdate or tungstate</gsmin:strunzlabel>
    <gsmin:wikipediadate>2011-084</gsmin:wikipediadate>
