    <gsmin:rruffnameplain xml:lang="en">Clintonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mather W W (1843) Metamorphic rocks of the highlands, and of Saratoga and Washington counties, in Geology of New York Part 1. Comprising the Geology of the First Geological District, Carroll and Cook (Albany) 467-467</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Clay</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EC.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with mica sheets, composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Clintonite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1834</gsmin:wikipediadate>
