    <gsmin:rruffids>R060646</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Donpeacorite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Donpeacorite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Petersen E U, Anovitz L M, Essene E J (1984) Donpeacorite, (Mn,Mg)MgSi&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;, a new orthopyroxene and its proposed phase relations in the system MnSiO&lt;sub&gt;3&lt;/sub&gt; - MgSiO&lt;sub&gt;3&lt;/sub&gt; - FeSiO&lt;sub&gt;3&lt;/sub&gt;, American Mineralogist 69, 472-480</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Pyroxene</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DA.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 2-periodic single chains, Si2O6; pyroxene family</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Donpeacorite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1982-045</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/thadeuite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
