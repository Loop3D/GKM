    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Meridianiite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Meridianiite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Peterson R C, Nelson W, Madu B, Shurvell H F (2007) Meridianiite: A new mineral species observed on Earth and predicted to exist on Mars, American Mineralogist 92, 1756-1759</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.CB.90</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, with H2O, With only medium-sized cations</gsmin:strunzlabel>
