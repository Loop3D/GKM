    <gsmin:mindaturl>http://www.mindat.org/min-3143.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;9&lt;/sub&gt;[(P,S)O&lt;sub&gt;4&lt;/sub&gt;]&lt;sub&gt;8&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·28H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Peisleyite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Peisleyite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pilkington E S, Segnit E R, Watts J A (1982) Peisleyite, a new sodium aluminium sulphate phosphate, Mineralogical Magazine 46, 449-452 Dunn P J, Cabri L J, Clark A M, Fleischer M (1983) New mineral names, American Mineralogist 68, 849-852 Chemical formula and cell parameters are redefined: Mills S J, Ma C, Birch W D (2011) A contribution to understanding the complex nature of peisleyite, Mineralogical Magazine 75, 2733-2737</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.DO.15</gsmin:strunzcodeV10>
