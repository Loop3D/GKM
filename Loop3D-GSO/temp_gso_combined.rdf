    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3433:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3433.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;5&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060858 | R070594</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Rockbridgeite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Rockbridgeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Frondel C (1949) The dufrenite problem, American Mineralogist 34, 513-540</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Rockbridgeite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BC.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With only medium-sized cations, (OH, etc.):RO4 &gt; 1:1 and &lt; 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Rockbridgeite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1949</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/tschermigite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Tschermigite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>N | H | Al | S | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">alum</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/tschermigite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(NH&lt;sub&gt;4&lt;/sub&gt;)Al(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·12H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Ammonium aluminium disulfate dodecahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-4036</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4036:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4036.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">N&lt;sup&gt;3-&lt;/sup&gt;H&lt;sub&gt;4&lt;/sub&gt;Al(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·12H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R050276</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tschermigite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tschermigite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">von Kobel F (1858) Es sind in Salzsäure, einige auch in Wasser, ohne merklichen Rückstand auflöslich. Die Aufl. bildet keine Gallerte, in Tafeln zur Bestimmung der Mineralien mittelst einfacher chemischer Versuche auf trockenem und nassem Wege., Joseph Lindauer'sche Buchhandlung (München) 47-47</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Alum</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.CC.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, with H2O, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Tschermigite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1832</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/lindsleyite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Lindsleyite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ba | Sr | Zr | Ca | Fe | Mg | Ti | Cr | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">crichtonite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/lindsleyite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ba,Sr)(Zr,Ca)(Fe,Mg)&lt;sub&gt;2&lt;/sub&gt;(Ti,Cr,Fe)&lt;sub&gt;18&lt;/sub&gt;O&lt;sub&gt;38&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1982-086</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2407</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2407:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2407.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ba,Sr)(Zr&lt;sup&gt;4+&lt;/sup&gt;,Ca)(Fe&lt;sup&gt;3+&lt;/sup&gt;,Mg)&lt;sub&gt;2&lt;/sub&gt;(Ti&lt;sup&gt;4+&lt;/sup&gt;,Cr&lt;sup&gt;3+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;18&lt;/sub&gt;O&lt;sub&gt;38&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Lindsleyite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Lindsleyite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Haggerty S E, Smyth J R, Erlank A J, Rickard R S, Danchin R V (1983) Lindsleyite (Ba) and mathiasite (K): two new chromium-titanites in the crichtonite series from the upper mantle, American Mineralogist 68, 494-505</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Crichtonite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.CC.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 2: 3,3: 5, and similar, With large and medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Lindsleyite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1982-086</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/whelanite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Whelanite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Ca | Si | O | H | C</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;2&lt;/sub&gt;Ca&lt;sub&gt;6&lt;/sub&gt;[Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;17&lt;/sub&gt;(OH)](CO&lt;sub&gt;3&lt;/sub&gt;)(OH)&lt;sub&gt;3&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1977-006</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-11215</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:11215:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-11215.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Ca&lt;sub&gt;6&lt;/sub&gt;[Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;17&lt;/sub&gt;(OH)](CO&lt;sub&gt;3&lt;/sub&gt;)(OH)&lt;sub&gt;3&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R050323</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Whelanite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Whelanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf A R, Mills S J, Merlino S, Pasero M, McDonald A M, Wray W B, Hindman J R (2012) Whelanite, Cu&lt;sub&gt;2&lt;/sub&gt;Ca&lt;sub&gt;6&lt;/sub&gt;[Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;17&lt;/sub&gt;(OH)](CO&lt;sub&gt;3&lt;/sub&gt;)(OH)&lt;sub&gt;3&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;2&lt;/sub&gt;, an (old) new mineral from the Bawana mine, Milford, Utah, American Mineralogist 97, 2007-2015</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">silicate</gsmin:strunzlabel>
    <gsmin:wikipediadate>1977-006</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Tidal_Marsh">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al., 2005</dct:source>
    <rdfs:comment xml:lang="en">A marsh bordering a coast (as in a shallow lagoon or sheltered bay), formed of mud and of the resistant mat of roots of salt-tolerant plants, and regularly inundated during high tides, a marshy tidal flat.</rdfs:comment>
    <rdfs:label xml:lang="en">tidal marsh setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Swamp_Or_Marsh_Setting"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Tidal_Flat_Setting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/trippkeite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Trippkeite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | As | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">trippkeite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/trippkeite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;As&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4023</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4023:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4023.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;As&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Trippkeite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Trippkeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">vom Rath G (1880) Bespricht Tridymit aus Neuseeland, Diaspor vom Greiner und Trippkeït, ein neues Mineral aus Chili, Verhandlungen des Naturhistorischen Vereines der Preussischen Rheinlande und Westphalens 37, 207-212</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Trippkeite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.JA.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Arsenite, antimonite, bismuthite; without additional anions, without H2O</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Trippkeite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1880</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/bayerite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Bayerite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Al | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/bayerite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al(OH)&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Aluminium trihydroxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-580</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:580:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-580.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al(OH)&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bayerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Bayerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Fricke R (1928) Über das kristallinische tonerdehydrat v. Bonsdorff´s, Zeitschrift für Anorganische und Allgemeine Chemie 175, 249-256</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.FE.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Hydroxide (without V or U), Hydroxides with OH, without H2O; sheets of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Bayerite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1928</gsmin:wikipediadate>
  </rdf:Description>
