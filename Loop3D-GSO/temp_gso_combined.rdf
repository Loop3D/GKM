    <gsmin:mindaturl>http://www.mindat.org/min-2566.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na(Mn&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;7&lt;/sub&gt;Mn&lt;sup&gt;3+&lt;/sup&gt;)O&lt;sub&gt;16&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060379</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Manjiroite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Manjiroite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Nambu M, Tanida K (1967) Manjiroite, a new manganese dioxide mineral, from Kohare Mine, Iwate Prefecture, Japan, Journal of the Japanese Association of Mineralogists, Petrologists and Economic Geologists 58, 39-54 Chemical formula changed from Na(Mn^4+^,Mn^2+^)_8_O_16_·nH_2_O: Biagioni C, Capalbo C, Pasero M (2013) Nomenclature tunings in the hollandite supergroup. European Journal of Mineralogy 25, 85-90</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Coronadite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.DK.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With large (+- medium-sized) cations; tunnel structures</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Manjiroite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1966-009</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/miguelromeroite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
