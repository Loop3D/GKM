    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:11114:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-11114.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Fe&lt;sup&gt;2+&lt;/sup&gt;,Mg,Zn&lt;sup&gt;2+&lt;/sup&gt;,Al)&lt;sub&gt;3&lt;/sub&gt;(Al,Ti&lt;sup&gt;4+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;15&lt;/sub&gt;(OH)</gsmin:rruffchemistry>
    <gsmin:rruffids>R061017 | R070156</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ferrohögbomite-2N2S</gsmin:rruffnamehtml>
