    <gsmin:mindaturl>http://www.mindat.org/min-27382.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;(Pb&lt;sup&gt;2+&lt;/sup&gt;,La&lt;sup&gt;3+&lt;/sup&gt;,Nd&lt;sup&gt;3+&lt;/sup&gt;,Ce&lt;sup&gt;3+&lt;/sup&gt;,Ca)(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Plumboagardite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Plumboagardite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Walenta K, Theye T (2005) Plumboagardite, a new mineral of the mixite group from an occurrence in the Southern Black Forest, Neues Jahrbuch für Mineralogie, Abhandlungen 181, 219-224</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Mixite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DL.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 = 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Plumboagardite.shtml</gsmin:webmineralurl>
