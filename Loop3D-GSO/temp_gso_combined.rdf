    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/chapmanite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Sb&lt;sup&gt;3+&lt;/sup&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-970</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:970:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-970.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Sb&lt;sup&gt;3+&lt;/sup&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)</gsmin:rruffchemistry>
    <gsmin:rruffids>R060910</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Chapmanite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Chapmanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Walker T L (1924) Chapmanite, a new hydrous ferrous silicoantimonate, from South Lorrain, Ontario, Contributions to Canadian Mineralogy 17, 5-8</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.ED.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with kaolinite layers composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Chapmanite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1924</gsmin:wikipediadate>
  </rdf:Description>
