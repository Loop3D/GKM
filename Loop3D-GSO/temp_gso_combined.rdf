    <gsmin:statusnotes xml:lang="en">Mücke A (1988) Lehnerit Mn[UO_2_/PO_4_]_2_ 8H_2_O, ein neues mineral aus dem pegmatit von Hagendorf/Oberpfalz, Aufschluss 39, 209-217</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.EB.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl phosphate or arsenate, UO2:RO4 = 1:1</gsmin:strunzlabel>
