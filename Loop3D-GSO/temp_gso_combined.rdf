    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/calkinsitece.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ce&lt;sub&gt;2&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dicerium tricarbonate tetrahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-867</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:867:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-867.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ce&lt;sub&gt;2&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Calkinsite-(Ce)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Calkinsite-(Ce)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pecora W T, Kerr J H (1953) Burbankite and calkinsite, two new carbonate minerals from Montana, American Mineralogist 38, 1169-1183 Name changed from calkinsite: Nickel E H, Mandarino J A (1987) Procedures involving the IMA Commission on New Minerals and Mineral Names and guidelines on mineral nomenclature, American Mineralogist 72, 1031-1042</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.CC.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate without additional anions, with H2O, With rare earth elements (REE)</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Calkinsite-%28Ce%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1953</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/crawfordite">
