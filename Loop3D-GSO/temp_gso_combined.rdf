  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Carbonate_Sedimentary_Material">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">SLTTs 2004</dct:source>
    <rdfs:comment xml:lang="en">Sedimentary material in which at least 50 percent of the primary and/or recrystallized constituents are composed of one (or more) of the carbonate minerals calcite, aragonite and dolomite, in particles of intrabasinal origin.</rdfs:comment>
    <rdfs:comment xml:lang="en">Should carbonate sedimentary material be considered a kind of chemical sedimentary material? Is biogenic precipitation a chemical sedimentary process?</rdfs:comment>
    <rdfs:label xml:lang="en">carbonate sedimentary material</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Sedimentary_Material"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/jahnsite-camnfe">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Jahnsite-(CaMnFe)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Mn | Fe | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">jahnsite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/jahnsitecamnfe.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaMn&lt;sup&gt;2+&lt;/sup&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:mindatid>min-2066</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2066:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2066.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaMn&lt;sup&gt;2+&lt;/sup&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060310 | R070733</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Jahnsite-(CaMnFe)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Jahnsite-(CaMnFe)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Jahnsite group of minerals split into distinct species: Moore P B, Ito J (1978) I. Whiteite, a new species, and a proposed nomenclature for the jahnsite-whiteite complex series. II. New data on xanthoxenite. III. Salmonsite discredited, Mineralogical Magazine 42, 309-323</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Jahnsite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DH.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 &lt; 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Jahnsite-%28CaMnFe%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1978</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/douglasite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Douglasite</rdfs:label>
