    <rdfs:subClassOf rdf:nodeID="n037b213c2f8e4377846b28c96af009c4b4"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/aerinite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Aerinite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Na | Fe | Mg | Al | Si | O | H | C</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/aerinite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Na)&lt;sub&gt;6&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;,Fe&lt;sup&gt;2+&lt;/sup&gt;,Mg,Al)&lt;sub&gt;4&lt;/sub&gt;(Al,Mg)&lt;sub&gt;6&lt;/sub&gt;Si&lt;sub&gt;12&lt;/sub&gt;O&lt;sub&gt;36&lt;/sub&gt;(OH)&lt;sub&gt;12&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)·12H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:mindatid>min-34</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:34:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-34.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Na)&lt;sub&gt;6&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;,Fe&lt;sup&gt;2+&lt;/sup&gt;,Mg,Al)&lt;sub&gt;4&lt;/sub&gt;(Al,Mg)&lt;sub&gt;6&lt;/sub&gt;[Si&lt;sub&gt;12&lt;/sub&gt;O&lt;sub&gt;36&lt;/sub&gt;(OH)&lt;sub&gt;12&lt;/sub&gt;](CO&lt;sub&gt;3&lt;/sub&gt;)·12H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R050610</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Aerinite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Aerinite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">von Lasaulx A (1876) Aërinit, ein neues mineral, Neues Jahrbuch für Mineralogie 1876, 175, 352-358 Re-instated as a valid mineral: Azambre B, Monchoux P (1988) Précisions minéralogiques sur l'aérinite: nouvelle occurrence à Saint-Pandelon (Landes, France), Bulletin de Minéralogie 111, 39-47 Chemical formula redefined: Rius J, Elkaim E, Torrelles X (2004) Structure determination of the blue mineral pigment aerinite from synchrotron powder diffraction data: The solution of an old riddle, European Journal of Mineralogy 16, 127-134 Chemical formula redefined again: Rius J, Crespi A, Roig A, Melgarejo J C (2009) Crystal-structure refinement of Fe&lt;sup&gt;3+&lt;/sup&gt;-rich aerinite from synchrotron powder diffraction and Mössbauer data, European Journal of Mineralogy 21, 233-240</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.DB.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 2-periodic single chains, Si2O6; Pyroxene-related minerals</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Aerinite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1876</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/korobitsynite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
