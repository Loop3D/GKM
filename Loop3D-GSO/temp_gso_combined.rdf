    <gsmin:statusnotes xml:lang="en">Pekov, I.V., Koshlyakova, N.N., Belakovskiy, D.I., Vigasina, M.F., Zubkova, N.V., Agakhanov, A.A., Britvin, S.N., Sidorov, E.G. and Pushcharovsky, D.Y. (2018) Khrenovite, IMA 2017-105. CNMNC Newsletter No. 42, April 2018, page 448; Mineralogical Magazine, 82, 445–451</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Alluaudite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/thorneite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Thorneite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Te | O | C | Cl | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;6&lt;/sub&gt;(Te&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;)(CO&lt;sub&gt;3&lt;/sub&gt;)Cl&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2009-023</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-39558</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:39558:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-39558.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;(Te&lt;sup&gt;6+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;)(CO&lt;sub&gt;3&lt;/sub&gt;)Cl&lt;sup&gt;1-&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Thorneite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Thorneite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf A R, Housley R M, Marty J (2010) Lead-tellurium oxysalts from Otto Mountain near Baker, California: III. Thorneite, Pb6(Te6+2O10)(CO3)Cl2(H2O), the first mineral with edge-sharing octahedral tellurate dimers, American Mineralogist 95, 1548-1553</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">sulfate, chromate, molybdate or tungstate</gsmin:strunzlabel>
    <gsmin:wikipediadate>2009-023</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/camgasite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Camgasite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Mg | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/camgasite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaMg(AsO&lt;sub&gt;4&lt;/sub&gt;)(OH)·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1988-031</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Calcium magnesium arsenate hydroxyl pentahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-874</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:874:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-874.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaMgAs&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH)·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Camgasite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Camgasite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Walenta K, Dunn P J (1989) Camgasit, ein neues Calcium-Magnesiumarsenatmineral der Zusammensetzung CaMg(AsO&lt;sub&gt;4&lt;/sub&gt;)(OH)·5H&lt;sub&gt;2&lt;/sub&gt;O von Wittichen im mittleren Schwarzwald, Aufschluss 40, 369-372</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.DJ.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Camgasite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1988-031</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/fahleite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Fahleite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Zn | Fe | As | O | H</gsmin:chemistryelements>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/fahleite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaZn&lt;sub&gt;5&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;·14H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1982-061</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Calcium pentazinc diironIII hexaarsenate tetradecahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1436</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1436:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1436.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaZn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;·14H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fahleite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Fahleite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Medenbach O, Schmetzer K, Abraham K (1988) Fahleite from Tsumeb/Namibia, a new mineral belonging to the smolianinovite group, Neues Jahrbuch für Mineralogie, Monatshefte 1988, 167-171</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Smolyaninovite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CH.55</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With large and medium-sized cations, RO4:H2O &lt; 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Fahleite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1982-061</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/cafarsite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cafarsite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Na | Ti | Fe | As | O | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/cafarsite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Na,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)&lt;sub&gt;19&lt;/sub&gt;Ti&lt;sub&gt;8&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;(AsO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;28&lt;/sub&gt;F</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1965-036</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-849</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:849:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-849.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Na,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)&lt;sub&gt;19&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;8&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;(As&lt;sup&gt;3+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;28&lt;/sub&gt;F</gsmin:rruffchemistry>
    <gsmin:rruffids>R080118</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cafarsite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cafarsite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Graeser S (1966) Asbecasit und cafarsit, zwei neue mineralien aus dem Binnatal (Kt. Wallis), Schweizerische Mineralogische und Petrographische Mitteilungen 46, 367-375 Chemical formula revised from Ca_5.9_Mn_1.7_Fe_3_Ti_3_(AsO_3_)_12_·4-5H_2_O: Cametti G, Nagashima M, Fisch M, Armbruster T (2018) New data on cafarsite: reinvestigation of its crystal structure and chemical composition. European Journal of Mineralogy 30, 859-868</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.JC.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Arsenite, antimonite, bismuthite; without additional anions, with H2O</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Cafarsite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1965-036</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/manganolangbeinite">
