    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/spatiallyTouches"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/geology/isGeologicallyRelatedTo"/>
    <owl:inverseOf rdf:resource="https://w3id.org/gso/1.0/geologicrelation/underlies"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/andersonite">
