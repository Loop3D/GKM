  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/krohnkite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kröhnkite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Cu | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/krohnkite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;Cu(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Disodium copper disulfate dihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2277</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2277:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2277.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R050604 | R060111</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kröhnkite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Krohnkite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Domeyko I (1879) Kronnkit, in Mineralojía, Libreria Central de Servat I CA. (Santiago, Chile) 250-252</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Roselite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.CC.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, with H2O, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Krohnkite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1879</gsmin:wikipediadate>
  </rdf:Description>
