    <gsmin:mindaturl>http://www.mindat.org/min-1153.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sr(Mn&lt;sup&gt;2+&lt;/sup&gt;,Y&lt;sup&gt;3+&lt;/sup&gt;,U&lt;sup&gt;6+&lt;/sup&gt;)Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(Ti&lt;sup&gt;4+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;,Cr&lt;sup&gt;3+&lt;/sup&gt;,V&lt;sup&gt;5+&lt;/sup&gt;)&lt;sub&gt;18&lt;/sub&gt;(O,OH)&lt;sub&gt;38&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060314 | R090006</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Crichtonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Crichtonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally called craitonite: de Bournon J L (1814) Catalogue de la Collection Minéralogique du Comte de Bournon, The Monthly Review 73, 17-32 Name changed to crichtonite: British Museum (1814) Seventh Room (Case 42), in Synopsis of the Contents of the British Museum, Seventh Edition, Cox and Baylis (London) 47-49</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Crichtonite</gsmin:structuralgroup>
