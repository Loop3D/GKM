    <gsmin:rruffnameplain xml:lang="en">Farringtonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">DuFresne E R, Roy S K (1961) A new phosphate mineral from the Springwater pallasite, Geochimica et Cosmochimica Acta 24, 198-205</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.AB.05</gsmin:strunzcodeV10>
