    <gsmin:rruffids>R080096</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Chervetite</gsmin:rruffnamehtml>
