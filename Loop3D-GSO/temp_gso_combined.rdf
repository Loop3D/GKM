  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ferrowyllieite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ferrowyllieite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Mn | Fe | Al | P | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">wyllieite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/ferrowyllieite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,Ca,Mn&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Al(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Disodium diironII aluminium triphosphate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1536</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1536:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1536.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Al(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060178 | R160068</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ferrowyllieite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ferrowyllieite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Moore P B, Ito J (1973) Wyllieite, Na_2_Fe^2+^_2_Al(PO_4_)_3_, a new species. The Mineralogical Record 4, 131-136 Name changed from wyllieite to ferrowylleite: Moore P B, Ito J (1979) Alluaudites, wyllieites, arrojadites: crystal chemistry and nomenclature, Mineralogical Magazine 43, 227-235</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Alluaudite-Wyllieite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.AC.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, without H2O, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Ferrowyllieite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1979</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ferrierite-k">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ferrierite-K</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Na | Si | Al | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">zeolite-ferrierite series</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(K,Na)&lt;sub&gt;5&lt;/sub&gt;(Si&lt;sub&gt;31&lt;/sub&gt;Al&lt;sub&gt;5&lt;/sub&gt;)O&lt;sub&gt;72&lt;/sub&gt;·18H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-6930</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:6930:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-6930.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(K,Na)&lt;sub&gt;5&lt;/sub&gt;(Si&lt;sub&gt;31&lt;/sub&gt;Al&lt;sub&gt;5&lt;/sub&gt;)O&lt;sub&gt;72&lt;/sub&gt;·18H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R110200</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ferrierite-K</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ferrierite-K</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Described, but not named: Wise W S, Tschernich R W (1976) Chemical composition of ferrierite. American Mineralogist 61, 60-66 Named: Coombs D S, Alberti A, Armbruster T, Artioli G, Colella C, Galli E, Grice J D, Liebau F, Mandarino J A, Minato H, Nickel E H, Passaglia E, Peacor D R, Quartieri S, Rinaldi R, Ross M, Sheppard R A, Tillmanns E, Vezzalini G, (1997) Recommended nomenclature for zeolite minerals: report of the Subcommittee on Zeolites of the International Mineralogical Association, Commission on New Minerals and Mineral Names, The Canadian Mineralogist 35, 1571-1606</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.GD.50</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Zeolite family: Chains of 6-membered rings – tabular zeolites</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Ferrierite-K.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1997</gsmin:wikipediadate>
  </rdf:Description>
