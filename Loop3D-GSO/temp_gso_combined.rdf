    <gsmin:rruffnameplain xml:lang="en">Bromellite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Aminoff G (1925) Über berylliumoxyd als mineral und dessen kristallstruktur, Zeitschrift für Kristallographie 62, 113-122</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.AB.20</gsmin:strunzcodeV10>
