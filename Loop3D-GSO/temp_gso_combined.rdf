    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Meixnerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Meixnerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Koritnig S, Süsse P (1975) Meixnerit, Mg_6_Al_2_(OH)_18_·4H_2_O, ein neues magnesium-aluminium-hydroxid-mineral, Tschermaks Mineralogische und Petrographische Mitteilungen 22, 79-87</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hydrotalcite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.FL.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Hydroxide (without V or U), Hydroxides with H2O±(OH); sheets of edge-sharing octahedra</gsmin:strunzlabel>
