    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3533:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3533.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;4&lt;/sub&gt;Ca&lt;sub&gt;12&lt;/sub&gt;Al&lt;sub&gt;8&lt;/sub&gt;Si&lt;sub&gt;12&lt;/sub&gt;O&lt;sub&gt;46&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;,PO&lt;sub&gt;4&lt;/sub&gt;)(OH,H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;4&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;,Cl)</gsmin:rruffchemistry>
    <gsmin:rruffids>R070688</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sarcolite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Sarcolite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Vauquelin L N (1807) Analyse comparée de l'analcime de M. Hauy et de la sarcolite de M. Tompson, Annales du Muséum d'Histoire Naturelle 9, 241-250</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.EH.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Transitional structure between phyllosilicate and other silicate units</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Sarcolite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1807</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/chatkalite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Chatkalite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Fe | Sn | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/chatkalite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;6&lt;/sub&gt;FeSn&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;8&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1981-004</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Hexacopper iron ditin octasulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-973</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:973:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-973.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;1+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;Sn&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;8&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Chatkalite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Chatkalite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kovalenker V A, Evstigneeva T L, Malov V S, Vyalsov L N (1981) Chatkalite, Cu&lt;sub&gt;6&lt;/sub&gt;FeSn&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;8&lt;/sub&gt;, a new mineral, Mineralogiceskij Zhurnal 3, 79-86</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.CB.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide (M = S) with Zn, Fe, Cu, Ag, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Chatkalite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1981-004</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ferronigerite-2n1s">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ferronigerite-2N1S</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Al | Fe | Zn | Sn | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">nigerite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/ferronigerite2n1s.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Al,Fe,Zn)&lt;sub&gt;2&lt;/sub&gt;(Al,Sn)&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;11&lt;/sub&gt;(OH)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:mindatid>min-2903</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2903:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2903.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Al,Fe&lt;sup&gt;3+&lt;/sup&gt;,Zn&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;(Al,Sn&lt;sup&gt;4+&lt;/sup&gt;)&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;11&lt;/sub&gt;(OH)</gsmin:rruffchemistry>
    <gsmin:rruffids>R120083</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ferronigerite-2N1S</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ferronigerite-2N1S</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Designated nigerite: Jacobson R, Webb J S (1947) The occurrence of nigerite, a new tin mineral in quartz-sillimanite-rocks from Nigeria, Mineralogical Magazine 28, 118-128 Name changed to nigerite-6H: Bannister F A, Hey M H, Stadler H P (1947) Nigerite, a new tin mineral, Mineralogical Magazine 28, 129-136 Name changed to nigerite-6T because it is trigonal and not hexagonal: Nickel E H (1993) Standardization of polytype suffixes, The Canadian Mineralogist 31, 767-768 Renamed: Armbruster T (2002) Revised nomenclature of högbomite, nigerite, and taafeite minerals, European Journal of Mineralogy 14, 389-395</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Nigerite-Ferronigerite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.FC.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Hydroxide (without V or U), Hydroxides with OH, without H2O; corner-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Ferronigerite-2N1S.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1947</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/cordierite">
