  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/defernite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Defernite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | C | O | Si | H | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/defernite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;6&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;1.58&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;0.21&lt;/sub&gt;(OH)&lt;sub&gt;7&lt;/sub&gt;[Cl&lt;sub&gt;0.50&lt;/sub&gt;(OH)&lt;sub&gt;0.08&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;0.42&lt;/sub&gt;]</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1978-057</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1246</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1246:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1246.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;6&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;1.58&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;0.21&lt;/sub&gt;(OH)&lt;sub&gt;7&lt;/sub&gt;[Cl&lt;sub&gt;0.50&lt;/sub&gt;(OH)&lt;sub&gt;0.08&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;0.42&lt;/sub&gt;]</gsmin:rruffchemistry>
    <gsmin:rruffids>R060619</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Defernite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Defernite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Sarp H, Taner M F, Deferne J, Bizouard H, Liebich B W (1980) La defernite, Ca&lt;sub&gt;6&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH,Cl)&lt;sub&gt;8&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O, un nouveau carbonate de calcium chloro-hydroxylé, Bulletin de Minéralogie 103, 185-189 Chemical formula revised from Ca_6_(CO_3_,SiO_4_)_2_(OH)_7-8_: Armbruster T, Yang P, Liebich B W (1996) Mechanism of the SiO4 for CO3 substitution in defernite, Ca_6_(CO3)_1.58_(Si_2_O_7_)_0.21_(OH)_7_[Cl_0.50_(OH)_0.08_(H_2_O)_0.42_]: a single-crystal X-ray study at 100 K. American Mineralogist 81, 625-631</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.BA.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions, without H2O, With Cu, Co, Ni, Zn, Mg, Mn</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Defernite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1978-057</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kumtyubeite">
