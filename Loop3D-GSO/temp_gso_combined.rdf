  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/fizelyite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Fizélyite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ag | Pb | Sb | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/fizelyite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ag&lt;sub&gt;5&lt;/sub&gt;Pb&lt;sub&gt;14&lt;/sub&gt;Sb&lt;sub&gt;21&lt;/sub&gt;S&lt;sub&gt;48&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Pentasilver tetradecalead henicosaantimonide octatetracontasulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-1554</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1554:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1554.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ag&lt;sub&gt;5&lt;/sub&gt;Pb&lt;sub&gt;14&lt;/sub&gt;Sb&lt;sub&gt;21&lt;/sub&gt;S&lt;sub&gt;48&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060175 | R090068</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fizélyite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Fizelyite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">While first announced by Krenner in 1913, the mineral was formally described in this paper: Krenner J, Loczka J (1923) Fizélyit, egy új magyar ezüstérc, Matematikai és Természettudományi Értesitö 40, 18-19 Chemical formula revised: Moëlo Y, Makovicky E, Karup-Møller S (1984) New data on the minerals of the andorite series, Neues Jahrbuch für Mineralogie, Monatshefte 1984, 175-182</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Lillianite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.JB.40a</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">PbS type sulfosalt with Pb</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Fizelyite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1913</gsmin:wikipediadate>
  </rdf:Description>
