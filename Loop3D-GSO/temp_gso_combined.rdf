    <gsmin:rruffnameplain xml:lang="en">Cornetite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Described without name: Cesàro G (1912) Sur un nouveau mineral du Katanga, Annales de la Société Géologique de Belgique 39, B241-B242 Buttgenbach H (1916) Cornètite, in Les Minéraux et les Roches, Liège 452-453</gsmin:statusnotes>
