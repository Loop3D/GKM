    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2454:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2454.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;(BO&lt;sub&gt;3&lt;/sub&gt;)</gsmin:rruffchemistry>
    <gsmin:rruffids>R060010 | R060844</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ludwigite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ludwigite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Tschermak G (1874) Ludwigit, ein neues mineral aus dem Banate, Mineralogische Mittheilungen 1874, 59-66</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Ludwigite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>06.AB.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Monoborate, BO3, with additional anions; 1(D) + OH, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Ludwigite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1874</gsmin:wikipediadate>
