    <gsmin:statusnotes xml:lang="en">Holtstam D, Bindi L, Hålenius U, Kolitsch U, Mansfeld J (2017) Ulfanderssonite-(Ce), a new Cl-bearing REE silicate mineral species from the Malmkärra mine, Norberg, Sweden. European Journal of Mineralogy 29, 1015-1026</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/greenalite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
