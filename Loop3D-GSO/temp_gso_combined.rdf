    <gsmin:mindaturl>http://www.mindat.org/min-26262.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;(U&lt;sup&gt;4+&lt;/sup&gt;,U&lt;sup&gt;6+&lt;/sup&gt;)Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(Ti&lt;sup&gt;4+&lt;/sup&gt;,Fe&lt;sup&gt;2+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;18&lt;/sub&gt;(O,OH)&lt;sub&gt;38&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R061019</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cleusonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cleusonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Wülser P A, Meisser N, Brugger J, Schenk K, Ansermet S, Bonin M, Bussy F (2005) Cleusonite, (Pb,Sr)(U&lt;sup&gt;4+&lt;/sup&gt;,U&lt;sup&gt;6+&lt;/sup&gt;)(Fe&lt;sup&gt;2+&lt;/sup&gt;,Zn)&lt;sub&gt;2&lt;/sub&gt;(Ti,Fe&lt;sup&gt;2+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;18&lt;/sub&gt;(O,OH)&lt;sub&gt;38&lt;/sub&gt;, a new mineral species of the crichtonite group from the western Swiss Alps, European Journal of Mineralogy 17, 933-942</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Crichtonite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.CC.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 2: 3,3: 5, and similar, With large and medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://webmineral.com/data/Cleusonite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1998-070</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/zinkosite">
