    <gsmin:statusnotes xml:lang="en">Williams S A (1973) Heyite, Pb_5_Fe_2_(VO_4_)_2_O_4_, a new mineral from Nevada, Mineralogical Magazine 39, 65-68</gsmin:statusnotes>
