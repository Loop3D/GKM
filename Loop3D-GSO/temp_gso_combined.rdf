    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(K,Na,Ca)&lt;sub&gt;7.5&lt;/sub&gt;(Mn,Mg)&lt;sub&gt;49&lt;/sub&gt;Si&lt;sub&gt;72&lt;/sub&gt;O&lt;sub&gt;168&lt;/sub&gt;(OH)&lt;sub&gt;50&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
