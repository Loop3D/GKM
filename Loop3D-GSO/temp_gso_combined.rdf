    <gsmin:chemistryelements>Ag | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/acanthite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ag&lt;sub&gt;2&lt;/sub&gt;S</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Grandfathered</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Disilver sulfide</gsmin:iupacchemname>
