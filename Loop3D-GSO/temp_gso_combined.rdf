    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ag&lt;sup&gt;1+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Zn&lt;sup&gt;2+&lt;/sup&gt;Sn&lt;sup&gt;4+&lt;/sup&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R061016</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pirquitasite</gsmin:rruffnamehtml>
