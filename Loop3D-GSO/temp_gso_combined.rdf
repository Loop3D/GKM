    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Jennite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Jennite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Carpenter A B, Chalmers R A, Gard J A, Speakman K, Taylor H F W (1966) Jennite, a new mineral, American Mineralogist 51, 56-74 Chemical formula changed from Na_2_Ca_8_Si_5_O_30_H_22_: Gard J A, Taylor H F W, Cliff G, Lorimer G W (1977) A reexamination of jennite. American Mineralogist 62, 365-368 Chemical formula changed from Ca_9_Si_6_O_16_(OH)_10_·6H_2_O: Bonaccorsi E, Merlino S, Taylor H F W (2004) The crystal structure of jennite, Ca_9_Si_6_O_18_(OH)_6_·8H_2_O. Cement and Concrete Research 34, 1481-1488</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.DG.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 3-periodic single and multiple chains</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Jennite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1965-021</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/natropharmacoalumite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Natropharmacoalumite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Al | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaAl&lt;sub&gt;4&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2010-009</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-40144</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:40144:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-40144.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaAl&lt;sub&gt;4&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Natropharmacoalumite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Natropharmacoalumite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Rumsey M S, Mills S J, Spratt J (2010) Natropharmacoalumite, NaAl4[(OH)4(AsO4)3]·4H2O, a new mineral of the pharmacosiderite supergroup and the renaming of aluminopharmacosiderite to pharmacoalumite, Mineralogical Magazine 74, 929-936 Piilonen P C, Rowe R, Poirier G, Tait K T (2011) New mineral names, American Mineralogist 96, 1654-1661</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Pharmacosiderite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DK.12</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 &gt; 1:1 and &lt; 2:1</gsmin:strunzlabel>
    <gsmin:wikipediadate>2010-009</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/vigezzite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Vigezzite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Ce | Nb | Ta | Ti | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">aeschynite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/vigezzite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Ce)(Nb,Ta,Ti)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1977-008</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4177</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4177:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4177.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Ce&lt;sup&gt;3+&lt;/sup&gt;)(Nb&lt;sup&gt;5+&lt;/sup&gt;,Ta&lt;sup&gt;5+&lt;/sup&gt;,Ti&lt;sup&gt;4+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060584 | R120132</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Vigezzite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Vigezzite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Graeser S, Schwander H, Hänni, Mattiolo V (1979) Vigezzite, (Ca,Ce)(Nb,Ta,Ti)_2_O_6_, a new aeschynite-type mineral from the Alps, Mineralogical Magazine 43, 459-462</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Aeschynite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.DF.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With large (+- medium-sized) cations; dimers and trimers of edgesharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Vigezzite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1977-008</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/arrojadite-bana">
