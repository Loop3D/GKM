    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;6&lt;/sub&gt;Al(SO&lt;sub&gt;4&lt;/sub&gt;)(OH)&lt;sub&gt;12&lt;/sub&gt;Cl·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Hexacopper aluminium sulfate docecahydroxyl chloride trihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-3721</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3721:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3721.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;AlS&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;12&lt;/sub&gt;Cl·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060135 | R080023</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Spangolite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Spangolite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Penfield S L (1890) On spangolite, a new copper mineral, American Journal of Science 39, 370-378</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Spangolite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.DD.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With only medium-sized cations; sheets of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Spangolite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1890</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/telluronevskite">
