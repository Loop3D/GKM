    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:32197:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-32197.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">[Na(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;2.5&lt;/sub&gt;][Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;8&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;(OH)&lt;sub&gt;7&lt;/sub&gt;]·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R130084</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Meurigite-Na</gsmin:rruffnamehtml>
