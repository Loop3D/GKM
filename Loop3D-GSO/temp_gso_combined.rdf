  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/anthoinite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Anthoinite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Al | W | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/anthoinite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">AlWO&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-252</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:252:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-252.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">AlW&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070025</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Anthoinite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Anthoinite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Varlamoff N (1947) Anthoinite, nouveau tungstate hydraté d'alumine, Annales de la Société Géologique de Belgique 70, B153-B166</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Anthoinite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.GB.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Molybdate, Wolframate or Niobate, With additional anions and/or H2O</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Anthoinite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1947</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/perthite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">An intergrowth of albite or oligoclase with a microcline host, occasionally also with a orthoclase host. The intergrowths or exsolution lamellae of the albite are visible as white lines coursing through the K feldspar groundmass.</rdfs:comment>
    <rdfs:label xml:lang="en">Perthite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/mineral/alkali_feldspar"/>
    <gsmin:mindatid>min-6683</gsmin:mindatid>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/achyrophanite">
