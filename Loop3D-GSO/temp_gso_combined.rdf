  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/sulphotsumoite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Sulphotsumoite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Bi | Te | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">tetradymite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/sulphotsumoite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bi&lt;sub&gt;3&lt;/sub&gt;Te&lt;sub&gt;2&lt;/sub&gt;S</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1980-084</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Tribismuth ditelluride sulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-3825</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3825:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3825.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bi&lt;sub&gt;3&lt;/sub&gt;Te&lt;sub&gt;2&lt;/sub&gt;S</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sulphotsumoite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Sulphotsumoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Zav´yalov E N, Begizov V D (1982) Sulphotsumoite, Bi3Te2S, a new bismuth mineral, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 111, issue 3, 316-320</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Tetradymite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.DC.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide (M:S variable)</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Sulphotsumoite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1980-084</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/franklinphilite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Franklinphilite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Na | Mn | Mg | Zn | Si | Al | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/franklinphilite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(K,Na)&lt;sub&gt;4&lt;/sub&gt;(Mn&lt;sup&gt;2+&lt;/sup&gt;,Mg,Zn)&lt;sub&gt;48&lt;/sub&gt;(Si,Al)&lt;sub&gt;72&lt;/sub&gt;(O,OH)&lt;sub&gt;216&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1990-050</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1599</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1599:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1599.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(K,Na)&lt;sub&gt;4&lt;/sub&gt;(Mn&lt;sup&gt;2+&lt;/sup&gt;,Mg,Zn&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;48&lt;/sub&gt;(Si,Al)&lt;sub&gt;72&lt;/sub&gt;(O,OH)&lt;sub&gt;216&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Franklinphilite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Franklinphilite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Dunn P J, Peacor D R, Su S C (1992) Franklinphilite, the manganese analog of stilpnomelane, from Franklin, New Jersey, The Mineralogical Record 23, 465-468</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Stilpnomelane</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EG.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate: Double nets with 6-membered and larger rings</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Franklinphilite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1990-050</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/rutile">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Rutile</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ti | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">rutile</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/rutile.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">TiO&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: TitaniumIV oxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-3486</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3486:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3486.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ti&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R040049 | R050031 | R050417 | R060493 | R060745 | R110109 | R120008</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Rutile</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Rutile</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Known previously, but named rutile by Werner: Lampadius W A (1800) Noch ein Paar Bemertungen über den Uran- und Titangehalt einiger Fossilien. Der rothe schörl (Rutil, nach herrn Bergrath Werner), in Sammlung practisch-chemischer Abhandlungen und vermischter Bemerkungen, Volume 3, Walther (Dresden)</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Rutile</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.DB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With medium-sized cations; chains of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Rutile.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1800</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologiclineation/intersection_lineation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al 2005, CGI lineationtype SKOS vocabulary 2016-11-21</dct:source>
