    <gsmin:chemistryelements>K | Si | Al | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic, orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">zeolite-phillipsite series</gsmin:fleischersgroup>
