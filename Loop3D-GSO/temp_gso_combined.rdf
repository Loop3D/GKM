    <gsmin:chemistryelements>Na | U | O | S | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;7&lt;/sub&gt;(UO&lt;sub&gt;2&lt;/sub&gt;)(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(SO&lt;sub&gt;3&lt;/sub&gt;OH)(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
