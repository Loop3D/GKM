  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/tsaregorodtsevite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Tsaregorodtsevite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>N | C | H | Si | Al | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">cancrinite-sodalite-sodalite subgroup</gsmin:fleischersgroup>
