    <gsmin:imanumber xml:lang="en">IMA1983-019</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Pentazinc dichloride octahydroxide monohydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-3668</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3668:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3668.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;(OH)&lt;sub&gt;8&lt;/sub&gt;Cl&lt;sup&gt;1-&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R130117 | R130616</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Simonkolleite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Simonkolleite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Schmetzer K, Schnorrer-Köhler G, Medenbach O (1985) Wülfingite, e-Zn(OH)_2_, and simonkolleite, Zn_5_(OH)_8_Cl_2_·H_2_O, two new minerals from Richelsdorf, Hesse, F.R.G., Neues Jahrbuch für Mineralogie, Monatshefte 1985, 145-154</gsmin:statusnotes>
    <gsmin:strunzcodeV10>03.DA.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Double-, Oxy- or Hydroxy- halide with Cu, etc., without Pb</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Simonkolleite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1983-019</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Biological_Process">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Biological Process</rdfs:label>
