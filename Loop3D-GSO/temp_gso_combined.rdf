    <gsmin:imanumber xml:lang="en">IMA2014-050</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Ca&lt;sub&gt;2&lt;/sub&gt;[Si&lt;sub&gt;8&lt;/sub&gt;B&lt;sub&gt;2&lt;/sub&gt;(Si,B)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;28&lt;/sub&gt;]F</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Khvorovite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Khvorovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pautov L A, Agakhanov A A, Sokolova E, Hawthorne F C, Karpenko V Y, Siidra O I, Garanin V K, Abdu Y A (2015) Khvorovite, Pb^2+^_4_Ca_2_[Si_8_B_2_(SiB)O_28_]F, a new hyalotekite-group mineral from the Darai-Pioz alkaline massif, Tajikistan: description and crystal structure. Mineralogical Magazine 79, 949-963</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hyalotekite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/mariinskite">
