  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/leucophoenicite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Leucophoenicite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">humite-reinhardbraunsite subgroup</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/leucophoenicite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;7&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: HeptamanganeseII trinesosilicate dihydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-2384</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2384:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2384.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;7&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060308 | R150131</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Leucophoenicite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Leucophoenicite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Penfield S L, Warren C H (1899) Some new minerals from the zinc mines at Franklin, N.J., and note concerning the chemical composition of ganomalite, American Journal of Science 8, 339-353</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Humite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AF.60</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with additional anions; cations in [4], [5] and/or only [6] coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Leucophoenicite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1899</gsmin:wikipediadate>
  </rdf:Description>
