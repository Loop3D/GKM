    <gsmin:imanumber xml:lang="en">IMA1984-029</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3191</gsmin:mindatid>
