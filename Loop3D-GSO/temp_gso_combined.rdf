  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/dolerophanite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Dolerophanite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | O | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/dolerophanite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;2&lt;/sub&gt;O(SO&lt;sub&gt;4&lt;/sub&gt;)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1302</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1302:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1302.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;OS&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060139 | R070652</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Dolerophanite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Dolerophanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named dolerofano: Scacchi A (1873) Nuove specie di solfati di rame, Atti Dell'Accademia delle Scienze Fisiche e Matematiche 5, 22-29</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Natrochalcite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.BB.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions, without H2O, With medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Dolerophanite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1873</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/eliseevite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
