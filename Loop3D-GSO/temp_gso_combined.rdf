    <gsmin:mindaturl>http://www.mindat.org/min-6909.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KAlMg&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;)O&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R100078</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Eastonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Eastonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Winchell A N (1925) Studies in the mica group - Part 1, American Journal of Science 9, 309-327 Discredited: Livi K J T, Veblen D R (1987) “Eastonite” from Easton, Pennsylvania: A mixture of phlogopite and a new form of serpentine, American Mineralogist 72, 113-125 Redefined: Rieder M, Cavazzini G, D’Yakonov Y S, Frank-Kamenetskii V A, Gottardt G, Guggenheim S, Koval P V, Muller G, Neiva A M R, Radoslovich E W, Robert J L, Sassi F P, Takeda H, Weiss Z, Wones D R (1998) Nomenclature of the micas, The Canadian Mineralogist 36, 905-912</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Mica</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EC.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with mica sheets, composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Eastonite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1925</gsmin:wikipediadate>
