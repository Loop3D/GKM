  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfeature/Stratotype">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">based on Salvador 1994 (International Stratigraphic Guide: Int. Union Geo. Sciences and Geol. Soc. Am.), p.26, as repored in Neuendorf et al., 2005.</dct:source>
    <rdfs:comment xml:lang="en">a specific interval or point in a specific sequence of rock stata that constitues the reference standard  defining a stratigrphic unit or boundary</rdfs:comment>
    <rdfs:label xml:lang="en">Stratotype</rdfs:label>
