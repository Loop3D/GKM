    <gsmin:mindatid>min-42495</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:42495:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-42495.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sm&lt;sup&gt;3+&lt;/sup&gt;Al&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Florencite-(Sm)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Florencite-(Sm)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Repina S A, Popova V I, Churin E I, Belogub E V, Chiller V V (2010) Florencite-(Sm), (Sm,Nd)Al&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt; - a new mineral of alunite-jarosite group from the Subpolar Urals, Zapiski Rossiiskogo Mineralogicheskogo Obshchetstva 139(4), 16-25</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Alunite-crandallite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BL.13</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH, etc.):RO4 = 3:1</gsmin:strunzlabel>
    <gsmin:wikipediadate>2009-074</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/arisite-ce">
