    <gsmin:chemistryelements>Ca | C | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/ikaite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca(CO&lt;sub&gt;3&lt;/sub&gt;)·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1962-005</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Calcium carbonate hexahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2007</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2007:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2007.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaCO&lt;sub&gt;3&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ikaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ikaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pauly H (1963) Ikaite, nyt mineral der danner skaer, Naturens Verdens 1963, 168-192</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.CB.25</gsmin:strunzcodeV10>
