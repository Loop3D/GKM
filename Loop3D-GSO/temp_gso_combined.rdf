  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ohmilite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ohmilite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Sr | Ti | Fe | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/ohmilite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sr&lt;sub&gt;3&lt;/sub&gt;(Ti,Fe&lt;sup&gt;3+&lt;/sup&gt;)(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(O,OH)·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1974-031</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2963</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2963:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2963.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sr&lt;sub&gt;3&lt;/sub&gt;(Ti&lt;sup&gt;4+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;)(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(O,OH)·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ohmilite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ohmilite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Komatsu M, Chihara K, Mizota T (1973) A new strontium-titanium hydrous silicate mineral from Ohmi, Niigata Prefecture, Central Japan, Mineralogical Journal 7, 298-301 Chemical formula revised: Mizota T, Komatsu M, Chihara K (1983) A refinement of the crystal structure of ohmilite, Sr3(Ti,Fe3+)(O,OH)(Si2O6)2 · 2–3H2O, American Mineralogist 68, 811-817</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.DH.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 4-periodic single chains, Si4O12</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Ohmilite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1974-031</gsmin:wikipediadate>
  </rdf:Description>
