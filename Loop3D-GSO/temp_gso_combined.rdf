    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1222:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1222.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CuPtAsS&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Daomanite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Daomanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Yu T H, Lin S J, Chao P, Fang C S, Huang C S (1974) A preliminary study of some new minerals of the platinum group and another associated new one in platinum-bearing intrusions in a region in China, Acta Geologica Sinica 2, 202-218</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.LA.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Other sulfosalt without essential Pb</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Daomanite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1974</gsmin:wikipediadate>
