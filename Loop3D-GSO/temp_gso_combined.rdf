    <gsmin:imanumber xml:lang="en">IMA1983-005</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: ManganeseII ditantalum hexaoxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-2523</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2523:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2523.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;Ta&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tapiolite-(Mn)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tapiolite-(Mn)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named manganotapiolite when Fe and Mn end-members were distinguished in tapiolite: Lahti S I, Johanson B, Virkkunen M (1983) Contributions to the chemistry of tapiolite - manganotapiolite, a new mineral, Bulletin of the Geological Society of Finland 55, 101-109 Name changed from manganotapiolite: Burke E A J (2008) Tidying up mineral names: an IMA-CNMNC scheme for suffixes, hyphens and diacritical marks, The Mineralogical Record 39, 131-135</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Tapiolite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.DB.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With medium-sized cations; chains of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Manganotapiolite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1983-005</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/tellurium">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Tellurium</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Te</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/tellurium.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Te</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3906</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3906:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3906.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Te</gsmin:rruffchemistry>
    <gsmin:rruffids>R060136 | R070376</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tellurium</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tellurium</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Tellurium was discovered in gold ores by Muller, the chief inspector of mines in Trannsylvania in 1782. However it was named by Klaproth, who isolated it in 1798 while continuing Muller's work: Klaproth M H (1802) Chemische Untersuchung der Siebenbürgischen Golderze, Beiträge zur Chemischen Kenntniss der Mineralkörper 3, 1-34</gsmin:statusnotes>
    <gsmin:strunzcodeV10>01.CC.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfur-selenium-iodine family</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Tellurium.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1782</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/okruschite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
