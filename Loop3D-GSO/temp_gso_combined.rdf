    <gsmin:rruffids>R060233</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ardealite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ardealite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Schadler J (1932) Ardealite, ein neues mineral, CaHPO&lt;sub&gt;4&lt;/sub&gt;·CaSO&lt;sub&gt;4&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O, Centralblatt fur Mineralogie, Geologie und Palaontologie 2, 40-41</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Gypsum</gsmin:structuralgroup>
