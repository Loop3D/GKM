    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KNa&lt;sub&gt;2&lt;/sub&gt;(Al&lt;sub&gt;5&lt;/sub&gt;Mg&lt;sub&gt;2&lt;/sub&gt;)[B&lt;sub&gt;12&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;(OH)&lt;sub&gt;12&lt;/sub&gt;](OH)&lt;sub&gt;6&lt;/sub&gt;Cl&lt;sub&gt;4&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1967-023</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3541</gsmin:mindatid>
