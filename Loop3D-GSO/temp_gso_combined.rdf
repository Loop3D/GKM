    <gsmin:strunzlabel xml:lang="en">Sulfide or sulfosalt alloy of metalloids with PGE</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Miessiite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2006-013</gsmin:wikipediadate>
  </rdf:Description>
