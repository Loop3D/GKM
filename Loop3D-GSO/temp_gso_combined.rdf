    <gsmin:rruffnameplain xml:lang="en">Gormanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Sturman B D, Mandarino J A, Mrose M E, Dunn P J (1981) Gormanite, Fe^2+^_3_Al_4_(PO_4_)_4_(OH_6_)·2H_2_O, the ferrous analogue of souzalite, and new data for souzalite, The Canadian Mineralogist 19, 381-387</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Souzalite</gsmin:structuralgroup>
