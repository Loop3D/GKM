  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Paragneiss">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">This vocabulary</dct:source>
    <rdfs:comment xml:lang="en">A gneiss with mineralogy and texture indicating derivation from a sedimentary rock protolith. Typically consists of abundant quartz, mica, or calcsilicate minerals; aluminosilicate minerals or garnet commonly present. composition of rock tends to be more variable on a decimetric scale that in orthogneiss.</rdfs:comment>
    <rdfs:label xml:lang="en">paragneiss</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Gneiss"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb26e920196f4af8bbd263b193e6f242b980">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/common/Time_Instant_Location"/>
    <gsoc:hasStaticValue rdf:nodeID="ndb26e920196f4af8bbd263b193e6f242b981"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/haapalaite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Haapalaite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Fe | Ni | S | Mg | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">valleriite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/haapalaite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">2[(Fe,Ni)S]·1.61[(Mg,Fe)(OH)&lt;sub&gt;2&lt;/sub&gt;]</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1972-021</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1788</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1788:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1788.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">2[(Fe&lt;sup&gt;2+&lt;/sup&gt;,Ni&lt;sup&gt;2+&lt;/sup&gt;)S&lt;sup&gt;2-&lt;/sup&gt;]·1.61[(Mg,Fe&lt;sup&gt;2+&lt;/sup&gt;)(OH)&lt;sub&gt;2&lt;/sub&gt;]</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Haapalaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Haapalaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Muhma M, Vuorelainen Y, Häkli T A, Papunen H (1973) Haapalaite, a new nickel-iron sulphide of the valleriite type from East Finland, Bulletin of the Geological Society of Finland 45, 103-106</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Valleriite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.FD.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Other sulfide with O, OH, H2O</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Haapalaite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1972-021</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/romerite">
