    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Y&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;[(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;2&lt;/sub&gt;&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;]Ti&lt;sup&gt;4+&lt;/sup&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Batievaite-(Y)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Batievaite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Lyalina L M, Zolotarev A A, Selivanova E A, Savchenko Y E, Krivovichev S V, Mikhailova Y A, Kadyrova G I, Zozulya D R (2016) Batievaite-(Y), Y_2_Ca_2_Ti[Si_2_O_7_]_2_(OH)_2_(H_2_O)_4_, a new mineral from nepheline syenite pegmatite in the Sakharjok massif, Kola Peninsula, Russia. Mineralogy and Petrology 110, 895-904</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Seidozerite-Rinkite</gsmin:structuralgroup>
  </rdf:Description>
