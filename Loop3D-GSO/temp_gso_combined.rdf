    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1589:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1589.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(V&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070159</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Francevillite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Francevillite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Branche G, Ropert M E, Chantret F, Morignat B, Pouget R (1957) La francevillite, nouveau minéral uranifère, Comptes Rendus Hebdomadaires des Séances de l’Académie des Sciences 245, 89-91</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Fritzscheite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.HB.15</gsmin:strunzcodeV10>
