    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;2&lt;/sub&gt;Mn&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;5&lt;/sub&gt;(CrO&lt;sub&gt;4&lt;/sub&gt;)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2011-051</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-42233</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:42233:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-42233.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Mn&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;5&lt;/sub&gt;(Cr&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Reynoldsite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Reynoldsite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf A R, Mills S J, Housley R M, Bottrill R S, Kolitsch U (2012) Reynoldsite, Pb&lt;sub&gt;2&lt;/sub&gt;Mn&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;5&lt;/sub&gt;(CrO&lt;sub&gt;4&lt;/sub&gt;), a new phyllomanganate-chromate from the Blue Bell claims, California and the Red Lead mine, Tasmania, American Mineralogist 97, 1187-1192</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">sulfate, chromate, molybdate or tungstate</gsmin:strunzlabel>
    <gsmin:wikipediadate>2011-051</gsmin:wikipediadate>
