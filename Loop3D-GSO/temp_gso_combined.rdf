    <gsmin:rruffids>R070460</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Euchlorine</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Euchlorine</gsmin:rruffnameplain>
