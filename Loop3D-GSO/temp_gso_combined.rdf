    <gsmin:iupacchemname xml:lang="en">IUPAC: Copper tetraaluminium sulfate dodecahydroxyl trihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-961</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:961:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-961.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;Al&lt;sub&gt;4&lt;/sub&gt;S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;12&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060752</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Chalcoalumite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Chalcoalumite</gsmin:rruffnameplain>
