    <gsmin:chemistryelements>Ca | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/nekoite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;3&lt;/sub&gt;Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;15&lt;/sub&gt;·7H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2872</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2872:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2872.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;3&lt;/sub&gt;Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;15&lt;/sub&gt;·7H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070475</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nekoite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Nekoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Gard J A, Taylor H F W (1956) Okenite and nekoite (a new mineral), Mineralogical Magazine 31, 5-20 Fleischer M (1956) New mineral names, American Mineralogist 41, 958-960</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.EA.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate: Single nets of tetrahedra with 4-, 5-, (6-), and 8-membered rings</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Nekoite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1956</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/sinnerite">
