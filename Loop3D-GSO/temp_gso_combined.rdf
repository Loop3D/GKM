    <gsmin:imanumber xml:lang="en">IMA1983-029</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Lead tetracopper disulfate hexahydroxyl trihydrate</gsmin:iupacchemname>
