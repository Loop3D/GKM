    <gsmin:rruffids>R050060 | R050100 | R050316</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Augelite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Augelite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Blomstrand C W (1868) Om Westanå mineralier, Öfversigt af Kongliga Vetenskaps-Akademiens Förhandlingar 25, 197-212</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.BE.05</gsmin:strunzcodeV10>
