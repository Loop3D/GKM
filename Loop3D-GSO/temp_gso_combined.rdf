    <gsmin:rruffnameplain xml:lang="en">Hyttsjoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Grew E S, Peacor D R, Rouse R C, Yates M C, Su S-C, Marquez N (1996) Hyttsjöite, a new, complex layered plumbosilicate with unique tetrahedral sheets from Långban, Sweden, American Mineralogist 81, 743-753</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.EG.60</gsmin:strunzcodeV10>
