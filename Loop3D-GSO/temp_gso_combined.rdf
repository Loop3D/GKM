    <gsmin:chemistryelements>Mn | Zn | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">mooreite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/lawsonbauerite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;9&lt;/sub&gt;Zn&lt;sub&gt;4&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;22&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1979-004</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
