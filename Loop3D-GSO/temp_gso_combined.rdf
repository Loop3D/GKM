    <gsmin:rruffids>R040181 | R050532</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Olivenite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Olivenite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hoffmann C A S (1789) Mineralsystem des Herrn Inspektor Werners mit dessen erlaubnis herausgegeben von C A S Hoffmann. 127) Olivenerz, Bergmannisches Journal 1, 369-398 Jameson R (1820) Olivenite, in A System of Mineralogy Volume II, Archibald Constable and Co. (Edinburgh) 331-346</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Andalusite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BB.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With only medium-sized cations, (OH, etc.):RO4 about 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Olivenite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>0</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/Gas">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Gas is a state of matter that has no fixed shape and no fixed volume. Gases have lower density than other states of matter, such as solids and liquids. There is a great deal of empty space between particles, which have a lot of kinetic energy. The particles move very fast and collide into one another, causing them to diffuse, or spread out, until they are evenly distributed throughout the volume of the container.  (https://www.livescience.com/53304-gases.html)</rdfs:comment>
    <rdfs:label xml:lang="en">Gas state of matter</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Fluid"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseWuliuanSP2020">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologiccontact/GSSP"/>
    <dct:source>Episodes 42/2, p.165-184, 2019</dct:source>
    <rdfs:comment xml:lang="en">GSSP defined at the base of a silty mudstone layer (within bed 9) 52.8m above the base of the Kaili Formation in the Wuliu-Zengjiayan section in Jianhe County, eastern Guizhou Province, China. This level coincides with the first appearance of the cosmopolitan oryctocephalid trilobite Oryctocephalus indicus. Secondary indicators near the GSSP include the ROECE negative delta 13C excursion, the simultaneous appearance of acanthomorphic acritarchs, and a transgressive phase of a major eustatic event. The Wuliu-Zengjiayan section is situated along a hill ridge which is about 0.5km northeast of Balang Village, Jianhe County, GuizhouProvince, China at a latitude of  26.74738333 N and a longitude of 108.4138333 E. The GSSP is located inside the Jianhe Natural Reserve of Paleontological Fossils and the Miaoling National Geopark.</rdfs:comment>
    <rdfs:label xml:lang="en">Stratotype Point Base of Cambrian Stage 5</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://timescalefoundation.org/gssp/detail.php?periodid=150&amp;top_parentid=77"/>
    <owl:versionInfo>2019</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/coronadite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Coronadite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Mn | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic, tetragonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">coronadite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/coronadite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb(Mn&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;Mn&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;)O&lt;sub&gt;16&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Lead hexamanganeseIV dimanganeseII hexadecaoxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-1134</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1134:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1134.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb(Mn&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;Mn&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;)O&lt;sub&gt;16&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060258 | R070320 | R090056</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Coronadite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Coronadite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Lindgren W, Hillebrand W F (1904) Minerals from the Clifton-Morenci district, American Journal of Science 18, 448-460</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Coronadite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.DK.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With large (+- medium-sized) cations; tunnel structures</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Coronadite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1904</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/senkevichite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Senkevichite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cs | K | Na | Ca | Ti | O | Si | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CsNaKCa&lt;sub&gt;2&lt;/sub&gt;TiOSi&lt;sub&gt;7&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;(OH)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2004-017</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-27468</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:27468:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-27468.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cs&lt;sup&gt;1+&lt;/sup&gt;KNaCa&lt;sub&gt;2&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;OSi&lt;sub&gt;7&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;(OH)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Senkevichite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Senkevichite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Agakhanov A A, Pautov L A, Uvarova Y A, Sokolova E V, Hawthorne F C, Karpenko V Y (2005) Senkevichite CsKNaCa2TiO[Si7O18(OH)], a new mineral, New Data on Minerals. Moscow 40, 17-22</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.DG.75</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 3-periodic single and multiple chains</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://webmineral.com/data/Senekevichite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2004-017</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Hydration">
