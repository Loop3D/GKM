    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Y | H | C | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/thomasclarkitey.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaY(HCO&lt;sub&gt;3&lt;/sub&gt;)(OH)&lt;sub&gt;3&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1997-047</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Sodium yttrium bicarbonate trihydroxyl tetrahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-7336</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7336:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7336.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaY(HCO&lt;sub&gt;3&lt;/sub&gt;)(OH)&lt;sub&gt;3&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R110186</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Thomasclarkite-(Y)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Thomasclarkite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Grice J D, Gault R A (1998) Thomasclarkite-(Y), a new sodium — rare–earth–element bicarbonate mineral species from Mont Saint-Hilare, Quebec, The Canadian Mineralogist 36, 1293-1300</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.DC.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions and H2O, With large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Thomasclarkite-%28Y%29.shtml</gsmin:webmineralurl>
