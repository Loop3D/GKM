    <gsel:symbol>K</gsel:symbol>
    <gsel:wikidataid rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.wikidata.org/entity/Q703</gsel:wikidataid>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/hasSetting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
