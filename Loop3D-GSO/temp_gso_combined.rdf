    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:29254:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-29254.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KFe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(HP&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Gengenbachite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Gengenbachite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Walenta K, Theye T, Hatert F (2007) Gengenbachit, KFe_3_(H_2_PO_4_)_2_(HPO_4_)_4_·6H_2_O, ein zweites neues Phosphatmineral von der Grube Silberbrünnle bei Gengenbach im mittleren Schwarzwald, nunmehr eine anerkannte neue Mineralart, Aufschluss 58, 125-128</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.CA.65</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With small and large/medium cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Gengenbachite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2001-003b</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Dissolution_Creep">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf, K.K.E, Mehl, J.P. &amp; Jackson, J.A. (eds), 2005. Glossary of geology, 5th Edition. American Geological Institute, Alexandria, 779 p.</dct:source>
    <rdfs:comment xml:lang="en">Deformation by dissolution under the effects of differential stress and its transport to a new location by movement of fluid in the rock body.</rdfs:comment>
    <rdfs:label xml:lang="en">dissolution creep</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Transformation"/>
  </rdf:Description>
