    <gsmin:mindaturl>http://www.mindat.org/min-43583.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;2&lt;/sub&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Te&lt;sup&gt;6+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bairdite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Bairdite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf A R, Mills S J, Housley R M, Rossman G R, Marty J, Thorne B (2013) Lead-tellurium oxysalts from Otto Mountain near Baker, California: X. Bairdite, Pb_2_Cu^2+^_4_Te^6+^_2_O_10_(OH)_2_(SO_4_)(H_2_O), a new mineral with thick HCP layers, American Mineralogist 98, 1315-1321</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, hydroxide or arsenite</gsmin:strunzlabel>
    <gsmin:wikipediadate>2012-061</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/furongite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Furongite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Al | U | O | P | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/furongite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al&lt;sub&gt;4&lt;/sub&gt;(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;19.5&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1621</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1621:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1621.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al&lt;sub&gt;13&lt;/sub&gt;(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;7&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;13&lt;/sub&gt;(OH)&lt;sub&gt;14&lt;/sub&gt;·58H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Furongite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Furongite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hunan 230 Laboratory, Hunan 305 Geological Team and X-ray Laboratory, Wuhan Geological Institute (1976) Furongite - a new uranium mineral found in China, Acta Geologica Sinica 2, 203-204</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.EB.50</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl phosphate or arsenate, UO2:RO4 = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Furongite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1976</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/rruffite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Rruffite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Cu | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Cu(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2009-077</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dicalcium copper diarsenate dihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-39845</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:39845:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-39845.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070431 | R141211</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Rruffite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Rruffite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Yang H, Jenkins R A, Downs R T, Evans S H, Tait K T (2011) Rruffite, Ca_2_Cu(AsO_4_)_2_·2H_2_O, a new member of the roselite group, from Tierra Amarilla, Chile, The Canadian Mineralogist 49, 877-884</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Roselite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CG.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With large and medium-sized cations, RO4:H2O = 1:1</gsmin:strunzlabel>
    <gsmin:wikipediadate>2009-077</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/indigirite">
