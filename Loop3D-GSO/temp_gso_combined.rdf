    <gsmin:mindaturl>http://www.mindat.org/min-2147.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Mo&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;8&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kamiokite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kamiokite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Picot D, Johan Z (1977) Kamiokite. Atlas des Minéraux Métalliques, Mémoires du Bureau de Recherches Géologiques et Minières 90-1977, 219-219</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Nolanite</gsmin:structuralgroup>
