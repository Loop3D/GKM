  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfeature/Bed_Lithosome">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI rockbodypart vocabulary 2016-11-21</dct:source>
    <rdfs:comment xml:lang="en">Lithosome in lithostratigraphic unit that occurs as individual beds interleaved with other constituents on the outcrop (m) scale or larger.</rdfs:comment>
    <rdfs:label xml:lang="en">bed lithosome</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfeature/Lithosome"/>
  </rdf:Description>
