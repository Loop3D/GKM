    <gsmin:rruffids>R040128 | R050094 | R060023 | R120095</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Analcime</gsmin:rruffnamehtml>
