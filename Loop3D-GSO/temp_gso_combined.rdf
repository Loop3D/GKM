    <gsmin:wikipediadate>1978-080</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/rietveldite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
