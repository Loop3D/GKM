    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2013:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2013.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060149 | R130214</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ilmenite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ilmenite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kupffer A T (1827) Ilmenit, ein neues fossil (Sammt neuen spielarten des zirkon und gadolinit) aus Sibirien; beschrieben, Archiv für die Gesammte Naturlehre 10, 1-13</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Corundum</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.CB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 2: 3,3: 5, and similar, With medium-sized cations</gsmin:strunzlabel>
