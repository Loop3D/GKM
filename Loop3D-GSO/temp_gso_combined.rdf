    <gsmin:imanumber xml:lang="en">IMA1997-015</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-25707</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:25707:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-25707.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,Ca)&lt;sub&gt;5&lt;/sub&gt;Ca(Ti&lt;sup&gt;4+&lt;/sup&gt;,Nb&lt;sup&gt;5+&lt;/sup&gt;)&lt;sub&gt;5&lt;/sub&gt;Si&lt;sub&gt;12&lt;/sub&gt;O&lt;sub&gt;34&lt;/sub&gt;(OH,F)&lt;sub&gt;8&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Haineaultite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Haineaultite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">McDonald A M, Chao G Y (2004) Haineaultite, a new hydrated sodium calcium titanosilicate from Mont Saint-Hilaire, Quebec: description, structure determination and genetic implications, The Canadian Mineralogist 42, 769-780</gsmin:statusnotes>
