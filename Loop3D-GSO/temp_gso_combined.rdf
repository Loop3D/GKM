    <gsmin:rruffnameplain xml:lang="en">Galeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pabst A, Sawyer D L, Switzer G (1955) Galeite, a new mineral from Searles Lake, California. Geological Society of America Bulletin 66, 1658-1659</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.BD.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions, without H2O, With only large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Galeite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1963</gsmin:wikipediadate>
  </rdf:Description>
