    <gsmin:mindatid>min-985</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:985:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-985.html</gsmin:mindaturl>
