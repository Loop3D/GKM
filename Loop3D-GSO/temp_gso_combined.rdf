    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7127:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7127.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;5&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;7&lt;/sub&gt;Si&lt;sub&gt;20&lt;/sub&gt;O&lt;sub&gt;50&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·12H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kalifersite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kalifersite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Ferraris G, Khomyakov A P, Belluso E, Soboleva S V (1998) Kalifersite, a new alkaline silicate from Kola Peninsula (Russia) based on a palygorskite-sepiolite polysomatic series, European Journal of Mineralogy 10, 865-874</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.EE.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate: Single tetrahedral nets of 6-membered rings connected by octahedral nets or octahedral bands</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Kalifersite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1996-007</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Polar_Wander">
