    <gsmin:statusnotes xml:lang="en">Grice J D, Peacor D R, Robinson G W, Van Velthuizen J, Roberts W L, Campbell T J, Dunn P J (1985) Tiptopite (Li,K,Na,Ca,[box])_8_Be_6_(PO_4_)_6_(OH)_4_, a new mineral species from the Black Hills, South Dakota, The Canadian Mineralogist 23, 43-46</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Cancrinite-sodalite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DA.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With small (and occasionally larger) cations</gsmin:strunzlabel>
