    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Fe | U | O | S | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe(UO&lt;sub&gt;2&lt;/sub&gt;)(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;5&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2016-081</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Pending publication</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;5&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Rietveldite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Rietveldite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf, A.R., Sejkora, J., Witzke, T., Plášil, J., Cejka, J., Nash, B.P. and Marty, J. (2016) Rietveldite, IMA 2016-081. CNMNC Newsletter No. 34, December 2016, page 1320; Mineralogical Magazine, 80, 1315–1321</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Svornostite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/gersdorffite-p213">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Gersdorffite-P2&lt;sub&gt;1&lt;/sub&gt;3</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ni | As | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NiAsS</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ni&lt;sup&gt;3+&lt;/sup&gt;(AsS)&lt;sup&gt;3-&lt;/sup&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070343 | R070304 | R070341</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Gersdorffite-P2&amp;lt;sub&amp;gt;1&amp;lt;/sub&amp;gt;3</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Gersdorffite-P213</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Known previously, but named in this publication: Haidinger W (1845) Zweite Klasse: Geogenide. XIII. Ordnung. Kiese. III. Kobaltkies. Gersdorffit, in Handbuch der Bestimmenden Mineralogie, Bei Braumüller and Seidel (Wien) 559-562 Name changed from gersdorffite: Bayliss P (1986) Subdivision of the pyrite group, and a chemical and X-ray-diffraction investigation of ullmannite. The Canadian Mineralogist 24, 27-33</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Ullmannite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/metaheinrichite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
