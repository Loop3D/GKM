    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3380</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3380:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3380.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba(Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;Cr&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;)O&lt;sub&gt;16&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070714</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Redledgeite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Redledgeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Strunz H (1961) "Chromrutil" von der Red Ledge Mine ist kein Rutil. Redledgeit, Neues Jahrbuch für Mineralogie, Monatshefte 1961, 107-111 Chemical formula revised: Scott J D, Peatfield G R (1986) Mannardite [Ba·H_2_O](Ti_6_V^3+^_2_)O_16_, a new mineral species, and new data on redledgeite, The Canadian Mineralogist 24, 55-66 Chemical formula revised again: Biagioni C, Capalbo C, Pasero M (2013) Nomenclature tunings in the hollandite supergroup. European Journal of Mineralogy 25, 85-90</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Coronadite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.DK.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With large (+- medium-sized) cations; tunnel structures</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Redledgeite.shtml</gsmin:webmineralurl>
