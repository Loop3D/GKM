    <gsmin:rruffnameplain xml:lang="en">Sugilite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Murakami N, Kato T, Miúra Y, Hirowatari F (1976) Sugilite, a new silicate mineral from Iwagi Islet, Southwest Japan, Mineralogical Journal 8, 110-121</gsmin:statusnotes>
