    <gsmin:wikipediadate>2009-075</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/clinoatacamite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
