    <gsmin:rruffnameplain xml:lang="en">Pseudolaueite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Strunz H (1956) Pseudolaueit, ein neues Mineral, Naturwissenschaften 6, 128-128 Chemical formula revised from Mn^2+^Fe^3+^_2_(PO_4_)_2_(OH)_2_·7-8H_2_O: Baur W H (1969) A comparison of the crystal structures of pseudolaueite and laueite. American Mineralogist 54, 1312-1323</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Stewartite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DC.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With only medium-sized cations, (OH, etc.):RO4 = 1:1 and &lt; 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Pseudolaueite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1956</gsmin:wikipediadate>
  </rdf:Description>
