    <gsmin:mindaturl>http://www.mindat.org/min-231.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;3&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Angelellite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Angelellite</gsmin:rruffnameplain>
