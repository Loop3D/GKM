    <gsmin:mindaturl>http://www.mindat.org/min-26457.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;4&lt;/sub&gt;AgPb&lt;sub&gt;2&lt;/sub&gt;Bi&lt;sub&gt;9&lt;/sub&gt;S&lt;sub&gt;18&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cupromakovickyite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cupromakovickyite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Topa D, Paar W H (2008) Cupromakovickyite, Cu&lt;sub&gt;8&lt;/sub&gt;Pb&lt;sub&gt;4&lt;/sub&gt;Ag&lt;sub&gt;2&lt;/sub&gt;Bi&lt;sub&gt;18&lt;/sub&gt;S&lt;sub&gt;36&lt;/sub&gt;, a new mineral species of the pavonite homologous series, The Canadian Mineralogist 46, 503-514</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Pavonite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.JA.05d</gsmin:strunzcodeV10>
