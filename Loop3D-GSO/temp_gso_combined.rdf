    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2266:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2266.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;2&lt;/sub&gt;PO&lt;sub&gt;4&lt;/sub&gt;(OH)·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R050505 | R060579</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kovdorskite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kovdorskite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kapustin Y L, Bykova A V, Pudovkina Z V (1980) Kovdorskite - a new mineral, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 109(3), 341-347</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.DC.22</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With only medium-sized cations, (OH, etc.):RO4 = 1:1 and &lt; 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Kovdorskite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1979-066</gsmin:wikipediadate>
