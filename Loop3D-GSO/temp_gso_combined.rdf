    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1732:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1732.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;Al(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060268</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Goudeyite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Goudeyite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Wise W S (1978) Parnauite and goudeyite, two new copper arsenate minerals from the Majuba Hill Mine, Pershing County, Nevada, American Mineralogist 63, 704-708</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Mixite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DL.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 = 2:1</gsmin:strunzlabel>
