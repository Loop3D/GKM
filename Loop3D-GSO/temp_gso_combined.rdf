    <rdfs:comment xml:lang="en">Lineation in igneous rock defined by aligned crystals where there is evidence that the crystal alignment is related to process occurring before the rock was solidified.</rdfs:comment>
    <rdfs:label xml:lang="en">igneous mineral lineation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologiclineation/igneous_lineation"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologiclineation/mineral_lineation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/pyrope">
