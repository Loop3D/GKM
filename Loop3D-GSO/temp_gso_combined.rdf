    <gsmin:rruffnameplain xml:lang="en">Kegelite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Medenbach O, Schmetzer K (1975) Kegelit, ein neues bleisilicat, Naturwissenschaften 62, 137-137 Redefined: Dunn P J, Braithwaite R S W, Roberts A C, Ramik R A (1990) Kegelite from Tsumeb, Namibia: a redefinition, American Mineralogist 75, 702-704</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.EC.80</gsmin:strunzcodeV10>
