    <gsmin:rruffnameplain xml:lang="en">Paralabuntsovite-Mg</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Before this paper, the mineral was simply known as labuntsovite: Chukanov N V, Pekov I V, Khomyakov A P (2002) Recommended nomenclature for labuntsovite-group minerals, European Journal of Mineralogy 14, 165-173</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Labuntsovite</gsmin:structuralgroup>
