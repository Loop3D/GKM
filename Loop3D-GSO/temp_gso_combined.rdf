    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Catalanoite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Catalanoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Ruiz T V, Sureda R J (2002) Catalanoite, Na_2_H[PO_4_].8H_2_O, a new evaporite mineral from Santa Maria alkaline lagoon, Los Andes department, Salta province, Argentina, 18th General Meeting of the International Mineralogical Association, Edinburgh, UK Abstract, 143-143</gsmin:statusnotes>
