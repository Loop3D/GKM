  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Pure_Carbonate_Mudstone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Dunham 1962</dct:source>
    <rdfs:comment xml:lang="en">Mudstone that consists of greater than 90 percent carbonate minerals of intrabasinal orign in the mud fraction, and contains less than 10 percent allochems. The original depositional texture is preserved and fabric is matrix supported. Carbonate mudstone of Dunham (1962)</rdfs:comment>
    <rdfs:label xml:lang="en">pure carbonate mudstone</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Generic_Mudstone"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Pure_Carbonate_Sedimentary_Rock"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/brazilianite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
