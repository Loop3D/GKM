    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3204:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3204.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">MgAl&lt;sub&gt;2&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;·22H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060108</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pickeringite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Pickeringite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hayes A A (1844) Description and analysis of pickeringite, a native magnesian alum, The American Journal of Science and Arts 46, 360-362</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Halotrichite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.CB.85</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, with H2O, With only medium-sized cations</gsmin:strunzlabel>
