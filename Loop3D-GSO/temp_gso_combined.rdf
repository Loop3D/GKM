  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/magnesiohogbomite-6n6s">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Magnesiohögbomite-6N6S</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mg | Al | Fe | Ti | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">hogbomite</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Mg,Al,Fe)&lt;sub&gt;3&lt;/sub&gt;(Al,Ti)&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;15&lt;/sub&gt;(OH)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:mindatid>min-11447</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:11447:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-11447.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Mg,Al,Fe&lt;sup&gt;2+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;3&lt;/sub&gt;(Al,Ti&lt;sup&gt;4+&lt;/sup&gt;)&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;15&lt;/sub&gt;(OH)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Magnesiohögbomite-6N6S</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Magnesiohogbomite-6N6S</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Schmetzer K, Berger A (1990) Lamellar iron-free högbomite-24R from Tanzania, Neues Jahrbuch für Mineralogie, Monatshefte 1990, 401-412 Defined as a mineral, and designated as hogbomite-24R: Hejny C, Armbruster T (2002) Polysomatism in högbomite: The crystal structures of 10T, 12H, 14T, and 24R polysomes, American Mineralogist 87, 277-292 Chemical formula revised and name changed from hogbomite-24R: Armbruster T (2002) Revised nomenclature of högbomite, nigerite, and taafeite minerals, European Journal of Mineralogy 14, 389-395</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hogbömite-Magnesiohogbömite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.CB.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 2: 3,3: 5, and similar, With medium-sized cations</gsmin:strunzlabel>
