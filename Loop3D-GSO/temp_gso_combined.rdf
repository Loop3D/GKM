    <gsmin:rruffids>R050002 | R070651 | R100057</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Barysilite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Barysilite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Sjögren A, Lundström C H (1888) Om barysil, ett ej förr uppmärksammadt blysilikat från Harstigsgrufvan, Öfversigt af Kongliga Vetenskaps-Akademiens Förhandlingar 45, 7-11</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.BC.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate: Si2O7 groups, without non-tetrahedral anions; cations in octahedral [6] and greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Barysilite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1888</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/guanacoite">
