    <gsmin:wikipediadate>1970-015</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/chromphyllite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
