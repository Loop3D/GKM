    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3151:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3151.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ni&lt;sup&gt;2+&lt;/sup&gt;(Se&lt;sub&gt;2&lt;/sub&gt;)&lt;sup&gt;2-&lt;/sup&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Penroseite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Penroseite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Gordon S G (1926) Proceedings of societies: Penroseite and trudellite, two new minerals, American Mineralogist 11, 39-43</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Pyrite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.EB.05a</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide, M: S &lt;= 1:2 with Fe, Co, Ni, PGE, etc.</gsmin:strunzlabel>
