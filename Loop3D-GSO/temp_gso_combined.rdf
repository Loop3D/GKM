  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/johntomaite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Johntomaite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ba | Fe | P | O | H</gsmin:chemistryelements>
