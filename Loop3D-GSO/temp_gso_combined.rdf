  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/yttrotantalite-y">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Yttrotantalite-(Y)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Y | U | Fe | Ta | Nb | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">amorphous, unknown</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/yttrotantalitey.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Y,U,Fe&lt;sup&gt;2+&lt;/sup&gt;)(Ta,Nb)(O,OH)&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Renamed|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4373</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4373:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4373.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Y&lt;sup&gt;3+&lt;/sup&gt;,U&lt;sup&gt;6+&lt;/sup&gt;,Fe&lt;sup&gt;2+&lt;/sup&gt;)(Ta&lt;sup&gt;5+&lt;/sup&gt;,Nb&lt;sup&gt;5+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;(O,OH)&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060022 | R060828 | R080046</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Yttrotantalite-(Y)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Yttrotantalite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named yttrotantal: Ekeberg A G (1802) Uplysning 'om Ytterjordens egenskaper, i synnerhet i jamforelse med Berylljorden: om de Fossilier, hvari forstnamnde jord innehålles, samt om en ny uptäckt kropp of metallisk natur. Kongliga Svenska Vetenskaps-Akademiens Handlingar 23, 68-83 Name changed from yttrotantalite: Nickel E H, Mandarino J A (1987) Procedures involving the IMA Commission on New Minerals and Mineral Names and guidelines on mineral nomenclature, American Mineralogist 72, 1031-1042</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.DG.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With large (+- medium-sized) cations; chains of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Yttrotantalite-%28Y%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1802</gsmin:wikipediadate>
  </rdf:Description>
