  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Cataclastic_Deformation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">based on Neuendorf et al 2005</dct:source>
    <rdfs:comment xml:lang="en">Brittle deformation processes, i.e. the formation and growth of fractures and frictional sliding along fracture surfaces.</rdfs:comment>
