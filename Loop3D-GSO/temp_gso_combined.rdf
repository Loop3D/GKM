    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Athabascaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Athabascaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Harris D C, Cabri L J, Kaiman S (1970) Athabascaite: A new copper selenide mineral from Martin Lake, Saskatchewan, The Canadian Mineralogist 10, 207-215</gsmin:statusnotes>
