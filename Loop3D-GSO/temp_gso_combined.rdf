    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1896:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1896.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;Cl</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hibbingite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hibbingite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Saini-Eidukat B, Kucha H, Keppler H (1994) Hibbingite, ?-Fe_2_(OH)_3_Cl, a new mineral from the Duluth Complex, Minnesota, with implications for the oxidation of Fe-bearing compounds and the transport of metals, American Mineralogist 79, 555-561</gsmin:statusnotes>
