    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;5&lt;/sub&gt;Al(AlSi&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;)(OH)&lt;sub&gt;8&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1070</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1070:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1070.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;5&lt;/sub&gt;Al(AlSi&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;)(OH)&lt;sub&gt;8&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060725 | R061080 | R150146</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Clinochlore</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Clinochlore</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Blake W P (1851) Optical and blowpipe examination of the supposed chlorite of Chester County, Pa., American Journal of Science and Arts 12, 339-341 Chemical formula revised from Mg&lt;sub&gt;6&lt;/sub&gt;Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;8&lt;/sub&gt; after: Zanazzi P F, Comodi P, Nazzareni S, Andreozzi G B (2009) Thermal behaviour of chlorite: an in situ single-crystal and powder diffraction study, European Journal of Mineralogy 21, 581-589</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Clay</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EC.55</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with mica sheets, composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Clinochlore.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1851</gsmin:wikipediadate>
  </rdf:Description>
