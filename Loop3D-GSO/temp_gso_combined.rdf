    <gsmin:chemistryelements>As</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic, unknown</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/arsenolamprite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">As</gsmin:imachemistry>
