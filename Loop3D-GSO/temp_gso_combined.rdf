    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Vinogradovite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Vinogradovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Semenov E I, Bohnshtedt-Kupletskaya E M, Moleva V A, Sludskaya N N (1956) Vinogradovite - a new mineral, Doklady Akademii Nauk SSSR 109, 617-620</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.DB.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 2-periodic single chains, Si2O6; Pyroxene-related minerals</gsmin:strunzlabel>
