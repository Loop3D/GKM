  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/maldonite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Maldonite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Au | Bi</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/maldonite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Au&lt;sub&gt;2&lt;/sub&gt;Bi</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Digold bismuthide</gsmin:iupacchemname>
    <gsmin:mindatid>min-2553</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2553:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2553.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Au&lt;sub&gt;2&lt;/sub&gt;Bi</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Maldonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Maldonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Ulrich G H F (1870) Maldonite or bismuthic gold, in Contributions to the Mineralogy of Victoria, John Ferres (Melbourne) 1-32</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.AA.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">sulfide or sulfosalt alloy of metalloids with Cu, Ag, Au</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Maldonite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1870</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/nealite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Nealite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Fe | As | O | Cl | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;4&lt;/sub&gt;Fe(AsO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;Cl&lt;sub&gt;4&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1979-050</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2869</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2869:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2869.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;(As&lt;sup&gt;3+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;Cl&lt;sub&gt;4&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060774</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nealite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Nealite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Dunn P J, Rouse R C (1980) Nealite a new mineral from Laurion, Greece, The Mineralogical Record 11, 299-301 Chemical formula redefined: Giuseppetti G, Mazzi F, Tadini C (1993) The crystal structure of nealite: Pb_4_Fe(AsO_3_)_2_Cl_4_·2H_2_O, Neues Jahrbuch für Mineralogie, Monatshefte 1993, 278-288</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.JD.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Arsenite, antimonite, bismuthite; with additional anions and H2O</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Nealite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1979-050</gsmin:wikipediadate>
  </rdf:Description>
