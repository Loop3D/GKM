  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/haradaite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Haradaite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Sr | V | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/haradaite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">SrV&lt;sup&gt;4+&lt;/sup&gt;Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1963-011</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1817</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1817:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1817.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">SrV&lt;sup&gt;4+&lt;/sup&gt;Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Haradaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Haradaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Takéuchi Y, Joswig W (1967) The structure of haradaite and a note on the Si-O bond lengths in silicates, Mineralogical Journal 5, 98-123</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.DH.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 4-periodic single chains, Si4O12</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Haradaite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1963-011</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ramsdellite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ramsdellite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/ramsdellite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">MnO&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: ManganeseIV dioxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-3359</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3359:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3359.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050552</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ramsdellite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ramsdellite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">The mineral is described: Ramsdell L S (1932) An X-ray study of psilomelane and wad, American Mineralogist 17, 143-149 The mineral is named: Fleischer M, Richmond W E (1943) The manganese oxide minerals: a preliminary report, Economic Geology 38, 269-286</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Ramsdellite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.DB.15a</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With medium-sized cations; chains of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Ramsdellite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1932</gsmin:wikipediadate>
  </rdf:Description>
