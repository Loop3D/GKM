    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1875:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1875.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;Al&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R170038</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hercynite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hercynite</gsmin:rruffnameplain>
