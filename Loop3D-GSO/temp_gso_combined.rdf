    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">milarite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/osumilitemg.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KMg&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;3&lt;/sub&gt;(Al&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;10&lt;/sub&gt;)O&lt;sub&gt;30&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2011-083</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3038</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3038:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3038.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KMg&lt;sub&gt;2&lt;/sub&gt;(Al&lt;sub&gt;5&lt;/sub&gt;Si&lt;sub&gt;10&lt;/sub&gt;)O&lt;sub&gt;30&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R141100 | R141102</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Osumilite-(Mg)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Osumilite-(Mg)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">This mineral name was previously used, but this paper represents its formal description: Chukanov N V, Pekov I V, Rastsvetaeva R K, Aksenov S M, Belakovskiy D I, Van K V, Schuller V, Ternes B (2012) Osumilite-(Mg): Validation as a mineral species and new data. Zapiski Rossiiskogo Mineralogicheskogo Obshchetstva 141, 27-36</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Milarite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CM.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si6O18]12- 6-membered double rings (sechser-Doppelringe)</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Osumilite-%28Mg%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2011-083</gsmin:wikipediadate>
  </rdf:Description>
