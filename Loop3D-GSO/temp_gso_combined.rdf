    <gsmin:rruffnameplain xml:lang="en">Modderite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Cooper R A (1923) Mineral constituents of Rand concentrates, Journal of the Chemical, Metallurgical, and Mining Society of South Africa 24, 90-95</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Modderite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.CC.15</gsmin:strunzcodeV10>
