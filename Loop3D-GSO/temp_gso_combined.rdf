    <gsmin:mindaturl>http://www.mindat.org/min-1432.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(Te&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)O&lt;sub&gt;2&lt;/sub&gt;Cl</gsmin:rruffchemistry>
    <gsmin:rruffids>R130488</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Eztlite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Eztlite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Williams S A (1982) Cuzticite and eztlite, two new tellurium minerals from Moctezuma, Mexico, Mineralogical Magazine 46, 257-259 Formula revised from Pb_2_Fe^3+^_6_(Te^4+^O_3_)_3_(Te^6+^O_6_)(OH)_10_·8H_2_O: Missen O P, Mills S J, Spratt J, Welch M D, Birch W D, Rumsey M S, Vylita J (2018) The crystal-structure determination and redefinition of eztlite, Pb_2_^2+^Fe_3_^3+^(Te^4+^O_3_)_3_(SO_4_)O_2_Cl. Mineralogical Magazine 82, 1355-1367</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.JN.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Tellurite with additional anions and H2O</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Eztlite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1980-072</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/potassic-pargasite">
