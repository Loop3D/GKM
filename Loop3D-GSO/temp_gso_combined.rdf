    <gsmin:mindaturl>http://www.mindat.org/min-6902.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sr&lt;sup&gt;2+&lt;/sup&gt;(Y&lt;sup&gt;3+&lt;/sup&gt;,U&lt;sup&gt;4+&lt;/sup&gt;,Mn&lt;sup&gt;2+&lt;/sup&gt;)Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(Ti&lt;sup&gt;4+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;,Cr&lt;sup&gt;3+&lt;/sup&gt;,V&lt;sup&gt;5+&lt;/sup&gt;)&lt;sub&gt;18&lt;/sub&gt;(O,OH)&lt;sub&gt;38&lt;/sub&gt;</gsmin:rruffchemistry>
