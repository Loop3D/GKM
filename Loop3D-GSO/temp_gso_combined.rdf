    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Mg(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dicalcium magnesium diphosphate dihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1109</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1109:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1109.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Mg(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060140 | R120022 | R140626</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Collinsite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Collinsite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Poitevin E (1927) A new Canadian occurrence of phosphorite from near Francois Lake, British Columbia, Canada Department of Mines, Bulletin 46, 2-12</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Fairfieldite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CG.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With large and medium-sized cations, RO4:H2O = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Collinsite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1927</gsmin:wikipediadate>
  </rdf:Description>
