  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Weathering">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">this vocabulary</dct:source>
    <rdfs:comment xml:lang="en">The process or group of processes by which earth materials exposed to atmospheric agents at or near the Earth's surface are changed in color, texture, composition, firmness, or form, with little or no transport of the loosened or altered material. Processes typically include oxidationhydration, and leaching of soluble constituents.</rdfs:comment>
    <rdfs:label xml:lang="en">weathering</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Transformation"/>
  </rdf:Description>
