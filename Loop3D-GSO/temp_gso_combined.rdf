    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;Mg&lt;sub&gt;2&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dipotassium dimagnesium trisulfate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2320</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2320:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2320.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;Mg&lt;sub&gt;2&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070285</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Langbeinite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Langbeinite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Zuckschwerdt S (1891) Langbeinit, ein neues kaliummagnesiumsulfat, Zeitschrift für Angewandte Chemie 1891, 356-356</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Langbeinite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.AC.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, without H2O, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Langbeinite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1891</gsmin:wikipediadate>
  </rdf:Description>
