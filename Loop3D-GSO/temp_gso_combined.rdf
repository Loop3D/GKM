    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4025:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4025.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,U&lt;sup&gt;4+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;)(PO&lt;sub&gt;4&lt;/sub&gt;,SO&lt;sub&gt;4&lt;/sub&gt;)·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tristramite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tristramite</gsmin:rruffnameplain>
