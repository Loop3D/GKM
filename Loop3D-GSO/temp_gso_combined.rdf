    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2068:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2068.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaMn&lt;sup&gt;2+&lt;/sup&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R080072</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Jahnsite-(CaMnMn)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Jahnsite-(CaMnMn)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Grice J D, Dunn P J, Ramik R A (1990) Jahnsite-(CaMnMn), a new member of the whiteite group from Mangualde, Beira, Portugal, American Mineralogist 75, 401-404</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Jahnsite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DH.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 &lt; 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Jahnsite-%28CaMnMn%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1987-020a</gsmin:wikipediadate>
