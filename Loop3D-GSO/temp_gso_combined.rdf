    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Wadsleyite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Wadsleyite</gsmin:rruffnameplain>
