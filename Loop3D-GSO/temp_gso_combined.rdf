    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Clarkeite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Clarkeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Ross C S, Henderson E P, Posnjak E (1931) Clarkeite; a new uranium mineral, American Mineralogist 16, 213-220 Chemical formula revised: Gruner J W (1954) The chemical formula of clarkeite, American Mineralogist 39, 836-838 Chemical formula revised again: Frondel C, Meyrowitz R (1956) Studies of uranium minerals (XIX): rutherfordine, diderichite, and clarkeite, American Mineralogist 41, 127-133 Chemical formula revised yet again: Finch R J, Ewing R C (1997) Clarkeite: New chemical and structural data, American Mineralogist 82, 607-619</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.GC.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl hydroxide, With additional cations; with mainly UO2(O,OH)6 hexagonal polyhedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Clarkeite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1931</gsmin:wikipediadate>
