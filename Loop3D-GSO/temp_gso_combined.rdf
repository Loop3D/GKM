  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ferrirockbridgeite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ferrirockbridgeite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Fe | P | O | H</gsmin:chemistryelements>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;0.67&lt;/sub&gt;&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;&lt;sub&gt;0.33&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2018-065</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Pending publication</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;0.67&lt;/sub&gt;&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;&lt;sub&gt;0.33&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ferrirockbridgeite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ferrirockbridgeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Grey, I.E., Kampf, A.R., MacRae, C.M., Cashion, J.D., Gozukara, Y. and Shanks, F.L. (2018) Ferrirockbridgeite, IMA 2018-065. CNMNC Newsletter No. 45, October 2018, page xxx; Mineralogical Magazine, 82, xxx-xxx</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Rockbridgeite</gsmin:structuralgroup>
  </rdf:Description>
