    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | H | O | Fe | P</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">[Na(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;2.5&lt;/sub&gt;][Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;8&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;(OH)&lt;sub&gt;7&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;4&lt;/sub&gt;]</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2007-024</gsmin:imanumber>
