    <gsmin:mindaturl>http://www.mindat.org/min-3325.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ag&lt;sub&gt;3&lt;/sub&gt;SbS&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
