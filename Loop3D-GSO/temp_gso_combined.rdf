  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/arrojadite-kfe">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Arrojadite-(KFe)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Na | Fe | Ca | Al | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">dickinsonite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/arrojadite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(KNa)Fe&lt;sup&gt;2+&lt;/sup&gt;(CaNa&lt;sub&gt;2&lt;/sub&gt;)Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;13&lt;/sub&gt;Al(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;11&lt;/sub&gt;(PO&lt;sub&gt;3&lt;/sub&gt;OH)(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:mindatid>min-351</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:351:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-351.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(KNa)Fe&lt;sup&gt;2+&lt;/sup&gt;(CaNa&lt;sub&gt;2&lt;/sub&gt;)Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;13&lt;/sub&gt;Al(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;11&lt;/sub&gt;(PO&lt;sub&gt;3&lt;/sub&gt;OH)(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070319</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Arrojadite-(KFe)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Arrojadite-(KFe)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Guimarães D (1925) Arrojadita, um novo mineral do grupo da wagnerita, Publicaçao da Inspectoria de Obras Contra as Seccas, Rio de Janeiro 58, 119-122 Redefined and name changed from arrojadite: Chopin C, Oberti R, Camara F (2006) The arrojadite enigma: II. Compositional space, new members, and nomenclature of the group, American Mineralogist 91, 1260-1270</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Arrojadite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BF.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH, etc.):RO4&lt; 0.5:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Arrojadite-(KFe).shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1925</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/aqualite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Aqualite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>H | O | Na | K | Sr | Ca | Zr | Si | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/aqualite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(H&lt;sub&gt;3&lt;/sub&gt;O)&lt;sub&gt;8&lt;/sub&gt;(Na,K,Sr)&lt;sub&gt;5&lt;/sub&gt;Ca&lt;sub&gt;6&lt;/sub&gt;Zr&lt;sub&gt;3&lt;/sub&gt;Si&lt;sub&gt;26&lt;/sub&gt;O&lt;sub&gt;66&lt;/sub&gt;(OH)&lt;sub&gt;9&lt;/sub&gt;Cl</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2002-066</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-27558</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:27558:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-27558.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(H&lt;sub&gt;3&lt;/sub&gt;O)&lt;sub&gt;8&lt;/sub&gt;(Na,K,Sr)&lt;sub&gt;5&lt;/sub&gt;Ca&lt;sub&gt;6&lt;/sub&gt;Zr&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Si&lt;sub&gt;26&lt;/sub&gt;O&lt;sub&gt;66&lt;/sub&gt;(OH)&lt;sub&gt;9&lt;/sub&gt;Cl</gsmin:rruffchemistry>
    <gsmin:rruffids>R070413</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Aqualite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Aqualite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Khomyakov A P, Nechelyustov G N, Rastsvetaeva R K (2007) Aqualite, (H&lt;sub&gt;3&lt;/sub&gt;O)&lt;sub&gt;8&lt;/sub&gt;(Na,K,Sr)&lt;sub&gt;5&lt;/sub&gt;Ca&lt;sub&gt;6&lt;/sub&gt;Zr&lt;sub&gt;3&lt;/sub&gt;Si&lt;sub&gt;26&lt;/sub&gt;O&lt;sub&gt;66&lt;/sub&gt;(OH)&lt;sub&gt;9&lt;/sub&gt;Cl, a new eudialyte-group mineral from Inagli alkaline massif (Sakha-Yakutia, Russia), and the problem of oxonium in hydrated eudialytes, abstract only, Zapiski Rossiiskogo Mineralogicheskogo Obshchetstva 136(2), 39-55</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Eudialyte</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CO.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si9O27]18- 9-membered rings</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Aqualite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2002-066</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/natrodufrenite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Natrodufrénite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Fe | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">Dufrénite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/natrodufrenite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaFe&lt;sup&gt;2+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1981-033</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2854</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2854:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2854.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaFe&lt;sup&gt;2+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070599</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Natrodufrénite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Natrodufrenite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Fontan F, Pillard F, Permingeat F (1982) La natrodufrénite (Na, ) (Fe+++, Fe++) (Fe+++, Al)5 (PO4)4(OH)6_2H2O, une nouvelle espèce minérale du groupe de la dufrénite, Bulletin de Minéralogie 105, 321-326 Dunn P J, Grice J D, Fleischer M, Pabst A (1983) New mineral names, American Mineralogist 68, 1038-1041</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Dufrénite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DK.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 &gt; 1:1 and &lt; 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Natrodufrenite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1981-033</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/potassic-richterite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Potassic-richterite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Na | Ca | Mg | Si | O | H</gsmin:chemistryelements>
