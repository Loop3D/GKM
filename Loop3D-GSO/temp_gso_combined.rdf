  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/sakuraiite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Sakuraiite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Zn | Fe | In | Sn | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic, tetragonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/sakuraiite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Cu,Zn,Fe)&lt;sub&gt;3&lt;/sub&gt;(In,Sn)S&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1965-017</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3506</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3506:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3506.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Cu&lt;sup&gt;1+&lt;/sup&gt;,Cu&lt;sup&gt;2+&lt;/sup&gt;,Zn&lt;sup&gt;2+&lt;/sup&gt;,Fe&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;3&lt;/sub&gt;(In&lt;sup&gt;3+&lt;/sup&gt;,Sn&lt;sup&gt;4+&lt;/sup&gt;)S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sakuraiite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Sakuraiite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kato A (1965) Sakuraiite, a new mineral, Chigaku Kenkyu, Sakurai Volume 16, 1-7 Chemical formula revised from stannite-like (Cu,Zn,Fe)&lt;sub&gt;3&lt;/sub&gt;(In,Sn)S&lt;sub&gt;4&lt;/sub&gt;: Kissin S A, Owens D R (1986) The crystallography of sakuraiite, The Canadian Mineralogist 24, 679-683 Chemical formula revised from (Cu,Zn,In,Fe,Sn)S: Shimizu M, Kato A, Shiozawa T (1986) Sakuraiite: chemical composition and extent of (Zn,Fe)In-for-CuSn substitution. The Canadian Mineralogist 24, 405-409</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Sphalerite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.CB.05b</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide (M = S) with Zn, Fe, Cu, Ag, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Sakuraiite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1965-017</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Silt">
