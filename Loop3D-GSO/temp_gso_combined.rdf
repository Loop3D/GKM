    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">kaolinite-serpentine-serpentine subgroup</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/fraipontite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Zn,Al)&lt;sub&gt;3&lt;/sub&gt;(Si,Al)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;5&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1588</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1588:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1588.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Zn&lt;sup&gt;2+&lt;/sup&gt;,Al)&lt;sub&gt;3&lt;/sub&gt;(Si,Al)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;5&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fraipontite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Fraipontite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Cesàro G (1927) Sur la fraipontite, silicate basique hydraté de zinc et d´aluminum, Annales de la Société Géologique de Belgique 50, B106-B110</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Serpentine</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.ED.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with kaolinite layers composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Fraipontite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1927</gsmin:wikipediadate>
