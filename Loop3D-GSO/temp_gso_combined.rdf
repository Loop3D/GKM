    <gsmin:rruffnameplain xml:lang="en">Clinoenstatite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named klinoenstatit: Wahl W (1906) Zur nomenklatur, in Die Enstatitaugite, (PhD dissertation), 151 pages, University of Helsinki (Finland) 137-141</gsmin:statusnotes>
