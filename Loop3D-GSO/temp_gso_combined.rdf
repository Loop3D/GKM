    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;7&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;5&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1983-015</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Heptamagnesium pentasulfate tetrahydroxyl monohydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-875</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:875:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-875.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;7&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;5&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Caminite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Caminite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Haymon R M, Kastner M (1986) Caminite: A new magnesium-hydroxide-sulfate-hydrate mineral found in a submarine hydrothermal deposit, East Pacific Rise, 21°N, American Mineralogist 71, 819-825</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.BB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions, without H2O, With medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Caminite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1983-015</gsmin:wikipediadate>
