    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Spaltiite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Spaltiite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Graeser, S., Topa, D., Effenberger, H., Makovicky, E. and Paar, W.H. (2014) Spaltiite, IMA 2014-012. CNMNC Newsletter No. 20, June 2014, page 557; Mineralogical Magazine, 78, 549-558.</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/schulenbergite">
