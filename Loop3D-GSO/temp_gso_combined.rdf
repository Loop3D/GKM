    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;3&lt;/sub&gt;Zn&lt;sub&gt;3&lt;/sub&gt;(TeO&lt;sub&gt;6&lt;/sub&gt;)(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1978-034</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1326</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1326:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1326.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(Te&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;6&lt;/sub&gt;)(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060498</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Dugganite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Dugganite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Williams S A (1978) Khinite, parakhinite, and dugganite, three new tellurates from Tombstone, Arizona, American Mineralogist 63, 1016-1019</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Dugganite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DL.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 = 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Dugganite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1978-034</gsmin:wikipediadate>
