  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/paradamite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Paradamite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Zn | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/paradamite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sub&gt;2&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)(OH)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dizinc arsenate hydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-3086</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3086:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3086.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH)</gsmin:rruffchemistry>
    <gsmin:rruffids>R050582</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Paradamite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Paradamite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Switzer G (1956) Paradamite, a new zinc arsenate from Mexico, Science 123, 1039-1039 Fleischer M (1956) New mineral names, American Mineralogist 41, 958-960</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Tarbuttite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BB.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With only medium-sized cations, (OH, etc.):RO4 about 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Paradamite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1956</gsmin:wikipediadate>
