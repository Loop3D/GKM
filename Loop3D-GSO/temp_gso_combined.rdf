    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na&lt;sub&gt;0.5&lt;/sub&gt;Bi&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;0.5&lt;/sub&gt;)Mo&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Suseinargiuite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Suseinargiuite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Orlandi P, Biagioni C, Moëlo Y, Langlade J, Faulques E (2015) Suseinargiuite, (Na_0.5_Bi_0.5_)MoO_4_, the Na-Bi analogue of wulfenite, from Su Seinargiu, Sardinia, Italy. European Journal of Mineralogy 27, 695-699</gsmin:statusnotes>
