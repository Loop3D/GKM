    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4299:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4299.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaCO&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R040040 | R050148 | R050267</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Witherite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Witherite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mineral is first described: Withering W, Kirwan R (1784) Experiments and observations on the terra ponderosa, Philosophical Transactions of the Royal Society of London 74, 293-311 Mineral is named: Hoffmann C A S (1789) Mineralsystem des Herrn Inspektor Werners mit dessen erlaubnis herausgegeben von C A S Hoffmann. 78 Witherit, Bergmannisches Journal 1, 369-398</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Aragonite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>05.AB.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate without additional anions, without H2O, Alkali-earth (and other M2+) carbonates</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Witherite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1784</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/rossiantonite">
