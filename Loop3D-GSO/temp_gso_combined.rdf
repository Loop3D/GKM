    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaCu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;10&lt;/sub&gt;(Te&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Juabite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Juabite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Roberts A C, Gault R A, Jensen M C, Criddle A J, Moffatt E A (1997) Juabite, Cu_5_(Te^6+^O_4_)_2_(As^5+^O_4_)_2_·3H_2_O, a new mineral species from the Centennial Eureka mine, Juab County, Utah, Mineralogical Magazine 61, 139-144 Chemical formula revised: Burns P C, Clark C M, Gault R A (2000) Juabite, CaCu_10_(Te^4+^O_3_)_4_(AsO_4_)_4_(OH)_2_(H_2_O)_4_: crystal structure and revision of the chemical formula, The Canadian Mineralogist 38, 809-816</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.JN.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Tellurite with additional anions and H2O</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Juabite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1996-001</gsmin:wikipediadate>
  </rdf:Description>
