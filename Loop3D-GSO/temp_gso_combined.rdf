    <gsmin:mindaturl>http://www.mindat.org/min-3976.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;3&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;15&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tisinalite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tisinalite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kapustin Y L, Pudovkina Z V, Bykova A V (1980) Tinsinalite, Na3H3(Mn,Ca,Fe)TiSi6(O,OH)18·2H2O, a new mineral of the lovozerite group, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 109, issue 2, 223-229 Chemical formula revised: Pekov I V, Krivovichev S V, Zolotarev A A, Yakovenchuk V N, Armbruster T, Pakhomovsky Y A (2009) Crystal chemistry and nomenclature of the lovozerite group, European Journal of Mineralogy 21, 1061-1071</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Lovozerite-Zirsinalite–Lovozerite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CJ.15a</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si6O18]12- 6-membered single rings (sechser-Einfachringe), without insular complex anions</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Tisinalite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1979-052</gsmin:wikipediadate>
  </rdf:Description>
