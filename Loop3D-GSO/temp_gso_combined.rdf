    <gsmin:statusnotes xml:lang="en">Bailey E H, Hildebrand F A, Christ C L, Fahey J J (1959) Schuetteite, a new supergene mercury mineral, American Mineralogist 44, 1026-1038</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.BB.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions, without H2O, With medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Schuetteite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1959</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/bannermanite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Bannermanite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
