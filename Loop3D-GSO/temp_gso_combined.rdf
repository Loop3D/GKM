  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kiddcreekite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kiddcreekite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | W | Sn | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/kiddcreekite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;6&lt;/sub&gt;WSnS&lt;sub&gt;8&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1982-106</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Hexacopper tungsten tin octasulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-2201</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2201:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2201.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;6&lt;/sub&gt;WSnS&lt;sub&gt;8&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kiddcreekite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kiddcreekite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Harris D C, Roberts A C, Thorpe R I, Criddle A J, Stanley C J (1984) Kiddcreekite, a new mineral species from the Kidd Creek mine, Timmins, Ontario and from the Campbell orebody, Bisbee, Arizona, The Canadian Mineralogist 22, 227-232</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.CB.35a</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide (M = S) with Zn, Fe, Cu, Ag, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Kiddcreekite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1982-106</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/wermlandite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Wermlandite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mg | Al | O | H | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">woodwardite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/wermlandite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;7&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;18&lt;/sub&gt;[Ca(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;6&lt;/sub&gt;](SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1970-007</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4271</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4271:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4271.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;8&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;18&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·12H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R100052</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Wermlandite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Wermlandite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Moore P B (1971) Wermlandite, a new mineral from Långban, Sweden, Lithos 4, 213-217 Chemical formula revised: Rius J, Allmann R (1984) The superstructure of the double layer mineral wermlandite [Mg_7_ (Al_0.57_Fe^3+^_0.43_)(OH)_18_]^2+^ · [(Ca_0.6_,Mg_0.4_) (SO_4_)_2_(H_2_O)_12_]^2-^, Zeitschrift für Kristallographie 168, 133-144</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hydrotalcite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.DD.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With only medium-sized cations; sheets of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Wermlandite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1970-007</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/katoptrite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Katoptrite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | Al | Sb | O | Si</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/katoptrite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;13&lt;/sub&gt;Al&lt;sub&gt;4&lt;/sub&gt;Sb&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;20&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: TridecamanganeseII tetraaluminium diantimonyV dodecaoxy dinesosilicate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2169</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2169:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2169.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;13&lt;/sub&gt;Al&lt;sub&gt;4&lt;/sub&gt;Sb&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;20&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R140009</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Katoptrite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Katoptrite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Flink G (1917) Einige Neuigeiten in der schwedischen Mineralogie. Katoptrit, ein neues Mineral von Nordmarken. Geologiska Föreningens i Stockholm Förhandlingar 40, 426-452</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Katoptrite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AE.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with additional anions (O,OH,F,H2O); cations in tetrahedral [4] coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Katoptrite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1917</gsmin:wikipediadate>
  </rdf:Description>
