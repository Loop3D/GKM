    <gsmin:rruffids>R070072</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mercallite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Mercallite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Carobbi G (1935) «Mercallite» nuovo minerale fra i prodotti dell'attivita fumarolica vesuviana del 1933, Rendiconti, Reale Accademia dei Lincei 21, 385-393</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.AD.10</gsmin:strunzcodeV10>
