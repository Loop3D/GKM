    <gsmin:mindaturl>http://www.mindat.org/min-2625.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bi&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O(OH)&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Medenbachite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Medenbachite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Krause W, Berndardt H J, Gerbert W, Graetsch H, Belendorff K, Petitjean K (1996) Medenbachite, Bi2Fe(Cu,Fe)(O,OH)2(OH)2(AsO4)2, a new mineral species: Its description and crystal structure, American Mineralogist 81, 505-512</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.BK.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH, etc.):RO4 = 2:1, 2.5:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Medenbachite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1993-048</gsmin:wikipediadate>
  </rdf:Description>
