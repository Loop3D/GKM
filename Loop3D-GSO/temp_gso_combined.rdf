    <gsmin:imanumber xml:lang="en">IMA1977-020</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2154</gsmin:mindatid>
