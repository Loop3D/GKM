    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;x&lt;/sub&gt;Pb&lt;sub&gt;2+x&lt;/sub&gt;(Sb,Bi)&lt;sub&gt;2-x&lt;/sub&gt;S&lt;sub&gt;5&lt;/sub&gt; (x ˜ 0.15)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1982-057</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
