  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ikranite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ikranite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | H | O | Ca | Mn | REE | Fe | Zr | Si | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">eudialyte</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,H&lt;sub&gt;3&lt;/sub&gt;O)&lt;sub&gt;15&lt;/sub&gt;(Ca,Mn,REE)&lt;sub&gt;6&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Zr&lt;sub&gt;3&lt;/sub&gt;Si&lt;sub&gt;24&lt;/sub&gt;O&lt;sub&gt;66&lt;/sub&gt;(O,OH)&lt;sub&gt;6&lt;/sub&gt;Cl·nH&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2000-010</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-25686</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:25686:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-25686.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,H&lt;sub&gt;3&lt;/sub&gt;O)&lt;sub&gt;15&lt;/sub&gt;(Ca,Mn&lt;sup&gt;2+&lt;/sup&gt;,Ce&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;6&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Zr&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Si&lt;sub&gt;24&lt;/sub&gt;O&lt;sub&gt;66&lt;/sub&gt;(O,OH)&lt;sub&gt;6&lt;/sub&gt;Cl·nH&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ikranite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ikranite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chukanov N V, Pekov I V, Zadov A E, Korovushkin V V, Ekimenkova I A, Rastsvetaeva R K (2003) Ikranite (Na,H_3_O)_15_(Ca,Mn,REE)_6_Fe^3+^_2_Zr_3_([box],Zr)([box],Si)Si_24_O_66_(O,OH)_6_Cl·nH_2_O and raslakite Na_15_Ca_3_Fe_3_(NaZr)_3_Zr_3_(Si,Nb)(Si_25_O73)(OH,H2O)_2_(Cl,OH) - the new eudialyte-group minerals from Lovozero massif, Kola Peninsula. Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 132(5), 22-33</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Eudialyte</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CO.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si9O27]18- 9-membered rings</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Ikranite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2000-010</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/eirikite">
