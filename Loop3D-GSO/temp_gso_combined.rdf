    <gsmin:rruffnameplain xml:lang="en">Morenosite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Alcibar A M (1851) Sobre el mineral de nickel de Galicia, con algunas consideraciones sobre el polimorfismo del sulfato de nickel y de otras sustancias, Revista Minera 2, 175-184</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Epsomite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.CB.40</gsmin:strunzcodeV10>
