    <gsmin:rruffids>R060520</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Woodhouseite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Woodhouseite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Lemmon D M (1937) Woodhouseite, a new mineral of the beudantite group, American Mineralogist 22, 939-948</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Alunite-beudantite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BL.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH, etc.):RO4 = 3:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Woodhouseite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1937</gsmin:wikipediadate>
