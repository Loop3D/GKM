  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kapustinite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kapustinite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Zr | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic, rhombohedral</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">lovozerite</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;6&lt;/sub&gt;ZrSi&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;16&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2003-018</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-26446</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:26446:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-26446.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;6&lt;/sub&gt;Zr&lt;sup&gt;4+&lt;/sup&gt;Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;16&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060896</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kapustinite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kapustinite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pekov I V, Chukanov N V, Yamnova N A, Egorov-Tismenko Y K, lndov A E (2003) Kapustinite, Na_5.5_Mn_0.25_ZrSi_6_O_16_(OH)_2_, a new mineral from Lovozero massif (Kola peninsuJa) and the new data on the genetic crystallochemistry of the lovozerite group, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 132(6), 1-14 Chemical formula revised: Pekov I V, Krivovichev S V, Zolotarev A A, Yakovenchuk V N, Armbruster T, Pakhomovsky Y A (2009) Crystal chemistry and nomenclature of the lovozerite group, European Journal of Mineralogy 21, 1061-1071</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Lovozerite-Zirsinalite–Lovozerite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CJ.15a</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si6O18]12- 6-membered single rings (sechser-Einfachringe), without insular complex anions</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Kapustinite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2003-018</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Thermal_Shock_Weathering">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">this vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Propagation of fractures near the surface of solid rock due to expansion and contraction caused by temperature changes. Fractures typically propagate along surfaces close to and subparallel to the surface of the outcrop.</rdfs:comment>
    <rdfs:label xml:lang="en">thermal shock weathering</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicprocess/Physical_Weathering"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/dellaite">
