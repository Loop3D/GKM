  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/huemulite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Huemulite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Mg | V | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/huemulite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;4&lt;/sub&gt;MgV&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;10&lt;/sub&gt;O&lt;sub&gt;28&lt;/sub&gt;·24H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1965-012</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1941</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1941:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1941.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;4&lt;/sub&gt;MgV&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;10&lt;/sub&gt;O&lt;sub&gt;28&lt;/sub&gt;·24H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Huemulite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Huemulite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Gordillo C E, Linares E, Toubes R O, Winchell H (1966) Huemulite, Na_4_MgV_10_O_28_·24H_2_O, a new hydrous sodium a magnesium vanadate from Huemul mine, Mendoza province, Argentina, American Mineralogist 51, 1-13</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.HG.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">V oxide, unclassified</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Huemulite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1965-012</gsmin:wikipediadate>
  </rdf:Description>
