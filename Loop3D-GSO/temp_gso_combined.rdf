  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/Subordinate_Proportion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Constituent is less abundant than dominant constituent, but present in sufficient abundance to be an obvious constituent</rdfs:comment>
    <rdfs:comment xml:lang="en">Example--in a typical granite, biotite is a subordinate constituent.</rdfs:comment>
    <rdfs:label xml:lang="en">Subordinate Constituent</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Proportion_Value"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/chabazite-sr">
