    <gsmin:chemistryelements>Pt | Te | Bi</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">melonite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/moncheite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pt(Te,Bi)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2754</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2754:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2754.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pt(Te,Bi)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Moncheite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Moncheite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Genkin A D, Zhuravlev N N, Smirnova E M (1963) Moncheite and kotulskite - new minerals - and the composition of michenerite, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 92(1), 33-50</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Melonite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.EA.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide, M: S &lt;= 1:2 with Cu, Ag, Au</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Moncheite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1963</gsmin:wikipediadate>
  </rdf:Description>
