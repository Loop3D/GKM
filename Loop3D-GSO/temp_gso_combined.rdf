    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaFe&lt;sup&gt;3+&lt;/sup&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)F</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1987-044</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Sodium ironIII arsenate fluoride</gsmin:iupacchemname>
    <gsmin:mindatid>min-2605</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2605:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2605.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaFe&lt;sup&gt;3+&lt;/sup&gt;As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;F</gsmin:rruffchemistry>
    <gsmin:rruffids>R060955</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Maxwellite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Maxwellite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Foord E E, Hlava P F, Fitzpatrick J J, Erd R C, Hinton R W (1991) Maxwellite and squawcreekite, two new minerals from the Black Range Tin district, Catron County, New Mexico, U.S.A., Neues Jahrbuch für Mineralogie, Monatshefte 1991, 363-384 Jambor J L, Vanko D A (1992) New mineral names, American Mineralogist 77, 446-452</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Titanite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BH.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH,etc.):RO4 = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Maxwellite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1987-044</gsmin:wikipediadate>
  </rdf:Description>
