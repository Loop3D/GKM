  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/sverigeite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Sverigeite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Be | Mn | Sn | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/sverigeite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaBe&lt;sub&gt;2&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;SnSi&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;(OH)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1983-066</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Sodium diberyllium dimanganeseII tin trinesosilicate hydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-3839</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3839:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3839.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaBe&lt;sub&gt;2&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;SnSi&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;(OH)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sverigeite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Sverigeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Dunn P J, Peacor D R, Simmons W B, Gaines R V (1984) Sverigeite, a new tin beryllium silicate mineral from Långban, Värmland, Sweden, Geologiska Föreningens i Stockholm Förhandlingar 106, 175-177</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.AE.15</gsmin:strunzcodeV10>
