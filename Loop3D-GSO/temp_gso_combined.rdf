    <gsmin:chemistryelements>K | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">halite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/sylvite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KCl</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3850</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3850:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3850.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KCl</gsmin:rruffchemistry>
    <gsmin:rruffids>R050166</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sylvite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Sylvite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Described, but not given a name: Smithson J (1823) A discovery of chloride of potassium in the Earth, The Annals of Philosophy 6, 258-259 Beudant F S (1832) Sylvine, muriate de potasse, in Traité Élémentaire de Minéralogie, 2nd Edition, (Paris) 511-511</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Rocksalt</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>03.AA.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Simple halides, without H2O, M:X 1:&lt;2</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Sylvite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1823</gsmin:wikipediadate>
  </rdf:Description>
