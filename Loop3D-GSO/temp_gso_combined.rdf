  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/stringhamite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Stringhamite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Cu | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/stringhamite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaCu(SiO&lt;sub&gt;4&lt;/sub&gt;)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1974-007</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Calcium copper nesosilicate monohydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-3802</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3802:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3802.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaCu&lt;sup&gt;2+&lt;/sup&gt;SiO&lt;sub&gt;4&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060934 | R110018</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Stringhamite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Stringhamite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hindman J R (1976) Stringhamite, a new hydrous copper calcium silicate from Utah, American Mineralogist 61, 189-192</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.AE.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with additional anions (O,OH,F,H2O); cations in tetrahedral [4] coordination</gsmin:strunzlabel>
