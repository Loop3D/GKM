    <gsmin:chemistryelements>Cu | Tl | Se</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/crookesite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;7&lt;/sub&gt;TlSe&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Heptacopper thallium tetraselenide</gsmin:iupacchemname>
    <gsmin:mindatid>min-1159</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1159:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1159.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;7&lt;/sub&gt;TlSe&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R061025</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Crookesite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Crookesite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Nordenskiöld A E (1867) Sur les minéraux sélénifères et thallifères de Skrikerum, Bulletin Mensuel de la Société Chimique de Paris 7, 409-414</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.BD.50</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide M:S &gt; 1:1 with Hg, Tl</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Crookesite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1867</gsmin:wikipediadate>
