  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/krasnoite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Krásnoite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Al | Si | P | O | H | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;3&lt;/sub&gt;Al&lt;sub&gt;7.7&lt;/sub&gt;Si&lt;sub&gt;3&lt;/sub&gt;P&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;22.9&lt;/sub&gt;(OH)&lt;sub&gt;13.3&lt;/sub&gt;F&lt;sub&gt;2&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2011-040</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-42373</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:42373:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-42373.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;3&lt;/sub&gt;Al&lt;sub&gt;7.7&lt;/sub&gt;Si&lt;sub&gt;3&lt;/sub&gt;P&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;23.5&lt;/sub&gt;(OH)&lt;sub&gt;12.1&lt;/sub&gt;F&lt;sub&gt;2&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R120056</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Krásnoite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Krasnoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mills S J, Sejkora J, Kampf A R, Grey I E, Bastow T J, Ball N A, Adams P M, Raudsepp M, Cooper M A (2012) Krásnoite, the fluorophosphate analogue of perhamite, from the Huber open pit, Czech Republic and the Silver Coin mine, Nevada, USA, Mineralogical Magazine 76, 625-634</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Perhamite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DO.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With CO3, SO4, SiO4</gsmin:strunzlabel>
    <gsmin:wikipediadate>2011-040</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/oskarssonite">
