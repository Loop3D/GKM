    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3366:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3366.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)(CO&lt;sub&gt;3&lt;/sub&gt;)·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070287</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Rapidcreekite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Rapidcreekite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Roberts A C, Ansell H G, Jonasson I R, Grice J D, Ramik R A (1986) Rapidcreekite, a new hydrated calcium sulfate-carbonate from the Rapid Creek area, Yukon Territory, The Canadian Mineralogist 24, 51-54</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.DG.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With large and medium-sized cations; with NO3, CO3, B(OH)4, SiO4 or IO3</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Rapidcreekite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1984-035</gsmin:wikipediadate>
