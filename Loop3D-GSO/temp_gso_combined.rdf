    <gsmin:rruffnameplain xml:lang="en">Para-alumohydrocalcite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Srebrodol´skii V I (1977) Para-alumhydrocalcite, a new mineral, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 106, issue 3, 336-337 Fleischer M, Pabst A, White J S (1978) New mineral names, American Mineralogist 63, 793-796</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Alumohydrocalcite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>05.DB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions and H2O, With large and medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://webmineral.com/data/Para-alumohydrocalcite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1976-027</gsmin:wikipediadate>
  </rdf:Description>
