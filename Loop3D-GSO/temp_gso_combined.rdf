    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:733:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-733.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">MgFe&lt;sup&gt;3+&lt;/sup&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)·7H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070362 | R070581</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Botryogen</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Botryogen</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Haidinger W (1828) Ueber den Botryogen, oder den rothen Eisenvitriol von Fahlun, Annalen der Physik und Chemie 12, 491-494</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Botryogen</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.DC.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With only medium-sized cations; chains of edge-sharing octahedra</gsmin:strunzlabel>
