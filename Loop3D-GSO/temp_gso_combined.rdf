    <gsmin:rruffnameplain xml:lang="en">Okruschite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chukanov N V, Möhn G, Pekov I V, Belakovskiy D I, Bychkova Y V, Gurzhiy V V, Lorenz J A (2014) Okruschite, Ca_2_Mn^2+^_5_Be_4_(AsO_4_)_6_(OH)_4_·6H_2_O, a new roscherite-group mineral from Sailauf, Bavaria, Germany. European Journal of Mineralogy 26, 589-595</gsmin:statusnotes>
