    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(CaLa&lt;sub&gt;5&lt;/sub&gt;)(Al&lt;sub&gt;4&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;)[Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;][SiO&lt;sub&gt;4&lt;/sub&gt;]&lt;sub&gt;5&lt;/sub&gt;O(OH)&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2018-107</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Pending publication</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(CaLa&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;)(Al&lt;sub&gt;4&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;)[Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;][SiO&lt;sub&gt;4&lt;/sub&gt;]&lt;sub&gt;5&lt;/sub&gt;O(OH)&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
