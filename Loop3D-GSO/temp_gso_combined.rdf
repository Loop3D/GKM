    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3750:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3750.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pd&lt;sub&gt;3&lt;/sub&gt;Sn&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
