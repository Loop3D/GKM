    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2662:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2662.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R050612 | R060434 | R060476</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Meta-autunite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Meta-autunite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named métaautunite: Gaubert M P (1904) Produits de déshydratation de quelques phosphates et orientation du chlorure de baryum sur les minéraux du groupe de l´autunite, Bulletin de la Société Française de Minéralogie 27, 222-233</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Meta-autunite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.EB.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl phosphate or arsenate, UO2:RO4 = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Meta-autunite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1904</gsmin:wikipediadate>
