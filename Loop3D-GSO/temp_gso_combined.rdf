  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/lillianite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Lillianite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Ag | Bi | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/lillianite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;3-2x&lt;/sub&gt;Ag&lt;sub&gt;x&lt;/sub&gt;Bi&lt;sub&gt;2+x&lt;/sub&gt;S&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Grandfathered</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Trilead dibismuth hexasulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-2400</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2400:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2400.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;3-2x&lt;/sub&gt;Ag&lt;sub&gt;x&lt;/sub&gt;Bi&lt;sub&gt;2+x&lt;/sub&gt;S&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R110141</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Lillianite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Lillianite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Keller H F (1890) Ueber kobellit von Ouray, Colorado, und über die chemische zusammensetzung dieser species, Zeitschrift für Krystallographie und Mineralogie 17, 67-72 Chemical formula revised: Moëlo Y, Makovicky E, Mozgova N N, Jambor J L, Cook N, Pring A, Paar W, Nickel E H, Graeser S, Karup-Møller S, Balic-Zunic T, Mumme W G, Vurro F, Topa D, Bindi L, Bente K, Shimizu M (2008) Sulfosalt systematics: a review. Report of the sulfosalt sub-committee of the IMA Commission on Ore Mineralogy, European Journal of Mineralogy 20, 7-46</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Lillianite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.JB.40a</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">PbS type sulfosalt with Pb</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Lillianite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1890</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseHauterivianSP2020">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologiccontact/GSSP"/>
    <rdfs:comment xml:lang="en">Defined at the base of Bed 189 of the La Charce Section, Drôme, France. This level coincides with the first appearance of the ammonite genus Acanthodiscus which marks the base of the Acanthodiscus radiatus ammonite zone. The GSSP is located 550m west of the village of La Charce, Drôme, France at a latitude of 44.46944 N and a longitude of 5.44372 E.</rdfs:comment>
    <rdfs:label xml:lang="en">GSSP Base of Hauterivian</rdfs:label>
    <rdfs:seeAlso rdf:resource="https://timescalefoundation.org/gssp/detail.php?periodid=48&amp;top_parentid=35"/>
    <owl:versionInfo>2019</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/yanomamite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Yanomamite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>In | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">scorodite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/yanomamite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">In(AsO&lt;sub&gt;4&lt;/sub&gt;)·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1990-052</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Indium arsenate dihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-4352</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4352:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4352.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">In&lt;sup&gt;3+&lt;/sup&gt;As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060537</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Yanomamite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Yanomamite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Botelho N F, Roger G, d'Yvoire F, Moëlo Y, Volfinger M (1994) Yanomamite, InAsO_4_·2H_2_O, a new indium mineral from topaz-bearing greisen in the Goiás Tin Province, Brazil, European Journal of Mineralogy 6, 245-254</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.CD.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With only medium-sized cations, RO4:H2O = 1:2</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Yanomamite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1990-052</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/zanazziite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Zanazziite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Mg | Be | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">roscherite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/zanazziite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Be&lt;sub&gt;4&lt;/sub&gt;Mg&lt;sub&gt;5&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1986-054</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4385</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4385:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4385.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Mg&lt;sub&gt;5&lt;/sub&gt;Be&lt;sub&gt;4&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R050578 | R100220</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zanazziite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Zanazziite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Leavens P B, White J S, Nelen J A (1990) Zanazziite a new mineral from Minas Gerais, Brazil, The Mineralogical Record 21, 413-417</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Roscherite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DA.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With small (and occasionally larger) cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Zanazziite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1986-054</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/redcanyonite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Redcanyonite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>N | H | Mn | U | O | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(NH&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;Mn[(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;](H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2016-082</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(N&lt;sup&gt;3-&lt;/sup&gt;H&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;[(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;](H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Redcanyonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Redcanyonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Olds T A, Plášil J, Kampf A R, Burns P C, Nash B P, Marty J, Rose T P, Carlson S M (2018) Redcanyonite, (NH_4_)_2_Mn[(UO_2_)_4_O_4_(SO_4_)_2_](H_2_O)_4_, a new zippeite-group mineral from the Blue Lizard mine, San Juan County, Utah, USA. Mineralogical Magazine 82, 1261-1275</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Zippeite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kalithallite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
