    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-373</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:373:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-373.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;F·20H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R100008</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Arsenuranospathite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Arsenuranospathite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Walenta K (1978) Uranospathite and arsenuranospathite, Mineralogical Magazine 42, 117-128 Chemical formula revised: Chukanov N V, Möckel S, Sidorenko G A, Zaitsev V A (2009) Arsenuranospathite, Al(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;F·20H&lt;sub&gt;2&lt;/sub&gt;O: Formula revision and relationships with allied uranyl arsenates and phosphates, Neues Jahrbuch für Mineralogie, Abhandlungen 185, 305-312</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.EB.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl phosphate or arsenate, UO2:RO4 = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Arsenuranospathite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1978</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/natroboltwoodite">
