    <gsmin:rruffnameplain xml:lang="en">Asbolane</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Breithaupt A (1841) Genus 8. Maurites. Species 1. Maurites, Asbolanus kürzer, Asbolan, in Vollständiges Handbuch der Mineralogie, Volume 2, Arnoldische Buchhandlung (Dresden und Leipzig) 332-334</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.FL.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Hydroxide (without V or U), Hydroxides with H2O±(OH); sheets of edge-sharing octahedra</gsmin:strunzlabel>
