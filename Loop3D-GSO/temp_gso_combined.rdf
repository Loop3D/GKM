  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Organic_Rich_Sediment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">SLTTs 2004</dct:source>
    <rdfs:comment xml:lang="en">Sediment with color, composition, texture and apparent density indicating greater than 50 percent organic content by weight on a moisture-free basis.</rdfs:comment>
    <rdfs:comment xml:lang="en">The broader relation from organic rich sediment to biogenic sediment is based on the inference that organic rich material is always biogenic in origin. Biogenic is a broader category because not all biogenic materials are organic rich, for example shells or phosphatic bone.</rdfs:comment>
    <rdfs:label xml:lang="en">organic rich sediment</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Biogenic_Sediment"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Organic_Rich_Sedimentary_Material"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/marklite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Marklite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | C | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;5&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2015-101</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Pending publication</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Marklite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Marklite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Plášil, J., Kampf, A.R., Keuper, M. and Škoda, R. (2016) Marklite, IMA 2015-101. CNMNC Newsletter No. 29, February 2016, page 204; Mineralogical Magazine, 80, 199–205</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/Northgrippian2020">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologictime/Age"/>
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Specific_Geologic_Time_Unit"/>
    <rdfs:comment xml:lang="en">older bound -0.0082 Ma</rdfs:comment>
    <rdfs:comment xml:lang="en">younger bound -0.0042 Ma</rdfs:comment>
