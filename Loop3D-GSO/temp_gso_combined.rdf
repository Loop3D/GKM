  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/wavellite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Wavellite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Al | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/wavellite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Trialuminium diphosphate trihydroxyl pentahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-4250</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4250:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4250.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R040176 | R050219</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Wavellite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Wavellite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Given two names, wavellite and hydrargillite: Davy H (1805) An account of some analytical experiments on a mineral production from Devonshire, consisting principally of alumine and water, Philosophical Transactions of the Royal Society of London 95, 155-162</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Wavellite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DC.50</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With only medium-sized cations, (OH, etc.):RO4 = 1:1 and &lt; 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Wavellite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1805</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/manaevite-ce">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Manaevite-(Ce)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Ce | H | O | Mg | Al | Fe | Ti | Si</gsmin:chemistryelements>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;11&lt;/sub&gt;(Ce,H&lt;sub&gt;2&lt;/sub&gt;O,Ca)&lt;sub&gt;8&lt;/sub&gt;Mg(Al,Fe)&lt;sub&gt;4&lt;/sub&gt;(Mg,Ti,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;8&lt;/sub&gt;[Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;]&lt;sub&gt;4&lt;/sub&gt;[(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;8&lt;/sub&gt;(H&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;](OH)&lt;sub&gt;9&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2018-046</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Pending publication</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;11&lt;/sub&gt;(Ce,H&lt;sub&gt;2&lt;/sub&gt;O,Ca)&lt;sub&gt;8&lt;/sub&gt;Mg(Al,Fe)&lt;sub&gt;4&lt;/sub&gt;(Mg,Ti,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;8&lt;/sub&gt;[Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;]&lt;sub&gt;4&lt;/sub&gt;[(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;8&lt;/sub&gt;(H&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;](OH)&lt;sub&gt;9&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Manaevite-(Ce)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Manaevite-(Ce)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Moiseev, M.M., Panikorovskii, T.L., Aksenov, S.M., Mazur, A.S., Mikhailova, J.A., Yakovenchuk, V.N., Bazai, A.V., Ivanyuk, G.Y., Agakhanov, A.A., Shilovskikh, V.V., Pekov, I.V., Kasatkin, A.V., Rusakov, V.S., Yapaskurt, V.O., Karpenko, V.Y. and Krivovichev, S.V. (2018) Manaevite-(Ce), IMA 2018-046. CNMNC Newsletter No. 45, October 2018, page xxx; Mineralogical Magazine, 82, xxx-xxx</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Vesuvianite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/fluoro-edenite">
