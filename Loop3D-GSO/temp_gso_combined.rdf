  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/mangano-ferri-eckermannite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Mangano-ferri-eckermannite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Mn | Fe | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">amphibole-group 4 Na</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaNa&lt;sub&gt;2&lt;/sub&gt;(Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;)Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1968-028</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaNa&lt;sub&gt;2&lt;/sub&gt;(Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;)Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070122</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mangano-ferri-eckermannite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Mangano-ferri-eckermannite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Nambu M, Tanida K, Kita T (1969) Kôzulite, a new alkali amphibole from Tanohata Mine, Iwate Prefecture, Japan, Journal of the Japanese Association of Mineralogists, Petrologists and Economic Geologists 62, 311-328 Name changed from kôzulite: Hawthorne F C, Oberti R, Harlow G E, Maresch W V, Martin R F, Schumacher J C, Welch M D (2012) Nomenclature of the amphibole supergroup. American Mineralogist 97, 2031-2048</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Amphibole</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfault/Sinistral">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">GGIC vocabularies working group (Australia)</dct:source>
    <rdfs:comment xml:lang="en">In plan view the side opposite the observer is displaced to the left.</rdfs:comment>
    <rdfs:label xml:lang="en">sinistral</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfault/Fault_Movement_Sense"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/granularmaterial/Granular_Particle_Material">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">NADM SLTTs 2004</dct:source>
    <rdfs:comment xml:lang="en">Material consisting of a collection of pre-existing objects (particles, grains) before incorporation into a particulate aggregate. \...a component of solid material that has the form of grains, clasts, fragments, or whole objects of any size, shape, composition, texture, and structure.\ (NADMSC SLTTs, 2004)</rdfs:comment>
    <rdfs:label xml:lang="en">Granular particle material</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Rock_Grain_Material"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/granularmaterial/Crystal_Fragment_Particle_Material">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">this vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Granular material consisting of crystal fragments interpreted to have been broken by pyroclastic processes.</rdfs:comment>
    <rdfs:label xml:lang="en">crystal fragment particle material</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/granularmaterial/Pyroclastic_Particle_Material"/>
  </rdf:Description>
