  <rdf:Description rdf:about="https://w3id.org/gso/1.0/granularmaterial/resorbed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf, K.K.E, Mehl, J.P. &amp; Jackson, J.A. (eds), 2005. Glossary of geology, 5th Edition. American Geological Institute, Alexandria, 779 p.</dct:source>
    <rdfs:comment xml:lang="en">Particles have smooth, embayed boundaries caused by resorption by the host magma</rdfs:comment>
