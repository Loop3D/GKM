    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3148:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3148.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaMg&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060160 | R060270</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Penikisite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Penikisite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mandarino J A, Sturman B D, Corlett M I (1977) Penikisite, the magnesium analogue of kulanite, from Yukon Territory, The Canadian Mineralogist 15, 393-395</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Bjarebyite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BH.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH,etc.):RO4 = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Penikisite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1976-023</gsmin:wikipediadate>
