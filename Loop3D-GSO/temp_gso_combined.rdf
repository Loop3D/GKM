  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/magnesiocopiapite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Magnesiocopiapite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mg | Fe | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">copiapite</gsmin:fleischersgroup>
