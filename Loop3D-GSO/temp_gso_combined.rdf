    <gsmin:rruffnameplain xml:lang="en">Chambersite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Honea R M, Beck F R (1962) Chambersite, a new mineral, American Mineralogist 47, 665-671</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Boracite</gsmin:structuralgroup>
