  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/volcanicglass">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">a mixture of cryptocrystalline grains of silica minerals in a glass-like suspension, a super-cooled liquid. (https://www.mindat.org/min-8519.html)</rdfs:comment>
    <rdfs:label xml:lang="en">volcanic glass </rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/mineral/glass"/>
    <skos:prefLabel xml:lang="en">volcanic glass </skos:prefLabel>
    <gsmin:mindaturl>https://www.mindat.org/min-8519.html</gsmin:mindaturl>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/seidite-ce">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Seidite-(Ce)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ce | Sr | Ti | Si | O | H | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;4&lt;/sub&gt;(Ce,Sr)&lt;sub&gt;2&lt;/sub&gt;TiSi&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;(O,OH,F)&lt;sub&gt;6&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1993-029</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-7284</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7284:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7284.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;4&lt;/sub&gt;(Ce&lt;sup&gt;3+&lt;/sup&gt;,Sr)&lt;sub&gt;2&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;(O,OH,F)&lt;sub&gt;6&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Seidite-(Ce)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Seidite-(Ce)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Khomyakov A P, Ferraris G, Belluso E, Britvin S N, Nechelyustov G N, Soboleva S V (1998) Seidite-(Ce), Na_4_SrCeTiSi_8_O_22_F·5H_2_O, a new mineral with zeolitic properties, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 127(4), 94-100</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.DJ.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 4-periodic double and triple chains</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Seidite-%28Ce%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1993-029</gsmin:wikipediadate>
  </rdf:Description>
