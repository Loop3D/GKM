    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;3&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;F&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Tricalcium dialuminium decafluoride dihydroxyl hydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-4353</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4353:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4353.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;3&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;F&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Yaroslavite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Yaroslavite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Novikova M I, Sidorenko G A, Kuznetsova M N (1966) Yaroslavite a new calcium aluminum fluoride, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 95(1), 39-44</gsmin:statusnotes>
    <gsmin:strunzcodeV10>03.CB.50</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Neso-aluminofluoride</gsmin:strunzlabel>
