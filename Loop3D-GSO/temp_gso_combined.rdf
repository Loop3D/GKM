    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;1-x&lt;/sub&gt;O&lt;sub&gt;3-2x&lt;/sub&gt;(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;4+2x&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1587</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1587:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1587.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;1-x&lt;/sub&gt;O&lt;sub&gt;3-2x&lt;/sub&gt;(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;4+2x&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R100187</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fourmarierite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Fourmarierite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Buttgenbach H (1924) Minéralogie du Congo Belge. La fourmariérite, nouvell espèce minérale, Annales de la Société Géologique de Belgique 47, C41-C43</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.GB.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl hydroxide, With additional cations (K, Ca, Ba, Pb, etc.); with mainly UO2(O,OH)5 pentagonal polyhedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Fourmarierite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1924</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/hydroxycalcioromeite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Hydroxycalcioroméite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Sb | Ti | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/lewisite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Sb&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;(Sb&lt;sup&gt;5+&lt;/sup&gt;,Ti)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;(OH)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:mindatid>min-40366</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:40366:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-40366.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Sb&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;(Sb&lt;sup&gt;5+&lt;/sup&gt;,Ti&lt;sup&gt;4+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;(OH)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hydroxycalcioroméite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hydroxycalcioromeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named lewisite: Hussak E, Prior G T (1895) Lewisite and zirkelite, two new Brazilian minerals. Mineralogical Magazine 11, 80-88 Name changed from lewisite, and mineral redefined: Atencio D, Andrade M B, Christy A G, Gieré R, Kartashov P M (2010) The pyrochlore supergroup of minerals: nomenclature, The Canadian Mineralogist 48, 673-698</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Pyrochlore-Roméite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, hydroxide or arsenite</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://webmineral.com/data/Lewisite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1895</gsmin:wikipediadate>
  </rdf:Description>
