  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/colusite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Colusite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | V | As | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">germanite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/colusite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;13&lt;/sub&gt;VAs&lt;sub&gt;3&lt;/sub&gt;S&lt;sub&gt;16&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dodecacopper vanadium arsenide hexadecasulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-1113</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1113:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1113.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;1+&lt;/sup&gt;&lt;sub&gt;12&lt;/sub&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;V&lt;sup&gt;3+&lt;/sup&gt;As&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;16&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070568</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Colusite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Colusite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named by Sales (1914), but not formally described. Landon R E, Mogilnor A H (1933) Colusite, a new mineral of the sphalerite group, American Mineralogist 18, 528-533 Chemical formula revised from (Cu,Fe,Mo,Sn)&lt;sub&gt;4&lt;/sub&gt;(S,As,Te)&lt;sub&gt;3-4&lt;/sub&gt;: Spry P G, Merlino S, Wang S, Zhang X, Buseck P R (1994) New occurrences and refined crystal chemistry of colusite, with comparisons to arsenosulvanite, American Mineralogist 79, 750-762</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Germanite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.CB.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide (M = S) with Zn, Fe, Cu, Ag, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Colusite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1914</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kenyaite">
