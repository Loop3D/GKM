    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Thermessaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Thermessaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Demartin F, Gramaccioli C M, Campostrini I, Orlandi P (2008) Thermessaite, K2[AlF3 SO4], a new ino-aluminofluoride-sulfate from La Fossa crater, Vulcano, Aeolian Islands, Italy, The Canadian Mineralogist 46, 693-700</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Thermessaite</gsmin:structuralgroup>
