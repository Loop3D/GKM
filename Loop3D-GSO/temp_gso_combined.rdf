    <gsmin:rruffnameplain xml:lang="en">Liebenbergite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">de Waal S A, Calk L C (1973) Nickel minerals from Barberton, South Africa: Vl. Liebenbergite, a nickel olivine, American Mineralogist 58, 733-735</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Olivine</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AC.05</gsmin:strunzcodeV10>
