  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/homilite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Homilite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Fe | B | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">gadolinite-datolite-gadolinite subgroup</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/homilite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;B&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1926</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1926:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1926.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;B&lt;sub&gt;2&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Homilite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Homilite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Paijkull S R (1876) Homilit, ett mineral från Brevig i Norge, Geologiska Föreningens i Stockholm Förhandlingar 3, 229-232</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Gadolinite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AJ.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with BO3 triangles and/or B[4], Be[4] tetrahedra, cornersharing with SiO4</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Homilite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1876</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/weissite">
