  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/nagyagite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Nagyágite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Sb | S | Au | Te</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/nagyagite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">[Pb&lt;sub&gt;3&lt;/sub&gt;(Pb,Sb)&lt;sub&gt;3&lt;/sub&gt;S&lt;sub&gt;6&lt;/sub&gt;](Au,Te)&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2830</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2830:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2830.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">[Pb(Pb,Sb)S&lt;sub&gt;2&lt;/sub&gt;][(Au,Te)]</gsmin:rruffchemistry>
    <gsmin:rruffids>R060723 | R060865</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nagyágite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Nagyagite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Haidinger W (1845) Zweite Klasse: Geogenide. XIV. Ordnung. Glanze. V. Eutomglanz. Nagyagit., in Handbuch der Bestimmenden Mineralogie, Bei Braumüller and Seidel (Wien) 563-570 Chemical formula revised: Effenberger H, Paar W H, Topa D, Culetto F J, Giester G (1999) Toward the crystal structure of nagyagite, [Pb(Pb,Sb)S2][(Au,Te)], American Mineralogist 84, 669-676</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.HB.20a</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">SnS type sulfosalt with Cu, Ag, Fe, Sn and Pb</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Nagyagite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1845</gsmin:wikipediadate>
  </rdf:Description>
