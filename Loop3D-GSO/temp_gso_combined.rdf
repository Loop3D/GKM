    <rdfs:subClassOf rdf:nodeID="n7bda25761fc44f8595ef751309700190b292"/>
    <rdfs:subClassOf rdf:nodeID="n7bda25761fc44f8595ef751309700190b293"/>
    <rdfs:subClassOf rdf:nodeID="n7bda25761fc44f8595ef751309700190b294"/>
    <owl:disjointWith rdf:resource="https://w3id.org/gso/1.0/common/Time_Region"/>
    <owl:equivalentClass rdf:nodeID="n7bda25761fc44f8595ef751309700190b295"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/nickelhexahydrite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Nickelhexahydrite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ni | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">hexahydrite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/nickelhexahydrite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ni(SO&lt;sub&gt;4&lt;/sub&gt;)·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Nickel sulfate hexahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2889</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2889:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2889.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ni&lt;sup&gt;2+&lt;/sup&gt;S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060596</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nickelhexahydrite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Nickelhexahydrite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Oleinikov B V, Shvartsev S L, Mandrikova N T, Oleinikova N N (1965) Nickelhexahydrite, a new mineral, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 94, issue 5, 534-547 Fleischer M (1966) New mineral names, American Mineralogist 51, 529-534</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hexahydrite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.CB.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, with H2O, With only medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Nickelhexahydrite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1965</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/delindeite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Delindeite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ba | Ti | Na | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">bafertisite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/delindeite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba&lt;sub&gt;2&lt;/sub&gt;Ti&lt;sub&gt;2&lt;/sub&gt;(Na&lt;sub&gt;2&lt;/sub&gt;&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)Ti(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1987-004</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:mindatid>min-1252</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1252:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1252.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba&lt;sub&gt;2&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(Na&lt;sub&gt;2&lt;/sub&gt;&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)Ti&lt;sup&gt;4+&lt;/sup&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Delindeite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Delindeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Appleman D E, Evans H T, Nord G L, Dwornik E J, Milton C (1987) Delindeite and lourenswalsite, two new titanosilicates from the Magnet Cove region, Arkansas, Mineralogical Magazine 51, 417-425 Chemical formula redefined: Sokolova E, Cámara F (2007) From structure topology to chemical composition. II. Titanium silicates: revision of the crystal structure and chemical formula of delindeite, The Canadian Mineralogist 45, 1247-1261</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Seidozerite-Lamprophyllite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.BE.60</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate: Si2O7 groups, with additional anions; cations in octahedral [6] and greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Delindeite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1987-004</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/quality/Diameter">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">The (approximate) average length of line segments that pass through the center of an object and whose endpoints lie on the outside boundary of the object. Use to characterize the size of a broadly spheroidal object like a pluton or a rock sample.</rdfs:comment>
    <rdfs:label xml:lang="en">Diameter </rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Physical_Quality"/>
  </rdf:Description>
