    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Brodtkorbite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Brodtkorbite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Paar W H, Topa D, Roberts A C, Amann G, Sureda R J (2002) The new mineral species brodtkorbite, Cu&lt;sub&gt;2&lt;/sub&gt;HgSe&lt;sub&gt;2&lt;/sub&gt;, and the associated selenide assemblage from Tuminico, Sierra De Cacho, La Rioja, Argentina, The Canadian Mineralogist 40, 225-237</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.BD.55</gsmin:strunzcodeV10>
