    <gsmin:mindaturl>http://www.mindat.org/min-6857.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Sr,Ca)&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;4&lt;/sub&gt;Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;·11H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
