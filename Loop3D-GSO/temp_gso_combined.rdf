  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/balangeroite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Balangeroite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mg | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic, unknown, triclinic, orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/balangeroite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;21&lt;/sub&gt;Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;27&lt;/sub&gt;(OH)&lt;sub&gt;20&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1982-002</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-492</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:492:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-492.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;21&lt;/sub&gt;Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;27&lt;/sub&gt;(OH)&lt;sub&gt;20&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060244</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Balangeroite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Balangeroite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Compagnoni R, Ferraris G, Fiora L (1983) Balangeroite, a new fibrous silicate related to gageite from Balangero, Italy, American Mineralogist 68, 214-219</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.DH.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 4-periodic single chains, Si4O12</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Balangeroite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1982-002</gsmin:wikipediadate>
