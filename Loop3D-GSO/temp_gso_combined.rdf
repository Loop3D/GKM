    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba(Al,Mg)(PO&lt;sub&gt;4&lt;/sub&gt;,CO&lt;sub&gt;3&lt;/sub&gt;)(OH)&lt;sub&gt;2&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1991-020</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-7145</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7145:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7145.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba(Al,Mg)(PO&lt;sub&gt;4&lt;/sub&gt;,CO&lt;sub&gt;3&lt;/sub&gt;)(OH)&lt;sub&gt;2&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R080115</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Krasnovite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Krasnovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Britvin S N, Pakhomovskii Y A, Bogdonova A N (1996) Krasnovite Ba(Al,Mg)(PO_4_,CO_3_)(OH)_2_·H_2_O – a new mineral, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 125(3), 110-112</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.DK.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 &gt; 1:1 and &lt; 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Krasnovite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1991-020</gsmin:wikipediadate>
