  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicunit/Subgreenschist_Metamorphic_Facies">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">subgreenschist metamorphic facies</rdfs:label>
    <dct:source xml:lang="en">Smulikowski et al. 2003; Fettes and Desmons, 2007</dct:source>
    <rdfs:comment xml:lang="en">Metamorphic facies characterized in rocks of basaltic composition by prehnite-pumpellyite, pumpellyite-actinolite, prehnite-actinolite (prehnite and pumpellyite are the diagnostic Ca-Al silicates rather than minerals of the epidote or zeolite groups).</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicunit/Metamorphic_Facies"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfoliation/compound_foliation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Foliation that includes fabric elements indicating classification with foliation types of different genetic origin, e.g. cleavage parallel to bedding is a compound fabric with a sedimentary foliation and a tectonic foliation. No connotation of genetic origin of fabric elements.</rdfs:comment>
    <dct:source xml:lang="en">CGI foliationtype SKOS vocabulary 2018-08-03</dct:source>
    <rdfs:label xml:lang="en">compound foliation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicstructure/Foliation"/>
  </rdf:Description>
