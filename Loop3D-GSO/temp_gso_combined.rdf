    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)(OH)&lt;sub&gt;10&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Renamed|Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;SO&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;10&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Metauranopilite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Metauranopilite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Palache C, Berman H, Frondel C (1951) 31.1.11 Meta-uranopilite [(UO2)6(SO4(OH)10·5H2O], in The System of Mineralogy, Volume II, Seventh Edition, John Wiley and Sons, Inc (New York) 582-583 Name changed from meta-uranopilite: Burke E A J (2008) Tidying up mineral names: an IMA-CNMNC scheme for suffixes, hyphens and diacritical marks, The Mineralogical Record 39, 131-135</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/dickinsonite-kmnna">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Dickinsonite-(KMnNa)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Na | Mn | Ca | Al | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">dickinsonite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/dickinsonite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K(NaMn)CaNa&lt;sub&gt;3&lt;/sub&gt;AlMn&lt;sub&gt;13&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;12&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2005-048</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1286</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1286:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1286.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K(NaMn&lt;sup&gt;2+&lt;/sup&gt;)CaNa&lt;sub&gt;3&lt;/sub&gt;AlMn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;13&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;12&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R160071</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Dickinsonite-(KMnNa)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Dickinsonite-(KMnNa)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Brush G J, Dana E S (1878) On a new and remarkable mineral locality in Fairfield County, Connecticut; with a description of several new species occurring there. First Paper., American Journal of Science and Arts 16, 33-46; 114-123 Name changed from dickinsonite: Chopin C, Oberti R, Camara F (2006) The arrojadite enigma: II. Compositional space, new members, and nomenclature of the group, American Mineralogist 91, 1260-1270</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Arrojadite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BF.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH, etc.):RO4&lt; 0.5:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://webmineral.com/data/Dickinsonite-(KMnNa).shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1878, 2005-048</gsmin:wikipediadate>
  </rdf:Description>
