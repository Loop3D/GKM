    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;9&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;8&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;·9H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Redefined|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: NonamanganeseII triironIII octaphosphate trihydroxyl nonahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2318</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2318:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2318.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;9&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;8&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;·9H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Landesite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Landesite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Berman H, Gonyer F A (1930) Pegmatite minerals in Poland, Maine, American Mineralogist 15, 375-387 Chemical formula redefined: Moore P B (1964) Investigations of landesite, American Mineralogist 49, 1122-1125</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Reddingite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CC.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With only medium-sized cations, RO4:H2O = 1:1.5</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Landesite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1930</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/nielsbohrite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
