    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaLiZrSi&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;15&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1976-034</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4390</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4390:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4390.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaLiZr&lt;sup&gt;4+&lt;/sup&gt;Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;15&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070485</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zektzerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Zektzerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Dunn P J, Rouse R C, Cannon B, Nelen J A (1977) Zektzerite: a new lithium sodium zirconium silicate related to tuhualite and the osumilite group, American Mineralogist 62, 416-420</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.DN.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 6-periodic double chains</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Zektzerite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1976-034</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/souzalite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
