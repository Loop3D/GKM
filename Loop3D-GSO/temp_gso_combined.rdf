    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2254:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2254.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Mg,Fe&lt;sup&gt;2+&lt;/sup&gt;,Al,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)&lt;sub&gt;10&lt;/sub&gt;(Si,Al,B)&lt;sub&gt;5&lt;/sub&gt;O&lt;sub&gt;21&lt;/sub&gt;(OH,F)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050214 | R100155</gsmin:rruffids>
