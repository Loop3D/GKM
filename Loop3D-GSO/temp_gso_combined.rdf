    <gsmin:statusnotes xml:lang="en">Plášil, J., Kampf, A.R., Sejkora, J., Škoda, R. and Tvrdý, J. (2017) Horákite, IMA2017-033. CNMNC Newsletter No. 38, August 2017, page 1036; Mineralogical Magazine, 81, 1033–1038</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/burnsite">
