    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nukundamite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Nukundamite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Rice C M, Atkin D, Bowles J F W, Criddle A J (1979) Nukundamite, a new mineral, and idaite, Mineralogical Magazine 43, 193-200 Fleischer M, Cabri L J, Pabst A (1980) New mineral names, American Mineralogist 65, 406-408</gsmin:statusnotes>
