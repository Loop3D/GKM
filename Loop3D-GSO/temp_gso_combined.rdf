  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicunit/Glaucophane_Schist_Facies">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">glaucophane schist facies</rdfs:label>
    <dct:source xml:lang="en">Smulikowski et al. 2003; Fettes and Desmons, 2007</dct:source>
    <rdfs:comment xml:lang="en">Metamorphic facies characterized in rocks of basaltic composition by glaucophane-epidote (-garnet), glaucophane-lawsonite, or glaucophane-lawsonite-jadeite.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicunit/Metamorphic_Facies"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/orthominasragrite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Orthominasragrite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>V | O | S | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/orthominasragrite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">V&lt;sup&gt;4+&lt;/sup&gt;O(SO&lt;sub&gt;4&lt;/sub&gt;)·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2000-018</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-11007</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:11007:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-11007.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">V&lt;sup&gt;4+&lt;/sup&gt;O(SO&lt;sub&gt;4&lt;/sub&gt;)·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060974</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Orthominasragrite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Orthominasragrite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hawthorne F C, Schindler M, Grice J D, Haynes P (2001) Orthominasragrite, V^4+^O(SO_4_)·(H_2_O)_6_, a new mineral species from Temple Mountain, Emery County, Utah, USA, The Canadian Mineralogist 39, 1325-1331</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Minasragrite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.DB.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With only medium-sized cations; insular octahedra and finite units</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Orthominasragrite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2000-018</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/merenskyite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Merenskyite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pd | Te</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">melonite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/merenskyite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">PdTe&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1965-016</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Palladium ditelluride</gsmin:iupacchemname>
    <gsmin:mindatid>min-2650</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2650:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2650.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">PdTe&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Merenskyite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Merenskyite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kingston G A (1966) The occurence of platinoid bismuthotellurides in the Merensky Reef at Rustenburg platinum mine in the western Bushveld, Mineralogical Magazine 35, 815-835</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Melonite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.EA.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide, M: S &lt;= 1:2 with Cu, Ag, Au</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Merenskyite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1965-016</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/serendibite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Serendibite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Mg | Al | O | Si | B</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">aenigmatite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/serendibite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;4&lt;/sub&gt;[Mg&lt;sub&gt;6&lt;/sub&gt;Al&lt;sub&gt;6&lt;/sub&gt;]O&lt;sub&gt;4&lt;/sub&gt;[Si&lt;sub&gt;6&lt;/sub&gt;B&lt;sub&gt;3&lt;/sub&gt;Al&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;36&lt;/sub&gt;]</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3623</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3623:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3623.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;4&lt;/sub&gt;(Mg&lt;sub&gt;6&lt;/sub&gt;Al&lt;sub&gt;6&lt;/sub&gt;)O&lt;sub&gt;4&lt;/sub&gt;[Si&lt;sub&gt;6&lt;/sub&gt;B&lt;sub&gt;3&lt;/sub&gt;Al&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;36&lt;/sub&gt;]</gsmin:rruffchemistry>
    <gsmin:rruffids>R070622 | R070633 | R120069</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Serendibite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Serendibite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Prior G T, Coomáraswámy A K (1903) Serendibite, a new borosilicate from Ceylon, Mineralogical Magazine 13, 224-227 Chemical formula revised: Grew E S, Hålenius U, Pasero M, Barbier J (2008) Recommended nomenclature for the sapphirine and surinamite group (sapphirine supergroup), Mineralogical Magazine 72, 839-876</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Sapphirine</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DH.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 4-periodic single chains, Si4O12</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Serendibite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1903</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/balestraite">
