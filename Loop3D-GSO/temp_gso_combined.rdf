    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1708:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1708.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaMn&lt;sup&gt;2+&lt;/sup&gt;SiO&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Glaucochroite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Glaucochroite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Penfield S L, Warren C H (1899) Some new minerals from the zinc mines at Franklin, N.J., and note concerning the chemical composition of ganomalite, American Journal of Science 8, 339-353</gsmin:statusnotes>
