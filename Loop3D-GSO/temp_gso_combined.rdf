    <gsmin:statusnotes xml:lang="en">Kampf A R, Alves P, Kasatkin A, Škoda R (2019) Jahnsite-(MnMnZn), a new jahnsite-group mineral, and formal approval of the jahnsite group. European Journal of Mineralogy 31, 167-172</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Jahnsite</gsmin:structuralgroup>
  </rdf:Description>
