    <gsmin:mindaturl>http://www.mindat.org/min-27571.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;3&lt;/sub&gt;(Si,Al)&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)(OH)&lt;sub&gt;6&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060894</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Niksergievite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Niksergievite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Saburov S P, Britvin S N, Bekenova G K, Sergieva M N, Kotelnikov P E, Chukanov N V, Yagovkina M A (2005) Niksergievite, [Ba1.33Ca0.67Al(CO3)(OH)4][Al2(AlSi3O10)(OH)2]·nH2O, a new phyllosilicate related to the surite-ferrisurite series, American Mineralogist 90, 1163-1166</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.EC.75</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with mica sheets, composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
