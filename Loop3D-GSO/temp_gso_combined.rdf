    <gsmin:rruffnameplain xml:lang="en">Amblygonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Breithaupt A (1818) Gattung B. Amblygonit, in Handbuch der Mineralogie von C. A. S. Hoffmann, Volume 4, Craz und Gerlach (Freiberg) 159-161</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Titanite-Amblygonite</gsmin:structuralgroup>
