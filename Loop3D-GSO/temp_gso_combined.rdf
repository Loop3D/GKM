    <gsmin:rruffids>R070578 | R080016</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Acanthite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Acanthite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kenngott A (1855) Ueber den akanthit, eine neue species in dem geschlechte der silber-glanze, Annalen der Physik und Chemie 95, 462-464</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Acanthite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.BA.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide M:S &gt; 1:1 with Cu, Ag, Au</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Acanthite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1855</gsmin:wikipediadate>
  </rdf:Description>
