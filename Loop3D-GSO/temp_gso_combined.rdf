  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/parageorgbokiite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Parageorgbokiite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | O | Se | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;5&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(SeO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;Cl&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2006-001</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-29093</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:29093:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-29093.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(Se&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;Cl&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Parageorgbokiite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Parageorgbokiite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Vergasova L P, Krivovichev S V, Filatov S K, Britvin S N, Berns P K, Ananyev V V (2006) Parageorgbokiite, ß-Cu_5_O_2_(SeO_3_)_2_Cl_2_ - a new mineral from volcanic Exhalation (Kamchatka Peninsula, Russia), Zapiski Rossiiskogo Mineralogicheskogo Obshchetstva 135(4), 24-28</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.JG.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Selenite with additional anions, without H2O</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Parageorgbokiite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2006-001</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/pharmacoalumite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Pharmacoalumite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Al | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">pharmacosiderite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/alumopharmacosiderite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KAl&lt;sub&gt;4&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·6.5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1980-002</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Renamed|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-158</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:158:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-158.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KAl&lt;sub&gt;4&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·6.5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060411</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pharmacoalumite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Pharmacoalumite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Schmetzer K, Horn W, Bank H (1981) Alumopharmacosiderite, KAl4(AsO4)3(OH)4·6.5H2O, a new mineral, Neues Jahrbuch für Mineralogie, Monatshefte 1981, 97-102 Name changed from alumopharmacosiderite to pharmacoalumite: Rumsey M S, Mills S J, Spratt J (2010) Natropharmacoalumite, NaAl4[(OH)4(AsO4)3]·4H2O, a new mineral of the pharmacosiderite supergroup and the renaming of aluminopharmacosiderite to pharmacoalumite, Mineralogical Magazine 74, 929-936</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Pharmacosiderite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DK.12</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 &gt; 1:1 and &lt; 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Alumopharmacosiderite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1980-002</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/siderazot">
