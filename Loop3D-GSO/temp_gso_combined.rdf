    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;8&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)(SO&lt;sub&gt;3&lt;/sub&gt;OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Octapotassium sulfate hexahydrogen sulfate</gsmin:iupacchemname>
