    <gsmin:rruffnameplain xml:lang="en">Ferrochiavennite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Grice J D, Kristiansen R, Friis H, Rowe R, Poirier G G, Selbekk R S, Cooper M A, Larsen A O (2013) Ferrochiavennite, a new beryllium silicate zeolite from syenite pegmatites in the Larvik Plutonic Complex, Oslo Region, Southern Norway, The Canadian Mineralogist 51, 285-296</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/mendeleevite-ce">
