  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/gartrellite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Gartrellite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Cu | Fe | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">tsumcorite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/gartrellite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">PbCuFe&lt;sup&gt;3+&lt;/sup&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1988-039</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Lead copper ironIII diarsenate hydroxyl monohydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1654</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1654:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1654.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060881</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Gartrellite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Gartrellite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Nickel E H, Robinson B W, FitzGerald O, Birch W D (1989) Gartrellite, a new secondary arsenate mineral from Ashburton Downs, W.A. and Broken Hill, N.S.W., Australian Mineralogist 4, 83-89 Chemical formula redefined: Krause W, Belendorff K, Bernhardt H J, McCammon C A, Effenberger H, Mikenda W (1998) Crystal chemistry of the tsumcorite-group minerals. New data on ferrilotharmeyerite, tsumcorite, thometzekite, mounanaite, helmutwinklerite, and a redefinition of gartrellite, European Journal of Mineralogy 10, 179-206</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Helmutwinklerite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CG.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With large and medium-sized cations, RO4:H2O = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Gartrellite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1988-039</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/bikitaite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Bikitaite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Li | Al | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic, monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">zeolite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/bikitaite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">LiAlSi&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-670</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:670:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-670.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">LiAlSi&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R050160 | R060032</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bikitaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Bikitaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hurlbut C S (1957) Bikitaite, LiAlSi&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O, a new mineral from Southern Rhodesia, American Mineralogist 42, 792-797</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.GD.55</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Zeolite family: Chains of 6-membered rings – tabular zeolites</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Bikitaite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1957</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/cancrisilite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cancrisilite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Si | Al | O | C | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">cancrinite-sodalite-cancrinite subgroup</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/cancrisilite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;7&lt;/sub&gt;(Si&lt;sub&gt;7&lt;/sub&gt;Al&lt;sub&gt;5&lt;/sub&gt;)O&lt;sub&gt;24&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1990-013</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-881</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:881:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-881.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;7&lt;/sub&gt;(Si&lt;sub&gt;7&lt;/sub&gt;Al&lt;sub&gt;5&lt;/sub&gt;)O&lt;sub&gt;24&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cancrisilite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cancrisilite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Khomyakov A P, Semenov E I, Pobedimskaya E A, Nadezhina T N, Rastsvetaeva R K (1991) Cancrisilite Na&lt;sub&gt;7&lt;/sub&gt;[Al&lt;sub&gt;5&lt;/sub&gt;Si&lt;sub&gt;7&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;]CO&lt;sub&gt;3&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O - a new mineral of the cancrinite group, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 120(6), 80-84</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Cancrinite-sodalite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.FB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Tektosilicate with additional anions</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Cancrisilite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1990-013</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/demicheleite-cl">
