    <gsmin:statusnotes xml:lang="en">Penfield S L, Jamieson G S (1905) On tychite, a new mineral from Borax Lake, California, and on its artificial production and its relations to northupite, American Journal of Science 20, 217-224</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Northupite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>05.BF.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions, without H2O, With (Cl), SO4, PO4, TeO3</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Tychite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1905</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologictime/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:comment xml:lang="en">generated by S.M.Richard for Loop3D project</rdfs:comment>
    <rdfs:comment xml:lang="en">generic definition of time ordinal eras and older boundaries for eras, based on all eras defined in ISC 2020 time scale. The intention is to define generic time scale concepts to unify the materialization of those concepts in different versions of the time scale. Each specific materialization is linked to the unifying element as 'part of'. </rdfs:comment>
    <rdfs:label xml:lang="en">Geoscience Ontology, Geologic Timescale Framework</rdfs:label>
    <owl:imports rdf:resource="https://w3id.org/gso/1.0/common/ontology"/>
    <owl:imports rdf:resource="https://w3id.org/gso/1.0/geologicunit/ontology"/>
    <owl:imports rdf:resource="https://w3id.org/gso/1.0/geology/ontology"/>
    <owl:imports rdf:resource="https://w3id.org/gso/1.0/qudt/voc/ontology"/>
    <owl:versionInfo xml:lang="en">2021-03-10</owl:versionInfo>
    <dct:bibliographicCitation>Brodaric, B., and Richard, S.M., 2021, The GeoScience Ontology Reference, Geologic Time: Geological Survey of Canada Open File 8796, 34 p., https://doi.org/10.4095/328296</dct:bibliographicCitation>
    <skos:definition xml:lang="en">Defines named ordinal eras and their older boundaries that are used to build the geologic time scale, without anchoring to particular geologic features</skos:definition>
    <skos:prefLabel xml:lang="en">Geoscience Ontology, Geologic Timescale Framework</skos:prefLabel>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-10</dct:created>
    <dct:creator rdf:resource="https://w3id.org/gso/1.0/common/stephen_richard"/>
    <dct:creator rdf:resource="https://w3id.org/gso/1.0/common/boyan_brodaric"/>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/legalcode"/>
    <schema:codeRepository>https://github.com/Loop3D/GKM</schema:codeRepository>
    <dct:rights>Copyright (c) 2021 Government of Canada</dct:rights>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-26</dct:modified>
    <dct:publisher>ARC Loop3D project;  https://loop3d.org/</dct:publisher>
    <dct:publisher>Geological Survey of Canada, Natural Resources Canada, Government of Canada</dct:publisher>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/brenkite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Brenkite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | C | O | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/brenkite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)F&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1977-036</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dicalcium carbonate difluoride</gsmin:iupacchemname>
    <gsmin:mindatid>min-764</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:764:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-764.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)F&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060247</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Brenkite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Brenkite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hentschel G, Leufer U, Tillmans E (1978) Brenkite, a new calcium fluor-carbonate from Schellkopf, Eifel, Neues Jahrbuch für Mineralogie, Monatshefte 1978, 325-329</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.BC.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions, without H2O, With alkali-earth cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Brenkite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1977-036</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/rauenthalite">
