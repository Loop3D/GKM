    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;7&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;26&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O (?)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1967-043</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Questionable mineral species|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Heptamagnesium tetraironIII hexacosahydroxyl monohydrate</gsmin:iupacchemname>
