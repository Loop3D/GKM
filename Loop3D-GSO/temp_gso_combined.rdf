    <gsmin:rruffnameplain xml:lang="en">Shimazakiite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kusachi I, Kobayashi S, Takechi Y, Nakamuta Y, Nagase T, Yokoyama K, Momma K, Miyawaki R, Shigeoka M, Matsubara S (2013) Shimazakiite-4M and shimazakiite-4O, Ca_2_B_2_O_5_, two polytypes of a new mineral from Fuka, Okayama Prefecture, Japan, Mineralogical Magazine 77, 93-105</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.AJ.??</gsmin:strunzcodeV10>
