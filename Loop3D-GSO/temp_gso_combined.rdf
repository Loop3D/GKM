    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7129:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7129.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;Al&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kastningite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kastningite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Schlüter J, Klaska K H, Friese K, Adiwidjaja G (1999) Kastningite, (Mn,Fe,Mg)Al_2_(PO_4_)_2_(OH)_2_·8H_2_O, a new phosphate mineral from Waidhaus, Bavaria, Germany, Neues Jahrbuch für Mineralogie, Monatshefte 1999, 40-48</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Stewartite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DC.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With only medium-sized cations, (OH, etc.):RO4 = 1:1 and &lt; 2:1</gsmin:strunzlabel>
