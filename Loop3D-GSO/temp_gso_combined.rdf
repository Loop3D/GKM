  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/hydrokenomicrolite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Hydrokenomicrolite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>H | O | Ta</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;,H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;2&lt;/sub&gt;Ta&lt;sub&gt;2&lt;/sub&gt;(O,OH)&lt;sub&gt;6&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2011-103</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;,H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;2&lt;/sub&gt;Ta&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(O,OH)&lt;sub&gt;6&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hydrokenomicrolite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hydrokenomicrolite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Andrade M B, Atencio D, Chukanov N V, Ellena J (2013) Hydrokenomicrolite, ([box],H_2_O)_2_Ta_2_(O,OH)_6_(H_2_O), a new microlite-group mineral from Volta Grande pegmatite, Nazareno, Minas Gerais, Brazil, American Mineralogist 98, 292-296</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Pyrochlore-microlite</gsmin:structuralgroup>
  </rdf:Description>
