    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Sodium calcium aluminium hexafluoride monohydrate</gsmin:iupacchemname>
