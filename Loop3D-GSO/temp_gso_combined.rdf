  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologiccontact/Geophysical_Contact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI contacttype SKOS vocabulary 2012-11-24</dct:source>
    <rdfs:comment xml:lang="en">A contact separating bodies of material in the earth that have different geophysical properties. Use for boundaries that are detected by geophysical sensor techniques as opposed to direct lithologic observation.</rdfs:comment>
    <rdfs:label xml:lang="en">geophysical contact</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologiccontact/Contact"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/mutuallySpecDependsOn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:comment xml:lang="en">Mutual specific dependence: the relata specifically depend on each other.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/specificallyDependsOn"/>
  </rdf:Description>
