  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/hydrohonessite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Hydrohonessite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ni | Fe | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">woodwardite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/hydrohonessite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ni&lt;sub&gt;1-x&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;x&lt;/sub&gt;)(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;x/2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O (x &lt; 0.5, n &gt; 3x/2)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1980-037a</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1978</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1978:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1978.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ni&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;1-x&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;x&lt;/sub&gt;)(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;x/2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O (x &lt; 0.5, n &gt; 3x/2)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hydrohonessite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hydrohonessite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Nickel E H, Wildman J E (1981) Hydrohonessite - a new hydrated Ni-Fe hydroxy-sulphate mineral; its relationship to honessite, carrboydite, and minerals of the pyroaurite group, Mineralogical Magazine 44, 333-337 Chemical formula revised from (Ni,Fe^3+^)_9_(SO_4_)_2_(OH)_18_·7H_2_O: Mills S J, Christy A G, Génin J -M R, Kameda T, Colombo F (2012) Nomenclature of the hydrotalcite supergroup: natural layered double hydroxides. Mineralogical Magazine 76, 1289-1336</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hydrotalcite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.DD.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With only medium-sized cations; sheets of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Hydrohonessite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1980-037a</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/aspedamite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
