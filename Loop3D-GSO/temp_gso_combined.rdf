    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3234:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3234.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al&lt;sub&gt;6&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;3&lt;/sub&gt;OH)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;8&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R080123</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Planerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Planerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hermann R (1862) Untersuchungen einiger neuer Russischer mineralien. 1. Ueber planerit, ein neues mineral, Bulletin de la Société Impériale des Naturalistes de Moscou 35, 240-243 Redefined: Foord E E, Taggart J E (1998) A reexamination of the turquoise group: the mineral aheylite, planerite (redefined), turquoise and coeruleolactite, Mineralogical Magazine 62, 93-111</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Turquoise</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DD.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With only medium-sized cations, (OH, etc.):RO4= 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Planerite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1862</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/karelianite">
