  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/eckhardite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Eckhardite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Pb | Cu | Te | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Pb)Cu&lt;sup&gt;2+&lt;/sup&gt;Te&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;5&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2012-085</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Pb&lt;sup&gt;2+&lt;/sup&gt;)Cu&lt;sup&gt;2+&lt;/sup&gt;Te&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;5&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Eckhardite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Eckhardite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf A R, Mills S J, Housley R M, Rossman G R, Marty J, Thorne B (2013) Lead-tellurium oxysalts from Otto Mountain near Baker, California: XI. Eckhardite, (Ca,Pb)Cu^2+^Te^6+^O_5_(H_2_O), a new mineral with HCP stair-step layers. American Mineralogist 98, 1617-162</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kanoite">
