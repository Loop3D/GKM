    <gsmin:fleischersgroup xml:lang="en">ilmenite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/melanostibite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;(Sb&lt;sup&gt;5+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;)O&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2631</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2631:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2631.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;(Sb&lt;sup&gt;5+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;)O&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Melanostibite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Melanostibite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named melanostibian: Igelström L J (1893) Melanostibian, ein neues mineral von der Manganerzgrube Sjögrufvan, Kirchspiel Grythyttan, Gouvernement Örebro, Schweden, Zeitschrift für Krystallographie und Mineralogie 21, 246-248</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Corundum</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.CB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 2: 3,3: 5, and similar, With medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Melanostibite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1893</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/olympite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
