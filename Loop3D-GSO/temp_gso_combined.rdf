  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/plumboagardite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Plumboagardite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Pb | La | Nd | Ce | Ca | As | O | H</gsmin:chemistryelements>
