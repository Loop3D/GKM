    <gsmin:rruffids>R060146 | R070538</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Childrenite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Childrenite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Brooke H J A (1823) On some undescribed minerals. Childrenite, The Quarterly Journal of Science, Literature, and the Arts 16, 274-277</gsmin:statusnotes>
