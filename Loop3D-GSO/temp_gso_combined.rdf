    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">PbMn&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(VO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1998-044</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Lead dimanganeseIII divanadate dihydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-7059</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7059:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7059.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;Mn&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(V&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Krettnichite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Krettnichite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Brugger J, Armbruster T, Criddle A J, Berlepsch P, Graeser S, Reeves S (2001) Description, crystal structure, and paragenesis of krettnichite, PbMn^3+^_2_(VO_4_)_2_(OH)_2_, the Mn^3+^ analogue of mounanaite, European Journal of Mineralogy 13, 145-158</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Natrochalcite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CG.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With large and medium-sized cations, RO4:H2O = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Krettnichite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1998-044</gsmin:wikipediadate>
  </rdf:Description>
