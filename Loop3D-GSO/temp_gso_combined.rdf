    <gsmin:rruffnameplain xml:lang="en">Reederite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Grice J D, Gault R A, Chao G Y (1995) Reederite-(Y), a new sodium rare-earth carbonate mineral with a unique fluorosulfate anion, American Mineralogist 80, 1059-1064</gsmin:statusnotes>
