    <gsmin:strunzcodeV10>09.GB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Zeolite family: Chains of single connected 4-membered rings</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Analcime.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1797</gsmin:wikipediadate>
