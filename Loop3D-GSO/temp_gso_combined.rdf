  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ulrichite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ulrichite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Cu | U | O | P | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/ulrichite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaCu(UO&lt;sub&gt;2&lt;/sub&gt;)(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1988-006</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4088</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4088:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4088.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaCu&lt;sup&gt;2+&lt;/sup&gt;(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)(P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070748</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ulrichite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ulrichite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Birch W D, Mumme W G, Segnit E R (1988) Ulrichite: a new copper calcium uranium phosphate from Lake Boga, Victoria, Australia, Australian Mineralogist 3, 125-131</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.EA.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl phosphate or arsenate, UO2:RO4 = 1:2</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Ulrichite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1988-006</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Upper_Mantle_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al., 2005</dct:source>
    <rdfs:comment xml:lang="en">That part of the mantle which lies above a depth of about 660 km and has a density of 3.4 g/cm3 to 4.0 g/cm3 with increasing depth. Similarly, P-wave velocity increases from about 8 to 11 km/sec with depth and S wave velocity increases from about 4.5 to 6 km/sec with depth. It is presumed to be peridotitic in composition. It includes the subcrustal lithosphere the asthenosphere and the transition zone,</rdfs:comment>
    <rdfs:label xml:lang="en">upper mantle setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Mantle_Setting"/>
    <rdfs:subClassOf rdf:nodeID="nb91377c629b1476ba973ba249cd56575b83"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/giorgiosite">
