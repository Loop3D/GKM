    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Co(SO&lt;sub&gt;4&lt;/sub&gt;)·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1963-009</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Cobalt sulfate tetrahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-282</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:282:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-282.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Co&lt;sup&gt;2+&lt;/sup&gt;S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Aplowite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Aplowite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Jambor J L, Boyle R W (1965) Moorhouseite and aplowite, new cobalt minerals from Walton, Nova Scotia, The Canadian Mineralogist 8, 166-171</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Starkeyite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.CB.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, with H2O, With only medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Aplowite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1963-009</gsmin:wikipediadate>
  </rdf:Description>
