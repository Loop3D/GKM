  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kyrgyzstanite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kyrgyzstanite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Zn | Al | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">chalcoalumite</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">ZnAl&lt;sub&gt;4&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)(OH)&lt;sub&gt;12&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2004-024</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Zinc tetraaluminium sulfate dodecahydroxyl trihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-27476</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:27476:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-27476.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sup&gt;2+&lt;/sup&gt;Al&lt;sub&gt;4&lt;/sub&gt;S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;12&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kyrgyzstanite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kyrgyzstanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Agakhanov A A, Karpenko V Y, Pautov L A, Bekenova G K (2005) Kyrgyzstanite, ZnAl_4_(SO_4_)(OH)_12_·3H_2_O, a new mineral form the Kara-Tangi deposit, Kirgizia, New Data on Minerals. Moscow 40, 23-28</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Chalcoalumite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.DD.75</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With only medium-sized cations; sheets of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Kyrgyzstanite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2004-024</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/rosieresite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Rosièresite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Cu | Al | P | O | H</gsmin:chemistryelements>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/rosieresite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">[Pb,Cu,Al,PO&lt;sub&gt;4&lt;/sub&gt;,H&lt;sub&gt;2&lt;/sub&gt;O] (?)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Questionable mineral species|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3459</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3459:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3459.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;x&lt;/sub&gt;Cu&lt;sub&gt;y&lt;/sub&gt;Al&lt;sub&gt;z&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;m&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Rosièresite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Rosieresite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">The mineral is described but not named: Berthier M P (1841) Analyse d'un phosphate d'alumine plombifère de rosières (département du Tarn), Annales des Mines 19, 669-674 The mineral is named: Lacroix A (1910) Rosiérésite, Minéralogie de la France et de ses Colonies 4, 532-533</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.DF.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With only medium-sized cations, (OH,etc.):RO4 &gt; 3:1</gsmin:strunzlabel>
    <gsmin:wikipediadate>0</gsmin:wikipediadate>
  </rdf:Description>
