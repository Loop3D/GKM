    <gsmin:rruffids>R040018 | R040052 | R040057 | R050117 | R060539 | R060535 | R060551 | R100099 | R100100 | R100101 | R100140</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Forsterite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Forsterite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Levy M (1824) Observations on the preceding paper, with an account of a new mineral, The Annals of Philosophy 7, 59-62</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Olivine</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AC.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate without additional anions; cations in octahedral [6] coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Forsterite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1824</gsmin:wikipediadate>
