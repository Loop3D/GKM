    <gsmin:imanumber xml:lang="en">IMA1981-023</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: TricopperII carbonate tetrahydroxyl terahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1057</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1057:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1057.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Cu&lt;sup&gt;2+&lt;/sup&gt;,Zn&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;15&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)(OH)&lt;sub&gt;14&lt;/sub&gt;·7H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R110020</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Claraite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Claraite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Walenta K, Dunn P J (1982) Clarait, ein neues Karbonatmineral aus der Grube Clara (mittlerer Schwarzwald), Chemie der Erde 41, 97-102 Chemical formula revised from Cu^2+^_3_CO_3_(OH)_4_·4H_2_O to (Cu,Zn)_15_(CO_3_)_4_(AsO_4_)_2_(SO_4_)(OH)_14_·7H_2_O: Biagioni C, Orlandi P (2017) Claraite, (Cu,Zn)_15_(AsO_4_)_2_(CO_3_)_4_(SO_4_)(OH)_14_·7H_2_O: redefinition and crystal structure. European Journal of Mineralogy 29, 1031-1044</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.DA.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions and H2O, With medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Claraite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1981-023</gsmin:wikipediadate>
  </rdf:Description>
