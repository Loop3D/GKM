    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2818:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2818.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;7&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;26&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Muskoxite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Muskoxite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Jambor J L (1969) Muckoxite, a new hydrous magnesium-ferric iron oxide from the Muskox Intrusion, Northwest Territories, Canada, American Mineralogist 54, 684-696</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hydrotalcite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.FL.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Hydroxide (without V or U), Hydroxides with H2O±(OH); sheets of edge-sharing octahedra</gsmin:strunzlabel>
