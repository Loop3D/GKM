    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sub&gt;5&lt;/sub&gt;(AsO&lt;sub&gt;3&lt;/sub&gt;OH)&lt;sub&gt;2&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2008-066</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Pentamanganese diarsenate dihydrogenarsenate tetrahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-39333</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:39333:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-39333.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;OH)&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070064</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Miguelromeroite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Miguelromeroite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf A R (2009) Miguelromeroite, the Mn analogue of sainfeldite, and redefinition of villyaellenite as an ordered intermediate in the sainfeldite-miguelromeroite series, American Mineralogist 94, 1535-1540</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hureaulite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CB.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With only medium-sized cations, RO4:H2O = 1:1</gsmin:strunzlabel>
    <gsmin:wikipediadate>2008-066</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/paracostibite">
