  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ferri-ghoseite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ferri-ghoseite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Mn | Mg | Fe | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">amphibole-group 3 Na-Ca</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;(NaMn&lt;sup&gt;2+&lt;/sup&gt;)(Mg&lt;sub&gt;4&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;)Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2003-066</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;(NaMn&lt;sup&gt;2+&lt;/sup&gt;)(Mg&lt;sub&gt;4&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;)Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ferri-ghoseite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ferri-ghoseite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Described with the since discredited name, tirodite: Oberti R, Ghose S (1993) Crystal-chemistry of a complex Mn-bearing alkali amphibole ("tirodite") on the verge of exsolution. European Journal of Mineralogy 5, 1153-1160 Mineral is named: Williams P A, Hatert F, Pasero M, Mills S J (2013) IMA Commission on new minerals, nomenclature and classification (CNMNC) Newsletter 15. New minerals and nomenclature modifications approved in 2012 and 2013. Mineralogical Magazine 77, 1-12</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Amphibole</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/laurelite">
