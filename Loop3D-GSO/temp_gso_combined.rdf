  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/dissakisite-la">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Dissakisite-(La)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | La | Mg | Al | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">epidote</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaLa(Al&lt;sub&gt;2&lt;/sub&gt;Mg)[Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;][SiO&lt;sub&gt;4&lt;/sub&gt;]O(OH)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2003-007</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-27401</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:27401:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-27401.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaLaMgAl&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)(SiO&lt;sub&gt;4&lt;/sub&gt;)O(OH)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Dissakisite-(La)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Dissakisite-(La)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Tumiati S, Godard G, Martin S, Nimis P, Mair V, Boyer B (2005) Dissakisite-(La) from the Ulten zone peridotite (Italian Eastern Alps): A new end-member of the epidote group, American Mineralogist 90, 1177-1185</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Epidote</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.BG.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate with mixed SiO4 and Si2O7 groups; cations in octahedral [6] and greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://webmineral.com/data/Dissakisite-(La).shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2003-007</gsmin:wikipediadate>
  </rdf:Description>
