    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Fe | Mg | Cu | As | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;7&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;,Mg,Cu)&lt;sub&gt;4&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2013-033</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;7&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;,Mg,Cu&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;4&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Yurmarinite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Yurmarinite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pekov I V, Zubkova N V, Yapaskurt V O, Belakovskiy D I, Lykova I S, Vigasina M F, Sidorov E G, Pushcharovsky D Yu (2014) New arsenate minerals from the Arsenatnaya fumarole, Tolbachik volcano, Kamchatka, Russia. I. Yurmarinite, Na_7_(Fe^3+^,Mg,Cu)_4_(AsO_4_)_6_. Mineralogical Magazine 78, 905-917</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Yurmarinite</gsmin:structuralgroup>
  </rdf:Description>
