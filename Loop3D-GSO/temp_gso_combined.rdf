    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K(Mg&lt;sub&gt;2&lt;/sub&gt;Na)Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;F&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2001-063</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-11435</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:11435:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-11435.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K(Mg&lt;sub&gt;2&lt;/sub&gt;Na)Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;F&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Shirokshinite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Shirokshinite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pekov I V, Chukanov N V, Ferraris G, Ivaldi G, Pushcharovsky D Y, Zadov A E (2003) Shirokshinite, K(NaMg2)Si4O10F2, a new mica with octahedral Na from Khidiny massif, Kola Peninsula: descriptive data and structural disorder, European Journal of Mineralogy 15, 447-454</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.EC.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with mica sheets, composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Shirokshinite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2001-063</gsmin:wikipediadate>
  </rdf:Description>
