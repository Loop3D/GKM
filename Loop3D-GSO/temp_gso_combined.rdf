  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/mccrillisite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Mccrillisite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Cs | Be | Li | Zr | P | O | H</gsmin:chemistryelements>
    <gsmin:fleischersgroup xml:lang="en">gainesite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/mccrillisite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaCs(Be,Li)Zr&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;·1-2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1991-023</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-7174</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7174:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7174.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaCs(Be,Li)Zr&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;·1-2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mccrillisite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Mccrillisite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Foord E E, Brownfield M E, Lichte F E, Davis A M, Sutley S J (1994) McCrillisite, NaCs(Be,Li)Zr_2_(PO_4_)_4_·1-2H_2_O, a new mineral species from Mount Mica, Oxford County, Maine, and new data for gainesite, The Canadian Mineralogist 32, 839-842</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.CA.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With small and large/medium cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Mccrillisite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1991-023</gsmin:wikipediadate>
