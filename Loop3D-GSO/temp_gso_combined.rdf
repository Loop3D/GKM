    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Nb | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic, cubic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">perovskite</gsmin:fleischersgroup>
