    <gsmin:wikipediadate>1979-028</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ericssonite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ericssonite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ba | Mn | Fe | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic, monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">lamprophyllite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/ericssonite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaMn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)O(OH)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1966-013</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Redefined|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1397</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1397:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1397.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaMn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)O(OH)</gsmin:rruffchemistry>
    <gsmin:rruffids>R070615 | R130001</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ericssonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ericssonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Moore P B (1967) Abstract of paper presented at the twelfth annual meeting: Eleven new minerals from Langban, Sweden, The Canadian Mineralogist 9, 301-301 Moore P B (1971) Ericssonite and orthoericssonite, two new members of the lamprophyllite group, from Långban, Sweden, Lithos 4, 137-145</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Ericssonite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.BE.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate: Si2O7 groups, with additional anions; cations in octahedral [6] and greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Ericssonite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1966-013</gsmin:wikipediadate>
  </rdf:Description>
