    <gsmin:rruffnameplain xml:lang="en">Eifelite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Abraham K, Gebert W, Medenbach O, Schreyer W, Hentschel G (1980) KNa_2_Mg_4.5_[Si_12_O_30_], ein neues mineral der milaritgruppe aus der Eifel, mit natrium in oktaederposition, Fortschritte der Mineralogie 58, 3-4</gsmin:statusnotes>
