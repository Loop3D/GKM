  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/Nonphysical_Endurant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">An endurant that does not occupy space directly, but might occupy space indirectly or not occupy space at all. Indirect spatial occupants have physical endurant parts or are ontologically dependent on physical endurants. Examples of things that indirectly occupy some space, due to such ontological dependence, include physical qualities (my height) and physical relators (reified physical relations). It even includes thoughts, poems, digital files, and datasets, whose existence is tied to being manifest in some physical object (brain, book, storage media). Also includes fictional entities such as unicorns, which must be so manifested to exist.</rdfs:comment>
    <rdfs:label xml:lang="en">Nonphysical Endurant</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Endurant"/>
    <rdfs:subClassOf rdf:nodeID="n7bda25761fc44f8595ef751309700190b151"/>
    <rdfs:subClassOf rdf:nodeID="n7bda25761fc44f8595ef751309700190b153"/>
    <rdfs:subClassOf rdf:nodeID="n7bda25761fc44f8595ef751309700190b154"/>
    <owl:disjointWith rdf:resource="https://w3id.org/gso/1.0/common/Physical_Endurant"/>
    <owl:equivalentClass rdf:nodeID="n7bda25761fc44f8595ef751309700190b155"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/schlossmacherite">
