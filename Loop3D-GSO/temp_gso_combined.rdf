    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Li | Ca | K | Be | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">zeolite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/pahasapaite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Li&lt;sub&gt;8&lt;/sub&gt;(Ca,Li,K)&lt;sub&gt;10&lt;/sub&gt;Be&lt;sub&gt;24&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;24&lt;/sub&gt;·38H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1983-060</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3062</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3062:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3062.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Li&lt;sub&gt;8&lt;/sub&gt;(Ca,Li,K)&lt;sub&gt;10.5&lt;/sub&gt;Be&lt;sub&gt;24&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;24&lt;/sub&gt;·38H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pahasapaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Pahasapaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Rouse R C, Peacor D R, Dunn P J, Campbell T J, Roberts W L, Wicks F J, Newbury D (1987) Pahasapaite, a beryllophosphate zeolite related to synthetic zeolite rho, from the Tip Top pegmatite of South Dakota, Neues Jahrbuch für Mineralogie, Monatshefte 1987, 433-440</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.CA.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With small and large/medium cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Pahasapaite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1983-060</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/voglite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
