    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7344:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7344.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;4&lt;/sub&gt;As&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;7&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tsugaruite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tsugaruite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Shimizu M, Miyawaki R, Kato A, Matsubara S, Matsuyama F, Kiyota K (1998) Tsugaruite, Pb4As2S7, a new mineral species from the Yunosawa mine, Aomori Prefecture, Japan, Mineralogical Magazine 62, 793-799</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.JB.30c</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">PbS type sulfosalt with Pb</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Tsugaruite.shtml</gsmin:webmineralurl>
