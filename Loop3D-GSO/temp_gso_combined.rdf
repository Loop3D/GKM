    <gsmin:mindaturl>http://www.mindat.org/min-7201.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CoSbAs</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Oenite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Oenite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Dobbe R T M, Zakrzewski M A (1998) Oenite, CoSbAs, a new mineral species from the Tunaberg Cu–Co–sulfide skarns, Bergslagen, Sweden, The Canadian Mineralogist 36, 855-860 Jambor J L, Roberts A C (1999) New Mineral Names, American Mineralogist 84, 990-994</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Löllingite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.EB.10f</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide, M: S &lt;= 1:2 with Fe, Co, Ni, PGE, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Oenite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1995-007</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/goldquarryite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Goldquarryite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Cd | Al | P | O | F | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CuCd&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;F&lt;sub&gt;3&lt;/sub&gt;·10H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2001-058</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Copper dicadmium trialuminium tetraphosphate trifluoride decahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-25588</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:25588:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-25588.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;Cd&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;F&lt;sub&gt;3&lt;/sub&gt;·10H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Goldquarryite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Goldquarryite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Roberts A C, Cooper M A, Hawthorne F C, Gault R A, Jensen M C, Foord E E (2003) Goldquarryite, a new Cd-bearing phosphate mineral from the Gold Quarry mine, Eureka County, Nevada, The Mineralogical Record 34, 237-240</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.DB.65</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With only medium-sized cations, (OH, etc.):RO4&lt; 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Goldquarryite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2001-058</gsmin:wikipediadate>
  </rdf:Description>
