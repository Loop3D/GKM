  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicunit/Lithologic_Unit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Lithologic unit</rdfs:label>
    <dct:source xml:lang="en">CGI geologicunittype SKOS vocabulary 2012-11-24</dct:source>
    <rdfs:comment xml:lang="en">A rock body defined by lithology independent of relationships to other units. Denotes a 'kind' of rock body characterized by lithology, e.g. basaltic rocks. Does not necessarily represent a single genetically related or connected package of material.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicunit/Nonstratigraphic_Unit"/>
    <owl:equivalentClass rdf:nodeID="n6d111a80c3f44937a55e40566db5bca3b30"/>
  </rdf:Description>
