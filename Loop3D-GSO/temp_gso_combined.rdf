    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2299:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2299.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaMn&lt;sup&gt;2+&lt;/sup&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060473</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kutnohorite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kutnohorite</gsmin:rruffnameplain>
