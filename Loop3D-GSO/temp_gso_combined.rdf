  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/mcgovernite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Mcgovernite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | Zn | As | O | Si | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/mcgovernite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sub&gt;19&lt;/sub&gt;Zn&lt;sub&gt;3&lt;/sub&gt;(AsO&lt;sub&gt;3&lt;/sub&gt;)(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;21&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2614</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2614:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2614.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;19&lt;/sub&gt;Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(As&lt;sup&gt;3+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;21&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R110030</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mcgovernite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Mcgovernite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Palache C, Bauer L H (1927) McGovernite, a new mineral from Sterling Hill, New Jersey, American Mineralogist 12, 373-374 Chemical formula revised: Dunn P J, Nelen J A (1980) Kraisslite and mcgovernite: new chemical data, American Mineralogist 65, 957-960</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hematolite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BE.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With only medium-sized cations, (OH, etc.):RO4 &gt; 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Mcgovernite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1927</gsmin:wikipediadate>
