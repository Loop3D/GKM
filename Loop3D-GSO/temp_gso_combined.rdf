    <rdfs:label xml:lang="en">Mellizinkalite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Zn | Cl</gsmin:chemistryelements>
