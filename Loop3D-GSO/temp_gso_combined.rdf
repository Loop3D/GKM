    <gsmin:rruffids>R050400</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cavansite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cavansite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Staples L W, Evans H T, Lindsay J R (1973) Cavansite and pentagonite, new dimorphous calcium vanadium silicate minerals from Oregon, American Mineralogist 58, 405-411</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.EA.50</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate: Single nets of tetrahedra with 4-, 5-, (6-), and 8-membered rings</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Cavansite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1967-019</gsmin:wikipediadate>
