    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Aluminium trichloride hexahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1012</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1012:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1012.html</gsmin:mindaturl>
