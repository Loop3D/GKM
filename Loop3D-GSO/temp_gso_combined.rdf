  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfault/Reverse_Fault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI faulttype SKOS vocabulary 2016-10-19</dct:source>
    <rdfs:comment xml:lang="en">Fault with dip-parallel displacement component of slip vector more than 10 times the strike-parallel component of the slip vector at at least one location along the mapped trace of the fault, and the fault dips consistently in the same direction with the hanging wall displaced up relative to the footwall over at least half the mapped trace of the fault.</rdfs:comment>
    <rdfs:label xml:lang="en">reverse fault</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfault/Fault"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/jungite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Jungite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Zn | Fe | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/jungite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Zn&lt;sub&gt;4&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;8&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;9&lt;/sub&gt;(OH)&lt;sub&gt;9&lt;/sub&gt;·16H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1977-034</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2122</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2122:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2122.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Zn&lt;sup&gt;2&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;8&lt;/sub&gt;(P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;9&lt;/sub&gt;(OH)&lt;sub&gt;9&lt;/sub&gt;·16H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Jungite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Jungite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Moore P B, Ito J (1980) Jungit und matulait: Zwei neue taflige phosphat-mineralien, Aufschluss 31, 55-61</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.DJ.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Jungite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1977-034</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/perrierite-la">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Perrierite-(La)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>La | Ce | Ca | Fe | Mn | Ti | Al | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">chevkinite</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(La,Ce,Ca)&lt;sub&gt;4&lt;/sub&gt;(Fe&lt;sup&gt;2+&lt;/sup&gt;,Mn)(Ti,Fe&lt;sup&gt;3+&lt;/sup&gt;,Al)&lt;sub&gt;4&lt;/sub&gt;[(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)O&lt;sub&gt;4&lt;/sub&gt;]&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2010-089</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-29144</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:29144:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-29144.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(La&lt;sup&gt;3+&lt;/sup&gt;,Ce&lt;sup&gt;3+&lt;/sup&gt;,Ca)&lt;sub&gt;4&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;(Ti&lt;sup&gt;4+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;4&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;8&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Perrierite-(La)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Perrierite-(La)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chukanov N V, Blass G, Pekov I V, Belakovskiy D I, Van K V, Rastsvetaeva R K, Aksenov S M (2011) Perrierite-(La) (La,Ce,Ca)&lt;sub&gt;4&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;(Ti,Fe)&lt;sub&gt;4&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;8&lt;/sub&gt; - a new mineral species from volcanic region Eifel, Germany, Zapiski Rossiiskogo Mineralogicheskogo Obshchetstva 140, 34-44</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Chevkinite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.BE.70</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate: Si2O7 groups, with additional anions; cations in octahedral [6] and greater coordination</gsmin:strunzlabel>
    <gsmin:wikipediadate>2010-089</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/irinarassite">
