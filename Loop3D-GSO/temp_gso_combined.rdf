    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:997:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-997.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;17&lt;/sub&gt;Si&lt;sub&gt;20&lt;/sub&gt;O&lt;sub&gt;54&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
