    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Quality that specifies a temporal location with a temporal coordinate or an xsd dateTime</rdfs:comment>
    <rdfs:label xml:lang="en">Time Instant Value </rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Temporal_Value"/>
    <rdfs:subClassOf rdf:nodeID="n7bda25761fc44f8595ef751309700190b492"/>
  </rdf:Description>
