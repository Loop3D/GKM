    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Chrysothallite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Chrysothallite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pekov I V, Zubkova N V, Belakovskiy D I, Yapaskurt V O, Vigasina M F, Lykova I S, Sidorov E G, Pushcharovsky D Y (2015) Chrysothallite K_6_Cu_6_Tl^3+^Cl_17_(OH)_4_·H_2_O, a new mineral species from the Tolbachik volcano, Kamchatka, Russia. Mineralogical Magazine 79, 365-376</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/popovite">
