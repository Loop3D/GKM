  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/senaite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Senaite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Mn | Y | U | Fe | Zn | Ti | Cr | V | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">crichtonite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/senaite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb(Mn,Y,U)(Fe,Zn)&lt;sub&gt;2&lt;/sub&gt;(Ti,Fe,Cr,V)&lt;sub&gt;18&lt;/sub&gt;(O,OH)&lt;sub&gt;38&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3617</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3617:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3617.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;(Mn&lt;sup&gt;2+&lt;/sup&gt;,Y&lt;sup&gt;3+&lt;/sup&gt;,U)(Fe&lt;sup&gt;2+&lt;/sup&gt;,Zn&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;(Ti&lt;sup&gt;4+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;,Cr&lt;sup&gt;3+&lt;/sup&gt;,V&lt;sup&gt;5+&lt;/sup&gt;)&lt;sub&gt;18&lt;/sub&gt;(O,OH)&lt;sub&gt;38&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060644</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Senaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Senaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hussak E, Prior G T (1898) On senaite, a new mineral belonging to the ilmenite group, from Brazil, Mineralogical Magazine 12, 30-32 Chemical formula revised: Wülser P-A, Brugger J, Meisser N (2004) The crichtonite group of minerals: a review of the classification, Bulletin de Liaison de la Société Francaise de Minéralogie et Cristallographie 16, 76-77</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Crichtonite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.CC.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 2: 3,3: 5, and similar, With large and medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Senaite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1898</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/simpsonite">
