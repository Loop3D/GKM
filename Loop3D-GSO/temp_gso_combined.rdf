  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/smolyaninovite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Smolyaninovite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Co | Fe | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/smolyaninovite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Co&lt;sub&gt;3&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;·11H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Tricobalt diironIII tetraarsenate undecahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-7298</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7298:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7298.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Co&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;·11H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Smolyaninovite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Smolyaninovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Yakhontova L K (1956) A new mineral - smolyaninovite, Doklady Akademii Nauk SSSR 109, 849-850 Chemical formula changed from Co_4_Fe^3+^_2_(AsO_4_)_4_·11H_2_O: Smith L K, Han K N, Lawson F (1977) On the occurrence of smolyaninovite in the Mount Cobalt deposit, in the north-western Queensland, Austrailia. Mineralogical Magazine 41, 385-388</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Smolyaninovite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CH.55</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With large and medium-sized cations, RO4:H2O &lt; 1:1</gsmin:strunzlabel>
