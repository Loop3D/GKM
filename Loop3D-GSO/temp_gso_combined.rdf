    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;10&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)(OH)&lt;sub&gt;24&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1965-011</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Decamagnesium diironIII carbonate tetracosahydroxyl dihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1095</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1095:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1095.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;10&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;CO&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;24&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R110196 | R110197</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Coalingite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Coalingite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mumpton F A, Jaffe H W, Thompson C S (1965) Coalingite, a new mineral from the New Idria serpentinite, Fresno and San Benito Counties, California, American Mineralogist 50, 1893-1913</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hydrotalcite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>05.DA.55</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions and H2O, With medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Coalingite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1965-011</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/parabrandtite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Parabrandtite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
