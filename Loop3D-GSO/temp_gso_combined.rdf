    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Azoproite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Azoproite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Konev A A, Lesedeva V S, Kashaev A A, Ushchapovskaya Z F (1970) Azoproite, a new mineral of the ludwigite group, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 99(2), 225-231 Note: This mineral is distinguished from ludwigite if Ti+Mg is greater than Fe&lt;sup&gt;3+&lt;/sup&gt; in the M4 site</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Ludwigite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>06.AB.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Monoborate, BO3, with additional anions; 1(D) + OH, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Azoproite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1970-021</gsmin:wikipediadate>
  </rdf:Description>
