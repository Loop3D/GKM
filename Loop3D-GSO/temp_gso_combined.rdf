  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/phuralumite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Phuralumite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Al | U | O | P | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">phosphuranylite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/phuralumite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al&lt;sub&gt;2&lt;/sub&gt;[(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O(OH)](OH)&lt;sub&gt;3&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;9</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1978-044</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3201</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3201:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3201.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al&lt;sub&gt;2&lt;/sub&gt;[(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O(OH)](OH)&lt;sub&gt;3&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;9</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Phuralumite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Phuralumite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Deliens M, Piret P (1979) Les phosphates d'uranyle et d'aluminium de Kobokobo. II. La phuralumite Al2(UO2)3(PO4)2(OH)6·10H2O et l'upalite Al (UO2)3 (PO4)2 (OH)3, nouveax minéraux, Bulletin de Minéralogie 102, 333-337 Chemical formula changed from Al_2_(UO_2_)_3_(PO_4_)_2_(OH)_6_·10H_2_O: Dal Bo F, Hatert F, Philippo S (2017) New crystallographic data and formula revision of phuralumite, Al_2_[(UO_2_)_3_(PO_4_)_2_O(OH)](OH)_3_(H_2_O)_9_. Journal of Geosciences 62, 87-95</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.EC.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl phosphate or arsenate, UO2:RO4 = 3:2</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Phuralumite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1978-044</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/garavellite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
