    <gsmin:rruffnameplain xml:lang="en">Greenalite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Leith C K (1903) The Mesabi iron-bearing district of Minnesota. Section II. The Biwabik Formation (iron-bearing), Monographs of the United States Geological Survey 43, 100-115</gsmin:statusnotes>
