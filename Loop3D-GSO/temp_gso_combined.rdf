    <gsmin:rruffids>R130126</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ottoite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ottoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf A R, Housley R M, Mills S J, Marty J, Thorne B (2010) Lead-tellurium oxysalts from Otto Mountain near Baker, California: I. Ottoite, Pb2TeO5, a new mineral with chains of tellurate octahedra, American Mineralogist 95, 1329-1336</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.??</gsmin:strunzcodeV10>
