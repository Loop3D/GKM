    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(Te&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)O&lt;sub&gt;2&lt;/sub&gt;Cl</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1980-072</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1432</gsmin:mindatid>
