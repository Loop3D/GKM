    <gsmin:rruffnameplain xml:lang="en">Santafeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Sun M S, Weber R H (1958) Santafeite, a new hydrated vanadate from New Mexico, American Mineralogist 43, 677-687 Chemical formula redefined: Dunn P J, Peacor D R (1986) Santafeite, a re-examination and new empirical formula, Mineralogical Magazine 50, 299-300</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.DM.40</gsmin:strunzcodeV10>
