    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">La(Y,U)Fe&lt;sub&gt;2&lt;/sub&gt;(Ti,Fe,Cr,V)&lt;sub&gt;18&lt;/sub&gt;(O,OH,F)&lt;sub&gt;38&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:mindatid>min-1234</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1234:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1234.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">La&lt;sup&gt;3+&lt;/sup&gt;(Y&lt;sup&gt;3+&lt;/sup&gt;,U&lt;sup&gt;4+&lt;/sup&gt;)Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(Ti&lt;sup&gt;4+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;,Cr&lt;sup&gt;3+&lt;/sup&gt;,V&lt;sup&gt;5+&lt;/sup&gt;)&lt;sub&gt;18&lt;/sub&gt;(O,OH,F)&lt;sub&gt;38&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070698 | R070697 | R110047</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Davidite-(La)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Davidite-(La)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mawson D (1906) On certain new mineral species associated with carnotite in the radio-active ore body near Olary, Transactions of the Royal Society of South Australia 30, 188-193 Name changed from davidite: Levinson A A (1966) A system of nomenclature for rare-earth minerals, American Mineralogist 51, 152-158</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Crichtonite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.CC.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 2: 3,3: 5, and similar, With large and medium-sized cations</gsmin:strunzlabel>
