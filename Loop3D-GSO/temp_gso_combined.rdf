    <gsmin:mindaturl>http://www.mindat.org/min-3943.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sn&lt;sup&gt;2+&lt;/sup&gt;Ta&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Thoreaulite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Thoreaulite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Buttgenbach H (1933) La thoreaulite, nouvelle espèce minérale, Annales de la Société Géologique de Belgique 56, 327-331</gsmin:statusnotes>
