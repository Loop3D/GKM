    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ce&lt;sub&gt;5&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;,BO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH,O)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:mindatid>min-4026</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4026:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4026.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ce&lt;sub&gt;5&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;,BO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH,O)</gsmin:rruffchemistry>
    <gsmin:rruffids>R060046 | R060370</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tritomite-(Ce)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tritomite-(Ce)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Name changed from tritomite: Nickel E H, Mandarino J A (1987) Procedures involving the IMA Commission on New Minerals and Mineral Names and guidelines on mineral nomenclature, American Mineralogist 72, 1031-1042</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Apatite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AH.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with CO3, SO4, PO4, etc.</gsmin:strunzlabel>
    <gsmin:wikipediadate>1987</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/shcherbakovite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
