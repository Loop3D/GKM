  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/groatite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Groatite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Mn | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/groatite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaCaMn&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)[PO&lt;sub&gt;3&lt;/sub&gt;(OH)]&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2008-054</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-39288</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:39288:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-39288.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaCaMn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)[PO&lt;sub&gt;3&lt;/sub&gt;(OH)]&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Groatite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Groatite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Cooper M A, Hawthorne F C, Ball N A, Ramik R A, Roberts A C (2009) Groatite, NaCaMn^2+^_2_(PO_4_)[PO_3_(OH)]_2_, a new mineral species of the alluaudite group from the Tanco pegmatite, Bernic Lake, Manitoba, Canada: Description and crystal structure, The Canadian Mineralogist 47, 1225-1235</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Alluaudite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.AC.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, without H2O, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:wikipediadate>2008-054</gsmin:wikipediadate>
  </rdf:Description>
