    <gsmin:statusnotes xml:lang="en">Werner A G (1817) Helvin, in Letztes Mineral-System, bey Craz und Gerlach, und bey Carl Gerold (Freiberg und Wien) 29-29</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Cancrinite-sodalite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.FB.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Tektosilicate with additional anions</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Helvite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1804</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/containedBy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <dct:source xml:lang="en">https://en.wikipedia.org/wiki/DE-9IM. Based on the seminal works of Egenhofer et al. (1990, 1991),  Cohn et al. (1997), Clementini et al. (1993, 1994).</dct:source>
    <rdfs:comment xml:lang="en">The interior and boundary of the subject spatial region intesect only the interior of the object spatial region. Subject region is in the interior of the object region.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/isSpatiallyRelatedTo"/>
    <owl:inverseOf rdf:resource="https://w3id.org/gso/1.0/common/contains"/>
    <skos:altLabel xml:lang="en">within</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/bracewellite">
