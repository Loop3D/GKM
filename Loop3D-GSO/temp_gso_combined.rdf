    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:43582:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-43582.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;Co&lt;sup&gt;2+&lt;/sup&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cobaltoblödite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cobaltoblodite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kasatkin A V, Nestola F, Plášil J, Marty J, Belakovskiy D I, Agakhanov A A, Mills S J, Pedron D, Lanza A, Favaro M, Bianchin S, Lykova I S, Goliáš V, Birch W D (2013) Manganoblödite, Na_2_Mn(SO_4_)_2_·4H_2_O, and cobaltoblödite, Na_2_Co(SO_4_)_2_·4H_2_O: two new members of the blödite group from the Blue Lizard mine, San Juan County, Utah, USA, Mineralogical Magazine 77, 367-383</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Blödite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">sulfate, chromate, molybdate or tungstate</gsmin:strunzlabel>
    <gsmin:wikipediadate>2012-059</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/meta-ankoleite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Meta-ankoleite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | U | O | P | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">autunite</gsmin:fleischersgroup>
