    <gsmin:rruffnameplain xml:lang="en">Grossite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Weber D, Bischoff A (1994) Grossite (CaAl_4_O_7_) - a rare phase in terrestrial rocks and meteorites, European Journal of Mineralogy 6, 591-594</gsmin:statusnotes>
