    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3409:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3409.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Rh&lt;sub&gt;3&lt;/sub&gt;Pb&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Rhodplumsite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Rhodplumsite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Genkin A D, Vyal'sov L N, Evstigneeva T L, Laputina I P, Basova G V (1983) Rhodplumsite, Rh_3_Pb_2_S_2_, a new sulfide of rhodium and lead, Mineralogiceskij Zhurnal 5, 87-91</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.BE.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide M:S &gt; 1:1 with Pb (Bi)</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Rhodplumsite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1982-043</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/honessite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Honessite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ni | Fe | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">woodwardite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/honessite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ni&lt;sub&gt;1-x&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;x&lt;/sub&gt;)(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;x/2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O (x &lt; 0.5, n &lt; 3x/2)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1927</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1927:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1927.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ni&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;1-x&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;x&lt;/sub&gt;)(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;x/2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O (x &lt; 0.5, n &lt; 3x/2)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Honessite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Honessite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Heyl A V, Milton C, Axelrod J M (1956) Nickel minerals from near Linden, Iowa County, Wisconsin, Bulletin of the Geological Society of America 67, 1706-1706 Chemical formula proposed as [Ni_6_Fe^3+^_2_(OH)_16_](SO_4_)·4H_2_O: Bish D L, Livingstone A (1981) The crystal chemistry and paragenesis of honessite and hydrohonessite: the sulphate analogues of reevesite. Mineralogical Magazine 44, 339-343 Chemical formula revised: Mills S J, Christy A G, Génin J -M R, Kameda T, Colombo F (2012) Nomenclature of the hydrotalcite supergroup: natural layered double hydroxides. Mineralogical Magazine 76, 1289-1336</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hydrotalcite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.DD.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With only medium-sized cations; sheets of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Honessite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1956</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/heyrovskyite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Heyrovskýite</rdfs:label>
