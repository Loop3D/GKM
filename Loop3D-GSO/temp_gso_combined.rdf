    <gsmin:chemistryelements>Ca | Na | K | Si | Al | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">zeolite-heulandite series</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Na,K)&lt;sub&gt;5&lt;/sub&gt;(Si&lt;sub&gt;27&lt;/sub&gt;Al&lt;sub&gt;9&lt;/sub&gt;)O&lt;sub&gt;72&lt;/sub&gt;·26H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
