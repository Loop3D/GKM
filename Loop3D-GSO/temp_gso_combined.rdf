  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/faizievite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Faizievite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Li | K | Na | Ca | Ti | Si | O | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Li&lt;sub&gt;6&lt;/sub&gt;K&lt;sub&gt;2&lt;/sub&gt;Na(Ca&lt;sub&gt;6&lt;/sub&gt;Na)Ti&lt;sub&gt;4&lt;/sub&gt;(Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;12&lt;/sub&gt;O&lt;sub&gt;30&lt;/sub&gt;)F&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2006-037</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-31306</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:31306:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-31306.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Li&lt;sub&gt;6&lt;/sub&gt;K&lt;sub&gt;2&lt;/sub&gt;Na(Ca&lt;sub&gt;6&lt;/sub&gt;Na)Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;(Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;12&lt;/sub&gt;O&lt;sub&gt;30&lt;/sub&gt;)F&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070221</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Faizievite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Faizievite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Agakhanov A A, Pautov L A, Uvarova Y A, Sokolova E V, Hawthorne F C, Karpenko V Y, Gafurov F G (2007) Faizievite, K_2_Na(Ca_6_Na)Ti_4_Li_6_Si_24_O_66_F_2_ - a new mineral species, New Data on Minerals. Moscow 42, 5-10</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.CM.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si6O18]12- 6-membered double rings (sechser-Doppelringe)</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Faizievite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2006-037</gsmin:wikipediadate>
  </rdf:Description>
