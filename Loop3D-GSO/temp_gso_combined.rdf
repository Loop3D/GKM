  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/stibiotantalite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Stibiotantalite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Sb | Ta | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">cervantite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/stibiotantalite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sb&lt;sup&gt;3+&lt;/sup&gt;TaO&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: AntimonyIII tantalum tetraoxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-3739</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3739:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3739.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sb&lt;sup&gt;3+&lt;/sup&gt;Ta&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050232 | R050599</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Stibiotantalite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Stibiotantalite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Goyder G A (1893) On a new mineral (stibiotantalite), Transactions and Proceedings and Report of the Royal Society of South Australia 17, 127-128</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.DE.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With medium-sized cations; with various polyhedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Stibiotantalite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1893</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Pure_Carbonate_Sedimentary_Rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">This vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Sedimentary rock in which greater than 90 percent of the primary and/or recrystallized constituents are carbonate minerals.</rdfs:comment>
    <rdfs:label xml:lang="en">pure carbonate sedimentary rock</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Carbonate_Sedimentary_Rock"/>
  </rdf:Description>
