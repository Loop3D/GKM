  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/tazzoliite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Tazzoliite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ba | Ca | Sr | Na | Ti | Nb | Si | O | P | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba&lt;sub&gt;2&lt;/sub&gt;CaSr&lt;sub&gt;0.5&lt;/sub&gt;Na&lt;sub&gt;0.5&lt;/sub&gt;Ti&lt;sub&gt;2&lt;/sub&gt;Nb&lt;sub&gt;3&lt;/sub&gt;SiO&lt;sub&gt;17&lt;/sub&gt;[PO&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;]&lt;sub&gt;0.5&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2011-018</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-42806</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:42806:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-42806.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba&lt;sub&gt;2&lt;/sub&gt;CaSr&lt;sub&gt;0.5&lt;/sub&gt;Na&lt;sub&gt;0.5&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Nb&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;SiO&lt;sub&gt;17&lt;/sub&gt;[PO&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;]&lt;sub&gt;0.5&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R130042</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tazzoliite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tazzoliite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Cámara F, Nestola F, Bindi L, Guastoni A, Zorzi F, Peruzzo L, Pedron D (2012) Tazzoliite: a new mineral with a pyrochlore-related structure from the Euganei Hills, Padova, Italy, Mineralogical Magazine 76, 827-838</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Pyrochlore</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">phosphate, arsenate, or vanadate</gsmin:strunzlabel>
    <gsmin:wikipediadate>2011-018</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/varulite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Varulite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Mn | P | O</gsmin:chemistryelements>
    <gsmin:fleischersgroup xml:lang="en">alluaudite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/varulite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaCaMn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Sodium calcium trimanganeseII triphosphate</gsmin:iupacchemname>
    <gsmin:mindatid>min-4158</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4158:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4158.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaCaMn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060740</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Varulite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Varulite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Quensel P (1937) Minerals of the Varuträsk Pegmatite. I. The lithium - manganese phosphates, Geologiska Föreningens i Stockholm Förhandlingar 59, 77-96</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Alluaudite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.AC.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, without H2O, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Varulite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1937</gsmin:wikipediadate>
  </rdf:Description>
