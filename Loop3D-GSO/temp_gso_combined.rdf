    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2933:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2933.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KLiMn&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060368 | R130089</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Norrishite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Norrishite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Eggleton R A, Ashley P M (1989) Norrishite, a new manganese mica, K(Mn3+2Li)Si4O12, from the Hoskins mine, New South Wales, Australia, American Mineralogist 74, 1360-1367</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Mica</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EC.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with mica sheets, composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Norrishite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1989-019</gsmin:wikipediadate>
