    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Taseqite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Taseqite</gsmin:rruffnameplain>
