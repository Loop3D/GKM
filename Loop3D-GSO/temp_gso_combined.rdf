  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/hannayite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Hannayite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>N | H | Mg | P | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/hannayite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(NH&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;Mg&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;3&lt;/sub&gt;OH)&lt;sub&gt;4&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Diammonium trimagnesium tetrahydrogen phosphate octahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1816</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1816:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1816.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(N&lt;sup&gt;3-&lt;/sup&gt;H&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;Mg&lt;sub&gt;3&lt;/sub&gt;(P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;OH)&lt;sub&gt;4&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hannayite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hannayite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">vom Rath G (1879) Note sur deux nouveaux phosphates du guano, Bulletin de la Société Minéralogique de France 2, 79-82</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.CH.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With large and medium-sized cations, RO4:H2O &lt; 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Hannayite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1878</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/arcanite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Arcanite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
