    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(U,Ca,Ce)&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·1-2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2906</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2906:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2906.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(U,Ca,Ce)&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·1-2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ningyoite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ningyoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Muto T, Meyrowitz R, Pommer A M, Murano T (1959) Ningyoite, a new uranous phosphate mineral from Japan, American Mineralogist 44, 633-650</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Rhabdophane</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CJ.85</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With only large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Ningyoite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1959</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/linekite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Línekite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Ca | U | O | C | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;Ca&lt;sub&gt;3&lt;/sub&gt;[(UO&lt;sub&gt;2&lt;/sub&gt;)(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;]&lt;sub&gt;2&lt;/sub&gt;·7H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2012-066</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;Ca&lt;sub&gt;3&lt;/sub&gt;[(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;]&lt;sub&gt;2&lt;/sub&gt;·7H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Línekite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Linekite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Plášil J, Cejka J, Sejkora J, Hloušek J, Škoda R, Novák M, Dušek M, Císarova I, Nemec I, Ederová (2018) Línekite, K_2_Ca_3_[(UO_2_)(CO_3_)_3_)]_2_·8H_2_O, a new uranyl carbonate mineral from Jáchymov, Czech Republic. Journal of Geosciences 62, 201-213</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/burkeite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Burkeite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | S | O | C</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/burkeite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;4&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)(CO&lt;sub&gt;3&lt;/sub&gt;)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Tetrasodium sulfate carbonate</gsmin:iupacchemname>
    <gsmin:mindatid>min-805</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:805:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-805.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;4&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)(CO&lt;sub&gt;3&lt;/sub&gt;)</gsmin:rruffchemistry>
    <gsmin:rruffids>R060112</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Burkeite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Burkeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Named but not described: Teeple J E (1921) The American potash industry and its problems, The Journal of Industrial and Engineering Chemistry 13, 249-252 Foshag W F (1935) Burkeite, a new mineral species from Searles Lake, California, American Mineralogist 20, 50-56</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.BD.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions, without H2O, With only large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Burkeite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1935</gsmin:wikipediadate>
  </rdf:Description>
