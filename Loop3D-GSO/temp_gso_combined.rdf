  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologiccontact/Unconformable_Contact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf, K.K.E, Mehl, J.P. &amp; Jackson, J.A. (eds), 2005. Glossary of geology, 5th Edition. American Geological Institute, Alexandria, 779 p.</dct:source>
    <rdfs:comment xml:lang="en">A contact separating two geological units in which the younger unit succeeds the older after a substantial hiatus in deposition.</rdfs:comment>
    <rdfs:label xml:lang="en">unconformable contact</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologiccontact/Depositional_Contact"/>
  </rdf:Description>
