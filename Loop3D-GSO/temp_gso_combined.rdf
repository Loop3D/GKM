    <gsmin:rruffnameplain xml:lang="en">Mackayite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Frondel C, Pough F H (1944) Two new tellurites of iron: mackayite and blakeite. with new data on emmonsite and "durdenite", American Mineralogist 29, 211-225</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.JL.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Tellurite with additional anions, without H2O</gsmin:strunzlabel>
