    <gsmin:imanumber xml:lang="en">IMA2017-014</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;3&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;8&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sharyginite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Sharyginite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Juroszek R, Krüger H, Galuskina I, Krüger B, Jezak L, Ternes B, Wojdyla J, Krzykawski T, Pautov L, Galuskin E (2018) Sharyginite, Ca_3_TiFe_2_O_8_, a new mineral from the Bellerberg volcano, Germany. Minerals 8, 308</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Perovskite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/fluoro-tremolite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Fluoro-tremolite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Mg | Si | O | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;Ca&lt;sub&gt;2&lt;/sub&gt;Mg&lt;sub&gt;5&lt;/sub&gt;Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;F&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2016-018</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;Ca&lt;sub&gt;2&lt;/sub&gt;Mg&lt;sub&gt;5&lt;/sub&gt;Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;F&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fluoro-tremolite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Fluoro-tremolite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Oberti R, Cámara F, Bellatreccia F, Radica F, Gianfagna A, Boiocchi M (2018) Fluoro-tremolite from the Limecrest-Southdown quarry, Sparta, New Jersey, USA: crystal chemistry of a newly approved end-member of the amphibole supergroup. Mineralogical Magazine 82, 145-157</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Amphibole-amphiboles calcic</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/chalcomenite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Chalcomenite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Se | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/chalcomenite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu(Se&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Copper seleniumIV trioxide dihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-949</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:949:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-949.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;Se&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060586 | R100123</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Chalcomenite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Chalcomenite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Des Cloizeaux A, Damour A A (1881) Note sur la chalcoménite, nouvelle espèce minérale (sélénite de cuivre), Bulletin de la Société Minéralogique de France 4, 51-55</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.JH.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Selenite without additional anions, with H2O</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Chalcomenite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1881</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/aluminoceladonite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Aluminoceladonite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/mineral/celadonitefamily"/>
    <gsmin:chemistryelements>K | Mg | Al | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic, hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">mica-true micas</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K(Mg,Fe&lt;sup&gt;2+&lt;/sup&gt;)Al(Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;)(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-6795</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:6795:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-6795.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KMgAlSi&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Aluminoceladonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Aluminoceladonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named leucophyllite: Starkl G (1883) Ueber neue Mineralvorkommnisse in Oesterreich, Jahrbuch der Kaiserlich-Königlichen Geologischen Reichsanstalt 33, 635-658 Renamed to avoid confusion with the name of a rock: Rieder M, Cavazzini G, D’Yakonov Y S, Frank-Kamenetskii V A, Gottardt G, Guggenheim S, Koval P V, Muller G, Neiva A M R, Radoslovich E W, Robert J L, Sassi F P, Takeda H, Weiss Z, Wones D R (1998) Nomenclature of the micas, The Canadian Mineralogist 36, 905-912</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Mica</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EC.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with mica sheets, composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Aluminoceladonite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1998</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/chernovite-y">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Chernovite-(Y)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Y | As | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">xenotime</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/chernovitey.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Y(AsO&lt;sub&gt;4&lt;/sub&gt;)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1967-027</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Yttrium arsenate</gsmin:iupacchemname>
    <gsmin:mindatid>min-992</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:992:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-992.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">YAs&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070368</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Chernovite-(Y)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Chernovite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Goldin B A, Yushkin N P, Fishman M V (1967) A new yttrium mineral, chernovite, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 96(6), 699-704 Name changed from chernovite: Nickel E H, Mandarino J A (1987) Procedures involving the IMA Commission on New Minerals and Mineral Names and guidelines on mineral nomenclature, American Mineralogist 72, 1031-1042</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Zircon</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.AD.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, without H2O, With only large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Chernovite-%28Y%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1967-027</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/francoisite-nd">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Françoisite-(Nd)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Nd | U | O | P | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">phosphuranylite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/francoisitend.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nd(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;O(OH)(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1987-041</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1594</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1594:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1594.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nd&lt;sup&gt;3+&lt;/sup&gt;(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O(OH)·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Françoisite-(Nd)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Francoisite-(Nd)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Piret P, Deliens M, Piret-Meunier J (1988) La françoisite-(Nd), nouveau phosphate d'uranyle et de terres rares; propriétés et structure cristalline, Bulletin de Minéralogie 111, 443-449</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.EC.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl phosphate or arsenate, UO2:RO4 = 3:2</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Francoisite-%28Nd%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1987-041</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/scainiite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Scainiite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Sb | S | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/scainiite.pdf</gsmin:handbookofmineralogyurl>
