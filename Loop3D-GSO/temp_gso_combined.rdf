    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: ManganeseII dihydroxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-3317</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3317:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3317.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R100045</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pyrochroite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Pyrochroite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Igelström L J (1864) Pyrochroït, ein neues mineral, Annalen der Physik und Chemie 122, 181-182</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Brucite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.FE.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Hydroxide (without V or U), Hydroxides with OH, without H2O; sheets of edge-sharing octahedra</gsmin:strunzlabel>
