    <gsmin:rruffnameplain xml:lang="en">Jorgensenite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pauly H, Hawthorne F C, Burns P C, Della Ventura G (1997) Jørgensenite, Na_2_(Sr,Ba)_14_Na_2_Al_12_F_64_(OH,F)_4_, a new aluminofluoride mineral from Ivigtut, Greenland, The Canadian Mineralogist 35, 175-179</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Jarlite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>03.CC.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Soro-aluminofluoride</gsmin:strunzlabel>
