    <gsmin:statusnotes xml:lang="en">Stanley C J, Jones G C, Hart A D (1991) Barstowite, 3PbCl&lt;sub&gt;2&lt;/sub&gt;·PbCO&lt;sub&gt;3&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O, a new mineral from Bounds Cliff, St Endellion, Cornwall, Mineralogical Magazine 55, 121-125</gsmin:statusnotes>
    <gsmin:strunzcodeV10>03.DC.95</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Double-, Oxy- or Hydroxy-  halide with Pb (As,Sb,Bi), without Cu</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Barstowite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1989-057</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/cryptomelane">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cryptomelane</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Mn | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal, monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">coronadite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/cryptomelane.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K(Mn&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;7&lt;/sub&gt;Mn&lt;sup&gt;3+&lt;/sup&gt;)O&lt;sub&gt;16&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1982 s.p. ?</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1164</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1164:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1164.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K(Mn&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;7&lt;/sub&gt;Mn&lt;sup&gt;3+&lt;/sup&gt;)O&lt;sub&gt;16&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cryptomelane</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cryptomelane</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Richmond W E, Fleischer M (1942) Cryptomelane, a new name for the commonest of the "psilomelane" minerals, American Mineralogist 27, 607-610 Formula changed from K(Mn^4+^,Mn^2+^)_8_O_16_: Biagioni C, Capalbo C, Pasero M (2013) Nomenclature tunings in the hollandite supergroup. European Journal of Mineralogy 25, 85-90</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Coronadite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.DK.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With large (+- medium-sized) cations; tunnel structures</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Cryptomelane.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1982-s.p.</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/edwardsite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Edwardsite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Cd | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/edwardsite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;3&lt;/sub&gt;Cd&lt;sub&gt;2&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2009-048</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-39682</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:39682:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-39682.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Cd&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Edwardsite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Edwardsite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Elliot P, Brugger J, Caradoc-Davies T (2010) Description and crystal structure of a new mineral, edwardsite, Cu_3_Cd_2_(SO_4_)_2_(OH)_6_·4H_2_O, from Broken Hill, New South Wales, Australia, Mineralogical Magazine 74, 39-53</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.DD.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With only medium-sized cations; sheets of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:wikipediadate>2009-048</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/montbrayite">
