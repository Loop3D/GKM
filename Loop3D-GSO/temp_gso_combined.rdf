  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/wilcoxite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Wilcoxite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mg | Al | S | O | F | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">aubertite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/wilcoxite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">MgAl(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;F·17H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1979-070</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Magnesium aluminium disulfate fluorid octadecahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-4288</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4288:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4288.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">MgAl(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;F·18H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Wilcoxite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Wilcoxite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Williams S A, Cesbron F P (1983) Wilcoxite and lannonite, two new fluosulphates from Catron County, New Mexico, Mineralogical Magazine 47, 37-40</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Aubertite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.DE.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With only medium-sized cations; unclassified</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Wilcoxite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1979-070</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/soddyite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
