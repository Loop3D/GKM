    <gsmin:rruffids>R050280</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Norbergite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Norbergite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Geijer P (1926) Norbergite and fluoborite, two new minerals from the Norberg mining district, Geologiska Föreningens i Stockholm Förhandlingar 48, 84-85 Foshag W F (1927) New mineral names, American Mineralogist 12, 265-266</gsmin:statusnotes>
