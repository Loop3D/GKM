    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;4&lt;/sub&gt;Ca&lt;sub&gt;12&lt;/sub&gt;Al&lt;sub&gt;8&lt;/sub&gt;Si&lt;sub&gt;12&lt;/sub&gt;O&lt;sub&gt;46&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;,PO&lt;sub&gt;4&lt;/sub&gt;)(OH,H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;4&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;,Cl)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
