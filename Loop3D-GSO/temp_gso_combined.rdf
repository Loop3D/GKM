    <gsmin:mindaturl>http://www.mindat.org/min-2843.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">PbMn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Al&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;5&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nasledovite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Nasledovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Enikeev M R (1958) A new mineral, nasledovite, from the Altyn-Topkansk ore field. Doklady Akademii Nauk Uzbekistan SSR 5, 13-16</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Alumohydrocalcite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>05.DB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions and H2O, With large and medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Nasledovite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>0</gsmin:wikipediadate>
