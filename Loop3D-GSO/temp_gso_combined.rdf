  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/yeatmanite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Yeatmanite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Zn | Mn | Sb | O | Si</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/yeatmanite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sub&gt;6&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;9&lt;/sub&gt;Sb&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4357</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4357:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4357.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;9&lt;/sub&gt;Sb&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Yeatmanite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Yeatmanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Palache C, Bauer L H, Berman H (1938) Yeatmanite, a new mineral, and sarkinite from Franklin, New Jersey, American Mineralogist 23, 527-530 Chemical formula revised: Dunn P J, Leavens P B (1980) Yeatmanite: New data, American Mineralogist 65, 196-199</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Katoptrite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AE.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with additional anions (O,OH,F,H2O); cations in tetrahedral [4] coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Yeatmanite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1938</gsmin:wikipediadate>
  </rdf:Description>
