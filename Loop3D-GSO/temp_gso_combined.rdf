    <gsmin:mindaturl>http://www.mindat.org/min-11002.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Al(P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)(V&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)(OH)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bushmakinite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Bushmakinite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pekov I V, Kleimenov D A, Chukanov N V, Yakubovich O V, Massa W, Belakovskiy D I, Pautov L A (2002) Bushmakinite Pb&lt;sub&gt;2&lt;/sub&gt;Al(PO&lt;sub&gt;4&lt;/sub&gt;)(VO&lt;sub&gt;4&lt;/sub&gt;)(OH), a new mineral of the brackebuschite group from oxidized zone of berezovskoye gold deposit, the Middle Urals, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 131(2), 62-71</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Brackebuschite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BG.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH, etc.):RO4 = 0.5:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Bushmakinite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2001-031</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/calcioandyrobertsite">
