    <gsmin:rruffnameplain xml:lang="en">Calciojohillerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pekov, I.V., Koshlyakova, N.N., Agakhanov, A.A., Zubkova, N.V., Belakovskiy, D.I., Vigasina, M.F., Turchkova, A.G., Sidorov, E.G. and Pushcharovsky, D.Y. (2016) Calciojohillerite, IMA 2016-068. CNMNC Newsletter No. 34, December 2016, page 1317; Mineralogical Magazine, 80, 1315–1321</gsmin:statusnotes>
