    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;6&lt;/sub&gt;Bi&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;9&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1970-022</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Hexalead dibismuth nonasulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-6993</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:6993:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-6993.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;6&lt;/sub&gt;Bi&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;9&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070010</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Heyrovskýite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Heyrovskyite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Klomínský K, Rieder M, Kieft C, Mráz L (1971) Heyrovskýite, 6(Pb0.86Bi0.08(Ag,Cu)0.04)S·Bi2S3, from Hurky, Czechoslovakia, a new mineral of genetic interest, Mineralium Deposita 6, 133-147</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Lillianite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.JB.40b</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">PbS type sulfosalt with Pb</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Heyrovskyite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1970-022</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/arfvedsonite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Arfvedsonite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Fe | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">amphibole-group 4 Na</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/arfvedsonite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaNa&lt;sub&gt;2&lt;/sub&gt;(Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;)Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Redefined|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-325</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:325:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-325.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaNa&lt;sub&gt;2&lt;/sub&gt;(Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;)Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R040127 | R050514 | R110049</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Arfvedsonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Arfvedsonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Brooke H J (1823) A description of the crystalline form of some new minerals. Arfwedsonite, The Annals of Philosophy 5, 381-384</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Amphibole</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DE.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 2-periodic double chains, Si4O11; Clinoamphiboles</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Arfvedsonite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1823</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ilmenite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
