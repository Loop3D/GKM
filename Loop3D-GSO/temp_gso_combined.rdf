    <gsmin:mindaturl>http://www.mindat.org/min-3481.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ru,Ni)As</gsmin:rruffchemistry>
