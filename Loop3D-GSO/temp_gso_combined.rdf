    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Magnesiohögbomite-2N4S</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Magnesiohogbomite-2N4S</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Shimura T, Akai J, Lazic B, Armbruster T, Shimizu M, Kamei A, Tsukada K, Owada M, Yuhara M (2012) Magnesiohögbomite-2N4S: A new polysome from the central Sør Rondane Mountains, East Antarctica, American Mineralogist 97, 268-280</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hogbömite-Magnesiohogbömite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.CB.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 2: 3,3: 5, and similar, With medium-sized cations</gsmin:strunzlabel>
    <gsmin:wikipediadate>2010-084</gsmin:wikipediadate>
  </rdf:Description>
