    <gsmin:rruffnameplain xml:lang="en">Sergeevite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Yakhontova L K, Ilyusnina I I, Stolyarova T I, Egorov-Tismenko Y K, Kuleshevich L V (1980) Sergeevite, a new hydrous carbonate of magnesium and calcium, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 109, issue 2, 217-223</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.DB.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions and H2O, With large and medium-sized cations</gsmin:strunzlabel>
