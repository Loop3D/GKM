  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/omariniite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Omariniite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Fe | Zn | Ge | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;8&lt;/sub&gt;Fe&lt;sub&gt;2&lt;/sub&gt;ZnGe&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;12&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2016-050</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;8&lt;/sub&gt;Fe&lt;sub&gt;2&lt;/sub&gt;ZnGe&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;12&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Omariniite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Omariniite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Bindi L, Putz H, Paar W H, Stanley C J (2017) Omariniite, Cu_8_Fe_2_ZnGe_2_S_12_, the germanium analogue of stannoidite, a new mineral species from Capillitas, Argentina. Mineralogical Magazine 81, 1151-1159</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Stannoidite</gsmin:structuralgroup>
  </rdf:Description>
