    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/manandonite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Li&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;4&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;AlB)O&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;8&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2559</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2559:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2559.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Li&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;4&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;AlB)O&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;8&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060968</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Manandonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Manandonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Lacroix A (1912) Sur une nouvelle espèce minérale (manandonite) des pegmatites de Madagascar, Bulletin de la Société Française de Minéralogie 35, 223-226 Chemical formula redefined: Zheng H, Bailey S W (1995) The crystal structure of manandonite-2H2, American Mineralogist 80, 387-393</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Serpentine</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.ED.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with kaolinite layers composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Manandonite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1912</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/donharrisite">
