    <gsmin:chemistryelements>Al | B | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">dumortierite</gsmin:fleischersgroup>
