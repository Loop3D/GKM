    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sr(Mn,Y,U)Fe&lt;sub&gt;2&lt;/sub&gt;(Ti,Fe,Cr,V)&lt;sub&gt;18&lt;/sub&gt;(O,OH)&lt;sub&gt;38&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
