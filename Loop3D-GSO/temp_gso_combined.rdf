    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2753:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2753.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NdPO&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Monazite-(Nd)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Monazite-(Nd)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Graeser S, Schwander H (1987) Gasparite-(Ce) and monazite-(Nd): two new minerals to the monazite group from the Alps, Schweizerische Mineralogische und Petrographische Mitteilungen 67, 103-113</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Monazite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.AD.50</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, without H2O, With only large cations</gsmin:strunzlabel>
