  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/rheniite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Rheniite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Re | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">ReS&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1999-004a</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Rhenium disulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-7269</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7269:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7269.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">ReS&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050362</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Rheniite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Rheniite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Znamensky V S, Korzhinsky M A, Steinberg G S, Tkachenko S I, Yakushev A I, Laputina I P, Bryzgalov I A, Samotoin N D, Magazina L O, Kuzmina O V, Organova N I, Rassulov V A, Chaplygin I V (2005) Rheniite, ReS2, the natural rhenium disulfide from fumaroles of Kudryavy volcano, lturup Isl., Kurily Islands, Zapiski Rossiiskogo Mineralogicheskogo Obshchetstva 134, issue 5, 32-40</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.EB.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide, M: S &lt;= 1:2 with Fe, Co, Ni, PGE, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://webmineral.com/data/Rheniite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1999-004a</gsmin:wikipediadate>
  </rdf:Description>
