  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/pyrosmalite-fe">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Pyrosmalite-(Fe)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Fe | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">pyrosmalite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/ferropyrosmalite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;8&lt;/sub&gt;Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;15&lt;/sub&gt;(OH)&lt;sub&gt;10&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1985-L</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Renamed|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1525</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1525:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1525.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;8&lt;/sub&gt;Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;15&lt;/sub&gt;(OH)&lt;sub&gt;10&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050158 | R060438 | R070313</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pyrosmalite-(Fe)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Pyrosmalite-(Fe)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Moll C E F (1808) Vorläufige Notiz von einigen neuen nordischen Fossilien; von dem Herrn Cammersecretär Hausmann zu Braunschweig mitgetheilt. 1. Pirodmalit, in Efemeriden der Berg und Hüttenkunde, Steinischen Buchhandlung (Nürnberg) 390-393 Name changed from pyrosmalite to ferropyrosmalite and the name pyrosmalite now designates the group name: Vaughan J P (1986) Ferropyrosmalite and nomenclature in the pyrosmalite series, Mineralogical Magazine 51, 174-174 Name changed from ferropyrosmalite: Burke E A J (2008) Tidying up mineral names: an IMA-CNMNC scheme for suffixes, hyphens and diacritical marks, The Mineralogical Record 39, 131-135</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Clay</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EE.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate: Single tetrahedral nets of 6-membered rings connected by octahedral nets or octahedral bands</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Pyrosmalite-(Fe).shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1985-L</gsmin:wikipediadate>
  </rdf:Description>
