    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">cancrinite-sodalite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/sacrofanite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na&lt;sub&gt;61&lt;/sub&gt;K&lt;sub&gt;19&lt;/sub&gt;Ca&lt;sub&gt;32&lt;/sub&gt;)&lt;sub&gt;S=112&lt;/sub&gt;(Si&lt;sub&gt;84&lt;/sub&gt;Al&lt;sub&gt;84&lt;/sub&gt;O&lt;sub&gt;336&lt;/sub&gt;)(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;26&lt;/sub&gt;Cl&lt;sub&gt;2&lt;/sub&gt;F&lt;sub&gt;6&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1979-058</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3498</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3498:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3498.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,Ca)&lt;sub&gt;9&lt;/sub&gt;(Si,Al)&lt;sub&gt;12&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;(OH,SO&lt;sub&gt;4&lt;/sub&gt;,CO&lt;sub&gt;3&lt;/sub&gt;,Cl)&lt;sub&gt;4&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sacrofanite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Sacrofanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Burragato F, Parodi G C, Zanazzi P F (1980) Sacrofanite- a new mineral of the cancrinite group, Neues Jahrbuch für Mineralogie, Abhandlungen 140, 102-110</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Cancrinite-sodalite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.FB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Tektosilicate with additional anions</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Sacrofanite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1979-058</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/jeanbandyite">
