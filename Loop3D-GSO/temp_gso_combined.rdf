    <gsmin:chemistryelements>Na | Sr | Fe | Mg | Ti | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">unknown, monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,Sr)&lt;sub&gt;3&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;,Mg)&lt;sub&gt;10&lt;/sub&gt;Ti&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;12&lt;/sub&gt;O&lt;sub&gt;37&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O,O,OH)&lt;sub&gt;17&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2005-031</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-28997</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:28997:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-28997.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,Sr)&lt;sub&gt;3&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;,Mg)&lt;sub&gt;10&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;12&lt;/sub&gt;O&lt;sub&gt;37&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O,O,OH)&lt;sub&gt;17&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070008</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Caryochroite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Caryochroite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kartashov P M, Ferraris G, Soboleva S V, Chukanov N V (2006) Caryochroite, a new heterophyllosilicate mineral species related to nafertisite, from the Lovozero Massif, Kola Peninsula, Russia, The Canadian Mineralogist 44, 1331-1339</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.HA.65</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Silicate, unclassified: With Alkali and Alkali-earth Elements</gsmin:strunzlabel>
