    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1575:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1575.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;5&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;1.5&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;1.5&lt;/sub&gt;F</gsmin:rruffchemistry>
    <gsmin:rruffids>R130124</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fluorellestadite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Fluorellestadite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chesnokov B V, Bazhenova L F, Bushmakin A F (1987) Fluorellestadite Ca_10_[(SO_4_),(SiO_4_)]_6_F_2_ - a new mineral, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 116(6), 743-746 Name changed from fluorellestadite to ellestadite-(F): Burke E A J (2008) Tidying up mineral names: an IMA-CNMNC scheme for suffixes, hyphens and diacritical marks, The Mineralogical Record 39, 131-135 Name changed from ellestadite-(F) back to fluorellestadite, and chemical formula changed: Pasero M, Kampf A R, Ferraris C, Pekov I V, Rakovan J R, White T J (2010) Nomenclature of the apatite supergroup minerals, European Journal of Mineralogy 22, 163-179</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Apatite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AH.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with CO3, SO4, PO4, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Fluorellestadite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1987-002</gsmin:wikipediadate>
  </rdf:Description>
