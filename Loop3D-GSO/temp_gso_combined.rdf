  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/nioboholtite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Nioboholtite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Nb | Al | B | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Nb&lt;sub&gt;0.6&lt;/sub&gt;&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;&lt;sub&gt;0.4&lt;/sub&gt;)Al&lt;sub&gt;6&lt;/sub&gt;BSi&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2012-068</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Nb&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;0.6&lt;/sub&gt;&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;&lt;sub&gt;0.4&lt;/sub&gt;)Al&lt;sub&gt;6&lt;/sub&gt;BSi&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nioboholtite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Nioboholtite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pieczka A, Evans R J, Grew E S, Groat L A, Ma C, Rossman G R (2013) The dumortierite supergroup. II. Three new minerals from the Szklary pegmatite, SW Poland: Nioboholtite, (Nb_0.6_[box]_0.4_)Al_6_BSi_3_O_18_, titanoholtite, (Ti_0.75_[box]_0.25_)Al_6_BSi_3_O_18_, and szklaryite, [box]Al_6_BAs^3+^_3_O_15_. Mineralogical Magazine 77, 2841-2856</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Dumortierite</gsmin:structuralgroup>
  </rdf:Description>
