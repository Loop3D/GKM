  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/chalcocite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Chalcocite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic, cubic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/chalcocite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;2&lt;/sub&gt;S</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dicopper sulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-962</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:962:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-962.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;1+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;S&lt;sup&gt;2-&lt;/sup&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050067 | R070730 | R120090 | R120113</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Chalcocite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Chalcocite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mineral name, or its predecessor chalcitis, has been known since antiquity and predates any formal descriptive publication. Eg. Hill J (1751) Of vitriolic minerals, in A History of the Materia Medica, Longman, Hitch and Hawes (London) 140-147</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.BA.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide M:S &gt; 1:1 with Cu, Ag, Au</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Chalcocite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>old</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/stilbite-na">
