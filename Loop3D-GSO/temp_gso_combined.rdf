    <gsmin:mindaturl>http://www.mindat.org/min-3108.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Mn&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R120119</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pararobertsite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Pararobertsite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Roberts A C, Sturman B D, Dunn P J, Roberts W L (1989) Pararobertsite, Ca_2_Mn^3+^_3_(PO_4_)_3_O_2_·3H_2_O, a new mineral species from the Tip Top pegmatite, Custer County, South Dakota, and its relationship to robertsite, The Canadian Mineralogist 27, 451-455</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.DH.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 &lt; 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Pararobertsite.shtml</gsmin:webmineralurl>
