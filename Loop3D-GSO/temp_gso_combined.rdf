    <gsmin:rruffids>R060936</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Orientite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Orientite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Moore P B, Ito J, Steele I M (1979) Macfallite and orientite: calcium manganese (III) silicates from upper Michigan, Mineralogical Magazine 43, 325-331 Fleischer M, Cabri L J, Pabst A (1980) New mineral names, American Mineralogist 65, 406-408</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.BJ.05</gsmin:strunzcodeV10>
