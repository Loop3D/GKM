    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2109:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2109.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070102</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Jôkokuite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Jokokuite</gsmin:rruffnameplain>
