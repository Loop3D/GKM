  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/norsethite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Norsethite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ba | Mg | C | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">dolomite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/norsethite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaMg(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Barium magnesium dicarbonate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2934</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2934:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2934.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaMg(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Norsethite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Norsethite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mrose M E, Chao E C T, Fahey J J, Milton C (1961) Norsethite, BaMg(CO3)2, a new mineral from the Green River formation, Wyoming, American Mineralogist 46, 420-429</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.AB.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate without additional anions, without H2O, Alkali-earth (and other M2+) carbonates</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Norsethite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1961</gsmin:wikipediadate>
  </rdf:Description>
