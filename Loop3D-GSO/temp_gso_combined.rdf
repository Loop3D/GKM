  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/povondraite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Povondraite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Fe | Mg | Si | O | B | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">tourmaline</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/povondraite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaFe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Mg&lt;sub&gt;2&lt;/sub&gt;)(Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;)(BO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1990-E</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:mindatid>min-3274</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3274:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3274.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaFe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Mg&lt;sub&gt;2&lt;/sub&gt;)(Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;)(BO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Povondraite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Povondraite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Walenta K, Dunn P J (1979) Ferridravite, a new mineral of the tourmaline group from Bolivia, American Mineralogist 64, 945-948 Name changed from ferridravite: Grice J D, Ercit T S, Hawthorne F C (1993) Povondraite, a redefinition of the tourmaline ferridravite, American Mineralogist 78, 433-436 Chemical formula redefined: Hawthorne F C, Henry D J (1999) Classification of the minerals of the tourmaline group, European Journal of Mineralogy 11, 201-215</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Tourmaline</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CK.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si6O18]12- 6-membered single rings, with insular complex anions</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Povondraite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1990-E</gsmin:wikipediadate>
  </rdf:Description>
