    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Matlockite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Matlockite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Greg R P (1851) A description of matlockite, a new oxychloride of lead, The London, Edinburgh, and Dublin Philosophical Magazine and Journal of Science 2, 120-121 Chemical formula redefined: Nieuwenkamp W (1933) Die chemische zusammensetzung von matlockit, Zeitschrift für Kristallographie 86, 470-471</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Matlockite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>03.DC.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Double-, Oxy- or Hydroxy-  halide with Pb (As,Sb,Bi), without Cu</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Matlockite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1851</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/paranatisite">
