    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:6948:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-6948.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">SrCaCa&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;F</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fluorcaphite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Fluorcaphite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Khomyakov A P, Kulikova I M, Rastsvetaeva R K (1997) Fluorcaphite Ca(Sr,Na,Ca)(Ca,Sr,Ce)_3_(PO_4_)_3_F – a new mineral with the apatite structural motif, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 126(3), 87-97 Chemical formula revised: Pasero M, Kampf A R, Ferraris C, Pekov I V, Rakovan J R, White T J (2010) Nomenclature of the apatite supergroup minerals, European Journal of Mineralogy 22, 163-179</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Apatite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BN.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With only large cations, (OH, etc.):RO4 = 0.33:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Fluorcaphite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1996-022</gsmin:wikipediadate>
  </rdf:Description>
