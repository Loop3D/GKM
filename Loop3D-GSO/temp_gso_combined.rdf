    <gsmin:mindaturl>http://www.mindat.org/min-1405.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;3&lt;/sub&gt;Na&lt;sub&gt;4&lt;/sub&gt;(Fe&lt;sup&gt;2+&lt;/sup&gt;,Mn&lt;sup&gt;2+&lt;/sup&gt;,Ti&lt;sup&gt;4+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;20&lt;/sub&gt;(OH,O)&lt;sub&gt;4&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ershovite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ershovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Khomyakov A P, Menshikov Y P, Rastsvetaeva R K, Necheljustov G N (1993) Ershovite Na_4_K_3_(Fe,Mn,Ti)_2_Si_8_O_20_(OH)_4_·4H_2_O - a new mineral, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 122(1), 116-120</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Ershovite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DF.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 2-periodic multiple chains</gsmin:strunzlabel>
