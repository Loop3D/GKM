  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Arenite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Pettijohn, Potter, Siever, 1972, Sand and Sandstone: New York, Springer Verlag, 681 p.</dct:source>
    <rdfs:comment xml:lang="en">Clastic sandstone that contains less than 10 percent matrix. Matrix is mud-size silicate minerals (clay, feldspar, quartz, rock fragments, and alteration products) of detrital or diagenetic nature.</rdfs:comment>
    <rdfs:label xml:lang="de">arenit</rdfs:label>
    <rdfs:label xml:lang="en">arenite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Clastic_Sandstone"/>
  </rdf:Description>
