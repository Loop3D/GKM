    <gsmin:mindaturl>http://www.mindat.org/min-996.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;4&lt;/sub&gt;Ca&lt;sub&gt;2&lt;/sub&gt;Mg&lt;sub&gt;3&lt;/sub&gt;Al&lt;sub&gt;8&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;10&lt;/sub&gt;·40H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Chessexite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Chessexite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Sarp H, Deferne J (1982) La chessexite, un nouveau minéral, Schweizerische Mineralogische und Petrographische Mitteilungen 62, 337-341</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.DG.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With large and medium-sized cations; with NO3, CO3, B(OH)4, SiO4 or IO3</gsmin:strunzlabel>
