    <gsmin:strunzlabel xml:lang="en">Modular Inosilicate-Sorosilicate Structure</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Fukalite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1976-003</gsmin:wikipediadate>
