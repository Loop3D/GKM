    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sb&lt;sup&gt;5+&lt;/sup&gt;Mn&lt;sup&gt;3+&lt;/sup&gt;(Mg,Mn&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;10&lt;/sub&gt;O&lt;sub&gt;8&lt;/sub&gt;(BO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Folvikite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Folvikite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Cooper M A, Raade G, Ball N A, Abdu Y A, Hawthorne F C, Rowe R (2018) Folvikite, Sb^5+^Mn^3+^(Mg,Mn^2+^)_10_O_8_(BO_3_)_4_, a new oxyborate mineral from the Kitteln mine, Nordmark ore district, Värmland, Sweden: description and crystal structure. Mineralogical Magazine 82, 821-836</gsmin:statusnotes>
