    <gsmin:chemistryelements>Na | Mn | Y | C | O | S | F | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/reederitey.pdf</gsmin:handbookofmineralogyurl>
