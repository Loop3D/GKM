    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7005:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7005.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;18&lt;/sub&gt;Ba&lt;sub&gt;2&lt;/sub&gt;Ca&lt;sub&gt;5&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;30&lt;/sub&gt;O&lt;sub&gt;90&lt;/sub&gt;Cl·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
