    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dibismuth molybdenum hexaoxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-2235</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2235:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2235.html</gsmin:mindaturl>
