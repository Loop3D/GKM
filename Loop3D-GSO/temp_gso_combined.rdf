    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/gaspeite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ni(CO&lt;sub&gt;3&lt;/sub&gt;)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1965-029</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Nickel carbonate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1657</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1657:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1657.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ni&lt;sup&gt;2+&lt;/sup&gt;CO&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R040157 | R060366</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Gaspéite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Gaspeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kohls D W, Rodda J L (1966) Gaspeite, (Ni,Mg,Fe)(CO_3_), a new carbonate from the Gaspé Peninsula, Quebec, American Mineralogist 51, 677-684</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Calcite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>05.AB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate without additional anions, without H2O, Alkali-earth (and other M2+) carbonates</gsmin:strunzlabel>
