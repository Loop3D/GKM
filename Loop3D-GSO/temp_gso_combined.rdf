    <gsmin:mindaturl>http://www.mindat.org/min-7126.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaMgSc&lt;sup&gt;3+&lt;/sup&gt;(P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070732</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Juonniite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Juonniite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Liferovich R P, Yakovenchuk V N, Pakhomovsky Y A, Bogdanova A N, Britvin S N (1997) Juonniite, a new mineral of scandium from dolomitic carbonatites of the Kovdor massif, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 126(4), 80-88</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Overite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DH.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 &lt; 1:1</gsmin:strunzlabel>
