  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfoliation/tectonic_layering">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Layering defined by mineralogical or textural variations in a rock body that are interpreted to be related to deformation or metamorphism, commonly associated with layers that have sharp boundaries. Also known as gneissic foliation. See plates 142-145 (p. 342-349) in Borradaile et al [1982] and plate 46A to 49A in Weiss [1972].</rdfs:comment>
    <dct:source xml:lang="en">Weiss 1972, Borradaile et al 1982, CGI foliationtype SKOS vocabulary 2018-08-03</dct:source>
    <rdfs:label xml:lang="en">tectonic layering</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfoliation/layering"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfoliation/tectonic_foliation"/>
  </rdf:Description>
