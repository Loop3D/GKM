    <gsmin:rruffnameplain xml:lang="en">Cordylite-(La)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mills S J, Kartashov P M, Kampf A R, Konev A A, Konev A A, Raudsepp M (2012) Cordylite-(La), a new mineral species in fenite from the Biraya Fe-REE deposit, Irkutsk, Russia, The Canadian Mineralogist 50, 1281-1290</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Cordylite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/phosphohedyphane">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
