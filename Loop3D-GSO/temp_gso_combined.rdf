    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Llantenesite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Llantenesite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Lengauer, C.L., Ende, M., Topa, D., Lira, R. and Paar, W.H. (2019) Llantenesite, IMA 2018-111. CNMNC Newsletter No. 47, February 2019, page 145; Mineralogical Magazine, 83, 143–147</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Spangolite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/hambergite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Hambergite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Be | B | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/hambergite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Be&lt;sub&gt;2&lt;/sub&gt;(BO&lt;sub&gt;3&lt;/sub&gt;)(OH)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Diberyllium borate hydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-1811</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1811:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1811.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Be&lt;sub&gt;2&lt;/sub&gt;BO&lt;sub&gt;3&lt;/sub&gt;(OH)</gsmin:rruffchemistry>
    <gsmin:rruffids>R050603 | R050672</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hambergite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hambergite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Brögger W C (1890) Die mineralien der syenitpegmatitgänge der südnorwegischen augit- und nephelinsyenite, 16. Hambergit, Zeitschrift für Kristallographie 16, 65-67</gsmin:statusnotes>
    <gsmin:strunzcodeV10>06.AB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Monoborate, BO3, with additional anions; 1(D) + OH, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Hambergite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1890</gsmin:wikipediadate>
  </rdf:Description>
