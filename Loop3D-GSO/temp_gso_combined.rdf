    <gsmin:mindaturl>http://www.mindat.org/min-610.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(K,Ba,Sr)&lt;sub&gt;2&lt;/sub&gt;Sr&lt;sub&gt;2&lt;/sub&gt;Ca&lt;sub&gt;2&lt;/sub&gt;(Ca,Na)&lt;sub&gt;4&lt;/sub&gt;(Si,Al)&lt;sub&gt;36&lt;/sub&gt;O&lt;sub&gt;72&lt;/sub&gt;·30H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R100201</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bellbergite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Bellbergite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Rüdinger B, Tillmanns E, Hentschel G (1993) Bellbergite - a new mineral with zeolite structure type EAB, Mineralogy and Petrology 48, 147-152</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.GD.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Zeolite family: Chains of 6-membered rings – tabular zeolites</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Bellbergite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1990-057</gsmin:wikipediadate>
