    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Silicon dioxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-3790</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3790:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3790.html</gsmin:mindaturl>
