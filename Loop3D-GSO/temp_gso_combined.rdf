    <gsmin:chemistryelements>Fe | Sn | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">wickmanite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/natanite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;Sn&lt;sup&gt;4+&lt;/sup&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1980-028</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: IronII tinIV hexahydroxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-2847</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2847:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2847.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;Sn&lt;sup&gt;4+&lt;/sup&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R100016</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Natanite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Natanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Marshukova N K, Palovskii A B, Sidorenko G A, Chistyakova N I (1981) Vismirnovite, ZnSn(OH)6, and natanite, FeSn(OH)6, new tin minerals, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 110, issue 4, 492-500 Fleischer M, Cabri L J, Chao G Y, Mandarino J A, Pabst A (1982) New mineral names, American Mineralogist 67, 1074-1082</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Perovskite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.FC.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Hydroxide (without V or U), Hydroxides with OH, without H2O; corner-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Natanite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1980-028</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/orthoserpierite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Orthoserpierite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Cu | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/orthoserpierite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaCu&lt;sub&gt;4&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1983-022a</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3031</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3031:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3031.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaCu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R050292 | R060793 | R060977</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Orthoserpierite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Orthoserpierite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Sarp H (1985) Orthoserpiérite Ca(CuZn)_4_(SO_4_)_2_(OH)_6_·3H_2_O, un nouveau minéral de la Mine de Chessy, France, polymorphe de la serpiérite, Schweizerische Mineralogische und Petrographische Mitteilungen 65, 1-7</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.DD.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With only medium-sized cations; sheets of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Orthoserpierite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1983-022a</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/boleite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Boleite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Ag | Pb | Cu | Cl | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/boleite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KAg&lt;sub&gt;9&lt;/sub&gt;Pb&lt;sub&gt;26&lt;/sub&gt;Cu&lt;sub&gt;24&lt;/sub&gt;Cl&lt;sub&gt;62&lt;/sub&gt;(OH)&lt;sub&gt;48&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:mindatid>min-712</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:712:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-712.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KAg&lt;sup&gt;1+&lt;/sup&gt;&lt;sub&gt;9&lt;/sub&gt;Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;26&lt;/sub&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;24&lt;/sub&gt;Cl&lt;sub&gt;62&lt;/sub&gt;(OH)&lt;sub&gt;48&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050022 | R130099</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Boleite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Boleite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mallard F E, Cumenge E (1891) Sur une nouvelle espèce minérale, la boléite, Bulletin de la Société Française de Minéralogie 14, 283-293 Chemical formula revised: Cooper M A, Hawthorne F C (2000) Boleite: resolution of the formula, KPb&lt;sub&gt;26&lt;/sub&gt;Ag&lt;sub&gt;9&lt;/sub&gt;Cu&lt;sub&gt;24&lt;/sub&gt;Cl&lt;sub&gt;62&lt;/sub&gt;(OH)&lt;sub&gt;48&lt;/sub&gt;, The Canadian Mineralogist 38, 801-808</gsmin:statusnotes>
    <gsmin:strunzcodeV10>03.DB.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Double-, Oxy- or Hydroxy-  halide with Pb, Cu, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Boleite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1891</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/pearceite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Pearceite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ag | Cu | S | As | Sb</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal, monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">polybasite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/pearceite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">[Ag&lt;sub&gt;9&lt;/sub&gt;CuS&lt;sub&gt;4&lt;/sub&gt;][(Ag,Cu)&lt;sub&gt;6&lt;/sub&gt;(As,Sb)&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;7&lt;/sub&gt;]</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:mindatid>min-3138</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3138:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3138.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu(Ag,Cu)&lt;sub&gt;6&lt;/sub&gt;Ag&lt;sub&gt;9&lt;/sub&gt;As&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;11&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050310 | R050611 | R060689 | R090041</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pearceite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Pearceite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Penfield S L (1896) On pearceite, a sulpharsenite of silver and on the crystallization of polybasite, American Journal of Science 152, 17-29 Redefined: Bindi L, Evain M, Spry P G, Menchetti S (2007) The pearceite-polybasite group of minerals: crystal chemistry and new nomenclature rules, American Mineralogist 92, 918-925</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Polybasite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.GB.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Neso-sulfarsenite with additional S</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Pearceite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1833, 2007</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/vesignieite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Vésigniéite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Ba | V | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/vesignieite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;3&lt;/sub&gt;Ba(VO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Tricopper barium divanadate dihydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-4175</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4175:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4175.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Ba(V&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R120149</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Vésigniéite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Vesignieite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Guillemin C (1955) Une nouvelle espèce minérale: la vésigniéite Cu_3_Ba(VO_4_)_2_(OH)_2_, Comptes Rendus de L’Académie des Sciences Paris 240, 2331-2333</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.BH.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH,etc.):RO4 = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Vesignieite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1955</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/bairdite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Bairdite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Cu | Te | O | H | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;2&lt;/sub&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Te&lt;sup&gt;6+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
