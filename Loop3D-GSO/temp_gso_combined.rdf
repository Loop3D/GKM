    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2990:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2990.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">OsAs&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
