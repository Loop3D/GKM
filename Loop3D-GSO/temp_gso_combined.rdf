    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;3&lt;/sub&gt;[B(OH)&lt;sub&gt;4&lt;/sub&gt;]&lt;sub&gt;2&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)(OH,F)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3823</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3823:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3823.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;3&lt;/sub&gt;[B(OH)&lt;sub&gt;4&lt;/sub&gt;]&lt;sub&gt;2&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)(OH,F)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sulfoborite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Sulfoborite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Bücking H (1893) Sulfoborit, ein neues krystallisirtes Borat von Westeregeln, Sitzungsberichte der Königlich Preussischen Akademie der Wissenschaften 1893, 967-972</gsmin:statusnotes>
    <gsmin:strunzcodeV10>06.AC.55</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Monoborate, B(O,OH)4, without and with additional anions; 1(T), 1(T)+OH, etc</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Sulfoborite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1893</gsmin:wikipediadate>
