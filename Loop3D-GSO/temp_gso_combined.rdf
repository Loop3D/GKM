  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/heteromorphite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Heteromorphite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Sb | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">plagionite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/heteromorphite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;7&lt;/sub&gt;Sb&lt;sub&gt;8&lt;/sub&gt;S&lt;sub&gt;19&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Heptalead octaantimonide nonadecasulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-1886</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1886:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1886.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;7&lt;/sub&gt;Sb&lt;sub&gt;8&lt;/sub&gt;S&lt;sub&gt;19&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Heteromorphite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Heteromorphite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Zincken C, Rammelsberg C (1849) Beiträge zur Kenntnifs von mineralien des Harzes. III. Heteromorphit, Annalen der Physik und Chemie 77, 236-267</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.HC.10c</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">SnS type sulfosalt with only Pb</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Heteromorphite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1849</gsmin:wikipediadate>
  </rdf:Description>
