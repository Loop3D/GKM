    <gsmin:strunzcodeV10>08.BD.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With only medium-sized cations, (OH, etc.):RO4= 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Ludjibaite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1987-009</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/majorite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Majorite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/mineral/garnetgroup"/>
    <gsmin:chemistryelements>Mg | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal, cubic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">garnet</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/majorite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;3&lt;/sub&gt;(MgSi)(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1969-018</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2546</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2546:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2546.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;3&lt;/sub&gt;(MgSi)(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Majorite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Majorite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Smith J V, Mason B (1970) Pyroxene-garnet transformation in Coorara meteorite, Science 168, 832-833 Chemical formula changed from Mg_3_(Fe,Al,Si)_2_(SiO_4_)_3_: Grew E S, Locock A J, Mills S J, Galuskina I O, Galuskin E V, Hålenius U (2013) Nomenclature of the garnet supergroup. American Mineralogist 98, 785-811</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Garnet</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AD.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate without additional anions; cations in [6] and/or greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Majorite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1969-018</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/clinoptilolite-ca">
