    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tachyhydrite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tachyhydrite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Rammelsberg C (1856) Ueber den tachhydrit, ein neues mineral aus dem Steinsalzlager von Stassfurth, Annalen der Physik und Chemie 98, 261-263</gsmin:statusnotes>
