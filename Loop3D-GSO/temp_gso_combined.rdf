    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4199:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4199.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R050663</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Voglite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Voglite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">At the end of this article, Haidinger, in an editorial comment, proposed naming the mineral species after Vogl: Vogl J F (1853) Drei neue Mineral-Vorkommen von Joachimsthal, Jahrbuch der Kaiserlich-Königlichen Geologischen Reichsanstalt 4, 220-223</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.EE.05</gsmin:strunzcodeV10>
