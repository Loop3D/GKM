    <gsmin:rruffnameplain xml:lang="en">Lisitsynite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Khomyakov A P, Nechelyustov G N, Sokolova E V, Hawthorne F C (2000) New borosilicates: Malinkoite, NaBSiO_4_, and lisitsynite, KBSi_2_O_6_, from alkaline pegmatites of the Khibiny-Lovozero complex, Kola Peninsula, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 129(6) 35-42</gsmin:statusnotes>
