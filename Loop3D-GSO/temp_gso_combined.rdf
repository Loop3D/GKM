    <gsmin:fleischersgroup xml:lang="en">hydromagnesite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/giorgiosite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;5&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Questionable mineral species|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1697</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1697:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1697.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;5&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Giorgiosite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Giorgiosite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Lacroix M A (1905) Les carbonates basiques de magnésie de l'éruption de Santorin en 1866. Comptes Rendus Hebdomadaires des Séances de l’Académie des Sciences 140, 1308-1311</gsmin:statusnotes>
    <gsmin:strunzcodeV10>0</gsmin:strunzcodeV10>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Giorgiosite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>0</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/fabriesite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Fabrièsite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Al | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;3&lt;/sub&gt;Al&lt;sub&gt;3&lt;/sub&gt;Si&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2012-080</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:mindatid>min-43600</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:43600:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-43600.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;3&lt;/sub&gt;Al&lt;sub&gt;3&lt;/sub&gt;Si&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fabrièsite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Fabriesite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Ferraris C, Parodi G C, Pont S, Rondeau B, Lorand J P (2014) Trinepheline and fabriesite: two new mineral species from the jadeite deposit of Tawmaw (Myanmar). European Journal of Mineralogy 26, 257-265 Spelling of name changed from fabriesite to fabrièsite: Hålenius U, Hatert F, Pasero M, Mills S J (2015) IMA Commission on New Minerals, Nomenclature and Classification (CNMNC) Newsletter 28. New minerals and nomenclature modifications approved in 2015. Mineralogical Magazine 79, 1859-1864</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.??.</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">silicate</gsmin:strunzlabel>
    <gsmin:wikipediadate>2012-080</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/garyansellite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Garyansellite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mg | Fe | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">reddingite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/garyansellite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1981-019</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1655</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1655:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1655.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Garyansellite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Garyansellite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Sturman B D, Dunn P J (1984) Garyansellite, a new mineral from Yukon Territory, Canada, American Mineralogist 69, 207-209 Chemical formula revised from (Mg,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O,OH)&lt;sub&gt;3&lt;/sub&gt;: Zubkova N V, Pekov I V, Kasatkin A V, Chukanov N V, Ksenofontov D A, Pushcharovsky D Y (2016) Crystal structure and refined formula of garyansellite Mg_2_Fe^3+^(PO_4_)_2_(OH)·2H_2_O. Doklady Earth Sciences 467, 299-302</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Reddingite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CC.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With only medium-sized cations, RO4:H2O = 1:1.5</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Garyansellite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1981-019</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/synchysite-ce">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Synchysite-(Ce)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Ce | C | O | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaCe(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;F</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1982-030</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaCe(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;F</gsmin:rruffchemistry>
    <gsmin:rruffids>R060210 | R060971</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Synchysite-(Ce)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Synchysite-(Ce)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mineral is described, compared to parisite, but not named: Flink G (1901) Part I. On the minerals from Narsarsuk on the Firth of Tunugdliarfik in Southern Greenland. Parisite, Meddelelser om Grønland 24, 29-42 Flink G (1901) Ueber den Synchysit, Bulletin of the Geological Institution of the University of Upsala 5, 81-87 Name changed from synchysite: Nickel E H, Mandarino J A (1987) Procedures involving the IMA Commission on New Minerals and Mineral Names and guidelines on mineral nomenclature, American Mineralogist 72, 1031-1042</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kolfanite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kolfanite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Fe | O | As | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">arseniosiderite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/kolfanite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
