    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4351:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4351.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Na,K)&lt;sub&gt;0.2&lt;/sub&gt;(Cu&lt;sup&gt;2+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;,Mg)&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Yakhontovite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Yakhontovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Postnikova V P, Tsipurskij S I, Sidorenko G A, Mokhov A V (1986) Yakhontovite - a new copper-bearing smectite, Mineralogiceskij Zhurnal 8, 80-84</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Clay</gsmin:structuralgroup>
