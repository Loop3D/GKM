  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Marble">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">IUGS SCMR 2007 (http://www.bgs.ac.uk/SCMR/), SLTTm1.0 2004</dct:source>
    <rdfs:comment xml:lang="en">Metamorphic rock consisting of greater than 75 percent fine- to coarse-grained recrystallized calcite and/or dolomite; usually with a granoblastic, saccharoidal texture.</rdfs:comment>
