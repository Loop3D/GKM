  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Carbonate_Dominated_Shoreline_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI Event Environment vocabulary</dct:source>
    <rdfs:comment xml:lang="en">A shoreline setting in which terrigenous input is minor compared to local carbonate sediment production. Constructional biogenic activity is an important element in geomorphic development.</rdfs:comment>
