  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/scorodite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Scorodite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Fe | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">scorodite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/scorodite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;3+&lt;/sup&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: IronIII arsenate dihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-3595</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3595:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3595.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;3+&lt;/sup&gt;As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R050465</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Scorodite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Scorodite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Breithaupt A (1818) Gattung M. Skorodit., in Handbuch der Mineralogie von C. A. S. Hoffmann, Volume 4, Craz und Gerlach (Freiberg) 182-185</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.CD.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With only medium-sized cations, RO4:H2O = 1:2</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://webmineral.com/data/Scorodite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1818</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/oyelite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Oyelite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | B | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/oyelite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;10&lt;/sub&gt;B&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;29&lt;/sub&gt;·12H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1980-103</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3053</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3053:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3053.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;10&lt;/sub&gt;B&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;29&lt;/sub&gt;·12H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Oyelite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Oyelite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally known as tobermorite-10A, but was shown to not be related to tobermorite, and so it was made into a new mineral species: Kusachi I, Henmi C, Henmi K (1984) An oyelite-bearing vein at Fuka, the town of Bitchu, Okayama Prefecture, Journal of the Japanese Association of Mineralogists, Petrologists and Economic Geologists 79, 267-275 Dunn P J, Chao G Y, Fitzpatrick J J, Langley R H, Fleischer M, Zilczer J A (1986) New mineral names, American Mineralogist 71, 227-232</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.HA.80</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Silicate, unclassified: With Alkali and Alkali-earth Elements</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Oyelite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1980-103</gsmin:wikipediadate>
  </rdf:Description>
