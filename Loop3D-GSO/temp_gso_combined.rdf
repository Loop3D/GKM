    <rdfs:label xml:lang="en">flaser structure</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfoliation/tectonic_foliation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kalininite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kalininite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Zn | Cr | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">linnaeite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/kalininite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">ZnCr&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1984-028</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Zinc dichromium tetrasulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-2138</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2138:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2138.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sup&gt;2+&lt;/sup&gt;Cr&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kalininite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kalininite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Reznickij L Z, Skl'arov E V, Ustschapovskaya Z F (1985) Kalininite ZnCr_2_S_4_ - a new natural sulphospinel, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 114(5), 622-627</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Spinel</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.DA.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide (M:S = 3:4)</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Kalininite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1984-028</gsmin:wikipediadate>
  </rdf:Description>
