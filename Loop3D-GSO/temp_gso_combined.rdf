    <gsmin:chemistryelements>Cu | Ag | Te</gsmin:chemistryelements>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Cu&lt;sub&gt;1-x&lt;/sub&gt;Ag&lt;sub&gt;x&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;Te, x˜0.4</gsmin:imachemistry>
