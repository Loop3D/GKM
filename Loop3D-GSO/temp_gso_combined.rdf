    <gsmin:structuralgroup xml:lang="en">Whitlockite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>0</gsmin:strunzcodeV10>
    <gsmin:wikipediadate>2011-093</gsmin:wikipediadate>
