    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | K | Ba | Ti | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">labuntsovite</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;4&lt;/sub&gt;K&lt;sub&gt;4&lt;/sub&gt;Ba&lt;sub&gt;2+x&lt;/sub&gt;Ti&lt;sub&gt;8&lt;/sub&gt;(Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH,O)&lt;sub&gt;8&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1998-052a</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-11440</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:11440:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-11440.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;4&lt;/sub&gt;K&lt;sub&gt;4&lt;/sub&gt;Ba&lt;sub&gt;2+x&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;8&lt;/sub&gt;(Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(O,OH)&lt;sub&gt;8&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070650 | R110017</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Lemmleinite-Ba</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Lemmleinite-Ba</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chukanov N V, Pekov I V, Rastsvetaeva R K, Zadov A E, Nedelko V V (2001) Lemmleinite-Ba, Na_2_K_2_Ba_1+x_Ti_4_[Si_4_O_12_]_2_(O,OH)_4_·5H_2_O, a new mineral of labuntsovite group, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 130(3), 36-43</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Labuntsovite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CE.30d</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si4O12]8- 4-membered single rings (vierer-Einfachringe), without insular complex anions</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Lemmleinite-Ba.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1998-052a</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Pyroclastic_Rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">based on LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Fragmental igneous rock that consists of greater than 75 percent fragments produced as a direct result of eruption or extrusion of magma from within the earth onto its surface. Includes autobreccia associated with lava flows and excludes deposits reworked by epiclastic processes.</rdfs:comment>
    <rdfs:label xml:lang="en">pyroclastic rock</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Fragmental_Igneous_Rock"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Pyroclastic_Material"/>
  </rdf:Description>
