  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Beach_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al., 2005</dct:source>
    <rdfs:comment xml:lang="en">The unconsolidated material at the shoreline that covers a gently sloping zone, typically with a concave profile, extending landward from the low-water line to the place where there is a definite change in material or physiographic form (such as a cliff), or to the line of permanent vegetation (usually the effective limit of the highest storm waves), at the shore of a body of water, formed and washed by waves or tides, usually covered by sand or gravel, and lacking a bare rocky surface.</rdfs:comment>
    <rdfs:label xml:lang="en">beach setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Shoreline_Setting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/shinkolobweite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Shinkolobweite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | U | H | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;1.25&lt;/sub&gt;[U&lt;sup&gt;5+&lt;/sup&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;2&lt;/sub&gt;(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;5&lt;/sub&gt;O&lt;sub&gt;8&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;](H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;5&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2016-095</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Pending publication|Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;1.25&lt;/sub&gt;[U&lt;sup&gt;5+&lt;/sup&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;2&lt;/sub&gt;(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;5&lt;/sub&gt;O&lt;sub&gt;8&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;](H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;5&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Shinkolobweite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Shinkolobweite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Olds, T.A., Lussier, A.J., Oliver, A.G., Petrícek, V., Plášil, J., Kampf, A.R., Burns, P.C., Dembowski, M., Carlson, S.M. and Steele, I.M. (2017) Shinkolobweite, IMA 2016-095. CNMNC Newsletter No. 36, April 2017, page 339; European Journal of Mineralogy, 29, 339–344</gsmin:statusnotes>
  </rdf:Description>
