    <gsmin:rruffnameplain xml:lang="en">Dimorphite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Original name is dimorfina: Scacchi A (1849) Memoria IIIa. Esame delle sostanze che si formano presso i fumaroli della Regione Flegrea, Memorie Geologiche sulla Campania 3a, (Napoli) 83-131</gsmin:statusnotes>
