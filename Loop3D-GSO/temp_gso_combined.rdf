  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/faustite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Faustite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Zn | Al | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">turquoise</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/faustite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">ZnAl&lt;sub&gt;6&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;8&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Zinc hexaaluminium tetraphosphate octahydroxyl tetrahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1623</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1623:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1623.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sup&gt;2+&lt;/sup&gt;Al&lt;sub&gt;6&lt;/sub&gt;(P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;8&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060891</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Faustite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Faustite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Erd R C, Foster M D, Proctor P D (1953) Faustite, a new mineral, the zinc analogue of turquois, American Mineralogist 38, 964-972</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Turquoise</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DD.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With only medium-sized cations, (OH, etc.):RO4= 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Faustite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1953</gsmin:wikipediadate>
  </rdf:Description>
