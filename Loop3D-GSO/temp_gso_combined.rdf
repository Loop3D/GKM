    <gsmin:webmineralurl>http://www.webmineral.com/data/Olgite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1979-027</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/arsentsumebite">
