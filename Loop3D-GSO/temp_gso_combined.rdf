  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/barwoodite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Barwoodite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | Nb | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;(Nb&lt;sup&gt;5+&lt;/sup&gt;,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)&lt;sub&gt;2&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(O,OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2017-046</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;(Nb&lt;sup&gt;5+&lt;/sup&gt;,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)&lt;sub&gt;2&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(O,OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Barwoodite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Barwoodite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf A R, Celestian A J, Nash B P (2018) Barwoodite, Mn^2+^_6_(Nb^5+^,[box])_2_(SiO_4_)_2_(O,OH)_6_, a new member of the welinite group from Granite Mountain, Arkansas. The Canadian Mineralogist 56, 799-809</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Welinite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/argentotetrahedrite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Argentotetrahedrite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ag | Cu | Fe | Zn | Sb | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ag&lt;sub&gt;6&lt;/sub&gt;Cu&lt;sub&gt;4&lt;/sub&gt;(Fe,Zn)&lt;sub&gt;2&lt;/sub&gt;Sb&lt;sub&gt;4&lt;/sub&gt;S&lt;sub&gt;13&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2016-093</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-10677</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:10677:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-10677.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ag&lt;sup&gt;1+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;Cu&lt;sup&gt;1+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;(Fe&lt;sup&gt;2+&lt;/sup&gt;,Zn&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;Sb&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;13&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Argentotetrahedrite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Argentotetrahedrite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Welch M D, Stanley C J, Spratt J, Mills S J (2018) Rozhdestvenskayaite Ag_10_Zn_2_Sb_4_S_13_ and argentotetrahedrite Ag_6_Cu_4_(Fe^2+^,Zn)_2_Sb_4_S_13_: two Ag-dominant members of the tetrahedrite group. European Journal of Mineralogy 30, 1163-1172</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Tennantite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">sulfide or sulfosalt</gsmin:strunzlabel>
    <gsmin:wikipediadate>1992, 2008 s.p.</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Lower_Mantle_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al., 2005</dct:source>
    <rdfs:comment xml:lang="en">That part of the mantle that lies below a depth of about 660 km. With increasing depth, density increases from ~4.4 g/cm3-to ~5.6 g/cm3, and velocity of compressional seismic waves increases from ~10.7 km/s to ~13.7 km/s (Dziewonski and Anderson, 1981).</rdfs:comment>
    <rdfs:label xml:lang="en">lower mantle setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Mantle_Setting"/>
    <rdfs:subClassOf rdf:nodeID="nb91377c629b1476ba973ba249cd56575b53"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n7bda25761fc44f8595ef751309700190b183">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:intersectionOf rdf:nodeID="n7bda25761fc44f8595ef751309700190b186"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/tweddillite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Tweddillite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Sr | Mn | Al | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">epidote</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaSr(Mn&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Al)[Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;][SiO&lt;sub&gt;4&lt;/sub&gt;]O(OH)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2001-014</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaSrMn&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Al(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)(SiO&lt;sub&gt;4&lt;/sub&gt;)O(OH)</gsmin:rruffchemistry>
    <gsmin:rruffids>R120125</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tweddillite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tweddillite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Armbruster T, Gnos E, Dixon R, Gutzmer J, Hejny C, Döbelin N, Medenbach O (2002) Manganvesuvianite and tweddillite, two new Mn^3+^-silicate minerals, Mineralogical Magazine 66, 137-150 Name changed from tweddillite to manganipiemontite-(Sr): Armbruster T, Bonazzi P, Akasaka M, Bermanec V, Chopin C, Giere R, Huess-Assbichler S, Liebscher A, Menchetti S, Pan Y, Pasero M (2006) Recommended nomeclature of epidote-group minerals, European Journal of Mineralogy 18, 551-567 Name changed back to tweddillite: Revheim O, King V T (2016) Epidote supergroup nomenclature: The names hancockite, niigataite and tweddillite reinstated. Mineralogical Magazine 80, 877-880</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Epidote</gsmin:structuralgroup>
  </rdf:Description>
