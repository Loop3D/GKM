  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/althupite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Althupite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Al | Th | U | O | P | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">phosphuranylite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/althupite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">AlTh(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;7&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;5&lt;/sub&gt;·15H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1986-003</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-149</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:149:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-149.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">AlTh&lt;sup&gt;4+&lt;/sup&gt;(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;7&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;5&lt;/sub&gt;·15H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Althupite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Althupite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Piret P, Deliens M (1987) Les phosphates d'uranyle et d'aluminium de Kobokobo IX. L'althupite AlTh(UO&lt;sub&gt;2&lt;/sub&gt;)[(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;O(OH)PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;]&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;·15H&lt;sub&gt;2&lt;/sub&gt;O, nouveau mineral; properties et structures cristalline, Bulletin de Minéralogie 110, 65-72</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.EC.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl phosphate or arsenate, UO2:RO4 = 3:2</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Althupite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1986-003</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ardaite">
