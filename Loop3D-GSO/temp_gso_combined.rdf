    <gsmin:rruffnameplain xml:lang="en">Schuilingite-(Nd)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Fleischer M (1948) New mineral names, American Mineralogist 33, 384-386 Name changed from schuilingite: Nickel E H, Mandarino J A (1987) Procedures involving the IMA Commission on New Minerals and Mineral Names and guidelines on mineral nomenclature, American Mineralogist 72, 1031-1042</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.DB.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions and H2O, With large and medium-sized cations</gsmin:strunzlabel>
