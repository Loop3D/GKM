    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;2&lt;/sub&gt;[(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;5&lt;/sub&gt;]·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2016-064</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;2&lt;/sub&gt;[(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;5&lt;/sub&gt;]·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Leesite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Leesite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Olds T A, Plášil J, Kampf A R, Spano T, Haynes P, Carlson S M, Burns P C, Simonetti A, Mills O P (2018) Leesite, K(H_2_O)_2_[(UO_2_)_4_O_2_(OH)_5_]·3H_2_O, a new K-bearing schoepite-family mineral from the Jomac mine, San Juan County, Utah, U.S.A. American Mineralogist 103, 143-150</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/wakefieldite-ce">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
