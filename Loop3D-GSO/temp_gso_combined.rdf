    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;9&lt;/sub&gt;Mg(PO&lt;sub&gt;3&lt;/sub&gt;OH)(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4280</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4280:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4280.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;9&lt;/sub&gt;Mg(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;(PO&lt;sub&gt;3&lt;/sub&gt;OH)</gsmin:rruffchemistry>
    <gsmin:rruffids>R070675 | R080052</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Whitlockite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Whitlockite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Frondel C (1941) Whitlockite: a new calcium phosphate, Ca3(PO4)2, American Mineralogist 26, 145-152 Chemical formula redefined: Gopal R, Calvo C (1972) Structural relationship of whitlockite and ß Ca_3_(PO_4_)_2_, Nature Physical Science 237, 30-32</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Whitlockite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.AC.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, without H2O, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Whitlockite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1941</gsmin:wikipediadate>
