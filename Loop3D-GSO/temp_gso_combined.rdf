    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Maghrebite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Maghrebite</gsmin:rruffnameplain>
