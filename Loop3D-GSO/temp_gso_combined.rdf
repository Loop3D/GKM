    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2223:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2223.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sb&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060157</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Klebelsbergite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Klebelsbergite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Zsivny V (1929) Klebelsbergit, ein neues mineral von Felsöbánya, Matematikai és Természettudományi Értesitö 46, 19-24 Redefined: Nakai I, Appleman D E (1980) Klebelsbergite, Sb_4_O_4_(OH)_2_SO_4_: redefined and synthesis, American Mineralogist 65, 499-505</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Klebelsbergite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.BB.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions, without H2O, With medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Klebelsbergite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1929</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/bobshannonite">
