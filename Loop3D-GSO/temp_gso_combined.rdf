    <gsmin:mindaturl>http://www.mindat.org/min-6957.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;3&lt;/sub&gt;Na&lt;sub&gt;3&lt;/sub&gt;Ca&lt;sub&gt;5&lt;/sub&gt;Si&lt;sub&gt;12&lt;/sub&gt;O&lt;sub&gt;30&lt;/sub&gt;(F,OH)&lt;sub&gt;4&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060100</gsmin:rruffids>
