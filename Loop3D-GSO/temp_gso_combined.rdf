    <gsmin:mindaturl>http://www.mindat.org/min-2893.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(N&lt;sup&gt;3-&lt;/sup&gt;H&lt;sub&gt;4&lt;/sub&gt;)Mn&lt;sup&gt;2+&lt;/sup&gt;PO&lt;sub&gt;4&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Niahite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Niahite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Bridge P J, Robinson B W (1983) Niahite - a new mineral from Malaysia, Mineralogical Magazine 47, 79-80 Dunn P J, Cabri L J, Chao G Y, Fleischer M, Francis C A, Grice J D, Jambor J L, Pabst A (1984) New mineral names, American Mineralogist 69, 406-412</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.CH.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With large and medium-sized cations, RO4:H2O &lt; 1:1</gsmin:strunzlabel>
