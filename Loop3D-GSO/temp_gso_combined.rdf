    <gsmin:rruffids>R060775</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nevadaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Nevadaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Cooper M A, Hawthorne F C, Roberts A C, Foord E E, Erd R C, Evans H T, Jensen M C (2004) Nevadaite, (Cu^2+^,[box],Al,V^3+^)_6_[Al_8_(PO_4_)_8_F_8_](OH)_2_(H_2_O)_22_, a new phosphate mineral species from the Gold Quarry mine, Carlin, Eureka County, Nevada: description and crystal structure, The Canadian Mineralogist 42, 741-752</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.DC.60</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With only medium-sized cations, (OH, etc.):RO4 = 1:1 and &lt; 2:1</gsmin:strunzlabel>
