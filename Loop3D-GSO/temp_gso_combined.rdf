    <gsmin:statusnotes xml:lang="en">Cesaro G (1884) Sur la koninckite, nouveau phosphate ferrique hydrate, Annales de la Société Géologique de Belgique 11, 247-257</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.CE.55</gsmin:strunzcodeV10>
