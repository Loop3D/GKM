    <gsmin:mindaturl>http://www.mindat.org/min-4402.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;V&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070482</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ziesite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ziesite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hughes J M, Birnie R W (1980) Ziesite, ß-Cu_2_V_2_O_7_, a new copper vanadate and fumarole temperature indicator, American Mineralogist 65, 1146-1149</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.FA.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Polyphosphate, etc., without OH and H2O; dimers of corner-sharing RO4 tetrahedra.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Ziesite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1979-055</gsmin:wikipediadate>
