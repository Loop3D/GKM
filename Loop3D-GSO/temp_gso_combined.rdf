  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/vulcanite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Vulcanite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Te</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/vulcanite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CuTe</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: CopperI telluride</gsmin:iupacchemname>
    <gsmin:mindatid>min-4213</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4213:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4213.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CuTe</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Vulcanite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Vulcanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Cameron E N, Threadgold I M (1961) Vulcanite, a new copper telluride from Colorado, with notes on certain associated minerals, American Mineralogist 46, 258-268</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.CB.75</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide (M = S) with Zn, Fe, Cu, Ag, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Vulcanite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1961</gsmin:wikipediadate>
  </rdf:Description>
