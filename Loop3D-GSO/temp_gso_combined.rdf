    <gsmin:rruffnameplain xml:lang="en">Pyrope</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Ludwig C F (1803) Sippschaft des granats. Pyrop, in Handbuch der Mineralogie nach A. G. Werner, Siegfried Lebrécht Crusius (Leipzig) 62-67</gsmin:statusnotes>
