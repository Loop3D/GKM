    <gsmin:statusnotes xml:lang="en">Roberts A C, Venance K E, Seward T M, Grice J D, Paar W H (2006) Lafossaite, a new mineral from the La Fossa Crater, Vulcano, Italy, The Mineralogical Record 37, 165-168</gsmin:statusnotes>
    <gsmin:strunzcodeV10>03.AA.25</gsmin:strunzcodeV10>
