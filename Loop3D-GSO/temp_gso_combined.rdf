    <gsmin:imanumber xml:lang="en">IMA1986-020</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Cerium dititanium pentaoxide hydroxyl</gsmin:iupacchemname>
