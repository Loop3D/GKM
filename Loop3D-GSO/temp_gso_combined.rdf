    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KCa&lt;sub&gt;12&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;F</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nabimusaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Nabimusaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Galuskin E V, Gfeller F, Armbruster T, Galuskina I O, Vapnik Y, Murashko M, Wlodyka R, Dzierzanowski P (2015) New minerals with a modular structure derived from hatrurite from the pyrometamorphic Hatrurim Complex. Part I. Nabimusaite, KCa_12_(SiO_4_)_4_(SO_4_)_2_O_2_F, from larnite rocks of Jabel Harmun, Palestinian Autonomy, Israel. Mineralogical Magazine 79, 1061-1072</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Nabimusaite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ferronickelplatinum">
