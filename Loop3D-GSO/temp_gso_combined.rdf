    <gsmin:rruffnameplain xml:lang="en">Shannonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Roberts A C, Stirling J A R, Carpenter G J C, Criddle A J, Jones G C, Birkett T C, Birch W D (1995) Shannonite, Pb2OCO3, a new mineral from the Grand Reef mine, Graham County, Arizona, USA, Mineralogical Magazine 59, 305-310</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.BE.05</gsmin:strunzcodeV10>
