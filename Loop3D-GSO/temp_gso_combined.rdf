    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3125:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3125.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(K,Na,Ca)&lt;sub&gt;7.5&lt;/sub&gt;(Mn&lt;sup&gt;2+&lt;/sup&gt;,Mg)&lt;sub&gt;49&lt;/sub&gt;Si&lt;sub&gt;72&lt;/sub&gt;O&lt;sub&gt;168&lt;/sub&gt;(OH)&lt;sub&gt;50&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Parsettensite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Parsettensite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Jakob J (1923) Vier Mangansilikate aus dem Val d'Err (Kt. Graubünden), Schweizerische Mineralogische und Petrographische Mitteilungen 3, 227-237</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Clay</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EG.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate: Double nets with 6-membered and larger rings</gsmin:strunzlabel>
