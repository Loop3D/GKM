  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/alluaivite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Alluaivite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Mn | Ti | Nb | Si | O | Cl | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/alluaivite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;19&lt;/sub&gt;(Ca,Mn&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;6&lt;/sub&gt;(Ti,Nb)&lt;sub&gt;3&lt;/sub&gt;Si&lt;sub&gt;26&lt;/sub&gt;O&lt;sub&gt;74&lt;/sub&gt;Cl·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1988-052</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-141</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:141:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-141.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;19&lt;/sub&gt;(Ca,Mn&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;6&lt;/sub&gt;(Ti&lt;sup&gt;4+&lt;/sup&gt;,Nb&lt;sup&gt;5+&lt;/sup&gt;)&lt;sub&gt;3&lt;/sub&gt;Si&lt;sub&gt;26&lt;/sub&gt;O&lt;sub&gt;74&lt;/sub&gt;Cl·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Alluaivite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Alluaivite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Khomyakov A P, Netschelyustov G N, Rastsvetaeva R K (1990) Alluaivite Na&lt;sub&gt;19&lt;/sub&gt;(Ca,Mn)&lt;sub&gt;6&lt;/sub&gt;(Ti,Nb)&lt;sub&gt;3&lt;/sub&gt;Si&lt;sub&gt;26&lt;/sub&gt;O&lt;sub&gt;74&lt;/sub&gt;Cl·2H&lt;sub&gt;2&lt;/sub&gt;O – a new titanosilicate of eudialyte–like structure, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 119(1), 117-120</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Eudialyte</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CO.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si9O27]18- 9-membered rings</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Alluaivite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1988-052</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/amblygonite">
