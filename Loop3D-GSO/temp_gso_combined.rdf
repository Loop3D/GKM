    <gsmin:imanumber xml:lang="en">IMA1998-065</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-7729</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7729:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7729.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;9&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060291</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hydroxylclinohumite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hydroxylclinohumite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Gekimyants V M, Sokolova E V, Spiridonov E M, Ferraris G, Chukanov N V, Prencipe M, Avdonin V N, Polenov Y A (1999) Hydroxylclinohumite Mg_9_(SiO_4_)_4_(OH,F)_2_ - a new mineral of the humite group, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 128(5), 64-70</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Humite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AF.55</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with additional anions; cations in [4], [5] and/or only [6] coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Hydroxylclinohumite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1998-065</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/keiviite-y">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Keiviite-(Y)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Y | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">thortveitite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/keiviitey.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Y&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1984-054</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2177</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2177:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2177.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Y&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Keiviite-(Y)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Keiviite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Voloshin A V, Pakhomovsky Y A, Tyusheva F N (1985) Keiviite-(Y) - A new yttrian diorthosilicate, and thalenite from amazonite pegmatites of the Kola Peninsula. Diortho- and triorthosilicates of yttrium, Mineralogiceskij Zhurnal 7, 79-94</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Thortveitite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.BC.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate: Si2O7 groups, without non-tetrahedral anions; cations in octahedral [6] and greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Keiviite-%28Y%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1984-054</gsmin:wikipediadate>
  </rdf:Description>
