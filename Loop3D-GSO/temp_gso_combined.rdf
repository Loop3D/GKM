    <gsmin:mindaturl>http://www.mindat.org/min-879.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;2&lt;/sub&gt;(HBO&lt;sub&gt;3&lt;/sub&gt;)(CO&lt;sub&gt;3&lt;/sub&gt;)·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Canavesite</gsmin:rruffnamehtml>
