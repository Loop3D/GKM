    <gsmin:mindaturl>http://www.mindat.org/min-7053.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Mo&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;As&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;5&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Vajdakite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Vajdakite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Ondruš P, Skála R, Císarová I, Veselovský F, Frýda J, Cejka J (2002) Description and crystal structure of vajdakite, [(Mo^6+^O_2_)_2_(H_2_O)_2_As^3+^_2_O_5_]·H_2_O - a new mineral from Jáchymov, Czech Republic, American Mineralogist 87, 983-990</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.JC.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Arsenite, antimonite, bismuthite; without additional anions, with H2O</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Vajdakite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1998-031</gsmin:wikipediadate>
  </rdf:Description>
