    <gsmin:rruffnameplain xml:lang="en">Cobalttsumcorite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Krause W, Bernhardt H J, Effenberger H, Martin M (2001) Cobalttsumcorite and nickellotharmeyerite, two new minerals from Schneeberg, Germany: description and crystal structure, Neues Jahrbuch für Mineralogie, Monatshefte 2001, 558-576</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Natrochalcite</gsmin:structuralgroup>
