  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/rosslerite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Rösslerite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mg | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/rosslerite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg(AsO&lt;sub&gt;3&lt;/sub&gt;OH)·7H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3470</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3470:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3470.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;OH)·7H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Rösslerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Rosslerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Blum R (1861) Rösslerit, ein neues Mineral, Jahresbericht der Wetterauischen Gesellschaft für die Gesammte Naturkunde zu Hanau 1861, 32-36</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.CE.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With only medium-sized cations, RO4:H2O about 1:2.5</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Rosslerite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1861</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/fersmite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Fersmite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Ce | Na | Nb | Ta | Ti | O | H | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">columbite-euxenite-columbite subgroup</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/fersmite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Ce,Na)(Nb,Ta,Ti)&lt;sub&gt;2&lt;/sub&gt;(O,OH,F)&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1539</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1539:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1539.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Ce&lt;sup&gt;3+&lt;/sup&gt;,Na)(Nb&lt;sup&gt;5+&lt;/sup&gt;,Ta&lt;sup&gt;5+&lt;/sup&gt;,Ti&lt;sup&gt;4+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;(O,OH,F)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060717</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fersmite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Fersmite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Bohnstedt-Kupletskaya E M, Burova T A (1946) Fersmite, a new calcium niobate from the pegmatites of the Vishnevye Mts., the Central Urals, Comptes Rendus (Doklady) de l’Académie des Sciences de l’URSS 52, 69-71</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Columbite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.DG.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With large (+- medium-sized) cations; chains of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Fersmite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1946</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/athabascaite">
