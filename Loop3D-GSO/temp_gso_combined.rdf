    <gsmin:chemistryelements>Rh | As | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">cobaltite</gsmin:fleischersgroup>
