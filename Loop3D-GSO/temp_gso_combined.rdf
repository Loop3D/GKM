  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/nickelaustinite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Nickelaustinite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Ni | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">adelite-descloizite-adelite subgroup</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/nickelaustinite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaNi(AsO&lt;sub&gt;4&lt;/sub&gt;)(OH)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1985-002</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2891</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2891:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2891.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaNi&lt;sup&gt;2+&lt;/sup&gt;As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nickelaustinite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Nickelaustinite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Cesbron F P, Ginderow D, Giraud R, Pelisson P, Pillard F (1987) La nickelaustinite Ca(Ni,Zn)(AsO4)(OH): Nouvelle espèce minérale du district cobalto-nickelifère de bou-azzer, Maroc, The Canadian Mineralogist 25, 401-407 Jambor J L, Bladh K W, Ercit T S, Grice J D, Grew E S (1988) New mineral names, American Mineralogist 73, 927-935</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Adelite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BH.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH,etc.):RO4 = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Nickelaustinite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1985-002</gsmin:wikipediadate>
  </rdf:Description>
