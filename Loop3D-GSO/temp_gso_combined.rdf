    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sb&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;W&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tungstibite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tungstibite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Walenta K (1995) Tungstibit, Sb2O3·WO3 - ein neues Mineral von der Grube Clara bei Oberwolfach im mittleren Schwarzwald (Deutschland), Chemie der Erde 55, 217-224</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.DE.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With medium-sized cations; with various polyhedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Tungstibite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1993-059</gsmin:wikipediadate>
