    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Zn(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1985-055</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dicalcium zinc diarsenate dihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-4415</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4415:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4415.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Zn&lt;sup&gt;2+&lt;/sup&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R100192</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zincroselite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Zincroselite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Keller P, Innes J, Dunn P J (1986) Zincroselite, Ca_2_Zn(AsO_4_)_2_·2H_2_O, a new mineral from Tsumeb, Namibia, Neues Jahrbuch für Mineralogie, Monatshefte 1986, 523-527</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Roselite</gsmin:structuralgroup>
