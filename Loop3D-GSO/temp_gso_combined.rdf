    <gsmin:wikipediadate>1882</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/beudantite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Beudantite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Fe | As | O | S | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">alunite-jarosite-beudantite subgroup</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/beudantite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">PbFe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)(SO&lt;sub&gt;4&lt;/sub&gt;)(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Palladium triironIII arsenate sulfate hexahydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-652</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:652:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-652.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060985 | R070189 | R070190 | R070492 | R070502 | R100183</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Beudantite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Beudantite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Levy A (1826) Descriptions of two new minerals, The Annals of Philosophy 11, 194-196</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Alunite-beudantite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BL.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH, etc.):RO4 = 3:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Beudantite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1826</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/deltalumite">
