  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/yttrotungstite-y">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Yttrotungstite-(Y)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Y | W | Fe | Si | Al | Ti | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/yttrotungstitey.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Y(W,Fe,Si,Al,Ti)&lt;sub&gt;2&lt;/sub&gt;(O,OH,H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;9&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4374</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4374:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4374.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Y&lt;sup&gt;3+&lt;/sup&gt;W&lt;sup&gt;6+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050569</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Yttrotungstite-(Y)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Yttrotungstite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Scrivenor J B, Shenton J C (1927) Thorotungstite. A mineral containing tungsten and thorium from the Federated Malay States, American Journal of Science 13, 487-490 Chemical formula revised and name changed from thorotungstite: Beard E H (1950) Thorotungstite - a misnomer, Colonial Geology and Mineral Resources 1, 50-51 Name changed from yttrotungstite: Nickel E H, Mandarino J A (1987) Procedures involving the IMA Commission on New Minerals and Mineral Names and guidelines on mineral nomenclature, American Mineralogist 72, 1031-1042</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.FD.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Hydroxide (without V or U), Hydroxides with OH, without H2O; chains of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Yttrotungstite-%28Y%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1927</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/philipsburgite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Philipsburgite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
