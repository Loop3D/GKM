  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ewaldite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ewaldite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ba | Na | Ca | Y | Ce | K | C | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/ewaldite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba(Na,Ca,Y,Ce,K)(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·2.6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1969-013</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1429</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1429:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1429.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba(Na,Ca,Y,Ce,K)(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·2.6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ewaldite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ewaldite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Donnay G, Donnay J D H, Hey M H (1971) Ewaldite, a new barium calcium carbonate I. Occurrence of ewaldite in syntactic intergrowth with mackelvyite. Tschermaks Mineralogische und Petrographische Mitteilungen 15, 185-200 Chemical formula redefined: Voloshin A V, Subbotin V V, Yakovenchuk V N, Pakhomovskii Ya A, Men'shikov Y P, Nadezhina T N, Pushcharovskii D Y (1992) New data on the ewaldite, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 1992, 56-66</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.CC.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate without additional anions, with H2O, With rare earth elements (REE)</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Ewaldite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1969-013</gsmin:wikipediadate>
  </rdf:Description>
