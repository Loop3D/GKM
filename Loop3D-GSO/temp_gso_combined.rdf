  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/zippeite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Zippeite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | U | O | S | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic, orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">zippeite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/zippeite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;3&lt;/sub&gt;(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;3&lt;/sub&gt;(OH)·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1971-029a</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Redefined|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4420</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4420:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4420.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;3&lt;/sub&gt;(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;3&lt;/sub&gt;(OH)·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zippeite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Zippeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Haidinger W (1845) Zweite Klasse: Geogenide. XI. Ordnung, Erze. VII. Uranerz. Zippeit., in Handbuch der Bestimmenden Mineralogie, Bei Braumüller and Seidel (Wien) 506-511 Redefined: Frondel C, Ito J, Honea R M, Weeks A M (1976) Mineralogy of the zippeite group, The Canadian Mineralogist 14, 429-436</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Zippeite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.EC.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl sulfate, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Zippeite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1971-002a</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/mitscherlichite">
