    <gsmin:rruffnameplain xml:lang="en">Vikingite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Makovicky E, Karup-Møller S (1977) Chemistry and crystallography of the lillianite homologous series. Part II: Definition of new minerals: eskimoite, vikingite, ourayite, and treasurite. Redefinition of schirmerite and new data on the lillianite-gustavite solid solution series, Neues Jahrbuch für Mineralogie, Abhandlungen 131, 56-82</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Lillianite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.JB.40a</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">PbS type sulfosalt with Pb</gsmin:strunzlabel>
