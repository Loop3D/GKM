    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Malyshevite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Malyshevite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chernikov A A, Chistykova N I, Uvarkina O M, Dubinchuk V T, Rassulov V A, Polehovsky Y S (2006) Malyshevite - A new mineral from Srednyaya Padma deposit in Southern Karelia, New Data on Minerals. Moscow 41, 14-17</gsmin:statusnotes>
