  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/suseinargiuite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Suseinargiuite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Bi | Mo | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na&lt;sub&gt;0.5&lt;/sub&gt;Bi&lt;sub&gt;0.5&lt;/sub&gt;)(MoO&lt;sub&gt;4&lt;/sub&gt;)</gsmin:imachemistry>
