    <gsmin:chemistryelements>Fe | F | H | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">FeF&lt;sub&gt;3&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2016-113</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;3+&lt;/sup&gt;F&lt;sub&gt;3&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Topsøeite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Topsoeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Balic-Žunic T, Garavelli A, Mitolo D (2018) Topsøeite, FeF_3_(H_2_O)_3_, a new fumarolic mineral from the Hekla volcano, Iceland. European Journal of Mineralogy 30, 841-848</gsmin:statusnotes>
