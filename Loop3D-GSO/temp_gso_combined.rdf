  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/triplite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Triplite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | Fe | P | O | F | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">triplite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/triplite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Mn&lt;sup&gt;2+&lt;/sup&gt;,Fe&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)F</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: DimanganeseII phosphate fluoride</gsmin:iupacchemname>
    <gsmin:mindatid>min-4021</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4021:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4021.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)F</gsmin:rruffchemistry>
    <gsmin:rruffids>R050186 | R050226 | R050615 | R060743 | R060935 | R070645</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Triplite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Triplite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hausmann J F L (1813) Triplit, in Handbuch der Mineralogie, Volume 2, (Göttingen) 1079-1080</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Triplite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BB.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With only medium-sized cations, (OH, etc.):RO4 about 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Triplite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1813</gsmin:wikipediadate>
  </rdf:Description>
