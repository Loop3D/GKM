    <gsmin:rruffnameplain xml:lang="en">Koashvite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kapustin Y L, Pudovkina Z V, Bykova A V, Lyubomilova G V (1974) Koashvite, a new mineral, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 103(5), 559-566</gsmin:statusnotes>
