    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Cobalt diironIII diarsenate dihydroxyl tetrahydrate</gsmin:iupacchemname>
