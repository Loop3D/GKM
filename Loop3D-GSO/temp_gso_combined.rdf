    <gsmin:rruffnameplain xml:lang="en">Orthopinakiolite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Randmets R (1960) Orthopinakiolite, a new modification of Mg_3_Mn^2+^Mn^3+^_2_B_2_O_10_ from Långban, Sweden, Arkiv för Mineralogi och Geologi 2, 551-555 Chemical formula changed from Mg_3_Mn^2+^Mn^3+^_2_B_2_O_10_: Takéuchi Y, Haga N, Kato T, Miura Y (1978) Orthopinakiolite, Me_2.95_O_2_[BO_3_]: its crystal structure and relationship to pinakiolite, Me_2.90_O_2_[BO_3_], The Canadian Mineralogist 16, 475-485</gsmin:statusnotes>
    <gsmin:strunzcodeV10>06.AB.40</gsmin:strunzcodeV10>
