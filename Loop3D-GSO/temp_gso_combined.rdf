    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bubnovaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Bubnovaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Gorelova L A, Vergasova L P, Krivovichev S V, Avdontseva E Y, Moskaleva S V, Karpov G A, Filatov S K (2016) Bubnovaite, K_2_Na_8_Ca(SO_4_)_6_, a new mineral species with modular structure from the Tolbachik volcano, Kamchatka peninsula, Russia. European Journal of Mineralogy 28, 677-686</gsmin:statusnotes>
