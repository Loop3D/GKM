    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4289:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4289.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaMn&lt;sup&gt;2+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Wilhelmvierlingite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Wilhelmvierlingite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mücke A (1983) Wilhelmvierlingit, (Ca,Zn)MnFe^3+^[OH(PO_4_)_2_]_2_H_2_O, ein neues Mineral von Hagendorf/Oberpfalz, Der Aufschluss 34, 267-274</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Overite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DH.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 &lt; 1:1</gsmin:strunzlabel>
