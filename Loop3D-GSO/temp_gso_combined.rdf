    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;12&lt;/sub&gt;(PO&lt;sub&gt;3&lt;/sub&gt;OH,CO&lt;sub&gt;3&lt;/sub&gt;)(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;5&lt;/sub&gt;(OH,O)&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1976-054</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1924</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1924:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1924.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;12&lt;/sub&gt;(PO&lt;sub&gt;3&lt;/sub&gt;OH,CO&lt;sub&gt;3&lt;/sub&gt;)(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;5&lt;/sub&gt;(OH,O)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060710</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Holtedahlite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Holtedahlite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Raade G, Mladeck M H (1979) Holtedahlite, a new magnesium phosphate from Modum, Norway, Lithos 12, 283-287</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.BB.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With only medium-sized cations, (OH, etc.):RO4 about 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Holtedahlite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1976-054</gsmin:wikipediadate>
  </rdf:Description>
