    <gsmin:chemistryelements>Ca | P | O | Si</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;5&lt;/sub&gt;[(PO&lt;sub&gt;4&lt;/sub&gt;)(SiO&lt;sub&gt;4&lt;/sub&gt;)](PO&lt;sub&gt;4&lt;/sub&gt;)</gsmin:imachemistry>
