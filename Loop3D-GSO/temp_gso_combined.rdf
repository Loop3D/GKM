    <gsmin:mindaturl>http://www.mindat.org/min-1264.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)(Se&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R100223</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Derriksite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Derriksite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Cesbron F, Pierrot R, Verbeek T (1971) La derriksite, Cu&lt;sub&gt;4&lt;/sub&gt;(UO&lt;sub&gt;2&lt;/sub&gt;)(SeO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O, une nouvelle espèce minérale, Bulletin de la Société Française de Minéralogie et de Cristallographie 94, 534-537</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.JG.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Selenite with additional anions, without H2O</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Derriksite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1971-033</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/witzkeite">
