  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/loranskite-y">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Loranskite-(Y)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Y | Ce | Ca | Zr | Ta | O</gsmin:chemistryelements>
    <gsmin:fleischersgroup xml:lang="en">columbite-euxenite-euxenite subgroup</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/loranskitey.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Y,Ce,Ca)(Zr,Ta)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt; (?)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2435</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2435:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2435.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Y,Ce,Ca)(Zr&lt;sup&gt;4+&lt;/sup&gt;,Ta&lt;sup&gt;5+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Loranskite-(Y)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Loranskite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Melnikow M (1899) Loranskit, ein neues mineral, Zeitschrift für Krystallographie und Mineralogie 31, 505-505 Name changed from loranskite: Nickel E H, Mandarino J A (1987) Procedures involving the IMA Commission on New Minerals and Mineral Names and guidelines on mineral nomenclature, American Mineralogist 72, 1031-1042</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.DG.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With large (+- medium-sized) cations; chains of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Loranskite-%28Y%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1899</gsmin:wikipediadate>
  </rdf:Description>
