  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologiclineation/igneous_lineation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI lineationtype SKOS vocabulary 2016-11-21</dct:source>
    <rdfs:comment xml:lang="en">Lineation defined by alignment of elongate fabric elements formed in lava or magma before complete crystallization. Some typical fabric elements are elongate phenocrysts and vesicles.</rdfs:comment>
    <rdfs:label xml:lang="en">igneous lineation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicstructure/Lineation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/jahnsite-mnmnzn">
