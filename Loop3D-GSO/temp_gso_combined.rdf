    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:35971:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-35971.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Y&lt;sup&gt;3+&lt;/sup&gt;,Ce&lt;sup&gt;3+&lt;/sup&gt;,Ca,Na,Mn&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;15&lt;/sub&gt;CaFe&lt;sup&gt;2+&lt;/sup&gt;(P&lt;sup&gt;5+&lt;/sup&gt;,Si)Si&lt;sub&gt;6&lt;/sub&gt;B&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;34&lt;/sub&gt;F&lt;sub&gt;14&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Proshchenkoite-(Y)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Proshchenkoite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Raade G, Grice J D, Erambert M, Kristiansson P, Witzke T (2008) Proshchenkoite-(Y) from Russia - a new mineral species in the vicanite group: Descriptive data and crystal structure, Mineralogical Magazine 72, 1071-1082</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Okanoganite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AJ.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with BO3 triangles and/or B[4], Be[4] tetrahedra, cornersharing with SiO4</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Proshchenkoite-(Y).shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2008-007</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Wetland_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI Event Environment vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Setting characterized by gentle surface slope, and at least intermittent presence of standing water, which may be fresh, brackish, or saline. Wetland may be terrestrial setting or shoreline setting.</rdfs:comment>
    <rdfs:label xml:lang="en">wetland setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Planet_Surface_Setting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/swamboite-nd">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Swamboite-(Nd)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Nd | U | O | Si | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nd&lt;sub&gt;0.333&lt;/sub&gt;[(UO&lt;sub&gt;2&lt;/sub&gt;)(SiO&lt;sub&gt;3&lt;/sub&gt;OH)](H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;~2.5&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1981-008</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nd&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;0.333&lt;/sub&gt;[(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)(SiO&lt;sub&gt;3&lt;/sub&gt;OH)](H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;~2.5&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Swamboite-(Nd)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Swamboite-(Nd)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Deliens M, Piret P (1981) La swamboïte, nouveau silicate d'uranium hydraté du shaba, Zaïre, The Canadian Mineralogist 19, 553-557 Mineral name and formula changed from swamboite and U^6+^(UO_2_)_6_(SiO_3_OH)_6_·30H_2_O: Plášil J, Petrícek V, Locock A J, Škoda R, Burns P C (2018) The (3+3) commensurately modulated structure of the uranyl silicate mineral swamboite-(Nd), Nd_0.333_[(UO_2_)(SiO_3_OH)](H_2_O)_2.41_. Zeitschrift für Kristallographie 233, 223-231</gsmin:statusnotes>
  </rdf:Description>
