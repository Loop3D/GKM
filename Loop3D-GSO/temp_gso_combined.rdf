  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Calcareous_Carbonate_Sediment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">after Hallsworth and Knox 1999</dct:source>
    <rdfs:comment xml:lang="en">Carbonate sediment with a calcite (plus aragonite) to dolomite ratio greater than 1 to 1. Includes lime-sediments.</rdfs:comment>
    <rdfs:label xml:lang="en">calcareous carbonate sediment</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Calcareous_Carbonate_Sedimentary_Material"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Carbonate_Sediment"/>
  </rdf:Description>
