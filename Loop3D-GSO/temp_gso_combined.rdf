  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Impure_Dolostone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">This vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Impure carbonate sedimentary rock with a ratio of magnesium carbonate to calcite (plus aragonite) greater than 1 to 1.</rdfs:comment>
    <rdfs:label xml:lang="en">impure dolomite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Dolomitic_Or_Magnesian_Sedimentary_Rock"/>
