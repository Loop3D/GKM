    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:38843:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-38843.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Mn&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Te&lt;sup&gt;6+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Xocolatlite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Xocolatlite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Grundler P V, Brugger J, Meisser N, Ansermet S, Borg S, Etschmann B, Testemale D, Bolin T (2008) Xocolatlite, Ca_2_Mn^4+^_2_Te_2_O_12_·H_2_O, a new tellurate related to kuranakhite: Description and measurement of Te oxidation state by XANES spectroscopy, American Mineralogist 93, 1911-1920</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.DF.85</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With large and medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Xocolatlite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2007-020</gsmin:wikipediadate>
