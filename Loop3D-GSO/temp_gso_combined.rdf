    <gsmin:mindaturl>http://www.mindat.org/min-1542.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Fe&lt;sup&gt;2+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;,Ti&lt;sup&gt;4+&lt;/sup&gt;)&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;As&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;5&lt;/sub&gt;</gsmin:rruffchemistry>
