    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:10810:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-10810.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)(OH)&lt;sub&gt;12&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zaccagnaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Zaccagnaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Merlino S, Orlandi P (2001) Carraraite and zaccagnaite, two new minerals from the Carrara marble quarries: their chemical compositions, physical properties, and structural features, American Mineralogist 86, 1293-1301</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hydrotalcite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>05.DA.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions and H2O, With medium-sized cations</gsmin:strunzlabel>
