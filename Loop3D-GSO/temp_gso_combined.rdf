    <gsmin:imastatus xml:lang="en">Redefined|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1966</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1966:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1966.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K(Mg,Fe&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;6&lt;/sub&gt;(Si,Al)&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;20&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hydrobiotite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hydrobiotite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Schrauf A (1882) Beiträge zur kenntniss des associationskreises der magnesiasilicate, Zeitschrift für Krystallographie und Mineralogie 6, 321-388 Redefined: Brindley G W, Zalba P E, Bethke C M (1983) Hydrobiotite, a regular 1 : 1 interstratification of biotite and vermiculite layers, American Mineralogist 68, 420-425</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Clay</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EC.60</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with mica sheets, composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Hydrobiotite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1882</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/stronadelphite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
