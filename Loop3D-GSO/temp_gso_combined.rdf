    <gsoc:nextTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Pridoli2004"/>
    <gsoc:previousTimeInterval rdf:resource="https://w3id.org/gso/1.0/ischart/Homerian2004"/>
