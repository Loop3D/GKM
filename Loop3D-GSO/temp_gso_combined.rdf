  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/pandoraite-ca">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Pandoraite-Ca</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | V | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaV&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;V&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;16&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2018-036</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaV&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;V&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;16&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pandoraite-Ca</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Pandoraite-Ca</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf A R, Hughes J M, Nash B P, Marty J (2019) Pandoraite-Ba and Pandoraite-Ca, Ba(V_5_^4+^V_2_^5+^)O_16_·3H_2_O and Ca(V_5_^4+^V_2_^5+^)O_16_·3H_2_O, two new vanadium oxide bronze minerals in solid solution from the Pandora mine, La Sal mining district, San Juan County, Colorado, USA. The Canadian Mineralogist 57, 255-265</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Pandoraite</gsmin:structuralgroup>
  </rdf:Description>
