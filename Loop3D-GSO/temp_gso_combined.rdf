    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaBSi&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;8&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3382</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3382:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3382.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaBSi&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;8&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060096</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Reedmergnerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Reedmergnerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Milton C, Axelrod J M, Grimaldi F S (1955) New minerals, reedmergnerite (Na2O·B2O3·6SiO2) and eitelite (Na2O·MgO·2CO2) associated with leucosphenite, shortite, searlesite, and crocidolite in the Green River formation, Utah, American Mineralogist 40, 326-327</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Feldspar</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.FA.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Tektosilicate without additional non-tetrahedral anions</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Reedmergnerite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1955</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/yttrocolumbite-y">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Yttrocolumbite-(Y)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Y | U | Fe | Nb | Ta | O</gsmin:chemistryelements>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/yttrocolumbitey.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Y,U,Fe&lt;sup&gt;2+&lt;/sup&gt;)(Nb,Ta)O&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Questionable mineral species</gsmin:imastatus>
    <gsmin:mindatid>min-4369</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4369:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4369.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Y&lt;sup&gt;3+&lt;/sup&gt;,U&lt;sup&gt;6+&lt;/sup&gt;,Fe&lt;sup&gt;2+&lt;/sup&gt;)(Nb&lt;sup&gt;5+&lt;/sup&gt;,Ta&lt;sup&gt;5+&lt;/sup&gt;)O&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Yttrocolumbite-(Y)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Yttrocolumbite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Dana J D (1837) Yttro-columbite. Columbus Berzelii, in A System of Mineralogy, Durrie &amp; Peck and Herrick &amp; Noyes (New Haven) 370-370 Name changed from yttrocolumbite: Nickel E H, Mandarino J A (1987) Procedures involving the IMA Commission on New Minerals and Mineral Names and guidelines on mineral nomenclature, American Mineralogist 72, 1031-1042</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.DB.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With medium-sized cations; chains of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Yttrocolumbite-%28Y%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1837</gsmin:wikipediadate>
  </rdf:Description>
