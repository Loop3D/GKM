  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Carbonate_Sediment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">SLTTs 2004</dct:source>
    <rdfs:comment xml:lang="en">Sediment in which at least 50 percent of the primary and/or recrystallized constituents are composed of one (or more) of the carbonate minerals calcite, aragonite and dolomite, in particles of intrabasinal origin.</rdfs:comment>
    <rdfs:label xml:lang="en">carbonate sediment</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Carbonate_Sedimentary_Material"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Sediment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/rudenkoite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Rudenkoite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Sr | Al | Si | O | H | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sr&lt;sub&gt;3&lt;/sub&gt;Al&lt;sub&gt;3.5&lt;/sub&gt;Si&lt;sub&gt;3.5&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;(OH,O)&lt;sub&gt;8&lt;/sub&gt;Cl&lt;sub&gt;2&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2003-060</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-26665</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:26665:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-26665.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sr&lt;sub&gt;3&lt;/sub&gt;Al&lt;sub&gt;3.5&lt;/sub&gt;Si&lt;sub&gt;3.5&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;(OH,O)&lt;sub&gt;8&lt;/sub&gt;Cl&lt;sub&gt;2&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070048</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Rudenkoite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Rudenkoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chukanov N B, Dubinchuk V T, Murashko M N, Zadov A E, Karpenko V Y (2004) Rudenkoite Sr_3_Al_3.5_Si_3.5_O_10_(OH_7.5_,O_0.5_)Cl_2_·H_2_O, a new mineral from phlogopite deposits of Southern Yakutia, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 133(3), 37-41</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.HA.50</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Silicate, unclassified: With Alkali and Alkali-earth Elements</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Rudenkoite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2003-060</gsmin:wikipediadate>
  </rdf:Description>
