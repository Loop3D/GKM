    <gsmin:rruffnameplain xml:lang="en">Triangulite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Deliens M, Piret P (1982) Les phosphates d'uranyle et d'aluminum de Kobokobo. VI. La triangulite, Al3(UO2.PO4)4(OH)5. 5H2O, nouveau minéral, Bulletin de Minéralogie 105, 611-614</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.EB.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl phosphate or arsenate, UO2:RO4 = 1:1</gsmin:strunzlabel>
