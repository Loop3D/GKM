  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/tausonite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Tausonite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Sr | Ti | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal, cubic, orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">perovskite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/tausonite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">SrTiO&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1982-077</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Strontium titanate</gsmin:iupacchemname>
    <gsmin:mindatid>min-3895</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3895:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3895.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">SrTi&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>RS856528</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tausonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tausonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Vorob´ev E I, Konev A A, Malyshonok Y V, Afonina G F, Sapozhnikov A N (1984) Tausonite, SrTiO_3_, a new mineral of the perovskite group, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 113(1), 86-89</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Perovskite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.CC.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 2: 3,3: 5, and similar, With large and medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Tausonite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1982-077</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/topaz">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Topaz</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Al | Si | O | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/topaz.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al&lt;sub&gt;2&lt;/sub&gt;SiO&lt;sub&gt;4&lt;/sub&gt;F&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dialuminium nesosilicate difluoride</gsmin:iupacchemname>
    <gsmin:mindatid>min-3996</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3996:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3996.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al&lt;sub&gt;2&lt;/sub&gt;SiO&lt;sub&gt;4&lt;/sub&gt;F&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R040121 | R050176 | R050199 | R050200 | R050404 | R050405 | R060024 | R060026</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Topaz</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Topaz</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">A mineral name that predates its formal definition. For instance: Pliny [translated by Hardouin, 1685] (77) Topazion, in Caii Plinii secundi Naturalis historiae libri XXXVII interpretatione et notis illustravit Joannes Harduinus in usum Delphini, Franciscum Muguet (Paris) 364-364 Formal definition: Henkel J F (1737) De topasio vera Saxonum, orientali non inferiore, Acta Physico-medica Academiae Caesareae Leopoldino-Carolinae Naturae Curiosorum 4, 316-320</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Topaz</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AF.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with additional anions; cations in [4], [5] and/or only [6] coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Topaz.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1737</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kadyrelite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kadyrelite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Hg | O | Br | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/kadyrelite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">([Hg&lt;sup&gt;1+&lt;/sup&gt;]&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;OBr&lt;sub&gt;3&lt;/sub&gt;(OH)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1986-042</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2128</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2128:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2128.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">([Hg&lt;sup&gt;1+&lt;/sup&gt;]&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;OBr&lt;sub&gt;3&lt;/sub&gt;(OH)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kadyrelite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kadyrelite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Vasilev V I (1987) Kadyrelite Hg_4_(Br,Cl)_2_O - a new oxyhalide of mercury from the Kadyrelsky ore occurrence (Tuvinskaya ASSR), Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 116(6) 733-737 Chemical formula revised from : Mereiter K, Zemann J, Hewat A W (1992) Eglestonite, (Hg_2_)_3_Cl_3_O_2_H: confirmation of the chemical formula by neutron powder diffraction. American Mineralogist 77, 839-842</gsmin:statusnotes>
    <gsmin:strunzcodeV10>03.DD.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Double-, Oxy- or Hydroxy-  halide with Hg</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Kadyrelite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1986-042</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/neltnerite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
