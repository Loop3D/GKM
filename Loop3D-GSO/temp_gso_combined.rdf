  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/cuprocopiapite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cuprocopiapite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Fe | S | O | H</gsmin:chemistryelements>
    <gsmin:fleischersgroup xml:lang="en">copiapite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/cuprocopiapite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·20H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Copper tetrairon hexasulfate dihydroxyl icosahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1181</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1181:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1181.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·20H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cuprocopiapite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cuprocopiapite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Bandy M C (1938) Mineralogy of three sulphate deposits of Northern Chile, American Mineralogist 23, 669-760</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Copiapite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.DB.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With only medium-sized cations; insular octahedra and finite units</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Cuprocopiapite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1938</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/byelorussite-ce">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Byelorussite-(Ce)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ba | Ce | Mn | Ti | Si | O | F | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">joaquinite</gsmin:fleischersgroup>
