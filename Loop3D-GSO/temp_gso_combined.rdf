    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Zr&lt;sup&gt;4+&lt;/sup&gt;,Ti&lt;sup&gt;4+&lt;/sup&gt;,Ca)(O,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
