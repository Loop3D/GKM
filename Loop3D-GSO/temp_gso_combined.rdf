    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">FeS·0.85[Fe(OH)&lt;sub&gt;2&lt;/sub&gt;]</gsmin:imachemistry>
