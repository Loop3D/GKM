  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/gratianite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Gratianite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | Bi | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">MnBi&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2013-076</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;Bi&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Graţianite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Gratianite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Ciobanu C L, Brugger J, Cook N J, Mills S J, Elliott P, Damian G, Damian F (2014) Gratianite, MnBi_2_S_4_, a new mineral from the Baita Bihor skarn, Romania. American Mineralogist 99, 1163-1170</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Berthierite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Regional_Metamorphism">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">based on Smulikowski et al, 2003</dct:source>
    <rdfs:comment xml:lang="en">Metamorphic processes driven by temperature and pressure changes affecting a large rock volume, associated with large-scale tectonic processes.</rdfs:comment>
    <rdfs:label xml:lang="en">regional metamorphic genesis</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicprocess/Metamorphic_Process"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb26e920196f4af8bbd263b193e6f242b425">
