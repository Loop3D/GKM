  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/timeEquivalentTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:comment xml:lang="en">A is equivalent to B if they represent expressions of the same Time_Region. Same as Allen A Equals B.</rdfs:comment>
    <rdfs:comment xml:lang="en">One of six binary relations between geologic events defined by Burns (1975)</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/timeIncludedBy"/>
