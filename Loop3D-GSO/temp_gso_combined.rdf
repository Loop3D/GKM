    <gsmin:rruffids>R060576</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Montroseite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Montroseite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Weeks A D, Cisney E A, Sherwood A M (1953) Montroseite, a new vanadium oxide from the Colorado plateaus, American Mineralogist 38, 1235-1241</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.FD.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Hydroxide (without V or U), Hydroxides with OH, without H2O; chains of edge-sharing octahedra</gsmin:strunzlabel>
