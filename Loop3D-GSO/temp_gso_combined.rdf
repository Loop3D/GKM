  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/niobokupletskite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Niobokupletskite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Na | Mn | Nb | Zr | Ti | Si | O | H | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">astrophyllite</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;NaMn&lt;sub&gt;7&lt;/sub&gt;(Nb,Zr,Ti)&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;26&lt;/sub&gt;(OH,O,F)&lt;sub&gt;5&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1999-032</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-7098</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7098:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7098.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;NaMn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;7&lt;/sub&gt;(Nb&lt;sup&gt;5+&lt;/sup&gt;,Ti&lt;sup&gt;4+&lt;/sup&gt;)(Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;(O,F)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Niobokupletskite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Niobokupletskite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Piilonen P C, Lalonde A E, McDonald A M, Gault R A (2000) Niobokupletskite, a new astrophyllite-group mineral from Mont Saint-Hilaire, Quebec, Canada: description and crystal structure, The Canadian Mineralogist 38, 627-639 Chemical composition revised according to: Cámara F, Sokolova E, Abdu Y, Hawthorne F C (2010) The crystal structures of niobophyllite, kupletskite-(Cs) and Sn-rich astrophyllite: Revisions to the crystal chemistry of the astrophyllite-group minerals, The Canadian Mineralogist 48, 1-16</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Astrophyllite-Kupletskite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DC.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with branched 2-periodic single chains; Si2O6 + 2SiO3 Si4O12</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Niobokupletskite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1999-032</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/heterogenite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Heterogenite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Co | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/heterogenite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Co&lt;sup&gt;3+&lt;/sup&gt;O(OH)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1885</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1885:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1885.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Co&lt;sup&gt;3+&lt;/sup&gt;O(OH)</gsmin:rruffchemistry>
    <gsmin:rruffids>R050382</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Heterogenite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Heterogenite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Frenzel A (1872) Mineralgisches 5. Heterogenit, Journal für Praktische Chemie 5, 401-407 Redefined: Schoep A (1921) Sur la nature et la composition chimique d'un minéral de cobalt provenant du Katanga, Bulletin de la Société Chimiques de Belgique 30, 207-212</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.FE.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Hydroxide (without V or U), Hydroxides with OH, without H2O; sheets of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Heterogenite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1872</gsmin:wikipediadate>
  </rdf:Description>
