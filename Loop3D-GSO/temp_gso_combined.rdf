  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/carbokentbrooksite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Carbokentbrooksite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ce | Ca | Mn | Zr | Nb | Si | O | H | C</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">eudialyte</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)&lt;sub&gt;12&lt;/sub&gt;(Na,Ce)&lt;sub&gt;3&lt;/sub&gt;Ca&lt;sub&gt;6&lt;/sub&gt;Mn&lt;sub&gt;3&lt;/sub&gt;Zr&lt;sub&gt;3&lt;/sub&gt;NbSi&lt;sub&gt;25&lt;/sub&gt;O&lt;sub&gt;73&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2002-056</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-25674</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:25674:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-25674.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)&lt;sub&gt;12&lt;/sub&gt;(Na,Ce&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;3&lt;/sub&gt;Ca&lt;sub&gt;6&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Zr&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Nb&lt;sup&gt;5+&lt;/sup&gt;Si&lt;sub&gt;25&lt;/sub&gt;O&lt;sub&gt;73&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;(C&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Carbokentbrooksite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Carbokentbrooksite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Khomyakov A P, Dusmatov V D, Ferraris G, Gula A, lvaldi G, Nechelyustov G N (2003) Zirsilite-(Ce), (Na,[box])&lt;sub&gt;12&lt;/sub&gt;(Ce,Na)&lt;sub&gt;3&lt;/sub&gt;Ca&lt;sub&gt;6&lt;/sub&gt;Mn&lt;sub&gt;3&lt;/sub&gt;Zr&lt;sub&gt;3&lt;/sub&gt;Nb(Si&lt;sub&gt;25&lt;/sub&gt;O&lt;sub&gt;73&lt;/sub&gt;)(OH)&lt;sub&gt;3&lt;/sub&gt;(CO)&lt;sub&gt;3&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O and carbokentbrooksite (Na,[box])(Na,Ce)&lt;sub&gt;3&lt;/sub&gt;Ca&lt;sub&gt;6&lt;/sub&gt;Mn&lt;sub&gt;3&lt;/sub&gt;Zr&lt;sub&gt;3&lt;/sub&gt;Nb(Si&lt;sub&gt;25&lt;/sub&gt;O&lt;sub&gt;73&lt;/sub&gt;)(OH)&lt;sub&gt;3&lt;/sub&gt;(CO)&lt;sub&gt;3&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O - two new eudialyte group minerals from Dara-i-Pioz alkaline massif, Tajikista, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 132, 40-51</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Eudialyte</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CO.10</gsmin:strunzcodeV10>
