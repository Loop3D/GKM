    <gsmin:rruffids>R040133 | R050019 | R050116 | R100002 | R100162</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Rhodochrosite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Rhodochrosite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hausmann J F L (1813) Rhodochrosit, in Handbuch der Mineralogie, Volume 3, (Göttingen) 1081-1082</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Calcite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>05.AB.05</gsmin:strunzcodeV10>
