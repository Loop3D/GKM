    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Au,Ag,Sb,Bi,Pb)&lt;sub&gt;23&lt;/sub&gt;(Te,Sb,Bi,Pb)&lt;sub&gt;38&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
