    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/plumboferrite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;2&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;,Mn&lt;sup&gt;2+&lt;/sup&gt;,Mg)&lt;sub&gt;11&lt;/sub&gt;O&lt;sub&gt;19&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3246</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3246:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3246.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;2&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;,Mn&lt;sup&gt;2+&lt;/sup&gt;,Mg)&lt;sub&gt;11&lt;/sub&gt;O&lt;sub&gt;19&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Plumboferrite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Plumboferrite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Igelström L J (1881) Plumboferrit, ett nytt mineral från Jakobsbergs manganmalmsgrufva vid Nordmarken i Wermland, Öfversigt af Kongliga Vetenskaps-Akademiens Förhandlingar 38, issue 8, 27-31</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Plumboferrite</gsmin:structuralgroup>
