    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:748:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-748.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cr&lt;sup&gt;3+&lt;/sup&gt;O(OH)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bracewellite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Bracewellite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Milton C, Appleman D E, Appleman M H, Chao E C T, Cuttita F, Dinnin J I, Dwornik E J, Ingram B L, Rose H J (1976) Merumite, a complex assemblage of chromium minerals from Guyana, U.S. Geological Survey Professional Paper 887, 1-29</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.FD.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Hydroxide (without V or U), Hydroxides with OH, without H2O; chains of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Bracewellite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1967-035</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/rapidcreekite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
