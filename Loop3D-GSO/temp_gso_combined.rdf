  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/potassic-chloro-hastingsite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Potassic-chloro-hastingsite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Ca | Fe | Si | Al | O | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">amphibole-group 2 Ca</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KCa&lt;sub&gt;2&lt;/sub&gt;(Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;)(Si&lt;sub&gt;6&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;)O&lt;sub&gt;22&lt;/sub&gt;Cl&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2005-007</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KCa&lt;sub&gt;2&lt;/sub&gt;[Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;](Si&lt;sub&gt;6&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;)O&lt;sub&gt;22&lt;/sub&gt;Cl&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Potassic-chloro-hastingsite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Potassic-chloro-hastingsite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pekov I V, Chukanov N V, Nefedova M E, Pushcharovsky D Y, Rastsvetaeva R K (2005) Chloro-potassichastingsite (K,Na)Ca&lt;sub&gt;2&lt;/sub&gt;(Fe&lt;sup&gt;2+&lt;/sup&gt;,Mg)&lt;sub&gt;4&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;[Si&lt;sub&gt;6&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;](Cl,OH)&lt;sub&gt;2&lt;/sub&gt;: revalidation and the new name of dashkesanite, Proceedings of the Russian Mineralogical Society 134, 31-35 Name changed: Hawthorne F C, Oberti R, Harlow G E, Maresch W V, Martin R F, Schumacher J C, Welch M D (2012) Nomenclature of the amphibole supergroup, American Mineralogist 97, 2031-2048</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Amphibole</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/hydrobiotite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
