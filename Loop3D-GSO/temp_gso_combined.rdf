    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:32208:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-32208.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nielsbohrite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Nielsbohrite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Walenta K, Hatert F, Theye T, Lissner F, Röller K (2009) Nielsbohrite, a new potassium uranyl arsenate from the uranium deposit of Menzenschwand, southern Black Forest, Germany, European Journal of Mineralogy 21, 515-520 Piilonen P C, Poirier G, Tait K T (2009) New mineral names, American Mineralogist 47, 1495-1501</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.EC.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl phosphate or arsenate, UO2:RO4 = 3:2</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Nielsbohrite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2002-045b</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/tengchongite">
