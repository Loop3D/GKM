    <gsmin:statusnotes xml:lang="en">Frenzel A (1871) Mineralogisches. Hypochlorit, Journal für Praktische Chemie 4, 353-362 Mineral species is confirmed: Milton C, Axelrod J M, Ingram B (1958) Bismutoferrite, chapmanite, and “hypochlorite”, American Mineralogist 43, 656-670</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Kaolinite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.ED.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with kaolinite layers composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Bismutoferrite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1871</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/wilhelmgumbelite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Wilhelmgümbelite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Zn | Fe | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">[ZnFe&lt;sup&gt;2+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;5&lt;/sub&gt;]·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2015-072</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-46972</gsmin:mindatid>
    <gsmin:mindaturl>https://www.mindat.org/min-46972.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sup&gt;2+&lt;/sup&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;5&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Wilhelmgümbelite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Wilhelmgumbelite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Grey I E, Keck E, Kampf A R, Macrae C M, Glenn A M, Price J R (2017) Wilhelmgümbelite, [ZnFe^2+^Fe^3+^_3_(PO_4_)_3_(OH)_4_(H_2_O)_5_]·2H_2_O, a new schoonerite-related mineral from the Hagendorf Süd pegmatite, Bavaria. Mineralogical Magazine 81, 287-296</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Calcioferrite-Schoonerite</gsmin:structuralgroup>
  </rdf:Description>
