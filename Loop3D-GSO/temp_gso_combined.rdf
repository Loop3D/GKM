    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)(OH)</gsmin:rruffchemistry>
    <gsmin:rruffids>R050621</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tarbuttite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tarbuttite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Name given: Spencer L J (1907) Societies and Academies: Mineralogical Society, Nature 76, 215-215 Description given: Spencer L J (1908) On hopeite and other zinc phosphates and associated minerals from Broken Hill mines, Noth-Western Rhodesia, Mineralogical Magazine 15, 1-38</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Tarbuttite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BB.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With only medium-sized cations, (OH, etc.):RO4 about 1:1</gsmin:strunzlabel>
