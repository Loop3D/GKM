    <rdfs:label xml:lang="en">Stavelotite-(La)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>La | Mn | Cu | Fe | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">La&lt;sub&gt;3&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;(Mn&lt;sup&gt;3+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;,Mn&lt;sup&gt;4+&lt;/sup&gt;)&lt;sub&gt;26&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;30&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2004-014</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-27465</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:27465:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-27465.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">La&lt;sub&gt;3&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;(Mn&lt;sup&gt;3+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;,Mn&lt;sup&gt;4+&lt;/sup&gt;)&lt;sub&gt;26&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;30&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Stavelotite-(La)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Stavelotite-(La)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Bernhardt H J, Armbruster T, Fransolet A M, Schreyer W (2005) Stavelotite-(La), a new lanthanum-manganese-sorosilicate mineral from the Stavelot Massif, Belgium, European Journal of Mineralogy 17, 703-714</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.BE.87</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate: Si2O7 groups, with additional anions; cations in octahedral [6] and greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://webmineral.com/data/Stavelotite-(La).shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2004-014</gsmin:wikipediadate>
  </rdf:Description>
