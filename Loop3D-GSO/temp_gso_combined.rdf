  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/oneillite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Oneillite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Mn | Fe | Zr | Nb | Si | O | H | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">eudialyte</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;15&lt;/sub&gt;Ca&lt;sub&gt;3&lt;/sub&gt;Mn&lt;sub&gt;3&lt;/sub&gt;Fe&lt;sub&gt;3&lt;/sub&gt;Zr&lt;sub&gt;3&lt;/sub&gt;Nb(Si&lt;sub&gt;25&lt;/sub&gt;O&lt;sub&gt;73&lt;/sub&gt;)(O,OH,H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;3&lt;/sub&gt;(OH,Cl)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1998-064</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-7205</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7205:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7205.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;15&lt;/sub&gt;Ca&lt;sub&gt;3&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Zr&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Nb&lt;sup&gt;5+&lt;/sup&gt;(Si&lt;sub&gt;25&lt;/sub&gt;O&lt;sub&gt;73&lt;/sub&gt;)(O,OH,H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;3&lt;/sub&gt;(OH,Cl)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R110184</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Oneillite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Oneillite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Johnsen O, Grice J D, Gault R A (1999) Oneillite: A new Ca-deficient and REE-rich member of the eudialyte group from Mont Saint-Hilaire, Quebec, Canada, The Canadian Mineralogist 37, 1295-1301</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Eudialyte</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CO.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si9O27]18- 9-membered rings</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Oneillite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1998-064</gsmin:wikipediadate>
