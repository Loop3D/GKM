  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/theisite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Theisite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Zn | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal, orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/theisite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;5&lt;/sub&gt;Zn&lt;sub&gt;5&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;14&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1980-040</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3934</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3934:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3934.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;As&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;8&lt;/sub&gt;(OH)&lt;sub&gt;14&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050326 | R060478</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Theisite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Theisite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Williams S A (1982) Theisite, a new mineral from Colorado, Mineralogical Magazine 46, 49-50</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.BE.75</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With only medium-sized cations, (OH, etc.):RO4 &gt; 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Theisite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1980-040</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/congolite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Congolite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Fe | B | O | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/congolite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;B&lt;sub&gt;7&lt;/sub&gt;O&lt;sub&gt;13&lt;/sub&gt;Cl</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1971-030</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1118</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1118:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1118.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;B&lt;sub&gt;7&lt;/sub&gt;O&lt;sub&gt;13&lt;/sub&gt;Cl</gsmin:rruffchemistry>
    <gsmin:rruffids>R070149 | R110153</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Congolite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Congolite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Wendling E, Hodenberg R V, Kühn R (1972) Congolit, der trigonale eisenboracit, Kali und Steinsalz 6, 1-3</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Boracite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>06.GA.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Tekto-heptaborate</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Congolite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1971-030</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/hydroxynatropyrochlore">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Hydroxynatropyrochlore</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Ce | Nb | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,Ca,Ce)&lt;sub&gt;2&lt;/sub&gt;Nb&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;(OH)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2017-074</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,Ca,Ce)&lt;sub&gt;2&lt;/sub&gt;Nb&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;(OH)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hydroxynatropyrochlore</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hydroxynatropyrochlore</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Ivanyuk G Y, Yakovenchuk V N, Panikorovskii T L, Konoplyova N, Pakhomovsky Y A, Bazai A V, Bocharov V N, Krivovichev S V (2019) Hydroxynatropyrochlore, (Na,Ca,Ce)_2_Nb_2_O_6_(OH), a new member of the pyrochlore group from the Kovdor phoscorite-carbonatite pipe, Kola Peninsula, Russia. Mineralogical Magazine 83, 107-113</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Pyrochlore-Pyrochlore</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/zincgartrellite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Zincgartrellite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Zn | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">tsumcorite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/zincgartrellite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">PbZn&lt;sub&gt;2&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O,OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1998-014</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-7043</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7043:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7043.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O,OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zincgartrellite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Zincgartrellite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Effenberger H, Krause W, Bernhardt H J, Martin M (2000) On the symmetry of tsumcorite group minerals based on the new species rappoldite and zincgartrellite, Mineralogical Magazine 64, 1109-1126</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Helmutwinklerite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CG.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With large and medium-sized cations, RO4:H2O = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Zincgartrellite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1998-014</gsmin:wikipediadate>
  </rdf:Description>
