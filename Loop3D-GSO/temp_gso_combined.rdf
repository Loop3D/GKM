    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Zn | W | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic, triclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">wolframite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/sanmartinite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn(WO&lt;sub&gt;4&lt;/sub&gt;)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Zinc tungsten tetraoxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-3523</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3523:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3523.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sup&gt;2+&lt;/sup&gt;W&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sanmartinite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Sanmartinite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Angelelli V, Gordon S G (1948) Sanmartinite, a new zinc tungstate from Argentina, Notulae Naturae of The Academy of Natural Sciences of Philadelphia 205, 1-7</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Wolframite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.DB.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With medium-sized cations; chains of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Sanmartinite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1948</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/zincobradaczekite">
