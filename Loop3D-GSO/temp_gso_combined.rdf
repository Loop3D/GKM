    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:41905:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-41905.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">6Fe&lt;sup&gt;2+&lt;/sup&gt;S&lt;sup&gt;2-&lt;/sup&gt;·5Fe&lt;sup&gt;2+&lt;/sup&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
