    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Y&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O[F,(OH)]&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mieite-(Y)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Mieite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Miyawaki R, Matsubara S, Yokoyama K, Shigeoka M, Momma K, Yamamoto S (2015) Mieite-(Y), Y_4_Ti(SiO_4_)_2_O[F,(OH)]_6_, a new mineral in a pegmatite at Souri Valley, Komono, Mie Prefecture, central Japan. Journal of Mineralogical and Petrological Sciences 110, 135-144</gsmin:statusnotes>
  </rdf:Description>
