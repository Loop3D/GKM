    <gsmin:statusnotes xml:lang="en">Spiridonov E P, Krapiva L Y, Gapeev A K, Stepanov V I, Prushinskaya E Y, and Volgin V Y (1981) Gruzdevite Cu_6_Hg_3_Sb_4_S_12_ - a new mineral from the Chauvai antimony-mercury deposit, Central Asia, Doklady Akademii Nauk SSSR 261, 971-976</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Nowackiite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.GA.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Neso-sulfarsenite without additional S</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Gruzdevite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1980-053</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Biogenic_Sediment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">SLTTs 2004</dct:source>
    <rdfs:comment xml:lang="en">Corresponding biogenic sedimentary material and biogenic sedimentary rock categories are not included based on the interpretation that biogenic sedimentary rock will be in a different category, e.g. carbonate sedimentary rock or organic rich sedimentary rock.</rdfs:comment>
    <rdfs:comment xml:lang="en">Sediment composed of greater than 50 percent material of biogenic origin. Because the biogenic material may be skeletal remains that are not organic, all biogenic sediment is not necessarily organic-rich.</rdfs:comment>
    <rdfs:label xml:lang="en">biogenic sediment</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Sediment"/>
  </rdf:Description>
