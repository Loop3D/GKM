    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/dittmarite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(NH&lt;sub&gt;4&lt;/sub&gt;)Mg(PO&lt;sub&gt;4&lt;/sub&gt;)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Ammonium magnesium phosphate monohydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1297</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1297:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1297.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(N&lt;sup&gt;3-&lt;/sup&gt;H&lt;sub&gt;4&lt;/sub&gt;)MgPO&lt;sub&gt;4&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Dittmarite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Dittmarite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">MacIvor R W E (1887) On Australian bat guano and some minerals occurring therein, The Chemical News 55, 215-216</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.CH.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With large and medium-sized cations, RO4:H2O &lt; 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Dittmarite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1887</gsmin:wikipediadate>
  </rdf:Description>
