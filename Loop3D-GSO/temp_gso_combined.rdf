    <gsmin:mindaturl>http://www.mindat.org/min-3169.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ag&lt;sup&gt;1+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Hg&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;(I&lt;sup&gt;1-&lt;/sup&gt;,Br&lt;sup&gt;1-&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;Cl&lt;sup&gt;1-&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
