    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;9&lt;/sub&gt;Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;23&lt;/sub&gt;(OH)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: DiironII nonaaluminium tetranesosilicate heptaoxy hydroxyl</gsmin:iupacchemname>
