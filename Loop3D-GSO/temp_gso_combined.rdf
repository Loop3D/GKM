    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bearsite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Bearsite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kopchenova E V, Sidorenko G A (1962) Bearsite, the arsenic analogue of moraesite, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 91(4), 442-446</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.DA.05</gsmin:strunzcodeV10>
