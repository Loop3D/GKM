    <gsmin:mindatid>min-4024</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4024:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4024.html</gsmin:mindaturl>
