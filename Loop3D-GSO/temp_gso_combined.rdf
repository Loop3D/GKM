    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:43558:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-43558.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba(Mn&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;)O&lt;sub&gt;16&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ferrihollandite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ferrihollandite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Original description of hollandite: Fermor L L (1906) Manganese in India. Transactions of the Mining and Geological Institute of India 1, 69-131 Fe-rich mineral redefined to be ferrihollandite: Biagioni C, Capalbo C, Pasero M (2013) Nomenclature tunings in the hollandite supergroup. European Journal of Mineralogy 25, 85-90 Original hollandite shown to be ferrihollandite: Biagioni C, Capalbo C, Lezzerini M, Pasero M (2014) Ferrihollandite, BaMn^4+^_6_Fe^3+^_2_O_16_, from Apuan Alps, Tuscany, Italy: description and crystal structure. European Journal of Mineralogy 26, 171-178</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Coronadite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, hydroxide or arsenite</gsmin:strunzlabel>
    <gsmin:wikipediadate>2011-F</gsmin:wikipediadate>
  </rdf:Description>
