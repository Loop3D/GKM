    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;2&lt;/sub&gt;O(CO&lt;sub&gt;3&lt;/sub&gt;)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1993-053</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dilead oxycarbonate</gsmin:iupacchemname>
    <gsmin:mindatid>min-3632</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3632:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3632.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;2&lt;/sub&gt;O(CO&lt;sub&gt;3&lt;/sub&gt;)</gsmin:rruffchemistry>
    <gsmin:rruffids>R070501</gsmin:rruffids>
