    <gsmin:chemistryelements>U | O | Ca | Ti | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;1.75&lt;/sub&gt;Ca&lt;sub&gt;0.25&lt;/sub&gt;TiO&lt;sub&gt;4&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2003-009</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-11514</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:11514:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-11514.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;1.75&lt;/sub&gt;Ca&lt;sub&gt;0.25&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060595</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Holfertite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Holfertite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Belakovskiy D I, Pautov L A, Sokolova E, Hawthorne F C, Mokhov A V (2006) Holfertite, a new hydroxyl-hydrated uranium titanate from Starvation Canyon, Thomas Range, Utah, Mineralogical Record 37, 311-317</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.GB.70</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl hydroxide, With additional cations (K, Ca, Ba, Pb, etc.); with mainly UO2(O,OH)5 pentagonal polyhedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Holfertite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2003-009</gsmin:wikipediadate>
  </rdf:Description>
