    <gsmin:webmineralurl>http://www.webmineral.com/data/Walthierite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1991-008</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/piretite">
