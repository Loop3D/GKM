    <gsmin:mindaturl>http://www.mindat.org/min-104.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;5&lt;/sub&gt;Al&lt;sub&gt;12&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;8&lt;/sub&gt;(OH)&lt;sub&gt;22&lt;/sub&gt;·32H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R100073</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Aldermanite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Aldermanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Harrowfield I R, Segnit E R, Watts J A (1981) Aldermanite, a new magnesium aluminium phosphate, Mineralogical Magazine 44, 59-62</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.DE.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With only medium-sized cations, (OH, etc.):RO4 = 3:1</gsmin:strunzlabel>
