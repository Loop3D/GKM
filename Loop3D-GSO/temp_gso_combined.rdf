    <gsmin:mindaturl>http://www.mindat.org/min-31500.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Mg(OH)&lt;sub&gt;6&lt;/sub&gt;Cl&lt;sup&gt;1-&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R120085</gsmin:rruffids>
