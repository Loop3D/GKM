    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sr(Mn&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;Mn&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;)O&lt;sub&gt;16&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1995-005</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-7317</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7317:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7317.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sr(Mn&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;Mn&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;)O&lt;sub&gt;16&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Strontiomelane</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Strontiomelane</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Meisser N, Perseil E A, Brugger J, Chiappero P J, (1999) Strontiomelane, SrMn^4+^_6_Mn^3+^_2_O_16_, a new mineral species of the cryptomelane group from St. Marcel-Praborna, Aosta valley, Italy, The Canadian Mineralogist 37, 673-678</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Coronadite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.DK.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With large (+- medium-sized) cations; tunnel structures</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Strontiomelane.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1995-005</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/bernardite">
