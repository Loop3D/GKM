  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/zincostaurolite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Zincostaurolite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Zn | Al | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">staurolite</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;9&lt;/sub&gt;Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;23&lt;/sub&gt;(OH)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1992-036</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-27027</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:27027:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-27027.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;9&lt;/sub&gt;Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;23&lt;/sub&gt;(OH)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zincostaurolite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Zincostaurolite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chopin C, Goffe B, Ungaretti L, Oberti R (2003) Magnesiostaurolite and zincostaurolite: mineral description with a petrogenetic and crystal-chemical update, European Journal of Mineralogy 15, 167-176</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.AF.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with additional anions; cations in [4], [5] and/or only [6] coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Zincostaurolite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1992-036</gsmin:wikipediadate>
  </rdf:Description>
