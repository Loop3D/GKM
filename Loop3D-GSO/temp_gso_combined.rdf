  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/barrydawsonite-y">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Barrydawsonite-(Y)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Y | Ca | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;1.5&lt;/sub&gt;Y&lt;sub&gt;0.5&lt;/sub&gt;CaSi&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;9&lt;/sub&gt;H</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2014-042</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;1.5&lt;/sub&gt;Y&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;0.5&lt;/sub&gt;CaSi&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;9&lt;/sub&gt;H</gsmin:rruffchemistry>
