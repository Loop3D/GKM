    <gsmin:rruffids>R040001 | R050256 | R050311 | R050377 | R060358 | R060350 | R060326 | R060423 | R060449 | R070722 | R100049 | R100138 | R120004</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Andradite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Andradite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Dana J D, Brush G J (1868) E. Lime-Irongarnet; Andradite, in A System of Mineralogy, Fifth Edition, John Wiley and Sons (New York) 268-270</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Garnet</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AD.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate without additional anions; cations in [6] and/or greater coordination</gsmin:strunzlabel>
