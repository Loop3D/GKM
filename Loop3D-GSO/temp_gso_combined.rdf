    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/perdurant/Statistical_Calculation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/manganbabingtonite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Manganbabingtonite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Mn | Fe | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">rhodonite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/manganbabingtonite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;Si&lt;sub&gt;5&lt;/sub&gt;O&lt;sub&gt;14&lt;/sub&gt;(OH)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2494</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2494:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2494.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;Si&lt;sub&gt;5&lt;/sub&gt;O&lt;sub&gt;14&lt;/sub&gt;(OH)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Manganbabingtonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Manganbabingtonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Vinogradova R A, Sychkova V A, Kabalov Y K (1966) Manganiferous babingtonite from the Rudnyi Kaskad deposit, Eastern Sayan, Doklady Akademii Nauk SSSR 169, 434-437</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Rhodonite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DK.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 5-periodic single chains</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Manganbabingtonite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1966</gsmin:wikipediadate>
  </rdf:Description>
