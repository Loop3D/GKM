    <gsmin:rruffids>R070600 | R080103</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fergusonite-(Y)-β</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Fergusonite-(Y)-beta</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Gorshevskaya S A, Sidorenko G A, Smorchkov I E (1961) A new modification of fergusonite: ß-fergusonite, Geologiya Rudnykh Mestorozhdenii 9, 28-29 Name changed from fergusonite-beta: Nickel E H, Mandarino J A (1987) Procedures involving the IMA Commission on New Minerals and Mineral Names and guidelines on mineral nomenclature, American Mineralogist 72, 1031-1042</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/roselite-beta">
