    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3797:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3797.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaBa&lt;sub&gt;3&lt;/sub&gt;(Mn&lt;sup&gt;2+&lt;/sup&gt;,Mn&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;4&lt;/sub&gt;[Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;][Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;]O&lt;sub&gt;2&lt;/sub&gt;·(F,OH)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R080039</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Strakhovite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Strakhovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kalinin V V, Pushcharovsky D Y, Yamnova N A, Dikov Y P, Borisovsky S E (1994) Strakhovite NaBa3(Mn2+, Mn3+)4Si6O19(OH)3 — a new Na-bearing silicate of Ba and Mn, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 123, issue 4, 94-97</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.CF.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si4O12]8- 4-membered single rings, with insular complex anions</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Strakhovite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1993-005</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/uranophane-beta">
