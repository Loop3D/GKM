    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaCa&lt;sub&gt;2&lt;/sub&gt;(Mg&lt;sub&gt;4&lt;/sub&gt;Al)(Si&lt;sub&gt;6&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;)O&lt;sub&gt;22&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Redefined|Approved</gsmin:imastatus>
