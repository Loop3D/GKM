    <rdfs:comment xml:lang="en">Any individual, e.g. this rock or that event. Individuals are not types and cannot have instances.</rdfs:comment>
    <rdfs:label xml:lang="en">Particular</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="n7bda25761fc44f8595ef751309700190b213"/>
    <rdfs:subClassOf rdf:nodeID="n7bda25761fc44f8595ef751309700190b214"/>
    <rdfs:subClassOf rdf:nodeID="n7bda25761fc44f8595ef751309700190b215"/>
    <rdfs:subClassOf rdf:nodeID="n7bda25761fc44f8595ef751309700190b216"/>
    <rdfs:subClassOf rdf:nodeID="n7bda25761fc44f8595ef751309700190b217"/>
  </rdf:Description>
