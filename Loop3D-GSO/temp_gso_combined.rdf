    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1205:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1205.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba(Si,Al)&lt;sub&gt;4&lt;/sub&gt;(O,OH)&lt;sub&gt;8&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R080032</gsmin:rruffids>
