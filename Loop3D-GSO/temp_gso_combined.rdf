    <gsmin:rruffnameplain xml:lang="en">Denningite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mandarino J A, Williams S J, Mitchell R S (1963) Denningite, a new tellurite mineral from Moctezuma, Sonora, Mexico, The Canadian Mineralogist 7, 443-452</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.JK.30</gsmin:strunzcodeV10>
