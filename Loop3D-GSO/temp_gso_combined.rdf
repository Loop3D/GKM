    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KLi&lt;sub&gt;3&lt;/sub&gt;Ca&lt;sub&gt;7&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(SiO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;12&lt;/sub&gt;F&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Baratovite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Baratovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Dusmatov V D, Semenov E I, Khomayakov A P, Bykova A V, Dzharfarov N K (1975) Baratovite, a new mineral, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 104(5), 580-582</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Baratovite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CJ.25</gsmin:strunzcodeV10>
