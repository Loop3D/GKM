    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sb&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Diantimony trisulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-2686</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2686:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2686.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sb&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060755</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Metastibnite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Metastibnite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Becker G F (1888) Geology of the Quicksilver Deposits of the Pacific Slope. Chapter 11. Descriptive geology of the Steamboat Springs district, Monographs of the United States Geological Survey 13, 331-353</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Stibnite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.DB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide (M:S = 2:3)</gsmin:strunzlabel>
