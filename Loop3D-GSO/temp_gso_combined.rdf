  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/chlormagaluminite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Chlormagaluminite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mg | Al | O | H | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">manasseite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/chlormagaluminite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;4&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;12&lt;/sub&gt;Cl&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1980-098</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Tetramagnesium dialuminium dodecahydroxyl dichloride dihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1018</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1018:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1018.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;4&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;12&lt;/sub&gt;Cl&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Chlormagaluminite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Chlormagaluminite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kashaev A A, Feoktisov G D, Petrova S V (1982) Chlormagaluminite, (Mg,Fe&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;4&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;12&lt;/sub&gt;(Cl,½CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O, a new mineral of the manasseite-sjögrenite group, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 111(1), 121-127</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hydrotalcite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>05.DA.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions and H2O, With medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Chlormagaluminite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1980-098</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Clastic_Conglomerate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al. 2005; SLTTs 2004</dct:source>
    <rdfs:comment xml:lang="en">Clastic sedimentary rock composed of at least 30 percent rounded to subangular fragments larger than 2 mm in diameter; typically contains finer grained material in interstices between larger fragments. If more than 15 percent of the fine grained matrix is of indeterminant clastic or diagenetic origin and the fabric is matrix supported, may also be categorized as wackestone. If rock has unsorted or poorly sorted texture with a wide range of particle sizes, may also be categorized as diamictite.</rdfs:comment>
    <rdfs:comment xml:lang="en">Note this category is equivlanet to category labeled 'Conglomeratic rock in SLTTs (2004), not to the category labeled 'Conglomerate' in that system.</rdfs:comment>
    <rdfs:label xml:lang="en">conglomerate</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Clastic_Sedimentary_Rock"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Generic_Conglomerate"/>
    <skos:altLabel xml:lang="en">conglomeratic rock</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/epistolite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Epistolite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Nb | Ti | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">epistolite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/epistolite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)Nb&lt;sub&gt;2&lt;/sub&gt;Na&lt;sub&gt;3&lt;/sub&gt;Ti(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:mindatid>min-1392</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1392:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1392.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)Nb&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Na&lt;sub&gt;3&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070396</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Epistolite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Epistolite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Boeggild O B (1901) Epistolite, a new mineral, Meddelelser om Grønland 24, 183-190</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Seidozerite-Lamprophyllite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.BE.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate: Si2O7 groups, with additional anions; cations in octahedral [6] and greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Epistolite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1901</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ferristrunzite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ferristrunzite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Fe | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">strunzite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/ferristrunzite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;3+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1986-023</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: TriironIII diphosphate trihydroxyl pentahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1500</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1500:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1500.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;3+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ferristrunzite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ferristrunzite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Peacor D R, Dunn P J, Simmons W B, Ramik R A (1987) Ferristrunzite, a new mineral of the strunzite group, from Blaton, Belgium, Neues Jahrbuch für Mineralogie, Monatshefte 1987, 453-457</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Strunzite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DC.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With only medium-sized cations, (OH, etc.):RO4 = 1:1 and &lt; 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Ferristrunzite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1986-023</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/aspidolite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Aspidolite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/mineral/mica"/>
    <gsmin:chemistryelements>Na | Mg | Si | Al | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic, monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">mica-true micas</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaMg&lt;sub&gt;3&lt;/sub&gt;(Si&lt;sub&gt;3&lt;/sub&gt;Al)O&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2004-049</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Redefined|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-396</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:396:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-396.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaMg&lt;sub&gt;3&lt;/sub&gt;(Si&lt;sub&gt;3&lt;/sub&gt;Al)O&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Aspidolite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Aspidolite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">von Kobell F (1869) Ueber den Aspidolith, ein Glied aus der Biotit- und Phlogopit-Gruppe, Sitzungsberichte der Königlich Bayerischen Akademie der Wissenschaften zu München 1, 364-366 Mineral was only formally accepted as a species with this publication: Banno Y, Miyawaki R, Kogure T, Matsubara S, Kamiya T, Yamada S (2005) Aspidolite, the Na analogue of phlogopite, from Kasuga-mura, Gifu Prefecture, central Japan, description and structural data, Mineralogical Magazine 69, 1047-1057</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Clay</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EC.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with mica sheets, composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Aspidolite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2004-049</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/pracharite">
