    <gsmin:chemistryelements>Ca | Fe | Al | Si | O | B | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaFe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Al&lt;sub&gt;6&lt;/sub&gt;(Si&lt;sub&gt;5&lt;/sub&gt;AlO&lt;sub&gt;18&lt;/sub&gt;)(BO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;(OH)</gsmin:imachemistry>
