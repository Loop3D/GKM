    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Vaughanite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Vaughanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Harris D C, Roberts A C (1989) Vaughanite, TlHgSb_4_S_7_, a new mineral from Hemlo, Ontario, Canada, Mineralogical Magazine 53, 79-83</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.LA.20</gsmin:strunzcodeV10>
