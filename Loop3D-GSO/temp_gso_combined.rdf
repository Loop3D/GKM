    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bischofite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Bischofite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Ochsenius C (1877) Bischofit, in Die Bildung der Steinsalzlager und ihrer Mutterlaugensalze unter specieller Berücksichtigung der Flötze von Douglashall in der egeln'schen Mulde, C E M Pfeffer (Halle, Germany) 156-160</gsmin:statusnotes>
    <gsmin:strunzcodeV10>03.BB.15</gsmin:strunzcodeV10>
