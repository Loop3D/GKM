    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaAl&lt;sub&gt;3&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;18&lt;/sub&gt;·12H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R080090</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Shigaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Shigaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Peacor D R, Dunn P J, Kato A, Wicks F J (1985) Shigaite, a new manganese aluminum sulfate mineral from the Loi mine, Shiga, Japan, Neues Jahrbuch für Mineralogie, Monatshefte 1985, 453-457</gsmin:statusnotes>
