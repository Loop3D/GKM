    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:502:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-502.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CuSe&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bambollaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Bambollaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Harris D C, Nuffield E W (1972) Bambollaite, a new copper telluro-selenide, The Canadian Mineralogist 11, 738-742</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.EB.05b</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide, M: S &lt;= 1:2 with Fe, Co, Ni, PGE, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Bambollaite.shtml</gsmin:webmineralurl>
