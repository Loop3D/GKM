  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/timeYoungerThan">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Age associated with subject is entirely after the age associated with object</rdfs:comment>
    <rdfs:comment xml:lang="en">Event A is younger than event B if A has occurred after  B.  Same as Allen A After B.  (Burns, 1975; Mathematical Geology, Vol. 7, No. 4)</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/isTemporallyRelatedTo"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/armbrusterite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Armbrusterite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | K | Mn | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;6&lt;/sub&gt;K&lt;sub&gt;5&lt;/sub&gt;Mn&lt;sup&gt;3+&lt;/sup&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;14&lt;/sub&gt;(Si&lt;sub&gt;9&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;10&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2005-035</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-28891</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:28891:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-28891.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;6&lt;/sub&gt;K&lt;sub&gt;5&lt;/sub&gt;Mn&lt;sup&gt;3+&lt;/sup&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;14&lt;/sub&gt;[Si&lt;sub&gt;9&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;]&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;10&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Armbrusterite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Armbrusterite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Yakovenchuk V N, Krivovichev S V, Pakhomovsky Y A, Ivanyuk G Y, Selivanova E A, Men’shikov Y P, Britvin S N (2007) Armbrusterite, K&lt;sub&gt;5&lt;/sub&gt;Na&lt;sub&gt;6&lt;/sub&gt;Mn&lt;sup&gt;3+&lt;/sup&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;14&lt;/sub&gt;[Si&lt;sub&gt;9&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;]&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;10&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O, a new Mn hydrous heterophyllosilicate from the Khibiny alkaline massif, Kola Peninsula, Russia, American Mineralogist 92, 416-423</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.EG.65</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate: Double nets with 6-membered and larger rings</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://webmineral.com/data/Armbrusterite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2005-035</gsmin:wikipediadate>
  </rdf:Description>
