    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;x&lt;/sub&gt;Mn&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;1-x&lt;/sub&gt;O&lt;sub&gt;2-2x&lt;/sub&gt;(OH)&lt;sub&gt;2x&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2940</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2940:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2940.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;x&lt;/sub&gt;Mn&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;1-x&lt;/sub&gt;O&lt;sub&gt;2-2x&lt;/sub&gt;(OH)&lt;sub&gt;2x&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nsutite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Nsutite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Zwicker W K, Groeneveld Meijer W O J, Jaffe H W (1962) Nsutite - a widespread manganese oxide mineral, American Mineralogist 47, 246-266</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Ramsdellite</gsmin:structuralgroup>
