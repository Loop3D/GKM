    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;4+&lt;/sup&gt;(O,OH)&lt;sub&gt;2&lt;/sub&gt;·(Co,Ni,Mg,Ca)&lt;sub&gt;x&lt;/sub&gt;(OH)&lt;sub&gt;2x&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-384</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:384:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-384.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;4+&lt;/sup&gt;(O,OH)&lt;sub&gt;2&lt;/sub&gt;·(Co&lt;sup&gt;3+&lt;/sup&gt;,Ni&lt;sup&gt;2+&lt;/sup&gt;,Mg,Ca)&lt;sub&gt;x&lt;/sub&gt;(OH)&lt;sub&gt;2x&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070306 | R070359</gsmin:rruffids>
