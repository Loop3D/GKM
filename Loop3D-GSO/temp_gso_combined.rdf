    <gsmin:mindaturl>http://www.mindat.org/min-7062.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaCeSr&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;F</gsmin:rruffchemistry>
    <gsmin:rruffids>R070163</gsmin:rruffids>
