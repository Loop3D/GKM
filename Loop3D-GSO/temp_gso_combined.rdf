    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/decrespignyitey.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Y&lt;sub&gt;4&lt;/sub&gt;Cu(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;Cl(OH)&lt;sub&gt;5&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2001-027</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-9294</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:9294:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-9294.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Y&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;Cl(OH)&lt;sub&gt;5&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060302</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Decrespignyite-(Y)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Decrespignyite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Wallwork K, Kolitsch U, Pring A, Nasdala L (2002) Decrespignyite-(Y), a new copper yttrium rare earth carbonate chloride hydrate from Paratoo, South Australia, Mineralogical Magazine 66, 181-188</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.CC.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate without additional anions, with H2O, With rare earth elements (REE)</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Decrespignyite-%28Y%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2001-027</gsmin:wikipediadate>
