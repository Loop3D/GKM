  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ferro-taramite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ferro-taramite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Fe | Al | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">amphibole-group 3 Na-Ca</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na(NaCa)(Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;)(Si&lt;sub&gt;6&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;)O&lt;sub&gt;22&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2006-023</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:mindatid>min-106</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:106:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-106.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na(NaCa)Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;6&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;)O&lt;sub&gt;22&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ferro-taramite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ferro-taramite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Oberti R, Boiocchi M, Smith D C, Medenbach O (2007) Aluminotaramite, alumino-magnesiotaramite, and fluoro-alumino-magnesiotaramite: mineral data and crystal chemistry, American Mineralogist 92, 1428-1435 Name changed from aluminotaramite: Hawthorne F C, Oberti R, Harlow G E, Maresch W V, Martin R F, Schumacher J C, Welch M D (2012) Nomenclature of the amphibole supergroup. American Mineralogist 97, 2031-2048</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Amphibole</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DE.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 2-periodic double chains, Si4O11; Clinoamphiboles</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://webmineral.com/data/Aluminotaramite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2006-023</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/xifengite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Xifengite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Fe | Si</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/xifengite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sub&gt;5&lt;/sub&gt;Si&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1983-086</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Pentairon trisilicide</gsmin:iupacchemname>
    <gsmin:mindatid>min-4335</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4335:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4335.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sub&gt;5&lt;/sub&gt;Si&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Xifengite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Xifengite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Yu Z (1984) Two new minerals gupeiite and xifengite in cosmic dusts from Yanshan, Acta Petrologica Mineralogica et Analytica 3, 231-238</gsmin:statusnotes>
    <gsmin:strunzcodeV10>01.BB.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Silicides</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Xifengite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1983-086</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/biehlite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Biehlite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Sb | Mo | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/biehlite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sb&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;MoO&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1999-019</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: DiantimonyIII molybdenum hexaoxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-7581</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7581:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7581.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sb&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Mo&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Biehlite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Biehlite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Schlüter J, Klaska K-H, Adiwidjaja G, Friese K, Gebhard G (2000) Biehlite, (Sb,As)&lt;sub&gt;2&lt;/sub&gt;MoO&lt;sub&gt;6&lt;/sub&gt;, a new mineral from Tsumeb, Namibia, Neues Jahrbuch für Mineralogie, Monatshefte 2000, 234-240</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.DB.60</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With medium-sized cations; chains of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Biehlite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1999-019a</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/eylettersite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Eylettersite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Th | Al | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">alunite-jarosite-plumbogummite subgroup</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/eylettersite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Th&lt;sub&gt;0.75&lt;/sub&gt;Al&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1969-035</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1430</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1430:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1430.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Th&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;0.75&lt;/sub&gt;Al&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Eylettersite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Eylettersite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">van Wambeke L (1972) Eylettersite, un nouveau phosphate de thorium appartenant à la série de la crandallite, Bulletin de la Société Française de Minéralogie et de Cristallographie 95, 98-105</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Alunite-crandallite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BL.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH, etc.):RO4 = 3:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Eylettersite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1969-035</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kaolinite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kaolinite</rdfs:label>
