    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Verbeekite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Verbeekite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Roberts A C, Paar W H, Cooper M A, Topa D, Criddle A J, Jedwab J (2002) Verbeekite, monoclinic PdSe_2_, a new mineral from the Musonoi Cu-Co-Mn-U mine, near Kolwezi, Shaba Province, Democratic Republic of Congo, Mineralogical Magazine 66, 173-179</gsmin:statusnotes>
