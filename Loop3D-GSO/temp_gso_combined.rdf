    <gsmin:wikipediadate>1824</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/chelkarite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
