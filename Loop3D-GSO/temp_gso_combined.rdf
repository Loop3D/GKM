    <gsmin:mindaturl>http://www.mindat.org/min-39584.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·9H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nováčekite-II</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Novacekite-II</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Frondel C (1951) Studies of uranium minerals (IX): saléeite and novacekite, American Mineralogist 36, 680-686 Name changed from novácekite II: Nickel E H, Nichols M C (2009) IMA/CNMNC list of mineral names compiled by Ernest H. Nickel &amp; Monte C. Nichols supplied through the courtesy of Materials Data, Inc. (http://www.MaterialsData.com) and based on the database MINERAL, which MDI makes available as a free download to the mineralogical community. 1-315</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.EB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl phosphate or arsenate, UO2:RO4 = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Novacekite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1951</gsmin:wikipediadate>
