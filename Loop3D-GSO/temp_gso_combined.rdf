  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/intersilite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Intersilite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Mn | Ti | Nb | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;6&lt;/sub&gt;Mn(Ti,Nb)Si&lt;sub&gt;10&lt;/sub&gt;(O,OH)&lt;sub&gt;28&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1995-033</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-7111</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7111:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7111.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;6&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;(Ti&lt;sup&gt;4+&lt;/sup&gt;,Nb&lt;sup&gt;5+&lt;/sup&gt;)Si&lt;sub&gt;10&lt;/sub&gt;(O,OH)&lt;sub&gt;28&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Intersilite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Intersilite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Khomyakov A P, Roberts A, Nechelyustov G N, Yamnova N A, Pushcharovsky D Y (1996) Intersilite Na_6_MnTi[Si_10_O_24_(OH)](OH)_3_·4H_2_O – the new mineral with a new type of the band-layered silicon-oxygen radical, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 125(4), 79-85</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.EE.60</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate: Single tetrahedral nets of 6-membered rings connected by octahedral nets or octahedral bands</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Intersilite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1995-033</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/paulingite-ca">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Paulingite-Ca</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | K | Na | Ba | Si | Al | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">zeolite-paulingite series</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,K,Na,Ba,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)&lt;sub&gt;10&lt;/sub&gt;(Si,Al)&lt;sub&gt;42&lt;/sub&gt;O&lt;sub&gt;84&lt;/sub&gt;·34H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Renamed|Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,K,Na,Ba,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)&lt;sub&gt;10&lt;/sub&gt;(Si,Al)&lt;sub&gt;42&lt;/sub&gt;O&lt;sub&gt;84&lt;/sub&gt;·34H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R120023</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Paulingite-Ca</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Paulingite-Ca</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Defined as the Ca-end member of paulingite: Coombs D S, Alberti A, Armbruster T, Artioli G, Colella C, Galli E, Grice J D, Liebau F, Mandarino J A, Minato H, Nickel E H, Passaglia E, Peacor D R, Quartieri S, Rinaldi R, Ross M, Sheppard R A, Tillmanns E, Vezzalini G, (1997) Recommended nomenclature for zeolite minerals: report of the Subcommittee on Zeolites of the International Mineralogical Association, Commission on New Minerals and Mineral Names, The Canadian Mineralogist 35, 1571-1606 Jambor J L, Grew E S, Roberts A C (1998) New mineral names, American Mineralogist 83, 1347-1352</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/scandiobabingtonite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
