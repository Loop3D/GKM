    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;4&lt;/sub&gt;Al&lt;sub&gt;4&lt;/sub&gt;)O&lt;sub&gt;16&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060809</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Gismondine</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Gismondine</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named zeagonite: von Leonhard K C (1817) Die zeagonit, ein neues mineral vom Capo do Bove bei Rom, Taschenbuch für die gesammte Mineralogie mit Hinsicht auf die neuesten Entdeckungen 11, 164-168</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.GC.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Zeolite family: Chains of doubly-connected 4-membered rings</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Gismondine-Ca.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>0</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/alfredopetrovite">
