  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/vladimirite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Vladimirite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/vladimirite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;4&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(AsO&lt;sub&gt;3&lt;/sub&gt;OH)·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:mindatid>min-4195</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4195:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4195.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;4&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;OH)·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R080001 | R100075</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Vladimirite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Vladimirite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Nefedov E I (1953) Report on new minerals discovered by him p.317 in V. A. Mokievsky. The scientific session of the Federov Institute together with the All-Union Mineralogical Society, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 82(4), 311-317 Redefined both chemically and structurally: Pierrot R (1964) Contribution à la minéralogie des arséniates calciques et calcomagnésiens naturels, Bulletin de la Société Française de Minéralogie et de Cristallographie 87, 169-211 Chemical formula revised from Ca_5_(AsO_4_)_2_(AsO_3_OH)_2_·5H_2_O: Yang H, Evans S H, Downs R T, Jenkins R A (2011) The crystal structure of vladimirite, with a revised chemical formula, Ca_4_(AsO_4_)_2_(AsO_3_OH)·4H_2_O, The Canadian Mineralogist 49, 1055-1064</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.CJ.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With only large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Vladimirite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1953</gsmin:wikipediadate>
  </rdf:Description>
