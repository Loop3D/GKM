    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Majzlanite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Majzlanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Siidra, O.I., Nazarchuk, E.V., Zaitsev, A.N. and Shilovskikh, V.V. (2018) Majzlanite, IMA2018-016. CNMNC Newsletter No 43, June 2018, page 784; Mineralogical Magazine, 82, 779–785</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/dansite">
