    <gsmin:mindaturl>http://www.mindat.org/min-285.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Sb&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;S</gsmin:rruffchemistry>
    <gsmin:rruffids>R060674</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Apuanite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Apuanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mellini M, Merlino S, Orlandi P (1979) Versiliaite and apuanite, two new minerals from the Apuan Alps, Italy, American Mineralogist 64, 1230-1234</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Trippkeite</gsmin:structuralgroup>
