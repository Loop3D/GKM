    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7169:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7169.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;12&lt;/sub&gt;Ca&lt;sub&gt;6&lt;/sub&gt;Sr&lt;sub&gt;3&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;W&lt;sup&gt;5+&lt;/sup&gt;Zr&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(Si&lt;sub&gt;25&lt;/sub&gt;O&lt;sub&gt;73&lt;/sub&gt;)(O,OH,H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;3&lt;/sub&gt;(Cl,OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Manganokhomyakovite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Manganokhomyakovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Johnsen O, Gault R A, Grice J D, Ercit T S (1999) Khomyakovite and Manganokhomyakovite, two new members of the eudialyte group from Mont Saint-Hilaire, Quebec, Canada, The Canadian Mineralogist 37, 893-899</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Eudialyte</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CO.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si9O27]18- 9-membered rings</gsmin:strunzlabel>
