    <gsmin:rruffnameplain xml:lang="en">Symplesite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Breithaupt A (1837) Bestimmung neuer mineralien. 1. Symplesischer diatom oder symplesit, Journal für Praktische Chemie 10, 501-503</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Symplesite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CE.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With only medium-sized cations, RO4:H2O about 1:2.5</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Symplesite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1837</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/lukrahnite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
