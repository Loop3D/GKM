  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/pertlikite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Pertlikite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Fe | Mg | Al | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;(Fe&lt;sup&gt;2+&lt;/sup&gt;,Mg)&lt;sub&gt;2&lt;/sub&gt;(Mg,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;4&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Al(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;12&lt;/sub&gt;·18H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2005-055</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-36064</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:36064:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-36064.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;(Fe&lt;sup&gt;2+&lt;/sup&gt;,Mg)&lt;sub&gt;2&lt;/sub&gt;(Mg,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;4&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Al(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;12&lt;/sub&gt;·18H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R110209</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pertlikite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Pertlikite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Ertl A, Dyar M D, Hughes J M, Brandstätter F, Gunter M E, Prem M, Peterson R C (2008) Pertlikite, a new tetragonal Mg-rich member of the voltaite group from Madeni Zakh, Iran, The Canadian Mineralogist 46, 661-669</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Voltaite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.CC.25</gsmin:strunzcodeV10>
