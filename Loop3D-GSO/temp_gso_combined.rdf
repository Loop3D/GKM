    <gsmin:chemistryelements>Mn | Sn | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">stottite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/tetrawickmanite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;Sn&lt;sup&gt;4+&lt;/sup&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1971-018</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: ManganeseII tinIV hexahydroxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-3928</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3928:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3928.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;Sn&lt;sup&gt;4+&lt;/sup&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R100003</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tetrawickmanite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tetrawickmanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">White J S, Nelen J A (1973) Tetrawickmanite, tetragonal MnSn(OH)6 a new mineral from North Carolina, and the stottite group, The Mineralogical Record 4, 24-30</gsmin:statusnotes>
