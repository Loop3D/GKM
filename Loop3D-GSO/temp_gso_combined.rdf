    <gsmin:rruffnameplain xml:lang="en">Dessauite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Orlandi P, Pasero M, Duchi G, Olmi F (1997) Dessauite, (Sr,Pb)(Y,U)(Ti,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;20&lt;/sub&gt;O&lt;sub&gt;38&lt;/sub&gt;, a new mineral of the crichtonite group from Buca delia Vena mine, Tuscany, Italy, American Mineralogist 82, 807-811</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Crichtonite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.CC.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 2: 3,3: 5, and similar, With large and medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Dessauite-%28Y%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1994-057</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/pittongite">
