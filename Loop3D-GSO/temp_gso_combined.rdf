    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ophirite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ophirite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf A R, Hughes J M, Nash B P, Wright S E, Rossman G R, Marty J (2014) Ophirite, Ca_2_Mg_4_[Zn_2_Mn^3+^_2_(H_2_O)_2_(Fe^3+^W_9_O_34_)_2_]·46H_2_O, a new mineral with a heteropolytungstate tri-lacunary Keggin anion. American Mineralogist 99, 1045-1051</gsmin:statusnotes>
