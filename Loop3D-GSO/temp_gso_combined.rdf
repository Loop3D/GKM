    <gsmin:imastatus xml:lang="en">Redefined|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: TrimanganeseII diphosphate tetrahydrate</gsmin:iupacchemname>
