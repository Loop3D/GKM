    <rdfs:label xml:lang="en">Middle Pleistocene Age</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Orthogneiss">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">This vocabulary</dct:source>
    <rdfs:comment xml:lang="en">A gneiss with mineralogy and texture indicating derivation from a phaneritic igneous rock protolith. Typically consists of abundant feldspar, with quartz, and variable hornblende, biotite, and muscovite, with a relatively homogeneous character.</rdfs:comment>
    <rdfs:label xml:lang="en">orthogneiss</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Gneiss"/>
  </rdf:Description>
