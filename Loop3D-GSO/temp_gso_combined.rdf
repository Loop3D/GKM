  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/askagenite-nd">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Åskagenite-(Nd)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | Nd | Al | Fe | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;NdAl&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)(SiO&lt;sub&gt;4&lt;/sub&gt;)O&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2009-073</gsmin:imanumber>
