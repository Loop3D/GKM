    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,Ca)&lt;sub&gt;2+x&lt;/sub&gt;(V&lt;sup&gt;5+&lt;/sup&gt;,V&lt;sup&gt;4+&lt;/sup&gt;)&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;16&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1739</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1739:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1739.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,Ca)&lt;sub&gt;2+x&lt;/sub&gt;(V&lt;sup&gt;5+&lt;/sup&gt;,V&lt;sup&gt;4+&lt;/sup&gt;)&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;16&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
