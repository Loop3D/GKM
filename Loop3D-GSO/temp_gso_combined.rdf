  <rdf:Description rdf:about="https://w3id.org/gso/1.0/element/osmium">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">osmium</rdfs:label>
    <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://www.britannica.com/science/osmium</rdfs:seeAlso>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Element"/>
    <gsel:atomicNumber rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">76</gsel:atomicNumber>
    <gsel:chebiid rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://purl.obolibrary.org/obo/CHEBI_30687</gsel:chebiid>
    <gsel:symbol>Os</gsel:symbol>
    <gsel:wikidataid rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">http://www.wikidata.org/entity/Q751</gsel:wikidataid>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Spilite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Fettes and Desmon, 2007; Best, M.G., 1982, Igneous and metamorphic petrology: New York, W.H. Freeman and company, p. 398; Neuendorf et al. 2005, p. 619.</dct:source>
    <rdfs:comment xml:lang="en">Altered basic to intermediate composition fine-grained igneous rock in which the feldspar is partially or completely composed of of albite, typically accompanied by chlorite, calcite, quartz, epidote, prehnite, and low-tempaerature hydrous crystallization products. Preservation of eruptive volcanic features is typical.</rdfs:comment>
    <rdfs:label xml:lang="en">spilite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Metasomatic_Rock"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Frost_Shattering">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf, K.K.E, Mehl, J.P. &amp; Jackson, J.A. (eds), 2005. Glossary of geology, 5th Edition. American Geological Institute, Alexandria, 779 p.</dct:source>
    <rdfs:comment xml:lang="en">Propagation of fractures due to expansion of freezing water in intergranular spaces and fractures in a rock body. Result is mechanical disintegration spliitting, or breakup of rock.</rdfs:comment>
    <rdfs:label xml:lang="en">frost shattering</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicprocess/Physical_Weathering"/>
  </rdf:Description>
