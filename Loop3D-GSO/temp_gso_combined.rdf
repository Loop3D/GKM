    <gsmin:rruffids>R110193</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Shkatulkalite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Shkatulkalite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Menchikov Y P, Khomyakov A P, Polezhaeva L I, Rastsvetaeva R K (1996) Shkatulkalite Na_10_MnTi_3_Nb_3_(Si_2_O_7_)_6_(OH)_2_F·12H_2_O – a new mineral, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 125(1), 120-126</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Seidozerite-Lamprophyllite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.BE.50</gsmin:strunzcodeV10>
