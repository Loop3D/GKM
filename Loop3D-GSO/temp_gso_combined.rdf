  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Traction_Saltation_or_Suspension_Deposition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">this vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Deposition of sediment from moving water or air, in which the sediment is transported by entrainment in the moving fluid. Constrast with debris flow or turbidity current deposition in which movement of fluid/sediment mixture is due to incorporation of sediment in fluid.</rdfs:comment>
    <rdfs:label xml:lang="en">deposition from moving fluid</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicprocess/Mechanical_Deposition"/>
  </rdf:Description>
