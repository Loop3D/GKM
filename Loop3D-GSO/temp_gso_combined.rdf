  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/raslakite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Raslakite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Fe | Zr | Si | Nb | O | H | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">eudialyte</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;15&lt;/sub&gt;Ca&lt;sub&gt;3&lt;/sub&gt;Fe&lt;sub&gt;3&lt;/sub&gt;(Na,Zr)&lt;sub&gt;3&lt;/sub&gt;Zr&lt;sub&gt;3&lt;/sub&gt;(Si,Nb)Si&lt;sub&gt;25&lt;/sub&gt;O&lt;sub&gt;73&lt;/sub&gt;(OH,H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;3&lt;/sub&gt;(Cl,OH)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2002-067</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-25687</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:25687:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-25687.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;15&lt;/sub&gt;Ca&lt;sub&gt;3&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(Na,Zr&lt;sup&gt;4+&lt;/sup&gt;)&lt;sub&gt;3&lt;/sub&gt;Zr&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(Si,Nb&lt;sup&gt;3+&lt;/sup&gt;)Si&lt;sub&gt;25&lt;/sub&gt;O&lt;sub&gt;73&lt;/sub&gt;(OH,H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;3&lt;/sub&gt;(Cl,OH)</gsmin:rruffchemistry>
    <gsmin:rruffids>R070071</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Raslakite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Raslakite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chukanov N V, Pekov I V, Zadov A E, Korovushkin V V, Ekimenkova I A, Rastsvetaeva R K (2003) (Na,H_3_O)_15_(Ca,Mn,REE)_6_Fe^3+^_2_Zr_3_([box],Zr)([box],Si)Si_24_O_66_(O,OH)_6_Cl·nH_2_O and raslakite Na_15_Ca_3_Fe_3_(NaZr)_3_Zr_3_(Si,Nb)(Si_25_O_73_)(OH,H_2_O)_2_(Cl,OH) - the new eudialyte-group minerals from Lovozero massif, Kola Peninsula, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 132(5), 22-33</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Eudialyte</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CO.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si9O27]18- 9-membered rings</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Raslakite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2002-067</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Human_Deposition">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Human processes of material deposition, e.g. landfill, mining waste heaps, tailings, road-grade fill.</rdfs:comment>
