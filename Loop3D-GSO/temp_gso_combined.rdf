    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1730:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1730.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;24&lt;/sub&gt;Fe&lt;sub&gt;2&lt;/sub&gt;Hg&lt;sub&gt;9&lt;/sub&gt;S&lt;sub&gt;23&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Gortdrumite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Gortdrumite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Steed G M (1983) Gortdrumite, a new sulphide mineral containing copper and mercury, from Ireland, Mineralogical Magazine 47, 35-36 Chemical formula changed from Cu_18_FeHg_6_S_16_: Bindi L, Paar W H, Leblhuber P (2018) Gortdrumite, Cu_24_Fe_2_Hg_9_S_23_, from Leogang, Salzburg, Austria: crystal structure and revision of the chemical formula. Mineralogical Magazine 82, 853-861</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.BD.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide M:S &gt; 1:1 with Hg, Tl</gsmin:strunzlabel>
