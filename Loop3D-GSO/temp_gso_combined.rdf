    <gsmin:mindaturl>http://www.mindat.org/min-3307.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;Al&lt;sub&gt;2&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)(OH)&lt;sub&gt;2&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pumpellyite-(Fe&amp;lt;sup&amp;gt;2+&amp;lt;/sup&amp;gt;)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Pumpellyite-(Fe2+)</gsmin:rruffnameplain>
