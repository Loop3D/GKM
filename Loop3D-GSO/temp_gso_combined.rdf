  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/alnaperboeite-ce">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Alnaperbøeite-(Ce)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Ce | Na | Al | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(CaCe&lt;sub&gt;2.5&lt;/sub&gt;Na&lt;sub&gt;0.5&lt;/sub&gt;)(Al&lt;sub&gt;4&lt;/sub&gt;)(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;O(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2012-054</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-43577</gsmin:mindatid>
    <gsmin:mindaturl>https://www.mindat.org/min-43577.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(CaCe&lt;sub&gt;2.5&lt;/sub&gt;Na&lt;sub&gt;0.5&lt;/sub&gt;)Al&lt;sub&gt;4&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;O(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Alnaperbøeite-(Ce)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Alnaperboeite-(Ce)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Bonazzi P, Lepore G O, Bindi L, Chopin C, Husdal T A, Medenbach O (2014) Perbøeite-(Ce) and alnaperbøeite-(Ce), two new members of the epidote-törnebohmite polysomatic series: Chemistry, structure, dehydrogenation, and clue for a sodian epidote end-member. American Mineralogist 99, 157-169</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Gatelite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfoliation/comb_layering">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Layering fabric defined by layers that have internal comb structure. Layer boundaries are the termination surfaces for the constituent crystals.</rdfs:comment>
