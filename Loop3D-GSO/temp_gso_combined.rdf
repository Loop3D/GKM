  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/schmidite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Schmidite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Zn | Fe | Mn | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">[Zn&lt;sub&gt;2&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;,Mn&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;6&lt;/sub&gt;]·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2017-012</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Pending publication</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">[Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;,Mn&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;6&lt;/sub&gt;]·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Schmidite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Schmidite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Grey, I.E., Keck, E., Kampf, A.R., MacRae, C.M., Glenn, A.M., Cashion, J. and Gozukara, Y. (2017) Schmidite, IMA 2017-012. CNMNC Newsletter No. 37, June 2017, page 7 1; Mineralogical Magazine, 81, 737–742</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Calcioferrite-Schoonerite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/putoranite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
