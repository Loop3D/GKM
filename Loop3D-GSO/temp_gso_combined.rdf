    <gsmin:statusnotes xml:lang="en">Paar W H, Moëlo Y, Mozgova N N, Organova N I, Stanley C J, Roberts A C, Culetto F J, Effenberger H S, Topa D, Putz H, Sureda R J, de Brodtkorb M K (2008) Coiraite, (Pb,Sn&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;12.5&lt;/sub&gt;As&lt;sub&gt;3&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;Sn&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;S&lt;sub&gt;28&lt;/sub&gt;: a franckeite-type new mineral species from Jujuy Province, NW Argentina, Mineralogical Magazine 72, 1083-1101</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.HF.25b</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">SnS type sulfosalt with SnS and PbS archetype structure units</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://webmineral.com/data/Coiraite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2005-024</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/sarcolite">
