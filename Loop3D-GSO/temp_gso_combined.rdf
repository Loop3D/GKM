    <gsmin:rruffids>R060525</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Turkestanite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Turkestanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pautov L A, Agakhanov A A, Sokolova E V, Kabalov Y K (1997) Turkestanite Th(Ca,Na)_2_(K_1-x_[box]_x_)Si_8_O_20_·nH_2_O – a new mineral, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 126(6), 45-55</gsmin:statusnotes>
