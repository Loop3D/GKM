    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">RhAsS</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1964-029</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Rhodium arsenide sulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-1922</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1922:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1922.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Rh&lt;sup&gt;3+&lt;/sup&gt;(AsS)&lt;sup&gt;3-&lt;/sup&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hollingworthite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hollingworthite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Stumpel E F, Clark A M (1965) Hollingworthite, a new rhodium mineral, identified by electron probe microanalysis, American Mineralogist 50, 1068-1074</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Ullmannite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.EB.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide, M: S &lt;= 1:2 with Fe, Co, Ni, PGE, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Hollingworthite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1964-029</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/merlinoite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Merlinoite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Ca | Si | Al | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">zeolite</gsmin:fleischersgroup>
