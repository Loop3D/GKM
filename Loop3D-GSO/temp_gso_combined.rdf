    <gsmin:imanumber xml:lang="en">IMA1991-008</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4240</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4240:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4240.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba&lt;sub&gt;0.5&lt;/sub&gt;Al&lt;sub&gt;3&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Walthierite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Walthierite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Li G, Peacor D R, Essene E J, Brosnahan D R, Beane R E (1992) Walthierite, Ba_0.5_[box]_0.5_Al_3_(SO_4_)_2_(OH)_6_, and huangite, Ca_0.5_[box]_0.5_Al_3_(SO_4_)_2_(OH)_6_, two new minerals of the alunite group from the Coquimbo region, Chile, American Mineralogist 77, 1275-1284</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Alunite-Alunite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.BC.10</gsmin:strunzcodeV10>
