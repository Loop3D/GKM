    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Lautenthalite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Lautenthalite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Medenbach O, Gebert W (1993) Lautenthalite, PbCu_4_[(OH)_6_|(SO_4_)_2_]·3H_2_O, the Pb analogue of devillite - A new mineral from the Harz mountains, Germany, Neues Jahrbuch für Mineralogie, Monatshefte 1993, 401-407</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Devilline</gsmin:structuralgroup>
