    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: TricopperII phosphate trihydroxyl dihydrate</gsmin:iupacchemname>
