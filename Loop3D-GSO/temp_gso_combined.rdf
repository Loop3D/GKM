    <gsmin:rruffids>R100092</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Lithiophosphate</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Lithiophosphate</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Matias V V, Bondareva A M (1957) Lithiophosphate - a new mineral, Doklady Akademii Nauk SSSR 112, 124-126</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.AA.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, without H2O, With small cations (some also with larger ones)</gsmin:strunzlabel>
