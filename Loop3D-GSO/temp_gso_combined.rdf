  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Clay">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">based on SLTTs 2004; Neuendorf et al. 2005; particle size from Wentworth grade scale</dct:source>
    <rdfs:comment xml:lang="en">Mud that consists of greater than 50 percent particles with grain size less than 0.004 mm</rdfs:comment>
    <rdfs:label xml:lang="en">clay</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Mud"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/hasDataValue">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
