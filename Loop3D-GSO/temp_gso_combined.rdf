    <owl:imports rdf:resource="https://w3id.org/gso/1.0/quality/ontology"/>
    <skos:definition xml:lang="en">Basic geologic structures for Geoscience Ontology; more specific structure types are in associated structure modules for faults, folds, fabrics.</skos:definition>
    <skos:prefLabel xml:lang="en">Geoscience Ontology, Geological Structure</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/torbernite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Torbernite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | U | O | P | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">autunite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/torbernite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·12H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Copper diuranyl diphosphate dodecahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-3997</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3997:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3997.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·12H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Torbernite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Torbernite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Estner F J A, Werner A G, Karsten D L G, Leske N G (1790) Chlorit-Erde, Chlorit-Schieser, in Frenmüthige Gedanken über herrn Inspector Werners Berbesserungen in der Mineralogie: nebst einigen Bemerkungen über Herrn Assessor Karstens Beschreibung des vom sel. Leske hinterlassenen Mineralien-Cabinetts, Wappler (Wien) 28-30</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.EB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl phosphate or arsenate, UO2:RO4 = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://webmineral.com/data/Torbernite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1790</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/carbobystrite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Carbobystrite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Al | Si | O | C | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;8&lt;/sub&gt;(Al&lt;sub&gt;6&lt;/sub&gt;Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;)(CO&lt;sub&gt;3&lt;/sub&gt;)·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2009-028</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-39562</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:39562:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-39562.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;8&lt;/sub&gt;(Al&lt;sub&gt;6&lt;/sub&gt;Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;)(CO&lt;sub&gt;3&lt;/sub&gt;)·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Carbobystrite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Carbobystrite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Khomyakov A P, Cámara F, Sokolova E (2010) Carbobystrite, Na&lt;sub&gt;8&lt;/sub&gt;[Al&lt;sub&gt;6&lt;/sub&gt;Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;](CO&lt;sub&gt;3&lt;/sub&gt;)·4H&lt;sub&gt;2&lt;/sub&gt;O, a new cancrinite-group mineral species from the Khibina Alkaline massif, Kola Peninsula, Russia: Description and crystal structure, The Canadian Mineralogist 48, 291-300</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Cancrinite-sodalite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.FB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Tektosilicate with additional anions</gsmin:strunzlabel>
    <gsmin:wikipediadate>2009-028</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/norilskite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Norilskite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pd | Ag | Pb</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Pd,Ag)&lt;sub&gt;7&lt;/sub&gt;Pb&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
