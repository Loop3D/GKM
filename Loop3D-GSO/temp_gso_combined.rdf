  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kraisslite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kraisslite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Zn | Mn | Mg | Fe | Al | As | O | Si | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic, hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/kraisslite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sub&gt;3&lt;/sub&gt;(Mn,Mg)&lt;sub&gt;25&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;,Al)(As&lt;sup&gt;3+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;[(Si,As&lt;sup&gt;5+&lt;/sup&gt;)O&lt;sub&gt;4&lt;/sub&gt;]&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;16&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1977-003</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2268</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2268:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2268.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(Mn&lt;sup&gt;2+&lt;/sup&gt;,Mg)&lt;sub&gt;25&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;,Al)(As&lt;sup&gt;3+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;[(Si,As&lt;sup&gt;5+&lt;/sup&gt;)O&lt;sub&gt;4&lt;/sub&gt;]&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;16&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060328</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kraisslite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kraisslite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Moore P B, Ito J (1978) Kraisslite, a new platy arsenosilicate from Sterling Hill, New Jersey, American Mineralogist 63, 938-940 Chemical formula revised: Dunn P J, Nelen J A (1980) Kraisslite and mcgovernite: new chemical data, American Mineralogist 65, 957-960 Chemical formula revised again: Cooper M A, Hawthorne F C (2012) Crystal structure of kraisslite, Zn_3_(Mn,Mg)_25_(Fe^3+^,Al)(As^3+^O_3_)_2_[(Si,As^5+^)O_4_]_10_(OH)_16_, from the Sterling Hill mine, Ogdensburg, Sussex County, New Jersey, USA, Mineralogical Magazine 76, 2819-2836</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hematolite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BE.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With only medium-sized cations, (OH, etc.):RO4 &gt; 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Kraisslite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1977-003</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologiccontact/Depositional_Contact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI contacttype SKOS vocabulary 2012-11-24</dct:source>
    <rdfs:comment xml:lang="en">Lithogenetic contact at which a sedimentary or volcanic rock has been deposited on (or against) another rock body. The relationship between the older underlying rocks and younger overlying rocks is unknown or not specfied.</rdfs:comment>
    <rdfs:label xml:lang="en">depositional contact</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologiccontact/Lithogenetic_Contact"/>
  </rdf:Description>
