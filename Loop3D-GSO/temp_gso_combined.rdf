  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfoliation/rhythmic_layering">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Layering in igneous rock defined by repeated gravity-stratified layers of typically mafic minerals at the base and plagioclase at the top, formed by crystal settling</rdfs:comment>
    <dct:source xml:lang="en">Jackson 1997</dct:source>
    <rdfs:label xml:lang="en">rhythmic layering</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfoliation/igneous_layering"/>
  </rdf:Description>
