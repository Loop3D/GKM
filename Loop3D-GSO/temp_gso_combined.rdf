  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/dansite-fe">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">D'ansite-(Fe)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Fe | S | O | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;21&lt;/sub&gt;Fe(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;10&lt;/sub&gt;Cl&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2011-065</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;21&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;10&lt;/sub&gt;Cl&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">D'ansite-(Fe)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Dansite-(Fe)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Demartin F, Campostrini I, Castellano C, Gramaccioli C M, Russo M (2012) D'ansite-(Mn), Na&lt;sub&gt;21&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;10&lt;/sub&gt;Cl&lt;sub&gt;3&lt;/sub&gt; and d'ansite-(Fe), Na&lt;sub&gt;21&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;10&lt;/sub&gt;Cl&lt;sub&gt;3&lt;/sub&gt;, two new minerals from volcanic fumaroles, Mineralogical Magazine 76, 2773-2783</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Dansite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/manganflurlite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Manganflurlite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Zn | Mn | Fe | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">ZnMn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;7&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2017-076</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sup&gt;2+&lt;/sup&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;7&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Manganflurlite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Manganflurlite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf A R, Grey I E, MacRae C M, Keck E (2019) Manganflurlite, ZnMn_3_^2+^Fe^3+^(PO_4_)_3_(OH)_2_(H_2_O)_7_·2H_2_O, a new schoonerite-related mineral from the Hagendorf-Süd pegmatite. European Journal of Mineralogy 31, 127-134</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Flurlite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/datolite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Datolite</rdfs:label>
