  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/allophane">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Amorphous hydrous silicate of aluminium, composition not fixed. (https://www.mindat.org/min-139.html)</rdfs:comment>
    <rdfs:label xml:lang="en">Allophane</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineraloid_Material"/>
    <gsmin:chemistryelements>Al | O | Si | H</gsmin:chemistryelements>
    <gsmin:fleischersgroup xml:lang="en">kaolinite-serpentine-serpentine subgroup</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/allophane.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;3&lt;/sub&gt;(SiO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;1.3-2.0&lt;/sub&gt;·2.5-3.0H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-139</gsmin:mindatid>
    <gsmin:mindaturl>http://www.mindat.org/min-139.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;3&lt;/sub&gt;(SiO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;1.3-2.0&lt;/sub&gt;·2.5-3.0H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070188 | R120001</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Allophane</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Allophane</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hausmann J F L, Stromeyer F (1816) Report at the Royal Academy of Sciences Göttingen meeting 13 July, 1816 on silberkupferglanz and allophan, Göttingische Gelehrte Anzeigen 2, 1249-1253</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Allophane</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.ED.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with kaolinite layers composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Allophane.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1816</gsmin:wikipediadate>
  </rdf:Description>
