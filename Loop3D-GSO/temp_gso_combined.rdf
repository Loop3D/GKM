    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Fe&lt;sup&gt;3+&lt;/sup&gt;,Mg,Al,Fe&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;2.5&lt;/sub&gt;(Si,Al)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;5&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1988-015</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2957</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2957:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2957.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Fe&lt;sup&gt;3+&lt;/sup&gt;,Mg,Al,Fe&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;2.5&lt;/sub&gt;(Si,Al)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;5&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Odinite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Odinite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Bailey S W (1988) Odinite, a new dioctahedral-trioctahedral Fe3+-rich 1:1 clay mineral, Clay Minerals 23, 237-247 Jambor J L, Puziewicz J (1990) New mineral names, American Mineralogist 75, 431-438</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Serpentine</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.ED.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with kaolinite layers composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Odinite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1988-015</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ferrisurite">
