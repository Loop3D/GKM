    <gsmin:chemistryelements>Ca | Si | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;6&lt;/sub&gt;Si&lt;sub&gt;2&lt;/sub&gt;[(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(SO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;12&lt;/sub&gt;]·22H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2011-037</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-41772</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:41772:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-41772.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;3&lt;/sub&gt;Si(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)(S&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)(OH)&lt;sub&gt;6&lt;/sub&gt;·11H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hielscherite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hielscherite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pekov I V, Chukanov N V, Britvin S N, Kabalov Y K, Göttlicher J, Yapaskurt V O, Zadov A E, Krivovichev S V, Schüller W, Ternes B (2012) The sulfite anion in ettringite-group minerals: a new mineral species hielscherite, Ca&lt;sub&gt;3&lt;/sub&gt;Si(OH)&lt;sub&gt;6&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)(SO&lt;sub&gt;3&lt;/sub&gt;)·11H&lt;sub&gt;2&lt;/sub&gt;O, and the thaumasite-hielscherite solid-solution series, Mineralogical Magazine 76, 1133-1152</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Ettringite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">sulfate, chromate, molybdate or tungstate</gsmin:strunzlabel>
    <gsmin:wikipediadate>2011-037</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ustarasite">
