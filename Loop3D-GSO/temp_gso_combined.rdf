  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/isPersistentPartOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Inverse of hasPersistentPart. Persistent parts temporally co-exist with the whole for the lifespan of the whole, so cannot be misisng but can be exchanged.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/isEssentialPartOf"/>
    <owl:inverseOf rdf:resource="https://w3id.org/gso/1.0/common/hasPersistentPart"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/tsepinite-na">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Tsepinite-Na</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | H | O | K | Sr | Ba | Ti | Nb | Si</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">labuntsovite</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,H&lt;sub&gt;3&lt;/sub&gt;O,K,Sr,Ba,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)&lt;sub&gt;2&lt;/sub&gt;(Ti,Nb)&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;)(OH,O)&lt;sub&gt;2&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2000-046</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:mindatid>min-11013</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:11013:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-11013.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,H&lt;sub&gt;3&lt;/sub&gt;O,K,Sr,Ba,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)&lt;sub&gt;12&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;8&lt;/sub&gt;(Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH,O)&lt;sub&gt;8&lt;/sub&gt;·12-16H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070241</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tsepinite-Na</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tsepinite-Na</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Shlyukova Z V, Chukanov N V, Pekov I V, Rastsvetaeva R K, Organova N I, Zadov A E (2001) Tsepinite-Na (Na,H3O,K,Sr,Ba)2(Ti,Nb)2[Si4O12](OH,O)2·3H2O, a new mineral of the labuntsovite group, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 130, issue 3, 43-50</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Labuntsovite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CE.30b</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si4O12]8- 4-membered single rings (vierer-Einfachringe), without insular complex anions</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Tsepinite-Na.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2000-046</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/namuwite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Namuwite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Zn | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/namuwite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sub&gt;4&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)(OH)&lt;sub&gt;6&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1981-020</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Tetrazinc tetrasulfate hexahydroxyl tetrahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2837</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2837:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2837.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R130173</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Namuwite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Namuwite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Bevins R E, Turgoose S, Williams P A (1982) Namuwite, (Zn,Cu)_4_SO_4_(OH)_6_·4H_2_O, a new mineral from Wales, Mineralogical Magazine 46, 51-54</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Ktenasite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.DD.50</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With only medium-sized cations; sheets of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Namuwite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1981-020</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/raadeite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Raadeite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mg | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;7&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;8&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1996-034</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Heptamagnesium diphosphate octahydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-7018</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7018:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7018.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;7&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;8&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Raadeite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Raadeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chopin C, Ferraris G, Prencipe M, Brunet F, Medenbach O (2001) Raadeite, Mg7(PO4)2(OH)8: a new dense-packed phosphate from Modum (Norway), European Journal of Mineralogy 13, 319-327</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Allactite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BE.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With only medium-sized cations, (OH, etc.):RO4 &gt; 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Raadeite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1996-034</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/weberite">
