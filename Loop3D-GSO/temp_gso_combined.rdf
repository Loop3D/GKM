    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Al | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/vantasselite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al&lt;sub&gt;4&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;·9H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1986-016</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Tetraaluminium triphosphate trihydroxyl nonahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-4150</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4150:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4150.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al&lt;sub&gt;4&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;·9H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060371</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Vantasselite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Vantasselite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Fransolet A M (1987) La vantasselite, Al_4_(PO_4_)_3_(OH)_3_·9H_2_O, une nouvelle espèce minérale du Massif de Stavelot, Belgique, Bulletin de Minéralogie 110, 647-656</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.DC.37</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With only medium-sized cations, (OH, etc.):RO4 = 1:1 and &lt; 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Vantasselite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1986-016</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/corrensite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Corrensite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Na | K | Mg | Fe | Al | Si | O | H</gsmin:chemistryelements>
    <gsmin:fleischersgroup xml:lang="en">smectite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/corrensite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Na,K)&lt;sub&gt;1-x&lt;/sub&gt;(Mg,Fe,Al)&lt;sub&gt;9&lt;/sub&gt;(Si,Al)&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;20&lt;/sub&gt;(OH)&lt;sub&gt;10&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1135</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1135:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1135.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Na,K)&lt;sub&gt;1-x&lt;/sub&gt;(Mg,Fe&lt;sup&gt;2+&lt;/sup&gt;,Al)&lt;sub&gt;9&lt;/sub&gt;(Si,Al)&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;20&lt;/sub&gt;(OH)&lt;sub&gt;10&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Corrensite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Corrensite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Lippmann F (1954) Über einen Keuperton von Zaisersweiher bei Maulbronn, Heidelberger Beiträge zur Mineralogie und Petrographie 4, 130-134</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Clay</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EC.60</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with mica sheets, composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Corrensite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1954</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/isEssentialPartOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Relation of being an essential part of a whole, such that whole is generically dependent on the part, and the part can be exchanged or missing.</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/hasDependent"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/isPartOf"/>
    <owl:inverseOf rdf:resource="https://w3id.org/gso/1.0/common/hasEssentialPart"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/natanite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
