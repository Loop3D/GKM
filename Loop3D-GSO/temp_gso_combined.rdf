    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Trilithium phosphate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2420</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2420:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2420.html</gsmin:mindaturl>
