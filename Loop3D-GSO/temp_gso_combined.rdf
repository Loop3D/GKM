    <gsmin:imanumber xml:lang="en">IMA1975-032</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: IronIII oxyhydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-1484</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1484:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1484.html</gsmin:mindaturl>
