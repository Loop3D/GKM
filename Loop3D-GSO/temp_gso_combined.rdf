    <gsmin:rruffnameplain xml:lang="en">Sitinakite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Men´shikov Y P, Sokolova E V, Egorov-Tismenko Y K, Khomyakov A P, Polezhaeva L I (1992) Sitinakite Na2KTi4Si2O13(OH)·4H2O—a new mineral, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 121, issue 1, 94-99</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.AG.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with additional anions; cations in &gt; [6] +- [6] coordination</gsmin:strunzlabel>
