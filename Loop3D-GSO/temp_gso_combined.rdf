  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/todorokite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Todorokite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | K | Ba | Sr | Mn | Mg | Al | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">coronadite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/todorokite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,Ca,K,Ba,Sr)&lt;sub&gt;1-x&lt;/sub&gt;(Mn,Mg,Al)&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;·3-4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3988</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3988:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3988.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,Ca,K,Ba,Sr)&lt;sub&gt;1-x&lt;/sub&gt;(Mn&lt;sup&gt;4+&lt;/sup&gt;,Mn&lt;sup&gt;3+&lt;/sup&gt;,Mg,Al)&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;·3-4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070257</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Todorokite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Todorokite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Yoshimura T (1934) "Todorokite", a new manganese mineral from the Todoroki mine, Hokkaido, Japan, Journal of the Faculty of Science, Hokkaido Imperial University, Series IV, Geology and Mineralogy 2, 289-297</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.DK.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With large (+- medium-sized) cations; tunnel structures</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Todorokite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1934</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/scacchite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Scacchite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/scacchite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">MnCl&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Manganese dichloride</gsmin:iupacchemname>
    <gsmin:mindatid>min-3549</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3549:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3549.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;Cl&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Scacchite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Scacchite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mineral is described, but not named: Guarini G, Palmieri L, Scacchi A (1855) Protocloruro di manganese e cloruro di magnesio, in Memoria sullo Incendio Vesuviano del Mese di Maggio 1855, G. Nobile (Napoli) 181-182 Mineral is named: Adam G J (1869) Scacchite, in Tableau Minéralogique, Libraire des Corps Impériaux des Ponts et Chaussées et des Mines (Paris) 70-70</gsmin:statusnotes>
    <gsmin:strunzcodeV10>03.AB.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Simple halides, without H2O, M:X 1:2</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Scacchite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1855</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/richardsollyite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Richardsollyite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Tl | Pb | As | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">TlPbAsS&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2016-043</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tl&lt;sup&gt;1+&lt;/sup&gt;Pb&lt;sup&gt;2+&lt;/sup&gt;As&lt;sup&gt;3+&lt;/sup&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Richardsollyite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Richardsollyite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Meisser N, Roth P, Nestola F, Biagioni C, Bindi L, Robyr M (2017) Richardsollyite, TlPbAsS_3_, a new sulfosalt from the Lengenbach quarry, Binn Valley, Switzerland. European Journal of Mineralogy 29, 679-688</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicunit/Pluton">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Pluton </rdfs:label>
    <rdfs:comment xml:lang="en">A pluton is any large igneous body that has congealed from magma underground. There are many sorts of pluton – including the lens-like and subhorizontal laccoliths and lopoliths, and the vertical or near-vertical sided stocks and batholiths. All these categories of pluton are defined on their overall apparent shape and relationship to the country rock. A batholith is the largest of the pluton types and by definition cover at least 100 square kilometres. A stock is a small discordant pluton, shaped like a batholith but falling below the necessary 100 square km in extent. (Dr Ted Nield, https://www.geolsoc.org.uk/Education-and-Careers/Ask-a-Geologist/Earth-Materials/Batholiths-and-Plutons </rdfs:comment>
    <rdfs:comment xml:lang="en">a body of intrusive rock, generally with a simple, regular margin, the whole being kilometre-scale or larger and with a cylindrical, lenticular or tabular shape; a pluton might consist of essentially one intrusion, or be a composite  of two or more spatially associated intrusions that are inferred to be related genetically.</rdfs:comment>
    <rdfs:comment xml:lang="en">dct:Source -- based on Gillespie, M R, Stephenson, D, and Millward, D. 2008. BGS classification of lithodemic units: Proposals for classifying units of intrusive rock. British Geological Survey Research Report, RR/08/05. 31pp.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="n6d111a80c3f44937a55e40566db5bca3b71"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicunit/Intrusion"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/chlorocalcite">
