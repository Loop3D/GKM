    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dicopper lead tetrabismuth nonasulfide</gsmin:iupacchemname>
