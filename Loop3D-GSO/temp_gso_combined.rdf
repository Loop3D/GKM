    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">MgB&lt;sub&gt;2&lt;/sub&gt;O(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3217</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3217:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3217.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">MgB&lt;sub&gt;2&lt;/sub&gt;O(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pinnoite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Pinnoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Staute H (1884) Pinnoit, ein neues Borat von Stassfurt, Berichte der Deutschen Chemischen Gesellschaft 17, 1584-1586</gsmin:statusnotes>
    <gsmin:strunzcodeV10>06.BB.05</gsmin:strunzcodeV10>
