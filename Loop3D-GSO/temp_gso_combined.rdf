    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Co&lt;sup&gt;2+&lt;/sup&gt;(S&lt;sub&gt;2&lt;/sub&gt;)&lt;sup&gt;2-&lt;/sup&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R061039</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cattierite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cattierite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kerr P F (1945) Cattierite and vaesite: New Co-Ni minerals from the Belgian Congo, American Mineralogist 30, 483-497</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Pyrite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.EB.05a</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide, M: S &lt;= 1:2 with Fe, Co, Ni, PGE, etc.</gsmin:strunzlabel>
