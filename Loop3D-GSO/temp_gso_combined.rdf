    <gsmin:strunzcodeV10>04.AA.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 2:1 and 1:2, Cation:Anion (M:O) = 2:1 (and 1.8:1)</gsmin:strunzlabel>
