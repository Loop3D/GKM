    <gsmin:rruffnameplain xml:lang="en">Nagashimalite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Matsubara S, Kato A (1980) Nagashimalite, Ba_4_(V^3+^,Ti)_4_[(O,OH)_2_|Cl|Si_8_B_2_O_27_], a new mineral from the Mogurazawa mine, Gumma prefecture, Japan, Mineralogical Journal 10, 122-130</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.CE.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si4O12]8- 4-membered single rings (vierer-Einfachringe), without insular complex anions</gsmin:strunzlabel>
