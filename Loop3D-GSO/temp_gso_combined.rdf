    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nyholmite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Nyholmite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Elliott P, Turner P, Jensen P, Kolitsch U, Pring A (2009) Description and crystal structure of nyholmite, a new mineral related to hureaulite, from Broken Hill, New South Wales, Australia, Mineralogical Magazine 73, 723-735 Piilonen P C, Poirier G (2010) New mineral names, American Mineralogist 95, 1357-1361</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hureaulite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CB.10</gsmin:strunzcodeV10>
