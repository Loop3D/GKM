    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1685:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1685.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;MgZn&lt;sup&gt;2+&lt;/sup&gt;SiO&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R130646</gsmin:rruffids>
