    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:26404:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-26404.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;8&lt;/sub&gt;As&lt;sub&gt;10&lt;/sub&gt;S&lt;sub&gt;23&lt;/sub&gt;</gsmin:rruffchemistry>
