    <gsmin:mindaturl>http://www.mindat.org/min-11005.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;4&lt;/sub&gt;Zr&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;10&lt;/sub&gt;O&lt;sub&gt;26&lt;/sub&gt;·9H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
