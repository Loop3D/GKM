  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/munakataite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Munakataite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Cu | Se | O | S | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;2&lt;/sub&gt;Cu&lt;sub&gt;2&lt;/sub&gt;(Se&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)(SO&lt;sub&gt;4&lt;/sub&gt;)(OH)&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2007-012</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dilead dicopper selenite sulfate tetrahydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-31727</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:31727:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-31727.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(Se&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R110005 | R110006 | R150128</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Munakataite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Munakataite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Matsubara S, Mouri T, Miyawaki R, Yokoyama K, Nakahara M (2008) Munakataite, a new mineral from the Kato mine, Fukuoka, Japan, Journal of Mineralogical and Petrological Sciences 103, 327-332</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Linarite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.BC.65</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions, without H2O, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Munakataite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2007-012</gsmin:wikipediadate>
  </rdf:Description>
