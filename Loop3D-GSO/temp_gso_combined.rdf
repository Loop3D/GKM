    <gsmin:rruffids>R070124 | R070194 | R070250</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hastingsite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hastingsite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Adams F D, Harrington B J (1896) On a new alkali hornblende and a titaniferous andradite from the nepheline-syenite of Dungannon, Hastings County, Ontario, The American Journal of Science 151, 210-218</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Amphibole</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DE.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 2-periodic double chains, Si4O11; Clinoamphiboles</gsmin:strunzlabel>
