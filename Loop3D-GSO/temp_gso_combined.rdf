    <rdfs:label xml:lang="en">Stracherite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ba | Ca | Si | O | P | C | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaCa&lt;sub&gt;6&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;[(PO&lt;sub&gt;4&lt;/sub&gt;)(CO&lt;sub&gt;3&lt;/sub&gt;)]&lt;sub&gt;2&lt;/sub&gt;F</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2016-098</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaCa&lt;sub&gt;6&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;[(P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)(C&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)]&lt;sub&gt;2&lt;/sub&gt;F</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Stracherite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Stracherite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Galuskin E V, Krüger B, Galuskina I O, Krüger H, Vapnik Y, Pauluhn A, Olieric V (2018) Stracherite, BaCa_6_(SiO_4_)_2_[(PO_4_)(CO_3_)]F, the first CO_3_-bearing intercalated hexagonal antiperovskite from Negev Desert, Israel. American Mineralogist 103, 1699–1706</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Zadovite</gsmin:structuralgroup>
  </rdf:Description>
