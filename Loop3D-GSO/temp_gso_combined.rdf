  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/magnesiohogbomite-2n2s">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Magnesiohögbomite-2N2S</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Al | Mg | Fe | Ti | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">hogbomite</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Mg,Fe,Al,Ti)&lt;sub&gt;22&lt;/sub&gt;(O,OH)&lt;sub&gt;32&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Al,Mg,Fe&lt;sup&gt;2+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;,Ti&lt;sup&gt;4+&lt;/sup&gt;)&lt;sub&gt;22&lt;/sub&gt;(O,OH)&lt;sub&gt;32&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Magnesiohögbomite-2N2S</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Magnesiohogbomite-2N2S</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Gavelin A (1916) Über högbomit, Bulletin of the Geological Institution of the University of Upsala 15, 289-316 Designated as hogbomite-4H: McKie D, (1963) The högbomite polytypes, Mineralogical Magazine 33, 563-580 Name changed to hogbomite-8H: Peacor D R (1967) New data on nigerite, American Mineralogist 52, 864-866 Name changed from hogbomite-8H: Armbruster T (2002) Revised nomenclature of högbomite, nigerite, and taafeite minerals, European Journal of Mineralogy 14, 389-395</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hogbömite-Magnesiohogbömite</gsmin:structuralgroup>
  </rdf:Description>
