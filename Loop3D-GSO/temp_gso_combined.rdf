    <gsmin:mindaturl>http://www.mindat.org/min-840.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;24&lt;/sub&gt;AlO&lt;sub&gt;6&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;17&lt;/sub&gt;(OH)&lt;sub&gt;12&lt;/sub&gt;·75H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070141</gsmin:rruffids>
