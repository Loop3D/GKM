    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(V&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R050548</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Curienite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Curienite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Cesbron F, Morin N (1968) Une nouvelle espèce minérale : la curiénite. Étude de la série francevillite-curiénite, Bulletin de la Société Française de Minéralogie et de Cristallographie 91, 453-459</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Fritzscheite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.HB.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">V[5,6] Vanadate, Uranyl Sorovanodates</gsmin:strunzlabel>
