  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/brannockite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Brannockite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Sn | Li | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">milarite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/brannockite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KSn&lt;sub&gt;2&lt;/sub&gt;(Li&lt;sub&gt;3&lt;/sub&gt;Si&lt;sub&gt;12&lt;/sub&gt;)O&lt;sub&gt;30&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1972-029</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-755</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:755:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-755.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KSn&lt;sub&gt;2&lt;/sub&gt;(Li&lt;sub&gt;3&lt;/sub&gt;Si&lt;sub&gt;12&lt;/sub&gt;)O&lt;sub&gt;30&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070278 | R070410</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Brannockite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Brannockite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">White J S, Arem J E, Nelen J A, Leavens P B, Thomssen R W (1973) Brannockite, a new tin mineral, The Mineralogical Record 4, 73-76</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Milarite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CM.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si6O18]12- 6-membered double rings (sechser-Doppelringe)</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Brannockite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1972-029</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/bonshtedtite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Bonshtedtite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Fe | P | O | C</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">bradleyite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/bonshtedtite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;3&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)(CO&lt;sub&gt;3&lt;/sub&gt;)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1981-026</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Trisodium ironII phosphate carbonate</gsmin:iupacchemname>
    <gsmin:mindatid>min-719</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:719:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-719.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;3&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)(CO&lt;sub&gt;3&lt;/sub&gt;)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bonshtedtite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Bonshtedtite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Khomyakov A P, Aleksandrov V V, Krasnova N I, Ermilov V V, Smolyaninova N N (1982) Bonshtedtite, Na&lt;sub&gt;3&lt;/sub&gt;Fe(PO&lt;sub&gt;4&lt;/sub&gt;)(CO&lt;sub&gt;3&lt;/sub&gt;), a new mineral, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 111(4), 486-490</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Bradleyite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>05.BF.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions, without H2O, With (Cl), SO4, PO4, TeO3</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Bonshtedtite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1981-026</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/dukeite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Dukeite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Bi | Cr | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bi&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;24&lt;/sub&gt;Cr&lt;sup&gt;6+&lt;/sup&gt;&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;57&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1999-021</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-7089</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7089:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7089.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bi&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;24&lt;/sub&gt;Cr&lt;sup&gt;6+&lt;/sup&gt;&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;57&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070441</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Dukeite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Dukeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Burns P C, Roberts A C, Stirling J A R, Criddle A J, Feinglos M N (2000) Dukeite, Bi&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;24&lt;/sub&gt;Cr&lt;sup&gt;6+&lt;/sup&gt;&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;57&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;3&lt;/sub&gt;, a new mineral from Brejaúba, Minas Gerais, Brazil: Description and crystal structure, American Mineralogist 85, 1822-1827</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.DF.80</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With large and medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Dukeite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1999-021</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/hedenbergite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Hedenbergite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Fe | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">pyroxene</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/hedenbergite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaFe&lt;sup&gt;2+&lt;/sup&gt;Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1842</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1842:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1842.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaFe&lt;sup&gt;2+&lt;/sup&gt;Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050030 | R060040 | R070136 | R070236</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hedenbergite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hedenbergite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Berzelius J J (1819) Hedenbergite, in Nouveau Système de Minéralogie, Méquignon-Marvis (Paris) 269-270</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Pyroxene</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DA.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 2-periodic single chains, Si2O6; pyroxene family</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Hedenbergite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1819</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kolbeckite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kolbeckite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Sc | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">phosphosiderite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/kolbeckite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sc(PO&lt;sub&gt;4&lt;/sub&gt;)·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Scandium phosphate dihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2239</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2239:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2239.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sc&lt;sup&gt;3+&lt;/sup&gt;P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060981 | R061040</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kolbeckite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kolbeckite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Edelmann F (1926) Kolbeckit, ein neues sächsisches Mineral, Jahrbuch für das Berg-und Hüttenwesen im Sachsen 100, 73-74</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Phosphosiderite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CD.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With only medium-sized cations, RO4:H2O = 1:2</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Kolbeckite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1926</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/camerolaite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Camérolaite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Al | O | H | Sb | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic, monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">chalcoalumite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/camerolaite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;6&lt;/sub&gt;Al&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;18&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;2&lt;/sub&gt;[Sb(OH)&lt;sub&gt;6&lt;/sub&gt;](SO&lt;sub&gt;4&lt;/sub&gt;)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1990-036</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Renamed|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-872</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:872:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-872.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;Al&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;18&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;2&lt;/sub&gt;[Sb&lt;sup&gt;5+&lt;/sup&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;](S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Camérolaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Camerolaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Sarp H, Perroud P (1991) Camerolaite, Cu&lt;sub&gt;4&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;[HSbO&lt;sub&gt;4&lt;/sub&gt;,SO&lt;sub&gt;4&lt;/sub&gt;](OH)&lt;sub&gt;10&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)·2H&lt;sub&gt;2&lt;/sub&gt;O, a new mineral from Cap Garonne mine, Var, France, Neues Jahrbuch für Mineralogie, Monatshefte 1991, 481-486 Chemical formula revised from Cu&lt;sub&gt;4&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;[HSbO&lt;sub&gt;4&lt;/sub&gt;,SO&lt;sub&gt;4&lt;/sub&gt;](OH)&lt;sub&gt;10&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)·2H&lt;sub&gt;2&lt;/sub&gt;O: Mills S J, Christy A G, Schnyder C, Favreau G, Price J R (2014) The crystal structure of camerolaite and structural variation in the cyanotrichite family of merotypes. Mineralogical Magazine 78, 1527-1552 Spelling of name changed from camerolaite to camérolaite: Hålenius U, Hatert F, Pasero M, Mills S J (2015) IMA Commission on New Minerals, Nomenclature and Classification (CNMNC) Newsletter 28. New minerals and nomenclature modifications approved in 2015. Mineralogical Magazine 79, 1859-1864</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Cyanotrichite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.DE.75</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With only medium-sized cations; unclassified</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Camerolaite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1990-036</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/cannizzarite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cannizzarite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Bi | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/cannizzarite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;8&lt;/sub&gt;Bi&lt;sub&gt;10&lt;/sub&gt;S&lt;sub&gt;23&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Octalead decabismuth tricosasulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-883</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:883:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-883.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;8&lt;/sub&gt;Bi&lt;sub&gt;10&lt;/sub&gt;S&lt;sub&gt;23&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060609</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cannizzarite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cannizzarite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Zambonini F, de Fiore O, Carobbi G (1924) Su un solfobismutito di piombo di Vulcano (Isole Eolie), Annali dell'Osservatorio Vesuviano 1, 31-36 Discredited as being bismuthinite or galenobismutite: Wolfe C W (1938) Cannizzarite and bismuthinite from Vulcano, American Mineralogist 23, 790-798 Redefined: Graham A R, Thompson R M, Berry L G (1953) Studies on mineral sulpho-salts: XVII - Cannizzarite, American Mineralogist 38, 536-544 Chemical formula revised: Matzat E (1979) Cannizzarite, Acta Crystallographica B35, 133-136 Chemical formula revised again: Mozgova N N, Kuzmina O V, Organova N I, Laputina I P, Borodaev Y S, Fornaseri M (1985) New data on sulphosalt assemblages at Vulcano (Italy), Rendiconti della Società Italiana di Mineralogia e Petrologia 40, 277-283</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.JB.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">PbS type sulfosalt with Pb</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Cannizzarite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1924</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kinoite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kinoite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Cu | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/kinoite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Cu&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1969-037</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2213</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2213:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2213.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R040155 | R050168</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kinoite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kinoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Anthony J W, Laughon R B (1970) Kinoite, a new hydrous copper calcium silicate mineral from Arizona, American Mineralogist 55, 709-715</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.BH.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate with Si3O10, Si4O11, etc. anions; cations in tetrahedral [4] and greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Kinoite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1969-037</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/aragonite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Aragonite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | C | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">aragonite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/aragonite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca(CO&lt;sub&gt;3&lt;/sub&gt;)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Calcium carbonate</gsmin:iupacchemname>
    <gsmin:mindatid>min-307</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:307:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-307.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaCO&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R040078 | R060195 | R080142 | R150021</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Aragonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Aragonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mineral known earlier, but named arragonischer apatit by Werner: Werner A G (1788) Geschichte, Karakteristik, und kurze chemische Untersuchung des Apatits. IV. Kurze Nachricht von den sogenannten arragonischen Apatiten, Bergmannisches Journal 1, 76-96 Renamed arragonite: Hauy C (1791) Sur l'arragonite de Werner, Bulletin des Science, par la Société Philomathique 2, 67-68</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Aragonite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>05.AB.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate without additional anions, without H2O, Alkali-earth (and other M2+) carbonates</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Aragonite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1788</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kolitschite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kolitschite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Zn | Fe | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb[Zn&lt;sub&gt;0.5&lt;/sub&gt;,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;&lt;sub&gt;0.5&lt;/sub&gt;]Fe&lt;sub&gt;3&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2008-063</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-38994</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:38994:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-38994.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;[Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;0.5&lt;/sub&gt;&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;&lt;sub&gt;0.5&lt;/sub&gt;]Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kolitschite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kolitschite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mills S J, Grey I E, Mumme W G, Miyawaki R, Matsubara S, Bordet P, Birch W D, Raudsepp M (2008) Kolitschite, Pb[Zn0.5, 0.5]Fe3(AsO4)2(OH)6, a new mineral from the Kintore opencut, Broken Hill, New South Wales, Australian Journal of Mineralogy 14, 63-67</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Alunite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BM.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH, etc.):RO4 = 4:1</gsmin:strunzlabel>
    <gsmin:wikipediadate>2008-063</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/alumovesuvianite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Alumovesuvianite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Al | Mg | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;19&lt;/sub&gt;Al(Al&lt;sub&gt;10&lt;/sub&gt;Mg&lt;sub&gt;2&lt;/sub&gt;)Si&lt;sub&gt;18&lt;/sub&gt;O&lt;sub&gt;69&lt;/sub&gt;(OH)&lt;sub&gt;9&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2016-014</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;19&lt;/sub&gt;Al(Al&lt;sub&gt;10&lt;/sub&gt;Mg&lt;sub&gt;2&lt;/sub&gt;)Si&lt;sub&gt;18&lt;/sub&gt;O&lt;sub&gt;69&lt;/sub&gt;(OH)&lt;sub&gt;9&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Alumovesuvianite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Alumovesuvianite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Panikorovskii T L, Chukanov N V, Aksenov S M, Mazur A S, Avdontseva E Y, Shilovskikh V V, Krivovichev S V (2017) Alumovesuvianite, Ca_19_Al(Al,Mg)_12_Si_18_O_69_(OH)_9_, a new vesuvianite-group member from the Jeffrey mine, Asbestos, Estrie region, Québec. Mineralogy and Petrology 6, 833-842</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Vesuvianite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/thorosteenstrupine">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Thorosteenstrupine</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Th | Mn | Si | O | F | H</gsmin:chemistryelements>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/thorosteenstrupine.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Th,Mn)&lt;sub&gt;3&lt;/sub&gt;Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;11&lt;/sub&gt;F·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3949</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3949:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3949.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Th&lt;sup&gt;4+&lt;/sup&gt;,Mn&lt;sup&gt;2+&lt;/sup&gt;,Mn&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;3&lt;/sub&gt;Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;11&lt;/sub&gt;F·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Thorosteenstrupine</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Thorosteenstrupine</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kupriyanova I I, Stolyarova T I, Sidorenko G A (1962) A new thorium silicate - thorosteenstrupine, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 91, 325-330</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.CK.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si6O18]12- 6-membered single rings, with insular complex anions</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Thorosteenstrupine.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1962</gsmin:wikipediadate>
  </rdf:Description>
