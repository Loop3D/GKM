  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/sveinbergeite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Sveinbergeite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Fe | Ti | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca(Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;)Ti&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;5&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2010-027</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-40285</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:40285:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-40285.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;2&lt;/sub&gt;[Ca(H&lt;sub&gt;2&lt;/sub&gt;O)](Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;)Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;[OH(H&lt;sub&gt;2&lt;/sub&gt;O)]</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sveinbergeite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Sveinbergeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Khomyakov A P, Cámara F, Sokolova E, Abdu Y, Hawthorne F C (2011) Sveinbergeite, Ca(Fe^2+^_6_Fe^3+^)Ti_2_(Si_4_O_12_)_2_O_2_(OH)_5_(H_2_O)_4_, a new astrophyllite-group mineral from the Larvik Plutonic Complex, Oslo Region, Norway: description and crystal structure, Mineralogical Magazine 75, 2687-2702</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Astrophyllite-Devitoite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DC.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with branched 2-periodic single chains; Si2O6 + 2SiO3 Si4O12</gsmin:strunzlabel>
    <gsmin:wikipediadate>2010-027</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/tungstibite">
