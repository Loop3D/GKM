  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/nahpoite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Nahpoite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/nahpoite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;3&lt;/sub&gt;OH)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1981-002</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Disodium hydrogen phosphate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2832</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2832:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2832.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;3&lt;/sub&gt;OH)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nahpoite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Nahpoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Coleman L C, Robertson B T (1981) Nahpoite Na2HPO4, a new mineral from the Big Fish River area, Yukon Territory, The Canadian Mineralogist 19, 373-376 Fleischer M, Chao G Y, Mandarino J A (1982) New mineral names, American Mineralogist 67, 854-860</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.AD.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, without H2O, With only large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Nahpoite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1981-002</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/freedite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Freedite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Pb | As | O | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/freedite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;1+&lt;/sup&gt;Pb&lt;sub&gt;8&lt;/sub&gt;(As&lt;sup&gt;3+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;3&lt;/sub&gt;Cl&lt;sub&gt;5&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1984-012</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: CopperI octalead diarseniteIII trioxy pentachloride</gsmin:iupacchemname>
    <gsmin:mindatid>min-1604</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1604:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1604.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;1+&lt;/sup&gt;Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;8&lt;/sub&gt;(As&lt;sup&gt;3+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;3&lt;/sub&gt;Cl&lt;sub&gt;5&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Freedite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Freedite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Dunn P J, Rouse R C (1985) Freedite and thorikosite from Långban, Sweden, and Laurion, Greece: two new species related to the synthetic bismuth oxyhalides, American Mineralogist 70, 845-848 Chemical formula is revised: Pertilik F (1987) The structure of freedite, Pb_8_Cu(AsO_3_)_2_O_3_Cl_5_. Mineralogy and Petrology 36, 85-92</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.JB.65</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Arsenite, antimonite, bismuthite; with additional anions, without H2O</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Freedite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1984-012</gsmin:wikipediadate>
  </rdf:Description>
