  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/tantalcarbide">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Tantalcarbide</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ta | C</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">tantalcarbide</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/tantalcarbide.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">TaC</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Tantalum carbide</gsmin:iupacchemname>
    <gsmin:mindatid>min-7327</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7327:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7327.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">TaC</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tantalcarbide</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tantalcarbide</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Reported the discovery of native tantalum: Walther P (1909) A new mineral from a gold-washing locality in the Ural Mountains, Nature 81, 335-335 Showed that the previously reported native tantalum was actually tantalum carbide: Frondel C (1962) Non-existence of native tantalum, American Mineralogist 47, 786-787 Removed uncertainty about the status of the mineral: Novgorodova M I, Generalov M E, Trubkin N V (1997) The new TaC-NbC isomorphic row and niobocarbide – a new mineral from platinum placers of the Urals, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 126, issue 1, 76-95</gsmin:statusnotes>
    <gsmin:strunzcodeV10>01.BA.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbides</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Tantalcarbide.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1909</gsmin:wikipediadate>
  </rdf:Description>
