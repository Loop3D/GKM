    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-674</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:674:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-674.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070588 | R070624</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Billietite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Billietite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Vaes J F (1947) Six nouveaux minéraux d'urane provenant de Shinkolobwe (Katanga), Annales de la Société Géologique de Belgique 70, 212-225 Chemical formula redefined: Finch R L, Burns P C, Hawthorne F C, Ewing R C (2006) Refinement of the crystal structure of billietite, Ba[(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;](H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;8&lt;/sub&gt;, The Canadian Mineralogist 44, 1197-1205</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.GB.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl hydroxide, With additional cations (K, Ca, Ba, Pb, etc.); with mainly UO2(O,OH)5 pentagonal polyhedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Billietite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1947</gsmin:wikipediadate>
  </rdf:Description>
