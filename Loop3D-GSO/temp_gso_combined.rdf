    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Balkanite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Balkanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Atanassov V A, Kirov G N (1973) Balkanite, Cu&lt;sub&gt;9&lt;/sub&gt;Ag&lt;sub&gt;5&lt;/sub&gt;HgS&lt;sub&gt;8&lt;/sub&gt;, a new mineral from the Sedmochislenitsi mine, Bulgaria, American Mineralogist 58, 11-15</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.BD.15</gsmin:strunzcodeV10>
