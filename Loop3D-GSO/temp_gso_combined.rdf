  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Deposition_Hiatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Pause in a process of sediment accumulation. Use to indicate paraconformable boundaries.</rdfs:comment>
    <rdfs:label xml:lang="en">Deposition Hiatus </rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Pause"/>
    <rdfs:subClassOf rdf:nodeID="n2ea68da2033446efa375a7e6e2114b9ab1"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologiccontact/Paraconformable_Contact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf, K.K.E, Mehl, J.P. &amp; Jackson, J.A. (eds), 2005. Glossary of geology, 5th Edition. American Geological Institute, Alexandria, 779 p.</dct:source>
    <rdfs:comment xml:lang="en">An unconformable contact between two geological units in which the bedding of the older, underlying unit is parallel to the bedding of the younger, overlying unit, in which the contact between the two units is planar, and may be coincident with a bedding plane.</rdfs:comment>
    <rdfs:label xml:lang="en">paraconformable contact</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologiccontact/Unconformable_Contact"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/Process">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A event is the thing that happens (an earthquake), and a process is how it happens (the ground shaking). Events are constituted by processes.</rdfs:comment>
    <rdfs:label xml:lang="en">Process</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Perdurant"/>
    <rdfs:subClassOf rdf:nodeID="n7bda25761fc44f8595ef751309700190b290"/>
