  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/podlesnoite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Podlesnoite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Ba | C | O | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Ba(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;F&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2006-033</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Barium dicalcium dicarbonate difluoride</gsmin:iupacchemname>
    <gsmin:mindatid>min-30907</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:30907:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-30907.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaCa&lt;sub&gt;2&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;F&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Podlesnoite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Podlesnoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pekov I V, Zubkova N V, Chukanov N V, Pushcharovsky D Y, Kononkova N N, Zadov A E (2008) Podlesnoite BaCa2(CO3)2F2 a new mineral species from the Kirovskii mine, Khibiny, Kola Peninsula, Russia, The Mineralogical Record 39, 137-148</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.BC.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions, without H2O, With alkali-earth cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Podlesnoite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2006-033</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/sternbergite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
