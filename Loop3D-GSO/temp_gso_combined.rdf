    <gsmin:rruffnameplain xml:lang="en">Yingjiangite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chen Z, Huang Y, Gu X (1990) A new uranium mineral - yingjiangite, Acta Mineralogica Sinica 10, 102-105 Chemical formula revised from (K_0.65_Ca_0.35_)(UO_2_)_3_(PO_4_)_2_(OH)_1.35_·4H_2_O: Zhang J, Wan A, Gong W (1992) New data on yingjiangite. Acta Petrologica et Mineralogica 11, 178-184</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Phosphuranylite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.EC.10</gsmin:strunzcodeV10>
