    <gsmin:rruffids>R060384</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Otwayite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Otwayite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Nickel E H, Robinson B W, Davis C E S (1977) Otwayite, a new nickel mineral from Western Australia, American Mineralogist 62, 999-1002</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.DA.15</gsmin:strunzcodeV10>
