    <gsmin:wikipediadate>1962</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/quadridavyne">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Quadridavyne</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Si | Al | O | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">cancrinite-sodalite-cancrinite subgroup</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/quadridavyne.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">[(Na,K)&lt;sub&gt;6&lt;/sub&gt;Cl&lt;sub&gt;2&lt;/sub&gt;][Ca&lt;sub&gt;2&lt;/sub&gt;Cl&lt;sub&gt;2&lt;/sub&gt;][(Si&lt;sub&gt;6&lt;/sub&gt;Al&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;)]</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1990-054</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3335</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3335:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3335.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;6&lt;/sub&gt;Ca&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;6&lt;/sub&gt;Al&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;Cl&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R141084</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Quadridavyne</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Quadridavyne</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Bonaccorsi E, Merlino S, Orlandi P, Pasero M, Vezzalini G (1994) Quadridavyne, [(Na,K)6Cl2][Ca2Cl2][Si6Al6O24], a new feldspathoid mineral from Vesuvius area, European Journal of Mineralogy 6, 481-487 Jambor J L, Kovalenker V A, Roberts A C (1995) New mineral names, American Mineralogist 80, 630-635</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Cancrinite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.FB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Tektosilicate with additional anions</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Quadridavyne.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1990-054</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/armenite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Armenite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ba | Ca | Al | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">milarite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/armenite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaCa&lt;sub&gt;2&lt;/sub&gt;(Al&lt;sub&gt;6&lt;/sub&gt;Si&lt;sub&gt;9&lt;/sub&gt;)O&lt;sub&gt;30&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-343</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:343:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-343.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaCa&lt;sub&gt;2&lt;/sub&gt;(Al&lt;sub&gt;6&lt;/sub&gt;Si&lt;sub&gt;9&lt;/sub&gt;)O&lt;sub&gt;30&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Armenite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Armenite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Neumann H (1939) Armenite, a new mineral. Preliminary note, Norsk Geologisk Tidsskrift 19, 312-313 Chemical formula revised: Neumann H (1941) Armenite, a water-bearing barium-calcium-alumosilicate. Norsk Geologisk Tidsskrift, 21, 19-24</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Milarite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CM.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si6O18]12- 6-membered double rings (sechser-Doppelringe)</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Armenite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1939</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/castellaroite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Castellaroite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·4.5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2015-071</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·4.5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Castellaroite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Castellaroite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf A R, Cámara F, Ciriotti M E, Nash B P, Balestra C, Chiappino L (2016) Castellaroite, Mn^2+^_3_(AsO_4_)_2_·4.5H_2_O, a new mineral from Italy related to metaswitzerite. European Journal of Mineralogy 28, 687-696</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicquality/Low_Metamorphic_Grade">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Smulikowski et al, 2003; Fry, 1984</dct:source>
    <rdfs:comment xml:lang="en">Metamorphic effects clearly visible, protolith structures typically still observable, includes rocks metamorphosed in greenschisthigh-temperature blueschist, very low temperature eclogite facies. Mineral assemblages according to Fry (1984) Table 10-1: ultramafic-serpentine (talc, magnesite),  mafic-chlorite, actinolite (garnet), calc-aluminous basic-albite, epidote, pelite, semi-pelite -- white mica, chlorite, quartz, biotite (garnet, Al-minerals).</rdfs:comment>
    <rdfs:label xml:lang="en">low metamorphic grade</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicquality/Metamorphosed"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologiccontact/Mineralisation_Assemblage_Contact">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI contacttype SKOS vocabulary 2012-11-24</dct:source>
    <rdfs:comment xml:lang="en">A metasomatic facies contact separating rocks which have been mineralised and contain a particular mineral assemblage from those which contain a different assemblage. Mineralization is a kind of metasomatism that introduces ecomomically important minerals.</rdfs:comment>
    <rdfs:label xml:lang="en">mineralisation assemblage contact</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologiccontact/Metamorphic_Contact"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologictime/BaseFortunian">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Boundary"/>
    <gsoc:timeEquivalentTo rdf:resource="https://w3id.org/gso/1.0/geologictime/BasePhanerozoic"/>
    <rdfs:label xml:lang="en">shared boundary with BasePhanerozoic</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/cesarolite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cesàrolite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Mn | O | H</gsmin:chemistryelements>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/cesarolite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">PbMn&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Lead trimanganeseIV hexaoxide dihydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-939</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:939:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-939.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">PbMn&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cesàrolite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cesarolite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Buttgenbach H, Gillet C (1920) La cesàrolite (nouvelle espèce minérale), Annales de la Société Géologique de Belgique 43, 239-241</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.FG.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Hydroxide (without V or U), with OH, without H2O; unclassified</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Cesarolite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1920</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/fluorvesuvianite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Fluorvesuvianite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Al | Mg | Si | O | F | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">vesuvianite</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;19&lt;/sub&gt;(Al,Mg)&lt;sub&gt;13&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;10&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;O(F,OH)&lt;sub&gt;9&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2000-037</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-25683</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:25683:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-25683.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;19&lt;/sub&gt;(Al,Mg)&lt;sub&gt;13&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;10&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;O(F,OH)&lt;sub&gt;9&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fluorvesuvianite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Fluorvesuvianite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Britvin S N, Antonov A A, Krivovichev S V, Armbruster T, Burns P C, Chukanov N V (2003) Fluorvesuvianite, Ca_19_(Al,Mg,Fe^2+^)_13_[SiO_4_]_10_[Si_2_O_7_]_4_O(F,OH)_9_, a new mineral species from Pitkäranta, Karelia, Russia: description and crystal structure, The Canadian Mineralogist 41, 1371-1380</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Vesuvianite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.BG.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate with mixed SiO4 and Si2O7 groups; cations in octahedral [6] and greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Fluorvesuvianite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2000-037</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseUpperPennsylvanianSP2004">
