    <gsmin:mindaturl>http://www.mindat.org/min-39212.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Na)&lt;sub&gt;2&lt;/sub&gt;(Al,Mg,Fe&lt;sup&gt;2+&lt;/sup&gt;)(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)</gsmin:rruffchemistry>
