    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Phaneritic crystalline rock consisting of intermediate plagioclase, commonly with hornblende and often with biotite or augite; colour index M less than 90, sodic plagioclase (An0-An50), no feldspathoid, and between 0 and 5 percent quartz. Includes rocks defined modally in QAPF field 10 as diorite.</rdfs:comment>
    <rdfs:label xml:lang="en">diorite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Dioritic_Rock"/>
  </rdf:Description>
