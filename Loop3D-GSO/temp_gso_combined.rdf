    <gsmin:rruffnameplain xml:lang="en">Manganarsite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Peacor D R, Dunn P J, Simmons W B, Wicks F J (1986) Arsenites related to layer silicates: manganarsite, the arsenite analogue of manganpyrosmalite, and unnamed analogues of friedelite and schallerite from Långban, Sweden, American Mineralogist 71, 1517-1521</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.JB.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Arsenite, antimonite, bismuthite; with additional anions, without H2O</gsmin:strunzlabel>
