    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">C&lt;sub&gt;2&lt;/sub&gt;H&lt;sub&gt;17&lt;/sub&gt;O&lt;sub&gt;5&lt;/sub&gt;·Si&lt;sub&gt;46&lt;/sub&gt;O&lt;sub&gt;92&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:mindatid>min-2630</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2630:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2630.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">C&lt;sub&gt;2&lt;/sub&gt;H&lt;sub&gt;17&lt;/sub&gt;O&lt;sub&gt;5&lt;/sub&gt;·Si&lt;sub&gt;46&lt;/sub&gt;O&lt;sub&gt;92&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060863 | R110071</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Melanophlogite</gsmin:rruffnamehtml>
