    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dipalladium arsenide</gsmin:iupacchemname>
    <gsmin:mindatid>min-3068</gsmin:mindatid>
