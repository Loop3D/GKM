    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Oxo-magnesio-hastingsite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Oxo-magnesio-hastingsite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Zaitsev A N, Avdontseva E Y, Britvin S N, Demény A, Homonnay Z, Jeffries T E, Keller J, Krivovichev V G, Markl G, Platonova N V, Siidra O I, Spratt J, Vennemann T (2013) Oxo-magnesio-hastingsite, NaCa_2_(Mg_2_Fe^3+^_3_)(Si_6_Al_2_)O_22_O_2_, a new anhydrous amphibole from the Deeti volcanic cone, Gregory rift, northern Tanzania. Mineralogical Magazine 77, 2773-2792</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Amphibole</gsmin:structuralgroup>
  </rdf:Description>
