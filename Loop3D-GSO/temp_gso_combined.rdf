    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hansblockite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hansblockite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Förster H J, Bindi L, Stanley C J, Grundmann G (2017) Hansblockite, (Cu,Hg)(Bi,Pb)Se_2_, the monoclinic polymorph of grundmannite: a new mineral from the Se mineralization at El Dragón (Bolivia). Mineralogical Magazine 81, 629-640</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/friedelite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
