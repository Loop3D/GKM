    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sub&gt;4&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;12&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1992-026</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Tetramanganese dialuminium dodecahydroxyl carbonate trihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-7582</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7582:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7582.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;12&lt;/sub&gt;CO&lt;sub&gt;3&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Charmarite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Charmarite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chao G Y, Gault R A (1997) Quintinite-2H, quintinite-3T, charmarite-2H, charmarite-3T and caresite-3T, a new group of carbonate minerals related to the hydrotalcite - manasseite group, The Canadian Mineralogist 35, 1541-1549</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hydrotalcite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>05.DA.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions and H2O, With medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Charmarite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1992-026</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/gatehouseite">
