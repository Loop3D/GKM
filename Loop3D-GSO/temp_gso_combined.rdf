  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kurnakovite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kurnakovite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mg | B | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/kurnakovite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">MgB&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;5&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2295</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2295:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2295.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">MgB&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;5&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R050105 | R050393</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kurnakovite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kurnakovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Godlevsky M N (1940) Kurnakovite, a new borate, Comptes Rendus (Doklady) de l’Académie des Sciences de l’URSS 28, 638-640</gsmin:statusnotes>
    <gsmin:strunzcodeV10>06.CA.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Neso-triborate</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Kurnakovite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1940</gsmin:wikipediadate>
