    <gsmin:statusnotes xml:lang="en">Redefined: Skinner B J, Appleman D E (1963) Melanophlogite, a cubic polymorph of silica, American Mineralogist 48, 854-867</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.DA.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With small cations: Silica family</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Melanophlogite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1963</gsmin:wikipediadate>
