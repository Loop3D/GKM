  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/oyonite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Oyonite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ag | Mn | Pb | Sb | As | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ag&lt;sub&gt;3&lt;/sub&gt;Mn&lt;sub&gt;2&lt;/sub&gt;Pb&lt;sub&gt;4&lt;/sub&gt;Sb&lt;sub&gt;7&lt;/sub&gt;As&lt;sub&gt;4&lt;/sub&gt;S&lt;sub&gt;24&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2018-002</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ag&lt;sub&gt;3&lt;/sub&gt;Mn&lt;sub&gt;2&lt;/sub&gt;Pb&lt;sub&gt;4&lt;/sub&gt;Sb&lt;sub&gt;7&lt;/sub&gt;As&lt;sub&gt;4&lt;/sub&gt;S&lt;sub&gt;24&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Oyonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Oyonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Bindi L, Biagioni C, Keutsch F N (2018) Oyonite, Ag_3_Mn_2_Pb_4_Sb_7_As_4_S_24_, a new member of the lillianite homologous series from the Uchucchacua base-metal deposit, Oyon district, Peru. Minerals 8, 192</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Lillianite</gsmin:structuralgroup>
  </rdf:Description>
