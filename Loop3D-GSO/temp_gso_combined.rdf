  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/jagoite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Jagoite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Fe | Si | O | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/jagoite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;18&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;[Si&lt;sub&gt;4&lt;/sub&gt;(Si,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;6&lt;/sub&gt;][Pb&lt;sub&gt;4&lt;/sub&gt;Si&lt;sub&gt;16&lt;/sub&gt;(Si,Fe)&lt;sub&gt;4&lt;/sub&gt;]O&lt;sub&gt;82&lt;/sub&gt;Cl&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2064</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2064:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2064.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;9&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;[Si&lt;sub&gt;2&lt;/sub&gt;(Si,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;3&lt;/sub&gt;][Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;8&lt;/sub&gt;(Si,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;]O&lt;sub&gt;41&lt;/sub&gt;Cl&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R090028</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Jagoite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Jagoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Blix R, Gabrielson O, Wickman F E (1957) Jagoite, a new lead-silicate mineral from Langban in Sweden, Arkiv för Mineralogi och Geologi 2, 315-317 Chemical formula changed from (Pb,Ca,Mn,Na,K)_24_(Fe^3+^,Al,Mg)_8_(Si,Al,Be)_27_O_84_(OH,Cl)_8_: Mellini M, Merlino S (1981) The crystal structure of jagoite, American Mineralogist 66, 852-858</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.EG.50</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate: Double nets with 6-membered and larger rings</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Jagoite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1957</gsmin:wikipediadate>
  </rdf:Description>
