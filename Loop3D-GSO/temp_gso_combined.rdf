    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;0.3&lt;/sub&gt;Mg&lt;sub&gt;8&lt;/sub&gt;Al(Si,Al)&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;20&lt;/sub&gt;(OH)&lt;sub&gt;10&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1980-031</gsmin:imanumber>
