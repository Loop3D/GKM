  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/fiedlerite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Fiedlerite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Cl | F | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic, monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/fiedlerite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;3&lt;/sub&gt;Cl&lt;sub&gt;4&lt;/sub&gt;F(OH)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Trilead tetrachloride fluoride hydroxyl monohydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1547</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1547:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1547.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Cl&lt;sub&gt;4&lt;/sub&gt;F(OH)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060859</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fiedlerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Fiedlerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">vom Rath G (1887) Einige mineralogische und geologische Mittheilungen, Niederheinische Gesellschafte für Natur und Theilkunde, Bonn 102, 149-154 Chemical formula revised: Merlino S, Pasero M, Perchiazzi N (1994) Fiedlerite: revised chemical formula [Pb_3_Cl_4_F(OH)·H_2_O], OD description and crystal structure refinement of the two MDO polytypes, Mineralogical Magazine 58, 69-77</gsmin:statusnotes>
    <gsmin:strunzcodeV10>03.DC.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Double-, Oxy- or Hydroxy-  halide with Pb (As,Sb,Bi), without Cu</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Fiedlerite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1887</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfault/High_Angle_Reverse_Fault">
