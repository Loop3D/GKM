    <gsmin:rruffnameplain xml:lang="en">Olgite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Khomyakov A P, Semenov Y I, Shumyatskaya N G, Timoshenkov I M, Laputina I P, Smol'yaninova N N (1980) Olgite Na(Sr,Ba)PO_4_ - a new mineral, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 109, 347-351</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Aphthitalite</gsmin:structuralgroup>
