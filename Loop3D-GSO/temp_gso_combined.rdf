    <gsmin:imanumber xml:lang="en">IMA2014-039</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba&lt;sub&gt;44&lt;/sub&gt;Si&lt;sub&gt;66&lt;/sub&gt;Al&lt;sub&gt;30&lt;/sub&gt;O&lt;sub&gt;192&lt;/sub&gt;Cl&lt;sub&gt;25&lt;/sub&gt;(OH)&lt;sub&gt;33&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R170045</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Meierite</gsmin:rruffnamehtml>
