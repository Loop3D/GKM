    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A plagioclase feldspar with an albite : anorthite molar ratio ranging from 50 : 50 to 70 : 30. </rdfs:comment>
    <rdfs:label xml:lang="en">Andesine</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/mineral/plagioclase"/>
    <gsmin:mindatid>min-220</gsmin:mindatid>
  </rdf:Description>
