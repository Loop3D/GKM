    <gsmin:mindaturl>http://www.mindat.org/min-1366.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;6&lt;/sub&gt;(Mg,Ti&lt;sup&gt;4+&lt;/sup&gt;,Zr&lt;sup&gt;4+&lt;/sup&gt;,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)&lt;sub&gt;2&lt;/sub&gt;(Al,Mg)&lt;sub&gt;6&lt;/sub&gt;Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;28&lt;/sub&gt;(OH)&lt;sub&gt;10&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070395</gsmin:rruffids>
