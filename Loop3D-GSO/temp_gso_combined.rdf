    <gsmin:rruffnameplain xml:lang="en">Arsenbrackebuschite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Abraham K, Kautz K, Tillmanns E, Walenta K (1978) Arsenbrackebuschite, Pb&lt;sub&gt;2&lt;/sub&gt;(Fe,Zn)(OH,H&lt;sub&gt;2&lt;/sub&gt;O)[AsO&lt;sub&gt;4&lt;/sub&gt;]&lt;sub&gt;2&lt;/sub&gt;, a new arsenate mineral, Neues Jahrbuch für Mineralogie, Monatshefte 1978, 193-196</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Brackebuschite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BG.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH, etc.):RO4 = 0.5:1</gsmin:strunzlabel>
