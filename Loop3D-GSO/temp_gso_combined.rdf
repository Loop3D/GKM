    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7117:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7117.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;8&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)(OH)&lt;sub&gt;14&lt;/sub&gt;·13H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
