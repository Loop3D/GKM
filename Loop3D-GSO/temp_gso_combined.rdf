    <gsmin:mindaturl>http://www.mindat.org/min-922.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Yb,Er)&lt;sub&gt;4&lt;/sub&gt;Y&lt;sub&gt;4&lt;/sub&gt;Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;20&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;(OH)·7H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R080143</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Caysichite-(Y)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Caysichite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hogarth D D, Chao G Y, Plant A G, Steacy H R (1974) Caysichite, a new silico-carbonate of yttrium and calcium, The Canadian Mineralogist 12, 293-298 Name changed from caysichite: Nickel E H, Mandarino J A (1987) Procedures involving the IMA Commission on New Minerals and Mineral Names and guidelines on mineral nomenclature, American Mineralogist 72, 1031-1042</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.DJ.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 4-periodic double and triple chains</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Caysichite-%28Y%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1973-044</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/lavinskyite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
