  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Magmatic_Cystallisation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf, K.K.E, Mehl, J.P. &amp; Jackson, J.A. (eds), 2005. Glossary of geology, 5th Edition. American Geological Institute, Alexandria, 779 p.</dct:source>
    <rdfs:comment xml:lang="en">The process by which matter becomes crystalline, from a gaseous, fluid, or dispersed state</rdfs:comment>
    <rdfs:label xml:lang="en">magmatic crystallisation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicprocess/Magmatic_Process"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicprocess/Rock_Forming_Process"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Transformation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicrole/Crystal_Role">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">constituent formed by crystallization from melt or by metamorphic processes. Distinct from constituent roles related to clastic processes, or diagenetic processes.</rdfs:comment>
    <rdfs:label xml:lang="en">Crystal Constituent</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Role"/>
