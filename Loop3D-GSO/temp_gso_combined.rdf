  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/maghagendorfite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Maghagendorfite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Mg | Mn | Fe | P | O</gsmin:chemistryelements>
    <gsmin:fleischersgroup xml:lang="en">alluaudite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/maghagendorfite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)MgMn&lt;sup&gt;2+&lt;/sup&gt;(Fe&lt;sup&gt;2+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2532</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2532:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2532.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)MgMn&lt;sup&gt;2+&lt;/sup&gt;(Fe&lt;sup&gt;2+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Maghagendorfite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Maghagendorfite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Moore P B, Ito J (1979) Alluaudites, wyllieites, arrojadites: crystal chemistry and nomenclature, Mineralogical Magazine 43, 227-235</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Alluaudite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.AC.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, without H2O, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Maghagendorfite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1979</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/protasite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Protasite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ba | U | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/protasite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1984-001</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3289</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3289:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3289.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Protasite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Protasite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pagoaga M K, Appleman D E, Stewart J M (1986) A new barium uranyl oxide hydrate mineral, protasite, Mineralogical Magazine 50, 125-128 Hawthorne F C, Bladh K W, Burke E A J, Grew E S, Langley R H, Puciewicz J, Roberts A C, Schedler R A, Vanko D A (1987) New mineral names, American Mineralogist 72, 222-230</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.GB.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl hydroxide, With additional cations (K, Ca, Ba, Pb, etc.); with mainly UO2(O,OH)5 pentagonal polyhedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Protasite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1984-001</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/granularmaterial/Cognate_Volcanic_Particle_Material">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Base on Gillespie and Styles, 1999</dct:source>
    <rdfs:comment xml:lang="en">Granular material consisting of fragments of rock formed during earlier (related) volcanic activity that have been ejected with other pyroclastic debris during a later eruption.</rdfs:comment>
    <rdfs:label xml:lang="en">cognate volcanic particle material</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/granularmaterial/Pyroclastic_Particle_Material"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/bideauxite">
