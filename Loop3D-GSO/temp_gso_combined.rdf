  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Alkali_Feldspar_Syenite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Alkali feldspar syenitic rock that contains 0-5 percent quartz and no feldspathoid in the QAPF fraction. QAPF field 6.</rdfs:comment>
    <rdfs:label xml:lang="en">alkali feldspar syenite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Alkali_Feldspar_Syenitic_Rock"/>
  </rdf:Description>
