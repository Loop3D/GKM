    <gsmin:imanumber xml:lang="en">IMA1978-015</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Hexacopper aluminium triarsenate hexahydroxyl trihydrate</gsmin:iupacchemname>
