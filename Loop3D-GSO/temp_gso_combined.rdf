  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/satterlyite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Satterlyite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Fe | Mg | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/satterlyite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Fe&lt;sup&gt;2+&lt;/sup&gt;,Mg,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;12&lt;/sub&gt;(PO&lt;sub&gt;3&lt;/sub&gt;OH)(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;5&lt;/sub&gt;(OH,O)&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1976-056</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3543</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3543:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3543.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Fe&lt;sup&gt;2+&lt;/sup&gt;,Mg,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;12&lt;/sub&gt;(PO&lt;sub&gt;3&lt;/sub&gt;OH)(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;5&lt;/sub&gt;(OH,O)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060810</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Satterlyite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Satterlyite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mandarino J A, Sturman B D, Corlett M I (1978) Satterlyite, a new hydroxyl-bearing ferrous phosphate from the Big Fish River area, Yukon Territory, The Canadian Mineralogist 16, 411-413 Chemical formula redefined: Kolitsch U, Andrut M, Giester G (2002) Satterlyite, (Fe,Mg)12(PO3OH)(PO4)5(OH,O)6: crystal structure and infrared absorption spectra, European Journal of Mineralogy 14, 127-133</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.BB.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With only medium-sized cations, (OH, etc.):RO4 about 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Satterlyite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1976-056</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/elyite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Elyite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Pb | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/elyite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CuPb&lt;sub&gt;4&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)O&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1971-043</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1371</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1371:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1371.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)O&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R090024 | R130277</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Elyite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Elyite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Williams S A (1972) Elyite, basic lead-copper sulfate, a new mineral from Nevada, American Mineralogist 57, 364-367</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.DF.65</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With large and medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Elyite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1971-043</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicrole/Hydrothermal_Vein">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al 2005, CGI GTWG vocabulary</dct:source>
    <rdfs:comment xml:lang="en">A tabular or sheet-like part of a compound material formed by hydrothermal (or other metasomatic) mineral filling a fracture, may be associated with replacement of the host rock adjacent to the body</rdfs:comment>
