    <gsmin:imanumber xml:lang="en">IMA1988-017</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Hexalead monosulfate decafluorid</gsmin:iupacchemname>
    <gsmin:mindatid>min-3298</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3298:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3298.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;6&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)F&lt;sub&gt;10&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R100006</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pseudograndreefite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Pseudograndreefite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf A R, Dunn P J, Foord E E (1989) Grandreefite, pseudograndreefite, laurelite, and aravaipaite: Four new minerals from the Grand Reef mine, Graham County, Arizona, American Mineralogist 74, 927-933</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.BD.65</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions, without H2O, With only large cations</gsmin:strunzlabel>
