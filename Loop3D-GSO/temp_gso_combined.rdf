  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/pyrophanite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Pyrophanite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | Ti | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">ilmenite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/pyrophanite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;TiO&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3322</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3322:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3322.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070211</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pyrophanite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Pyrophanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hamberg A (1890) Mineralogische studien. 10. Über pyrophanit, eine mit dem titaneisen isomorphe verbindung der zusammensetzung MnTiO3, von Harstigen, Geologiska Föreningens i Stockholm Förhandlingar 12, 567-637</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Corundum</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.CB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 2: 3,3: 5, and similar, With medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Pyrophanite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1890</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/chirvinskyite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Chirvinskyite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Fe | Mn | Ti | Zr | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,Ca)&lt;sub&gt;13&lt;/sub&gt;(Fe,Mn,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)&lt;sub&gt;2&lt;/sub&gt;(Ti,Zr)&lt;sub&gt;5&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH,O)&lt;sub&gt;12&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2016-051</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,Ca)&lt;sub&gt;13&lt;/sub&gt;(Fe,Mn,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)&lt;sub&gt;2&lt;/sub&gt;(Ti,Zr)&lt;sub&gt;5&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH,O)&lt;sub&gt;12&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Chirvinskyite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Chirvinskyite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Yakovenchuk V N, Pakhomovsky Y A, Panikorovskii T L, Zolotarev A A, Mikhailova J A, Bocharov V N, Krivovichev S V, Ivanyuk G Y (2019) Chirvinskyite, (Na,Ca)_13_(Fe,Mn,[box])_2_(Ti,Nb)_2_(Zr,Ti)_3_(Si_2_O_7_)_4_(OH,O,F)_12_, a new mineral with a modular wallpaper structure, from the Khibiny Alkaline Massif (Kola Peninsula, Russia). Minerals 9, 219</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n487acc5da05049618fd9508bab26ad38b10">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/gso/1.0/common/hasQuality"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/gso/1.0/geologicquality/Azimuth"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/manganiandrosite-la">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Manganiandrosite-(La)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>La | Mn | Al | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">epidote</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">MnLa(Mn&lt;sup&gt;3+&lt;/sup&gt;AlMn&lt;sup&gt;2+&lt;/sup&gt;)[Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;][SiO&lt;sub&gt;4&lt;/sub&gt;]O(OH)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1994-048</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:mindatid>min-6801</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:6801:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-6801.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;La&lt;sup&gt;3+&lt;/sup&gt;AlMn&lt;sup&gt;3+&lt;/sup&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)(SiO&lt;sub&gt;4&lt;/sub&gt;)O(OH)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Manganiandrosite-(La)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Manganiandrosite-(La)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named androsite-(La): Bonazzi P, Menchetti S, Reinecke T (1996) Solid solution between piemontite and androsite-(La), a new mineral of the epidote group from Andros Island, Greece, American Mineralogist 81, 735-742 Name changed from androsite-(La) to manganiandrosite-(La): Armbruster T, Bonazzi P, Akasaka M, Bermanec V, Chopin C, Giere R, Huess-Assbichler S, Liebscher A, Menchetti S, Pan Y, Pasero M (2006) Recommended nomeclature of epidote-group minerals, European Journal of Mineralogy 18, 551-567 as Androsite-(La)</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Epidote</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.BG.05b</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate with mixed SiO4 and Si2O7 groups; cations in octahedral [6] and greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Androsite-%28La%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1994-048</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/larisaite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Larisaite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | H | O | U | Se</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na(H&lt;sub&gt;3&lt;/sub&gt;O)(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(Se&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2002-061</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-26392</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:26392:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-26392.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na(H&lt;sub&gt;3&lt;/sub&gt;O)(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(Se&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060879</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Larisaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Larisaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chukanov N V, Pushcharovsky D Yu, Pasero M, Merlino S, Barinova A V, Möckel S, Pekov I V, Zadov A E, Dubinchuk V T (2004) Larisaite, Na(H_3_O)(UO_2_)_3_(SeO_3_)_2_O_2_·4H_2_O, a new uranyl selenite mineral from Repete mine, San Juan County, Utah, U.S.A., European Journal of Mineralogy 16, 367-374</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.JH.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Selenite without additional anions, with H2O</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Larisaite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2002-061</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Foreland_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">1-GE WP3, Neuendorf et al.(2005), p. 250</dct:source>
    <rdfs:comment xml:lang="en">The exterior area of an orogenic belt where deformation occurs without significant metamorphism. Generally the foreland is closer to the continental interior than other portions of the orogenic belt are.</rdfs:comment>
    <rdfs:label xml:lang="en">foreland setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Tectonic_Setting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ogdensburgite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ogdensburgite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Fe | Zn | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/ogdensburgite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Zn(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1980-054</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2962</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2962:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2962.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Zn&lt;sup&gt;2+&lt;/sup&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ogdensburgite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ogdensburgite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Dunn P J (1981) Ogdensburgite a new calcium-zinc-ferric iron arsenate mineral from Sterling Hill, New Jersey, The Mineralogical Record 12, 369-370 Fleischer M, Chao G Y, Mandarino J A (1982) New mineral names, American Mineralogist 67, 854-860</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.DC.57</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With only medium-sized cations, (OH, etc.):RO4 = 1:1 and &lt; 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Ogdensburgite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1980-054</gsmin:wikipediadate>
  </rdf:Description>
