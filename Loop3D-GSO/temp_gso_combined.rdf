    <gsmin:rruffnameplain xml:lang="en">Alumotantite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Voloshin A V, Men’shikov Y P, Pakhomovskii Y A (1981) Alumotantite and natrotantite, new tantalum minerals in granitic pegmatites, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 110(3), 338-345</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.DB.55</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With medium-sized cations; chains of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Alumotantite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1980-025</gsmin:wikipediadate>
  </rdf:Description>
