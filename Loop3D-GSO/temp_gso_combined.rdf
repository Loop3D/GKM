  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/plumbogummite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Plumbogummite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Al | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">alunite-jarosite-plumbogummite subgroup</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/plumbogummite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">PbAl&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)(PO&lt;sub&gt;3&lt;/sub&gt;OH)(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Redefined|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3247</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3247:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3247.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">PbAl&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)(PO&lt;sub&gt;3&lt;/sub&gt;OH)(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050458 | R060684 | R070700</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Plumbogummite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Plumbogummite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Known previous to this publication, but referred to here as plomb-gomme: Berzelius J J (1819) (30) Diaspore, in Nouveau Système de Minéralogie, Méquignon-Marvis (Paris) 282-285 Named changed to plumbo-gummite: Shepard C U (1835) Plumbo-gummite, in Treatise on Mineralogy: Second Part, Hezekiah Howe &amp; Co. (New Haven) 113-113 Redefined: Scott K M (1987) Solid solution in, and classification of, gossan-derived members of the alunite-jarosite family, northwest Queensland, Australia, American Mineralogist 72, 178-187</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Alunite-crandallite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BL.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH, etc.):RO4 = 3:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Plumbogummite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1819</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/magnesiohogbomite-2n4s">
