    <rdfs:label xml:lang="en">Tokkoite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Ca | Si | O | H | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/tokkoite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;Ca&lt;sub&gt;4&lt;/sub&gt;Si&lt;sub&gt;7&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;(OH)F</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1985-009</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3989</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3989:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3989.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;Ca&lt;sub&gt;4&lt;/sub&gt;Si&lt;sub&gt;7&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;(OH)F</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tokkoite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tokkoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hawthorne F C, Burke E A J, Ercit T S, Grew E S, Grice J D, Jambor J L, Puziewicz J, Roberts A C, Vanko D A (1988) New mineral names, American Mineralogist 73, 189-199 Chemical formula revised: Rozhdestvenskaya I V, Nikishova L V, Lazebnik Yu D, Lazebnik K A (1989) The crystal structure of tokkoite and its relation to the structure of tinaksite, Zeitschrift für Kristallographie 189, 195-204</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.DG.75</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 3-periodic single and multiple chains</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Tokkoite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1985-009</gsmin:wikipediadate>
  </rdf:Description>
