    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ce&lt;sup&gt;3+&lt;/sup&gt;Nb&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070225 | R070300 | R080102</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fergusonite-(Ce)-β</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Fergusonite-(Ce)-beta</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named brocenite: Kuo C T, Wang I H, Wang H C, Wang C K, Hou H C (1973) Studies on minerals of the fergusonite group, Geochimica 2, 86-92 Name changed from brocenite: Fleischer M, Chao G Y, Kato A (1975) New mineral names, American Mineralogist 60, 485-489</gsmin:statusnotes>
  </rdf:Description>
