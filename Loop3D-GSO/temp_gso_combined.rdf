  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/nickenichite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Nickenichite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Cu | Mg | Fe | Al | As | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">alluaudite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/nickenichite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,Ca,Cu)&lt;sub&gt;1.6&lt;/sub&gt;(Mg,Fe&lt;sup&gt;3+&lt;/sup&gt;,Al)&lt;sub&gt;3&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1992-014</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2900</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2900:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2900.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,Ca,Cu&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;1.6&lt;/sub&gt;(Mg,Fe&lt;sup&gt;3+&lt;/sup&gt;,Al)&lt;sub&gt;3&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nickenichite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Nickenichite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Auernhammer M, Effenberger H, Hentschel G, Reinecke T, Tillmanns E (1993) Nickenichite, a new arsenate from the Eifel, Germany, Mineralogy and Petrology 48, 153-166 Jambor J L, Roberts A C, Puziewicz J (1994) New mineral names, American Mineralogist 79, 570-574</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Alluaudite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.AC.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, without H2O, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Nickenichite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1992-014</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/sasaite">
