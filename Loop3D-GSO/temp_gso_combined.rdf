    <gsmin:imanumber xml:lang="en">IMA2001-006</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-29113</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:29113:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-29113.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;Zn&lt;sup&gt;2+&lt;/sup&gt;(Nb&lt;sup&gt;5+&lt;/sup&gt;,Ti&lt;sup&gt;4+&lt;/sup&gt;)&lt;sub&gt;4&lt;/sub&gt;(Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(O,OH)&lt;sub&gt;4&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Organovaite-Zn</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Organovaite-Zn</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pekov I V, Chukanov N V, Zadov A E, Krivovichev S V, Azarova Y V, Burns P C, Schneider J (2002) Organovaite-Zn, K2Zn(Nb,Ti)4(Si4O12)2(O,OH)4·6H2O, a new mineral of the labuntsovite group, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 131, issue 1, 29-34 Jambor J L, Kovalenker V A, Roberts A C (2003) New mineral names, American Mineralogist 88, 931-935</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Labuntsovite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CE.30g</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si4O12]8- 4-membered single rings (vierer-Einfachringe), without insular complex anions</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://webmineral.com/data/Organovaite-Zn.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2001-006</gsmin:wikipediadate>
  </rdf:Description>
