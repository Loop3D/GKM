    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3381:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3381.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,Mn&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;15&lt;/sub&gt;Y&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(C&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;9&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;F)Cl</gsmin:rruffchemistry>
