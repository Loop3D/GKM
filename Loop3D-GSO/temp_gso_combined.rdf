  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/matteuccite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Matteuccite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | H | S | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/matteuccite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaH(SO&lt;sub&gt;4&lt;/sub&gt;)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Sodium hydrogen sulfate monohydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2596</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2596:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2596.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaHSO&lt;sub&gt;4&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Matteuccite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Matteuccite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Carobbi G, Cipriani C (1952) Ralstonite e bisolfato sodico (matteuccite) fra i prodotti delle fumarole vesuviane, Rendiconti, Reale Accademia dei Lincei 12, 23-29 Fleischer M (1954) New mineral names, American Mineralogist 39, 848-852</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.CD.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, with H2O, With only large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Matteuccite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1950</gsmin:wikipediadate>
