    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;19&lt;/sub&gt;Mg(Al&lt;sub&gt;11&lt;/sub&gt;Mg)Si&lt;sub&gt;18&lt;/sub&gt;O&lt;sub&gt;69&lt;/sub&gt;(OH)&lt;sub&gt;9&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2015-104</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;19&lt;/sub&gt;Mg(Al&lt;sub&gt;11&lt;/sub&gt;Mg)Si&lt;sub&gt;18&lt;/sub&gt;O&lt;sub&gt;69&lt;/sub&gt;(OH)&lt;sub&gt;9&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Magnesiovesuvianite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Magnesiovesuvianite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Panikorovskii T L, Shilovskikh V V, Avdontseva E Y, Zolotarev A A, Karpenko V Y, Mazur A S, Yakovenchuk V N, Bazai A V, Krivovichev S V, Pekov I V (2017) Magnesiovesuvianite, Ca_19_Mg(Al,Mg)_12_Si_18_O_69_(OH)_9_, a new vesuvianite-group mineral. Journal of Geosciences 62, 25-36</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Vesuvianite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/turquoise">
