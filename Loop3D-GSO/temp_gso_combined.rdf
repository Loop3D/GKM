    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;Cl&lt;sub&gt;4&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dipotassium ironII tetrachloride dihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1314</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1314:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1314.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;Cl&lt;sub&gt;4&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Douglasite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Douglasite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Precht H (1880) Ueber die bildung des wasserstoffs in den Stassfurter kalisalzbergweken, Berichte der Deutschen Chemischen Gesellschaft 13, 2326-2328</gsmin:statusnotes>
    <gsmin:strunzcodeV10>03.CJ.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Complex halide with MX6 complexes</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Douglasite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1880</gsmin:wikipediadate>
