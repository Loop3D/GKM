    <gsmin:statusnotes xml:lang="en">Genth F A (1878) On some tellurium and vanadium minerals. 6. Magnolite, a new mineral, Proceedings of the American Philosophical Society 17, 113-123</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.JK.60</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Tellurite without additional anions, without H2O</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Magnolite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1878</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfoliation/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:comment xml:lang="en">2020-01-28 SKOS vocabulary converted to OWL ontology by Stephen Richard (SMR), skos:concepts becoming owl:Class, skos:prefLabel to rdfs:label, skos:broader to rdfs:subClassOf. URIs mapped to GSO/ontology URIs.</rdfs:comment>
    <rdfs:comment xml:lang="en">Original version created by IUGS Commission for Geoscience Information (CGI) Geoscience Terminology Working Group as a SKOS vocabulary in 2010, see http://resource.geosciml.org/vocabulary/cgi/2016/foliationtype.rdf for current version. 2018-08-03 version was used to generate this ontology.  This scheme specifies concepts used to describe planar fabrics in rocks, as defined by the IUGS Commission for Geoscience Information (CGI) Geoscience Terminology Working Group. Includes primary (eg, sedimentary and igneous) and deformation-related (eg, metamorphic and tectonic) planar fabrics.</rdfs:comment>
    <dct:creator xml:lang="en">CGI Geoscience Terminology Working Group, Stephen M. Richard for Loop3d project</dct:creator>
    <dct:creator rdf:resource="https://w3id.org/gso/1.0/common/stephen_richard"/>
    <dct:creator rdf:resource="https://w3id.org/gso/1.0/common/boyan_brodaric"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-01-28</dct:modified>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-26</dct:modified>
    <rdfs:label xml:lang="en">Geoscience Ontology, Foliation</rdfs:label>
    <owl:imports rdf:resource="https://w3id.org/gso/1.0/common/ontology"/>
    <owl:imports rdf:resource="https://w3id.org/gso/1.0/geology/ontology"/>
    <owl:imports rdf:resource="https://w3id.org/gso/1.0/geologicstructure/ontology"/>
    <skos:definition xml:lang="en">Shared elements for geoscience ontology</skos:definition>
    <skos:prefLabel xml:lang="en">Geoscience Ontology, Foliation</skos:prefLabel>
    <dct:bibliographicCitation>Brodaric, B., and Richard, S.M., 2021, The GeoScience Ontology Reference: Geological Survey of Canada Open File 8796, 34 p., https://doi.org/10.4095/328296</dct:bibliographicCitation>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-26</dct:created>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/legalcode"/>
    <schema:codeRepository>https://github.com/Loop3D/GKM</schema:codeRepository>
    <dct:rights>Copyright (c) 2021 Government of Canada</dct:rights>
    <dct:publisher>ARC Loop3D project;  https://loop3d.org/</dct:publisher>
    <dct:publisher>Geological Survey of Canada, Natural Resources Canada, Government of Canada</dct:publisher>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/freibergite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Freibergite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ag | Cu | Fe | Sb | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">tennantite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/freibergite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ag&lt;sub&gt;6&lt;/sub&gt;[Cu&lt;sub&gt;4&lt;/sub&gt;Fe&lt;sub&gt;2&lt;/sub&gt;]Sb&lt;sub&gt;4&lt;/sub&gt;S&lt;sub&gt;12&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Hexasilver tetracopper diiron tetraantimonide tridecasulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-1605</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1605:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1605.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ag&lt;sup&gt;1+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;[Cu&lt;sup&gt;1+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;]Sb&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;12&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R061081</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Freibergite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Freibergite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kenngott G A (1853) Freibergit, in Das Mohs'sche Mineralsystem, dem gegenwärtigen Standpuncte der Wissenschaft gemäss bearbeitet, (Wien) 117-117</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Tennantite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.GB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Neso-sulfarsenite with additional S</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Freibergite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1853</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kettnerite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kettnerite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Bi | O | C | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/kettnerite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaBiO(CO&lt;sub&gt;3&lt;/sub&gt;)F</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Calcium bismuth oxycarbonate fluoride</gsmin:iupacchemname>
    <gsmin:mindatid>min-2190</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2190:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2190.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaBi&lt;sup&gt;3+&lt;/sup&gt;O(CO&lt;sub&gt;3&lt;/sub&gt;)F</gsmin:rruffchemistry>
    <gsmin:rruffids>R130113</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kettnerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kettnerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Zak L, Synecek V (1956) Kettnerite, (CaF)(BiO)CO_3_, a new mineral of the phosgenite-bismutite group: preliminary note, Casopis pro Mineralogii a Geologii 1, 195-197</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Bismutite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>05.BE.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions, without H2O, With Pb, Bi</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Kettnerite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1956</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/granularmaterial/rounded">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Powers, M. C., 1953 A new roundness scale for sedimentary particles. Journal of Sedimentary Petrology, v. 23, p. 117-119</dct:source>
    <rdfs:comment xml:lang="en">A clastic sedimentary particle whose original edges and corners have been smoothed off to rather broad curves and whose original faces are almost completely removed by abrasion (although some comparatively flat surfaces may be present), such as a pebble with a roundness value between 0.49 and 0.70 (midpoint at 0.59) and few (0-5) and greatly subdued secondary corners. The original shape is still readily apparent.</rdfs:comment>
    <rdfs:label xml:lang="en">rounded</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/granularmaterial/Grain_Roundness_Value"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n1fd689c41a864089b476a4d481ba57bdb95">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onClass rdf:resource="https://w3id.org/gso/1.0/geology/Geologic_Time_Boundary"/>
    <owl:onProperty rdf:resource="https://w3id.org/gso/1.0/common/hasStaticPart"/>
    <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:qualifiedCardinality>
  </rdf:Description>
