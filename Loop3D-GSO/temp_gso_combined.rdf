    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mg | Al | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic, orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">palygorskite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/palygorskite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Mg,Al)&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;(OH)·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3072</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3072:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3072.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Mg,Al)&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;(OH)·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Palygorskite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Palygorskite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">von Ssaftschenkow T (1862) Paligorskit, Verhandlungen der Kalserllchen Gesellschaft für die Gesammte Mlneralogle zu St. Petersburg 1862, 102-104</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Clay</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EE.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate: Single tetrahedral nets of 6-membered rings connected by octahedral nets or octahedral bands</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Palygorskite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1962</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ruifrancoite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ruifrancoite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Mn | Fe | Mg | Be | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">roscherite</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;(&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;,Mn)&lt;sub&gt;2&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;,Mn,Mg)&lt;sub&gt;4&lt;/sub&gt;Be&lt;sub&gt;4&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2005-061a</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-29066</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:29066:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-29066.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Be&lt;sub&gt;4&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070049</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ruifrancoite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ruifrancoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Atencio D, Chukanov N V, Coutinho J M V, Menezes L A D, Dubinchuk V T, Möckel S (2007) Ruifrancoite, a new Fe^3+^-dominant monoclinic member of the roscherite group from Galiléia, Minas Gerais, Brazil, The Canadian Mineralogist 45, 1263-1273</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Roscherite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DA.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With small (and occasionally larger) cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Ruifrancoite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2005-061a</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/barytocalcite">
