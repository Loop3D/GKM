    <gsmin:rruffnameplain xml:lang="en">Petricekite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Bindi L, Förster H J, Grundmann G, Keutsch F N, Stanley C J (2016) Petrícekite, CuSe_2_, a new member of the marcasite group from the Predborice Deposit, Central Bohemia Region, Czech Republic. Minerals 6, 33</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Marcasite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Glassy_Igneous_Rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">This vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Igneous rock that consists of greater than 80 percent massive glass.</rdfs:comment>
    <rdfs:comment xml:lang="en">Note that this category is used for massive glassy rocks. Much of the pyroclastic material in a pyroclastic rock may be composed of glass, but the rock is named based on its fragmental nature.</rdfs:comment>
    <rdfs:label xml:lang="en">glassy igneous rock</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Glass_Rich_Igneous_Rock"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/hansblockite">
