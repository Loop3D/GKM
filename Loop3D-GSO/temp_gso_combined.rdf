  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/chlorapatite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Chlorapatite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/mineral/apatite"/>
    <gsmin:chemistryelements>Ca | P | O | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal, monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">apatite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/chlorapatite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;5&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;Cl</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Renamed|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Pentacalcium triphosphate chloride</gsmin:iupacchemname>
    <gsmin:mindatid>min-1013</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1013:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1013.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;5&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;Cl</gsmin:rruffchemistry>
    <gsmin:rruffids>R060192</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Chlorapatite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Chlorapatite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Rose G (1827) Ueber die chemische Zusammensetzung der Apatite. Annalen der Physik und Chemie 85, 185-214 Name changed from chlorapatite to apatite-(CaCl): Burke E A J (2008) Tidying up mineral names: an IMA-CNMNC scheme for suffixes, hyphens and diacritical marks, The Mineralogical Record 39, 131-135 Name changed from apatite-(CaCl) back to chlorapatite. The monoclinic variant is defined as chlorapatite-M and is not a distinct species: Pasero M, Kampf A R, Ferraris C, Pekov I V, Rakovan J R, White T J (2010) Nomenclature of the apatite supergroup minerals, European Journal of Mineralogy 22, 163-179</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Apatite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BN.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With only large cations, (OH, etc.):RO4 = 0.33:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Chlorapatite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1860</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/chloritoid">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Chloritoid</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Fe | Al | O | Si | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic, monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">ottrelite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/chloritoid.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;Al&lt;sub&gt;2&lt;/sub&gt;O(SiO&lt;sub&gt;4&lt;/sub&gt;)(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: IronII dialuminium oxynesosilicate dihydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-1017</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1017:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1017.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;Al&lt;sub&gt;2&lt;/sub&gt;OSiO&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050334 | R060292</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Chloritoid</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Chloritoid</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named chloritspath: Fiedler K G (1832) Lagerstätten des diaspor, chloritspath, pyrophyllit und monazit, aufgefund in Ural, Annalen der Physik und Chemie 25, 322-333 Name changed to chloritoid: Breithaupt A (1835) Neue specifische gewichte von mineralien, Journal für Praktische Chemie 4, 272-278</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.AF.85</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with additional anions; cations in [4], [5] and/or only [6] coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Chloritoid.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1832</gsmin:wikipediadate>
  </rdf:Description>
