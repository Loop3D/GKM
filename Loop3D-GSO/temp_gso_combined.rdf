    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K(LiCu&lt;sup&gt;2+&lt;/sup&gt;)Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;(Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;11&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R120057 | R141115</gsmin:rruffids>
