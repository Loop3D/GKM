    <gsmin:mindaturl>http://www.mindat.org/min-1316.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al(OH)&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Doyleite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Doyleite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chao G Y, Baker J, Sabina A P, Roberts A C (1985) Doyleite, a new polymorph of Al(OH)&lt;sub&gt;3&lt;/sub&gt;, and its relationship to bayerite, gibbsite and nordstrandite, The Canadian Mineralogist 23, 21-28</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.FE.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Hydroxide (without V or U), Hydroxides with OH, without H2O; sheets of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Doyleite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1980-041</gsmin:wikipediadate>
