    <gsmin:rruffnameplain xml:lang="en">Ringwoodite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Binns R A, Davis R J, Reed S J B (1969) Ringwoodite, natural (Mg,Fe)_2_SiO_4_ spinel in the Tenham meteorite, Nature 221, 943-944</gsmin:statusnotes>
