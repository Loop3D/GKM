    <gsmin:rruffids>R050531 | R050508</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Malachite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Malachite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mineral name has been known since antiquity and predates any formal descriptive publication</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Malachite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>05.BA.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions, without H2O, With Cu, Co, Ni, Zn, Mg, Mn</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Malachite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1747</gsmin:wikipediadate>
