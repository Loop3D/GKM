    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;13&lt;/sub&gt;Fe&lt;sub&gt;2&lt;/sub&gt;Ge&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;16&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Tridecacopper diiron digermanium hexadecasulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-1681</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1681:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1681.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;1+&lt;/sup&gt;&lt;sub&gt;8&lt;/sub&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Ge&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;16&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050439</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Germanite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Germanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pufahl O (1922) “Germanit” ein germanium-mineral und -erz von Tsumeb, Südwest-Afrika, Metall und Erz 19, 324-325 Chemical formula changed from Cu_3_(Ge,Fe)S_4_: Tettenhorst R T, Corbato C E (1984) Crystal structure of germanite, Cu_26_Ge_4_Fe_4_S_32_, determined by powder X-ray diffraction. American Mineralogist 69, 943-947</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Sphalerite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.CB.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide (M = S) with Zn, Fe, Cu, Ag, etc.</gsmin:strunzlabel>
