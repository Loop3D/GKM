  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Phyllonite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">NADM metamorphic rock vocabulary SLTTm1.0; Marshak and Mitra 1988</dct:source>
    <rdfs:comment xml:lang="en">Mylonitic rock composed largely of fine-grained mica that imparts a sheen to foliation surfaces; may have flaser lamination, isoclinal folding, and deformed veins, which indicate significant shearing. Macroscopically resembles phyllite, but formed by mechanical degradation of initially coarser rock.</rdfs:comment>
    <rdfs:label xml:lang="en">phyllonite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Mylonitic_Rock"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicrole/Sedimentary_Matrix">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">very fine-grained material of undiscernible sedimentary or diagenetic origin between clasts in a sedimentary rock. Includes mud matrix and pseudomatrix derived from degraded clasts e.g. in a graywacke </rdfs:comment>
    <rdfs:label xml:lang="en">matrix </rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicrole/Matrix"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ivsite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ivsite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | H | S | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;3&lt;/sub&gt;H(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2013-138</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;3&lt;/sub&gt;H(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ivsite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ivsite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Filatov S K, Karpov G A, Shablinskii A P, Krivovichev S V, Vergasova L P, Antonov A V (2016) Ivsite, Na_3_H(SO_4_)_2_, a new mineral from volcanic exhalations of fumaroles of the Fissure Tolbachik Eruption of the 50th anniversary of the Institute of Volcanology and Seismology, Far East Branch, Russian Academy of Sciences. Doklady Earth Sciences 468, 632-635</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Continental_Rift_Setting">
