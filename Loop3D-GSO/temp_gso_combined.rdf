    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">hellandite</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,REE)&lt;sub&gt;4&lt;/sub&gt;Ce&lt;sub&gt;2&lt;/sub&gt;Al&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;&lt;sub&gt;2&lt;/sub&gt;(B&lt;sub&gt;4&lt;/sub&gt;Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;)(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2001-019</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,REE)&lt;sub&gt;4&lt;/sub&gt;Ce&lt;sub&gt;2&lt;/sub&gt;Al&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;&lt;sub&gt;2&lt;/sub&gt;(B&lt;sub&gt;4&lt;/sub&gt;Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;)(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R061013</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hellandite-(Ce)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hellandite-(Ce)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Oberti R, Ottolini L, Camara F, Della Ventura G (1999) Crystal structure of non-metamict Th-rich hellandite-(Ce) from Latium (Italy) and crystal chemistry of the hellandite-group minerals, American Mineralogist 84, 913-921 Chemical formula revised: Oberti R, Ventura G D, Ottolini L, Hawthorne F C, Bonazzi P (2002) Re-definition, nomenclature, and crystal-chemistry of the hellandite group, American Mineralogist 87, 745-752</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hellandite</gsmin:structuralgroup>
  </rdf:Description>
