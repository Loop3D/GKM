    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3702:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3702.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;SiO&lt;sub&gt;4&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060361 | R060407</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Soddyite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Soddyite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named soddite: Schoep A (1922) La soddite, nouveau minéral radioactif, Comptes Rendus Hebdomadaires des Séances de l’Académie des Sciences 174, 1066-1067 Chemical formula revised: Wherry E T, Holden E F (1922) New minerals-new species, American Mineralogist 7, 178-180</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.AK.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl neso- and polysilicate</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Soddyite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1922</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/lafossaite">
