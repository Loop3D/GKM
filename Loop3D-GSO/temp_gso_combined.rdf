    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">PbZn(VO&lt;sub&gt;4&lt;/sub&gt;)(OH)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Lead zinc vanadate hydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-1267</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1267:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1267.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;Zn&lt;sup&gt;2+&lt;/sup&gt;V&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH)</gsmin:rruffchemistry>
    <gsmin:rruffids>R050037 | R050509 | R120097</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Descloizite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Descloizite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Damour A A (1854) Notice sur la descloizite, nouvelle espèce minérale, Annales de Chimie et de Physique 41, 72-78</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Descloizite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BH.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH,etc.):RO4 = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Descloizite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1854</gsmin:wikipediadate>
  </rdf:Description>
