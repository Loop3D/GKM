    <gsmin:mindaturl>http://www.mindat.org/min-3541.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KNa&lt;sub&gt;2&lt;/sub&gt;(Al&lt;sub&gt;5&lt;/sub&gt;Mg&lt;sub&gt;2&lt;/sub&gt;)[B&lt;sub&gt;12&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;(OH)&lt;sub&gt;12&lt;/sub&gt;](OH)&lt;sub&gt;6&lt;/sub&gt;Cl&lt;sub&gt;4&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Satimolite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Satimolite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Bocharov V M, Khalturina I I, Avrova N P, Shipovalov Y V (1969) The new mineral satimolite, a hydrous chlorine-containing borate of aluminum and alkalies, Trudy Mineralogicheskogo Muzeya Akademiya Nauk SSSR 19, 121-123 Chemical formula revised from KNa_2_Al_4_(B_2_O_5_)_3_Cl_3_·13H_2_O: Pekov I V, Zubkova N V, Ksenofontov D A, Chukanov N V, Yapaskurt V O, Korotchenkova O V, Chaikovskiy I I, Bocharov V M, Britvin S N, Pushcharovsky D Y (2018) Redefinition of satimolite. Mineralogical Magazine 82, 1033-1047</gsmin:statusnotes>
    <gsmin:strunzcodeV10>06.HA.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Borate, unclassified</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Satimolite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1967-023</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/odinite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Odinite</rdfs:label>
