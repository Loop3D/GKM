  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/gahnite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Gahnite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Zn | Al | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">spinel</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/gahnite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">ZnAl&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Zinc dialuminium tetraoxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-1632</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1632:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1632.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sup&gt;2+&lt;/sup&gt;Al&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R040027 | R070591 | R170037</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Gahnite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Gahnite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">von Moll C E F (1807) Uebersicht. Gahnit, aus Fahlun, Efemeriden der Berg- und Huttenkunde 3, 75-92</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Spinel</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.BB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 3:4 and similar, With only medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Gahnite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1807</gsmin:wikipediadate>
