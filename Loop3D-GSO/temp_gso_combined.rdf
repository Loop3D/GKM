    <gsmin:mindaturl>http://www.mindat.org/min-3321.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;3&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R040159 | R050112 | R050113 | R050446 | R060441 | R060445 | R060448 | R070637 | R080060 | R100153</gsmin:rruffids>
