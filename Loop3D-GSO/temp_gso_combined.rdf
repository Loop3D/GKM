    <gsmin:imanumber xml:lang="en">IMA1980-041</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: aluminium trihydroxide</gsmin:iupacchemname>
