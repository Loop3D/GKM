    <gsmin:statusnotes xml:lang="en">Henmi C (1995) Kusachiite, CuBi_2_O_4_, a new mineral from Fuka, Okayama Prefecture, Japan, Mineralogical Magazine 59, 545-548</gsmin:statusnotes>
