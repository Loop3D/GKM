    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ce,Ca)&lt;sub&gt;2&lt;/sub&gt;Zr&lt;sub&gt;2&lt;/sub&gt;(Nb,Ti)(Ti,Nb)&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;O&lt;sub&gt;14&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2017-107</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ce,Ca)&lt;sub&gt;2&lt;/sub&gt;Zr&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(Nb&lt;sup&gt;5+&lt;/sup&gt;,Ti&lt;sup&gt;4+&lt;/sup&gt;)(Ti&lt;sup&gt;4+&lt;/sup&gt;,Nb&lt;sup&gt;5+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;O&lt;sub&gt;14&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nöggerathite-(Ce)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Noggerathite-(Ce)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chukanov N V, Zubkova N V, Britvin S N, Pekov I V, Vigasina M F, Schäfer C, Ternes B, Schüller W, Polekhovsky Y S, Ermolaeva V N, Pushcharovsky D Y (2018) Nöggerathite-(Ce), (Ce,Ca)_2_Zr_2_(Nb,Ti)(Ti,Nb)_2_Fe^2+^O_14_, a new zirconolite-related mineral from the Eifel volcanic region, Germany. Minerals 8, 449</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Zirconolite</gsmin:structuralgroup>
  </rdf:Description>
