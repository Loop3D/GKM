    <gsmin:chemistryelements>Na | Mg | Ca | Al | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">zeolite</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;3&lt;/sub&gt;Mg&lt;sub&gt;3&lt;/sub&gt;Ca&lt;sub&gt;5&lt;/sub&gt;Al&lt;sub&gt;19&lt;/sub&gt;Si&lt;sub&gt;117&lt;/sub&gt;O&lt;sub&gt;272&lt;/sub&gt;·93H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1994-054</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-6976</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:6976:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-6976.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;3&lt;/sub&gt;Mg&lt;sub&gt;3&lt;/sub&gt;Ca&lt;sub&gt;5&lt;/sub&gt;Al&lt;sub&gt;19&lt;/sub&gt;Si&lt;sub&gt;117&lt;/sub&gt;O&lt;sub&gt;272&lt;/sub&gt;·93H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Gottardiite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Gottardiite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Galli E, Quartieri S, Vezzalini G, Alberti A (1996) Gottardiite, a new high-silica zeolite from Antarctica: the natural counterpart of synthetic NU-87, European Journal of Mineralogy 8, 687-693</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.GF.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Other rare zeolite</gsmin:strunzlabel>
