    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sub&gt;3&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1978-038</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Trizinc diarsenate dihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-4244</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4244:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4244.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R080105</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Warikahnite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Warikahnite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Keller P, Hess H, Dunn P J (1979) Warikahnit, Zn_3_[(H_2_O)_2_|(AsO_4_)_2_], ein neues mineral aus Tsumeb, Südwestafrika, Neues Jahrbuch für Mineralogie, Monatshefte 1979, 389-395</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.CA.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With small and large/medium cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Warikahnite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1978-038</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfault/Transform_Fault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">GGIC vocabularies working group (Australia)</dct:source>
    <rdfs:comment xml:lang="en">A variety of strike-slip fault along which the displacement suddenly stops or changes form, typically associated with mid-ocean ridges.</rdfs:comment>
    <rdfs:label xml:lang="en">transform</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfault/Strike_Slip_Fault"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/francevillite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Francevillite</rdfs:label>
