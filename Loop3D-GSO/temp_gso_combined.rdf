    <gsmin:chemistryelements>Fe | O | H | C</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;8&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2012-049</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;8&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mössbauerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Mossbauerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Génin J M R, Mills S J, Christy A G, Guérin O, Herbillion A J, Kuzmann E, Ona-Nguema G, Ruby C, Upadhyay C (2014) Mössbauerite, Fe^3+^_6_O_4_(OH)_8_[CO_3_]·3H_2_O, the fully oxidized 'green rust' mineral from Mont Saint-Michel Bay, France. Mineralogical Magazine 78, 447-465</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hydrotalcite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologiclineation/biotite_mineral_lineation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI lineationtype SKOS vocabulary 2016-11-21</dct:source>
    <rdfs:comment xml:lang="en">Mineral lineation defined by aligned elongate biotite aggregates in a foliation surface. Biotite does not have an elongate (prismatic, acicular) mineral habit, so production of lineation must reflect elongate aggregates of biotite crystals.</rdfs:comment>
    <rdfs:label xml:lang="en">biotite mineral lineation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologiclineation/mineral_lineation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/thoreaulite">
