    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;42&lt;/sub&gt;K&lt;sub&gt;16&lt;/sub&gt;Ca&lt;sub&gt;6&lt;/sub&gt;Si&lt;sub&gt;48&lt;/sub&gt;Al&lt;sub&gt;48&lt;/sub&gt;O&lt;sub&gt;192&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;10&lt;/sub&gt;Cl&lt;sub&gt;2&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1979-064</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
