    <gsmin:mindaturl>http://www.mindat.org/min-1836.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Fe,Ni)&lt;sub&gt;23&lt;/sub&gt;C&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070034</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Haxonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Haxonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mineral described, but not named: Scott E R D (1971) New carbide, (Fe,Ni)_23_C_6_, found in iron meteorites, Nature 229, 61-62</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Haxonite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>01.BA.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbides</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Haxonite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1971-001</gsmin:wikipediadate>
  </rdf:Description>
