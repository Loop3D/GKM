    <gsmin:rruffnameplain xml:lang="en">Ellenbergerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chopin C, Klaska R, Medenbach O, Dron D (1986) Ellenbergerite, a new high-pressure Mg-Al-(Ti,Zr)-silicate with a novel structure based on face-sharing octahedra, Contributions to Mineralogy and Petrology 92, 316-321</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Ellenbergerite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AF.80</gsmin:strunzcodeV10>
