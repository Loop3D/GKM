    <gsmin:mindaturl>http://www.mindat.org/min-7061.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaV&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)(PO&lt;sub&gt;3&lt;/sub&gt;OH)(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Springcreekite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Springcreekite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kolitsch U, Taylor M R, Fallon G D, Pring A (1999) Springcreekite, BaV3+3(PO4)2(OH,H2O)6, a new member of the crandallite group, from the Spring Creek mine, South Australia: the first natural V3+-member of the alunite family and its crystal structure, Neues Jahrbuch für Mineralogie, Monatshefte 1999, 529-544</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Alunite-crandallite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BL.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH, etc.):RO4 = 3:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Springcreekite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1998-048</gsmin:wikipediadate>
