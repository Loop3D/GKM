    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3503:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3503.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;5&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;OH)&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060273</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sainfeldite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Sainfeldite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pierrot R (1964) Contribution à la minéralogie des arséniates calciques et calcomagnésiens naturels, Bulletin de la Société Française de Minéralogie et de Cristallographie 87, 169-211</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hureaulite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CB.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With only medium-sized cations, RO4:H2O = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Sainfeldite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1963-018</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/giuseppettite">
