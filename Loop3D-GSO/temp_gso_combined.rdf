    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Li&lt;sub&gt;2&lt;/sub&gt;(Ca,Na)Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;7&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;(O,F)(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bulgakite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Bulgakite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Agakhanov A A, Pautov L A, Sokolova E, Abdu Y A, Karpenko V Y (2016) Two astrophyllite-supergroup minerals: Bulgakite, a new mineral from the Darai-Pioz Alkaline Massif, Tajikistan and revision of the crystal structure and chemical formula of nalivkinite. The Canadian Mineralogist 54, 33-48</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Astrophyllite-Astrophyllite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/antigorite">
