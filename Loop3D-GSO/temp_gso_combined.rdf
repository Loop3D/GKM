    <gsmin:chemistryelements>N | H | U | O | As</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">autunite</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(NH&lt;sub&gt;4&lt;/sub&gt;)(UO&lt;sub&gt;2&lt;/sub&gt;)(AsO&lt;sub&gt;4&lt;/sub&gt;)·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2005-043</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-28919</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:28919:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-28919.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">N&lt;sup&gt;3-&lt;/sup&gt;H&lt;sub&gt;4&lt;/sub&gt;(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R061122</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Uramarsite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Uramarsite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Sidorenko G A, Chukanov N V, Chistyakova N I, Bebeshko G I, Zadov A E, Naumova A S (2007) Uramarsite, (NH_4_,H_3_O)_2_(UO_2_)_2_(AsO_4_,PO_4_)_2_·6H_2_O: a new mineral of the metaautunite group, Doklady Earth Sciences 415A, 965-969</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Meta-autunite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.EB.15</gsmin:strunzcodeV10>
