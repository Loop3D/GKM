    <gsmin:statusnotes xml:lang="en">Martini J E J (1991) Swaknoite [Ca(NH4)2·(HPO4)2·H2O, orthorhombic]: A new mineral from Arnhem Cave, Namibia, Bulletin of the South African Speleological Association 32, 72-74</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.CJ.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With only large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Swaknoite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1991-021</gsmin:wikipediadate>
