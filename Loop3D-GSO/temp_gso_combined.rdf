    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3030:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3030.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;2&lt;/sub&gt;Mn&lt;sup&gt;3+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;(BO&lt;sub&gt;3&lt;/sub&gt;)</gsmin:rruffchemistry>
