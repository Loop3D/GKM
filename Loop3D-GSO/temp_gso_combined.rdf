    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:42749:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-42749.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">U&lt;sup&gt;4+&lt;/sup&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;OH)&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Štěpite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Stepite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Plášil J, Fejfarová K, Hloušek J, Škoda R, Novák M, Sejkora J, Cejka J, Dušek M, Veselovský F, Ondruš P, Majzlan J, Mrázek Z (2013) Štepite, U(AsO_3_OH)_2_·4H_2_O, from Jáchymov, Czech Republic: the first natural arsenate of tetravalent uranium, Mineralogical Magazine 77, 137-152</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">phosphate, arsenate, or vanadate</gsmin:strunzlabel>
    <gsmin:wikipediadate>2012-006</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/material_formed_in_surficial_environment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">This vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Material that is the product of weathering processes operating on pre-existing rocks or deposits, analogous to hydrothermal or metasomatic rocks, but formed at ambient Earth surface temperature and pressure.</rdfs:comment>
    <rdfs:label xml:lang="en">material formed in surficial environment</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Composite_Genesis_Material"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Lacustrine_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI Event Environment vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Setting associated with a lake. Always overlaps with terrestrial, may overlap with subaerial, subaqueous, or shoreline.</rdfs:comment>
    <rdfs:label xml:lang="en">lacustrine setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Terrestrial_Setting"/>
  </rdf:Description>
