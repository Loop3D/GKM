    <gsmin:rruffnameplain xml:lang="en">Lumsdenite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf, A.R., Hughes, J.M., Nash, B.P., Marty, J. and Rose, T.P. (2018) Lumsdenite, IMA 2018-092. CNMNC Newsletter No. 46, December 2018, page 1374; Mineralogical Magazine, 82, 1369–1379</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/peterandresenite">
