    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Barium diuranyl diarsenate octahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2673</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2673:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2673.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060778</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Metaheinrichite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Metaheinrichite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Gross E B, Corey A S, Mitchell R S, Walenta K (1958) Heinrichite and metaheinrichite, hydrated barium uranyl arsenate minerals, American Mineralogist 43, 1134-1143</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.EB.10</gsmin:strunzcodeV10>
