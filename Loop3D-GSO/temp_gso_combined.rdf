  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/fluoro-leakeite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Fluoro-leakeite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Mg | Al | Li | Si | O | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaNa&lt;sub&gt;2&lt;/sub&gt;(Mg&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;Li)Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;F&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2009-012</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaNa&lt;sub&gt;2&lt;/sub&gt;(Mg&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;Li)Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;F&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fluoro-leakeite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Fluoro-leakeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Oberti R, Cámara F, Hawthorne F C, Ball N A (2009) Fluoro-aluminoleakeite, NaNa_2_(Mg_2_Al_2_Li)Si_8_O_22_F_2_, a new mineral of the amphibole group from Norra Kärr, Sweden: description and crystal structure, Mineralogical Magazine 73, 817-824 Name changed from fluoro-aluminoleakeite according to: Hawthorne F C, Oberti R, Harlow G E, Maresch W V, Martin R F, Schumacher J C, Welch M D (2012) Nomenclature of the amphibole supergroup. American Mineralogist 97, 2031-2048</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Amphibole</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/wollastonite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Wollastonite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic, monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">wollastonite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/wollastonite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaSiO&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4323</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4323:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4323.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaSiO&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R040131 | R040008 | R120016 | R120122</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Wollastonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Wollastonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Wollastonite introduced as a new mineral species that was similar to, but distinct, from meionite: Leman J (1818) Meionite, Nouveau Dictionnaire d'Histoire Naturelle 20, 28-31</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Wollastonite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DG.05</gsmin:strunzcodeV10>
