    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Rankamaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Rankamaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">von Knorring O, Vorma A, Nixon P H (1969) Rankamaite, a new tantalum mineral from Kivu, Congo, Bulletin of the Geological Society of Finland 41, 47-56</gsmin:statusnotes>
