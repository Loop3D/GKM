    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Trizinc diphosphate tetrahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1999</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1999:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1999.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R050254 | R130562</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hopeite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hopeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Brewster D (1826) Description of hopeite, a new mineral from Altenberg near Aix-la-Chapelle, Transactions of the Royal Society of Edinburgh 10, 107-111</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hopeite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CA.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With small and large/medium cations</gsmin:strunzlabel>
