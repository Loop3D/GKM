    <gsmin:rruffnameplain xml:lang="en">Sakhaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Ostrovskaya I V, Pertsev N N, Nikitina I B (1966) Sakhaite, a new carbonate-borate of calcium and magnesium, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 95, 193-202</gsmin:statusnotes>
    <gsmin:strunzcodeV10>06.AB.65</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Monoborate, BO3, with additional anions; 1(D) + OH, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Sakhaite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1965-035</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/magnetoplumbite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
