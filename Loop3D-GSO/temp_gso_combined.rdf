  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/garnetgroup">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Added by SMR.  full name is Garnet Group</rdfs:comment>
    <rdfs:comment xml:lang="en">a group of silicate minerals with the same structure. All species of garnets possess similar physical properties and crystal forms, but differ in chemical composition. The different species are pyrope, almandine, spessartine, grossular (varieties of which are hessonite or cinnamon-stone and tsavorite), uvarovite and andradite. The garnets make up two solid solution series: pyrope-almandine-spessartine and uvarovite-grossular-andradite.(https://en.wikipedia.org/wiki/Garnet)</rdfs:comment>
    <rdfs:label xml:lang="en">Garnet</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:mindatid>min-10272</gsmin:mindatid>
    <gsmin:mindaturl>https://www.mindat.org/min-10272.html</gsmin:mindaturl>
  </rdf:Description>
