    <gsmin:rruffnameplain xml:lang="en">Quadruphite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Khomyakov A P, Nechelyustov G N, Sokolova E V, Dorokhova G I (1992) Quadruphite Na_14_CaMgTi_4_[Si_2_O_7_]_2_[PO_4_]_4_O_4_F_2_ and polyphite Na_17_Ca_3_Mg(Ti,Mn)_4_[Si_2_O_7_]_2_[PO_4_]_6_O_2_F_6_ - new minerals of the lomonosovite family, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 121(1), 105-112</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Seidozerite-Murmanite</gsmin:structuralgroup>
