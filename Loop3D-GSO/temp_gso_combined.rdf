    <gsmin:chemistryelements>Ca | Al | Ta | Nb | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca[Al&lt;sub&gt;0.5&lt;/sub&gt;(Ta,Nb)&lt;sub&gt;0.5&lt;/sub&gt;)](SiO&lt;sub&gt;4&lt;/sub&gt;)O</gsmin:imachemistry>
