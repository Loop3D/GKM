    <gsmin:iupacchemname xml:lang="en">IUPAC: Magnesium sulfate tetrahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-3752</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3752:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3752.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">MgS&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060321 | R070589</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Starkeyite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Starkeyite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Grawe O R (1945) Pyrite deposits of Missouri. Starkeyite [FeSO_4_·H_2_O], a new mineral, Missouri Geological Survey and Water Resources 1945, 209-210 Chemical formula redefined: Grawe O R (1956) Notes and news: starkeyite, a correction, American Mineralogist 41, 662-662</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Starkeyite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.CB.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, with H2O, With only medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Starkeyite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1945</gsmin:wikipediadate>
  </rdf:Description>
