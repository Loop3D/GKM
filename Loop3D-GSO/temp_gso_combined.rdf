    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sub&gt;3&lt;/sub&gt;B&lt;sub&gt;7&lt;/sub&gt;O&lt;sub&gt;13&lt;/sub&gt;Cl</gsmin:imachemistry>
