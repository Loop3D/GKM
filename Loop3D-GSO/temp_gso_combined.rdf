    <gsmin:statusnotes xml:lang="en">Plášil, J., Kampf, A.R., Olds, T.A., Sejkora, J., Škoda, R., Burns, P.C. and Cejka, J. (2017) Kroupaite, IMA 2017-031. CNMNC Newsletter No. 38, August 2017, page 1036; Mineralogical Magazine, 81, 1033–1038</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/majakite">
