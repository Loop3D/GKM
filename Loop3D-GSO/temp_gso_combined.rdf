    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">AgPb&lt;sub&gt;2&lt;/sub&gt;F&lt;sub&gt;2&lt;/sub&gt;Cl&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1969-038</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Silver dilead difluoride trichloride</gsmin:iupacchemname>
    <gsmin:mindatid>min-662</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:662:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-662.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">AgPb&lt;sub&gt;2&lt;/sub&gt;F&lt;sub&gt;2&lt;/sub&gt;Cl&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bideauxite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Bideauxite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Williams S A (1970) Bideauxite, a new Arizona mineral, Mineralogical Magazine 37, 637-640 Chemical composition modified: Cooper M A, Hawthorne F C, Merlino S, Pasero M, Perchiazzi N (1999) Stereoactive lone-pair behavior of Pb in the crystal structure of bideauxite: Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Ag&lt;sup&gt;+&lt;/sup&gt;Cl&lt;sub&gt;3&lt;/sub&gt;F(OH), The Canadian Mineralogist 37, 915-921</gsmin:statusnotes>
    <gsmin:strunzcodeV10>03.DB.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Double-, Oxy- or Hydroxy-  halide with Pb, Cu, etc.</gsmin:strunzlabel>
