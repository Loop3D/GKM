  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Swamp_Or_Marsh_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al 2005, Soil Science Society of America, 1997.</dct:source>
    <rdfs:comment xml:lang="en">A water-saturated, periodically wet or continually flooded area with the surface not deeply submerged, essentially without the formation of peat. Marshes are characterized by sedges, cattails, rushes, or other aquatic and grasslike vegetation. Swamps are characterized by tree and brush vegetation.</rdfs:comment>
    <rdfs:label xml:lang="en">swamp or marsh setting</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicsetting/Wetland_Setting"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfault/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-26</dct:created>
    <dct:creator rdf:resource="https://w3id.org/gso/1.0/common/boyan_brodaric"/>
    <dct:creator rdf:resource="https://w3id.org/gso/1.0/common/stephen_richard"/>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/legalcode"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-26</dct:modified>
    <dct:publisher>ARC Loop3D project;  https://loop3d.org/</dct:publisher>
    <dct:publisher>Geological Survey of Canada, Natural Resources Canada, Government of Canada</dct:publisher>
    <schema:codeRepository>https://github.com/Loop3D/GKM</schema:codeRepository>
    <dct:rights>Copyright (c) 2021 Government of Canada</dct:rights>
    <rdfs:comment xml:lang="en">This module includes extensions for describing faults in more detail. (ie, a summary of movement type and orientation) as defined by the IUGS Commission for Geoscience Information (CGI) Geoscience Terminology Working Group. Although the terms in this vocabulary are in common usage with definitions in standard texts or glossaries like Neuendorf et al. (2005), the definitions here attempt to establish unambiguous criteria to distinguish the categories, and are thus listed with this vocabulary as the source. Adapted from CGI vocabulary for this ontology</rdfs:comment>
    <rdfs:label xml:lang="en">Geoscience Ontology, Faults</rdfs:label>
    <dct:bibliographicCitation>Brodaric, B., and Richard, S.M., 2021, The GeoScience Ontology Reference: Geological Survey of Canada Open File 8796, 34 p., https://doi.org/10.4095/328296</dct:bibliographicCitation>
    <owl:imports rdf:resource="https://w3id.org/gso/1.0/common/ontology"/>
    <owl:imports rdf:resource="https://w3id.org/gso/1.0/geologicprocess/ontology"/>
    <owl:imports rdf:resource="https://w3id.org/gso/1.0/geologicquality/ontology"/>
    <owl:imports rdf:resource="https://w3id.org/gso/1.0/geology/ontology"/>
    <owl:imports rdf:resource="https://w3id.org/gso/1.0/quality/ontology"/>
    <skos:definition xml:lang="en">Geologic faults.</skos:definition>
    <skos:prefLabel xml:lang="en">Geoscience Ontology, Faults</skos:prefLabel>
  </rdf:Description>
