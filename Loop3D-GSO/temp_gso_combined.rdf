    <gsmin:rruffnameplain xml:lang="en">Ammoniovoltaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Zhitova E S, Siidra O I, Belakovsky D I, Shilovskikh V V, Nuzhdaev A A, Ismagilova R M (2018) Ammoniovoltaite, (NH_4_)_2_Fe^2+^_5_Fe^3+^_3_Al(SO_4_)_12_(H_2_O)_18_, a new mineral from the Severo-Kambalny geothermal field, Kamchatka, Russia. Mineralogical Magazine 82, 1057-1077</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Voltaite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/heyite">
