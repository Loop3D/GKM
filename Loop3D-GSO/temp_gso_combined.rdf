    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al&lt;sub&gt;16&lt;/sub&gt;B&lt;sub&gt;4&lt;/sub&gt;Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;38&lt;/sub&gt;</gsmin:rruffchemistry>
