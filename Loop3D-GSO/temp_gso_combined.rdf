  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/zinczippeite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Zinczippeite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Zn | U | O | S | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">zippeite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/zinczippeite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)O&lt;sub&gt;2&lt;/sub&gt;·3.5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1971-008</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Renamed|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4408</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4408:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4408.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sup&gt;2+&lt;/sup&gt;(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)O&lt;sub&gt;2&lt;/sub&gt;·3.5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zinczippeite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Zinczippeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Frondel C, Ito J, Honea R M, Weeks A M (1976) Mineralogy of the zippeite group, The Canadian Mineralogist 14, 429-436 Name changed from zinc-zippeite: Burke E A J (2008) Tidying up mineral names: an IMA-CNMNC scheme for suffixes, hyphens and diacritical marks, The Mineralogical Record 39, 131-135</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Zippeite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.EC.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl sulfate, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Zinc-zippeite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1971-008</gsmin:wikipediadate>
  </rdf:Description>
