    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4176:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4176.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;PO&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R150143 | R070312 | R160003</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Veszelyite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Veszelyite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Schrauf A (1874) Untersuchung eines neuen Mineral's, genannt Veszelyit, Anzeiger der Kaiserlichen Akademie der Wissenschaften 11, 135-137</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.DA.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With small (and occasionally larger) cations</gsmin:strunzlabel>
