    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KAl&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;3&lt;/sub&gt;Al)O&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2815</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2815:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2815.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KAl&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;3&lt;/sub&gt;Al)O&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R040104 | R040108 | R040124 | R050080 | R050188 | R050198 | R060182 | R060266 | R061120 | R100147</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Muscovite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Muscovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Preciously known under related names like muscovy glass, but the current name was introduced in this publication: Dana J D (1850) Mica Family: Muscovite, in A System of Mineralogy, Third Edition, George P Putnam (New York) 356-358</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Clay</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EC.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with mica sheets, composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Muscovite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1794</gsmin:wikipediadate>
  </rdf:Description>
