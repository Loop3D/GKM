    <gsmin:rruffnameplain xml:lang="en">Foretite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mills S J, Kampf A R, McDonald A M, Favreau G, Chiappero P J (2012) Forêtite, a new secondary arsenate mineral from the Cap Garonne mine, France, Mineralogical Magazine 76, 769-775</gsmin:statusnotes>
