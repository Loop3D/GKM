    <gsmin:chemistryelements>Zn | Al | Fe | Ti | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">hogbomite</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Zn,Al,Fe)&lt;sub&gt;3&lt;/sub&gt;(Al,Fe,Ti)&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;15&lt;/sub&gt;(OH)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1994-016</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Renamed|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-7386</gsmin:mindatid>
