  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/shafranovskite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Shafranovskite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | K | Mn | Fe | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/shafranovskite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;3&lt;/sub&gt;K&lt;sub&gt;2&lt;/sub&gt;(Mn,Fe,Na)&lt;sub&gt;4&lt;/sub&gt;[Si&lt;sub&gt;9&lt;/sub&gt;(O,OH)&lt;sub&gt;27&lt;/sub&gt;](OH)&lt;sub&gt;2&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1981-048</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3629</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3629:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3629.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;3&lt;/sub&gt;K&lt;sub&gt;2&lt;/sub&gt;(Mn&lt;sup&gt;2+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;,Na)&lt;sub&gt;4&lt;/sub&gt;[Si&lt;sub&gt;9&lt;/sub&gt;(O,OH)&lt;sub&gt;27&lt;/sub&gt;](OH)&lt;sub&gt;2&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Shafranovskite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Shafranovskite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Khomyakov A P, Vrublevskaya Z V, Zvyagin B B, Mateeva N A, Piloyan G O (1982) Shafranovskite (Na,K)_6_(Mn,Fe)_3_Si_9_O_24_·6H_2_O, a new mineral, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 111(4), 475-480 Chemical formula redefined: Krivovichev S V, Yakovenchuk V N, Armbruster T, Pakhomovsky Y A, Weber H P, Depmeier W (2004) Synchrotron X-ray diffraction study of the structure of shafranovskite, K_2_Na_3_(Mn,Fe,Na)_4_[Si_9_(O,OH)_27_]·nH_2_O, a rare manganese silicate from Kola peninsula, Russia, American Mineralogist 89, 1816-1821</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.EE.65</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate: Single tetrahedral nets of 6-membered rings connected by octahedral nets or octahedral bands</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Shafranovskite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1981-048</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/batagayite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Batagayite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Zn | Cu | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaZn&lt;sub&gt;2&lt;/sub&gt;(Zn,Cu)&lt;sub&gt;6&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;[PO&lt;sub&gt;3&lt;/sub&gt;(OH)]&lt;sub&gt;3&lt;/sub&gt;·12H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2017-002</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaZn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(Zn&lt;sup&gt;2+&lt;/sup&gt;,Cu&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;6&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;[PO&lt;sub&gt;3&lt;/sub&gt;(OH)]&lt;sub&gt;3&lt;/sub&gt;·12H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Batagayite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Batagayite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Yakovenchuk V N, Pakhomovsky Y A, Konopleva N G, Panikorovskii T L, Bazai A, Mikhailova J A, Bocharov V N, Ivanyuk G Y, Krivovichev S V (2018) Batagayite, CaZn_2_(Zn,Cu)_6_(PO_4_)_4_(PO_3_OH)_3_·12H_2_O, a new phosphate mineral from Këster tin deposit (Yakutia, Russia): occurrence and crystal structure. Mineralogy and Petrology 112, 591-601</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/metasaleeite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Metasaléeite</rdfs:label>
