  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kimzeyite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kimzeyite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Zr | Si | Al | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">garnet</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/kimzeyite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;3&lt;/sub&gt;Zr&lt;sub&gt;2&lt;/sub&gt;(SiAl&lt;sub&gt;2&lt;/sub&gt;)O&lt;sub&gt;12&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2209</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2209:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2209.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;3&lt;/sub&gt;Zr&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(Al&lt;sub&gt;2&lt;/sub&gt;Si)O&lt;sub&gt;12&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060148</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kimzeyite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kimzeyite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Milton C, Blade L V (1958) Preliminary note on kimzeyite, a new zirconium garnet. Science 127, 1343-1343 Chemical formula changed from Ca_3_(Zr,Ti)_2_(Si,Al,Fe^3+^)_3_O_12_: Grew E S, Locock A J, Mills S J, Galuskina I O, Galuskin E V, Hålenius U (2013) Nomenclature of the garnet supergroup. American Mineralogist 98, 785-811</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Garnet</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AD.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate without additional anions; cations in [6] and/or greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Kimzeyite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1961</gsmin:wikipediadate>
  </rdf:Description>
