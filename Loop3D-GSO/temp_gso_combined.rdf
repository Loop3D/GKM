    <gsmin:chemistryelements>Na | Mn | Si | O | H | As</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaMn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;[Si&lt;sub&gt;5&lt;/sub&gt;O&lt;sub&gt;14&lt;/sub&gt;(OH)](AsO&lt;sub&gt;3&lt;/sub&gt;)(OH)</gsmin:imachemistry>
