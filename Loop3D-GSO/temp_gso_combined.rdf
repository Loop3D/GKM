    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">PbFe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;12&lt;/sub&gt;O&lt;sub&gt;19&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Lead dodecaironIII nonadecaoxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-2539</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2539:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2539.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;12&lt;/sub&gt;O&lt;sub&gt;19&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060074</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Magnetoplumbite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Magnetoplumbite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Aminoff G (1925) Über ein neues oxydisches mineral aus Långban (Magnetoplumbit), Geologiska Föreningens i Stockholm Förhandlingar 47, 283-289</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Plumboferrite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.CC.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 2: 3,3: 5, and similar, With large and medium-sized cations</gsmin:strunzlabel>
