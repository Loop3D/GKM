    <gsmin:rruffids>R060356</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Proustite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Proustite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Beudant F S (1832) Proustite, argent antimonié sulfuré en partie, in Traité Élémentaire de Minéralogie, 2nd Edition, (Paris) 445-447</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.GA.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Neso-sulfarsenite without additional S</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Proustite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1832</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/nollmotzite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
