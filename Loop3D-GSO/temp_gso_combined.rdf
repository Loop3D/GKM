    <gsmin:rruffids>R070583 | R080004</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Groutite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Groutite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Gruner J W (1947) Groutite, HMnO_2_, a new mineral of the diaspore-goethite group, American Mineralogist 32, 654-659</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.FD.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Hydroxide (without V or U), Hydroxides with OH, without H2O; chains of edge-sharing octahedra</gsmin:strunzlabel>
