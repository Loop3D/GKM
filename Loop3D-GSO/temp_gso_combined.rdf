  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/erythrosiderite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Erythrosiderite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Fe | Cl | H | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/erythrosiderite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;Cl&lt;sub&gt;5&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dipotassium ironIII pentachlorid monohydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1408</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1408:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1408.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;Cl&lt;sub&gt;5&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R120084</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Erythrosiderite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Erythrosiderite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named eritrosidero: Scacchi A (1872) Notizie preliminari di alcune specie mineralogiche rinvenute nel Vesuvio dopo l'incendio di aprile 1872, Rendiconto dell'Accademia delle Scienze Fisiche e Matematiche (sezione della Societa reale di Napoli) 11, 210-213</gsmin:statusnotes>
    <gsmin:strunzcodeV10>03.CJ.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Complex halide with MX6 complexes</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Erythrosiderite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1872</gsmin:wikipediadate>
  </rdf:Description>
