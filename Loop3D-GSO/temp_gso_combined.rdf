    <gsmin:mindaturl>http://www.mindat.org/min-2794.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(V&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mounanaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Mounanaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Cesbron F, Fritsche J (1969) La mounanaïte, nouveau vanadate de fer et de plomb hydraté, Bulletin de la Société Française de Minéralogie et de Cristallographie 92, 196-202 Fleischer M (1969) New mineral names, American Mineralogist 54, 1737-1742</gsmin:statusnotes>
