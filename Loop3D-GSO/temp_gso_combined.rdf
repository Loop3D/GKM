  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/roxbyite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Roxbyite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic, monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/roxbyite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;9&lt;/sub&gt;S&lt;sub&gt;5&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1986-010</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Nonacopper pentasulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-3468</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3468:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3468.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;1.78&lt;/sub&gt;S</gsmin:rruffchemistry>
    <gsmin:rruffids>R070676</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Roxbyite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Roxbyite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mumme W G, Sparrow G J, Walker G S (1988) Roxbyite, a new copper sulphide mineral from the Olympic Dam deposit, Roxby Downs, South Australia, Mineralogical Magazine 52, 323-330 Jambor J L, Vanko D A (1989) New mineral names, American Mineralogist 74, 946-951</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.BA.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide M:S &gt; 1:1 with Cu, Ag, Au</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Roxbyite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1986-010</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/sulfhydrylbystrite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Sulfhydrylbystrite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | K | Ca | Al | Si | O | S | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;5&lt;/sub&gt;K&lt;sub&gt;2&lt;/sub&gt;Ca[Al&lt;sub&gt;6&lt;/sub&gt;Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;](S&lt;sub&gt;5&lt;/sub&gt;)&lt;sup&gt;2-&lt;/sup&gt;(SH)&lt;sup&gt;-&lt;/sup&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2015-010</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Pending publication</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;5&lt;/sub&gt;K&lt;sub&gt;2&lt;/sub&gt;Ca[Al&lt;sub&gt;6&lt;/sub&gt;Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;](S&lt;sub&gt;5&lt;/sub&gt;)&lt;sup&gt;2-&lt;/sup&gt;(SH)&lt;sup&gt;1-&lt;/sup&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sulfhydrylbystrite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Sulfhydrylbystrite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Sapozhnikov, A.N., Kaneva, E.V., Suvorova, L.F., Levitsky, V.I., Ivanova, L.A., Mitichkin, M.A. and Barash, I.G. (2015) Sulfhydrylbystrite, IMA 2015-010. CNMNC Newsletter No. 25, June 2015, page 534; Mineralogical Magazine, 79, 529-535</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Cancrinite-sodalite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/chrysoberyl">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Chrysoberyl</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Be | Al | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/chrysoberyl.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BeAl&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Beryllium dialuminium tetraoxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-1039</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1039:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1039.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BeAl&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R040073 | R080110 | RS664626 | RS773050 | R100130 | R110103 | R110114 | RS708759</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Chrysoberyl</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Chrysoberyl</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named Krisoberil: Hoffmann C A S (1789) Mineralsystem des Herrn Inspektor Werners mit dessen erlaubnis herausgegeben von C A S Hoffmann. 2) Krisoberil, Bergmannisches Journal 1, 369-398</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Olivine</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.BA.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 3:4 and similar, With small and medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Chrysoberyl.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1789</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/sabinaite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Sabinaite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ti | Zr | O | C</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/sabinaite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;4&lt;/sub&gt;TiZr&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1978-071</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Tetrasodium titanium dizirconium tetraoxy tetracarbonate</gsmin:iupacchemname>
    <gsmin:mindatid>min-3495</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3495:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3495.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;4&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;Zr&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R110174</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sabinaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Sabinaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Jambor J L, Sturman B D, Weatherly G C (1980) Sabinaite, a new anhydrous zirconium-bearing carbonate mineral from Montreal Island, Québec, The Canadian Mineralogist 18, 25-29 Chemical formula revised: Chao G Y, Jiexiang G (1985) Sabinaite: a new occurrence and new data, The Canadian Mineralogist 23, 17-19</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.BB.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions, without H2O, With alkalies, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Sabinaite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>0</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologictime/BaseDanian">
