    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;Al&lt;sub&gt;2&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060760 | R090038</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Dundasite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Dundasite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Petterd W F (1894) A catalogue of the minerals known to occur in Tasmania, with notes on their distribution, Papers and Proceedings of the Royal Society of Tasmania for 1893 1984, 1-72</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Dundasite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>05.DB.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions and H2O, With large and medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Dundasite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1894</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/pirquitasite">
