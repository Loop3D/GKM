    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;8&lt;/sub&gt;(Si&lt;sub&gt;6&lt;/sub&gt;Al&lt;sub&gt;6&lt;/sub&gt;)O&lt;sub&gt;24&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2936</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2936:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2936.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;8&lt;/sub&gt;(Si&lt;sub&gt;6&lt;/sub&gt;Al&lt;sub&gt;6&lt;/sub&gt;)O&lt;sub&gt;24&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R050422</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nosean</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Nosean</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named nosian: Klaproth M H (1815) Chemische Untersuchung des Spinellan's, Beiträge zur Chemischen Kenntniss der Mineralkörper 6, 371-376</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Cancrinite-sodalite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.FB.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Tektosilicate with additional anions</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Nosean.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1815</gsmin:wikipediadate>
