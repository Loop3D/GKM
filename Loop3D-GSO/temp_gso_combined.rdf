  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/brittlemica">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">a sub-class of micas that contain divalent interlayer cations. The chemical bonding of the divalent cations as well as the concomitant substitution of AL for Si changes the physical nature of the mica from elastic to brittle and hence the origin of the name.</rdfs:comment>
    <rdfs:label xml:lang="en">Brittle Mica</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/mineral/micagroup"/>
    <gsmin:mindatid>min-43757</gsmin:mindatid>
    <gsmin:mindaturl>https://www.mindat.org/min-43757.html</gsmin:mindaturl>
  </rdf:Description>
