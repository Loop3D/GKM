    <gsmin:structuralgroup xml:lang="en">Pyrochlore-Pyrochlore</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/helmutwinklerite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Helmutwinklerite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Zn | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">tsumcorite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/helmutwinklerite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">PbZn&lt;sub&gt;2&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1979-010</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Lead dizinc diarsenate dihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1854</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1854:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1854.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Helmutwinklerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Helmutwinklerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Süsse P, Schnorrer G (1980) Helmutwinklerite, a new arsenate mineral from Tsumeb, S. W. Africa. Neues Jahrbuch für Mineralogie, Monatshefte 1980, 118-124</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Helmutwinklerite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CG.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With large and medium-sized cations, RO4:H2O = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Helmutwinklerite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1979-010</gsmin:wikipediadate>
  </rdf:Description>
