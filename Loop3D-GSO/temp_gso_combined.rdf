    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:692:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-692.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">BaMn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R130107 | R130106</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bjarebyite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Bjarebyite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Moore P B, Lund D H, Keester K L (1973) Bjarebyite, (Ba,Sr)(Mn,Fe,Mg)&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;, a new species, The Mineralogical Record 4, 282-285</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Bjarebyite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BH.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH,etc.):RO4 = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Bjarebyite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1972-022</gsmin:wikipediadate>
  </rdf:Description>
