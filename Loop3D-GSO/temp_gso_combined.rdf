    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3288:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3288.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Prosperite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Prosperite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Gait R I, Sturman D, Dunn P J (1979) Prosperite, HCaZn2(AsO4)2(OH), a new mineral from Tsumeb, South West Africa (Namibia), The Canadian Mineralogist 17, 87-92 Fleischer M, Pabst A, Mandarino J A (1980) New mineral names, American Mineralogist 65, 205-210 Chemical formula redefined: Keller P, Riffel H, Hess H (1982) Die kristallstruktur von prosperit, Ca2Zn4[H2O|(AsO4)4], Zeitschrift für Kristallographie 158, 33-42</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.CA.60</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With small and large/medium cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Prosperite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1978-028</gsmin:wikipediadate>
  </rdf:Description>
