    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2726:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2726.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;8&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Misenite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Misenite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Scacchi A (1849) Memoria IIIa. Esame delle sostanze che si formano presso i fumaroli della Regione Flegrea, Memorie Geologiche sulla Campania 3a, (Napoli) 83-131</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.AD.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, without H2O, With only large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Misenite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1849</gsmin:wikipediadate>
