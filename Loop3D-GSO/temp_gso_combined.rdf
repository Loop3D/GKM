    <gsmin:rruffnameplain xml:lang="en">Frankamenite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Nikishova L V, Lazebnik K A, Rozhdestvenskaya I V, Emelyanova N N, Lazebnik Y D (1996) Frankamenite K_3_Na_3_Ca_5_(Si_12_O_30_)F_3_(OH)·H_2_O - a new mineral, triclinic variety of canasite from charoitites, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 125(2), 106-108</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.DG.90</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 3-periodic single and multiple chains</gsmin:strunzlabel>
