    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:38693:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-38693.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;(Na&lt;sub&gt;2&lt;/sub&gt;Bi&lt;sup&gt;3+&lt;/sup&gt;)(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;Cl</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Aiolosite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Aiolosite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Demartin F, Gramaccioli C M, Campostrini I, Pilati T (2010) Aiolosite, Na&lt;sub&gt;2&lt;/sub&gt;(Na&lt;sub&gt;2&lt;/sub&gt;Bi)(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;Cl, a new sulfate isotypic to apatite from La Fossa Crater, Vulcano, Aeolian Islands, Italy, American Mineralogist 95, 382-385</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Apatite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.BD.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions, without H2O, With only large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Aiolosite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2008-015</gsmin:wikipediadate>
  </rdf:Description>
