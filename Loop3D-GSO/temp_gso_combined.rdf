    <gsmin:statusnotes xml:lang="en">Genkin A D, Murav´eva I V, Troneva N V (1966) Zvyagintsevite, a natural intermetallic compound of palladium, platinum, lead, and tin, Geologiya Rudnykh Mestorozhdenii 8, 94-100</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Perovskite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>01.AG.10</gsmin:strunzcodeV10>
