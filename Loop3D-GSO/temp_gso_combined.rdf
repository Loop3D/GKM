    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;1+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: DicopperI dicopperII trioxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-3098</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3098:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3098.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;1+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Paramelaconite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Paramelaconite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Koenig G A (1891) On paramelaconite, and the associated minerals, Proceedings of the Academy of Natural Sciences of Philadelphia 1891, 284-291</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.AA.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 2:1 and 1:2, Cation:Anion (M:O) = 2:1 (and 1.8:1)</gsmin:strunzlabel>
