  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicunit/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">Geoscience Ontology, Geologic Unit</rdfs:label>
    <dct:bibliographicCitation>Brodaric, B., and Richard, S.M., 2021, The GeoScience Ontology Reference: Geological Survey of Canada Open File 8796, 34 p., https://doi.org/10.4095/328296</dct:bibliographicCitation>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-26</dct:created>
    <dct:creator rdf:resource="https://w3id.org/gso/1.0/common/boyan_brodaric"/>
    <dct:creator rdf:resource="https://w3id.org/gso/1.0/common/stephen_richard"/>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/legalcode"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-26</dct:modified>
    <dct:publisher>ARC Loop3D project;  https://loop3d.org/</dct:publisher>
    <dct:publisher>Geological Survey of Canada, Natural Resources Canada, Government of Canada</dct:publisher>
    <dct:rights>Copyright (c) 2021 Government of Canada</dct:rights>
    <rdfs:comment xml:lang="en">This ontology specifies concepts for description of Geologic Unit, adopted from the IUGS Commission for Geoscience Information (CGI) Geoscience Terminology Working Group. These classes and properties extend the base GSO-Geology ontology for more detailed descriptions. Unit types are differentiated based on their defining lithological, stratigraphic, or other physical properties.</rdfs:comment>
    <owl:imports rdf:resource="http://topbraid.org/spin/spinowl"/>
    <owl:imports rdf:resource="https://w3id.org/gso/1.0/common/ontology"/>
    <owl:imports rdf:resource="https://w3id.org/gso/1.0/feature/ontology"/>
    <owl:imports rdf:resource="https://w3id.org/gso/1.0/geologicfeature/ontology"/>
    <owl:imports rdf:resource="https://w3id.org/gso/1.0/geologicprocess/ontology"/>
    <owl:imports rdf:resource="https://w3id.org/gso/1.0/geologictime/ontology"/>
    <owl:imports rdf:resource="https://w3id.org/gso/1.0/geology/ontology"/>
    <skos:definition xml:lang="en">Shared elements for geoscience ontology</skos:definition>
    <skos:prefLabel xml:lang="en">Geoscience Ontology, Geologic Unit</skos:prefLabel>
    <schema:codeRepository>https://github.com/Loop3D/GKM</schema:codeRepository>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kazakovite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kazakovite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Mn | Ti | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">lovozerite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/kazakovite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;6&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;TiSi&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1973-061</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2172</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2172:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2172.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;6&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kazakovite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kazakovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Khomyakov A P, Semenov E I, Es´kova E M, Voronkov A A (1974) Kazakovite - a new mineral of the lovozerite group, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 103(3), 342-345</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Lovozerite-Zirsinalite–Lovozerite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CJ.15a</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si6O18]12- 6-membered single rings (sechser-Einfachringe), without insular complex anions</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Kazakovite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1973-061</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n487acc5da05049618fd9508bab26ad38b21">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/gso/1.0/common/hostedBy"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/gso/1.0/geologicfault/Fault"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Calcsilicate_Metamorphic_Rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source>This vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Overlaps into metasomatic rocks because of high mobility of Ca carbonates. Typically rich in epidote, diopside, tremolite, calcic-amphibole, talc, with quartz and calcite. Might be gneiss or granofels; lower metamorphic grade than granulite.</rdfs:comment>
    <rdfs:label xml:lang="en">calc silicate metamorphic rock</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Metamorphic_Rock"/>
    <skos:definition xml:lang="en">metamorphic rock containing abundant calcium-silicate minerals</skos:definition>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/margarosanite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Margarosanite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Pb | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/margarosanite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;PbSi&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;9&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2574</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2574:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2574.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Pb&lt;sup&gt;2+&lt;/sup&gt;Si&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;9&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R120111</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Margarosanite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Margarosanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Ford W E, Bradley W M (1916) Margarosanite, a new lead-calcium silicate from Franklin, N. J., American Journal of Science 42, 159-162</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.CA.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si3O9]6- 3-membered single rings (dreier-Einfachringe), without insular complex anions</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Margarosanite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1916</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/szomolnokite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Szomolnokite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Fe | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">kieserite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/szomolnokite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe(SO&lt;sub&gt;4&lt;/sub&gt;)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3859</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3859:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3859.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070620</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Szomolnokite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Szomolnokite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Krenner J (1928) Zwei neue Mineralien aus Ungarn, Zentralblatt für Mineralogie, Geologie und Paläontologie 1928, 265-271</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Kieserite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.CB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, with H2O, With only medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Szomolnokite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1928</gsmin:wikipediadate>
  </rdf:Description>
