  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/pushcharovskite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Pushcharovskite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Cu | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/pushcharovskite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;0.6&lt;/sub&gt;Cu&lt;sub&gt;18&lt;/sub&gt;[AsO&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;]&lt;sub&gt;4&lt;/sub&gt;[AsO&lt;sub&gt;3&lt;/sub&gt;OH]&lt;sub&gt;10&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)(OH)&lt;sub&gt;9.6&lt;/sub&gt;·18.6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1995-048</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-7258</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7258:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7258.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;0.6&lt;/sub&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;18&lt;/sub&gt;[As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;]&lt;sub&gt;4&lt;/sub&gt;[As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;OH]&lt;sub&gt;10&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)(OH)&lt;sub&gt;9.6&lt;/sub&gt;·18.6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pushcharovskite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Pushcharovskite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Sarp H, Sanz-Gysler J (1997) La pushcharovskite, Cu(AsO3,OH)·H2O, un nouveau minéral de la mine de Cap Garronne, Var (France), Archives des Sciences, Genève 50, 177-186 Jambor J L, Roberts A C (1999) New mineral names, American Mineralogist 84, 193-198</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.CA.55</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With small and large/medium cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Pushcharovskite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1995-048</gsmin:wikipediadate>
  </rdf:Description>
