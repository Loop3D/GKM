    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;4&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Tetralead sulfate dicarbonate dihydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-2361</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2361:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2361.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050642 | R060047</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Leadhillite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Leadhillite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Beudant F S (1832) Leadhillite, plomb carbonaté rhomboédrique, in Traité Élémentaire de Minéralogie, 2nd Edition, (Paris) 366-367</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.BF.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions, without H2O, With (Cl), SO4, PO4, TeO3</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Leadhillite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1832</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ullmannite">
