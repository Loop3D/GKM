    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Si | Al | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic, orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">zeolite-stilbite series</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaCa&lt;sub&gt;4&lt;/sub&gt;(Si&lt;sub&gt;27&lt;/sub&gt;Al&lt;sub&gt;9&lt;/sub&gt;)O&lt;sub&gt;72&lt;/sub&gt;·28H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaCa&lt;sub&gt;4&lt;/sub&gt;(Si&lt;sub&gt;27&lt;/sub&gt;Al&lt;sub&gt;9&lt;/sub&gt;)O&lt;sub&gt;72&lt;/sub&gt;·28H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R050012 | R050106</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Stilbite-Ca</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Stilbite-Ca</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Haüy R J (1801) Stilbite, Traité de minéralogie 3, 161-166 Name changed from stilbite: Coombs D S, Alberti A, Armbruster T, Artioli G, Colella C, Galli E, Grice J D, Liebau F, Mandarino J A, Minato H, Nickel E H, Passaglia E, Peacor D R, Quartieri S, Rinaldi R, Ross M, Sheppard R A, Tillmanns E, Vezzalini G, (1997) Recommended nomenclature for zeolite minerals: report of the Subcommittee on Zeolites of the International Mineralogical Association, Commission on New Minerals and Mineral Names, The Canadian Mineralogist 35, 1571-1606</gsmin:statusnotes>
  </rdf:Description>
