  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/leightonite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Leightonite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Ca | Cu | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/leightonite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;Ca&lt;sub&gt;2&lt;/sub&gt;Cu(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dipotassium dicalcium copper tetrasulfate dihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2369</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2369:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2369.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;Ca&lt;sub&gt;2&lt;/sub&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R050211</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Leightonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Leightonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Palache C (1938) Leightonite, a new sulphate of copper from Chile, American Mineralogist 23, 34-37</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.CC.70</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, with H2O, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Leightonite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1938</gsmin:wikipediadate>
