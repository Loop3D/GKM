    <gsmin:chemistryelements>Mg | Al | O | Si</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic, triclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">aenigmatite</gsmin:fleischersgroup>
