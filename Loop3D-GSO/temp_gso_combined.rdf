    <gsmin:rruffnameplain xml:lang="en">Kolovratite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Vernadskij V (1922) A new nickel mineral kolovratite, Doklady Rossijskoj Akademii Nauk 1922, 37-37</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.CB.50</gsmin:strunzcodeV10>
