  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicsetting/Distributary_Channel_Setting">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al., 2005</dct:source>
    <rdfs:comment xml:lang="en">A divergent stream flowing away from the main stream and not returning to it, as in a delta or on an alluvial plain</rdfs:comment>
