    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;4&lt;/sub&gt;(Mg&lt;sub&gt;3&lt;/sub&gt;Al&lt;sub&gt;9&lt;/sub&gt;)O&lt;sub&gt;4&lt;/sub&gt;[Si&lt;sub&gt;3&lt;/sub&gt;Al&lt;sub&gt;9&lt;/sub&gt;O&lt;sub&gt;36&lt;/sub&gt;]</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3531</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3531:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3531.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;4&lt;/sub&gt;(Mg&lt;sub&gt;3&lt;/sub&gt;Al&lt;sub&gt;9&lt;/sub&gt;)O&lt;sub&gt;4&lt;/sub&gt;[Si&lt;sub&gt;3&lt;/sub&gt;Al&lt;sub&gt;9&lt;/sub&gt;O&lt;sub&gt;36&lt;/sub&gt;]</gsmin:rruffchemistry>
    <gsmin:rruffids>R060073 | R060556 | R100135 | R100143</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sapphirine</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Sapphirine</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Stromeyer F (1819) 2. Saphirin von Fiskenaes oder Kikertarsoeitsiak, Göttingische Gelehrte Anzeigen 3, 1994-1995</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Sapphirine</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DH.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 4-periodic single chains, Si4O12</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Sapphirine.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1819</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/jonesite">
