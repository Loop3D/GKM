    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2704</gsmin:mindatid>
    <gsmin:mindaturl>http://www.mindat.org/min-2704.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KAlSi&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;8&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R040154 | R050054 | R050150 | R050193 | R120005 | R150015</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Microcline</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Microcline</gsmin:rruffnameplain>
