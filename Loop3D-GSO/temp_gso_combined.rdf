  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/dualite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Dualite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Ce | Sr | Mn | Fe | Ti | Zr | Si | O | H | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;30&lt;/sub&gt;(Ca,Na,Ce,Sr)&lt;sub&gt;12&lt;/sub&gt;(Na,Mn,Fe,Ti)&lt;sub&gt;6&lt;/sub&gt;Zr&lt;sub&gt;3&lt;/sub&gt;Ti&lt;sub&gt;3&lt;/sub&gt;MnSi&lt;sub&gt;51&lt;/sub&gt;O&lt;sub&gt;144&lt;/sub&gt;(OH,H&lt;sub&gt;2&lt;/sub&gt;O,Cl)&lt;sub&gt;9&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2005-019</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-27578</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:27578:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-27578.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;30&lt;/sub&gt;(Ca,Na,Ce,Sr)&lt;sub&gt;12&lt;/sub&gt;(Na,Mn&lt;sup&gt;2+&lt;/sup&gt;,Fe&lt;sup&gt;2+&lt;/sup&gt;,Ti&lt;sup&gt;4+&lt;/sup&gt;)&lt;sub&gt;6&lt;/sub&gt;Zr&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;Si&lt;sub&gt;51&lt;/sub&gt;O&lt;sub&gt;144&lt;/sub&gt;(OH,H&lt;sub&gt;2&lt;/sub&gt;O,Cl)&lt;sub&gt;9&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Dualite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Dualite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Khomyakov A P, Nechelyustov G N, Rastsvetaeva R K (2007) Dualite, Na&lt;sub&gt;30&lt;/sub&gt;(Ca,Na,Ce,Sr)&lt;sub&gt;12&lt;/sub&gt;(Na,Mn,Fe,Ti)&lt;sub&gt;6&lt;/sub&gt;Zr&lt;sub&gt;3&lt;/sub&gt;Ti&lt;sub&gt;3&lt;/sub&gt;MnSi&lt;sub&gt;51&lt;/sub&gt;O&lt;sub&gt;144&lt;/sub&gt;(OH,H&lt;sub&gt;2&lt;/sub&gt;O,Cl)&lt;sub&gt;9&lt;/sub&gt;, a new zircono-titanosilicate with a modular eudialyte-like structure from Lovozero alkaline massif, Kola Peninsula, Russia, Zapiski Rossiiskogo Mineralogicheskogo Obshchetstva 136(4), 31-42</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Eudialyte</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CO.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si9O27]18- 9-membered rings</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://webmineral.com/data/Dualite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2005-019</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/krasheninnikovite">
