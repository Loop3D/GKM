    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3784:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3784.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;6&lt;/sub&gt;Cr&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;CO&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;16&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R050328 | R050475 | R060675</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Stichtite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Stichtite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Petterd W F (1910) Stichtite (carbonatohydrate of magnesium, chrome and iron), in Catalog of the Minerals of Tasmania 3rd Edition, J. Vail Hobart 167-169</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hydrotalcite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>05.DA.50</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions and H2O, With medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Stichtite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1910</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/reference">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    <rdfs:comment xml:lang="en">Undircted relation between an entity and its reference system</rdfs:comment>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/isFundamentallyRelatedTo"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/BaseMiddleMississippianSP2008">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologiccontact/GSSP"/>
    <dct:source xml:lang="en">Episodes 26/2, p. 105 –115, 2003</dct:source>
    <rdfs:comment xml:lang="en">base of bed 83 in the Pengchong Section, Pengchong, south China</rdfs:comment>
    <rdfs:label xml:lang="en">GSSP Base of Middle Mississippian / Visean</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://www.stratigraphy.org/GSSP/Visean.pdf"/>
    <rdfs:seeAlso rdf:resource="https://stratigraphy.org/gssps/"/>
    <owl:versionInfo>2008</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicrole/Porphyroclast">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source>Passchier C.W. &amp; Trouw R.A.J. (2005). Microtectonics. Springer Science &amp; Business Media. pp. 132-141. ISBN 9783540293590.; https://en.wikipedia.org/wiki/Porphyroclast</dct:source>
    <rdfs:comment xml:lang="en">A clast or mineral fragment in a metamorphic rock, surrounded by a groundmass of finer grained crystals. Porphyroclasts are fragments of the original rock before dynamic recrystallisation or cataclasis produced the groundmass. This means they are older than the groundmass.</rdfs:comment>
    <rdfs:label xml:lang="en">Porphyroclast </rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicrole/Paleoblast"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/Temporal_Quality">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Quality that specifies the temporal location or duration that is the extent of some TimeRegion</rdfs:comment>
    <rdfs:label xml:lang="en">Temporal Quality</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Quality"/>
    <rdfs:subClassOf rdf:nodeID="n7bda25761fc44f8595ef751309700190b451"/>
    <owl:equivalentClass rdf:nodeID="n7bda25761fc44f8595ef751309700190b452"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Foid_Syenite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">Foid syenitoid that has a plagioclase to total feldspar ratio of less than 0.1. Includes rocks defined modally in QAPF field 11.</rdfs:comment>
    <rdfs:label xml:lang="en">foid syenite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Foid_Syenitoid"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ferro-ferri-obertiite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ferro-ferri-obertiite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Fe | Ti | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaNa&lt;sub&gt;2&lt;/sub&gt;(Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;Ti)Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2009-034</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaNa&lt;sub&gt;2&lt;/sub&gt;(Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;)Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ferro-ferri-obertiite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ferro-ferri-obertiite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hawthorne F C, Ball N A, Czamanske G K (2010) Ferro-obertiite, NaNa_2_(Fe^2+^_3_Fe^3+^Ti)Si_8_O_22_O_2_, a new mineral species of the amphibole group from Coyote Peak, Humboldt County, California, The Canadian Mineralogist 48, 301-306 Name changed: Hawthorne F C, Oberti R, Harlow G E, Maresch W V, Martin R F, Schumacher J C, Welch M D (2012) Nomenclature of the amphibole supergroup. American Mineralogist 97, 2031-2048</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Amphibole</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/rowleyite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Rowleyite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | N | H | K | Cl | V | P | As | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">[Na(NH&lt;sub&gt;4&lt;/sub&gt;,K)&lt;sub&gt;9&lt;/sub&gt;Cl&lt;sub&gt;4&lt;/sub&gt;][V&lt;sup&gt;5+,4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(P,As)O&lt;sub&gt;8&lt;/sub&gt;]&lt;sub&gt;6&lt;/sub&gt;·n[H&lt;sub&gt;2&lt;/sub&gt;O,Na,NH&lt;sub&gt;4&lt;/sub&gt;,K,Cl]</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2016-037</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">[Na(N&lt;sup&gt;3-&lt;/sup&gt;H&lt;sub&gt;4&lt;/sub&gt;,K)&lt;sub&gt;9&lt;/sub&gt;Cl&lt;sub&gt;4&lt;/sub&gt;][(V&lt;sup&gt;5+&lt;/sup&gt;,V&lt;sup&gt;4+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;(P&lt;sup&gt;5+&lt;/sup&gt;,As&lt;sup&gt;5+&lt;/sup&gt;)O&lt;sub&gt;8&lt;/sub&gt;]&lt;sub&gt;6&lt;/sub&gt;·&lt;i&gt;n&lt;/i&gt;[H&lt;sub&gt;2&lt;/sub&gt;O,Na,N&lt;sup&gt;3-&lt;/sup&gt;H&lt;sub&gt;4&lt;/sub&gt;,K,Cl]</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Rowleyite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Rowleyite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf A R, Cooper M A, Nash B P, Cerling T E, Marty J, Hummer D R, Celestian A J, Rose T P, Trebisky T J (2017) Rowleyite, [Na(NH_4_,K)_9_Cl_4_][V_2_^5+,4+^(P,As)O_8_]_6_·n[H_2_O,Na,NH_4_,K,Cl], a new mineral with a microporous framework structure. American Mineralogist 102, 1037-1044</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/skos/annotation/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dct:contributor>Dave Beckett</dct:contributor>
    <dct:contributor>Nikki Rogers</dct:contributor>
    <dct:contributor>Participants in W3C's Semantic Web Deployment Working Group.</dct:contributor>
    <dct:creator>Alistair Miles</dct:creator>
    <dct:creator>Sean Bechhofer</dct:creator>
    <dct:creator rdf:resource="https://w3id.org/gso/1.0/common/stephen_richard"/>
    <dct:creator rdf:resource="https://w3id.org/gso/1.0/common/boyan_brodaric"/>
    <dct:description xml:lang="en">An RDF vocabulary for providing annotation to document other rdf resources; for the LOOP3D project.</dct:description>
    <dct:title xml:lang="en">SKOS Annotation Vocabulary</dct:title>
    <rdfs:label xml:lang="en">Geoscience Ontology, SKOS Annotation</rdfs:label>
    <rdfs:seeAlso rdf:resource="http://www.w3.org/TR/skos-reference/"/>
    <owl:versionInfo xml:lang="en">edited by Stephen Richard to only include skos annotation properties</owl:versionInfo>
    <owl:imports rdf:resource="https://w3id.org/gso/1.0/common/ontology"/>
    <skos:definition xml:lang="en">skos annotation classes used to document Geoscience Ontology documents</skos:definition>
    <skos:prefLabel xml:lang="en">Geoscience Ontology, SKOS Annotation</skos:prefLabel>
    <dct:bibliographicCitation>Brodaric, B., and Richard, S.M., 2021, The GeoScience Ontology Reference: Geological Survey of Canada Open File 8796, 34 p., https://doi.org/10.4095/328296</dct:bibliographicCitation>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-02-01</dct:created>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/legalcode"/>
    <schema:codeRepository>https://github.com/Loop3D/GKM</schema:codeRepository>
    <dct:rights>Copyright (c) 2021 Government of Canada</dct:rights>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-26</dct:modified>
    <dct:publisher>ARC Loop3D project;  https://loop3d.org/</dct:publisher>
    <dct:publisher>Geological Survey of Canada, Natural Resources Canada, Government of Canada</dct:publisher>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/oxo-mangani-leakeite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Oxo-mangani-leakeite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Mn | Li | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaNa&lt;sub&gt;2&lt;/sub&gt;(Mn&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Li)Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2015-035</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaNa&lt;sub&gt;2&lt;/sub&gt;(Mn&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Li)Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Oxo-mangani-leakeite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Oxo-mangani-leakeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Oberti R, Boiocchi M, Hawthorne F C, Ball N A, Ashley P M (2016) Oxo-mangani-leakeite from the Hoskins mine, New South Wales, Australia: occurrence and mineral description. Mineralogical Magazine 80, 1013-1021</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Amphibole</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologiccontact/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-26</dct:created>
    <dct:creator rdf:resource="https://w3id.org/gso/1.0/common/boyan_brodaric"/>
    <dct:creator rdf:resource="https://w3id.org/gso/1.0/common/stephen_richard"/>
    <dct:creator xml:lang="en">CGI Concept Definition Task Group, Stephen Richard OWL adoption for Loop3D project</dct:creator>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/legalcode"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-01-29</dct:modified>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-26</dct:modified>
    <dct:publisher>ARC Loop3D project;  https://loop3d.org/</dct:publisher>
    <dct:publisher>Geological Survey of Canada, Natural Resources Canada, Government of Canada</dct:publisher>
    <schema:codeRepository>https://github.com/Loop3D/GKM</schema:codeRepository>
    <dct:rights>Copyright (c) 2021 Government of Canada</dct:rights>
    <rdfs:comment xml:lang="en">This vocabulary specifies Contact Type types, primarily taken from the IUGS Commission for Geoscience Information (CGI) Geoscience Terminology Working Group. Originally designed for use in the contactType property in GeoSciML Contact elements, adopt here as subClasses of gscn:Contact to harmonize with this ontology.</rdfs:comment>
    <dct:bibliographicCitation>Brodaric, B., and Richard, S.M., 2021, The GeoScience Ontology Reference: Geological Survey of Canada Open File 8796, 34 p., https://doi.org/10.4095/328296</dct:bibliographicCitation>
    <rdfs:label xml:lang="en">Geoscience Ontology, Contact</rdfs:label>
    <owl:imports rdf:resource="https://w3id.org/gso/1.0/common/ontology"/>
    <owl:imports rdf:resource="https://w3id.org/gso/1.0/geologicfeature/ontology"/>
    <owl:imports rdf:resource="https://w3id.org/gso/1.0/geology/ontology"/>
    <owl:imports rdf:resource="https://w3id.org/gso/1.0/quality/ontology"/>
    <skos:definition xml:lang="en">Geologic contact types</skos:definition>
    <skos:prefLabel xml:lang="en">Geoscience Ontology, Contact</skos:prefLabel>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb26e920196f4af8bbd263b193e6f242b337">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/common/Uncertainty"/>
    <gsoc:hasDataValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.4</gsoc:hasDataValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfoliation/primary_foliation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Foliation formed during original process of deposition or crystallization of an igneous or sedimentary material.</rdfs:comment>
    <dct:source xml:lang="en">CGI foliationtype SKOS vocabulary 2018-08-03</dct:source>
    <rdfs:label xml:lang="en">primary foliation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicstructure/Foliation"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n6d111a80c3f44937a55e40566db5bca3b84">
    <rdf:first rdf:resource="https://w3id.org/gso/1.0/geologicunit/Facies"/>
    <rdf:rest rdf:nodeID="n6d111a80c3f44937a55e40566db5bca3b85"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n7bda25761fc44f8595ef751309700190b255">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/gso/1.0/common/occupiesTimeIndirectly"/>
    <owl:someValuesFrom rdf:resource="https://w3id.org/gso/1.0/common/Time_Region"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n7bda25761fc44f8595ef751309700190b353">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="https://w3id.org/gso/1.0/common/hasStaticPart"/>
