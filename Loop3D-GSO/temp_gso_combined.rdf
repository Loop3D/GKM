  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/scheuchzerite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Scheuchzerite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Mn | Si | V | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaMn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;9&lt;/sub&gt;Si&lt;sub&gt;9&lt;/sub&gt;V&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;28&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2004-044</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-27490</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:27490:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-27490.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaMn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;9&lt;/sub&gt;Si&lt;sub&gt;9&lt;/sub&gt;V&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;28&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Scheuchzerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Scheuchzerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Brugger J, Krivovichev S, Meisser N, Ansermet S, Armbruster T (2006) Scheuchzerite, Na(Mn,Mg)_9_[VSi_9_O_28_(OH)](OH)_3_, a new single-chain silicate, American Mineralogist 91, 937-943</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.DM.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 6-periodic single chains</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://webmineral.com/data/Scheuchzerite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2004-044</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/hectorfloresite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Hectorfloresite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | I | O | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/hectorfloresite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;9&lt;/sub&gt;(IO&lt;sub&gt;3&lt;/sub&gt;)(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1987-050a</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Nonasodium iodate tetrasulfate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1840</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1840:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1840.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;9&lt;/sub&gt;(I&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R080117</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hectorfloresite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hectorfloresite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Ericksen G E, Evans H T, Mrose M E, McGee J J, Marinenko J W, Konnert J A (1989) Mineralogical studies of the nitrate deposits of Chile: VI. Hectorfloresite, Na_9_(IO_3_)(SO_4_)_4_, a new saline mineral, American Mineralogist 74, 1207-1214</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.BD.60</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions, without H2O, With only large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Hectorfloresite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1987-050a</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/rancieite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ranciéite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Mn | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/rancieite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Mn&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;0.2&lt;/sub&gt;(Mn&lt;sup&gt;4+&lt;/sup&gt;,Mn&lt;sup&gt;3+&lt;/sup&gt;)O&lt;sub&gt;2&lt;/sub&gt;·0.6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3360</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3360:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3360.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Mn&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;0.2&lt;/sub&gt;(Mn&lt;sup&gt;4+&lt;/sup&gt;,Mn&lt;sup&gt;3+&lt;/sup&gt;)O&lt;sub&gt;2&lt;/sub&gt;·0.6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ranciéite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Rancieite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Leymerie A (1859) Ranciérite (partie du manganèse oxydé hydraté), in Cours de Minéralogie, Deuxième Partie, Victor Masson (Paris) 329-330 Chemical formula redefined: Ertl A, Pertlik F, Prem M, Post J E, Kim S J, Brandstatter F, Schuster R (2005) Ranciéite crystals from Friesach, Carinthia, Austria, European Journal of Mineralogy 17, 163-172</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.FL.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Hydroxide (without V or U), Hydroxides with H2O±(OH); sheets of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Rancieite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1857</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/turtmannite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Turtmannite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | O | V | Si | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sub&gt;25&lt;/sub&gt;O&lt;sub&gt;5&lt;/sub&gt;(VO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;20&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2000-007</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-11090</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:11090:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-11090.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;25&lt;/sub&gt;O&lt;sub&gt;5&lt;/sub&gt;(V&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;20&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070089</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Turtmannite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Turtmannite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Brugger J, Armbruster T, Meisser N, Hejny C, Grobety B (2001) Description and crystal structure of turtmannite, a new mineral with a 68 Å period related to mcgovernite, American Mineralogist 86, 1494-1505</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hematolite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BE.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With only medium-sized cations, (OH, etc.):RO4 &gt; 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Turtmannite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2000-007</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/hammarite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Hammarite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Pb | Bi | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">aikinite</gsmin:fleischersgroup>
