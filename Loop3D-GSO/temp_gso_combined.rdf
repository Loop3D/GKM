  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/tsangpoite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Tsangpoite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | P | O | Si</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;5&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2014-110</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Pending publication</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;5&lt;/sub&gt;(P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tsangpoite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tsangpoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hwang, S.-L., Shen, P., Chu, H.-T., Yui, T.-F., Varela, M.E. and Iizuka, Y. (2015) Tsangpoite, IMA 2014-110. CNMNC Newsletter No. 25, June 2015, page 533; Mineralogical Magazine, 79, 529-535</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ferrierite-na">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ferrierite-Na</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | K | Si | Al | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic, monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">zeolite-ferrierite series</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/ferrieritena.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,K)&lt;sub&gt;5&lt;/sub&gt;(Si&lt;sub&gt;31&lt;/sub&gt;Al&lt;sub&gt;5&lt;/sub&gt;)O&lt;sub&gt;72&lt;/sub&gt;·18H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-6932</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:6932:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-6932.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,K)&lt;sub&gt;5&lt;/sub&gt;(Si&lt;sub&gt;31&lt;/sub&gt;Al&lt;sub&gt;5&lt;/sub&gt;)O&lt;sub&gt;72&lt;/sub&gt;·18H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ferrierite-Na</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ferrierite-Na</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Described, but not named: Wise W S, Tschernich R W (1976) Chemical composition of ferrierite. American Mineralogist 61, 60-66 Named: Coombs D S, Alberti A, Armbruster T, Artioli G, Colella C, Galli E, Grice J D, Liebau F, Mandarino J A, Minato H, Nickel E H, Passaglia E, Peacor D R, Quartieri S, Rinaldi R, Ross M, Sheppard R A, Tillmanns E, Vezzalini G, (1997) Recommended nomenclature for zeolite minerals: report of the Subcommittee on Zeolites of the International Mineralogical Association, Commission on New Minerals and Mineral Names, The Canadian Mineralogist 35, 1571-1606</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.GD.50</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Zeolite family: Chains of 6-membered rings – tabular zeolites</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Ferrierite-Na.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1997</gsmin:wikipediadate>
  </rdf:Description>
