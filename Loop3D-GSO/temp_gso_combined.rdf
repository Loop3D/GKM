    <gsmin:rruffnameplain xml:lang="en">Tienshanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Dusmatov V D, Efimov A F, Alkhazov V Y, Kazakova M E, Mumyatskaya N G (1967) Tienshanite — a new mineral, Doklady Akademii Nauk SSSR 177, 678-680</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.CL.05</gsmin:strunzcodeV10>
