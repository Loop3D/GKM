    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Lisiguangite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Lisiguangite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Yu Z, Cheng F, Ma H (2009) Lisiguangite, CuPtBiS_3_, a new platinum-group mineral from the Yanshan Mountains, Hebei, China, Acta Geologica Sinica 83, 238-244</gsmin:statusnotes>
