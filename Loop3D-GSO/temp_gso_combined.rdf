  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/mitridatite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Mitridatite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Fe | O | P | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic, hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">arseniosiderite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/mitridatite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dicalcium triironIII dioxy triphosphate trihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2728</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2728:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2728.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060367</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mitridatite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Mitridatite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Dvoichenko P A (1914) The minerals of Crimea, Zapiski Krymskogo Obshchestva Estestvoispytatelei (Proceeding of the Crimea Society of Naturalistes) 4, 1-208</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Arseniosiderite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DH.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 &lt; 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Mitridatite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1914</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/karlite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Karlite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mg | Al | B | O | H | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/karlite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Mg,Al)&lt;sub&gt;6.5&lt;/sub&gt;(BO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;(&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;,Cl)&lt;sub&gt;0.5&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1980-030</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2160</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2160:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2160.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Mg,Al)&lt;sub&gt;6.5&lt;/sub&gt;(BO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;(&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;,Cl)&lt;sub&gt;0.5&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Karlite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Karlite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Franz G, Ackermand D, Koch E (1981) Karlite, Mg_7_(BO_3_)_3_(OH,Cl)_5_ a new borate mineral and associated ludwigite from the Eastern Alps, American Mineralogist 66, 872-877</gsmin:statusnotes>
    <gsmin:strunzcodeV10>06.AB.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Monoborate, BO3, with additional anions; 1(D) + OH, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Karlite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1980-030</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/karpovite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Karpovite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Tl | V | O | S | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tl&lt;sub&gt;2&lt;/sub&gt;VO(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2013-040</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tl&lt;sup&gt;1+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;V&lt;sup&gt;4+&lt;/sup&gt;O(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Karpovite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Karpovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Siidra O I, Vergasova L P, Kretser Y L, Polekhovsky Y S, Filatov S K, Krivovichev S V (2014) Unique thallium mineralization in the fumaroles of the Tolbachik volcano, Kamchatka Peninsula, Russia. II. Karpovite, Tl_2_VO(SO_4_)_2_(H_2_O). Mineralogical Magazine 78, 1699-1709</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/jorgkellerite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Jörgkellerite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Mn | P | O | C | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;3&lt;/sub&gt;Mn&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)O&lt;sub&gt;2&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2015-020</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Pending publication</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)&lt;sub&gt;3&lt;/sub&gt;Mn&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(C&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)(O,OH)&lt;sub&gt;2&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Jörgkellerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Jorgkellerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Zaitsev, A.N., Britvin, S.N., Kearsley, A., Wenzel, T. and Kirk, C. (2015) Jorgkellerite, IMA 2015-020. CNMNC Newsletter No. 26, August 2015, page 942; Mineralogical Magazine, 79, 941-947</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/lecontite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Lecontite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>N | H | Na | S | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/lecontite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(NH&lt;sub&gt;4&lt;/sub&gt;)Na(SO&lt;sub&gt;4&lt;/sub&gt;)·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Ammonium sodium sulfate dihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2364</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2364:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2364.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(N&lt;sup&gt;3-&lt;/sup&gt;H&lt;sub&gt;4&lt;/sub&gt;)Na(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Lecontite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Lecontite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Taylor W J (1858) Lecontite, a new mineral, The American Journal of Science and Arts 76, 273-274</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.CD.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, with H2O, With only large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Lecontite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1858</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/guidottiite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Guidottiite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | Fe | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;(SiFe&lt;sup&gt;3+&lt;/sup&gt;)O&lt;sub&gt;5&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2009-061</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dimanganese ironIII ironIII silicium pentaoxide tetrahydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-39763</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:39763:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-39763.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;(SiFe&lt;sup&gt;3+&lt;/sup&gt;)O&lt;sub&gt;5&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Guidottiite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Guidottiite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Wahle M W, Bujnowski T J, Guggenheim S, Kogure T (2010) Guidottiite, the Mn-analogue of cronstedtite: A new serpentine-group mineral from South Africa, Clays and Clay Minerals 58, 364-376</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Clay</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.ED.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with kaolinite layers composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
    <gsmin:wikipediadate>2009-061</gsmin:wikipediadate>
  </rdf:Description>
