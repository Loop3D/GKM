    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3740:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3740.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,Fe&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;Ba&lt;sub&gt;2&lt;/sub&gt;Sr&lt;sub&gt;2&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(SiO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;8&lt;/sub&gt;(O,OH)&lt;sub&gt;2&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060331 | R070084</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Strontiojoaquinite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Strontiojoaquinite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Wise W S (1982) Strontiojoaquinite and bario-orthojoaquinite: two new members of the joaquinite group, American Mineralogist 67, 809-816</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Joaquinite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CE.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si4O12]8- 4-membered single rings (vierer-Einfachringe), without insular complex anions</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Strontiojoaquinite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1982</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/phosphammite">
