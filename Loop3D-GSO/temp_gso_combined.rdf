    <gsoc:hasDataValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.1</gsoc:hasDataValue>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/strontiodresserite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Strontiodresserite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Sr | Al | C | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">dundasite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/strontiodresserite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">SrAl&lt;sub&gt;2&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1977-005</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Strontium dialuminium dicarbonate tetrahydroxyl monohydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-3774</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3774:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3774.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">SrAl&lt;sub&gt;2&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070741</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Strontiodresserite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Strontiodresserite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Jambor J L, Sabina A P, Roberts A C, Sturman B D (1977) Strontiodresserite, a new Sr-Al carbonate from Montreal Island, Quebec, The Canadian Mineralogist 15, 405-407</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Dundasite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>05.DB.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions and H2O, With large and medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Strontiodresserite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1977-005</gsmin:wikipediadate>
  </rdf:Description>
