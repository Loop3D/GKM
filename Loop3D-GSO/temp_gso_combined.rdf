    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4316:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4316.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;O</gsmin:rruffchemistry>
