  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/eckermannite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Eckermannite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Mg | Al | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">amphibole-group 4 Na</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/eckermannite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaNa&lt;sub&gt;2&lt;/sub&gt;(Mg&lt;sub&gt;4&lt;/sub&gt;Al)Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2013-136</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1348</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1348:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1348.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaNa&lt;sub&gt;2&lt;/sub&gt;(Mg&lt;sub&gt;4&lt;/sub&gt;Al)Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060320</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Eckermannite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Eckermannite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Adamson O J (1942) Eckermannite, a new alkali amphibole. Preliminary note., Geologiska Föreningens i Stockholm Förhandlingar 64, 329-334 Original holotype is actually fluoro-leakeite, so a new type sample and locality for eckermannite was established: Oberti R, Boiocchi M, Hawthorne F C, Ball N A, Harlow G E (2015) Eckermannite revised: the new holotype from the Jade Mine Track, Myanmar - crystal structure, mineral data, and hints on the reasons for the rarity of eckermannite. American Mineralogist 100, 909-914</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Amphibole</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DE.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 2-periodic double chains, Si4O11; Clinoamphiboles</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Eckermannite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1942</gsmin:wikipediadate>
  </rdf:Description>
