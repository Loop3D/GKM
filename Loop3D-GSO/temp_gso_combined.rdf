    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1533:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1533.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;6&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ferrotychite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ferrotychite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Khomyakov A P, Malinovskii Y A, Sandomirskaya S M (1981) New mineral ferrotychite Na_6_Fe_2_(SO_4_)(CO_3_)_4_, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 110(5), 600-603</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Northupite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>05.BF.05</gsmin:strunzcodeV10>
