    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Nickel disulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-4133</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4133:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4133.html</gsmin:mindaturl>
