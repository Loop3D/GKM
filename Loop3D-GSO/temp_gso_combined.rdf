  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ferrostalderite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ferrostalderite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Fe | Tl | As | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CuFe&lt;sub&gt;2&lt;/sub&gt;TlAs&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2014-090</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;1+&lt;/sup&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Tl&lt;sup&gt;1+&lt;/sup&gt;As&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ferrostalderite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ferrostalderite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Biagioni C, Bindi L, Nestola F, Cannon R, Roth P, Raber T (2016) Ferrostalderite, CuFe_2_TlAs_2_S_6_, a new mineral from Lengenbach, Switzerland: occurrence, crystal structure, and emphasis on the role of iron in sulfosalts. Mineralogical Magazine 80, 175-186</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Routhierite</gsmin:structuralgroup>
  </rdf:Description>
