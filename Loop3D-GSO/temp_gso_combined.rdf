  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/rammelsbergite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Rammelsbergite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ni | As</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">Marcasite-Löllingite-Löllingite subgroup</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/rammelsbergite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NiAs&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Nickel diarsenide</gsmin:iupacchemname>
    <gsmin:mindatid>min-3357</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3357:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3357.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NiAs&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R061021</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Rammelsbergite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Rammelsbergite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Haidinger W (1845) Zweite Klasse: Geogenide. XIII. Ordnung. Kiese III. Kobaltkies. Rammelsbergit., in Handbuch der Bestimmenden Mineralogie, Bei Braumüller and Seidel (Wien) 559-562</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Löllingite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.EB.15a</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide, M: S &lt;= 1:2 with Fe, Co, Ni, PGE, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Rammelsbergite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1845</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/cliffordite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Cliffordite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>U | Te | O</gsmin:chemistryelements>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/cliffordite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">UTe&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;9&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1966-046</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Uranyl tritelluriumIV heptaoxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-1064</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1064:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1064.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">U&lt;sup&gt;6+&lt;/sup&gt;Te&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;9&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070407</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cliffordite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Cliffordite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Gaines R V (1969) Cliffordite – a new tellurite mineral from Moctezuma, Sonora, Mexico, American Mineralogist 54, 697-701 Chemical formula revised: Galy J, Meunier G (1971) A propos de la cliffordite UTe&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;8&lt;/sub&gt;. Le système UO&lt;sub&gt;3&lt;/sub&gt;–TeO&lt;sub&gt;2&lt;/sub&gt; à 700°C. Structure cristalline de UTe&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;9&lt;/sub&gt;, Acta Crystallographica B27, 608-616</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.JK.75</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Tellurite without additional anions, without H2O</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Cliffordite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1966-046</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/fingerite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Fingerite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | O | V</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/fingerite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;11&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(VO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1983-064</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Undecacopper dioxy hexavanadate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1550</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1550:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1550.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;11&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(V&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070614</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fingerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Fingerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hughes J M, Hadidiacos C G (1985) Fingerite, Cu_11_O_2_(VO_4_)_6_, a new vanadium sublimate from lzalco volcano, El Salvador: descriptive mineralogy, American Mineralogist 70, 193-196</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.BB.80</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With only medium-sized cations, (OH, etc.):RO4 about 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Fingerite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1983-064</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/creedite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Creedite</rdfs:label>
