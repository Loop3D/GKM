    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2009:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2009.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R080073 | R070494</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ilesite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ilesite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mineral described but not named: Iles M W (1881) A new manganese mineral, American Chemical Journal 3, 420-422 The mineral is named: Dana J D, Dana E S, Silliman B (1881) Scientific intelligence. Brief notices of some recently described minerals. Ilesite, The American Journal of Science 122, 490-491</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Starkeyite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.CB.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, with H2O, With only medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Ilesite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1881</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/rouvilleite">
