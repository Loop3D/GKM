    <gsmin:rruffnameplain xml:lang="en">Moskvinite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Agakhanov A A, Pautov L A, Sokolova E V, Hawthorne F C, Karpenko V Y (2003) Moskvinite-(Y), Na_2_K(Y,REE)[Si_6_O_15_], a new mineral, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 132(6), 15-21</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.CD.05</gsmin:strunzcodeV10>
