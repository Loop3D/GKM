    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaMn&lt;sup&gt;2+&lt;/sup&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;[P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;]&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Whiteite-(CaMnMn)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Whiteite-(CaMnMn)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Yakovenchuk V N, Keck E, Krivovichev S V, Pakhomovsky Y A, Selivanova E A, Mikhailova J A, Chernyatieva A P, Ivanyuk G Y (2012) Whiteite-(CaMnMn), CaMnMn&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;[PO&lt;sub&gt;4&lt;/sub&gt;]&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O, a new mineral from the Hagendorf-Süd granitic pegmatite, Germany, Mineralogical Magazine 76, 2761-2771</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Jahnsite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DH.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 &lt; 1:1</gsmin:strunzlabel>
    <gsmin:wikipediadate>2011-002</gsmin:wikipediadate>
  </rdf:Description>
