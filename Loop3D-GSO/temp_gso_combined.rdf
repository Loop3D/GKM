    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1650:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1650.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;Sb&lt;sup&gt;3+&lt;/sup&gt;Bi&lt;sup&gt;3+&lt;/sup&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Garavellite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Garavellite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Gregorio F, Lattanzi P, Tanelli G, Vurro F (1979) Garavellite, FeSbBiS_4_, a new mineral from the Cu-Fe deposit of Valle del Frigido in the Apuane Alps, northern Tuscany, Italy, Mineralogical Magazine 43, 99-102</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Berthierite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.HA.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">SnS type sulfosalt with Cu, Ag, Fe (without Pb)</gsmin:strunzlabel>
