    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;2&lt;/sub&gt;Cu(AsO&lt;sub&gt;4&lt;/sub&gt;)(SO&lt;sub&gt;4&lt;/sub&gt;)(OH)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-372</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:372:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-372.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)(SO&lt;sub&gt;4&lt;/sub&gt;)(OH)</gsmin:rruffchemistry>
    <gsmin:rruffids>R060949 | R070629 | R110041</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Arsentsumebite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Arsentsumebite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">The mineral name was used for a sample later shown to be duftite. So the name was discredited. Vésignié J P L (1935) Présentation d'échantillons, Bulletin de la Société Française de Minéralogie 58, 4-5 The name was reintroduced when a piece matching the original definition was discovered: Bideaux R A, Nichols M C, Williams S A (1966) The arsenate analog of tsumebite, a new mineral, American Mineralogist 51, 258-259</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Brackebuschite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BG.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH, etc.):RO4 = 0.5:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Arsentsumebite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1966</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/compreignacite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Compreignacite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | U | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/compreignacite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·7H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1964-026</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dipotassium hexauranyl tetraoxy hexahydroxyl heptahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1117</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1117:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1117.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·7H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Compreignacite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Compreignacite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Protas J (1964) Une nouvelle espèce minérale : la compreignacite, K&lt;sub&gt;2&lt;/sub&gt;O·6UO&lt;sub&gt;3&lt;/sub&gt;·11H&lt;sub&gt;2&lt;/sub&gt;O, Bulletin de la Société Française de Minéralogie et de Cristallographie 87, 365-371</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Compreignacite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.GB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl hydroxide, With additional cations (K, Ca, Ba, Pb, etc.); with mainly UO2(O,OH)5 pentagonal polyhedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Compreignacite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1964-026</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/montmorillonite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Montmorillonite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/mineral/smectitegroup"/>
    <gsmin:chemistryelements>Na | Ca | Al | Mg | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic, unknown, triclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">smectite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/montmorillonite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,Ca)&lt;sub&gt;0.3&lt;/sub&gt;(Al,Mg)&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2821</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2821:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2821.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Na,Ca)&lt;sub&gt;0.3&lt;/sub&gt;(Al,Mg)&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R110052 | R110053</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Montmorillonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Montmorillonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally named montmorillonniste: Mauduyt L (1847) Un mot sur un morceau de quartz d'une variété particulière, ainsi que sur une substance minérale trouvée dans le département de la Vienne, Bulletin de la Société Géologique de France 4, 168-170</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Smectite-vermiculite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EC.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with mica sheets, composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Montmorillonite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1847</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/hemusite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Hemusite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Sn | Mo | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/hemusite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;1+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;SnMoS&lt;sub&gt;8&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1968-038</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Hexacopper tin molybdenum octasulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-1862</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1862:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1862.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;1+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Sn&lt;sup&gt;4+&lt;/sup&gt;Mo&lt;sup&gt;4+&lt;/sup&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;8&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R061011</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hemusite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hemusite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Terziev G I (1971) Hemusite - a complex copper-tin-molybdenum sulfide from the Chelopech ore deposit, Bulgaria, American Mineralogist 56, 1847-1854</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Sphalerite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.CB.35a</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide (M = S) with Zn, Fe, Cu, Ag, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Hemusite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1968-038</gsmin:wikipediadate>
  </rdf:Description>
