    <gsmin:mindatid>min-3608</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3608:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3608.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">FeSb&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Seinäjokite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Seinajokite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mozgova N N, Borodaev Y S, Ozerova N A, Paakonen V, Sveshnikova O L, Balitskii V S, Dorogovin B A (1976) Seinäjokite, (Fe0.8Ni0.2) (Sb1.7As0.8), and antimonian westerveldite from Seinäjoki, Finland, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 105, issue 5, 617-630</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Löllingite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.EB.15b</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide, M: S &lt;= 1:2 with Fe, Co, Ni, PGE, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Seinajokite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1976-001</gsmin:wikipediadate>
