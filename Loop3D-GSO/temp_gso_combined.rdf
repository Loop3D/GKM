  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/keiviite-yb">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Keiviite-(Yb)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Yb | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">thortveitite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/keiviiteyb.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Yb&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1982-065</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2178</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2178:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2178.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Yb&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060522</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Keiviite-(Yb)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Keiviite-(Yb)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Voloshin A V, Pakhomovsky Y A, Tyusheva F N (1983) Keiviite Yb_2_Si_2_O7 - a new ytterbium silicate from amazonitic pegmatites of the Kola Peninsula, Mineralogiceskij Zhurnal 5, 94-99 Name changed from keiviite: Note: name spelt keivyite in this paper Nickel E H, Mandarino J A (1987) Procedures involving the IMA Commission on New Minerals and Mineral Names and guidelines on mineral nomenclature, American Mineralogist 72, 1031-1042</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Thortveitite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.BC.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate: Si2O7 groups, without non-tetrahedral anions; cations in octahedral [6] and greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Keiviite-%28Yb%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1982-065</gsmin:wikipediadate>
  </rdf:Description>
