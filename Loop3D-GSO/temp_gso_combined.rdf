  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/phosphofibrite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Phosphofibrite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | H | O | Fe | P</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/phosphofibrite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(H&lt;sub&gt;2&lt;/sub&gt;O,K)&lt;sub&gt;3.5&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;8&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;(OH)&lt;sub&gt;7&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1982-082</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3200</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3200:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3200.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(K&lt;sub&gt;0.5&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;3&lt;/sub&gt;)Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;8&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;(OH)&lt;sub&gt;6.5&lt;/sub&gt;·6.5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Phosphofibrite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Phosphofibrite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Walenta K, Dunn P J (1984) Phosphofibrit, ein neues Eisenphosphat aus der Grube Clara im mittlerren Schwarzwald (BRD), Chemie der Erde 43, 11-16 Chemical formula revised by analogy to meurigite: Kampf A R, Pluth J J, Chen Y S (2007) The crystal structure of meurigite, American Mineralogist 92, 1518-1524 Chemical formula modifed again: Kampf A R, Adams P M, Kolitsch U, Steele I M (2009) Meurigite-Na, a new species, and the relationship between phosphofibrite and meurigite, American Mineralogist 94, 720-727</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Phosphofibrite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DJ.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Phosphofibrite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1982-082</gsmin:wikipediadate>
  </rdf:Description>
