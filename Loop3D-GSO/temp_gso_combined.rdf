    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Sasaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Sasaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Martini J (1978) Sasaite, a new phosphate mineral from West Driefontein Cave, Transvaal, South Africa, Mineralogical Magazine 42, 401-404</gsmin:statusnotes>
