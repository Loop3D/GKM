  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/chlorothionite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Chlorothionite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Cu | S | O | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/chlorothionite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;Cu(SO&lt;sub&gt;4&lt;/sub&gt;)Cl&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dipotassium copper sulfate dichloride</gsmin:iupacchemname>
    <gsmin:mindatid>min-982</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:982:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-982.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;Cl&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Chlorothionite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Chlorothionite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Scacchi A (1872) Notizie preliminari di alcune specie mineralogiche rinvenute nel Vesuvio dopo l'incendio di aprile 1872, Rendiconto dell'Accademia delle Scienze Fisiche e Matematiche (sezione della Societa reale di Napoli) 11, 210-213</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Chlorothionite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.BC.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions, without H2O, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Chlorothionite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1872</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Grading">
