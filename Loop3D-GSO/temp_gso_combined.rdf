    <gsmin:rruffids>R060831</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Glaucocerinite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Glaucocerinite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Dittler E, Koechlin R (1932) Über glaukokerinit, ein neues mineral von Laurion, Centralblatt fur Mineralogie, Geologie und Palaontologie 1, 13-17 Chemical formula revised from (Zn,Cu)_10_Al_4_(SO_4_)(OH)_30_·2H_2_O: Raade G, Elliott C J, Din V K (1985) New data on glaucocerinite, Mineralogical Magazine 49, 583-590</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hydrotalcite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.DD.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With only medium-sized cations; sheets of edge-sharing octahedra</gsmin:strunzlabel>
