    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:312:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-312.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">As</gsmin:rruffchemistry>
    <gsmin:rruffids>R060680</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Arsenolamprite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Arsenolamprite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hintze C (1886) Ueber arsenolamprit, Zeitschrift für Krystallographie und Mineralogie 11, 606-608</gsmin:statusnotes>
    <gsmin:strunzcodeV10>01.CA.10</gsmin:strunzcodeV10>
