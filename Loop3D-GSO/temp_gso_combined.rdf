    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:40287:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-40287.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;1.5&lt;/sub&gt;Li{Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;[Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;10.5&lt;/sub&gt;(OH)&lt;sub&gt;1.5&lt;/sub&gt;]}·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R130075</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Eliseevite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Eliseevite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Yakovenchuk V N, Ivanyuk G Y, Krivovichev S V, Pakhomovsky Y A, Selivanova E A, Korchak J A, Men'shikov Y P, Drogobuzhskaya S V, Zalkind O A (2011) Eliseevite, Na_1.5_Li[Ti_2_Si_4_O_12.5_(OH)_1.5_]·2H_2_O, a new microporous titanosilicate from the Lovozero alkaline massif (Kola Peninsula, Russia), American Mineralogist 96, 1624-1629</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.DB.17</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 2-periodic single chains, Si2O6; Pyroxene-related minerals</gsmin:strunzlabel>
    <gsmin:wikipediadate>2010-031</gsmin:wikipediadate>
  </rdf:Description>
