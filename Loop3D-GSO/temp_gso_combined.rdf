    <gsmin:chemistryelements>Tl | Pb | As | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/edenharterite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">TlPbAs&lt;sub&gt;3&lt;/sub&gt;S&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1987-026</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Thallium lead triarsenite hexasulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-1350</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1350:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1350.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">TlPbAs&lt;sub&gt;3&lt;/sub&gt;S&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Edenharterite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Edenharterite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Graeser S, Schwander H (1992) Edenharterite (TlPbAs_3_S_6_): a new mineral from Lengenbach, Binntal (Switzerland), European Journal of Mineralogy 4, 1265-1270</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.HD.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">SnS type sulfosalt with Tl</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Edenharterite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1987-026</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kermesite">
