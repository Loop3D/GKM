    <gsmin:mindaturl>http://www.mindat.org/min-4400.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaMgAl((C&lt;sub&gt;2&lt;/sub&gt;)&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zhemchuzhnikovite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Zhemchuzhnikovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Knipovich Y N, Komkov A I, Nefedov E I (1963) On stepanovite and the new mineral zhemchuzhnikovite, Trudy Vsesouznogo Ordena Lenina Naucno-Issledovatelskogo Geologiceskogo Instituta 96, 131-135</gsmin:statusnotes>
    <gsmin:strunzcodeV10>10.AB.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxalate</gsmin:strunzlabel>
