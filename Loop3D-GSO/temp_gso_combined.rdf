    <gsmin:rruffids>R060642</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bystrite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Bystrite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Sapozhnikov A N, Ivanov V G, Piskunova L F, Kashaev A A, Terentieva L E, Pobedimskaya E A (1991) Bystrite Ca(Na,K)&lt;sub&gt;7&lt;/sub&gt;(Si&lt;sub&gt;6&lt;/sub&gt;Al&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;)(S&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;1.5&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O - a new cancrinite-like mineral, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 120(3), 97-100</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Cancrinite-sodalite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.FB.05</gsmin:strunzcodeV10>
