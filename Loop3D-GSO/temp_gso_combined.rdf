    <gsmin:wikipediadate>1995-024</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/mourite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Mourite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>U | O | Mo | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/mourite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(UO&lt;sub&gt;2&lt;/sub&gt;)(Mo&lt;sup&gt;6+&lt;/sup&gt;)&lt;sub&gt;5&lt;/sub&gt;O&lt;sub&gt;16&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Uranium pentamolybdenumVI dodecaoxy decahydroxide</gsmin:iupacchemname>
    <gsmin:mindatid>min-2797</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2797:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2797.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">UO&lt;sub&gt;2&lt;/sub&gt;Mo&lt;sup&gt;6+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;O&lt;sub&gt;16&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mourite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Mourite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kopchenova E V, Skvortsova K V, Silantieva N I, Sidorenko G A, Mikhailova L V (1962) Mourite, a new supergene uranium-molybdenum mineral, Zapiski Vsesoyuznogo Mineralogicheskogo Obshchestva 91, issue 1, 67-71 Fleischer M (1962) New mineral names, American Mineralogist 47, 1216-1223</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.FL.80</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Hydroxide (without V or U), Hydroxides with H2O±(OH); sheets of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Mourite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1962</gsmin:wikipediadate>
  </rdf:Description>
