  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/janchevite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Janchevite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | V | O | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;7&lt;/sub&gt;V&lt;sup&gt;5+&lt;/sup&gt;(O&lt;sub&gt;8.5&lt;/sub&gt;&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;&lt;sub&gt;0.5&lt;/sub&gt;)Cl&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2017-079</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;7&lt;/sub&gt;V&lt;sup&gt;5+&lt;/sup&gt;(O&lt;sub&gt;8.5&lt;/sub&gt;&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;&lt;sub&gt;0.5&lt;/sub&gt;)Cl&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Janchevite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Janchevite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chukanov N V, Nekrasova D O, Siidra O I, Polekhovsky Y S, Pekov I V (2018) Janchevite, Pb_7_V^5+^(O_8.5_[box]_0.5_)Cl_2_, a new mineral from the Kombat mine, Namibia. The Canadian Mineralogist 56, 159-165</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Asisite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="http://qudt.org/vocab/unit/SUSCEPTIBILITY_MAG">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:isDefinedBy rdf:resource="http://qudt.org/2.1/vocab/unit"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Unit_Of_Measure_Value"/>
    <skos:altLabel>chi</skos:altLabel>
    <skos:definition xml:lang="en">Magnetic susceptibility is a dimensionless proportionality constant that indicates the degree of magnetization of a material in response to an applied magnetic field.  Here M = chi * H. Where M is the magnetization of the material (the magnetic dipole moment per unit volume), measured in amperes per meter, and H is the magnetic field strength, also measured in amperes per meter. Chi is therefore a dimensionless quantity.</skos:definition>
    <skos:prefLabel xml:lang="en">Magnetic Susceptibility</skos:prefLabel>
  </rdf:Description>
