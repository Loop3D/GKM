    <gsmin:mindaturl>http://www.mindat.org/min-1859.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;10&lt;/sub&gt;Zn&lt;sup&gt;2+&lt;/sup&gt;(Cr&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050551 | R140133 | R140134 | R141184</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hemihedrite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hemihedrite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Williams S A, Anthony J W (1970) Hemihedrite, a new mineral from Arizona, American Mineralogist 55, 1088-1102 The chemical formula is revised from Pb_10_Zn(CrO_4_)_6_(SiO_4_)_2_F_2_: Lafuente B, Downs R T, Origlieri M J, Domanik K J, Gibbs R B, Rumsey M S (2017) New data on hemihedrite from Arizona. Mineralogical Magazine 81, 1021-1030</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Iranite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.FC.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Chromate, With PO4, AsO4, SiO4</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Hemihedrite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1967-011</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/sacrofanite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
