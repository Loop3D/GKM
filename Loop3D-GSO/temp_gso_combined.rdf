    <gsmin:rruffnameplain xml:lang="en">Akrochordite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Flink G (1922) Akrochordit, ett nytt mineral från Långbans gruvor, Geologiska Foereningens i Stockholm Foerhandlingar 44, 773-776</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.DD.10</gsmin:strunzcodeV10>
