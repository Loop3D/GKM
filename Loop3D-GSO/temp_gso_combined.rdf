  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/krieselite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Krieselite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Al | Ge | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al&lt;sub&gt;2&lt;/sub&gt;(GeO&lt;sub&gt;4&lt;/sub&gt;)F&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2000-043a</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Dialuminium germanium tetraoxide dihydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-27545</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:27545:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-27545.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al&lt;sub&gt;2&lt;/sub&gt;GeO&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Krieselite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Krieselite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Schlüter J, Geisler T, Pohl D, Stephan T (2010) Krieselite, Al_2_GeO_4_(F,OH)_2_: A new mineral from the Tsumeb mine, Namibia, representing the Ge analogue of topaz, Neues Jahrbuch für Mineralogie, Abhandlungen 187, 33-40</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Topaz</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AF.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with additional anions; cations in [4], [5] and/or only [6] coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Krieselite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2000-043a</gsmin:wikipediadate>
