    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CuPb&lt;sub&gt;2&lt;/sub&gt;(MoO&lt;sub&gt;4&lt;/sub&gt;)(AsO&lt;sub&gt;4&lt;/sub&gt;)(OH)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1982-062</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Copper dilead molybdate arsenate hydroxyl</gsmin:iupacchemname>
