    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;O(Mo&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)</gsmin:rruffchemistry>
    <gsmin:rruffids>R061141</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Vergasovaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Vergasovaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Bykova E Y, Berlepsch P, Kartashov P M, Brugger J, Armbruster T, Criddle A J (1998) Vergasovaite Cu_3_O[(Mo,S)O_4_][SO_4_], a new copper-oxy-molybdate-sulfate from Kamchatka, Schweizerische Mineralogische und Petrographische Mitteilungen 78, 479-488</gsmin:statusnotes>
