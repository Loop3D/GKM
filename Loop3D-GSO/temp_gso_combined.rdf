    <gsmin:mindaturl>http://www.mindat.org/min-39785.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Cu&lt;sup&gt;2+&lt;/sup&gt;,Zn&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;16&lt;/sub&gt;(Te&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;Cl&lt;sup&gt;1-&lt;/sup&gt;(OH)&lt;sub&gt;18&lt;/sub&gt;·7H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R100039</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Eurekadumpite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Eurekadumpite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pekov I V, Chukanov N V, Zadov A E, Roberts A C, Jensen M C, Zubkova N V, Nikischer A J (2010) Eurekadumpite (Cu,Zn)_16_(TeO_3_)_2_(AsO_4_)_3_Cl(OH)_18_·7H_2_O - a new hypergene mineral, Zapiski Rossiiskogo Mineralogicheskogo Obshchetstva 139(4), 26-35</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, hydroxide or arsenite</gsmin:strunzlabel>
    <gsmin:wikipediadate>2009-072</gsmin:wikipediadate>
