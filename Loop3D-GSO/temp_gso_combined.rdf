  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dct:bibliographicCitation>Brodaric, B., and Richard, S.M., 2021, The GeoScience Ontology Reference: Geological Survey of Canada Open File 8796, 34 p., https://doi.org/10.4095/328296</dct:bibliographicCitation>
    <dct:created rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2020-03-26</dct:created>
    <dct:creator rdf:resource="https://w3id.org/gso/1.0/common/boyan_brodaric"/>
    <dct:creator rdf:resource="https://w3id.org/gso/1.0/common/stephen_richard"/>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/legalcode"/>
    <dct:modified rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2021-03-26</dct:modified>
    <dct:publisher>ARC Loop3D project;  https://loop3d.org/</dct:publisher>
    <dct:publisher>Geological Survey of Canada, Natural Resources Canada, Government of Canada</dct:publisher>
    <dct:rights>Copyright (c) 2021 Government of Canada</dct:rights>
    <rdfs:comment xml:lang="en">Unary predicates are represented by owl classes, binary predicates by rdf properties.  This ontology defines common types and relations that are further specialized by geologic entities in other modules</rdfs:comment>
    <rdfs:label xml:lang="en">Geoscience Ontology, Common</rdfs:label>
    <skos:definition xml:lang="en">Common elements for geoscience ontology</skos:definition>
    <schema:codeRepository>https://github.com/Loop3D/GKM</schema:codeRepository>
  </rdf:Description>
  <rdf:Description rdf:nodeID="n7bda25761fc44f8595ef751309700190b169">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="https://w3id.org/gso/1.0/common/Nonphysical_Endurant"/>
    <owl:onProperty rdf:resource="https://w3id.org/gso/1.0/common/isQualityOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/clino-ferri-holmquistite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Clino-ferri-holmquistite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Li | Mg | Fe | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;Li&lt;sub&gt;2&lt;/sub&gt;(Mg&lt;sub&gt;3&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;)Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2001-067</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;Li&lt;sub&gt;2&lt;/sub&gt;(Mg&lt;sub&gt;3&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;)Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Clino-ferri-holmquistite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Clino-ferri-holmquistite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Originally known as ferri-ottoliniite: Oberti R, Camara F, Caballero J M (2004) Ferri-ottoliniite and ferriwhittakerite, two new end-members of the new Group 5 for monoclinic amphiboles. American Mineralogist 89, 888-893 Redefined and name changed to conform to new amphibole nomenclature: Williams P A, Hatert F, Pasero M, Mills S J (2014) IMA Commission on New Minerals, Nomenclature and Classification (CNMNC) Newsletter 22. New minerals and nomenclature modifications approved in 2014. Mineralogical Magazine 78, 1241-1248</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Amphibole</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/rowlandite-y">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Rowlandite-(Y)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Fe | Y | Si | O | F</gsmin:chemistryelements>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/rowlanditey.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;Y&lt;sub&gt;4&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;F&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3467</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3467:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3467.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;Y&lt;sub&gt;4&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;F&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Rowlandite-(Y)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Rowlandite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hidden W E (1891) Preliminary notice of a new yttrium-silicate, The American Journal of Science 142, 430-431 Name changed from rowlandite: Nickel E H, Mandarino J A (1987) Procedures involving the IMA Commission on New Minerals and Mineral Names and guidelines on mineral nomenclature, American Mineralogist 72, 1031-1042</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Rowlandite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.HG.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Silicate, unclassified: With REE, Th</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Rowlandite-%28Y%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1891</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/lipuite">
