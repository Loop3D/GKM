    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4264:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4264.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;(W&lt;sup&gt;6+&lt;/sup&gt;&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;)(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Welinite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Welinite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Moore P B (1967) Welinite, a new mineral from Långban. Arkiv för Mineralogi och Geologi 4, 407-411 Chemical formula revised: Dunn P J, Peacor D R, Erd R C, Ramik R A (1986) Franciscanite and örebroite, two new minerals from California and Sweden, related to redefined welinite, American Mineralogist 71, 1522-1526</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Welinite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AF.75</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with additional anions; cations in [4], [5] and/or only [6] coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Welinite-III.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1966-002</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/triangulite">
