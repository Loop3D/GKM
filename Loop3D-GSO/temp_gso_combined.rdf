  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Gneiss">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Neuendorf et al. 2005</dct:source>
    <rdfs:comment xml:lang="en">Foliated metamorphic rock with bands or lenticles rich in granular minerals alternating with bands or lenticles rich in minerals with a flaky or elongate prismatic habit. Mylonitic foliation or well developed, continuous schistosity (greater than 50 percent of the rock consists of grains participate in a planar or linear fabric) precludes classification with this concept.</rdfs:comment>
    <rdfs:label xml:lang="en">gneiss</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Foliated_Metamorphic_Rock"/>
  </rdf:Description>
