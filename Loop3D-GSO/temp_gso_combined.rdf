  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/vanarsite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Vanarsite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | As | V | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaCa&lt;sub&gt;12&lt;/sub&gt;(As&lt;sup&gt;3+&lt;/sup&gt;V&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;8.5&lt;/sub&gt;V&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;3.5&lt;/sub&gt;As&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;51&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·78H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2014-031</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaCa&lt;sub&gt;12&lt;/sub&gt;(As&lt;sup&gt;3+&lt;/sup&gt;V&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;8.5&lt;/sub&gt;V&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;3.5&lt;/sub&gt;As&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;51&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·78H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Vanarsite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Vanarsite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf A R, Hughes J M, Nash B P, Marty J (2016) Vanarsite, packratite, morrisonite, and gatewayite: Four new minerals containing the [As^3+^V^4+,5+^_12_As^5+^_6_O_51_] heteropolyanion, a novel polyoxometalate cluster. The Canadian Mineralogist 54, 145-162</gsmin:statusnotes>
  </rdf:Description>
