    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-342</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:342:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-342.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;26&lt;/sub&gt;As&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;18&lt;/sub&gt;O&lt;sub&gt;50&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)(OH)&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R100041 | R100054</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Armangite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Armangite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Aminoff G, Mauzelius R (1920) Armangite, a new arsenite from Långbanshyttan, Geologiska Föreningens i Stockholm Förhandlingar 42, 301-309</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.JB.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Arsenite, antimonite, bismuthite; with additional anions, without H2O</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Armangite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1920</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/donbassite">
