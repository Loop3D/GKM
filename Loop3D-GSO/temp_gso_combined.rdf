    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Sodium uranyl oxyhydroxide nhydrate</gsmin:iupacchemname>
