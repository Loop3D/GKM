    <gsmin:rruffids>R050033 | R050136</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Datolite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Datolite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Klaproth M H (1806) Chemische untersuchung des datoliths, Neues Allgemeines Journal der Chemie 6, 107-110</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Gadolinite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AJ.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with BO3 triangles and/or B[4], Be[4] tetrahedra, cornersharing with SiO4</gsmin:strunzlabel>
