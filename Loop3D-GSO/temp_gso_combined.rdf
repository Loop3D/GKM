    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3605:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3605.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaMgFe&lt;sup&gt;3+&lt;/sup&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
