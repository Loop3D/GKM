    <gsmin:fleischersgroup xml:lang="en">zeolite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/paranatrolite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;3&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;)O&lt;sub&gt;10&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1978-017</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3102</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3102:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3102.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;3&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;)O&lt;sub&gt;10&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Paranatrolite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Paranatrolite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chao G Y (1980) Paranatrolite, a new zeolite from Mont St-Hilaire, Québec, The Canadian Mineralogist 18, 85-88 Fleischer M, Cabri L J (1981) New mineral names, American Mineralogist 66, 1274-1280</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.GA.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Zeolite with T5O10 Units – Fibrous Zeolite</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Paranatrolite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1978-017</gsmin:wikipediadate>
  </rdf:Description>
