    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mn | Al | Mg | As | O | Si | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/ardennite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Al&lt;sub&gt;4&lt;/sub&gt;(AlMg)(AsO&lt;sub&gt;4&lt;/sub&gt;)(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;)(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:mindatid>min-322</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:322:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-322.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Al&lt;sub&gt;4&lt;/sub&gt;(AlMg)(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;)(OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060669</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ardennite-(As)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ardennite-(As)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">von Lasaulx A (1872) Ardennit, ein neues mineral, Neues Jahrbuch für Mineralogie, Geologie und Palaontologie 1872, 930-934 Chemical formula revised: Barresi A A, Orlandi P, Pasero M (2007) History of ardennite and the new mineral ardennite-(V), European Journal of Mineralogy 19, 581-587 Name changed from ardennite to ardennite-(As) according to CNMNC decision IMA2007-A because of the approval of ardennite-(V).</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Ardennite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.BJ.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate with Si3O10, Si4O11, etc. anions; cations in octahedral [6] and greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://webmineral.com/data/Ardennite-(As).shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1872</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/galuskinite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Galuskinite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Si | O | C</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;7&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2010-075</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-41778</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:41778:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-41778.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;7&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)</gsmin:rruffchemistry>
    <gsmin:rruffids>R130076</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Galuskinite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Galuskinite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Lazic B, Armbruster T, Savelyeva V B, Zadov A E, Pertsev N N, Dzierzanowski P (2011) Galuskinite, Ca_7_(SiO_4_)_3_(CO_3_), a new skarn mineral from the Birkhin gabbro massif, Eastern Siberia, Russia, Mineralogical Magazine 75, 2631-2648</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">silicate</gsmin:strunzlabel>
    <gsmin:wikipediadate>2010-075</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/hiarneite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Hiärneite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Mn | Na | Zr | Sb | Ti | Fe | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Mn&lt;sup&gt;2+&lt;/sup&gt;,Na)&lt;sub&gt;2&lt;/sub&gt;(Zr,Mn&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;5&lt;/sub&gt;(Sb,Ti,Fe)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;16&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1996-040</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-6994</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:6994:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-6994.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Mn&lt;sup&gt;2+&lt;/sup&gt;,Na)&lt;sub&gt;2&lt;/sub&gt;(Zr&lt;sup&gt;4+&lt;/sup&gt;,Mn&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;5&lt;/sub&gt;(Sb&lt;sup&gt;5+&lt;/sup&gt;,Ti&lt;sup&gt;4+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;16&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hiärneite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hiarneite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Holtstam D (1997) Hiärneite, a new, Zr-Sb oxide mineral isostructural with calzirtite, from Långban, Sweden, European Journal of Mineralogy 9, 843-848</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.DL.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With large (+- medium-sized) cations; fluorite-type structures</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Hiarneite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1996-040</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/iraqite-la">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Iraqite-(La)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Ca | La | Ce | Th | Si | O</gsmin:chemistryelements>
    <gsmin:fleischersgroup xml:lang="en">iraqite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/iraqitela.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KCa&lt;sub&gt;2&lt;/sub&gt;(La,Ce,Th)Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;20&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1973-041</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2041</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2041:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2041.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KCa&lt;sub&gt;2&lt;/sub&gt;(La,Ce,Th)Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;20&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Iraqite-(La)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Iraqite-(La)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Livingstone A, Atkin D, Hutchison D, Al-Hermezi H M (1976) Iraqite, a new rare-earth mineral of the ekanite group, Mineralogical Magazine 40, 441-445</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Steacyite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CH.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si4O12]8- 4-membered double rings</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Iraqite-%28La%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1973-041</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/pyroaurite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Pyroaurite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mg | Fe | C | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">hydrotalcite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/pyroaurite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;6&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)(OH)&lt;sub&gt;16&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:mindatid>min-3330</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3330:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3330.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;6&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;CO&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;16&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R100053 | R120011</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pyroaurite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Pyroaurite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Igelström L J (1866) Nya och sällsynta mineralier från Vermlands och Örebro län, Öfversigt af Kongliga Vetenskaps-Akademiens Förhandlingar 1865, 605-611</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hydrotalcite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>05.DA.50</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions and H2O, With medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Pyroaurite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1866</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/herderite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Herderite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Be | P | O | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">herderite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/herderite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaBe(PO&lt;sub&gt;4&lt;/sub&gt;)F</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Calcium beryllium phosphate fluoride</gsmin:iupacchemname>
    <gsmin:mindatid>min-1876</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1876:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1876.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaBePO&lt;sub&gt;4&lt;/sub&gt;F</gsmin:rruffchemistry>
    <gsmin:rruffids>R100064</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Herderite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Herderite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Haidinger W (1828) On herderite, a new mineral species, The Philosophical Magazine 4, 1-3</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Gadolinite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BA.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With small and medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Herderite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1828</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/bassanite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Bassanite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic, hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/bassanite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca(SO&lt;sub&gt;4&lt;/sub&gt;)·0.5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Calcium sulfate 0.5hydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-557</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:557:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-557.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaSO&lt;sub&gt;4&lt;/sub&gt;·0.5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bassanite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Bassanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Zambonini F (1910) Mineralogia Vesuviana. Bassanite CaSO&lt;sub&gt;4&lt;/sub&gt;, Atti della Reale Accademia delle Scienze Fisiche e Matematiche di Napoli, Serie II 14, 327-328</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Rhabdophane</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.CD.45</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. without additional anions, with H2O, With only large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Bassanite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1910</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/larsenite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Larsenite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Zn | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/larsenite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">ZnPb(SiO&lt;sub&gt;4&lt;/sub&gt;)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Lead zinc nesosilicate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2335</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2335:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2335.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;Zn&lt;sup&gt;2+&lt;/sup&gt;SiO&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Larsenite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Larsenite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Palache C, Bauer L H, Berman H (1928) Larsenite and calcium-larsenite, new members of the chrysolite group, from Franklin, New Jersey. (Preliminary Notice), American Mineralogist 13, 142-144</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.AB.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate without additional anions; cations in [4] and greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Larsenite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1928</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/leningradite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Leningradite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Cu | V | O | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/leningradite.pdf</gsmin:handbookofmineralogyurl>
