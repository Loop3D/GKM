    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Spadaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Spadaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">von Kobell F (1843) Ueber den Spadait, eine neue Mineral-species, und über den Wollastonit von Capo di bove. Gelehrte Anzeigen der Königlich Bayerischen Akademie der Wissenschaften 17, 945-950</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.EC.45</gsmin:strunzcodeV10>
