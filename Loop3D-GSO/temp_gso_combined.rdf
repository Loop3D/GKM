    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:38830:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-38830.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;O[As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;(OH)]&lt;sub&gt;2&lt;/sub&gt;·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Lapeyreite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Lapeyreite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Sarp H, Cerný R, Babalik H, Hatipoglu M, Mari G (2010) Lapeyreite, Cu_3_O[AsO_3_(OH)]_2_·0.75H_2_O, a new mineral: Its description and crystal structure, American Mineralogist 95, 171-176</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">phosphate, arsenate, or vanadate</gsmin:strunzlabel>
