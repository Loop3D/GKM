  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/euxenite-y">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Euxenite-(Y)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Y | Ca | Ce | U | Th | Nb | Ta | Ti | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic, amorphous</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">columbite-euxenite-euxenite subgroup</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/euxenitey.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Y,Ca,Ce,U,Th)(Nb,Ta,Ti)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1425</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1425:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1425.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Y&lt;sup&gt;3+&lt;/sup&gt;,Ca,Ce&lt;sup&gt;3+&lt;/sup&gt;,U&lt;sup&gt;4+&lt;/sup&gt;,Th&lt;sup&gt;4+&lt;/sup&gt;)(Nb&lt;sup&gt;5+&lt;/sup&gt;,Ta&lt;sup&gt;5+&lt;/sup&gt;,Ti&lt;sup&gt;4+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060856 | R070324 | R080101</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Euxenite-(Y)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Euxenite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Scheerer T (1840) Ueber den euxenite, eine neue mineralspecies, Annalen der Physik und Chemie 50, 149-153 Name changed from euxenite: Nickel E H, Mandarino J A (1987) Procedures involving the IMA Commission on New Minerals and Mineral Names and guidelines on mineral nomenclature, American Mineralogist 72, 1031-1042</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Columbite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.DG.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With large (+- medium-sized) cations; chains of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Euxenite-%28Y%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1840</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/juonniite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
