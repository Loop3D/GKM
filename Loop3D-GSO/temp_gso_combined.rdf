    <gsmin:chemistryelements>Pb | Mn | Sb | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/benavidesite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;4&lt;/sub&gt;MnSb&lt;sub&gt;6&lt;/sub&gt;S&lt;sub&gt;14&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1980-073</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Tetralead manganese hexanantimonide tetradecasulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-623</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:623:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-623.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;Sb&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;S&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;14&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070348</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Benavidesite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Benavidesite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Oudin E, Picot P, Pillard F, Moëlo Y, Burke E A J, Zakrzewski M A (1982) La bénavidésite, Pb&lt;sub&gt;4&lt;/sub&gt;(Mn,Fe)Sb&lt;sub&gt;6&lt;/sub&gt;S&lt;sub&gt;14&lt;/sub&gt;, un nouveau minéral de la série de la jamesonite, Bulletin de Minéralogie 105, 166-169</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.HB.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">SnS type sulfosalt with Cu, Ag, Fe, Sn and Pb</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Benavidesite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1980-073</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/khorixasite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Khorixasite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Bi | Cu | V | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Bi&lt;sub&gt;0.67&lt;/sub&gt;&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;&lt;sub&gt;0.33&lt;/sub&gt;)Cu(VO&lt;sub&gt;4&lt;/sub&gt;)(OH)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2016-048</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Pending publication</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Bi&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;0.67&lt;/sub&gt;&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;&lt;sub&gt;0.33&lt;/sub&gt;)Cu&lt;sup&gt;2+&lt;/sup&gt;(V&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)(OH)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Khorixasite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Khorixasite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mills, S.J., Christy, A.G., Birch,W. D., Bourgoin, V. and Boulliard, J.-C. (2016) Khorixasite, IMA 2016-048. CNMNC Newsletter No. 33, October 2016, page 1139; Mineralogical Magazine, 80, 1135–1144</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Descloizite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/tarkianite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Tarkianite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Fe | Re | Mo | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Cu,Fe)(Re,Mo)&lt;sub&gt;4&lt;/sub&gt;S&lt;sub&gt;8&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2003-004</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-25693</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:25693:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-25693.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Cu,Fe)(Re,Mo)&lt;sub&gt;4&lt;/sub&gt;S&lt;sub&gt;8&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tarkianite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tarkianite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kojonen K K, Roberts A C, Isomaki O P, Knauf V V, Johanson B, Pakkanen L (2004) Tarkianite, (Cu,Fe)(Re,Mo)_4_S_8_, a new mineral species from the Hitura Mine, Nivala, Finland, The Canadian Mineralogist 42, 539-544</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.DB.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide (M:S = 2:3)</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Tarkianite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2003-004</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/carmichaelite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Carmichaelite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ti | Cr | Fe | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/carmichaelite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ti,Cr,Fe)(O,OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1996-062</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-6849</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:6849:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-6849.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ti&lt;sup&gt;4+&lt;/sup&gt;,Cr&lt;sup&gt;3+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;)(O,OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Carmichaelite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Carmichaelite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Wang L, Rouse R C, Essene E J, Peacor D R, Zhang Y (2000) Carmichaelite, a new hydroxyl-bearing titanite from Garnet Ridge, Arizona, American Mineralogist 85, 792-800</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.DB.50</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With medium-sized cations; chains of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Carmichaelite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1996-062</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/phoxite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Phoxite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>N | H | Mg | C | O | P</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(NH&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;Mg&lt;sub&gt;2&lt;/sub&gt;(C&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;)(PO&lt;sub&gt;3&lt;/sub&gt;OH)&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;4&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2018-009</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Pending publication</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(N&lt;sup&gt;3-&lt;/sup&gt;H&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;Mg&lt;sub&gt;2&lt;/sub&gt;((C&lt;sub&gt;2&lt;/sub&gt;)&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)(PO&lt;sub&gt;3&lt;/sub&gt;OH)&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Phoxite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Phoxite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf, A.R., Celestian, A.J., Nash, B.P. and Marty, J. (2018) Phoxite, IMA2018-009. CNMNC Newsletter No 43, June 2018, page 783; Mineralogical Magazine, 82, 779–785</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/urea">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Urea</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>C | O | N | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/urea.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CO(NH&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1972-031</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4117</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4117:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4117.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CO(N&lt;sup&gt;3-&lt;/sup&gt;H&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Urea</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Urea</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">First organic compound to be synthesized from inorganic compounds: Wohler M F (1828) Artificial formation of urea, The Philosophical Magazine 4, 309-310 Discovered as a mineral: Bridge P J (1974) Urea, a new mineral, and neotype phosphammite from Western Australia, Mineralogical Magazine 39, 346-348</gsmin:statusnotes>
    <gsmin:strunzcodeV10>10.CA.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Miscellaneous Organic Mineral</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Urea.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1972-031</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/tsumcorite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Tsumcorite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | Zn | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">tsumcorite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/tsumcorite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">PbZn&lt;sub&gt;2&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1969-047</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Lead dizinc diarsenate dihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-4039</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4039:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4039.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060081 | R100185 | R110036</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tsumcorite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tsumcorite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Geier B H, Kautz K, Müller G (1971) Tsumcorit(e) [Pb Zn Fe(AsO4)2] · H2O, ein neues mineral aus den oxidationszonen der Tsumeb-Mine, Südwestafrika, Neues Jahrbuch für Mineralogie, Monatshefte 1971, 305-309 Chemical formula revised: Tillmanns E, Gebert W (1973) The crystal structure of tsumcorite, a new mineral from the Tsumeb Mine, S.W. Africa, Acta Crystallographica B29, 2789-2794</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Natrochalcite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CG.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With large and medium-sized cations, RO4:H2O = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Tsumcorite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1969-047</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Phosphorite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">HallsworthandKnox 1999, Jackson 1997</dct:source>
    <rdfs:comment xml:lang="en">Sedimentary rock in which at least 50 percent of the primary or recrystallized constituents are phosphate minerals. Most commonly occurs as a bedded primary or reworked secondary marine rock, composed of microcrystalline carbonate fluorapatite in the form of lamina, pellets, oolites and nodules, and skeletal, shell and bone fragments.</rdfs:comment>
    <rdfs:label xml:lang="en">phosphorite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Phosphate_Rich_Sedimentary_Material"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Sedimentary_Rock"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/jouravskite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Jouravskite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Mn | S | O | C | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">ettringite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/jouravskite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;3&lt;/sub&gt;Mn&lt;sup&gt;4+&lt;/sup&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)(CO&lt;sub&gt;3&lt;/sub&gt;)(OH)&lt;sub&gt;6&lt;/sub&gt;·12H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1965-009</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2118</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2118:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2118.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;3&lt;/sub&gt;Mn&lt;sup&gt;4+&lt;/sup&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)(C&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;)(OH)&lt;sub&gt;6&lt;/sub&gt;·12H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R110012</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Jouravskite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Jouravskite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Gaudefroy C, Permingeat F (1965) La jouravskite, une nouvelle espèce minérale, Bulletin de la Société Française de Minéralogie et de Cristallographie 88, 254-262</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Ettringite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.DG.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With large and medium-sized cations; with NO3, CO3, B(OH)4, SiO4 or IO3</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Jouravskite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1965-009</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Organic_Accumulation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Sediment accumulation of biologically produced organic material, as in bog, coal swamps.</rdfs:comment>
    <rdfs:label xml:lang="en">organic accumulation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicprocess/Deposition"/>
  </rdf:Description>
