    <gsmin:rruffnameplain xml:lang="en">Threadgoldite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Deliens M, Piret P (1979) Les phosphates d'uranyle et d'aluminium de Kobokobo IV. La threadgoldite, Al(UO2)2(PO4)2(OH)·8H2O, nouveau mineral, Bulletin de Minéralogie 102, 338-341</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.EB.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl phosphate or arsenate, UO2:RO4 = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Threadgoldite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1978-066</gsmin:wikipediadate>
