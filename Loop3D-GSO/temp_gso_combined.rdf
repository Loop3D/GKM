    <gsmin:imastatus xml:lang="en">Approved|Pending publication</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(K,Na,Pb)&lt;sub&gt;4&lt;/sub&gt;(Na,Ca)&lt;sub&gt;2&lt;/sub&gt;(Mg,Cu)&lt;sub&gt;3&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;0.5&lt;/sub&gt;Al&lt;sub&gt;0.5&lt;/sub&gt;)(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;8&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Philoxenite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Philoxenite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pekov, I.V., Zubkova, N.V., Agakhanov, A.A., Belakovskiy, D.I., Vigasina, M.F., Britvin, S.N., Turchkova, A.G., Sidorov, E.G. and Pushcharovsky, D.Y. (2016) Philoxenite, IMA 2015-108. CNMNC Newsletter No. 30, April 2016, page 410; Mineralogical Magazine, 80, 407–413</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/orthoclase">
