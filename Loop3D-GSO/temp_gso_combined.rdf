    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;4&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;12&lt;/sub&gt;(Cl,CO&lt;sub&gt;3&lt;/sub&gt;,OH)&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hydrocalumite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hydrocalumite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Tilley C E, Megaw H D, Hey M H (1934) Hydrocalumite (4CaO.Al&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;3&lt;/sub&gt;.12H&lt;sub&gt;2&lt;/sub&gt;O), a new mineral from Scawt Hill, Co. Antrim, Mineralogical Magazine 23, 607-615</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hydrotalcite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.FL.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Hydroxide (without V or U), Hydroxides with H2O±(OH); sheets of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Hydrocalumite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1934</gsmin:wikipediadate>
