  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicprocess/Ductile_Simple_Shear">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Simple shear accomodated by ductile deformation. Simple sheare is a deformation in which parallel planes in a material remain parallel and maintain a constant distance, while translating relative to each other (https://en.wikipedia.org/wiki/Simple_shear).</rdfs:comment>
    <rdfs:label xml:lang="en">Ductile Simple Shear</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicprocess/Ductile_Flow"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicprocess/Shearing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/zimbabweite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Zimbabweite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Pb | K | Ta | Nb | Ti | As | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/zimbabweite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na(Pb,Na,K)&lt;sub&gt;2&lt;/sub&gt;(Ta,Nb,Ti)&lt;sub&gt;4&lt;/sub&gt;As&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1984-034</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4403</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4403:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4403.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na(Pb&lt;sup&gt;2+&lt;/sup&gt;,Na,K)&lt;sub&gt;2&lt;/sub&gt;(Ta&lt;sup&gt;5+&lt;/sup&gt;,Nb&lt;sup&gt;5+&lt;/sup&gt;,Ti&lt;sup&gt;4+&lt;/sup&gt;)&lt;sub&gt;4&lt;/sub&gt;As&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zimbabweite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Zimbabweite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Foord E E, Taggart J E, Gaines R V, Grubb P L C, Kristiansen R (1986) Zimbabweite, a new alkali-lead-arsenic tantalate from St Anns mine, Karoi District, Zimbabwe, Bulletin de Minéralogie 109, 331-336</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.JA.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Arsenite, antimonite, bismuthite; without additional anions, without H2O</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Zimbabweite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1984-034</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Dolostone">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">This vocabulary</dct:source>
    <rdfs:comment xml:lang="en">Pure carbonate sedimentary rock with a ratio of magnesium carbonate to calcite (plus aragonite) greater than 1 to 1.</rdfs:comment>
    <rdfs:label xml:lang="en">dolomite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Dolomitic_Or_Magnesian_Sedimentary_Rock"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Pure_Carbonate_Sedimentary_Rock"/>
    <skos:altLabel xml:lang="en">dolostone</skos:altLabel>
    <skos:altLabel xml:lang="en">pure dolomitic or magnesian carbonate sedimentary rock</skos:altLabel>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfeature/Bedding_Package">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">A sub-map scale sequence of strata, e.g. bouma sequence, fining-upward sequence, interbedded sandstone and mudstone...  Repeated multiple times in a stratigraphic unit.</rdfs:comment>
    <rdfs:label xml:lang="en">Bedding Package </rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfeature/Lithosome"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/obradovicite-nacu">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Obradovicite-NaCu</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | H | O | Cu | Mo | As | Fe</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">[Na&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;17&lt;/sub&gt;Cu(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;6&lt;/sub&gt;][Mo&lt;sub&gt;8&lt;/sub&gt;As&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;34&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;]</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2011-079</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-41948</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:41948:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-41948.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">[Na&lt;sub&gt;2&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;17&lt;/sub&gt;Cu&lt;sup&gt;2+&lt;/sup&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;6&lt;/sub&gt;][Mo&lt;sup&gt;6+&lt;/sup&gt;&lt;sub&gt;8&lt;/sub&gt;As&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;34&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;]</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Obradovicite-NaCu</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Obradovicite-NaCu</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf A R, Mills S J, Rumsey M S, Dini M, Birch W D, Spratt J, Pluth J J, Steele I M, Jenkins R A, Pinch W W (2012) The heteropolymolybdate family: structural relations, nomenclature scheme and new species, Mineralogical Magazine 76, 1175-1207</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Betpakdalite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.GB.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Molybdate, Wolframate or Niobate, With additional anions and/or H2O</gsmin:strunzlabel>
    <gsmin:wikipediadate>2011-079</gsmin:wikipediadate>
  </rdf:Description>
