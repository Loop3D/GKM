  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kleberite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kleberite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Fe | Ti | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;3+&lt;/sup&gt;Ti&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;11&lt;/sub&gt;(OH)&lt;sub&gt;5&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2012-023</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;3+&lt;/sup&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;11&lt;/sub&gt;(OH)&lt;sub&gt;5&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kleberite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kleberite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mineral named and described without IMA approval: Bautsch H J, Rohde G, Sedlacek P, Zedler A (1978) Kleberit - ein neues Eisen-Titan-Oxidmineral aus tertiären Sanden. Zeitschrift für Geologische Wissenschaften 6, 661-671 Grey I E, Steinike K, MacRae C M (2013) Kleberite, Fe^3+^Ti_6_O_11_(OH)_5_, a new ilmenite alteration product, from Königshain, northeast Germany, Mineralogical Magazine 77, 45-55</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Tivanite</gsmin:structuralgroup>
  </rdf:Description>
