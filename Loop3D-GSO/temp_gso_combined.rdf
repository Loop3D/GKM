    <gsmin:chemistryelements>Ba | V | O | H | Fe | Si</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba&lt;sub&gt;2-x&lt;/sub&gt;(V&lt;sup&gt;3+&lt;/sup&gt;OH)&lt;sub&gt;x&lt;/sub&gt;V&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;9&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;,Fe&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2010-007</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-40146</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:40146:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-40146.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba&lt;sub&gt;2-x&lt;/sub&gt;(V&lt;sup&gt;3+&lt;/sup&gt;OH)&lt;sub&gt;x&lt;/sub&gt;V&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;9&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;,Fe&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;22&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Greenwoodite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Greenwoodite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Bartholomew P R, Mancini F, Harlow G E, Deifel N, Cahill C, Bernhardt H J (2012) Greenwoodite, a new nesosilicate from British Columbia with a Ba-VOH coupled substitution and tetrahedral Fe: description and structure, The Canadian Mineralogist 50, 1233-1242</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">silicate</gsmin:strunzlabel>
    <gsmin:wikipediadate>2010-007</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/haiweeite">
