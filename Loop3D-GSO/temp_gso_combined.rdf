  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/nioboaeschynite-ce">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Nioboaeschynite-(Ce)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ce | Ca | Nb | Ti | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">aeschynite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/nioboaeschynitece.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ce,Ca)(Nb,Ti)&lt;sub&gt;2&lt;/sub&gt;(O,OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:mindatid>min-2908</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2908:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2908.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ce&lt;sup&gt;3+&lt;/sup&gt;,Ca)(Nb&lt;sup&gt;5+&lt;/sup&gt;,Ti&lt;sup&gt;4+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;(O,OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R110056</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nioboaeschynite-(Ce)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Nioboaeschynite-(Ce)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Zhabin A G, Mukhitdinov G N, Kazakova M E (1960) Paragenetic associations of accessory rare-element minerals in exocontact fenitized rocks of the miaskite intrusive of Vishnevye Gor, Trudy Institut Mineralogii, Geokhimii, Kristallokhim. Redkikh Elementov, Akademiia Nauk SSSR 4, 51-73 Originally named niobo-aeschynite: Fleischer M (1962) New mineral names, American Mineralogist 47, 414-420 Name changed to niobo-aeschynite-(Ce): Nickel E H, Mandarino J A (1987) Procedures involving the IMA Commission on New Minerals and Mineral Names and guidelines on mineral nomenclature, American Mineralogist 72, 1031-1042 Name changed from niobo-aeschynite-(Ce): Burke E A J (2008) Tidying up mineral names: an IMA-CNMNC scheme for suffixes, hyphens and diacritical marks, The Mineralogical Record 39, 131-135</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Aeschynite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.DF.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With large (+- medium-sized) cations; dimers and trimers of edgesharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://webmineral.com/data/Nioboaeschynite-(Ce).shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1960</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/spryite">
