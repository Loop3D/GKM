  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/dufrenite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Dufrénite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Fe | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">Dufrénite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/dufrenite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;0.5&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1323</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1323:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1323.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;0.5&lt;/sub&gt;Fe&lt;sup&gt;2+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;6&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Dufrénite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Dufrenite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Brongniart A (1833) Dufrénite, in Tableau de la distribution méthodique des espèces minérales, suivie dans le cours de minèralogie fait au Musèum Royal d'Histoire Naturelle en 1833, A la Librairie Encyclopèdique de Roret (Paris) 20-20 Redefined: Frondel C (1949) The dufrenite problem, American Mineralogist 34, 513-540</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Dufrénite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DK.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 &gt; 1:1 and &lt; 2:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Dufrenite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1803</gsmin:wikipediadate>
  </rdf:Description>
