    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2471:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2471.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Manganosegelerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Manganosegelerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Voloshin A V, Pakhomovskiy Y A, Tyusheva F N (1992) Manganosegelerite (Mn,Ca)(Mn,Fe,Mg)Fe3+(PO4)2(OH)·4H2O: a new phosphate of the overite group from granitic pegmatites of the Kola Peninsula, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 121, issue 2, 95-103 Jambor J L, Grew E S (1994) New mineral names, American Mineralogist 79, 185-189</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Overite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.DH.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With large and medium-sized cations, (OH, etc.):RO4 &lt; 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Manganosegelerite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1984-055</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/crocoite">
