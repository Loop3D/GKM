    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: ManganeseII magnesium zinc nesosilicate tetrahydroxyl</gsmin:iupacchemname>
