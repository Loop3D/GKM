  <rdf:Description rdf:about="https://w3id.org/gso/1.0/common/Endurant">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">The main characteristic of endurants is that they are fully present at any timepoint they exist, but they can change from one timepoint to another - something can be red at one time, and pink at another time. Endurants have onl;y endurants as parts.</rdfs:comment>
    <rdfs:label xml:lang="en">Endurant</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/common/Particular"/>
