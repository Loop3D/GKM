    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CsNa&lt;sub&gt;6&lt;/sub&gt;Be&lt;sub&gt;2&lt;/sub&gt;Al&lt;sub&gt;3&lt;/sub&gt;Si&lt;sub&gt;15&lt;/sub&gt;O&lt;sub&gt;39&lt;/sub&gt;F&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Telyushenkoite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Telyushenkoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Agakhanov A A, Pautov L A, Belakovskiy D I, Sokolova E V, Hawthorne F C (2003) Telyushenkoite CsNa6[Be2(Si,A1,Zn)18O39F2] - a new cesium mineral of the leifite group, New Data on Minerals. Moscow 38, 5-8</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Leifite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EH.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Transitional structure between phyllosilicate and other silicate units</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Telyushenkoite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2001-012</gsmin:wikipediadate>
