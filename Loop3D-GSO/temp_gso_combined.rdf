  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfault/High_Angle_Fault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI faulttype SKOS vocabulary 2016-10-19</dct:source>
    <rdfs:comment xml:lang="en">Fault that dips at least 45 degrees over more than half of its recognized extent, for which slip or separation is not explicitly specified.</rdfs:comment>
    <rdfs:label xml:lang="en">high angle fault</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfault/Fault"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/fraipontite">
