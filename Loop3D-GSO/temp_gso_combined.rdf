    <gsmin:chemistryelements>Ca | Y | Mg | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(CaY&lt;sub&gt;2&lt;/sub&gt;)Mg&lt;sub&gt;2&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2009-050</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Diyttrium calcium dimagnesium trinesosilicate</gsmin:iupacchemname>
    <gsmin:mindatid>min-42520</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:42520:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-42520.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaY&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Mg&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;3&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Menzerite-(Y)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Menzerite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Grew E S, Marsh J H, Yates M G, Lazic B, Armbruster T, Locock A, Bell S W, Dyar M D, Bernhardt H J, Medenbach O (2010) Menzerite-(Y), a new species, {(Y,REE)(Ca,Fe^2+^)_2_}[(Mg,Fe^2+^)(Fe^3+^,Al)](Si_3_)O_12_, from a felsic granulite, Parry Sound, Ontario, and a new garnet end-member, {Y_2_Ca}[Mg_2_](Si_3_)O_12_, The Canadian Mineralogist 48, 1171-1193</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Garnet</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AD.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate without additional anions; cations in [6] and/or greater coordination</gsmin:strunzlabel>
    <gsmin:wikipediadate>2009-050</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/roselite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Roselite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Co | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">roselite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/roselite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Co(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3450</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3450:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3450.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Co&lt;sup&gt;2+&lt;/sup&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R100191 | R150066</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Roselite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Roselite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Levy M, Children J G (1824) Account of a new mineral substance, The Annals of Philosophy 8, 439-442</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Roselite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CG.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With large and medium-sized cations, RO4:H2O = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Roselite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1824</gsmin:wikipediadate>
  </rdf:Description>
