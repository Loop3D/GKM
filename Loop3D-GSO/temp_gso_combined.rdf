    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zeunerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Zeunerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Weisbach A (1872) Mittheilungen an Professor H.B. Geinitz, Freiberg, den 9. Februar 1872, Neues Jahrbuch für Mineralogie, Geologie und Palaontologie 1872, 206-208</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Autunite</gsmin:structuralgroup>
