  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologiclineation/crenulation_lineation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI lineationtype SKOS vocabulary 2016-11-21</dct:source>
    <rdfs:comment xml:lang="en">Lineation defined by small-scale wrinkles, typically of phylosillicate minerals, on another surface, typically a cleavage or schistosity. Use instead of intersection lineation if the wrinkles are the measured feature and the intersecting planar feature is not apparent.</rdfs:comment>
    <rdfs:label xml:lang="en">crenulation lineation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologiclineation/tectonic_lineation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/cupropearceite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
