    <gsmin:rruffids>R060882</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Marcasite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Marcasite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mineral name has been known since antiquity and predates any formal descriptive publication. For example: Hill J (1751) Of vitriolic minerals. in A History of the Materia Medica, Longman, Hitch and Hawes (London) 140-147</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Marcasite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.EB.10a</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide, M: S &lt;= 1:2 with Fe, Co, Ni, PGE, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Marcasite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>old</gsmin:wikipediadate>
  </rdf:Description>
