  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/shibkovite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Shibkovite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Ca | Zn | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">milarite</gsmin:fleischersgroup>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;Ca&lt;sub&gt;2&lt;/sub&gt;(Zn&lt;sub&gt;3&lt;/sub&gt;Si&lt;sub&gt;12&lt;/sub&gt;)O&lt;sub&gt;30&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1997-018</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-7290</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:7290:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-7290.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;Ca&lt;sub&gt;2&lt;/sub&gt;(Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Si&lt;sub&gt;12&lt;/sub&gt;)O&lt;sub&gt;30&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R080040</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Shibkovite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Shibkovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pautov L A, Agakhanov A A, Sokolova E V (1998) Shibkovite K(Ca, Mn, Na)2 (K2-x x)2Zn3Si12O30 — the new mineral from the milarite group, Zapiski Vserossijskogo Mineralogicheskogo Obshchestva 127, issue 4, 89-94</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Milarite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CM.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si6O18]12- 6-membered double rings (sechser-Doppelringe)</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Shibkovite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1997-018</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/selivanovaite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Selivanovaite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ti | Fe | Mn | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaTi&lt;sub&gt;3&lt;/sub&gt;(Ti,Na,Fe,Mn)&lt;sub&gt;4&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH,H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;4&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2015-126</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaTi&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;(Ti&lt;sup&gt;4+&lt;/sup&gt;,Na,Fe&lt;sup&gt;3+&lt;/sup&gt;,Mn&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;4&lt;/sub&gt;(Si&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;7&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH,H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;4&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Selivanovaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Selivanovaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pakhomovsky Y A, Panikorovskii T L, Yakovenchuk V N, Ivanyuk G Y, Mikhailova J A, Krivovichev S V, Bocharov V N, Kalashnikov A O (2018) Selivanovaite, NaTi_3_(Ti,Na,Fe,Mn)_4_[(Si_2_O_7_)_2_O_4_(OH,H_2_O)_4_]·nH_2_O, a new rock-forming mineral from the eudialyte-rich malignite of the Lovozero alkaline massif (Kola Peninsula, Russia). European Journal of Mineralogy 30, 525-535</gsmin:statusnotes>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ashcroftine-y">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ashcroftine-(Y)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Na | Y | Si | O | H | C</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/ashcroftiney.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;5&lt;/sub&gt;Na&lt;sub&gt;5&lt;/sub&gt;Y&lt;sub&gt;12&lt;/sub&gt;Si&lt;sub&gt;28&lt;/sub&gt;O&lt;sub&gt;70&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;8&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-389</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:389:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-389.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;5&lt;/sub&gt;Na&lt;sub&gt;5&lt;/sub&gt;Y&lt;sub&gt;12&lt;/sub&gt;Si&lt;sub&gt;28&lt;/sub&gt;O&lt;sub&gt;70&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;8&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R110189</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ashcroftine-(Y)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ashcroftine-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hey M H, Bannister F A (1933) Studies on the zeolites. Part IV. Ashcroftine (kalithomsonite of S.G. Gordon), Mineralogical Magazine 23, 305-308 Chemical formula revised: Moore P B, Bennett J M, Louisnathan S J (1969) Ashcroftine is not a zeolite!, Mineralogical Magazine 37, 515-517 Chemical formula revised again: Moore P B, Sen Gupta P K, Schlemper E O, Merlino S (1987) Ashcroftine, ca. K&lt;sub&gt;10&lt;/sub&gt;Na&lt;sub&gt;10&lt;/sub&gt;(Y,Ca)&lt;sub&gt;24&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;16&lt;/sub&gt;(Si&lt;sub&gt;56&lt;/sub&gt;O&lt;sub&gt;140&lt;/sub&gt;)·16H&lt;sub&gt;2&lt;/sub&gt;O, a structure with enormous polyanions, American Mineralogist 72, 1176-1189 Name changed from ashcroftine: Nickel E H, Mandarino J A (1987) Procedures involving the IMA Commission on New Minerals and Mineral Names and guidelines on mineral nomenclature, American Mineralogist 72, 1031-1042</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.DN.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 6-periodic double chains</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Ashcroftine-%28Y%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1933</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/High_Magnesium_Fine_Grained_Igneous_Rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">LeMaitre et al. 2002</dct:source>
    <rdfs:comment xml:lang="en">fine-grained igneous rock that contains unusually high concentration of MgO. For rocks that contain greater than 52 percent silica, MgO must be greater than 8 percent. For rocks containing less than 52 percent silica, MgO must be greater than 12 percent.</rdfs:comment>
    <rdfs:label xml:lang="en">high magnesium fine grained igneous rock</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/rockmaterial/Fine_Grained_Igneous_Rock"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/malhmoodite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Malhmoodite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Fe | Zr | P | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/mahlmoodite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;Zr(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1992-001</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Renamed</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: IronII zirconium diphosphate tetrahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2544</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2544:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2544.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fe&lt;sup&gt;2+&lt;/sup&gt;Zr&lt;sup&gt;4+&lt;/sup&gt;(P&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060462</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Malhmoodite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Malhmoodite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Milton C, McGee J J, Evans H T (1993) Mahlmoodite, FeZr(PO_4_)_2_·4H_2_O, a new iron zirconium phosphate mineral from Wilson Springs, Arkansas, American Mineralogist 78, 437-440 Name changed from mahlmoodite: Grice J D, Ferraris G (2003) New minerals approved in 2002 and nomenclature modifications approved in 1998-2002 by the Commission on the New Minerals and Mineral Names, International Mineralogical Association, The Canadian Mineralogist 41, 795-802</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.CE.75</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With only medium-sized cations, RO4:H2O about 1:2.5</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Mahlmoodite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1992-001</gsmin:wikipediadate>
  </rdf:Description>
