    <gsmin:statusnotes xml:lang="en">Graham A R, Kaiman S (1952) Aurostibite, AuSb&lt;sub&gt;2&lt;/sub&gt;; a new mineral in the pyrite group, American Mineralogist 37, 461-469</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Pyrite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.EB.05a</gsmin:strunzcodeV10>
