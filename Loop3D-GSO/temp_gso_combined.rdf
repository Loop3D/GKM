    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Ca,Na,K)&lt;sub&gt;0.9&lt;/sub&gt;(V&lt;sup&gt;5+&lt;/sup&gt;,V&lt;sup&gt;4+&lt;/sup&gt;,Fe&lt;sup&gt;2+&lt;/sup&gt;,Ti)&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;20&lt;/sub&gt;·4H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Redefined|Approved</gsmin:imastatus>
