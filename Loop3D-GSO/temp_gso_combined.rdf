  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/natroglaucocerinite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Natroglaucocerinite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Zn | Al | O | H | S | Na</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sub&gt;6&lt;/sub&gt;Al&lt;sub&gt;3&lt;/sub&gt;(OH)&lt;sub&gt;18&lt;/sub&gt;[Na(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;6&lt;/sub&gt;](SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1995-025</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Questionable mineral species|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-10812</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:10812:2"/>
    <gsmin:mindaturl>http://www.mindat.org/min-10812.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;8-x&lt;/sub&gt;Al&lt;sub&gt;x&lt;/sub&gt;(OH)&lt;sub&gt;16&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;x/2+y/2&lt;/sub&gt;Na&lt;sub&gt;y&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Natroglaucocerinite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Natroglaucocerinite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Witzke T, Pöllmann H, Vogel A (1995) Struktur und synthese von [Zn_8-x_Al_x_(OH)_16_(SO_4_)_x/2+y/2_Na_y_(H_2_O)_6_], Zeitschrift für Kristallographie 9 supplementary, 252-252</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Woodwardite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.DD.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With only medium-sized cations; sheets of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Natroglaucocerinite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1995-025</gsmin:wikipediadate>
  </rdf:Description>
