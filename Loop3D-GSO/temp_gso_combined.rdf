    <gsmin:rruffnameplain xml:lang="en">Cesarferreiraite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Scholz R, Chukanov N V, Menezes L A D, Atencio D, Lagoeiro L, Belotti F M, Chaves M L S C, Romano A W, Brandão P R, Belakovskiy D I, Pekov I (2014) Césarferreiraite, Fe^2+^Fe^3+^_2_(AsO_4_)_2_(OH)_2_8·H_2_O, from Eduardo mine, Conselheiro Pena, Minas Gerais, Brazil: Second arsenate in the laueite mineral group. American Mineralogist 99, 607-611</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Laueite</gsmin:structuralgroup>
