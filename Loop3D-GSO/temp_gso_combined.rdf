    <gsmin:rruffids>R060104</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ammonioleucite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ammonioleucite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hori H, Nagashima K, Yamada M, Miyawaki R, Marubashi T (1986) Ammonioleucite, a new mineral from Tatarazawa, Fujioka, Japan, American Mineralogist 71, 1022-1027</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.GB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Zeolite family: Chains of single connected 4-membered rings</gsmin:strunzlabel>
