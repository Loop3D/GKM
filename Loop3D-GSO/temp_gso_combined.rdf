    <rdfs:label xml:lang="en">Plumbonacrite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | C | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/plumbonacrite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;5&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;O(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved|Redefined</gsmin:imastatus>
    <gsmin:mindatid>min-3229</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3229:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3229.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;5&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;O(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R160063 | R130567</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Plumbonacrite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Plumbonacrite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Heddle M F (1889) On dudgeonite, hydroplumbite, plumbonacrite, and plattnerite, Mineralogical Magazine 8, 200-203</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.BE.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate with additional anions, without H2O, With Pb, Bi</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Plumbonacrite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1889</gsmin:wikipediadate>
  </rdf:Description>
