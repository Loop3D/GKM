    <gsmin:rruffids>R050403</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Delafossite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Delafossite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Friedel C (1873) Sur une combinaison naturelle des oxydes de fer et de cuivre, et sur la reproduction de l'atacamite, Comptes Rendus Hebdomadaires des Séances de l’Académie des Sciences 77, 211-214</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.AB.15</gsmin:strunzcodeV10>
