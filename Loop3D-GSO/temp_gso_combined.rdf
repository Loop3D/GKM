    <gsmin:mindatid>min-821</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:821:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-821.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;Ca(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bütschliite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Butschliite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Milton C, Axelrod J (1947) Fused wood-ash stones: Fairchildite K&lt;sub&gt;2&lt;/sub&gt;CO&lt;sub&gt;3&lt;/sub&gt;·CaCO&lt;sub&gt;3&lt;/sub&gt;, buetschliite 3K&lt;sub&gt;2&lt;/sub&gt;CO&lt;sub&gt;3&lt;/sub&gt;·2CaCO&lt;sub&gt;3&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O and calcite, CaCO&lt;sub&gt;3&lt;/sub&gt;, their essential components, American Mineralogist 32, 607-624</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.AC.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate without additional anions, without H2O, Alkali and alkali-earth carbonates</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Butschliite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1947</gsmin:wikipediadate>
