    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3348:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3348.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;4&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Rabejacite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Rabejacite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Deliens M, Piret P (1993) La rabejacite, Ca(UO_2_)_4_(SO_4_)_2_(OH)_6_·6H_2_O, nouveau sulfate d'uranyle et de calcium des gîtes du Lodévois, Hérault, France, European Journal of Mineralogy 5, 873-877 Chemical formula revised from Ca(UO_2_)_4_(SO_4_)_2_(OH)_6_·6H_2_O: Plášil J, Dušek M, Cejka J, Sejkora J (2014) The crystal structure of rabejacite, the Ca^2+^-dominant member of the zippeite group. Mineralogical Magazine 78, 1249-1264</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.EC.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl sulfate, With medium-sized and large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Rabejacite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1992-043</gsmin:wikipediadate>
