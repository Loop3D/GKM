    <gsmin:mindaturl>http://www.mindat.org/min-2577.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;2&lt;/sub&gt;Pb&lt;sub&gt;7&lt;/sub&gt;(Si&lt;sub&gt;36&lt;/sub&gt;Al&lt;sub&gt;12&lt;/sub&gt;)O&lt;sub&gt;99&lt;/sub&gt;·n(H&lt;sub&gt;2&lt;/sub&gt;O,OH)</gsmin:rruffchemistry>
    <gsmin:rruffids>R120147</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Maricopaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Maricopaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Peacor D R, Dunn P J, Simmons W B, Wicks F J, Raudsepp M (1988) Maricopaite, a new hydrated Ca-Pb, zeolite-like silicate from Arizona, The Canadian Mineralogist 26, 309-313 Jambor J L, Vanko D A (1989) New mineral names, American Mineralogist 74, 946-951</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.GD.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Zeolite family: Chains of 6-membered rings – tabular zeolites</gsmin:strunzlabel>
