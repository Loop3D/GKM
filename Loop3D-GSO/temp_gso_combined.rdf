  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/neptunite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Neptunite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Na | Li | Fe | Ti | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">neptunite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/neptunite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KNa&lt;sub&gt;2&lt;/sub&gt;LiFe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Ti&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2883</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2883:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2883.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KNa&lt;sub&gt;2&lt;/sub&gt;LiFe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R060628 | R060746</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Neptunite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Neptunite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Flink G (1893) Om några mineral från Grönland, Geologiska Föreningens i Stockholm Förhandlingar 15, 195-208 Chemical formula revised from KNa_3_Fe_2_Ti_2_Si_8_O_24_: Cannillo E, Mazzi F, Rossi G (1966) The crystal structure of neptunite, Acta Crystallographica 21, 200-208</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Neptunite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EH.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Transitional structure between phyllosilicate and other silicate units</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Neptunite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1893</gsmin:wikipediadate>
  </rdf:Description>
