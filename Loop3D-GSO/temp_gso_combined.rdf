  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologiclineation/stretching_lineation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI lineationtype SKOS vocabulary 2016-11-21</dct:source>
    <rdfs:comment xml:lang="en">Lineation defined by elongate (prolate) fabric elements in which the alignment of the fabric elements, and the formation of prolate fabric elements is interpreted to be the product of crystal plastic deformation processes. Associated with mylontic foliation.</rdfs:comment>
    <rdfs:label xml:lang="en">stretching lineation</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologiclineation/particle_shape_lineation"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologiclineation/tectonic_lineation"/>
  </rdf:Description>
