  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/russoite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Russoite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>N | H | Cl | As | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(NH&lt;sub&gt;4&lt;/sub&gt;)ClAs&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;3&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;0.5&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2015-105</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(NH&lt;sub&gt;4&lt;/sub&gt;)ClAs&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;3&lt;/sub&gt;(H&lt;sub&gt;2&lt;/sub&gt;O)&lt;sub&gt;0.5&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Russoite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Russoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Campostrini I, Demartin F, Scavini M (2019) Russoite, NH_4_ClAs_2_^3+^O_3_(H_2_O)_0.5_, a new phylloarsenite mineral from Solfatara Di Pozzuoli, Napoli, Italy. Mineralogical Magazine 83, 89-94</gsmin:statusnotes>
