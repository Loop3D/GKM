  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/luanshiweiite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Luanshiweiite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Li | Al | Si | O | H</gsmin:chemistryelements>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KLiAl&lt;sub&gt;1.5&lt;/sub&gt;(Si&lt;sub&gt;3.5&lt;/sub&gt;Al&lt;sub&gt;0.5&lt;/sub&gt;)O&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2011-102</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KLiAl&lt;sub&gt;1.5&lt;/sub&gt;(Si&lt;sub&gt;3.5&lt;/sub&gt;Al&lt;sub&gt;0.5&lt;/sub&gt;)O&lt;sub&gt;10&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Luanshiweiite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Luanshiweiite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Fan G, Li G, Shen G, Xu J, Dai J (2013) Luanshiweiite: A new member of lepidolite series. Acta Mineralogica Sinica 33, 713-721</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Mica</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/fluorcarmoite-bana">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Fluorcarmoite-(BaNa)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ba | Na | Ca | Mg | Al | P | O | H | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;Na&lt;sub&gt;2&lt;/sub&gt;Na&lt;sub&gt;2&lt;/sub&gt;&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;CaMg&lt;sub&gt;13&lt;/sub&gt;Al(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;11&lt;/sub&gt;(PO&lt;sub&gt;3&lt;/sub&gt;OH)F&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2015-062</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved|Pending publication</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ba&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;Na&lt;sub&gt;2&lt;/sub&gt;Na&lt;sub&gt;2&lt;/sub&gt;&lt;span style="border: 1px solid #333; font-size:7px;"&gt; &lt;/span&gt;CaMg&lt;sub&gt;13&lt;/sub&gt;Al(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;11&lt;/sub&gt;(PO&lt;sub&gt;3&lt;/sub&gt;OH)F&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Fluorcarmoite-(BaNa)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Fluorcarmoite-(BaNa)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Cámara, F., Bittarello, E., Ciriotti, M.E., Nestola, F., Radica, F. and Bracco, R. (2015) Fluorcarmoite-(BaNa), IMA 2015-062. CNMNC Newsletter No. 27, October 2015, page 1229; Mineralogical Magazine, 79, 1229–1236</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Arrojadite</gsmin:structuralgroup>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/woodwardite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Woodwardite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Al | S | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">unknown</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">woodwardite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/woodwardite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Cu&lt;sub&gt;1-x&lt;/sub&gt;Al&lt;sub&gt;x&lt;/sub&gt;)(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;x/2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O (x &lt; 0.5, n &lt; 3x/2)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4314</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4314:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4314.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Cu&lt;sup&gt;2+&lt;/sup&gt;,Al)&lt;sub&gt;9&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;18&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060762</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Woodwardite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Woodwardite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Church A H (1866) Chemical researches on new and rare Cornish minerals, Journal of the Chemical Society 19, 130-135</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hydrotalcite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.DD.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With only medium-sized cations; sheets of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Woodwardite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1866</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/kobeite-y">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Kobeite-(Y)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Y | U | Ti | Nb | O | H</gsmin:chemistryelements>
    <gsmin:fleischersgroup xml:lang="en">columbite-euxenite-euxenite subgroup</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/kobeitey.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Y,U)(Ti,Nb)&lt;sub&gt;2&lt;/sub&gt;(O,OH)&lt;sub&gt;6&lt;/sub&gt; (?)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2232</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2232:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2232.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Y&lt;sup&gt;3+&lt;/sup&gt;,U&lt;sup&gt;6+&lt;/sup&gt;,U&lt;sup&gt;4+&lt;/sup&gt;)(Ti&lt;sup&gt;4+&lt;/sup&gt;,Nb&lt;sup&gt;5+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;(O,OH)&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Kobeite-(Y)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Kobeite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Takubo J, Ukai Y, Minato T (1950) Studies on the minerals containing rare elements (Part II) A new mineral found in Kobe-mura, Kyoto Prefecture, Japan, Chishitsugaku Zasshi 56, 509-513 Name changed from kobeite: Nickel E H, Mandarino J A (1987) Procedures involving the IMA Commission on New Minerals and Mineral Names and guidelines on mineral nomenclature, American Mineralogist 72, 1031-1042</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.DG.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With large (+- medium-sized) cations; chains of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Kobeite-%28Y%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1950</gsmin:wikipediadate>
  </rdf:Description>
