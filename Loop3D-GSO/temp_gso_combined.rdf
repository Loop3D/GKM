    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3402:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3402.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;4&lt;/sub&gt;(Mg&lt;sub&gt;8&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;)O&lt;sub&gt;4&lt;/sub&gt;[Si&lt;sub&gt;6&lt;/sub&gt;Al&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;36&lt;/sub&gt;]</gsmin:rruffchemistry>
    <gsmin:rruffids>R060316</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Rhönite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Rhonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Soellner J (1907) Ueber Rhönit, ein neues änigmatitähnliches mineral und über das vorkommen und die verbreitung desselben in basaltischen gesteinen, Neues Jahrbuch für Mineralogie, Geologie und Palaontologie 24, 475-547 Chemical formula revised: Grew E S, Hålenius U, Pasero M, Barbier J (2008) Recommended nomenclature for the sapphirine and surinamite group (sapphirine supergroup), Mineralogical Magazine 72, 839-876</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Sapphirine</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DH.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with 4-periodic single chains, Si4O12</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Rhonite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1907</gsmin:wikipediadate>
