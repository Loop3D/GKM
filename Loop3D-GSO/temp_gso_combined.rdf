  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/tuliokite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Tuliokite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ba | Th | C | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/tuliokite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;6&lt;/sub&gt;BaTh(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1988-041</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Hexasodium barium thorium hexacarbonate hexahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-4047</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4047:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4047.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;6&lt;/sub&gt;BaTh(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;6&lt;/sub&gt;·6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tuliokite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tuliokite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Yakovenchuk V N, Pakhomovskiy Y A, Voloshin A V, Bogdanova A N, Yamnova N A, Pushcharovskiy D Y (1990) Tuliokite Na_6_BaTh(CO_3_)_6_·H_2_O - a new hydrous carbonate of sodium, barium, and thorium, from alkalic pegmatites of the Khibiny massif (Kola Peninsula). Mineralogiceskij Zhurnal 12, 74-78</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.CB.50</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate without additional anions, with H2O, With large cations (alkali and alkali-earth carbonates)</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Tuliokite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1988-041</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/lemoynite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Lemoynite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Zr | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/lemoynite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;CaZr&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;10&lt;/sub&gt;O&lt;sub&gt;26&lt;/sub&gt;·5-6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1968-013</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2371</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2371:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2371.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;CaZr&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;10&lt;/sub&gt;O&lt;sub&gt;26&lt;/sub&gt;·5-6H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R080106</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Lemoynite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Lemoynite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Perrault G, Semenov E I, Bikova A V, Capitonova T A (1969) La lemoynite, un nouveau silicate hydraté de zirconium et de sodium de St. Hilaire, Québec, The Canadian Mineralogist 9, 585-596</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Lemoynite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DP.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate transitional ino-phyllosilicate structures</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Lemoynite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1968-013</gsmin:wikipediadate>
  </rdf:Description>
