    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">TiN</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Titanium nitride</gsmin:iupacchemname>
    <gsmin:mindatid>min-3035</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3035:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3035.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ti&lt;sup&gt;3+&lt;/sup&gt;N&lt;sup&gt;3-&lt;/sup&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Osbornite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Osbornite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Maskelyne N S (1870) On the mineral constituents of meteorites, Proceedings of the Royal Society of London 18, 146-157</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Rocksalt</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>01.BC.15</gsmin:strunzcodeV10>
