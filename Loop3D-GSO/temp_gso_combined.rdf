    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Lithium aluminium nesosilicate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1419</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1419:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1419.html</gsmin:mindaturl>
