    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zenzénite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Zenzenite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Holtstam D, Lindqvist B, Johnsson M, Norrestam R (1991) Zenzénite: Pb_3_(Fe^3+^,Mn^3+^)_4_Mn^4+^_3_O_15_, a new mineral species from Långban, Filipstad, Sweden, and its crystal structure, The Canadian Mineralogist 29, 347-354</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.CC.55</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 2: 3,3: 5, and similar, With large and medium-sized cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Zenzenite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1990-031</gsmin:wikipediadate>
  </rdf:Description>
