  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/ferrilotharmeyerite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ferrilotharmeyerite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Zn | Fe | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">tsumcorite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/ferrilotharmeyerite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaZnFe&lt;sup&gt;3+&lt;/sup&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1986-024</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Calcium zinc ironIII diarsenate hydroxyl hydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1495</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1495:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1495.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">CaZn&lt;sup&gt;2+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)·H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060209</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ferrilotharmeyerite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ferrilotharmeyerite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Ansell G H, Roberts A C, Dunn P J, Birch W D, Ansell V E, Grice J D (1992) Ferrilotharmeyerite, a new Ca-Zn-Fe^3+^ hydroxyl arsenate from Tsumeb, Namibia, The Canadian Mineralogist 30, 225-227 Chemical formula revised from CaZnFe(AsO_3_OH)_2_(OH)_3_: Krause W, Belendorff K, Bernhardt H J, McCammon C A, Effenberger H, Mikenda W (1998) Crystal chemistry of the tsumcorite-group minerals. New data on ferrilotharmeyerite, tsumcorite, thometzekite, mounanaite, helmutwinklerite, and a redefinition of gartrellite, European Journal of Mineralogy 10, 179-206</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Natrochalcite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.CG.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, with H2O, With large and medium-sized cations, RO4:H2O = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Ferrilotharmeyerite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1986-024</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/melanophlogite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
