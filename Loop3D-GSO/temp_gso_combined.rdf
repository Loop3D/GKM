  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/depmeierite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Depmeierite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Al | Si | O | P | C | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;8&lt;/sub&gt;[Al&lt;sub&gt;6&lt;/sub&gt;Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;](PO&lt;sub&gt;4&lt;/sub&gt;,CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;1-x&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O (x&lt; 0.5)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2009-075</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-39787</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:39787:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-39787.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;8&lt;/sub&gt;(Al&lt;sub&gt;6&lt;/sub&gt;Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;)(PO&lt;sub&gt;4&lt;/sub&gt;,CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;1-x&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O; (x&lt;0.5)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Depmeierite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Depmeierite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pekov I V, Olysych L V, Chukanov N V, Van K V, Pushcharovsky D Y (2010) Depmeierite Na&lt;sub&gt;8&lt;/sub&gt;[Al&lt;sub&gt;6&lt;/sub&gt;Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;24&lt;/sub&gt;](PO&lt;sub&gt;4&lt;/sub&gt;,CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;1-x&lt;/sub&gt;·3H&lt;sub&gt;2&lt;/sub&gt;O (x&lt;0.5) - a new cancrinite group mineral from the Lovozero alkaline massif (Kola Peninsula, Russia), Zapiski Rossiiskogo Mineralogicheskogo Obshchetstva 139(4), 63-74</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Cancrinite</gsmin:structuralgroup>
