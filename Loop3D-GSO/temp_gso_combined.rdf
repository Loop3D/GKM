    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2112:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2112.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KBa&lt;sub&gt;2&lt;/sub&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(Si&lt;sub&gt;5&lt;/sub&gt;Al)O&lt;sub&gt;18&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070735 | R080005</gsmin:rruffids>
