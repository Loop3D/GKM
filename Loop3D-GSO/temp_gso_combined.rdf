    <rdfs:domain rdf:resource="https://w3id.org/gso/1.0/common/Measure_Value"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#anySimpleType"/>
    <rdfs:subPropertyOf rdf:resource="https://w3id.org/gso/1.0/common/isFundamentallyRelatedTo"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/johnbaumite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Johnbaumite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/mineral/apatitegroup"/>
    <gsmin:chemistryelements>Ca | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">apatite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/johnbaumite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;5&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;(OH)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1980-B</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Pentacalcium triarsenate hydroxyl</gsmin:iupacchemname>
    <gsmin:mindatid>min-2105</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2105:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2105.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;5&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;OH</gsmin:rruffchemistry>
    <gsmin:rruffids>R070753</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Johnbaumite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Johnbaumite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Dunn P J, Peacor D R, Newberry N (1980) Johnbaumite, a new member of the apatite group from Franklin, New Jersey, American Mineralogist 65, 1143-1145</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Apatite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.BN.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With only large cations, (OH, etc.):RO4 = 0.33:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Johnbaumite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>0</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/delvauxite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
