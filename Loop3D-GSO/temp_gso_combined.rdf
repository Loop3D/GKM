  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/thaumasite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Thaumasite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | Si | O | H | S | C</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">ettringite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/thaumasite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;3&lt;/sub&gt;Si(OH)&lt;sub&gt;6&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)(SO&lt;sub&gt;4&lt;/sub&gt;)·12H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3933</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3933:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3933.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;3&lt;/sub&gt;Si(OH)&lt;sub&gt;6&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)(CO&lt;sub&gt;3&lt;/sub&gt;)·12H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060296 | R060814</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Thaumasite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Thaumasite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Nordenskiöld A E (1878) Sur une nouvelle espèce minérale nommée thaumasite, Comptes Rendus Hebdomadaires des Séances de l’Académie des Sciences 87, 313-314</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Ettringite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.DG.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With large and medium-sized cations; with NO3, CO3, B(OH)4, SiO4 or IO3</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Thaumasite.shtml</gsmin:webmineralurl>
