    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:39438:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-39438.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KCa&lt;sub&gt;7&lt;/sub&gt;Sn&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Li&lt;sub&gt;3&lt;/sub&gt;Si&lt;sub&gt;12&lt;/sub&gt;O&lt;sub&gt;36&lt;/sub&gt;F&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Aleksandrovite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Aleksandrovite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pautov L A, Agakhanov A A, Karpenko V Y, Gafurov F G (2010) Aleksandrovite KLi&lt;sub&gt;3&lt;/sub&gt;Ca&lt;sub&gt;7&lt;/sub&gt;Sn&lt;sub&gt;2&lt;/sub&gt;[Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;]&lt;sub&gt;2&lt;/sub&gt;F&lt;sub&gt;2&lt;/sub&gt; - a new tin mineral, New Data on Minerals. Moscow 45, 5-16</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Baratovite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CJ.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si6O18]12- 6-membered single rings (sechser-Einfachringe), without insular complex anions</gsmin:strunzlabel>
    <gsmin:wikipediadate>2009-004</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/hanksite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Hanksite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Na | S | O | C | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/hanksite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KNa&lt;sub&gt;22&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;9&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;Cl</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Potassium docosasodium nonasulfate dicarbonate chloride</gsmin:iupacchemname>
    <gsmin:mindatid>min-1815</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1815:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1815.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">KNa&lt;sub&gt;22&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;9&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;Cl&lt;sup&gt;1-&lt;/sup&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R050291</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Hanksite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Hanksite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Hidden W E (1885) On hanksite, a new anhydrous sulphato-carbonate of sodium, from San Bernardino County, California, American Journal of Science 130, 133-135</gsmin:statusnotes>
    <gsmin:strunzcodeV10>07.BD.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions, without H2O, With only large cations</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Hanksite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1885</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/magnesiohulsite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Magnesiohulsite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Mg | Fe | O | B</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">pinakiolite</gsmin:fleischersgroup>
