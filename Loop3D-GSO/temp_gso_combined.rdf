    <gsmin:rruffnameplain xml:lang="en">Namibite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">von Knorring O, Sahama T G (1981) Namibite, a new copper-bismuth-vanadium mineral from Namibia, Schweizerische Mineralogische und Petrographische Mitteilungen 61, 7-12</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.BB.50</gsmin:strunzcodeV10>
