    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1501:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1501.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;2.4&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;1.7&lt;/sub&gt;(OH)&lt;sub&gt;3&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060055</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ferrisurite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Ferrisurite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Kampf A R, Jackson L L, Sidder G B, Foord E E, Adams P M (1992) Ferrisurite, the Fe^3+^ analogue of surite, from Inyo County, California, American Mineralogist 77, 1107-1111</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.EC.75</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate with mica sheets, composed of tetrahedral and octahedral nets</gsmin:strunzlabel>
