  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfoliation/spaced_cleavage">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Cleavage in which cleavage domains are spaced at finite intervals as the scale of description. Microlithons of uncleaved rock separate cleavage domains.</rdfs:comment>
    <dct:source xml:lang="en">Borradaile et al. 1982</dct:source>
    <rdfs:label xml:lang="en">spaced cleavage</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geologicfoliation/cleavage"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/ischart/Gelasian2017">
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geologictime/Age"/>
    <rdf:type rdf:resource="https://w3id.org/gso/1.0/geology/Specific_Geologic_Time_Unit"/>
    <rdfs:comment xml:lang="en">older bound -2.58 Ma</rdfs:comment>
    <rdfs:comment xml:lang="en">younger bound -1.80 Ma</rdfs:comment>
    <rdfs:label xml:lang="en">Gelasian Age</rdfs:label>
