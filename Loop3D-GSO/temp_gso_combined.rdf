  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/zincaluminite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Zincaluminite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Zn | Al | S | O | H</gsmin:chemistryelements>
    <gsmin:fleischersgroup xml:lang="en">woodwardite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/zincaluminite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Zn&lt;sub&gt;1-x&lt;/sub&gt;Al&lt;sub&gt;x&lt;/sub&gt;)(SO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;x/2&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O (x &lt; 0.5, n &gt; 3x/2)</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Questionable mineral species|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-4409</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4409:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4409.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Zn&lt;sup&gt;2+&lt;/sup&gt;,Al)&lt;sub&gt;9&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;18&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Zincaluminite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Zincaluminite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Damour A A (1881) Essais chimiques et analyse d´un sulfate basique d´alumine et de zinc hydraté, nouvelle espèce minérale, Bulletin de la Société Minéralogique de France 4, 136-138</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Woodwardite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>07.DD.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sulfate, selenate, etc. with additional anions and H2O, With only medium-sized cations; sheets of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Zincaluminite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>0</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/hitachiite">
