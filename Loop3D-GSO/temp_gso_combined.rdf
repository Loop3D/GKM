    <gsmin:mindaturl>http://www.mindat.org/min-1709.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Co&lt;sup&gt;3+&lt;/sup&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;(AsS)&lt;sup&gt;3-&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R070644 | R070294</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Glaucodot</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Glaucodot</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Breithaupt A, Plattner C F (1849) Bestimmung neuer mineralien: Glaukodot, Annalen der Physik und Chemie 153, 127-141 Chemical formula redefined: Yang H, Downs R T (2008) Crystal structure of glaucodot, (Co,Fe)AsS, and its relationships to marcasite and arsenopyrite, American Mineralogist 93, 1183-1186</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Arsenopyrite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.EB.10c</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide, M: S &lt;= 1:2 with Fe, Co, Ni, PGE, etc.</gsmin:strunzlabel>
