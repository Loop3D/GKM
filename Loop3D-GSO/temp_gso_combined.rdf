    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pd&lt;sub&gt;8&lt;/sub&gt;Hg&lt;sub&gt;3&lt;/sub&gt;Se&lt;sub&gt;9&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2001-061</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Octalead trimercury nonaselenide</gsmin:iupacchemname>
    <gsmin:mindatid>min-11112</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:11112:6"/>
    <gsmin:mindaturl>http://www.mindat.org/min-11112.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pd&lt;sub&gt;8&lt;/sub&gt;Hg&lt;sub&gt;3&lt;/sub&gt;Se&lt;sub&gt;9&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tischendorfite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tischendorfite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Stanley C J, Criddle A J, Föster H J, Roberts A C (2002) Tischendorfite, Pd_8_Hg_3_Se_9_, a new mineral species from Tilkerode, Harz Mountains, Germany, The Canadian Mineralogist 40, 739-745</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.BC.65</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Metal sulfide M:S &gt; 1:1 with Rh, Pd, Pt, etc.</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Tischendorfite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2001-061</gsmin:wikipediadate>
  </rdf:Description>
