  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/karenwebberite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Karenwebberite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Fe | Mn | P | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na(Fe&lt;sup&gt;2+&lt;/sup&gt;,Mn&lt;sup&gt;2+&lt;/sup&gt;)(PO&lt;sub&gt;4&lt;/sub&gt;)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2011-015</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-42362</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:42362:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-42362.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na(Fe&lt;sup&gt;2+&lt;/sup&gt;,Mn&lt;sup&gt;2+&lt;/sup&gt;)PO&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Karenwebberite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Karenwebberite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Vignola P, Hatert F, Fransolet A M, Mendenbach O, Diella V, Andò S (2013) Karenwebberite, Na(Fe^2+^,Mn^2+^)PO_4_, a new member of the triphylite group from the Malpensata pegmatite, Lecco Province, Italy, American Mineralogist 98, 767-772</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Olivine</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>08.AB.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, without H2O, With medium-sized cations</gsmin:strunzlabel>
    <gsmin:wikipediadate>2011-015</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicfault/Strike_Slip_Fault">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">CGI faulttype SKOS vocabulary 2016-10-19</dct:source>
    <rdfs:comment xml:lang="en">Fault with strike-parallel displacement component of slip vector more than 10 times the dip-parallel component of the slip vector at at least one location along the mapped trace of the fault.</rdfs:comment>
