    <gsmin:statusnotes xml:lang="en">Steinmann J (1826) Kákoxèn, Archiv für die Gesammte Naturlehre 8, 446-446</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.DC.40</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions and H2O, With only medium-sized cations, (OH, etc.):RO4 = 1:1 and &lt; 2:1</gsmin:strunzlabel>
