    <gsmin:fleischersgroup xml:lang="en">adelite-descloizite-descloizite subgroup</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/mottramite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">PbCu(VO&lt;sub&gt;4&lt;/sub&gt;)(OH)</gsmin:imachemistry>
