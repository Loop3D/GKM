    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | C | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">monoclinic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/gaylussite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;Ca(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Disodium calcium dicarbonate pentahydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1662</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1662:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1662.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;Ca(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R040146</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Gaylussite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Gaylussite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Boussingault J B (1826) Analyse d'une nouvelle substance minérale (la Gay-Lussite), Annales de Chimie et de Physique 31, 270-276</gsmin:statusnotes>
    <gsmin:strunzcodeV10>05.CB.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Carbonate without additional anions, with H2O, With large cations (alkali and alkali-earth carbonates)</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Gaylussite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1826</gsmin:wikipediadate>
  </rdf:Description>
