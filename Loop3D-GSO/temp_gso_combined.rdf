  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/boggsite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Boggsite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ca | Si | Al | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">zeolite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/boggsite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;3&lt;/sub&gt;Ca&lt;sub&gt;8&lt;/sub&gt;(Si&lt;sub&gt;77&lt;/sub&gt;Al&lt;sub&gt;19&lt;/sub&gt;)O&lt;sub&gt;192&lt;/sub&gt;·70H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1989-009</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-704</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:704:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-704.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;3&lt;/sub&gt;Ca&lt;sub&gt;8&lt;/sub&gt;(Si&lt;sub&gt;77&lt;/sub&gt;Al&lt;sub&gt;19&lt;/sub&gt;)O&lt;sub&gt;192&lt;/sub&gt;·70H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Boggsite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Boggsite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Howard D G, Tschernich R W, Smith J V, Klein G L (1990) Boggsite, a new high-silica zeolite from Goble, Columbia County, Oregon, American Mineralogist 75, 1200-1204</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.GC.30</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Zeolite family: Chains of doubly-connected 4-membered rings</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Boggsite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1989-009</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/sylvite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Sylvite</rdfs:label>
