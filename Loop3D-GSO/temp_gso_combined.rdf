  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/fluellite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Fluellite</rdfs:label>
