    <gsmin:mindaturl>http://www.mindat.org/min-40272.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;3&lt;/sub&gt;Nb&lt;sup&gt;5+&lt;/sup&gt;&lt;sub&gt;3&lt;/sub&gt;Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;17&lt;/sub&gt;·9H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
