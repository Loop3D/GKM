  <rdf:Description rdf:about="https://w3id.org/gso/1.0/rockmaterial/Rock">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <dct:source xml:lang="en">Jackson, 1997; NADM C1 2004; Neuendorf et al 2005</dct:source>
    <rdfs:comment xml:lang="en">Consolidated aggregate of one or more EarthMaterials, or a body of undifferentiated mineral matter, or of solid organic material. Includes mineral aggregates such as granite, shale, marble; glassy matter such as obsidian; and organic material such a coal. Excludes unconsolidated materials.</rdfs:comment>
    <rdfs:label xml:lang="en">rock</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Rock_Material"/>
  </rdf:Description>
