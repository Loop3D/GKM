    <gsmin:rruffnameplain xml:lang="en">Wiluite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Groat L A, Hawthorne F C, Ercit T S, Grice J D (1998) Wiluite, Ca_19_(Al,Mg,Fe,Ti)_13_(B,Al,[box])_5_Si_18_O_68_(O,OH)_10_, a new mineral species isostructural with vesuvianite, from the Sakha Republic, Russian Federation, The Canadian Mineralogist 36, 1301-1304</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Vesuvianite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.BG.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Sorosilicate with mixed SiO4 and Si2O7 groups; cations in octahedral [6] and greater coordination</gsmin:strunzlabel>
