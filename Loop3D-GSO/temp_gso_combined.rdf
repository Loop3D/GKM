    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;4&lt;/sub&gt;MnCl&lt;sub&gt;6&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Tetrapotassium manganese hexachloride</gsmin:iupacchemname>
    <gsmin:mindatid>min-1019</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1019:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1019.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;4&lt;/sub&gt;Mn&lt;sup&gt;2+&lt;/sup&gt;Cl&lt;sub&gt;6&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Chlormanganokalite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Chlormanganokalite</gsmin:rruffnameplain>
