  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/tyuyamunite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Tyuyamunite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Ca | U | O | V | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">tetragonal, orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/tyuyamunite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(VO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·5-8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Calcium diuranyl divanadate 5-8hydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-4072</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4072:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4072.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(V&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;·5-8H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060983 | R070232</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Tyuyamunite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Tyuyamunite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Nenadkevich K A (1912) Tyuyamunite - a new mineral, Bulletin de l'Académie Impériale des Sciences de St.-Pétersbourg 6, 945-946</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.HB.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">V[5,6] Vanadate, Uranyl Sorovanodates</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Tyuyamunite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1912</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/bazzite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Bazzite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Be | Sc | Fe | Mg | Si | O | Na | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">beryl</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/bazzite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Be&lt;sub&gt;3&lt;/sub&gt;(Sc,Fe&lt;sup&gt;3+&lt;/sup&gt;,Mg)&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;·Na&lt;sub&gt;0.32&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-586</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:586:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-586.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Be&lt;sub&gt;3&lt;/sub&gt;(Sc&lt;sup&gt;3+&lt;/sup&gt;,Fe&lt;sup&gt;3+&lt;/sup&gt;,Mg)&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;6&lt;/sub&gt;O&lt;sub&gt;18&lt;/sub&gt;·Na&lt;sub&gt;0.32&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bazzite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Bazzite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Artini E (1915) Due minerali di Baveno contenenti terre rare: weibyeïte e bazzite, Atti della Reale Accademia dei Lincei, Rendiconti della Classe di Scienze Fisiche, Matematiche e Naturali 24, 313-319</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Beryl</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CJ.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si6O18]12- 6-membered single rings (sechser-Einfachringe), without insular complex anions</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Bazzite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1915</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/neustadtelite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Neustädtelite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Bi | Fe | Co | As | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">medenbachite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/neustadtelite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bi&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;,Co)&lt;sub&gt;2&lt;/sub&gt;(O,OH)&lt;sub&gt;4&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-11011</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:11011:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-11011.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bi&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;Fe&lt;sup&gt;3+&lt;/sup&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;,Co&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(O,OH)&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Neustädtelite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Neustadtelite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Krause W, Bernhardt H J, McCammon C, Effenberger H (2002) Neustädtelite and cobaltneustädtelite, the Fe3+- and Co2+-analogues of medenbachite, American Mineralogist 87, 726-738 Mandarino J A (2002) New minerals, The Canadian Mineralogist 40, 1527-1550</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.BK.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With medium-sized and large cations, (OH, etc.):RO4 = 2:1, 2.5:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Neustadtelite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2002</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/banalsite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Banalsite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Ba | Al | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">feldspar</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/banalsite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;BaAl&lt;sub&gt;4&lt;/sub&gt;Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;16&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:mindatid>min-504</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:504:7"/>
    <gsmin:mindaturl>http://www.mindat.org/min-504.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Na&lt;sub&gt;2&lt;/sub&gt;BaAl&lt;sub&gt;4&lt;/sub&gt;Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;16&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Banalsite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Banalsite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Smith W C, Bannister F A, Hey M H, Groves A W (1944) Banalsite, a new barium-feldspar from Wales, Mineralogical Magazine 27, 33-47</gsmin:statusnotes>
    <gsmin:strunzcodeV10>09.FA.60</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Tektosilicate without additional non-tetrahedral anions</gsmin:strunzlabel>
