  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/bernarlottiite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Bernarlottiite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Pb | As | Sb | S</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sub&gt;12&lt;/sub&gt;(As&lt;sub&gt;10&lt;/sub&gt;Sb&lt;sub&gt;6&lt;/sub&gt;)S&lt;sub&gt;36&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2013-133</gsmin:imanumber>
