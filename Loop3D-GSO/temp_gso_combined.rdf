    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;4&lt;/sub&gt;(As,Sb)&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;5&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1991-025</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Tetracopper diarsenide pentasulfide</gsmin:iupacchemname>
    <gsmin:mindatid>min-4246</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:4246:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-4246.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;4&lt;/sub&gt;As&lt;sub&gt;2&lt;/sub&gt;S&lt;sub&gt;5&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Watanabeite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Watanabeite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Shimizu M, Kato A, Matsubara S, Criddle A J, Stanley C J (1993) Watanabeite, Cu_4_(As,Sb)_2_S_5_, a new mineral from the Teine mine, Sapporo, Hokkaido, Japan, Mineralogical Magazine 57, 643-649</gsmin:statusnotes>
    <gsmin:strunzcodeV10>02.GC.15</gsmin:strunzcodeV10>
