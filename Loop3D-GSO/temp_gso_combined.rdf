    <gsmin:mindaturl>http://www.mindat.org/min-27416.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Al(U&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(As&lt;sup&gt;5+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;F·6.5H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R070024</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Chistyakovaite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Chistyakovaite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chukanov N V, Sidorenko G A, Naumova I S, Zadov A E, Kuz'min V I (2006) Chistyakovaite, a new mineral Al(UO&lt;sub&gt;2&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(AsO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(F,OH)·6.5H&lt;sub&gt;2&lt;/sub&gt;O, Doklady Akademii Nauk 406, 816-819</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.EB.20</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Uranyl phosphate or arsenate, UO2:RO4 = 1:1</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://webmineral.com/data/Chistyakovaite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2005-003</gsmin:wikipediadate>
