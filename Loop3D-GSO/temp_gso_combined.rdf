    <gsmin:imanumber xml:lang="en">IMA1980-001</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: CopperII telluriteIV</gsmin:iupacchemname>
    <gsmin:mindatid>min-501</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:501:0"/>
    <gsmin:mindaturl>http://www.mindat.org/min-501.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;Te&lt;sup&gt;4+&lt;/sup&gt;O&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Balyakinite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Balyakinite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Spiridonov E M (1980) Balyakinite CuTeO&lt;sub&gt;3&lt;/sub&gt; - a new mineral from the oxidation zone, Doklady Akademii Nauk SSSR 253, 1448-1450</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.JK.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Tellurite without additional anions, without H2O</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Balyakinite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1980-001</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/hlousekite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
