    <gsmin:mindaturl>http://www.mindat.org/min-3789.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(K,Ca,Na)(Fe&lt;sup&gt;2+&lt;/sup&gt;,Mg,Al,Fe&lt;sup&gt;3+&lt;/sup&gt;)&lt;sub&gt;8&lt;/sub&gt;(Si,Al)&lt;sub&gt;12&lt;/sub&gt;(O,OH)&lt;sub&gt;36&lt;/sub&gt;·nH&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R060334 | R070696 | R110195</gsmin:rruffids>
