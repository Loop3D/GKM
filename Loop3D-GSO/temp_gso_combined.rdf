  <rdf:Description rdf:about="https://w3id.org/gso/1.0/geologicunit/Sanidinite_Metamorphic_Facies">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">sanidinite metamorphic facies</rdfs:label>
    <dct:source xml:lang="en">Fettes and Desmons, 2007</dct:source>
    <rdfs:comment xml:lang="en">distinguished from the pyroxene hornfels facies by the occurrence of especially high-temperature varieties and polymorphs of minerals (eg. pigeonite, K-rich labradorite), assemblage for rocks of basaltic composition</rdfs:comment>
