    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Na | Li | P | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">orthorhombic</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/nalipoite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaLi&lt;sub&gt;2&lt;/sub&gt;(PO&lt;sub&gt;4&lt;/sub&gt;)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1990-030</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Sodium dilithium phosphate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2833</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2833:8"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2833.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">NaLi&lt;sub&gt;2&lt;/sub&gt;PO&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Nalipoite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Nalipoite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chao G Y, Ercit T S (1991) Nalipoite, sodium dilithium phosphate, a new mineral species from Mont Saint-Hilaire, Quebec, The Canadian Mineralogist 29, 565-568 Jambor J L, Vanko D A (1992) New mineral names, American Mineralogist 77, 446-452</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.AA.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. without additional anions, without H2O, With small cations (some also with larger ones)</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Nalipoite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1990-030</gsmin:wikipediadate>
  </rdf:Description>
