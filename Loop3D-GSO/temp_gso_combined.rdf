    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/creedite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;3&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)(OH)&lt;sub&gt;2&lt;/sub&gt;F&lt;sub&gt;8&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:imachemistry>
    <gsmin:imastatus xml:lang="en">Grandfathered|Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Tricalcium dialuminium sulfate dihydroxyl octafluoride dihydrate</gsmin:iupacchemname>
    <gsmin:mindatid>min-1151</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1151:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1151.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ca&lt;sub&gt;3&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;(SO&lt;sub&gt;4&lt;/sub&gt;)(OH)&lt;sub&gt;2&lt;/sub&gt;F&lt;sub&gt;8&lt;/sub&gt;·2H&lt;sub&gt;2&lt;/sub&gt;O</gsmin:rruffchemistry>
    <gsmin:rruffids>R050141</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Creedite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Creedite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Larsen E S, Wells R C (1916) Some minerals from the fluorite-barite vein near Wagon Wheel Gap, Colorado, Proceedings of the National Academy of Sciences 2, 360-365</gsmin:statusnotes>
    <gsmin:strunzcodeV10>03.CG.15</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Aluminofluoride with CO3, SO4, or PO4</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Creedite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1916</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/knorringite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Knorringite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/mineral/garnetgroup"/>
    <gsmin:chemistryelements>Mg | Cr | Si | O</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">garnet</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/knorringite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;3&lt;/sub&gt;Cr&lt;sub&gt;2&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1968-010</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:iupacchemname xml:lang="en">IUPAC: Trimagnesium dichromium trinesosilicate</gsmin:iupacchemname>
    <gsmin:mindatid>min-2229</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2229:9"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2229.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mg&lt;sub&gt;3&lt;/sub&gt;Cr&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;(SiO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;3&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Knorringite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Knorringite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Nixon P H, Hornung G (1968) A new chromium garnet end member, knorringite, from Kimberlite, American Mineralogist 53, 1833-1840</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Garnet</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AD.25</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate without additional anions; cations in [6] and/or greater coordination</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Knorringite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1968-010</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/niobophyllite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Niobophyllite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Na | Fe | Nb | Ti | Si | O | H | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">triclinic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">astrophyllite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/niobophyllite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;NaFe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;7&lt;/sub&gt;(Nb,Ti)&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;8&lt;/sub&gt;O&lt;sub&gt;26&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;(F,O)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1964-001</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2911</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2911:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2911.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2&lt;/sub&gt;NaFe&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;7&lt;/sub&gt;(Nb&lt;sup&gt;5+&lt;/sup&gt;,Ti&lt;sup&gt;4+&lt;/sup&gt;)(Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;12&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;(O,F)</gsmin:rruffchemistry>
    <gsmin:rruffids>R110048</gsmin:rruffids>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Niobophyllite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Niobophyllite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Nickel E H, Rowland J F, Charette D J (1964) Niobophyllite - the niobium analogue of astrophyllite; a new mineral from Seal Lake, Labrador, The Canadian Mineralogist 8, 40-52 Chemical composition revised according to: Cámara F, Sokolova E, Abdu Y, Hawthorne F C (2010) The crystal structures of niobophyllite, kupletskite-(Cs) and Sn-rich astrophyllite: Revisions to the crystal chemistry of the astrophyllite-group minerals, The Canadian Mineralogist 48, 1-16</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Astrophyllite-Astrophyllite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.DC.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Inosilicate with branched 2-periodic single chains; Si2O6 + 2SiO3 Si4O12</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Niobophyllite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1964-001</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/giraudite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Giraudite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Fe | Zn | As | Se</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">cubic</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">tennantite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/giraudite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;6&lt;/sub&gt;[Cu&lt;sub&gt;4&lt;/sub&gt;(Fe,Zn)&lt;sub&gt;2&lt;/sub&gt;]As&lt;sub&gt;4&lt;/sub&gt;Se&lt;sub&gt;13&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1980-089</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-1698</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:1698:4"/>
    <gsmin:mindaturl>http://www.mindat.org/min-1698.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;1+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;[Cu&lt;sup&gt;1+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;(Fe&lt;sup&gt;2+&lt;/sup&gt;,Zn&lt;sup&gt;2+&lt;/sup&gt;)&lt;sub&gt;2&lt;/sub&gt;]As&lt;sup&gt;3+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Se&lt;sup&gt;2-&lt;/sup&gt;&lt;sub&gt;13&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Giraudite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Giraudite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Johan Z, Picot P, Ruhlmann F (1982) Evolution paragénétique de la minéralisation uranifère de Chaméane (Puy-de-Dôme), France: chaméanite, geffroyite et giraudite, trois séléniures nouveaux de Cu, Fe, Ag et As, Tschermaks Mineralogische und Petrographische Mitteilungen 29, 151-167</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Tennantite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>02.GB.05</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Neso-sulfarsenite with additional S</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Giraudite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1980-089</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/gunningite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
