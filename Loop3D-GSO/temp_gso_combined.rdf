  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/minehillite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Minehillite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>K | Ca | Zn | Al | Si | O | H</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:fleischersgroup xml:lang="en">reyerite</gsmin:fleischersgroup>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/minehillite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(K,Na)&lt;sub&gt;2&lt;/sub&gt;Ca&lt;sub&gt;28&lt;/sub&gt;Zn&lt;sub&gt;5&lt;/sub&gt;Al&lt;sub&gt;4&lt;/sub&gt;Si&lt;sub&gt;40&lt;/sub&gt;O&lt;sub&gt;112&lt;/sub&gt;(OH)&lt;sub&gt;16&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1983-001</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2719</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2719:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2719.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">K&lt;sub&gt;2-3&lt;/sub&gt;Ca&lt;sub&gt;28&lt;/sub&gt;Zn&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;5&lt;/sub&gt;Al&lt;sub&gt;4&lt;/sub&gt;Si&lt;sub&gt;40&lt;/sub&gt;O&lt;sub&gt;112&lt;/sub&gt;(OH)&lt;sub&gt;16&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Minehillite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Minehillite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Dunn P J, Peacor D R, Leavens P B, Wicks F J (1984) Minehillite, a new layer silicate from Franklin, New Jersey, related to reyerite and truscottite, American Mineralogist 69, 1150-1155</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Gyrolite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.EE.75</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phyllosilicate: Single tetrahedral nets of 6-membered rings connected by octahedral nets or octahedral bands</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Minehillite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1983-001</gsmin:wikipediadate>
  </rdf:Description>
