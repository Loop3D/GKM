    <gsmin:statusnotes xml:lang="en">Back M E, Grice J D, Gault R A, Cooper M A, Walford P C, Mandarino J A (2017) Telluromandarinoite, a new tellurite mineral from the El Indio-Tambo mining property, Andes Mountains, Chile. The Canadian Mineralogist 55, 21-28</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Mandarinoite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.JM.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Tellurite without additional anions, with H2O</gsmin:strunzlabel>
    <gsmin:wikipediadate>2011-013</gsmin:wikipediadate>
