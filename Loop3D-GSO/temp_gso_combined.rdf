    <gsoc:timeStarts rdf:resource="https://w3id.org/gso/1.0/geologictime/BaseLopingian"/>
    <rdfs:comment xml:lang="en">Interval for grouping all specific instances of the Wuchiapingian Age</rdfs:comment>
    <rdfs:label xml:lang="en">Wuchiapingian Age</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/okanoganite-y">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Okanoganite-(Y)</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Y | REE | Ca | Na | Th | Fe | Ti | Si | B | P | O | H | F</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/okanoganitey.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Y,REE,Ca,Na,Th)&lt;sub&gt;16&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;,Ti)(Si,B,P)&lt;sub&gt;10&lt;/sub&gt;(O,OH)&lt;sub&gt;38&lt;/sub&gt;F&lt;sub&gt;10&lt;/sub&gt;</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1979-048</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-2966</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2966:3"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2966.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Y&lt;sup&gt;3+&lt;/sup&gt;,Ce&lt;sup&gt;3+&lt;/sup&gt;,Ca,Na,Th&lt;sup&gt;4+&lt;/sup&gt;)&lt;sub&gt;16&lt;/sub&gt;(Fe&lt;sup&gt;3+&lt;/sup&gt;,Ti&lt;sup&gt;4+&lt;/sup&gt;)(Si,B,P&lt;sup&gt;5+&lt;/sup&gt;)&lt;sub&gt;10&lt;/sub&gt;(O,OH)&lt;sub&gt;38&lt;/sub&gt;F&lt;sub&gt;10&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Okanoganite-(Y)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Okanoganite-(Y)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Boggs R C (1980) Okanoganite, a new rare-earth borofluorosilicate from the Golden Horn batholith, Okanogan County, Washington, American Mineralogist 65, 1138-1142 Name changed from okanoganite: Nickel E H, Mandarino J A (1987) Procedures involving the IMA Commission on New Minerals and Mineral Names and guidelines on mineral nomenclature, American Mineralogist 72, 1031-1042 Chemical formula revised: Boiocchi M, Callegari A, Ottolini L, Maras A (2004) The chemistry and crystal structure of okanoganite-(Y) and comparison with vicanite-(Ce), American Mineralogist 89, 1540-1545</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Okanoganite</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.AJ.35</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Nesosilicate with BO3 triangles and/or B[4], Be[4] tetrahedra, cornersharing with SiO4</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Okanoganite-%28Y%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1979-048</gsmin:wikipediadate>
  </rdf:Description>
