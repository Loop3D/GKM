    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mariinskite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Mariinskite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Pautov L A, Popov M P, Erokhin Y V, Khiller V V, Karpenko V Y (2012) Mariinskite, BeCr_2_O_4_, a new mineral, chromium analogue of chrysoberyl. Zapiski Rossiiskogo Mineralogicheskogo Obshchetstva 141(6) 43-62</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Olivine</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>04.BA.??</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 3:4 and similar, With small and medium-sized cations</gsmin:strunzlabel>
    <gsmin:wikipediadate>2011-057</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/thornasite">
