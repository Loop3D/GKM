  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/mojaveite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Mojaveite</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://w3id.org/gso/1.0/geology/Mineral_Material"/>
    <gsmin:chemistryelements>Cu | Te | O | H | Cl</gsmin:chemistryelements>
    <gsmin:crystalsystem xml:lang="en">hexagonal</gsmin:crystalsystem>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sub&gt;6&lt;/sub&gt;[Te&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;](OH)&lt;sub&gt;7&lt;/sub&gt;Cl</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA2013-120</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Cu&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;6&lt;/sub&gt;[Te&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;(OH)&lt;sub&gt;2&lt;/sub&gt;](OH)&lt;sub&gt;7&lt;/sub&gt;Cl&lt;sup&gt;1-&lt;/sup&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Mojaveite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Mojaveite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Mills S J, Kampf A R, Christy A G, Housley R M, Rossman G R, Reynolds R E, Marty J (2014) Bluebellite and mojaveite, two new minerals from the central Mojave Desert, California, USA. Mineralogical Magazine 78, 1325-1340</gsmin:statusnotes>
  </rdf:Description>
