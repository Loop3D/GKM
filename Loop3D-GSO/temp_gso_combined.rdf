    <gsmin:statusnotes xml:lang="en">Khomyakov A P, Nechelyustov G N, Arakcheeva A V (2006) Rastsvetaevite, Na_27_K_8_Ca_12_Fe_3_Zr_6_Si_4_[Si_3_O_9_]_4_[Si_9_O_27_]_4_(O,OH,H_2_O)_6_Cl_2_, a new mineral with a modular eudialyte-like structure and crystal-chemical systematics of the eudialyte group, Zapiski Rossiiskogo Mineralogicheskogo Obshchetstva 135(1), 49-65</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Eudialyte</gsmin:structuralgroup>
    <gsmin:strunzcodeV10>09.CO.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Cyclosilicate: [Si9O27]18- 9-membered rings</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Rastsvetaevite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>2000-028</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/galaxite">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Galaxite</rdfs:label>
