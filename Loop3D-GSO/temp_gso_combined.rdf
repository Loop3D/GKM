    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">(Au,Ag,Sb,Bi,Pb)&lt;sub&gt;23&lt;/sub&gt;(Te,Sb,Bi,Pb)&lt;sub&gt;38&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Montbrayite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Montbrayite</gsmin:rruffnameplain>
