    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Erikjonssonite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Erikjonssonite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Chukanov, N.V., Siidra, O.I., Polekhovsky, Y.S., Pekov, I.V., Varlamov, D.A., Ermolaeva, V.N. and Virus, A.A. (2018) Erikjonssonite, IMA 2018-058. CNMNC Newsletter No. 45, October 2018, page xxx; Mineralogical Magazine, 82, xxx-xxx</gsmin:statusnotes>
    <gsmin:structuralgroup xml:lang="en">Hereroite</gsmin:structuralgroup>
  </rdf:Description>
