    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Pb&lt;sup&gt;2+&lt;/sup&gt;&lt;sub&gt;4&lt;/sub&gt;Al&lt;sub&gt;2&lt;/sub&gt;Si&lt;sub&gt;4&lt;/sub&gt;O&lt;sub&gt;10&lt;/sub&gt;(S&lt;sup&gt;6+&lt;/sup&gt;O&lt;sub&gt;4&lt;/sub&gt;)(CO&lt;sub&gt;3&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)&lt;sub&gt;4&lt;/sub&gt;</gsmin:rruffchemistry>
    <gsmin:rruffids>R080021</gsmin:rruffids>
