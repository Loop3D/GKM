    <gsmin:strunzlabel xml:lang="en">Hydroxide (without V or U), Hydroxides with OH, without H2O; corner-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Tetrawickmanite.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1971-018</gsmin:wikipediadate>
  </rdf:Description>
