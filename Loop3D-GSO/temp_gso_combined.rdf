    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:2449:1"/>
    <gsmin:mindaturl>http://www.mindat.org/min-2449.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Ce&lt;sup&gt;3+&lt;/sup&gt;Ti&lt;sup&gt;4+&lt;/sup&gt;&lt;sub&gt;2&lt;/sub&gt;O&lt;sub&gt;5&lt;/sub&gt;(OH)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Lucasite-(Ce)</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Lucasite-(Ce)</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Nickel E H, Grey I E, Madsen I C (1987) Lucasite-(Ce), CeTi_2_(O,OH)_6_, a new mineral from Western Australia: its description and structure, American Mineralogist 72, 1006-1010</gsmin:statusnotes>
    <gsmin:strunzcodeV10>04.DH.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Oxide, Metal: Oxygen = 1:2 and similar, With large (+- medium-sized) cations; sheets of edge-sharing octahedra</gsmin:strunzlabel>
    <gsmin:webmineralurl>http://www.webmineral.com/data/Lucasite-%28Ce%29.shtml</gsmin:webmineralurl>
    <gsmin:wikipediadate>1986-020</gsmin:wikipediadate>
  </rdf:Description>
  <rdf:Description rdf:about="https://w3id.org/gso/1.0/mineral/marcasite">
