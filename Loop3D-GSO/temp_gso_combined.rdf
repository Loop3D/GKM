    <gsmin:handbookofmineralogyurl>http://www.handbookofmineralogy.com/pdfs/petitjeanite.pdf</gsmin:handbookofmineralogyurl>
    <gsmin:imachemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bi&lt;sub&gt;3&lt;/sub&gt;O(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)</gsmin:imachemistry>
    <gsmin:imanumber xml:lang="en">IMA1992-013</gsmin:imanumber>
    <gsmin:imastatus xml:lang="en">Approved</gsmin:imastatus>
    <gsmin:mindatid>min-3329</gsmin:mindatid>
    <gsmin:mindaturi rdf:resource="https://www.mindat.org/1:1:3329:5"/>
    <gsmin:mindaturl>http://www.mindat.org/min-3329.html</gsmin:mindaturl>
    <gsmin:rruffchemistry rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Bi&lt;sub&gt;3&lt;/sub&gt;O(PO&lt;sub&gt;4&lt;/sub&gt;)&lt;sub&gt;2&lt;/sub&gt;(OH)</gsmin:rruffchemistry>
    <gsmin:rruffnamehtml rdf:datatype="http://www.w3.org/1999/02/22-rdf-syntax-ns#HTML">Petitjeanite</gsmin:rruffnamehtml>
    <gsmin:rruffnameplain xml:lang="en">Petitjeanite</gsmin:rruffnameplain>
    <gsmin:statusnotes xml:lang="en">Krause W, Belendorff K, Bernhardt H J (1993) Petitjeanite, Bi3O(OH)(PO4)2, a new mineral, and additional data for the corresponding arsenate and vanadate, preisingerite and schumacherite, Neues Jahrbuch für Mineralogie, Monatshefte 1993, 487-503 Jambor J L, Puziewicz J, Roberts A C (1994) New mineral names, American Mineralogist 79, 763-767</gsmin:statusnotes>
    <gsmin:strunzcodeV10>08.BO.10</gsmin:strunzcodeV10>
    <gsmin:strunzlabel xml:lang="en">Phosphate, etc. with additional anions, without H2O, With only large cations, (OH, etc.):RO4 about 1:1</gsmin:strunzlabel>
